<rml>
<head>
	<title>[[market.title]]</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="market.rcss"/>
</head>
<!-- The market of the station the ship is at, or nearest: the shell's "market" data model, made from
     the simulation's snapshots (app/src/MarketScreen.h). Prices are credits a crate, a crate one IBC
     cube of the good. A bid over the galactic mean is worth selling at, and an ask under it worth
     buying at, in green; an ask half as much again over it, in red. Its text is the string table's
     (strings/<language>/market.yaml). -->
<body data-model="market">
	<div id="window" class="panel">
		<div id="header">
			<h1 id="station">{{screen.station}}</h1><span id="system">{{screen.system}}</span>
		</div>
		<div id="status" data-class-docked="screen.docked">{{screen.status}}</div>
		<div id="purse">
			[[market.credits]] <span id="credits">{{screen.credits | thousands}}</span>
			&nbsp;&nbsp; [[market.hold]] <span id="hold">{{screen.used}} / {{screen.capacity}}</span> [[market.crates]]
			<span id="lots">[[market.lots]]
				<button id="lot-1" data-class-chosen="screen.lot == 1" data-event-click="lot(1)">1</button>
				<button id="lot-10" data-class-chosen="screen.lot == 10" data-event-click="lot(10)">10</button>
			</span>
		</div>
		<table>
			<thead>
				<tr>
					<td>[[market.column.good]]</td><td class="number">[[market.column.stock]]</td>
					<td class="number">[[market.column.bid]]</td><td class="number">[[market.column.ask]]</td>
					<td class="number">[[market.column.mean]]</td>
					<td class="number">[[market.column.held]]</td><td class="elsewhere">[[market.column.elsewhere]]</td><td></td>
				</tr>
			</thead>
			<tbody>
				<tr data-for="row, i : screen.goods">
					<td class="good">{{row.name}}<span class="crate">{{row.crate}}</span></td>
					<td class="number" data-attr-id="'stock-' + i">{{row.stock}}</td>
					<td class="number" data-attr-id="'bid-' + i" data-class-cheap="row.bid &gt; row.mean">{{row.bid | thousands}}</td>
					<td class="number" data-attr-id="'ask-' + i" data-class-cheap="row.ask &lt; row.mean"
					    data-class-dear="row.ask &gt; row.mean * 3 / 2">{{row.ask | thousands}}</td>
					<td class="number mean" data-attr-id="'mean-' + i">{{row.mean | thousands}}</td>
					<td class="number" data-attr-id="'held-' + i">{{row.held}}</td>
					<td class="elsewhere">{{row.elsewhere}}</td>
					<td class="trade">
						<button data-attr-id="'buy-' + i" data-class-disabled="!row.canBuy"
						        data-event-click="buy(row.good, screen.lot)">[[market.buy]]</button>
						<button data-attr-id="'sell-' + i" data-class-disabled="!row.canSell"
						        data-event-click="sell(row.good, screen.lot)">[[market.sell]]</button>
					</td>
				</tr>
			</tbody>
		</table>
		<div id="message">{{screen.message}}</div>
		<div id="footer">[[market.footer]]</div>
	</div>
</body>
</rml>
