/* The saved-games screen (ui/saves.rml): a panel at the left of the frame. Its colours are
   ui/base.rcss's, by class, so a palette is that file's alone. */

#window {
	position: absolute;
	left: 24dp;
	top: 24dp;
	width: 620dp;
	padding: 16dp 20dp;
	border-width: 1dp;
	border-radius: 6dp;
}

h1 { margin-bottom: 10dp; }
table { width: 100%; }
thead td {
	padding-bottom: 4dp;
	border-bottom-width: 1dp;
	font-size: 13dp;
}
tbody td {
	padding: 5dp 0dp;
	border-bottom-width: 1dp;
}
td { white-space: nowrap; }
td.number { font-family: Hack; text-align: right; padding-right: 12dp; }
td.problem { font-size: 12dp; }
td.load { text-align: right; }
#footer {
	margin-top: 10dp;
	font-size: 12dp;
}
