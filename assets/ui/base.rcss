/* The game UI's base: what a browser's own stylesheet gives every element, which RmlUi leaves to the
   documents, and the palette every screen shares. A mod restyles every screen by shipping its own
   ui/base.rcss, or one screen by shipping that screen's stylesheet (docs/ui.md).

   The palette is the dev tools' (devtools/Theme.h), Catppuccin Mocha and, in the @media blocks at
   the end, the other three, so a game's screens and the tools read as one design and follow the
   same setting. Every colour of the engine's screens is in this file, by the dev tools' role, and
   ThemeTests holds each to its palette's table. RmlUi has no variables, so a mod changes the
   palette by restating the rules that carry a colour in ui/base.patch.rcss, which comes after this
   file and wins (docs/ui.md, "The game UI's palette"). */

body, div, p, h1, h2, h3, table, form {
	display: block;
}
table { display: table; }
tr { display: table-row; }
td, th { display: table-cell; }
thead { display: table-row-group; }
tbody { display: table-row-group; }
span, em, strong { display: inline; }

/* A document is the frame's size, so a panel placed against an edge is placed against the frame's,
   and the mouse goes through it to the scene and the documents behind it: a screen's panels take the
   mouse back (.panel), and only where they are. */
body {
	width: 100%;
	height: 100%;
	pointer-events: none;
	font-family: Roboto;
	font-weight: normal;
	font-size: 15dp;
	color: #cdd6f4; /* Foreground, text */
}

h1 { font-size: 24dp; }

/* A screen's panel: the tools' window ground, Background at 97 %, and the Border hairline. */
.panel {
	pointer-events: auto;
	border-color: #313244;
	background-color: #1e1e2ef7;
}

/* The text roles a screen's elements take by class, as the console's lines do. */
.muted { color: #a6adc8; }   /* subtext0 */
.faint { color: #6c7086; }   /* overlay0 */
.warning { color: #f9e2af; } /* yellow */
.danger { color: #f38ba8; }  /* red */

/* A table's lines, the tools' strong and light borders: a screen sets their widths. */
thead td { border-color: #313244; }
tbody td { border-color: #31324499; }

em { font-style: italic; }
strong { font-weight: bold; }

button {
	display: inline-block;
	padding: 3dp 10dp;
	margin-left: 4dp;
	border: 1dp #313244; /* Border */
	border-radius: 3dp;
	background-color: #45475a; /* Subtle, surface1 */
	color: #cdd6f4;
	cursor: pointer;
	tab-index: auto;
	nav: auto;
}
button:hover { background-color: #585b70; } /* Hover, surface2 */
button:active {
	background-color: #89b4fa; /* Primary, blue */
	color: #11111b;            /* OnPrimary, crust */
}
button.disabled, button.disabled:hover {
	border-color: #313244;
	background-color: #181825; /* Surface, mantle */
	color: #6c7086;            /* Faint */
	cursor: arrow;
}

/* The other three varieties, as the dev tools' palette switches (dev.palette): each restates every
   rule above that carries a colour, in its own palette's roles, and is active while the shell has
   its theme set (UiSystem::SetTheme). Mocha, the rules above, is what draws with no theme active. */
@media (theme: latte) {
	body { color: #4c4f69; }
	.panel { border-color: #ccd0da; background-color: #eff1f5f7; }
	.muted { color: #6c6f85; }
	.faint { color: #9ca0b0; }
	.warning { color: #df8e1d; }
	.danger { color: #d20f39; }
	thead td { border-color: #ccd0da; }
	tbody td { border-color: #ccd0da99; }
	button { border-color: #ccd0da; background-color: #bcc0cc; color: #4c4f69; }
	button:hover { background-color: #acb0be; }
	button:active { background-color: #1e66f5; color: #eff1f5; }
	button.disabled, button.disabled:hover {
		border-color: #ccd0da;
		background-color: #e6e9ef;
		color: #9ca0b0;
	}
}

@media (theme: frappe) {
	body { color: #c6d0f5; }
	.panel { border-color: #414559; background-color: #303446f7; }
	.muted { color: #a5adce; }
	.faint { color: #737994; }
	.warning { color: #e5c890; }
	.danger { color: #e78284; }
	thead td { border-color: #414559; }
	tbody td { border-color: #41455999; }
	button { border-color: #414559; background-color: #51576d; color: #c6d0f5; }
	button:hover { background-color: #626880; }
	button:active { background-color: #8caaee; color: #232634; }
	button.disabled, button.disabled:hover {
		border-color: #414559;
		background-color: #292c3c;
		color: #737994;
	}
}

@media (theme: macchiato) {
	body { color: #cad3f5; }
	.panel { border-color: #363a4f; background-color: #24273af7; }
	.muted { color: #a5adcb; }
	.faint { color: #6e738d; }
	.warning { color: #eed49f; }
	.danger { color: #ed8796; }
	thead td { border-color: #363a4f; }
	tbody td { border-color: #363a4f99; }
	button { border-color: #363a4f; background-color: #494d64; color: #cad3f5; }
	button:hover { background-color: #5b6078; }
	button:active { background-color: #8aadf4; color: #181926; }
	button.disabled, button.disabled:hover {
		border-color: #363a4f;
		background-color: #1e2030;
		color: #6e738d;
	}
}
