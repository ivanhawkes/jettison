{
    "tasks": [
        {
            "type": "process",
            "label": "CMake: configure clang-debug",
            "command": "cmake",
            "args": ["--preset", "clang-debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "CMake: build clang-debug",
            "command": "cmake",
            "args": ["--build", "--preset", "clang-debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure clang-debug",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}