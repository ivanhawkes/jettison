[0.018, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m2\u001b[17G\u001b[22m\u001b[38;2;117;113;94m \u001b[19Gcovers the course they\u001b[42Ggive (Cruis\u001b[54GSeconds), so no step \u001b[76Gf it\u001b[81Gacceler\u001b[90Ge\u001b[92G past the boost;\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[17G\u001b[22m\u001b[38;2;117;113;94m-\u001b[19Galong the course i\u001b[38G \u001b[40Gases out of its start and i\u001b[68Gto its\u001b[75Gend (an in-out cubic of the steps\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 164 -\u001b[38;2;248;248;242m//     run), or on a profile covers it as the profile does (\u001b[48;2;92;2;0mCruiseCovered\u001b[48;2;61;1;0m), slowed to the whole       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 164 +\u001b[38;2;117;113;94m//     run), or on a profile covers it as the profile does (\u001b[48;2;4;71;0mTransit::Covered\u001b[48;2;2;40;0m), slowed to the whole\u001b[38;2;248;248;242m    \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 165 \u001b[22m \u001b[38;2;117;113;94m//     steps; carried with the carrier on its orbit, and faces along the leg it is on;\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[17G\u001b[22m\u001b[38;2;117;113;94m-\u001b[19Gin the\u001b[26Gstep that ends its c\u001b[47Guise it i\u001b[58Gat the\u001b[65Gcourse's end, or if\u001b[85Gthat is not clear of every\r\u001b[8C\u001b[1B\u001b[39m\u001b[2m7\u001b[17G\u001b[22m\u001b[38;2;117;113;94m \u001b[19Gbody already ther\u001b[37G and of\u001b[45Gwhat arrived\u001b[58Gbefor\u001b[65Git in the step, at the fir\u001b[92Gt pla\u001b[98Ge clear\u001b[106Gon\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/space/tests/CruiseTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mRemoved \u001b[1m1\u001b[22m li\u001b[19Ge\u001b[K\r\u001b[1B     \u001b[2m 31 \u001b[22m \u001b[38;2;166;226;46mconst\u001b[39m std::\u001b[38;2;166;226;46muint64_