[182.898, "o", "\u001b[?25l\u001b[H\u001b[5G  where stepping takes about 1,800 st\u001b[43Gps. A wor\u001b[53Gd loaded mid-way ends wi\u001b[79G the\u001b[84Gsame state hash as the\u001b[107Gst\u001b[110Gpped\u001b[115Gone.\r\u001b[4C\u001b[1B\u001b[1mThe cruise is rebu\u001b[24Glt on\u001b[30Gthose parts:\u001b[22m its\u001b[47Gmaths\u001b[53Gmoved\u001b[59Gunchanged\u001b[69Gand\u001b[73Gits\u001b[77Gsaved\u001b[83G\u001b[38;2;177;185;249mCruising\u001b[92G\u001b[39mcomponent\u001b[102Gis\u001b[105Gkept.\u001b[111GLanes\u001b[117Gand\r\u001b[4C\u001b[1Bgates use the same\u001b[24Gshared piec\u001b[36Gs, so Space's privat\u001b[58Gcopy of th\u001b[69Gm\u001b[71Gis\u001b[74Gdele\u001b[79Ged\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne change outside the slice:\u001b[22m I added \u001b[38;2;177;185;249mtransit\u001b[39m to\u001b[54Gthe\u001b[58Ggate's ASa\u001b[69G un\u001b[73Gt-test stage\u001b[86Gin \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m, since it now\u001b[K\r\u001b[4C\u001b[1Bcarries\u001b[13Gth\u001b[16G cruise's movement and sav\u001b[43G/load.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdocs/architecture.md\u001b[39m has a new \"Transit\" sec\u001b[50Gion, an\u001b[59Gthe plan m\u001b[70Grks 4b\u001b[77Gdon\u001b[81G.\u001b[83G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNoth\u001b[10Gng\u001b[13Gis pushed.\u001b[K\r\u001b[4C\u001b[1BManifest's switch to\u001b[26Gthe\u001b[30Gneutral n\u001b[40Gmes is still uncommitted. It can't \u001b[76Ge committed\u001b[88Guntil\u001b[94GManifest's\u001b[105Gpin\u001b[109Gmoves\u001b[115Gto\u001b[118G4a\r\u001b[4C\u001b[1Bor\u001b[8Glater,\u001b[15Gwhich\u001b[21Gneeds\u001b[27Gthis\u001b[32Gbranch\u001b[39Gpushed.\u001b[47GSay\u001b[51Gif\u001b[54Gyou\u001b[58Gwant\u001b[63Gme\u001b[66Gto\u001b[69Gpush\u001b[74Gand\u001b[78Gmove\u001b[83Gthe\u001b[87Gpin;\u001b[92Gthat\u001b[97Gwould\u001b[103Gget\u001b[107GManifest's\r\u001b[2C\u001b[1B  full gate\u001b[15Gfirst.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext is 4c\u001b[22m, rebuilding\u001b[30Glanes on portal\u001b[46G: a door between two frames and\u001b[78Gone wi\u001b[85Ghin a frame. Opus at high effort\u001b[118G\u001b[K\r\u001b[2C\u001b[1Bagain: it's\u001b[15Gt\u001b[17Ge sam\u001b[23G keep-the-s\u001b[35Gved-bytes work,\u001b[51Gon\u001b[54G\u001b[38;2;177;185;249mOnLane\u001b[39m. Now\u001b[66Gis\u001b[69Ga good point to \u001b[38;2;177;185;249m/compact\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 16m 55s · done 10:25 pm\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m※\u001b[3G\u001b[1mrecap: \u001b[22m\u001b[3mSlice 4 moves the cruise, lanes and gates onto neutral transit pieces; 4b (passages, with a lift and a train) \r\u001b[2C\u001b[1Bis committed, gated, and every pin holds. Next is 4c, rebuilding the lanes on portals, unless you'd rather I push and \r\u001b[1B\u001b[23m\u001b[39m \u001b[3G\u001b[38;2;153;153;153m\u001b[3mmove Manifest's pin first. (turn off recaps in /config)\u001b[23m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
