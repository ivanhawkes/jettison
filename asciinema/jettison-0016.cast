[0.183, "o", "\u001b[?25l\u001b[H\u001b[5Gunder\u001b[11G\u001b[38;2;177;185;249mManifest::Space\u001b[27G\u001b[39mand\u001b[31G\u001b[38;2;177;185;249mmanifest/space/*.h\u001b[39m.\u001b[51GSaved\u001b[57Gand\u001b[61Greflected\u001b[71Gnames\u001b[77Gare\u001b[81Gunchanged.\r\u001b[2C\u001b[1B  - Celestial's\u001b[19G\u001b[38;2;177;185;249mRegisterTypes\u001b[33G\u001b[39mis\u001b[36Gnow\u001b[40G\u001b[38;2;177;185;249mRegisterSystemTypes\u001b[39m,\u001b[61Gsince\u001b[67Gthe\u001b[71Gtwo\u001b[75Gmodules\u001b[83Gnow\u001b[87Gshare\u001b[93Gone\u001b[97Gnamespace.\r\u001b[2C\u001b[1B \u001b[5G- Manifest no\u001b[19Glonger r\u001b[28Gquires \u001b[38;2;177;185;249mJettison::Celestial\u001b[39m or \u001b[38;2;177;185;249mJettison::Space\u001b[39m, a\u001b[77Gd its engine pin is moved to \u001b[38;2;177;185;249mb7d4580\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison:\u001b[22m both modules a\u001b[31G deleted.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- With no\u001b[15Goptional modules left, \u001b[38;2;177;185;249mjettison_check_optional\u001b[62G\u001b[39mis now\u001b[69G\u001b[38;2;177;185;249mjettison_check_dependencies\u001b[39m and only checks that no\u001b[K\r\u001b[4C\u001b[1B  \u001b[8Gngine module needs\u001b[27Ga\u001b[29Gsample.\r\u001b[2C\u001b[1B \u001b[5G- The words ch\u001b[20Gck now covers every module, and its all\u001b[60Gw-l\u001b[64Gst st\u001b[70Gys\u001b[73Gempty.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe\u001b[11Gmodule-graph\u001b[24Gdocs\u001b[29Gare\u001b[33Gupdated,\u001b[42Galong\u001b[48Gwith\u001b[53Gthe\u001b[57Gplan's\u001b[64Gslice\u001b[70G6\u001b[72Gentry.\r\u001b[2C\u001b[1B- \u001b[1mSpace reasons' text:\u001b[26G\u001b[22mthe English and Ger\u001b[46Gan wording\u001b[57Gf\u001b[59Gr the spa\u001b[69Ge reason\u001b[78G left the engine's\u001b[97Gstring tables w\u001b[113Gth \u001b[117Ghe\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gcode. Mani\u001b[16Gest has no \u001b[28Gtring tables yet,\u001b[46Gso\u001b[49Gfor\u001b[53Gnow\u001b[57Gthe\u001b[61Gtext\u001b[66Gexists\u001b[73Gonly\u001b[78Gin\u001b[81GJettison's\u001b[92Ghistory.\r\u001b[2C\u001b[2B\u001b[1mChecks:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mJettison:\u001b[22m th\u001b[19Gfull gate (\u001b[38;2;177;185;249m--werror --asan\u001b[39m) passed\u001b[54Gin\u001b[57G212\u001b[61Gs.\u001b[64GThe\u001b[68Gfirst\u001b[74Grun\u001b[78Gfailed\u001b[85Gbecause\u001b[93G\u001b[38;2;177;185;249mci.sh\u001b[99G\u001b[39mstill\u001b[105Gbuilt\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mjettison_space_tests\u001b[39m;\u001b[27GI\u001b[29Gremoved\u001b[37Gthat\u001b[42Gand\u001b[46Gfolded\u001b[53Git\u001b[56Ginto\u001b[61Gthe\u001b[65Gcommit.\r\u001b[1B \u001b[3G- \u001b[1mManifest:\u001b[22m all 54 suites pass on the\u001b[41Glocal\u001b[47Gengine\u001b[54Gwithout\u001b[62G\u001b[38;2;177;185;249mspace\u001b[39m,\u001b[69Gso\u001b[72Gevery\u001b[78Gpinned\u001b[85Ghash\u001b[90Gheld.\u001b[96GIts\u001b[100Gclang-tidy\u001b[111Gand\u001b[115Gformat\r\u001b[4C\u001b[1Bcheck\u001b[11Gare\u001b[15Gclean.\r\u001b[1B  - \u001b[1mNot run:\u001b[22m Manifest's own gate, which fetches \u001b[38;2;177;185;249mb7d4580\u001b[39m from GitHub and can't run until Jettison is pushed.\u001b[K\r\u001b[2B  The architecture doc's long sections on jumps, gates, routes and cruising still describe code that is now Manifest's.\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gleft\u001b[10Gthem\u001b[15Gfor\u001b[19Gslice\u001b[25G8's\u001b[29Gdoc\u001b[33Grewrite.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
