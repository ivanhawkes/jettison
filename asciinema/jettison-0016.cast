[0.061, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mstation\u001b[13G\u001b[39mand\u001b[17G\u001b[38;2;177;185;249mpad\u001b[21G\u001b[39mbecome\u001b[28G\u001b[38;2;177;185;249mvehicle\u001b[39m,\u001b[37G\u001b[38;2;177;185;249mplatform\u001b[46G\u001b[39mand\u001b[50G\u001b[38;2;177;185;249mberth\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther engine names:\u001b[25G\u001b[22m\u001b[38;2;177;185;249mPhysics.Thrusters\u001b[43G\u001b[39m→\u001b[45G\u001b[38;2;177;185;249mPhysics.Handling\u001b[39m,\u001b[63G\u001b[38;2;177;185;249mAi.CruiseProfile\u001b[80G\u001b[39m→\u001b[82G\u001b[38;2;177;185;249mTransit.MotionProfile\u001b[39m,\u001b[105G\u001b[38;2;177;185;249mbyHull\u001b[112G\u001b[39m→\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249mbyShape\u001b[39m, and the scene's \u001b[38;2;177;185;249mcelestial\u001b[39m record → \u001b[38;2;177;185;249mbody\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSaved values and keys:\u001b[28G\u001b[22mthe\u001b[32Gdocks'\u001b[39Gshape\u001b[45Gnames\u001b[51Ggo\u001b[54Gfrom\u001b[59G\u001b[38;2;177;185;249mhulls/\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249mstations/\u001b[80G\u001b[39mto\u001b[83G\u001b[38;2;177;185;249mvehicles/\u001b[93G\u001b[39mand\u001b[97G\u001b[38;2;177;185;249mplatforms/\u001b[39m,\u001b[109Gand\u001b[113Gthe\u001b[117Gdock\r\u001b[2C\u001b[1B  reasons' keys\u001b[19Gare\u001b[23Grenamed\u001b[31Gin\u001b[34Gthe\u001b[38Gen\u001b[41Gand\u001b[45Gde\u001b[48Gstring\u001b[55Gtables.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDropped:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mDock.Transfer\u001b[28G\u001b[39mand\u001b[32G\u001b[38;2;177;185;249mDock.Buggy\u001b[39m.\r\u001b[1B \u001b[3G- \u001b[1mManifest:\u001b[22m its sp\u001b[22Gce type\u001b[30G a\u001b[33Ge now \u001b[38;2;177;185;249mSpace.*\u001b[39m instead of \u001b[38;2;177;185;249mCelestial.*\u001b[70G\u001b[39mand\u001b[74G\u001b[38;2;177;185;249mAi.*\u001b[39m,\u001b[80Gand\u001b[84Gits\u001b[88Gdock\u001b[93Gdata\u001b[98Guses\u001b[103Gthe\u001b[107Gnew\u001b[111Gkeys.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow old saves load\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe save format is now version 5. Component type names are renamed in the save's table of\u001b[95Gnames.\u001b[102GFields\u001b[109Gare\u001b[113Grenamed\r\u001b[4C\u001b[1Bper type, by each component's own migration, because a blanket rename would also hit Manifest's\u001b[101Gown\u001b[105G\u001b[38;2;177;185;249mship\u001b[110G\u001b[39mand\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpadClass\u001b[39m fields.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFields in commands still queued in an old save are renamed as they are read, and stored dropped components are\r\u001b[4C\u001b[1Bskipped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOlder definition fil\u001b[26Gs (berths, vehicles,\u001b[47Gplatforms)\u001b[58Gstill\u001b[64Gload,\u001b[70Gand\u001b[74Gso\u001b[77Gdo\u001b[80Gold\u001b[84Gmod\u001b[88Gpatches.\u001b[97GScene\u001b[103Gfiles\u001b[109Gare\u001b[113Gnow\r\u001b[4C\u001b[1Bformat\u001b[12G3; older scene files with\u001b[38Ga\u001b[40G\u001b[38;2;177;185;249mcelestial:\u001b[51G\u001b[39mentry\u001b[57Gare\u001b[61Grefused\u001b[69Gwith\u001b[74Gan\u001b[77Gerror\u001b[83Gnaming\u001b[90Gthe\u001b[94Gfield\u001b[100Grather\u001b[107Gthan\u001b[112Gmigrated,\r\u001b[4C\u001b[1Band\u001b[9Gthe\u001b[13Gfive\u001b[18Gscene\u001b[24Gfiles\u001b[30Gin\u001b[33Gthe\u001b[37Grepo\u001b[42Gwere\u001b[47Gupdated.\r\u001b[1B \u001b[3G- Ma\u001b[8Gifest h\u001b[16Gs no saves of its \u001b[35Gwn, so it needed\u001b[52Gno m\u001b[57Ggration.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[40G\u001b[22mFive\u001b[45GJettison\u001b[54Gpins\u001b[59Gand\u001b[63Gfour\u001b[68GManifest\u001b[77Gpins\u001b[82Gmoved.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
