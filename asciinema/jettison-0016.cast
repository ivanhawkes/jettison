[0.094, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 234 +\u001b[38;2;248;248;242m   `textures/hulls` paths. `system` alone is not one of the checked words.                            \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 235 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 236 \u001b[12G\u001b[22m##\u001b[15GSettled\u001b[23Gwith\u001b[28Gthe\u001b[32Guser\r\u001b[5C\u001b[1B\u001b[2m 237 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(docs/space-extraction-plan.md)\u001b[K\r\u001b[5C\u001b[1BAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[5C\u001b[1B\u001b[2m 241 \u001b[22m   `dock-sequence` kept on the static scene's ship and pad, and the German UI frame on the engine's\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 242 \u001b[22m   own\u001b[18Gsaves\u001b[24Gscreen.\r\u001b[1B     \u001b[2m 243 \u001b[22m - **The cargo deck's two components kept** (2026-11-22, slice 2): `Dock.Transfer`\u001b[94Gand\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 244 -\u001b[38;2;248;248;242m  `Dock.Buggy` \u001b[48;2;92;2;0mstay\u001b[48;2;61;1;0m registered with no behaviour, so the pins \u001b[48;2;92;2;0mmove\u001b[48;2;61;1;0m once, in slice 7\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 244 +\u001b[38;2;248;248;242m  `Dock.Buggy` \u001b[48;2;4;71;0mstayed\u001b[48;2;2;40;0m registered with no behaviour, so the pins \u001b[48;2;4;71;0mmoved\u001b[48;2;2;40;0m once, in slice 7\u001b[48;2;4;71;0m, which\u001b[48;2;2;40;0m         \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 245 +\u001b[38;2;248;248;242m  dropped them.                                                                                       \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 246 \u001b[12G\u001b[22m-\u001b[14G**Pla