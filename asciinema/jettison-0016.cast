[0.301, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mbyShape\u001b[39m, and the s\u001b[24Gen\u001b[27G's \u001b[38;2;177;185;249mcelestia\u001b[39G\u001b[39m record → \u001b[38;2;177;185;249mbody\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSav\u001b[9Gd\u001b[11Gvalues\u001b[18Gand keys:\u001b[22m the docks' shape\u001b[45Gnames go from \u001b[38;2;177;185;249mhulls/\u001b[39m and \u001b[71G\u001b[38;2;177;185;249mtations/\u001b[80G\u001b[39mto \u001b[38;2;177;185;249mvehicles/\u001b[39m and \u001b[38;2;177;185;249mplatforms/\u001b[39m, and the\u001b[117Gdock\r\u001b[4C\u001b[1Breasons'\u001b[14Gkeys are r\u001b[26Gamed in the en and \u001b[46Ge string\u001b[55Gtables.\r\u001b[4C\u001b[1B\u001b[1mDropped:\u001b[22m \u001b[38;2;177;185;249mDock.Transfer\u001b[28G\u001b[39mand\u001b[32G\u001b[38;2;177;185;249mDock.Buggy\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m it\u001b[19Gspace typ\u001b[29Gs\u001b[31Gare now \u001b[38;2;177;185;249mSpace.*\u001b[39m instead\u001b[55Gof \u001b[38;2;177;185;249mCelestial.*\u001b[70G\u001b[39mand\u001b[74G\u001b[38;2;177;185;249mAi.*\u001b[39m,\u001b[80Gand\u001b[84Gits\u001b[88Gdock\u001b[93Gdata\u001b[98Guses\u001b[103Gthe\u001b[107Gnew\u001b[111Gkeys.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow old \u001b[12Gaves load\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gsave\u001b[14Gformat\u001b[21Gis\u001b[24Gnow\u001b[28Gversion 5.\u001b[39GComponent\u001b[49Gtype\u001b[54Gnames\u001b[60Gare\u001b[64Grenamed\u001b[72Gin\u001b[75Gthe\u001b[79Gsave's\u001b[86Gtable\u001b[92Gof\u001b[95Gnames.\u001b[102GFields\u001b[109Gare\u001b[113Grenamed\r\u001b[2C\u001b[1B  per type, by each\u001b[23Gcomponent's\u001b[35Gown\u001b[39Gmigration,\u001b[50Gbecause\u001b[58Ga\u001b[60Gblanket\u001b[68Grename\u001b[75Gwould\u001b[81Galso\u001b[86Ghit\u001b[90GManifest's\u001b[101Gown\u001b[105G\u001b[38;2;177;185;249mship\u001b[110G\u001b[39mand\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mpadClass\u001b[15G\u001b[39mields.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFields in\u001b[15Gcomm\u001b[20Gnds still queued in an old save are renamed as th\u001b[70Gy are rea\u001b[80G, and\u001b[86Gstored dropped\u001b[101Gcomponents are\r\u001b[4C\u001b[1Bskipped.\u001b[14G\u001b[K\r\u001b[4C\u001b[1BOlder definitio\u001b[21G files (berths,\u001b[37Gvehicles,\u001b[47Gplatfo\u001b[54Gms) still\u001b[64Gload, and so do old mod patches. Scene files are now\r\u001b[4C\u001b[1Bformat 3;\u001b[15Golder\u001b[21Gscene\u001b[27Gfiles\u001b[33Gwith\u001b[38Ga\u001b[40G\u001b[38;2;177;185;249mcelestial:\u001b[51G\u001b[39mentry\u001b[57Gare\u001b[61Grefused\u001b[69Gwith\u001b[74Gan\u001b[77Gerror\u001b[83Gnaming\u001b[90Gthe\u001b[94Gfield\u001b[100Grather\u001b[107Gthan\u001b[112Gmigrated,\r\u001b[2C\u001b[1B \u001b[5Gan\u001b[8G the \u001b[15Gve scene files in the\u001b[37Gr\u001b[39Gpo w\u001b[44Gre\u001b[47Gupdated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has no\u001b[22Gaves\u001b[27Gof its own, so it needed \u001b[53Go mig\u001b[59Gation.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[22m Five\u001b[45GJ\u001b[47Gttiso\u001b[53G pins \u001b[60Gnd four\u001b[68GManifest\u001b[77Gpins\u001b[82Gmoved.\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gtemporarily\u001b[19Gput\u001b[23Gback\u001b[28Gthe\u001b[32Gold\u001b[36Gnames,\u001b[43Gthe\u001b[47Gversion\u001b[55Gnumbers\u001b[63Gand\u001b[67Gthe\u001b[71Gtwo\u001b[75Gdropped\u001b[83Gcomponents.\u001b[95GEvery\u001b[101GJettison\u001b[110Gpin\r\u001b[2C\u001b[1B  returned to its old value, and Manifest's \u001b[48Gree from before this change passed all 54\u001b[90Gsuites\u001b[97Gagainst\u001b[105Gthat\u001b[110Gengine.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
