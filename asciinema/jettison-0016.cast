[0.090, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 161 \u001b[22m \u001b[38;2;117;113;94m//   - a drive with a profile is given the fewest whole steps found, from that solve's, in which it\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m62\u001b[12G\u001b[22m\u001b[38;2;117;113;94m//     covers the course they give (CruiseSeconds), so no step of it accelerates past the boost;\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m63\u001b[12G\u001b[22m\u001b[38;2;117;113;94m//   - along the course it eases out of its start and into its end (an in-out cubic of the steps\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 164 -\u001b[38;2;248;248;242m//     run), or on a profile covers it as the profile does (\u001b[48;2;92;2;0mCruiseCovered\u001b[48;2;61;1;0m), slowed to the whole       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 164 +\u001b[38;2;117;113;94m//     run), or on a profile covers it as the profile does (\u001b[48;2;4;71;0mTransit::Covered\u001b[48;2;2;40;0m), slowed to the whole\u001b[38;2;248;248;242m    \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m165\u001b[12G\u001b[22m\u001b[38;2;117;113;94m//     steps; carried with the carrier on its orbit, and faces along the leg it is on;\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m166\u001b[12G\u001b[22m\u001b[38;2;117;113;94m//   - in the step that ends its cruise it is at the course's end, or if that is not clear of every\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m167\u001b[12G\u001b[22m\u001b[38;2;117;113;94m//     body already there and of what arrived before it in the step, at the first place clear on\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/space/tests/CruiseTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mRemoved\u001b[14G\u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3\u001b[9G \u001b[22m \u001b[38;2;166;226;46mconst\u001b[17G\u001b[39mstd::\u001b[38;2;166;226;46muint64_t\u001b[31