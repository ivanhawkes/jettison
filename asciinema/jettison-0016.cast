[0.349, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mManif\u001b[11Gst:\u001b[22m its space types are now \u001b[38;2;177;185;249mSpace.*\u001b[47G\u001b[39minstead\u001b[55Gof\u001b[58G\u001b[38;2;177;185;249mCelestial.*\u001b[70G\u001b[39mand\u001b[74G\u001b[38;2;177;185;249mAi.*\u001b[39m,\u001b[80Gand\u001b[84Gits\u001b[88Gdock\u001b[93Gdata\u001b[98Guses\u001b[103Gthe\u001b[107Gnew\u001b[111Gkeys.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow old saves load\r\u001b[2C\u001b[1B\u001b[22m- The save format is\u001b[24Gnow\u001b[28Gversion 5.\u001b[39GComponent\u001b[49Gtype\u001b[54Gnames\u001b[60Gare\u001b[64Grenamed\u001b[72Gin\u001b[75Gthe\u001b[79Gsave's\u001b[86Gtable\u001b[92Gof\u001b[95Gnames.\u001b[102GFields\u001b[109Gare\u001b[113Grenamed\r\u001b[2C\u001b[1B \u001b[5Gper\u001b[9Gtyp\u001b[13G, by each compon\u001b[30Gnt's own\u001b[39Gmigration, because a\u001b[60Gblank\u001b[66Gt r\u001b[70Gname\u001b[75Gwould also\u001b[86Ghit Manifest'\u001b[100G own \u001b[38;2;177;185;249mship\u001b[39m and\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpadClass\u001b[39m fields.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFields in commands\u001b[24Gstill\u001b[30Gqueued\u001b[37Gin\u001b[40Gan\u001b[43Gold\u001b[47Gsave\u001b[52Gare\u001b[56Grenamed\u001b[64Gas\u001b[67Gthey\u001b[72Gare\u001b[76Gread,\u001b[82Gand\u001b[86Gstored\u001b[93Gdropped\u001b[101Gcomponents\u001b[112Gare\r\u001b[2C\u001b[1B \u001b[5Gskipped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOlder \u001b[12Gefinition\u001b[22Gfiles\u001b[28G(berths,\u001b[37Gvehicles,\u001b[47Gplatforms)\u001b[58Gstill\u001b[64Gload,\u001b[70Gand\u001b[74Gso\u001b[77Gdo\u001b[80Gold\u001b[84Gmod\u001b[88Gpatches.\u001b[97GScene\u001b[103Gfiles\u001b[109Gare\u001b[113Gnow\r\u001b[2C\u001b[1B \u001b[5Gformat 3; older scen\u001b[26G fil\u001b[31Gs with a \u001b[38;2;177;185;249mcelestial:\u001b[39m entry are refuse\u001b[68G with\u001b[74Gan\u001b[77Gerr\u001b[81Gr naming \u001b[91Ghe field rather th\u001b[110Gn migrated,\r\u001b[4C\u001b[1Band the five scene files in\u001b[33Gthe repo were updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has\u001b[18Gno saves of\u001b[31Gts own, s\u001b[42Git needed no migration.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[40G\u001b[22mFive\u001b[45GJettison\u001b[54Gpins\u001b[59Gand\u001b[63Gfour\u001b[68GManifest\u001b[77Gpins\u001b[82Gmoved.\r\u001b[2C\u001b[1B- I temporarily put back the old names, the ver\u001b[51Gion numbers\u001b[63Gand the two dropped components.\u001b[95GEvery\u001b[101GJettison\u001b[110Gpin\r\u001b[2C\u001b[1B \u001b[5Gre\u001b[8Gurned to its old value,\u001b[32Gan\u001b[36GM\u001b[38Gnifes\u001b[44G's\u001b[47Gtree from before this change pass\u001b[83Gall 54 suites agains\u001b[104G that\u001b[110Gengine.\r\u001b[2C\u001b[1B-\u001b[5GB\u001b[7Gfo\u001b[10Ge editing,\u001b[21Gthe\u001b[25Gold build wrote a save of a busy harbour\u001b[K\r\u001b[2C\u001b[1B \u001b[5G(\u001b[38;2;177;185;249msource/engine/dock/tests/fixtures/saves/harbour-version-4.world\u001b[39m).\u001b[72GA\u001b[74Gnew\u001b[78Gtest\u001b[83Gloads\u001b[89Git\u001b[92Gand\u001b[96Gchecks\u001b[103Git\u001b[106Greaches\u001b[114Gthe\r\u001b[4C\u001b[1Bsame state this build reaches from the same start.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLeft out on purpose:\u001b[24G\u001b[22mthe\u001b[28Gword\u001b[33G\"system\"\u001b[42Galone\u001b[48Gisn't\u001b[54Gon\u001b[57Gthe\u001b[61Gvocabulary\u001b[72Glist,\u001b[78Gso\u001b[81GI\u001b[83Gkept\u001b[88G\u001b[38;2;177;185;249mPhysics.Pick\u001b[39m's\u001b[103G\u001b[38;2;177;185;249msystem\u001b[110G\u001b[39mfield\u001b[116Gand\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.451, "o", "\u001b[?25l\u001b[H\u001b[5GThe save format is now version 5.\u001b[39GComponent type names are renamed in the s\u001b[81Gve's table of n\u001b[97Gme\u001b[100G. Fields are renamed\r\u001b[4C\u001b[1Bper\u001b[9Gtype,\u001b[15Gby\u001b[18Geach\u001b[23Gcomponent's\u001b[35Gown\u001b[39Gmigration,\u001b[50Gbecause\u001b[58Ga\u001b[60Gblanket\u001b[68Grename\u001b[75Gwould\u001b[81Galso\u001b[86Ghit\u001b[90GManifest's\u001b[101Gown\u001b[105G\u001b[38;2;177;185;249mship\u001b[110G\u001b[39mand\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mpadClass\u001b[39m fields.\r\u001b[4C\u001b[1BFi\u001b[8Glds in co\u001b[18Gmand\u001b[24Gstill queued in an \u001b[44Gld save are r\u001b[58Gnamed\u001b[64Gas th\u001b[70Gy\u001b[72Gare r\u001b[78Gad, and\u001b[86Gstor\u001b[91Gd dropp\u001b[99Gd components a\u001b[115G\u001b[K\r\u001b[4C\u001b[1Bskipped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOlder definition\u001b[22Gfiles\u001b[28G(berths,\u001b[37Gvehicles,\u001b[47Gplatforms)\u001b[58Gstill\u001b[64Gload,\u001b[70Gand\u001b[74Gso\u001b[77Gdo\u001b[80Gold\u001b[84Gmod\u001b[88Gpatches.\u001b[97GScene\u001b[103Gfiles\u001b[109Gare\u001b[113Gnow\r\u001b[2C\u001b[1B \u001b[5Gformat\u001b[12G3;\u001b[15Golder scene files with a\u001b[40G\u001b[38;2;177;185;249mcelestial:\u001b[39m entry are refu\u001b[66Ged with an \u001b[78Grror \u001b[84Gaming the field rather than\u001b[112Gmigrated,\r\u001b[4C\u001b[1Band the five\u001b[18Gscene\u001b[24Gfiles\u001b[30Gin\u001b[33Gthe\u001b[37Grepo\u001b[42Gwere\u001b[47Gupdated.\r\u001b[4C\u001b[1BManifest has n\u001b[20G saves of its own, so it needed no migration.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[22m Fiv\u001b[44G Jettison pins\u001b[59Gand\u001b[63Gfour\u001b[68GManifest\u001b[77Gpins\u001b[82Gmoved.\r\u001b[4C\u001b[1BI temporarily put back the old \u001b[37Games, \u001b[44Ghe version\u001b[55Gnumbers and\u001b[67Gthe\u001b[71Gtwo\u001b[75Gdropped\u001b[83