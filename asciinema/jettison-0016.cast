[3.856, "o", "\u001b[?25l\u001b[H\u001b[3G53\u001b[6Gsuites\u001b[13Gpass o\u001b[20G this engine,\u001b[34Gso no\u001b[40Gpinned\u001b[47Ghash moved.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat 4b does:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA neutral \"pas\u001b[20Gag\u001b[23G\" in\u001b[28G\u001b[38;2;177;185;249mtransit\u001b[39m:\u001b[38G\u001b[22mny game can now\u001b[55Gake \u001b[60Gn entity o\u001b[71Gt of physics and move it along a\u001b[104Gpath.\u001b[110GThe entity\r\u001b[4C\u001b[1Bkeeps its body while\u001b[26Git travels. The path moves\u001b[53Gwith\u001b[58Ga\u001b[60Gcarrier\u001b[68Gthe\u001b[72Ggame\u001b[77Gplaces,\u001b[85Geither\u001b[92Geasing\u001b[99Gin\u001b[102Gand\u001b[106Gout\u001b[110Gor\r\u001b[2C\u001b[1B \u001b[5Gfollowing a motion profile. The step\u001b[42G before arriv\u001b[56Gl are quiet, so fast-f\u001b[79Grward\u001b[85Gskips\u001b[91Gthem.\u001b[97GOn\u001b[100Garrival\u001b[108Gthe\u001b[112Gentity\r\u001b[4C\u001b[1Bcomes\u001b[11Gout\u001b[15Gat\u001b[18Grest,\u001b[24Gin\u001b[27Ga\u001b[29Gframe\u001b[35Gthe\u001b[39Ggame\u001b[44Gnames,\u001b[51Gclear\u001b[57Gof\u001b[60Ganything\u001b[69Galready\u001b[77Gthere.\u001b[84G\u001b[38;2;177;185;249mTransit::Passages\u001b[102G\u001b[39mruns\u001b[107Gthese.\r\u001b[2C\u001b[1B- \u001b[1mIn\u001b[8Gep\u001b[11Gndent tests in the \u001b[38;2;177;185;249mtransit\u001b[39m suite:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- A lift car rises\u001b[24Gon\u001b[27Ga\u001b[29Gprofile\u001b[37Gand\u001b[41Gcomes\u001b[47Gout\u001b[51Gbeside\u001b[58Ga\u001b[60Gcar\u001b[64Gparked\u001b[71Gat\u001b[74Gthe\u001b[78Gtop.\r\u001b[2C\u001b[1B \u001b[5G- A train runs on\u001b[23Ga moving fe\u001b[35Gry. Fast-forwarded and stepped\u001b[66Gruns give identical saves at every stop, with 65\u001b[115Gcalls\r\u001b[4C\u001b[1B  wher\u001b[12G stepping takes about 1,800 steps\u001b[47GA world loaded mid-way ends with the same sta\u001b[93Ge hash as\u001b[103Gthe\u001b[107Gstepp\u001b[113Gd one.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cruise is rebuilt on those parts:\u001b[43G\u001b[22mits\u001b[47Gmaths\u001b[53Gmoved\u001b[59Gunchanged\u001b[69Gand\u001b[73Gits\u001b[77Gsaved\u001b[83G\u001b[38;2;177;185;249mCruising\u001b[92G\u001b[39mcomponent\u001b[102Gis\u001b[105Gkept.\u001b[111GLanes\u001b[117Gand\r\u001b[4C\u001b[1Bgates\u001b[11Guse\u001b[15Gthe\u001b[19Gsame\u001b[24Gshared\u001b[31Gpieces,\u001b[39Gso\u001b[42GSpace's\u001b[50Gprivate\u001b[58Gcopy\u001b[63Gof\u001b[66Gthem\u001b[71Gis\u001b[74Gdeleted.\r\u001b[2C\u001b[1B- \u001b[1mOne change outside the slice:\u001b[22m I added \u001b[38;2;177;185;249mtransit\u001b[39m t\u001b[53G th\u001b[57G gate's ASan unit-test stage \u001b[89G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m, since it n\u001b[115Gw\u001b[K\r\u001b[2C\u001b[1B  carries the cruis\u001b[23G's movem\u001b[32Gnt an\u001b[38G sav\u001b[43G/load.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/architecture.md\u001b[26G\u001b[39mhas\u001b[30Ga\u001b[32Gnew\u001b[36G\"Transit\"\u001b[46Gsection,\u001b[55Gand\u001b[59Gthe\u001b[63Gplan\u001b[68Gmarks\u001b[74G4b\u001b[77Gdone.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done:\r\u001b[1B\u001b[22m \u001b[3G- Nothing is pushed.\u001b[K\r\u001b[2C\u001b[1B- Manifest's switch to the neutral names is still uncommitted. It can't be committed until Manifest's pin moves to 4a\u001b[K\r\u001b[2C\u001b[1B  or later, which needs this branch pushed. Say if you want\u001b[63Gme\u001b[66Gto\u001b[69Gpush\u001b[74Gand\u001b[78Gmove\u001b[83Gthe\u001b[87Gpin;\u001b[92Gthat\u001b[97Gwould\u001b[103Gget\u001b[107GManifest's\u001b[27;1H\u001b[24;3H\u001b[?25h"]
