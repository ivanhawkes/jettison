[0.152, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/s\u001b[31Gurce/test/FixtureTest\u001b[53G.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[8C\u001b[1B\u001b[2m7\u001b[14G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(replayed.world.\u001b[38;2;166;226;46mStateHash\u001b[39m() == hosted.world.\u001b[38;2;166;226;46mStateHash\u001b[39m());\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 768 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 769 \u001b[22m   \u001b[38;2;117;113;94m// The same in every build the gate runs; it moves as the fixture's does.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 770 -\u001b[38;2;248;248;242m  CHECK(hosted.world.StateHash() == \u001b[48;2;92;2;0m0xfa54e27c72cfd4d0ULL\u001b[48;2;61;1;0m);                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 770 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(hosted.world.\u001b[38;2;166;226;46mStateHash\u001b[38;2;248;248;242m() == \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m0x8c303288a407e262ULL\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m);                                           \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m1\u001b[12G\u001b[22m}\r\u001b[5C\u001b[1B\u001b[2m 772 \r\u001b[2C\u001b[1B\u001b[22m   \u001b[2m 773 \u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth\u001b[8Grepos\u001b[14Gare\u001b[18Ggreen:\u001b[25GJettison\u001b[34G31\u001b[37Gof\u001b[40G31\u001b[43Gsuites,\u001b[51GManifest\u001b[60G54\u001b[63Gof\u001b[66G54\u001b[69Gon\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine.\u001b[90GNext:\u001b[96GManifest's\u001b[107Gdocs,\u001b[113Gthen\u001b[118Gthe\r\u001b[1B \u001b[3Gextraction plan\u001b[19Gentry, tidy,\u001b[32Gformat,\u001b[40Gand\u001b[44Gthe\u001b[48Ggate.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWriting ~/projects/manifest/docs/small-trader-and-docking-plan.md\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Wri\u001b[10Ge(~/pr\u001b[17Gjects/manifes\u001b[31G/docs/small-trader-and-dockin\u001b[61G-plan.md)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
