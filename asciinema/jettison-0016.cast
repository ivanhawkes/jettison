[0.314, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mbyShape\u001b[39m, and the \u001b[23Gcene's\u001b[30G\u001b[38;2;177;185;249mcelestial\u001b[40G\u001b[39mrec\u001b[44Gr\u001b[47G→ \u001b[38;2;177;185;249mbody\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSaved values and keys:\u001b[28G\u001b[22mthe\u001b[32Gdocks'\u001b[39Gshape\u001b[45Gnames\u001b[51Ggo\u001b[54Gfrom\u001b[59G\u001b[38;2;177;185;249mhulls/\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249mstations/\u001b[80G\u001b[39mto\u001b[83G\u001b[38;2;177;185;249mvehicles/\u001b[93G\u001b[39mand\u001b[97G\u001b[38;2;177;185;249mplatforms/\u001b[39m,\u001b[109Gand\u001b[113Gthe\u001b[117Gdock\r\u001b[2C\u001b[1B \u001b[5Greasons' keys are renamed in the \u001b[39Gn and de string tables.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDropped:\u001b[22m \u001b[38;2;177;185;249mDock.Transfer\u001b[39m and \u001b[38;2;177;185;249mDock.Buggy\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m its space types are now \u001b[38;2;177;185;249mSpace.*\u001b[47G\u001b[39minstea\u001b[54G of\u001b[58G\u001b[38;2;177;185;249mCelestial.*\u001b[70G\u001b[39mand\u001b[74G\u001b[38;2;177;185;249mAi.*\u001b[39m,\u001b[80Gand\u001b[84Gits\u001b[88Gdock\u001b[93Gdata\u001b[98Guses\u001b[103Gthe\u001b[107Gnew\u001b[111Gkeys.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow old saves load\r\u001b[2C\u001b[1B\u001b[22m- The save format is now version 5. Componen\u001b[48G type\u001b[54Gnames are renamed in \u001b[76Ghe save's table\u001b[92Gof\u001b[95Gnames.\u001b[102GFields\u001b[109Gare\u001b[113Grenamed\r\u001b[2C\u001b[1B \u001b[5Gper type, by each\u001b[23Gcomponent's own migration, because a blanket r\u001b[70Gname\u001b[75Gwould als\u001b[85G hit Manifest's\u001b[101Gown \u001b[38;2;177;185;249mship\u001b[110G\u001b[39mand\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpadClass\u001b[14G\u001b[39mfield\u001b[20G.\u001b[K\r\u001b[4C\u001b[1BFields\u001b[12Gin commands still queued in an\u001b[43Gold save are ren\u001b[60Gmed as\u001b[67Gthey\u001b[72Gare\u001b[76Gread,\u001b[82Gand\u001b[86Gstored\u001b[93Gdropped\u001b[101Gcomponents\u001b[112Gare\r\u001b[4C\u001b[1Bskipped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOld\u001b[9Gr definit\u001b[19Gon f\u001b[25Ges (berths, vehicle\u001b[45G, pla\u001b[51Gforms)\u001b[58Gstill\u001b[64Gload,\u001b[70Gand\u001b[74Gso\u001b[77Gdo\u001b[80Gold\u001b[84Gmod\u001b[88Gpatches.\u001b[97GScene\u001b[103Gfiles\u001b[109Gare\u001b[113Gnow\r\u001b[4C\u001b[1Bformat\u001b[12G3;\u001b[15Golder\u001b[21Gscene\u001b[27Gfiles\u001b[33Gwith\u001b[38Ga\u001b[40G\u001b[38;2;177;185;249mcelestial:\u001b[51G\u001b[39mentry\u001b[57Gare\u001b[61Grefused\u001b[69Gwith\u001b[74Gan\u001b[77Gerror\u001b[83Gnaming\u001b[90Gthe\u001b[94Gfield\u001b[100Grather\u001b[107Gthan\u001b[112Gmigrated,\r\u001b[2C\u001b[1B  and the five scene\u001b[24Gfiles in\u001b[33Gthe r\u001b[39Gpo\u001b[42Gwere updated.\u001b[K\r\u001b[2C\u001b[1B- Manifest has no s\u001b[23Gves of its own, so it needed no migration.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[40G\u001b[22mFive\u001b[45GJettison\u001b[54Gpins\u001b[59Gand\u001b[63Gfour\u001b[68GManifest\u001b[77Gpins\u001b[82Gmoved.\r\u001b[2C\u001b[1B- I t\u001b[9Gmporarily put back the o\u001b[35G n\u001b[38Gmes, \u001b[44Ghe version numbers and the two dr\u001b[78Gpp\u001b[81Gd components. Every Jettison pin\u001b[114G\u001b[K\r\u001b[2C\u001b[1B  \u001b[6Ge\u001b[8Gurn\u001b[12Gd to its\u001b[21Gold\u001b[25Gv\u001b[27Glue, and Manifest's \u001b[76Gpas\u001b[80Ged all 54\u001b[90Gsuites against tha\u001b[109G engine.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
