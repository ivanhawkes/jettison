[0.174, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate\u001b[12Gpasses (212 s).\u001b[28GI'm folding the \u001b[38;2;177;185;249mci.sh\u001b[39m fix into \u001b[60Ghe commit, then\u001b[76Gr\u001b[78Gbu\u001b[81Glding Manifest on the engine as\u001b[K\r\u001b[2C\u001b[1Bcommitted, now wi\u001b[21Ghout\u001b[26G\u001b[38;2;177;185;249mspace\u001b[39m,\u001b[33Gand\u001b[37Gmoving\u001b[44Gits\u001b[48Gpin.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projec\u001b[19Gs/ma\u001b[24Gifes\u001b[29G/\u001b[31Gourc\u001b[36G/external/CMakeLists.\u001b[58Gxt)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\r\u001b[6C\u001b[1B\u001b[2m1 \u001b[22m \u001b[38;2;117;113;94m# Jettison feature-base, pinned rather than following main or a moving branch.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m \u001b[22m \u001b[38;2;117;113;94m# Updating this commit and the development shell is one SDK change. Fetch the engine\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 3 \u001b[10G\u001b[22m\u001b[38;2;117;113;94m# first: EnTT, yaml-cpp and doctest must be its targets, never second copies here.\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 4 -\u001b[38;2;248;248;242mset(MANIFEST_JETTISON_REVISION 3cd98290279cb0bd077230b73cb8b0eaad6e8483)                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 4 +\u001b[38;2;249;38;114mset\u001b[38;2;248;248;242m(MANIFEST_JETTISON_REVISION b7d45807d7b1250fa4cfaede4556db022619faf6)                                \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 5 \u001b[22m \u001b[38;2;249;38;114mset\u001b[39m(JETTISON_SOURCE_DIR \u001b[38;2;230;219;116m\"\"\u001b[39m CACHE PATH \u001b[38;2;230;219;116m\"Use a local Jettison checkout instead of the pinned revision\"\u001b[39m)\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 6 \u001b[22m \u001b[38;2;249;38;114mif\u001b[39m(\u001b[38;2;249;38;114mNOT\u001b[39m \u001b[38;2;249;38;114mTARGET\u001b[39m Jettison::\u001b[38;2;249;38;114mMath\u001b[39m)\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 7 \u001b[14G\u001b[22m\u001b[38;2;249;38;114mif\u001b[39m(JETTISON_SOURCE_DIR)\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd\u001b[11G'/home/ivan/p\u001b[26Gjects/manifest' &&\u001b[45Gcmake build/sdk-local > /\u001b[71Gev/n\u001b[76Gl\u001b[78G && cmake --build\u001b[96Gbuild/sdk-\u001b[107Gocal -j\u001b[115G24 \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m2>&1 | grep -E \"error|FAILED|warning:\" | head -20; ctest --test-dir build/sdk-local -j 24 2>&1 | tail -4\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[24G\u001b[38;2;153;153;153m7\r\u001b[18C\u001b[6B(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
