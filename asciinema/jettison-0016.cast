;153;153m · 7s\u001b[39m…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build --preset clang-debug --target jettison_dock_tests jettison_space_tests 2>&1 | grep -E \"error:\" | \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153msort -u\u001b[14G| head -30\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
