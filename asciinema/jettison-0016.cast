[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mpush\u001b[39m                                                                                                                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gpushed\u001b[12G\u001b[38;2;177;185;249mfeature-base\u001b[25G\u001b[39mto\u001b[28Gorigin,\u001b[36G\u001b[38;2;177;185;249m5ef3346..f194dd1\u001b[39m,\u001b[54Gso\u001b[57Gthe\u001b[61G4a\u001b[64Gand\u001b[68G4b\u001b[71Gcommits\u001b[79Gare\u001b[83Gnow\u001b[87Gon\u001b[90GGitHub.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BManifest's\u001b[14Gpin\u001b[18Ghasn't\u001b[25Gmoved,\u001b[32Gand\u001b[36Gits\u001b[40Gswitch\u001b[47Gto\u001b[50Gthe\u001b[54Gneutral\u001b[62Gnames\u001b[68Gis\u001b[71Gstill\u001b[77Guncommitted\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249m../manifest\u001b[39m.\u001b[105GNow\u001b[109Gthat\u001b[114Gthe\r\u001b[2C\u001b[1Bpush i\u001b[10G done, t\u001b[19Go\u001b[21Ge can go in. Moving the pin to \u001b[38;2;177;185;249mf194dd1\u001b[39m and comm\u001b[69Gtting them means running Manifest's\u001b[105Gfull g\u001b[113Ge first.\r\u001b[2C\u001b[1BSay if you wan\u001b[18G that, or I'll go on to 4c.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 23s · done 10:41 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mgo\u001b[39m                                                                                                                    \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m2\u001b[13G\u001b[22mshell\u001b[19Gcommands…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  1 action not run ·