[0.006, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BManifest's SDK pin hasn't\u001b[29Gm\u001b[31Gved yet. When\u001b[45Gyou want it moved, it\u001b[67Gshould go to\u001b[80G\u001b[38;2;177;185;249m0c37e69\u001b[39m, the last code commit; \u001b[38;2;177;185;249m5ef3346\r\u001b[2C\u001b[1B\u001b[39mwould also work.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 25s · done 9:37 pm\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mis it safe to /clear\u001b[39m                                                                                                  \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Git's\u001b[13Gsafe.\u001b[19GEverything\u001b[30Gfrom\u001b[35Gthis\u001b[40Gsession\u001b[48Gis\u001b[51Gcommitted\u001b[61Gand\u001b[65Gpushed,\u001b[73Gthe\u001b[77Gworking\u001b[85Gtree\u001b[90Gis\u001b[93Gclean,\u001b[100Gand\u001b[104Gnothing\u001b[112Gis\u001b[115Gstill\r\u001b[1B \u001b[3Grunning. The work done, the save-migration\u001b[46Gdecision\u001b[55Gand\u001b[59Gthe\u001b[63Gnote\u001b[68Gto\u001b[71Grevisit\u001b[79Git\u001b[82Gare\u001b[86Gall\u001b[90Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdocs/space-extraction-plan.md\u001b[39m,\u001b[34Gso\u001b[37Ga\u001b[39Gnew\u001b[43Gsession\u001b[51Gwill\u001b[56Gfind\u001b[61Gthem.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Grecords\u001b[19Gyet\u001b[23Gthat\u001b[28GManifest's\u001b[39GSDK\u001b[43Gpin\u001b[47Gstill\u001b[53Gneeds\u001b[59Gmoving\u001b[66Gto\u001b[69G\u001b[38;2;177;185;249m0c37e69\u001b[39m,\u001b[78Gso\u001b[81Gmention\u001b[89Git\u001b[92Gwhen\u001b[97Gyou\u001b[101Gstart\u001b[107Gthe\u001b[111Gnext\r\u001b[1B \u001b[3Gs\u001b[6Gsion. Th\u001b[15Gt pin can be moved before slice 4, or lef\u001b[57G to\u001b[61Gmove onc\u001b[70G af\u001b[74Ger\u001b[77Gslice 4.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCog