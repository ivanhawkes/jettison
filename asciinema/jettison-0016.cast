[0.105, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m8\u001b[12G\u001b[22mthe game says its rover \u001b[37Gas shown it moved (`SmokeActions::pil\u001b[75Gting`): past 1 m/s \u001b[95Gh\u001b[97Gad, then 10\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 579 \u001b[22m degrees turned, since a stage's four frames are fast or slow with the machine and the rover moves by\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 580 \u001b[22m simulation time. The game logs each, and the run fails unless it said both; a rover that never\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(scripts/\u001b[19Gmoke-test.sh)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 232 \u001b[16G\u001b[22m\u001b[38;2;249;38;114mif\u001b[19G\u001b[39m[\u001b[21G\u001b[38;2;230;219;116m\"\u001b[39m$packed\u001b[38;2;230;219;116m\"\u001b[31G\u001b[39m-eq\u001b[35G1\u001b[37G];\u001b[40G\u001b[38;2;249;38;114mthen\u001b[45G\u001b[38;2;166;226;46mrm\u001b[48G\u001b[39m-rf\u001b[52G\u001b[38;2;230;219;116m\"\u001b[39m$packed_user\u001b[38;2;230;219;116m\"\u001b[39m;\u001b[68G\u001b[38;2;249;38;114mfi\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 233 \u001b[22m   \u001b[38;2;249;38;114mdone\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 234 \u001b[12G\u001b[22m \u001b[14G\u001b[38;2;117;113;94m# The ground sample, from its staged content, packed or not: its scene, the rover its piloting\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 235 -\u001b[38;2;248;248;242m  # stages drive and the camera behind it\u001b[48;2;92;2;0m, and no jump, since it has none\u001b[48;2;61;1;0m.                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 235 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m# stages drive and the camera behind it.\u001b[38;2;248;248;242m                                                            \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m6\u001b[14G\u001b[22m\u001b[38;2;166;226;46mecho\u001b[39m \u001b[38;2;230;219;116m\"smoke-test: the ground sample\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 237 \u001b[22m   ground_command=()\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 238 \u001b[22m   \u001b[38;2;249;38;114mfor\u001b[39m word \u001b[38;2;249;38;114min\u001b[39m \u001b[38;2;230;219;116m\"\u001b[39m$@\u001b[38;2;230;219;116m\"\u001b[39m; \u001b[38;2;249;38;114mdo\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cmake --build --preset\u001b[34Gclang-debug\u001b[46G2>&1\u001b[51G|\u001b[53Ggrep\u001b[58G-E…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build --preset clang-debug 2>&1 | grep -E 'error|warning: ' -A3 | grep -v '^/nix' | head -30; ctest \r\u001b[5C\u001b[1B--test-dir build/clang-debug -j 24 2>&1 | tail -4; ./scripts/format-check.sh 2>&1 | tail -2; ./scripts/tidy.sh \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m--summary 2>&1 | tail -2\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
