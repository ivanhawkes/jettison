[0.340, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GOlder d\u001b[13Gfinition files (berths, veh\u001b[41Gcles, platform\u001b[56G)\u001b[58Gsti\u001b[62Gl load, and so do old mod patches. Scene files are now\r\u001b[4C\u001b[1Bformat 3; older scene\u001b[27Gfiles\u001b[33Gwith\u001b[38Ga\u001b[40G\u001b[38;2;177;185;249mcelestial:\u001b[51G\u001b[39mentry\u001b[57Gare\u001b[61Grefused\u001b[69Gwith\u001b[74Gan\u001b[77Gerror\u001b[83Gnaming\u001b[90Gthe\u001b[94Gfield\u001b[100Grather\u001b[107Gthan\u001b[112Gmigrated,\r\u001b[2C\u001b[1B \u001b[5Gand the five scene\u001b[24Gfiles\u001b[30Gin the\u001b[37Grepo were\u001b[47Gupdated.\u001b[56G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManif\u001b[11Gst\u001b[14Ghas\u001b[18Gno\u001b[21Gsaves\u001b[27Gof\u001b[30Gits\u001b[34Gown,\u001b[39Gso\u001b[42Git\u001b[45Gneeded\u001b[52Gno\u001b[55Gmigration.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[40G\u001b[22mFive Jettiso\u001b[53G pins and \u001b[64Gour Manifest\u001b[77Gpins moved.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI temporarily put back the old names, th\u001b[47Gversion numbers\u001b[63Gand\u001b[67Gthe\u001b[71Gtwo\u001b[75Gdropped\u001b[83Gcomponents.\u001b[95GEvery\u001b[101GJettison\u001b[110Gpin\r\u001b[2C\u001b[1B \u001b[5Greturned\u001b[14Gto its\u001b[21Gold value, and Manifes\u001b[44G's tr\u001b[50Ge\u001b[52Gfro\u001b[56G before this\u001b[69Gchange\u001b[76Gpassed\u001b[83Gall\u001b[87G54\u001b[90Gsuites\u001b[97Gagainst\u001b[105Gthat\u001b[110Gengine.\r\u001b[2C\u001b[1B-\u001b[5GBefore\u001b[12Gediting,\u001b[21Gthe\u001b[25Gold\u001b[29Gbuild\u001b[35Gwrote\u001b[41Ga\u001b[43Gsave\u001b[48Gof\u001b[51Ga\u001b[53Gbusy\u001b[58Gharbour\r\u001b[2C\u001b[1B  (\u001b[38;2;177;185;249msource/engine/dock/tests/fixtures/saves/harbour-version-4.world\u001b[39m). A new te\u001b[81Gt loa\u001b[87Gs\u001b[89Git\u001b[92Gand\u001b[96Gchecks\u001b[103Git\u001b[106Greaches\u001b[114Gthe\r\u001b[2C\u001b[1B \u00