[0.004, "o", "\u001b[?25l\u001b[H\u001b[5Gcomes o\u001b[13Gt at rest, in\u001b[27Ga\u001b[29Gframe\u001b[35Gthe\u001b[39Ggame\u001b[44Gnames,\u001b[51Gclear\u001b[57Gof\u001b[60Ganything\u001b[69Galready\u001b[77Gthere.\u001b[84G\u001b[38;2;177;185;249mTransit::Passages\u001b[102G\u001b[39mruns\u001b[107Gthese.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIndependent tests in the \u001b[38;2;177;185;249mtransit\u001b[39m suite:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- A lift car rises on a profile and comes out beside a car parked at the top.\u001b[K\r\u001b[4C\u001b[1B- A train runs on a moving ferry. Fast-forwarded and stepped runs give identical saves at every stop, with 65\u001b[115Gcalls\r\u001b[5C\u001b[1B where\u001b[13Gstepping takes about\u001b[34G1,800 steps. A world loaded mid-way ends with the same s\u001b[91Ga\u001b[94G hash as th\u001b[106G stepped\u001b[115Gone.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cruise is rebuilt on those parts:\u001b[43G\u001b[22mits\u001b[47Gmaths\u001b[53Gmoved\u001b[59Gunchanged\u001b[69Gand\u001b[73Gits\u001b[77Gsaved\u001b[83G\u001b[38;2;177;185;249mCruising\u001b[92G\u001b[39mcomponent\u001b[102Gis\u001b[105Gkept.\u001b[111GLanes\u001b[117Gand\r\u001b[4C\u001b[1Bgates use\u001b[15Gth\u001b[18G same sha\u001b[28Ged pi\u001b[34Gces, so Space's private copy of them is dele\u001b[79Ged.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne change outside the slice:\u001b[22m I added \u001b[38;2;177;185;249mtransit\u001b[39m to the gate'\u001b[65GASan unit-tes\u001b[79G \u001b[82Gage\u001b[86Gin\u001b[89G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m,\u001b[104Gsince\u001b[110Git\u001b[113Gnow\r\u001b[4C\u001b[1Bcarries the cruise's movement and save/load.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/architecture.md\u001b[39m has a new \"Transit\" section, and the plan marks 4b done.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNothing\u001b[13Gis\u001b[16Gpushed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest's\u001b[16Gswitch\u001b[23Gto\u001b[26Gthe\u001b[30Gneutral\u001b[38Gnames\u001b[44Gis\u001b[47Gstill\u001b[53Guncommitted.\u001b[66GIt\u001b[69Gcan't\u001b[75Gbe\u001b[78Gcommitted\u001b[88Guntil\u001b[94GManifest's\u001b[105Gpin\u001b[109Gmoves\u001b[115Gto\u001b[118G4a\r\u001b[4C\u001b[1Bor later,\u001b[15Gwhich\u001b[21Gneeds\u001b[27Gthis\u001b[32Gbranch\u001b[39Gpushed.\u001b[47GSay\u001b[51Gif\u001b[54Gyou\u001b[58Gwant\u001b[63Gme\u001b[66Gto\u001b[69Gpush\u001b[74Gand\u001b[78Gmove\u001b[83Gthe\u001b[87Gpin;\u001b[92Gthat\u001b[97Gwould\u001b[103Gget\u001b[107GManifest's\r\u001b[4C\u001b[1Bfull\u001b[10Ggate\u001b[15Gfirst.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mNext is 4c\u001b[22m, rebuilding the lanes on portals: a door between\u001b[63Gtwo\u001b[67Gframes\u001b[74Gand\u001b[78Gone\u001b[82Gwithin\u001b[89Ga\u001b[91Gframe.\u001b[98GOpus\u001b[103Gat\u001b[106Ghigh\u001b[111Geffort\r\u001b[2C\u001b[1Bagain:\u001b[10Git's\u001b[15Gthe\u001b[19Gsame\u001b[24Gkeep-the-saved-bytes\u001b[45Gwork,\u001b[51Gon\u001b[54G\u001b[38;2;177;185;249mOnLane\u001b[39m.\u001b[62GNow\u001b[66Gis\u001b[69Ga\u001b[71Ggood\u001b[76Gpoint\u001b[82Gto\u001b[85G\u001b[38;2;177;185;249m/compact\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCrunched for 16m 55\u001b[23G · done\u001b[31G10:25 \u001b[38Gm\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
