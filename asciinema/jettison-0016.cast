[0.025, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mpadClass\u001b[14G\u001b[39mfield\u001b[20G.\u001b[K\r\u001b[4C\u001b[1BFields\u001b[12Gin commands still queued in an\u001b[43Gold save are ren\u001b[60Gmed as\u001b[67Gthey\u001b[72Gare\u001b[76Gread,\u001b[82Gand\u001b[86Gstored\u001b[93Gdropped\u001b[101Gcomponents\u001b[112Gare\r\u001b[4C\u001b[1Bskipped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOld\u001b[9Gr definit\u001b[19Gon f\u001b[25Ges (berths, vehicle\u001b[45G, pla\u001b[51Gforms)\u001b[58Gstill\u001b[64Gload,\u001b[70Gand\u001b[74Gso\u001b[77Gdo\u001b[80Gold\u001b[84Gmod\u001b[88Gpatches.\u001b[97GScene\u001b[103Gfiles\u001b[109Gare\u001b[113Gnow\r\u001b[4C\u001b[1Bformat\u001b[12G3;\u001b[15Golder\u001b[21Gscene\u001b[27Gfiles\u001b[33Gwith\u001b[38Ga\u001b[40G\u001b[38;2;177;185;249mcelestial:\u001b[51G\u001b[39mentry\u001b[57Gare\u001b[61Grefused\u001b[69Gwith\u001b[74Gan\u001b[77Gerror\u001b[83Gnaming\u001b[90Gthe\u001b[94Gfield\u001b[100Grather\u001b[107Gthan\u001b[112Gmigrated,\r\u001b[2C\u001b[1B  and the five scene\u001b[24Gfiles in\u001b[33Gthe r\u001b[39Gpo\u001b[42Gwere updated.\u001b[K\r\u001b[2C\u001b[1B- Manifest has no s\u001b[23Gves of its own, so it needed no migration.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProof the pins moved by names alone.\u001b[40G\u001b[22mFive\u001b[45GJettison\u001b[54Gpins\u001b[59Gand\u001b[63Gfour\u001b[68GManifest\u001b[77Gpins\u001b[82Gmoved.\r\u001b[2C\u001b[1B- I t\u001b[9Gmporarily put back the o\u001b[35G n\u001b[38Gmes, \u001b[44Ghe version numbers and the two dr\u001b[78Gpp\u001b[81Gd components. Every Jettison pin\u001b[114G\u001b[K\r\u001b[2C\u001b[1B  \u001b[6Ge\u001b[8Gurn\u001b[12Gd to its\u001b[21Gold\u001b[25Gv\u001b[27Glue, and Manifest's tree from\u001b[57Gbefore this c\u001b[71Gange\u001b[76Gpas\u001b[80Ged all 54\u001b[90Gsuites against tha\u001b[109G engine.\u001b[K\r\u001b[2C\u001b[1B- Before editing,\u001b[21Gthe\u001b[25Gold\u001b[29Gbuild\u001b[35Gwrote\u001b[41Ga\u001b[43Gsave\u001b[48Gof\u001b[51Ga\u001b[53Gbusy\u001b[58Gharbour\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249msource/engine/dock/tests/fixtures/saves/harbour-version-4.world\u001b[39m).\u001b[72GA\u001b[74Gnew\u001b[78Gtest\u001b[83Gloads\u001b[89Git\u001b[92Gand\u001b[96Gchecks\u001b[103Git\u001b[106Greaches\u001b[114Gthe\r\u001b[1B \u001b[3G  same state this build reaches from\u001b[40Gthe\u001b[44Gsame\u001b[49Gstart.\r\u001b[2B  \u001b[1mLeft out on purpose:\u001b[22m the word \"system\" alone isn't on the vocabulary list, so I kept \u001b[38;2;177;185;249mPhysics.Pick\u001b[39m's \u001b[38;2;177;185;249msystem\u001b[39m field and\u001b[K\r\u001b[2C\u001b[1Bthe\u001b[7G\u001b[38;2;177;185;249mother_system\u001b[20G\u001b[39mreasons.\u001b[29GThe\u001b[33Gstring\u001b[40Gtables'\u001b[48Gwording\u001b[56G(\"the\u001b[62Gship…\")\u001b[70Gand\u001b[74Gthe\u001b[78G\u001b[38;2;177;185;249mtextures/hulls/\u001b[94G\u001b[39masset\u001b[100Gpaths\u001b[106Gare\u001b[110Galso\r\u001b[1B  unchanged.\u001b[K\r\u001b[2B \u001b[3GManifest's own gate, which builds\u001b[37Gagainst\u001b[45Gthe\u001b[49Gpinned\u001b[56Gcommit,\u001b[64Gcan\u001b[68Gonly\u001b[73Grun\u001b[77Gonce\u001b[82G\u001b[38;2;177;185;249m1297b9f\u001b[90G\u001b[39mis\u001b[93Gon\u001b[96GGitHub,\u001b[104Gso\u001b[107Gthat's\u001b[114Gthe\r\u001b[1B  first check after you say \"push\". Before slice 8, the close-out\u001b[67Gwith\u001b[72Gits\u001b[76Gcross-review,\u001b[90GI'd\u001b[94G\u001b[38;2;177;185;249m/compact\u001b[103G\u001b[39mand\u001b[107Gstay\u001b[112Gon\u001b[115GOpus\u001b[27;1H\u001b[24;3H\u001b[?25h"]
