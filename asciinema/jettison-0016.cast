[1B-\u001b[5G\u001b[1mDropped:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mDock.Transfer\u001b[39m and \u001b[38;2;177;185;249mDock.Buggy\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mManif\u001b[11Gst:\u001b[22m its space types are now \u001b[38;2;177;185;249mSpace.*\u001b[47G\u001b[39minstead\u001b[55Gof\u001b[58G\u001b[38;2;177;185;249mCelestial.*\u001b[70G\u001b[39mand\u001b[74G\u001b[38;2;177;185;249mAi.*\u001b[39m,\u001b[80Gand\u001b[84Gits\u001b[88Gdock\u001b[93Gdata\u001b[98Guses\u001b[103Gthe\u001b[107Gnew\u001b[111Gkeys.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow old saves load\r\u001b[2C\u001b[1B\u001b[22m- The save format is\u001b[24Gnow\u001b[28Gversion 5.\u001b[39GComponent\u001b[49Gtype\u001b[54Gnames\u001b[60Gare\u001b[64Grenamed\u001b[72Gin\u001b[75Gthe\u001b[79Gsave's\u001b[86Gtable\u001b[92Gof\u001b[95Gnames.\u001b[102GFields\u001b[109Gare\u001b[113Grenamed\r\u001b[2C\u001b[1B \u001b[5Gper\u001b[9Gtyp\u001b[13G, by each compon\u001b[30Gnt's own\u001b[39Gmigration, because a\u001b[60Gblank\u001b[66Gt r\u001b[70Gname\u001b[75Gwould also\u001b[86Ghit Manifest'\u001b[100G own \u001b[38;2;177;185;249mship\u001b[39m and\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mpadClass\u001b[39m fields.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFields in commands\u001b[24Gstill\u001b[30Gqueued\u001b[37Gin\u001b[40Gan\u001b[43Gold\u001b[47Gsave\u001b[52Gare\u001b[56Grenamed\u001b[64Gas\u001b[67Gthey\u001b[72Gare\u001b[76Gread,\u001b[82Gand\u001b[86Gstored\u001b[93Gdropped\u001b[101Gcomponents\u001b[112Gare\r\u001b[2C\u001b[1B \u001b[5Gskipped.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOlder \u001b[12Gefinition\u001b[22Gfiles\u001b[28G(berths,\u001b[37Gvehicles,\u001b[47Gplatforms)\u001b[58Gstill\u001b[64Gload,\u001b[70Gand\u001b[74Gso\u001b[77Gdo\u001b[80Gold\u001b[84Gmod\u001b[88Gpatches.\u001b[97GScene\u001b[103Gfiles\u001b[109Gare\u001b[113Gnow\r\u001b[2C\u001b[1B \u001b[5Gformat 3; older scen\u001b[26G fil\u001b[31Gs with a \u001b[38;2;177;185;249mcelestial:\u001b[39m entry are refuse\u001b[68G with\u001b[74Gan\u001b[77Gerr\u001b[81Gr naming \u001b[91Ghe field rather th\u001b[110Gn migrated,\r\u001b[4C\u001b[1Band the five scene files in\u001b[33Gthe repo were updated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has\u001b[18Gno saves of\u001b[31Gts own, s\u001b[42Git ne\u001b[27;1H\u001b[24;3H\u001b[?25h"]
