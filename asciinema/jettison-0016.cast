[0.955, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1BManifest no\u001b[19Glonger requires \u001b[38;2;177;185;249mJettison::C\u001b[47Glestial\u001b[39m or \u001b[38;2;177;185;249mJettison::Space\u001b[39m,\u001b[75Gan\u001b[78G it\u001b[83Gengine pin is\u001b[97Gmov\u001b[101Gd to \u001b[38;2;177;185;249mb7d4580\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison:\u001b[22m both modules are deleted.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- With no\u001b[15Gop\u001b[18Gional modules\u001b[32Gl\u001b[34Gft, \u001b[38;2;177;185;249mjettison_check_optional\u001b[62G\u001b[39mis\u001b[65Gnow\u001b[69G\u001b[38;2;177;185;249mjettison_check_dependencies\u001b[97G\u001b[39mand\u001b[101Gonly\u001b[106Gchecks\u001b[113Gthat\u001b[118Gno\r\u001b[4C\u001b[1B \u001b[7Gengine m\u001b[16Gdule needs a sample.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe words ch\u001b[20Gck now\u001b[27Gcovers \u001b[35Gvery\u001b[40Gmodule,\u001b[48Gand\u001b[52Gits\u001b[56Gallow-list\u001b[67Gstays\u001b[73Gempty.\r\u001b[10C\u001b[1Bm\u001b[13Gdule-graph docs are updated, along\u001b[48Gwith \u001b[54Ghe p\u001b[59Gan's \u001b[65Glice 6 entry.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSpace reasons' text:\u001b[22m the English and\u001b[42GGerman wording\u001b[57Gfor the space r\u001b[73Gasons\u001b[79Gleft\u001b[84Gthe\u001b[88Gengine's\u001b[97Gstring\u001b[104Gtables\u001b[111Gwith\u001b[116Gthe\r\u001b[2C\u001b[1B \u001b[5Gcode. Manifest has no stri\u001b[33G tables yet, so\u001b[49Gf\u001b[52G now\u001b[57Gthe\u001b[62Gext exists only in Jet\u001b[85Gison's history.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChecks:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mJettison:\u001b[15G\u001b[22mthe\u001b[19Gfull\u001b[24Ggate\u001b[29G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m)\u001b[47Gpassed\u001b[54Gin\u001b[57G212\u001b[61Gs.\u001b[64GThe\u001b[68Gfirst\u001b[74Grun\u001b[78Gfailed\u001b[85Gbecause\u001b[93G\u001b[38;2;177;185;249mci.sh\u001b[99G\u001b[39mstill\