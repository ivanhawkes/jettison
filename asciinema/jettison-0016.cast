[0.079, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, re\u001b[23Goved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[2m 157 \u001b[12G\u001b[22m \u001b[14Gwaypoints, the fa\u001b[32Glure\u001b[37Ghere,\u001b[43Gwhich\u001b[49Gplayers\u001b[57Gwork\u001b[62Ground\u001b[68Gwith\u001b[73Ga\u001b[75Gslow\u001b[80Gprecision\u001b[90Gmode\u001b[95Gor\u001b[98Gscripts.\u001b[107GSo\r\u001b[8C\u001b[1B\u001b[2m8\u001b[14G\u001b[22mthe solution: an app\u001b[35Goach corridor\u001b[49Gf\u001b[51Gown without stopping,\u001b[74Gt a speed that falls\u001b[95Gwith the\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[14G\u001b[22mdistance left; the station not an obstacle on the c\u001b[66Grr\u001b[69Gdor's l\u001b[77Gst l\u001b[82Gg, as it is not on the\u001b[105Gway\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 160 -\u001b[38;2;248;248;242m  down (`\u001b[48;2;92;2;0mbyHull\u001b[48;2;61;1;0m`); Arrive damping the velocity across its line rather than pursuing; and a            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 160 +\u001b[38;2;248;248;242m  down (`\u001b[48;2;4;71;0mbyShape\u001b[48;2;2;40;0m`); Arrive damping the velocity across its line rather than pursuing; and a           \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 161 \u001b[22m   reservation that lapses when a ship stops making progress rather than at a fixed time. Measured by\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[14G\u001b[22mships flow\u001b[26Gin from every side\u001b[45Gand speed,\u001b[56Gone queued b\u001b[69Ghind another on \u001b[86Ghe\u001b[89Gne\u001b[92Gt pad, and no\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[14G\u001b[22marrival slower\u001b[29Gthan\u001b[34Gth\u001b[37G stopgap's.\u001b[49G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u0