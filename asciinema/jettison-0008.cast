, \u001b[38;2;177;185;249mFastForward\u001b[39m and\u001b[34Gthe sim-suite tes\u001b[52Gs: fast-fo\u001b[63Gward and stepping give\u001b[86Gth\u001b[89G same\u001b[95Gh\u001b[97Gsh; \u001b[102G queued command\u001b[K\r\u001b[5C\u001b[1Btakes one step; \u001b[38;2;177;185;249muntil\u001b[28G\u001b[39mis\u001b[31Grespected;\u001b[42Ga\u001b[44Gsystem\u001b[51Gwith\u001b[56Gno\u001b[59Ghook\u001b[64Gstops\u001b[70Gany\u001b[74Gskip.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mHooks\u001b[22m for every engine system, plus \u001b[38;2;177;185;249mTaskWake\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mEngine acceptance tests:\u001b[31G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- a space-suite\u001b[22Gcru\u001b[26Gs\u001b[29Gpa\u001b[33G a station with pads\u001b[54Gand\u001b[58Gdocked\u001b[65Gships,\u001b[72Gfast-forwarded\u001b[87Gand\u001b[91Gstepped\u001b[99Gto\u001b[102Gthe\u001b[106Gsame\u001b[111Ghash\u001b[116Gat\r\u001b[2C\u001b[1B  \u001b[6G  every stop and the arrival\u001b[35Gstep;\u001b[27;1H\u001b[24;81H\u001b[?25h"]
[0.400, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mOrder of work\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mSpike\u001b[12G\u001b[22m(no\u001b[16Gcommit,\u001b[24Gabout\u001b[30Ghalf\u001b[35Ga\u001b[37Gday).\u001b[43GOn\u001b[46Gthe\u001b[50Gsample's\u001b[59Gstation\u001b[67Gand\u001b[71Gon\u001b[74GManifest's\u001b[85GOre→Brine\u001b[95Gcruise:\r\u001b[2C\u001b[1B  \u001b[6G- count awake and\u001b[24Gdynamic bodies;\u001b[K\r\u001b[7C\u001b[1Bl\u001b[10Gg \u001b[13Ghe jitter in the local-frame\u001b[42Gtargets;\r\u001b[7C\u001b[1Bc\u001b[10Gnfirm\u001b[16Gk\u001b[18Gnemat\u001b[24Gc\u001b[26Gbodies s\u001b[35Geep once th\u001b[47Gir targets\u001b[58Gare\u001b[62Gconstant;\r\u001b[15C\u001b[1Ba quie\u001b[23G Jolt \u001b[38;2;177;185;249mUpdate\u001b[39m leaves \u001b[38;2;177;185;249mSaveState\u001b[39m by\u001b[56Ge-id\u001b[61Gntical.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[5C\u001b[1BTwo\u001b[10Grisks\u001b[16Gto\u001b[19Gwatch:\u001b[26Ga\u001b[28Gkinematic\u001b[38Gsensor\u001b[45G(a\u001b[48Ggate's\u001b[55Gring)\u001b[61Gcan\u001b[65Gnever\u001b[71Gsleep,\u001b[78Gand\u001b[82GJolt's\u001b[89Gcontact\u001b[97Gcache\u001b[103Gtakes\u001b[109Ga\u001b[111Gstep\u001b[116Gor\r\u001b[5C\u001b[1Bt\u001b[10Gto set\u001b[17Gle. If the\u001b[28Gspike fail\u001b[39G, the\u001b[45Gplan changes.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPhysics:\u001b[22m \u001b[16Ghe exact local-frame target and the fix\u001b[56Gd-point\u001b[64Gcheck.\u001b[71GRe-pin\u001b[78Gthe\u001b[82Ghashes\u001b[89Gwith\u001b[94Gevidence\u001b[103Gthat\u001b[108Gonly\r\u001b[2C\u001b[1B  \u001b[6Gkinematic positions in Jolt \u001b[35Goved, by\u001b[44Gmicrom\u001b[51Gtres. Measure \u001b[38;2;177;185;249mstep-budget\u001b[39m as well: sleeping pa\u001b[98Gs may cu\u001b[108Gthe cruising\r\u001b[5C\u001b[1Bstep on their own.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSim:\u001b[11G\u001b[22m\u001b[38;2;177;185;249mQuiet\u001b[39m, \u001b[38;2;177;185;249mFastForward\u001b[30G\u001b[39mand\u001b[34Gthe\u001b[38Gsim-suite\u001b[48Gtests:\u001b[55Gfast-forward\u001b[68Gand\u001b[72Gstepping\u001b[81Ggive\u001b[86Gthe\u001b[90Gsame\u001b[95Ghash;\u001b[101Ga\u001b[103Gqueued\u001b[110Gcommand\r\u001b[2C\u001b[1B  \u001b[6Gtakes one step; \u001b[38;2;177;185;249muntil\u001b[39m is respected; a system with no ho\u001b[62Gk stops any skip.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mHooks\u001b[12G\u001b[22mfor\u001b[16Gev\u001b[19Gry\u001b[22Gengine \u001b[30Gystem, plus\u001b[42G\u001b[38;2;177;185;249mTaskWake\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mEngine acceptance tests:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- a space-suite cruise past\u001b[34Ga\u001b[36Gstation\u001b[44Gwith\u001b[49Gpads\u001b[54Gand\u001b[58Gdocked\u001b[65Gships,\u001b[72Gfast-forwarded\u001b[87Gand\u001b[91Gstepped\u001b[99Gto\u001b[102Gthe\u001b[106Gsame\u001b[111Ghash\u001b[116Gat\r\u001b[5C\u001b[1B \u001b[8Gevery stop and the arrival step;\u001b[K\r\u001b[5C\u001b[1B-\u001b[8Ga lane, a p\u001b[20Gd lapsing, and\u001b[35Ga behaviour\u001b[47Gwait\u001b[52Gor\u001b[55Gtask\u001b[60Gwake;\u001b[27;1H\u001b[24;81H\u001b[?25h"]
