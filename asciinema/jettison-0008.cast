001b[36Gand\u001b[40Gpass\u001b[45Gwith\u001b[50Gthem.\u001b[56GRunning\u001b[64Gevery\u001b[70Gdebug\u001b[76Gsuite,\u001b[83Gthen\u001b[88Gsending\u001b[96Gthe\u001b[100Greply\u001b[106Gfor\u001b[110Ground\u001b[116G2:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cmake --build --preset clang-debug 2>&1 | grep -E…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build -\u001b[24Gpreset clang-debug 2>&1 | grep -E 'error:|warning: \u001b[83G; ctest --test-dir build/clang-debug \r\u001b[5C\u001b[1B-j 20 --output-on-failure 2>&1 | grep -E 'tests passed|Failed |ERROR:' | head (22s)\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
