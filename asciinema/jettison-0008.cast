[0.031, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bquiet, and a major one wh\u001b[29Gre FastForward skips the sched\u001b[60Gler's\u001b[66Gdependency check. Since two rounds i\u001b[104Gthe lim\u001b[112Gt,\u001b[115GI'\r\u001b[2C\u001b[1Bfix both with tests\u001b[23Gand\u001b[27Gleave\u001b[33Gthe\u001b[37Gdecision\u001b[46Gon\u001b[49Ga\u001b[51Gthird\u001b[57Ground\u001b[63Gto\u001b[66Gyou,\u001b[71Gand\u001b[75GI'm\u001b[79Gchecking\u001b[88Gthe\u001b[92Gscheduler's\u001b[104Gvalidation\u001b[115Gcall\r\u001b[2C\u001b[1Bnow.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(source/\u001b[18Gngine/sim/src/SimWorld.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[22m line\u001b[19G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[18G\u001b[39mstd::vector<\u001b[38;2;166;226;46mconst\u001b[36G\u001b[39mQuiet\u001b[42G*>\u001b[45G&\u001b[38;2;166;226;46mSimWorld::QuietInOrder\u001b[38;2;253;151;31m()\r\u001b[8C\u001b[1B\u001b[39m\u001b[2m5\u001b[12G\u001b[22m{\u001b[14G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 136 \u001b[22m   \u001b[38;2;249;38;114mif\u001b[39m (m_quietOrder.\u001b[38;2;166;226;46mempty\u001b[39m())\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[14G\u001b[38;2;248;248;242m{\u001b[16G                                                                                                  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[16G\u001b[38;2;117;113;94m// As Step's first Run does: an after or a before naming no system throws here too.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 139 +\u001b[38;2;248;248;242m    m_scheduler.\u001b[38;2;166;226;46mValidate\u001b[38;2;248;248;242m();                                                                           \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m0\u001b[16G\u001b[22m\u001b[38;2;249;38;114mfor\u001b[20G\u001b[39m(\u001b[38;2;166;226;46mconst\u001b[27G\u001b[39mstd::string\u001b[39G&name\u001b[45G:\u001b[47Gm_scheduler.\u001b[38;2;166;226;46mOrder\u001b[39m(Ecs::TickPhase::Simulation))\r\u001b[8C\u001b[1B\u001b[2m1\u001b[16G\u001b[22m{\u001b[18G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 142 \u001b[18G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[24G\u001b[38;2;249;38;114mauto\u001b[29G\u001b[39mfound\u001b[35G=\u001b[37Gm_quiets.\u001b[38;2;166;226;46mfind\u001b[39m(name);\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;107;128m●\u001b[39m \u001b[1mUpdate\u001b[22m(source/engine/sim/src/SimWorld.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[38;2;255;107;128mEr\u001b[9Gor: String\u001b[20Gto\u001b[23Greplace\u001b[31Gnot\u001b[35Gfound in fil\u001b[76G\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
