;113;94m// for two (nothing dynamic, nothing awake, no body made or removed) and the registry asks for no\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 342 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// body to be made, removed or placed, every kinematic one being on rails. Then never: steps pass\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 343 \u001b[22m   \u001b[38;2;117;113;94m// it by until something dynamic is in a world.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 344 -\u001b[38;2;248;248;242m  std::uint64_t QuietFrom(const entt::registry &registry, std::uint64_t step) const;                  \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 344 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::\u001b[38;2;166;226;46muint64_t\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mQuietFrom\u001b[38;2;253;151;31m(\u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m entt::registry &registry, \u001b[38;2;166;226;46mstd\u001b[38;2;253;151;31m::\u001b[38;2;166;226;46muint64_t\u001b[38;2;253;151;31m step\u001b[48;2;4;71;0m, \u001b[38;2;166;226;46mdouble\u001b[38;2;253;151;31m now\u001b[48;2;2;40;0m)\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m;      \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 345 \u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 346 \u001b[22m  \u001b[14G\u001b[38;2;117;113;94m// Puts what the steps passed ove\u001b[76G): each entity on rails where its\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
