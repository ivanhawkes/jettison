[0.114, "o", "\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m, and is left as the last step wrote it.                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 558 \u001b[12G\u001b[22m-\u001b[14G**Cruise**\u001b[25Gruns\u001b[30Gin\u001b[33Gthe\u001b[37Gstep\u001b[42Gthat\u001b[47Gplaces\u001b[54Gan\u001b[57Garrival,\u001b[66Gand\u001b[70Gits\u001b[74Gskip\u001b[79Gplaces\u001b[86Geach\u001b[91Gship\u001b[96Galong\u001b[102Gits\u001b[106Gcourse.\r\u001b[1B \u001b[3G   \u001b[2m 559 \u001b[22m   **Lanes** run in the\u001b[35Gstep\u001b[40Gan\u001b[43Garrival\u001b[51Gends\u001b[56Gat,\u001b[60G**gates**\u001b[70Gat\u001b[73Ga\u001b[75Gship\u001b[80Gat\u001b[83Ga\u001b[85Ggate,\u001b[91Ga\u001b[93Gqueue\u001b[99Gto\u001b[102Gserve\u001b[108Gor\u001b[111Ga\r\u001b[1B     \u001b[2m 560 \u001b[12G\u001b[22m \u001b[14Gclearanc\u001b[23G lapsing, **\u001b[36Gteering**\u001b[46Gwhile\u001b[52Ga\u001b[54Gship\u001b[59Ghas\u001b[63Ga\u001b[65Gdestination\u001b[77Gin\u001b[80Ga\u001b[82Gframe,\u001b[89Gand\u001b[93G**docks**\u001b[103Gat\u001b[106Gany\u001b[110Gship\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning ./sc\u001b[17Gpts/ci.sh --werror --asan\u001b[43G--log build/gate.…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ./scripts/ci.sh --werror --asan --log build/gate.log 2>&1 | tail -3 (1m 28s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;218;124;92mHullaballooing…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Gate, then commit and push F6 fix · 1h 12m 5s · ↓\u001b[39m \u001b[38;2;153;153;153m89.6k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/btw explain what is meant by a 'spike'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m\u001b[1m/btw \u001b[22m\u001b[38;2;153;153;153mare you expecting the game to be running entities on rails without a body?\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BEntities\u001b[14Gon rails without\u001b[31Ga body, yes; flown ones like\u001b[60Gthat, no.\u001b[70G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mRails without a body is normal.\u001b[37G\u001b[22mPhysics\u001b[45Gplaces\u001b[52Gevery\u001b[58Gentity\u001b[65Gthat\u001b[70Ghas\u001b[74G\u001b[38;2;177;185;249mOnRails\u001b[82G\u001b[39mand\u001b[86Ga\u001b[88G\u001b[38;2;177;185;249mTransform\u001b[98G\u001b[39meach\u001b[103Gstep,\u001b[109Gwhether\u001b[117Gor\r\u001b[1B \u001b[3G  \u001b[6Got it has a \u001b[38;2;177;185;249mBody\u001b[39m. A station's\u001b[36Gpad\u001b[40G and decks ri\u001b[54Ge i\u001b[58Gs rails\u001b[66Gthat\u001b[71Gway:\u001b[76GL26's\u001b[82Gprofile\u001b[90Gfound\u001b[96Gthe\u001b[100Gstation's\u001b[110Gorbit\r\u001b[1B    evaluated once for each pad, deck and buggy, yet the spike showed only the station\u001b[88Gand\u001b[92Gdocked\u001b[99Gships\u001b[105Gas\u001b[108GJolt\r\u001b[4C\u001b[1Bbodies.\u001b[13GThe\u001b[17Gskip\u001b[22Ghas\u001b[26Gto\u001b[29Gplace\u001b[35Gthose\u001b[41Gtoo,\u001b[46Gand\u001b[50Git\u001b[53Gdoes,\u001b[59Gbecause\u001b[67Git\u001b[70Gcovers\u001b[77Gevery\u001b[83Grails\u001b[89Gentity,\u001b[97Gnot\u001b[101Gonly\u001b[106Gbodies.\r\u001b[1B\u001b[K\r\u001b[1B    \u001b[1mA flown entity on rails without a body isn't something I expect.\u001b[22m A ship with \u001b[38;2;177;185;249mFlightControls\u001b[39m and \u001b[38;2;177;185;249mHandling\u001b[39m is\u001b[K\r\u001b[2C\u001b[1B  normally either:\u001b[K\r\u001b[2C\u001b[1B  - a dynamic body in flight, where physics isn't quiet anyway; or\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Ga\u001b[9Gkinematic\u001b[19Gbody\u001b[24Gdocked\u001b[31Gon\u001b[34Ga\u001b[36Gstation's\u001b[46Grails\u001b[52Gin\u001b[55Gthat\u001b[60Gstation's\u001b[70Gframe,\u001b[77Gwhich\u001b[83Gthe\u001b[87Gflight\u001b[94Gcheck\u001b[100Gleaves\u001b[107Gto\u001b[110Gphysics.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153m\u001b[3m↑/↓ to sc\u001b[14Gll · ⇧←/→ to browse · c to\u001b[41Gcopy ·\u001b[48Gf to fork · x to clear history · Esc to close\u001b[23m\u001b[39m\u001b[27;1H"]
