  \u001b[6Gkinematic positions in Jolt \u001b[35Goved, by\u001b[44Gmicrom\u001b[51Gtres. Measure \u001b[38;2;177;185;249mstep-budget\u001b[39m as well: sleeping pa\u001b[98Gs may cu\u001b[108Gthe cruising\r\u001b[5C\u001b[1Bstep on their own.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSim:\u001b[11G\u001b[22m\u001b[38;2;177;185;249mQuiet\u001b[39m, \u001b[38;2;177;185;249mFastForward\u001b[30G\u001b[39mand\u001b[34Gthe\u001b[38Gsim-suite\u001b[48Gtests:\u001b[55Gfast-forward\u001b[68Gand\u001b[72Gstepping\u001b[81Ggive\u001b[86Gthe\u001b[90Gsame\u001b[95Ghash;\u001b[101Ga\u001b[103Gqueued\u001b[110Gcommand\r\u001b[2C\u001b[1B  \u001b[6Gtakes one step; \u001b[38;2;177;185;249muntil\u001b[39m is respected; a system with no ho\u001b[62Gk stops any skip.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mHooks\u001b[12G\u001b[22mfor\u001b[16Gev\u001b[19Gry\u001b[22Gengine \u001b[30Gystem, plus\u001b[42G\u001b[38;2;177;185;249mTaskWake\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B5\u001b[27;1H\u001b[24;81H\u001b[?25h"]
