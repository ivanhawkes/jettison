contain\u001b[49Ggates.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, listed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[2C\u001b[1B               \u001b[27;1H\u001b[24;3H\u001b[?25h"]
