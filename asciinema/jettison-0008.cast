[0.016, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m1\u001b[20G\u001b[22m\u001b[38;2;117;113;94mstep begins.\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[17G\u001b[22m\u001b[38;2;117;113;94m4.\u001b[20GEach\u001b[25Gframe's worlds step, in identifier order, on one thread.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs\u001b[8Gdone.\u001b[14GNow\u001b[18Gthe\u001b[22Gformat\u001b[29Gcheck,\u001b[36Gdeclaration\u001b[48Gspacing\u001b[56Gand\u001b[60Gclang-tidy\u001b[71Gover\u001b[76Gthe\u001b[80Gchanged\u001b[88Gunits,\u001b[95Gthen\u001b[100Gthe\u001b[104Ggate.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggrep\u001b[12Gpattern\u001b[20Gwas\u001b[24Gescaped\u001b[32Gwrongly,\u001b[41Gso\u001b[44Gthe\u001b[48Gtidy\u001b[53Grun\u001b[57Gwas\u001b[61Glost.\u001b[67GI'll\u001b[72Guse\u001b[76Gthe\u001b[80Gproject's\u001b[90Gscript,\u001b[98Gwhich\u001b[104Gchecks\u001b[111Gthe\u001b[115Gwhole\r\u001b[1B \u001b[3Gtr\u001b[6Ge, and the decl\u001b[22Gration spacer's check\u001b[44Gmode:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTidy\u001b[8Gis\u001b[11Gclean.\u001b[18GThe\u001b[22Gonly\u001b[27Gtwo\u001b[31Gfiles\u001b[37Gthe\u001b[41Gspacer\u001b[48Gflags\u001b[54Gare\u001b[58Gin\u001b[61G\u001b[38;2;177;185;249mnet\u001b[39m,\u001b[66Gwhich\u001b[72GI\u001b[74Gdidn't\u001b[81Gtouch,\u001b[88Gand\u001b[92Gthey\u001b[97Gwere\u001b[102Galready\u001b[110Glike\u001b[115Gthat.\r\u001b[1B \u001b[3GRunning\u001b[11Gth\u001b[14G gate now, about\u001b[32Gour minutes:\u001b[K\r\u001b