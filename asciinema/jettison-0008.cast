[0.172, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 141 +\u001b[38;2;248;248;242m  \u001b[38;2;249;38;114mreturn\u001b[38;2;248;248;242m \u001b[38;2;190;132;255mtrue\u001b[38;2;248;248;242m;                                                                                        \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 142 +\u001b[38;2;248;248;242m}                                                                                                     \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 143 \u001b[12G\u001b[22m}\u001b[14G\u001b[38;2;117;113;94m// namespace Jettison::Physics\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/physics/include/jettison/physics/Flight.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m5\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 117 \u001b[22m \u001b[38;2;117;113;94m// velocity as the step began. Each ship flown has its Thrust written, and one with a Thrust that was\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m118 \u001b[22m \u001b[38;2;117;113;94m// not flown has it taken away.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m119 \u001b[22m \u001b[38;2;166;226;46mvoid\u001b[39m \u001b[38;2;166;226;46mStepFlight\u001b[38;2;253;151;31m(entt::registry &registry, \u001b[38;2;166;226;46mdouble\u001b[38;2;253;151;31m fixedStep)\u001b[39m;\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 120 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 121 +\u001b[38;2;117;113;94m// Whether the flight model's next step would leave every ship's Velocity as it is, which is when a\u001b[38;2;248;248;242m   \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 122 +\u001b[38;2;117;113;94m// step may pass it over (Sim::Quiet): a kinematic body's it changes only for physics to write over.\u001b[38;2;248;248;242m  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 123 +\u001b[38;2;117;113;94m// Thrust is not state, so it is left as the last step wrote it.\u001b[38;2;248;248;242m                                      \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 124 +\u001b[38;2;166;226;46mbool\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mFlightAtRest\u001b[38;2;253;151;31m(\u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m entt::registry &registry, \u001b[38;2;166;226;46mdouble\u001b[38;2;253;151;31m fixedStep)\u001b[38;2;248;248;242m;                                  \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 125 \u001b[12G\u001b[22m}\u001b[14G\u001b[38;2;117;113;94m// namespace Jettison::Physics\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build --preset clang-debug 2>&1 |\u001b[50Ggrep\u001b[55G-E '\u001b[60Grror:|warning: ' | head -20; ctest --t\u001b[100Gt-dir\u001b[106G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mbuild/clang-debug -j 20 --output-on-failure 2>&1 | grep -E 'tests passed|Failed |ERROR:|values: ' | head -30\r\u001b[2B\u001b[38;2;215;119;87m·\u001b[3G\u001b[38;2;220;129;97mTinkering…\u001b[15G\u001b[38;2;153;153;153m22m\u001b[19G37s · ↓\u001b[39m \u001b[38;2;153;153;153m75.6k\u001b[33Gtokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
