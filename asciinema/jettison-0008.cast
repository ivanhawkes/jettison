[0.101, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 136 \u001b[22m   \u001b[38;2;117;113;94m// has to run in, the world as the last step left it and no command applied: the clock's own count,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 137 \u001b[22m   \u001b[38;2;117;113;94m// or less, for the next step. Called between steps; changes nothing.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 138 \u001b[22m   \u001b[38;2;166;226;46mstd\u001b[39m::function<\u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46muint64_t\u001b[39m(\u001b[38;2;166;226;46mconst\u001b[39m SimWorld &)> next;\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 139 -\u001b[38;2;248;248;242m  // Puts what the system writes where \u001b[48;2;92;2;0mevery\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mstep\u001b[48;2;61;1;0m passed over would have left it, the\u001b[48;2;92;2;0m clock already\u001b[48;2;61;1;0m   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 140 -\u001b[38;2;248;248;242m  // at the end of them; lastBegan is the time the last of them began at, since the\u001b[48;2;92;2;0m clock's time is a\u001b[48;2;61;1;0m \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 141 -\u001b[38;2;248;248;242m  // sum of steps, not a product. Run in the order the step runs the systems in.\u001b[48;2;92;2;0m Empty for a system\u001b[48;2;61;1;0m   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 142 -\u001b[38;2;248;248;242m  // that writes nothing in the steps it may be passed over in.                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 143 -\u001b[38;2;248;248;242m  std::function<void(SimWorld &, double lastBegan)> skip{};                                           \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 139 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Puts what the system writes where \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0msteps\u001b[48;2;2;40;0m passed 