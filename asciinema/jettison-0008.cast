[0.209, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 140 \u001b[22m   \u001b[38;2;117;113;94m// at the end of them; lastBegan is the time the last of them began at, since the clock's time is a\r\u001b[1B\u001b[39m     \u001b[2m 141 \u001b[12G\u001b[22m \u001b[14G\u001b[38;2;117;113;94m// sum of steps, not a product. Run in the order the step runs the systems in. Empty for a system\r\u001b[8C\u001b[1B\u001b[39m\u001b[2m2\u001b[17G\u001b[22m\u001b[38;2;117;113;94mtha\u001b[21G writes no\u001b[33Ging\u001b[37Gin \u001b[41Gh\u001b[43G step\u001b[50Git may be passed over in.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 143 -\u001b[38;2;248;248;242m  std::function<void(SimWorld &, double lastBegan)> skip;                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 143 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::function<\u001b[38;2;166;226;46mvoid\u001b[38;2;248;248;242m(SimWorld &, \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m lastBegan)> skip\u001b[48;2;4;71;0m{}\u001b[48;2;2;40;0m;                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 144 \u001b[22m };\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 145 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m\u001b[38;2;117;113;94m// A component's migrations: a chain over the binary record of one value (Serialise::BinaryRecord),\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe sim tests pass. Next\u001b[28Gare\u001b[32Gthe\u001b[36Gengine\u001b[43Gsystems'\u001b[52Gquiets,\u001b[60Gstarting\u001b[69Gwith\u001b[74Gphysics\u001b[82Gand\u001b[86Gthe\u001b[90Gflight\u001b[97Gmodel.\u001b[104GChecking\u001b[113Gthe\r\u001b[2C\u001b[1Bflight\u001b[10Gheader\u001b[17Gand\u001b[21G\u001b[38;2;177;185;249mThrust\u001b[39m:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, read \u001b[1m1\u001b[22m file \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm adding two quie\u001b[23Ging paths: physics can\u001b[46Gbe\u001b[49Gskipped\u001b[57Gafter\u001b[63Gtwo\u001b[67Grested\u001b[74Gsteps\u001b[80Gwith\u001b[85Gno\u001b[88Gchanges,\u001b[97Gand\u001b[101Gflight\u001b[108Gcan\u001b[112Gbe\r\u001b[1B  skipped when no ship's velocity would change, ignoring kinematic\u001b[68Gbodies.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3GTinkering… \u001b[20G\u001b[38;2;153;153;153m6\u001b[42Gthought for 34s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
