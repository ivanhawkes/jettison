[0.204, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  6 +\u001b[38;2;248;248;242mon pin `800a5cc`. Next: W10, standing trade policies, autopilot and NPC jobs. Its fleets docked at     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m  7 +\u001b[38;2;248;248;242monce will stop every step being passed over until observation's live reports stop changing each        \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  8 +\u001b[38;2;248;248;242mstep; and each system W10 adds needs its own quiet (`Jettison::Sim::Quiet`), or none is passed over.   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m  9 \u001b[11G\u001b[22mThe\u001b[15Gplanning\u001b[24Gdocuments'\u001b[35Ghome-region\u001b[47Gallocation\u001b[58G(scope,\u001b[66Gthe\u001b[70Groadmap's\u001b[80Gregion\u001b[87Gsupply\u001b[94Gand\u001b[98GD-076)\u001b[105Gwaits\r\u001b[1B \u001b[3G   \u001b[2m 10 \u001b[22m for W13 to restate\u001b[30Git as fou\u001b[40Gding.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 11 \r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The Jettison gate passed on \u001b[38;2;177;185;249m800a5cc\u001b[39m (535 s, every stage green), and the devenv\u001b[82Gfiles\u001b[88Gare\u001b[92Gunchanged\u001b[102Gsince\u001b[108Gthe\u001b[112Gold\u001b[116Gpin.\r\u001b[2C\u001b[1BPushing\u001b[11Git\u001b[14Gso\u001b[17GManifest\u001b[26Gcan\u001b[30Gpin\u001b[34Git:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Pushe\u001b[9G (\u001b[38;2;177;185;249md9beee7..800a5cc\u001b[39m).\u001b[30GMoving\u001b[37GManifest's\u001b[48Gpin,\u001b[53Gthen\u001b[58Gits\u001b[62Ggate.\u001b[68GChecking\u001b[77Gmy\u001b[80Gnote\