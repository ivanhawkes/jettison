                                  \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 437 -\u001b[38;2;248;248;242m  original.Run(2.0);                                                                                  \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 438 -\u001b[38;2;248;248;242m  loaded.Run(2.0);                                                                                    \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 439 -\u001b[38;2;248;248;242m  CHECK(loaded.world.Save() == original.world.Save());                                                \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 440 -\u001b[38;2;248;248;242m}                                                                                                     \r\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build --preset clang-debug --target jettison_physic\u001b[68G_tests 2>&1 | grep -E 'error:\u001b[98Gwarning: ' | head;\u001b[117G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mbuild/clang-debug/source/engine/physics/jettison_physics_tests 2>&1 | grep -E 'ERROR|values|test cases' | head -20\r\u001b[19C\u001b[2B37m 38s · ↓\u001b[39m \u001b[38;2;153;153;153m63.8k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
