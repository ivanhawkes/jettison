[0.082, "o", "\u001b[?25l\u001b[H\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(source/\u001b[18Gngine/sim/include/jettison/sim/SimWorld.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m140 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// at the end of them; lastBegan is the time the last of them began at, since the clock's time is a\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m141 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// sum of steps, not a product. Run in the order the step runs the systems in. Empty for a system\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 142 \u001b[22m   \u001b[38;2;117;113;94m// that writes nothing in the steps it may be passed over in.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 143 -\u001b[38;2;248;248;242m  std::function<void(SimWorld &, double lastBegan)> skip;                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 143 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::function<\u001b[38;2;166;226;46mvoid\u001b[38;2;248;248;242m(SimWorld &, \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m lastBegan)> skip\u001b[48;2;4;71;0m{}\u001b[48;2;2;40;0m;                                           \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m144 \u001b[12G\u001b[22m};\u001b[20G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m145 \u001b[20G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 146 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m// A component's migrations: a chain over the binary record of one value (Serialise::BinaryRecord),\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build --preset clang-debug --target\u001b[52Gjettison_sim_tests 2>&1 | grep -E 'error:\u001b[94Gw\u001b[96Grning: ' |\u001b[107Ghead -20; \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;153;153;153mtest --test-dir build/clang-debug -R '^sim$' --output-on-failure 2>&1 | grep -E 'ERROR|values|tests passed|test \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mcases' | hea\u001b[19G -30\u001b[39m\u001b[K\r\u001b[18C\u001b[8B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
