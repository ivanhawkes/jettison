[0.370, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 200 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m//      gains what its frame's gravity gives it over the step, from where the bodies are as the\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 201 \u001b[22m \u001b[38;2;117;113;94m//      step begins.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 202 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m//   4. Each frame's worlds step, in identifier order, on one thread.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs\u001b[8Gdone.\u001b[14GNow\u001b[18Gthe\u001b[22Gformat\u001b[29Gcheck,\u001b[36Gdeclaration\u001b[48Gspacing\u001b[56Gand\u001b[60Gclang-tidy\u001b[71Gover\u001b[76Gthe\u001b[80Gchanged\u001b[88Gunits,\u001b[95Gthen\u001b[100Gthe\u001b[104Ggate.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe grep pattern was escaped\u001b[32Gwrongly,\u001b[41Gso\u001b[44Gthe\u001b[48Gtidy\u001b[53Grun\u001b[57Gwas\u001b[61Glost.\u001b[67GI'll\u001b[72Guse\u001b[76Gthe\u001b[80Gproject's\u001b[90Gscript,\u001b[98Gwhich\u001b[104Gchecks\u001b[111Gthe\u001b[115Gwhole\r\u001b[2C\u001b[1Btree,\u001b[9Gand\u001b[13Gthe\u001b[17Gdeclaration\u001b[29Gspacer's\u001b[38Gcheck\u001b[44Gmode:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTidy is\u001b[11Gclean. The only\u001b[27Gtwo files the spacer flags are in \u001b[38;2;177;185;249mnet\u001b[39m,\u001b[66Gwhich\u001b[72GI\u001b[74Gdidn't\u001b[81Gtouch,\u001b[88Gand\u001b[92Gthey\u001b[97Gwere\u001b[102Galready\u001b[110Glike\u001b[115Gthat.\r\u001b[1B  Running the gate now, about four minutes:\u001b[K\r\u001b[2C\u001b[7B\u001