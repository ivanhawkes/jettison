[0.041, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest\u001b[12Gpulls\u001b[18Gits\u001b[22Gengine\u001b[29Gpin\u001b[33Gfrom\u001b[38GGitHub,\u001b[46Gso\u001b[49Gthe\u001b[53Gmove\u001b[58Gto\u001b[61Gd9beee7\u001b[69Gneeds\u001b[75Gthat\u001b[80Gcommit\u001b[87Gpushed\u001b[94Gfirst.\u001b[101GI'll\u001b[106Gwork\u001b[111Gagainst\r\u001b[2C\u001b[1Bthe local checkout\u001b[22Gvia\u001b[26GJETTISON_SOURCE_DIR\u001b[46Gand\u001b[50Gpush\u001b[55Gonce\u001b[60Gthe\u001b[64Gpin\u001b[68Gchanges.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gpin\u001b[11Gmove\u001b[16Gis\u001b[19Gthe\u001b[23Grevision\u001b[32Gplus\u001b[37Gthree\u001b[43Genvironment\u001b[55Gfiles\u001b[61Gcopied\u001b[68Gfrom\u001b[73Gthat\u001b[78Gcommit;\u001b[86Gmine\u001b[91Gdidn't\u001b[98Gtouch\u001b[104Gthem.\u001b[110GNow\r\u001b[2C\u001b[1BManifest's six\u001b[18Gsimulation\u001b[29Gsystems,\u001b[38Gits\u001b[42Gconsole's\u001b[52Gstep\u001b[57Gand\u001b[61Gits\u001b[65Gserver\u001b[72Gloop:\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Geconomy\u001b[15Gproduces\u001b[24Gevery\u001b[30Gstep,\u001b[36Gnot\u001b[40Gonly\u001b[45Gon\u001b[48Gits\u001b[52Gturn.\u001b[58GReading\u001b[66G\u001b[38;2;177;185;249mProduce\u001b[39m,\u001b[75Glife\u001b[80Gsupport's\u001b[90G\u001b[38;2;177;185;249mDraw\u001b[39m,\u001b[96Gthe\u001b[100Greport\u001b[107Gcapture\u001b[115Gand\r\u001b[2C\u001b[1Bthe travel system:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\