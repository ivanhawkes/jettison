 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// body is at now, each kinematic body there in Jolt with the velocity its last step's motion\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(source/\u001b[18Gngine/physics/include/jettison/physics/PhysicsWorld.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[7C\u001b[1B\u001b[2m39\u001b[14G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m0\u001b[17G\u001b[22m\u001b[38;2;117;113;94mThe step phy\u001b[30Gics \u001b[35Gas to run in next\u001b[53G(Sim::Quiet): the one about to begin, unless it has rested\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 341 \u001b[22m   \u001b[38;2;117;113;94m// for two (nothing dynamic, nothing awake, no body made or removed) and the registry asks for no\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 342 -\u001b[38;2;248;248;242m  // body to be made, removed or placed, every kinematic one being on rails\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mThen\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnever:\u001b[48;2;61;1;0m \u001b[48;2;92;2;0msteps\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpass\u001b[48;2;61;1;0m   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 343 -\u001b[38;2;248;248;242m  // it by until something dynamic is in a world.                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 342 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// body to be made, removed or pl\u001b[76Gng on rails \u001b[48;2;4;71;0mand\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mevery\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mbody\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mon rails\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m   \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
