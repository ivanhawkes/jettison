[0.083, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 628 -\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 629 -\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 630 -\u001b[38;2;248;248;242mTEST_CASE(\"DIAG legs\")                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 631 -\u001b[38;2;248;248;242m{                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 632 -\u001b[38;2;248;248;242m  Hosted forwarded{MANIFEST_MOD_DIRECTORY};                                                           \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 633 -\u001b[38;2;248;248;242m  forwarded.Bootstrap();                                                                              \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 634 -\u001b[38;2;248;248;242m  ToCruise(forwarded);                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 635 -\u001b[38;2;248;248;242m  const std::uint64_t end = forwarded.world.Clock().Step() + kJourneySteps;                           \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 636 -\u001b[38;2;248;248;242m  std::map<int, std::pair<std::uint64_t, std::uint64_t>> perLeg;                                      \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 637 -\u001b[38;2;248;248;242m  while (!forwarded.Ship1().journey->Ended() && forwarded.world.Clock().Step() < end)                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 638 -\u001b[38;2;248;248;242m  {                                                                                                   \