[0.008, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\r\u001b[2C\u001b[1B\u001b[22m  - If commands\u001b[19Gare\u001b[23Gqueued,\u001b[31Gor\u001b[34Gthe\u001b[38Gsoonest\u001b[46G\u001b[38;2;177;185;249mnext\u001b[51G\u001b[39mis\u001b[54Gthe\u001b[58Gnext\u001b[63Gstep,\u001b[69Git\u001b[72Gtakes\u001b[78Gone\u001b[82Greal\u001b[87Gstep.\r\u001b[4C\u001b[1B-\u001b[7GOtherwise\u001b[17Git\u001b[20Gmoves\u001b[26Gthe\u001b[30Gclock\u001b[36Gto\u001b[39Gthe\u001b[43Gstep\u001b[48Gbefore\u001b[55Gthat\u001b[60Gsoonest\u001b[68Gone,\u001b[73Gby\u001b[76Grepeated\u001b[85G\u001b[38;2;177;185;249mAdvance\u001b[93G\u001b[39mso\u001b[96Gthe\u001b[100Gbits\u001b[105Gmatch\u001b[111G(23\u001b[115GM\r\u001b[2C\u001b[1B \u001b[5G  additions is about 25 ms). Then it calls each \u001b[38;2;177;185;249mskip\u001b[39m \u001b[59Gn st\u001b[64Gp order and runs that step\u001b[91Gfor \u001b[96Geal.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat a quiet step promises:\u001b[22m it sends no events, draws no random numbers\u001b[77Gand applies\u001b[89Gno command\u001b[100G. The tests\u001b[112Genforce\u001b[K\r\u001b[4C\u001b[1Bthis.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEach engine system\u001b[22G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSystem:\u001b[22m physics\u001b[K\r\u001b[2C\u001b[1B\u001b[1mnext:\u001b[22m Next step, unless its Jolt state is a proven\u001b[54Gfixed\u001b[60Gpoint:\u001b[67Gno\u001b[70Gdynamic\u001b[78Gbody,\u001b[84Gno\u001b[87Gbody\u001b[92Gmade\u001b[97Gor\u001b[100Gremoved,\u001b[109Gand\u001b[113Geach\r\u001b[4C\u001b[1Bworld's state\u001b[19Gbytes unchanged over th\u001b[43G last two s\u001b[55Geps. Hash only when nothing moved, so\u001b[93Ga\u001b[95Gbusy\u001b[100Gstep\u001b[105Gcosts\u001b[111Gnothing.\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m Rails Transf\u001b[22Grm\u001b[26Gand\u001b[30Gthe rec\u001b[38Grds'\u001b[43Glast\u001b[48Gplacements at th\u001b[65G final time; each frame's origin and velocity\u001b[111Gfrom the\r\u001b[4C\u001b[1Blast two clock\u001b[20Gtimes. Jolt is untouched.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSystem:\u001b[11G\u001b[22mflight\r\u001b[2C\u001b[1B\u001b[1mnext:\u001b[9G\u001b[22mNext\u001b[14Gstep\u001b[19Gif\u001b[22Gany\u001b[26Gdynamic\u001b[34Gship\u001b[39Ghas\u001b[43Gcontrols\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m none\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[10C\u001b[1Bcruise \u001b[27;1H\u001b[24;3H\u001b[?25h"]
