[0.363, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe cro\u001b[11Gs-\u001b[14Gevi\u001b[18Gw found three blockers, each wit\u001b[51G a \u001b[55Gompiled rep\u001b[67Go\u001b[69Guction:\u001b[77Ga\u001b[79Gstatic\u001b[86Gbody\u001b[91Gon\u001b[94Grails\u001b[100Gleft\u001b[105Gbehind\u001b[112Gby\u001b[115Gthe\r\u001b[1B  skip, rails changed after physics\u001b[37Gproducing\u001b[47Ga\u001b[49Gwrong\u001b[55Gimplied\u001b[63Gvelocity,\u001b[73Gand\u001b[77Ga\u001b[79Gkinematic\u001b[89Gship\u001b[94Goutside\u001b[102Gany\u001b[106Gframe\u001b[112Glosing\r\u001b[2C\u001b[1Bits velocity change. I'm turning those reproductions into regression tests next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, listed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThree fixes are in: the skip now places static bodies on rails too, physics' wake re-checks rails before running\u001b[116Gthe\r\u001b[2C\u001b[1Bnext step,\u001b[14Gand\u001b[18Gflight\u001b[25Gonly\u001b[30Gpasses\u001b[37Gover\u001b[42Gkinematic\u001b[52Gbodies\u001b[59Gthat\u001b[64Gare\u001b[68Gin\u001b[71Ga\u001b[73Gframe.\u001b[80GI'm\u001b[84Gadding\u001b[91Ga\u001b[93Gregression\u001b[104Gtest\u001b[109Gfor\u001b[113Geach,\r\u001b[2C\u001b[1Bbuilt from\u001b[14Gthe reviewer's reproduction.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/physics/include/jettison/physics/PhysicsWorld.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m lin\u001b[18G, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[2m 341 \u001b[12G\u001b[22m \u001b[14G\u001b[38;2;117;113;94m// for two (nothing dynamic, nothing awake, no body made or rem