ich moves as a coordinate crosses a power of two: 2 to 14\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1028 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m// times a day by up to 30 nm at the sample's stations (2026-11-20), waking a body at\u001b[38;2;248;248;242m        \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1029 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m// rest at a step nothing else marks, which a fast-forward could not see coming.\u001b[38;2;248;248;242m             \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1030 +\u001b[38;2;248;248;242m        \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[38;2;249;38;114mauto\u001b[38;2;248;248;242m *rails = registry.\u001b[38;2;166;226;46mtry_get\u001b[38;2;248;248;242m<OnRails>(entity);                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1031 +\u001b[38;2;248;248;242m        \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m glm::dvec3 target = \u001b[76G                                      \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
