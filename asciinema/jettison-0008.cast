[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GF6\u001b[10Gtest\u001b[15Gfails\u001b[21Gwithout\u001b[29Gthe\u001b[33Gfix\u001b[37Gand\u001b[41Gpasses\u001b[48Gwith\u001b[53Git\u001b[56G(24\u001b[60Gof\u001b[63G24).\u001b[68GUpdating\u001b[77Gthe\u001b[81Garchitecture\u001b[94Gline,\u001b[100Gthen\u001b[105Gthe\u001b[109Gsame\r\u001b[1B \u001b[3Gsequence\u001b[12Gas before:\u001b[23Gevery debug suite, the Manifest c\u001b[57Geck, then\u001b[67Gthe\u001b[71Ggate:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/archit\u001b[22Gctur\u001b[27G.md)\u001b[K\r\u001b[5C\u001b[1BAd\u001b[9Ged \u001b[1m2\u001b[14G\u001b[22mlines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 553 \u001b[22m   swept on from where it was put. The skip also places every entity on rails and each local\u001b[104Gframe's\r\u001b[5C\u001b[1B\u001b[2m 554 \u001b[14G\u001b[22morigin\u001b[21Gand\u001b[25Gvelocity\u001b[34Gover\u001b[39Gthe\u001b[43Glast\u001b[48Gstep.\r\u001b[2C\u001b[1B   \u001b[2m 555 \u001b[22m - **Flight**\u001b[25Ghas\u001b[29Gto\u001b[32Grun\u001b[36Gwhile\u001b[42Ga\u001b[44Gship's\u001b[51Gvelocity\u001b[60Gwould\u001b[66Gchange,\u001b[74Gor\u001b[77Gwhile\u001b[83Gone\u001b[87Gis\u001b[90Gflown\u001b[96Gagainst\u001b[104Ga\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 556 -\u001b[38;2;248;248;242m  reference with a velocity, which may change step to step; a kinematic body's in a frame it changes  \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 557 -\u001b[38;2;248;248;242m  only for physics to write over. `Thrust` is not state, and is left as the last step wrote it.       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 556 +\u001b[38;2;248;248;242m  reference with a velocity or is on rails, either of which may change what it is held to step to     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 557 +\u001b[38;2;248;248;242m  \u001b[48;2;4;71;0mstep; a kinematic body's in a frame it changes \u001b[48;2;2;40;0monly for physics to write over. `Thrust` is not state\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242m, and is left as the last step wrote it.                                                              \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 558 \u001b[22m - **Cru\u001b[20Gs\u001b[22G** \u001b[26Guns in\u001b[33Gthe\u001b[37Gstep\u001b[42Gthat\u001b[47Gplaces\u001b[54Gan\u001b[57Garrival,\u001b[66Gand\u001b[70Gits\u001b[74Gskip\u001b[79Gplaces\u001b[86Geach\u001b[91Gship\u001b[96Galong\u001b[102Gits\u001b[106Gcourse.\r\u001b[1B     \u001b[2m 559 \u001b[12G\u001b[22m \u001b[14G**Lanes** run in\u001b[31Gthe \u001b[36Gtep\u001b[40Gan\u001b[43Garrival\u001b[51Gends\u001b[56Gat,\u001b[60G**gates**\u001b[70Gat\u001b[73Ga\u001b[75Gship\u001b[80Gat\u001b[83Ga\u001b[85Ggate,\u001b[91Ga\u001b[93Gqueue\u001b[99Gto\u001b[102Gserve\u001b[108Gor\u001b[111Ga\r\u001b[7C\u001b[1B\u001b[2m60\u001b[14G\u001b[22mcl\u001b[17Garance lapsing, **steering**\u001b[46Gw\u001b[48Gile a ship has a destination in\u001b[80Ga f\u001b[85Gme,\u001b[93G**docks** at \u001b[107Gny \u001b[111Ghip\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning ./scripts/ci.s\u001b[26G --wer\u001b[33Gor\u001b[36G--asan --log build/ga\u001b[58Ge.…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ./scripts/ci.sh --werror --asan --log b\u001b[76G(42s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
