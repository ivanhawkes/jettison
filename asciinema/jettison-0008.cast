[0.302, "o", "\u001b[?25l\u001b[H\u001b[3Gstays awake, and Jolt'\u001b[26G state\u001b[33Gchanges every step. That probably\u001b[67Gexplains much o\u001b[83G the 13\u001b[91Gµs Jolt-and-docks\u001b[109Gc\u001b[111Gst.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[22m for\u001b[17G body on the rails of th\u001b[42G same body\u001b[53Gits local fram\u001b[68G belo\u001b[74Ggs to,\u001b[81Ggive Jolt\u001b[91Gthe target in the\u001b[109Gframe's\u001b[117Gown\r\u001b[2C\u001b[1Bcoordinates,\u001b[16Gthe\u001b[20Gturned\u001b[27Goffset,\u001b[35Ginstead\u001b[43Gof\u001b[46Gthe\u001b[50Ground\u001b[56Gtrip.\u001b[62GThe\u001b[66Gtarget\u001b[73Gis\u001b[76Gthen\u001b[81Gthe\u001b[85Gsame\u001b[90Gevery\u001b[96Gstep,\u001b[102Gthe\u001b[106Gbodies\u001b[113Gcan\u001b[117Gfall\r\u001b[2C\u001b[1Basleep, and the world reaches a fixed point.\u001b[48GThis\u001b[53Gchanges the state on purp\u001b[79Gse, so\u001b[86Gthe pinned hashes mov\u001b[108G: Jetti\u001b[116Gon's\r\u001b[2C\u001b[1Bphysics r\u001b[13Gcorded\u001b[20Gr\u001b[22Gns, the 8 world pins, and Manifest's on\u001b[62Gits\u001b[66Gnext pin bump.\u001b[81G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe contract\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mHooks:\u001b[22m \u001b[38;2;177;185;249mSimWorld::RegisterSystem(desc, Sim::Quiet)\u001b[39m,\u001b[56Gwhich\u001b[62Gkeeps\u001b[68G\u001b[38;2;177;185;249mEcs::SystemDescription\u001b[91G\u001b[39mgeneric.\u001b[100G\u001b[38;2;177;185;249mQuiet\u001b[106G\u001b[39mhas\u001b[110Gtwo\u001b[114Ghooks:\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mnext(const SimWorld&) → step\u001b[39m:\u001b[37Gthe\u001b[41Gfirst\u001b[47Gstep\u001b[52Gat\u001b[55Gwhich\u001b[61Gthe\u001b[65Gsystem\u001b[72Gmust\u001b[77Greally\u001b[84Grun,\u001b[89Ggiven\u001b[95Gthe\u001b[99Gstate\u001b[105Gand\u001b[109Gno\u001b[112Gcommands\r\u001b[2C\u001b[1B \u001b[5G  queued. It must have no side effects, and an earlier answ\u001b[65Gr is always safe.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mskip\u001b[12GSimWorld&, double lastBegan)\u001b[39m: leave\u001b[48G \u001b[50Gxac\u001b[54Gly the\u001b[61Gstate that\u001b[72Gstepping the gap\u001b[89Gwould\u001b[95Ghave left. The clock has\u001b[K\r\u001b[6C\u001b[1Balrea\u001b[13Gy\u001b[15Gmoved; \u001b[38;2;177;185;249mlastBegan\u001b[39m \u001b[33Gs when the l\u001b[46Gst\u001b[49Gskipped step began, which matters\u001b[83Gbecause\u001b[91Gthe\u001b[95Gclock's\u001b[103Gtime\u001b[108Gis\u001b[111Ga\u001b[113Grunning\r\u001b[4C\u001b[1B \u001b[7Gsum, not step × dt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefault:\u001b[22m a system with no hook must run every step.\u001b[57GUntil \u001b[64Gvery\u001b[69Gsystem has a hook, the world simply step\u001b[110G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- If comm\u001b[15Gnds are\u001b[23Gqueued,\u001b[31Gor the \u001b[39Goonest \u001b[38;2;177;185;249mnext\u001b[51G\u001b[39mis the \u001b[59Gext\u001b[63Gst\u001b[66Gp,\u001b[69Git \u001b[73Gakes one\u001b[82Greal s\u001b[89Gep.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Otherwise it moves the clock to the step before\u001b[55Gthat\u001b[60Gsoonest\u001b[68Gone,\u001b[73Gby\u001b[76Grepeated\u001b[85G\u001b[38;2;177;185;249mAdvance\u001b[93G\u001b[39mso\u001b[96Gthe\u001b[100Gbits\u001b[105Gmatch\u001b[111G(23\u001b[115GM\r\u001b[4C\u001b[1B \u001b[7Gadditions is about 25 ms).\u001b[34GT\u001b[37Gn it calls each \u001b[38;2;177;185;249mskip\u001b[58G\u001b[39min step order\u001b[72Gand runs that step for\u001b[95Greal.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;81H\u001b[?25h"]
