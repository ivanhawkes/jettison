[0.091, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.001, "o", "\u001b[H\r\u001b[4C\u001b[13Bno\u001b[8G it has a \u001b[38;2;177;185;249mBody\u001b[39m. A sta\u001b[30Gion's pads and decks ride \u001b[57Gts\u001b[60Grails\u001b[66Gthat\u001b[71Gway:\u001b[76GL26's\u001b[82Gprofile\u001b[90Gfound\u001b[96Gthe\u001b[100Gstation's\u001b[110Gorbit\r\u001b[4C\u001b[1Bevaluated\u001b[15Gonce\u001b[20Gfor\u001b[24Geach\u001b[29Gpad,\u001b[34Gdeck\u001b[39Gand\u001b[43Gbuggy,\u001b[50Gyet\u001b[54Gthe\u001b[58Gspike\u001b[64Gshowed\u001b[71Gonly\u001b[76Gthe\u001b[80Gstation\u001b[88Gand\u001b[92Gdocked\u001b[99Gships\u001b[105Gas\u001b[108GJolt\r\u001b[4C\u001b[1Bbodies. The skip has to place those too, and it does, because i\u001b[70Gcovers every rails entity, not only bodies.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA flown entity on rails without a body isn't something I expect.\u001b[22m A ship with \u001b[38;2;177;185;249mFlightControls\u001b[39m and \u001b[38;2;177;185;249mHandling\u001b[39m is\r\u001b[4C\u001b[1Bn\u001b[7Grmally either:\u001b[22G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Ga\u001b[9Gdynamic\u001b[17Gbody\u001b[22Gin\u001b[25Gflight,\u001b[33Gwhere\u001b[39Gphysics\u001b[47Gisn't\u001b[53Gquiet\u001b[59Ganyway;\u001b[67Gor\r\u001b[4C\u001b[1B- a kinematic body docked on a station's rails in that station's\u001b[70Gframe,\u001b[78Ghich the flight check leaves to\u001b[110Gphysics.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BNeither the\u001b[17Gsample nor Manifest build\u001b[43G the kind\u001b[53Gof \u001b[57Gntit\u001b[62G F6 used.\u001b[72GThe\u001b[76Greviewer\u001b[85Gconstructed\u001b[97Git\u001b[100Gto\u001b[103Gprobe\u001b[109Gthe\u001b[113Gpublic\r\u001b[4C\u001b[1Bcontract, be\u001b[18Gause nothing\u001b[31Gi\u001b[34Gthe API forbids it. The same goes for F4's\u001b[77Gbody-less\u001b[87Gsh\u001b[90Gp holding\u001b[100Gto a reference,\u001b[K\r\u001b[4C\u001b[1Band\u001b[9GF3's\u001b[14Gkinematic\u001b[24Gship\u001b[29Goutside\u001b[37Gany\u001b[41Gframe.\u001b[27;1H"]
[0.015, "o", "\u001b[H\r\u001b[119C\u001b[13B\u001b[38;2;153;153;153m↑\u001b[39m\u001b[27;1H"]
