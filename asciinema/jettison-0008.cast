  \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 655 -\u001b[38;2;248;248;242m      out << std::format(\"tank {:.17g}\\n\", tank);                                                     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 656 -\u001b[38;2;248;248;242m  const auto &placed = registry.get<Jettison::Sim::Transform>(hosted.Ship());                         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 657 -\u001b[38;2;248;248;242m  out << std::format(\"ship {:.17g} {:.17g} {:.17g}\\n\", placed.position.x, placed.position.y, placed.po\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m     -\u001b[38;2;248;248;242msition.z);                                                                                            \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 658 -\u001b[38;2;248;248;242m}                                                                                                     \r\u001b[3C\u001b[2B\u001b[49m\u001b[39mead\u001b[11G\u001b[1m2\u001b[22m files, run\u001b[25Gng \u001b[1m1\u001b[31G\u001b[22mhell command…\r\u001b[19C\u001b[3B\u001b[38;2;153;153;153m12\u001b[23G 26s · ↓\u001b[39m \u001b[38;2;153;153;153m42.2k\u001b[38Gtok\u001b[42Gns)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
