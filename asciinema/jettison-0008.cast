[0.065, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Foun\u001b[12G\u001b[1m1\u001b[22m new\u001b[18Gdiagnostic issue in 1\u001b[40Gfile (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mCan you move gate rings to another reference frame to quiet their physics?\u001b[39m                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMoving\u001b[10Gthe\u001b[14Gring\u001b[19Gto\u001b[22Ganother\u001b[30Gframe\u001b[36Gwon't\u001b[42Gfix\u001b[46Git,\u001b[50Gsince\u001b[56Gno\u001b[59Gframe\u001b[65Gholds\u001b[71Gthe\u001b[75Gring\u001b[80Gstill.\u001b[87GJolt\u001b[92Gcan\u001b[96Gplace\u001b[102Gthe\u001b[106Gkinematic\u001b[116Gring\r\u001b[1B \u001b[3Gat \u001b[7Gts\u001b[10Grails pose e\u001b[23Gch step, which keeps it asleep, so I'm checking\u001b[71GJolt's behaviour for\u001b[92Gthat and will\u001b[106Gremove the\u001b[K\r\u001b[2C\u001b[1Bexac\u001b[8G-target\u001b[16Gchang\u001b[22G I just made.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJolt\u001b[8Gworks\u001b[14Gfor\u001b[18Gthis:\u001b[24Gresetting\u001b[34Ga\u001b[36Gbody's\u001b[43Gpose\u001b[48Gresets\u001b[55Gits\u001b[59Gsleep\u001b[65Gtest,\u001b[71Gso\u001b[74Gthe\u001b[78Gsaved\u001b[84Gstate\u001b[90Gdepends\u001b[98Gonly\u001b[103Gon\u001b[106Gpose,\u001b[112Gand\r\u001b[1B \u001b[3Gkinematic sensors only \u001b[28Ge dynamic bodies h\u001b[47Gre. I'm\u001b[55Greverting\u001b[66Ghe exact-target change and implementing\u001b[106Gthe hold rule\r\u001b[2C\u001b[1Bnext.\u001b[38;2;153;153;153m · summary\u00