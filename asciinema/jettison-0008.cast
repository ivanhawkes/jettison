EVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m--werror --asan --tidy > build/gate-l27b.out 2>&1; echo \"exit=$?\" >> build/gate-l27b.out; grep -E 'passed out \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mof|tidy:|gate passed|exi\u001b[31G=|FAIL' build/gate-l27b.out\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
