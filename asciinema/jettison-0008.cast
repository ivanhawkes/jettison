89Gwould\u001b[95Ghave left. The clock has\u001b[K\r\u001b[6C\u001b[1Balrea\u001b[13Gy\u001b[15Gmoved; \u001b[38;2;177;185;249mlastBegan\u001b[39m \u001b[33Gs when the l\u001b[46Gst\u001b[49Gskipped step began, which matters\u001b[83Gbecause\u001b[91Gthe\u001b[95Gclock's\u001b[103Gtime\u001b[108Gis\u001b[111Ga\u001b[113Grunning\r\u001b[4C\u001b[1B \u001b[7Gsum, not step × dt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefault:\u001b[22m a system with no hook must run every step.\u001b[57GUntil \u001b[64Gvery\u001b[69Gsystem has a hook, the world simply step\u001b[110G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- If comm\u001b[15Gnds are\u001b[23Gqueued,\u001b[31Gor the \u001b[39Goonest \u001b[38;2;177;185;249mnext\u001b[51G\u001b[39mis the \u001b[59Gext\u001b[63Gst\u001b[66Gp,\u001b[69Git \u001b[73Gakes one\u001b[82Greal s\u001b[89Gep.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Otherwise it moves the clock to the step before\u001b[55Gthat\u001b[60Gsoonest\u001b[68Gone,\u001b[73Gby\u001b[76Grepeated\u001b[85G\u001b[38;2;177;185;249mAdvance\u001b[93G\u001b[39mso\u001b[96Gthe\u001b[100Gbits\u001b[105Gmatch\u001b[111G(23\u001b[115GM\r\u001b[4C\u001b[1B \u001b[7Gadditions is about 25 ms).\u001b[34GT\u001b[37Gn it calls each \u001b[38;2;177;185;249mskip\u001b[58G\u001b[39min step order\u001b[72Gand runs that step for\u001b[95Greal.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat a quiet step promises:\u001b[22m it\u001b[36Gsends no \u001b[46Gvents, draws no random \u001b[70Gumbers and applies no commands. The tests enforce\r\u001b[4C\u001b[1Bthis.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;81H\u001b[?25h"]
