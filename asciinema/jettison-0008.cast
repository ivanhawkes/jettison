[0.073, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 392 -\u001b[38;2;248;248;242m  // controls let go with its destination as it sets out on a cruise or a lane\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m                       \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 392 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// controls let go with its destination as it sets out on a cruise or a lane\u001b[48;2;4;71;0m; and for the\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 393 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// fast-forward, a kinematic body put at rest where it is while nothing dynamic shares its world,\u001b[38;2;248;248;242m   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 394 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// half an hour of every trader's place, runs and cargo and every market the same to the bit.\u001b[38;2;248;248;242m       \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m5\u001b[14G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(original.world.\u001b[38;2;166;226;46mStateHash\u001b[39m() == \u001b[38;2;190;132;255m0x719f5a591e4fceafULL\u001b[39m);\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 396 \u001b[22m }\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m2\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAll 33 suites\u001b[17Gpass,\u001b[23Gand\u001b[27GI'm\u001b[31Gnow\u001b[35Grunning\u001b[43GManifest's\u001b[54Gfull\u001b[59Gsuite,\u001b[66Gincluding\u001b[76Gthe\u001b[80Gstep\u001b[85Gbudget,\u001b[93Gagainst\u001b[101Gthis\u001b[106Gcheckout\u001b[115Gin\u001b[118Ga\r\u001b[2C\u001b[1Bseparate\u001b[12Gbuild\u001b[18Gdirectory\u001b[28Gwithout\u001b[36Gtouching\u001b[45Gits\u001b[49Gsources.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mMake a note that at last development stage we should remove all those comments if they are no longer useful.\u001b[39m          \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd ../m\u001b[19Gnifest && cmake\u001b[35G--bu\u001b[40Gld\u001b[43Gbuild/\u001b[50Gpike-ff 2>…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && cmake --build build/spike-ff 2>&1 | grep -E 'error:|FAILED' | head; ctest --test-dir \r\u001b[5C\u001b[1Bbuild/spike-ff -j 20 --output-on-failure -E step-budget 2>&1 | grep -E 'tests passed|Failed |ERROR:|values:' | head\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m-30; ctest --test-dir build/spike-ff -R step-budget --output-on-failure 2>&1 |… (5s)\u001b[39m\u001b[K\r\u001b[92C\u001b[2B\u001b[38;2;153;153;153mthought for 3s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
