[0.001, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GJettison\u001b[16Ggate\u001b[21Gpassed\u001b[28Gon\u001b[31G\u001b[38;2;177;185;249m800a5cc\u001b[39G\u001b[39m(535\u001b[44Gs,\u001b[47Gevery\u001b[53Gstage\u001b[59Ggreen),\u001b[67Gand\u001b[71Gthe\u001b[75Gdevenv\u001b[82Gfiles\u001b[88Gare\u001b[92Gunchanged\u001b[102Gsince\u001b[108Gthe\u001b[112Gold\u001b[116Gpin.\r\u001b[2C\u001b[1BPushing\u001b[11Git\u001b[14Gso\u001b[17GManifest\u001b[26Gcan\u001b[30Gpin\u001b[34Git:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Pushe\u001b[9G (\u001b[38;2;177;185;249md9beee7..800a5cc\u001b[39m).\u001b[30GMoving\u001b[37GManifest's\u001b[48Gpin,\u001b[53Gthen\u001b[58Gits\u001b[62Ggate.\u001b[68GChecking\u001b[77Gmy\u001b[80Gnote\u001b[85Gon\u001b[88GManifest's\u001b[99Ggate\u001b[104Gflags:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;107;128m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/external/CMakeLists.txt)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[38;2;255;107;128mError: File has not been read yet. Read it first before writing to it.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/external/CMakeLists.txt)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[14G\u001b[22mline, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[2m 1 \u001b[22m \u001b[38;2;117;113;94m# Jettison feature-base, pinned rather than following main o