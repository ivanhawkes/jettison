[0.458, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1BNext step, unless its Jolt state is a proven fixed point:\u001b[67Gno\u001b[70Gdynamic\u001b[78Gbody,\u001b[84Gno\u001b[87Gbody\u001b[92Gmade\u001b[97Gor\u001b[100Gremoved,\u001b[109Gand\u001b[113Geach\r\u001b[2C\u001b[1B  world's\u001b[14Gtate byt\u001b[23Gs\u001b[25Gunchanged over th\u001b[43G last two s\u001b[55Geps. Hash only whe\u001b[75Gnothing m\u001b[85Gved, so a busy\u001b[100Gst\u001b[103Gp costs no\u001b[115Ging.\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m Rails\u001b[15GTransforms\u001b[26Gand\u001b[30Gthe\u001b[34Grecords'\u001b[43Glast\u001b[48Gplacements\u001b[59Gat\u001b[62Gthe\u001b[66Gfinal\u001b[72Gtime;\u001b[78Geach\u001b[83Gframe's\u001b[91Gorigin\u001b[98Gand\u001b[102Gvelocity\u001b[111Gfrom\u001b[116Gthe\r\u001b[2C\u001b[1B  last two clock times. Jolt is untouched.\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mSys\u001b[7Gem:\u001b[22m flight\u001b[K\r\u001b[2C\u001b[1B\u001b[1mnext\u001b[9G\u001b[22mNext\u001b[14Gstep\u001b[19Gif\u001b[22Gany\u001b[26Gdynamic\u001b[34Gship\u001b[39Ghas\u001b[43Gcontrols\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m none\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mSys\u001b[7Gem:\u001b[22m cruis\u001b[17G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mnext\u001b[9G\u001b[22mThe step\u001b[18Gits\u001b[22Garrival\u001b[30Gis\u001b[33Gplaced\u001b[40Gin\u001b[43G(\u001b[38;2;177;185;249marrivalStep − 1\u001b[39m)\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m The ship placed at the last skipped\u001b[45Gstep:\u001b[51Gfactor\u001b[58Gits\u001b[62Gplacement\u001b[72Gin\u001b[75G\u001b[38;2;177;185;249mPlace\u001b[81G\u001b[39minto\u001b[86Ga\u001b[88Gfunction\u001b[97Gof\u001b[100Gthe\u001b[104Gstep\u001b[109Gand\u001b[113Gthe\r\u001b[2C\u001b[1B  time\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSystem:\u001b[22m lanes\u001