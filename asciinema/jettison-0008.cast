[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m──────────────────────────────────────────────────── 2 new messages ────────────────────────────────────────────────────\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate ring is a kinematic\u001b[32Gsensor\u001b[39Gthat\u001b[44Gturns\u001b[50Gevery\u001b[56Gstep\u001b[61Gto\u001b[64Gface\u001b[69Gits\u001b[73Gplanet,\u001b[81Gso\u001b[84Gits\u001b[88GJolt\u001b[93Gworld\u001b[99Gcan\u001b[103Gnever\u001b[109Gsettle.\u001b[117GI'm\r\u001b[1B  checking whether Manifest's scenarios contain gates.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[18G\u001b[22mpat\u001b[22Gerns, listed \u001b[1m1\u001b[22m directory\u001b[47G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSpike showed Jolt already settles,\u001b[38Gbut\u001b[42Gthe\u001b[46Gexact\u001b[52Glocal-frame\u001b[64Gtarget\u001b[71Gis\u001b[74Gstill\u001b[80Gneeded\u001b[87Gfor\u001b[91Gcorrectness,\u001b[104Gand\u001b[108Ggate\u001b[113Grings\r\u001b[2C\u001b[1Bare\u001b[7Gnever\u001b[13Gquiet.\u001b[20GManifest's\u001b[31GBreathe\u001b[39Gand\u001b[43GObserve\u001b[51Gmust\u001b[56Gbecome\u001b[63Gformula-driven\u001b[78Gbefore\u001b[85Gthe\u001b[89Gheadline\u001b[98Gcase\u001b[103Gcan\u001b[107Gskip,\u001b[113Gso\u001b[116GI'm\r\u001b[2C\u001b[1Breverting the spike code and making the physics change next.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(\u001b[9Gi\u001b[11G checkout -- source/engine/physics/src/PhysicsWorld.\u001b[64Gpp\u001b[67Gsource/samples/space/t\u001b[90Gsts/StationsTests.cpp && git\u001b[K\r\u001b[2C\u001b[1B    s\u001b[10Gtus --sho