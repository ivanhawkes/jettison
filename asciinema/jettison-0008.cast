[0.045, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m5\u001b[10G\u001b[22mb218554.\u001b[19GThe\u001b[23Groadmap\u001b[31Gitem\u001b[36Gwas\u001b[40G\"First:\u001b[48Gwhat\u001b[53Gsaves\u001b[59Gand\u001b[63Gthe\u001b[67Gsimulation's\u001b[80Ginterface\u001b[90Ghold\u001b[95G—\u001b[97GA\u001b[99Gfast-forward\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22mover quiet steps\" (now mov\u001b[37Gd to docs/history.md, \"The fa\u001b[67Gt-fo\u001b[72Gward over quie\u001b[87G s\u001b[90Geps\"); the contract\u001b[110Gis\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mdocs/archit\u001b[22Gcture.md \"Quiet steps\"\u001b[45Gand \u001b[50Ghe\u001b[53Gdecis\u001b[59Gon in docs/decisions.md.\u001b[84GM\u001b[86Gnifest consumes it at\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m../manifest da93f86 (\u001b[33Gs six systems'\u001b[48Gquiet\u001b[54G, its console and server), on this pin.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m## Wh\u001b[16Gt it is for\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +50 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gcross-review\u001b[20Gfound\u001b[26Gthree\u001b[32Gblockers,\u001b[42Geach\u001b[47Gwith\u001b[52Ga\u001b[54Gcompiled\u001b[63Greproduction:\u001b[77Ga\u001b[79Gstatic\u001b[86Gbody\u001b[91Gon\u001b[94Grails\u001b[100Gleft\u001b[105Gbehind\u001b[112Gby\u001b[115Gthe\r\u001b[2C\u001b[1Bskip, rails changed after physics producing a\u001b[49Gwrong\u001b[55Gimplied\u001b[63Gvelocity,\u001b[73Gand\u001b[77Ga\u001b[79Gkinematic\u001b[89Gship\u001b[94Goutside\u001b[102Gany\u001b[106Gframe\u001b[112Glosing\r\u001b[2C\u001b[1Bits\u001b[7Gvelocity\u001b[16Gchange.\u001b[24GI'm\u001b[28Gturning\u001b[36Gthose\u001b[42Greproductions\u001b[56Ginto\u001b[61Gregression\u001b[72Gtests\u001b[78Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, listed \u001b[1m1\u001b[22m directory \u001b[37G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThree\u001b[9Gfixes\u001b[15Gare\u001b[19Gin:\u001b[23Gthe\u001b[27Gskip\u001b[32Gnow\u001b[36Gplaces\u001b[43Gstatic\u001b[50Gbodies\u001b[57Gon\u001b[60Grails\u001b[66Gtoo,\u001b[71Gphysics'\u001b[80Gwake\u001b[85Gre-checks\u001b[95Grails\u001b[101Gbefore\u001b[108Grunning\u001b[116Gthe\r\u001b[1B \u001b[3Gn\u001b[5Gxt step, and fligh\u001b[24G only\u001b[30Gpasses over\u001b[42Gkinematic\u001b[52Gbodies\u001b[59Gthat\u001b[64Gare\u001b[68Gin\u001b[71Ga\u001b[73Gframe.\u001b[80GI'm\u001b[84Gadding\u001b[91Ga\u001b[93Gregression\u001b[104Gtest\u001b[109Gfor\u001b[113Geach,\r\u001b[1B  built from the reviewer's reproduction.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GHullab\u001b[38;2;235;159;127mall\u001b[38;2;215;119;87mooing… \u001b[47G\u001b[38;2;153;153;153mthought for 15s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
