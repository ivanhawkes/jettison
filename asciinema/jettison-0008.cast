[0.038, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEv\u001b[6Gry stage ran and passed: the\u001b[35Gdebug,\u001b[42GTUI-off,\u001b[51Grelease\u001b[59Gand\u001b[63Gsanitised\u001b[73Gbuilds\u001b[80Gwith\u001b[85Gtheir\u001b[91Gsuites\u001b[98G(47,\u001b[103G45,\u001b[107G47\u001b[110Gand\u001b[114G47),\r\u001b[2C\u001b[1Bthen\u001b[8Gtidy.\u001b[14GCommitting\u001b[25GManifest:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+28\u001b[38;2;153;153;153m, committed \u001b[1mda93f86\u001b[22m, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest\u001b[12Gis comm\u001b[20Gt\u001b[22Ged as da93f86, \u001b[38Gne commit ahead of\u001b[58Grigin\u001b[64Ga\u001b[66Gd unpushed, so pushing is left to you. Next\u001b[110GI'm\r\u001b[2C\u001b[1Bchecking\u001b[12Gthe\u001b[16Gscript\u001b[23Gand\u001b[27Gmy\u001b[30Gnotes\u001b[36Gfor\u001b[40Gthe\u001b[44Gcross-review\u001b[57Gof\u001b[60Gthe\u001b[64Gengine\u001b[71Gcommits\u001b[79Gd9beee7\u001b[87Gand\u001b[91G800a5cc.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command, recalled \u001b[1m3\u001b[22m memories \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNo \u001b[7Gar\u001b[11Ger rounds need\u001b[26Gke\u001b[29Gping, so I'm starting fresh\u001b[57G(\u001b[38;2;177;185;249m--new\u001b[39m),\u001b[66Gagainst\u001b[74Gthe\u001b[78Gcommit\u001b[85Gbefore\u001b[92Gthe\u001b[96Gfast-forward\u001b[109Gwork.\u001b[115GThe\r\u001b[2C\u001b[1Bbrief\u001b[9Glists\u001b[15Gthe\u001b[19Gclaims\u001b[26Gthe\u001b[30Greviewer\u001b[39Gshould\u001b[46Gattack:\