[0.084, "o", "\u001b[?25l\u001b[H\u001b[3GManifest's\u001b[14Gstations\u001b[23Gdon't\u001b[29Gspin\u001b[34G(rotation\u001b[44Gperiod\u001b[51G0).\u001b[55GEven\u001b[60Gso,\u001b[64Ga\u001b[66Gpad's\u001b[72Gkinematic\u001b[82Gtarget\u001b[89Gis\u001b[92Gcomputed\u001b[101Gas\u001b[104G(station\u001b[113Gposition\r\u001b[2C\u001b[1B+\u001b[5Goffset)\u001b[13G−\u001b[15Gstation\u001b[23Gposition.\u001b[33GAbout\u001b[39G1.5\u001b[43G×\u001b[45G10¹¹\u001b[50Gm\u001b[52Gfrom\u001b[57Gthe\u001b[61Gstar,\u001b[67Gthat\u001b[72Grounds\u001b[79Gdifferently\u001b[91Gevery\u001b[97Gstep,\u001b[103Gby\u001b[106Gup\u001b[109Gto\u001b[112Gabout\u001b[118G30\r\u001b[1B \u001b[3Gµm. So \u001b[38;2;177;185;249mMoveKinematic\u001b[39m (\u001b[38;2;177;185;249mPhysicsWorld.cpp:1024\u001b[39m) always gets\u001b[60Ga nonzero veloc\u001b[76Gty,\u001b[80Gevery\u001b[86Gpad, deck, buggy and docked ship\r\u001b[2C\u001b[1Bstays awak\u001b[14G, and Jolt's state changes\u001b[41Gevery\u001b[47Gstep. That probably explains much\u001b[81Gof\u001b[84Gthe\u001b[88G13\u001b[91Gµs\u001b[94GJolt-and-docks\u001b[109Gcost.\r\u001b[2C\u001b[2B\u001b[1mThe fix:\u001b[22m for a body on the rails of\u001b[39Gthe\u001b[43Gsame\u001b[48Gbody\u001b[53Gits\u001b[57Glocal\u001b[63Gframe\u001b[69Gbelongs\u001b[77Gto,\u001b[81Ggive\u001b[86GJolt\u001b[91Gthe\u001b[95Gtarget\u001b[102Gin\u001b[105Gthe\u001b[109Gframe's\u001b[117Gown\r\u001b[2C\u001b[1Bcoordinates,\u001b[16Gthe\u001b[20Gturned\u001b[27Goffset,\u001b[35Ginstead\u001b[43Gof\u001b[46Gthe\u001b[50Ground\u001b[56Gtrip.\u001b[62GThe\u001b[66Gtarget\u001b[73Gis\u001b[76Gthen\u001b[81Gthe\u001b[85Gsame\u001b[90Gevery\u001b[96Gstep,\u001b[102Gthe\u001b[106Gbodies\u001b[113Gcan\u001b[117Gfall\r\u001b[1B \u001b[3Gasleep, and th\u001b[19Gworld reaches a fixed point. This\u001b[53Gchang\u001b[59Gs the state on\u001b[74Gpurpose, so\u001b[86Gthe pinned hashe\u001b[104Gmov\u001b[108G: Jettison's\r\u001b[2C\u001b[1Bphysics recorded runs, the 8 world pins,\u001b[44Gand Manifest's on its next pin bum\u001b[79G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe contract\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHooks:\u001b[12G\u001b[22m\u001b[38;2;177;185;249mSimWorld::RegisterSystem(desc, Sim::Quiet)\u001b[39m,\u001b[56Gwhich\u001b[62Gkeeps\u001b[68G\u001b[38;2;177;185;249mEcs::SystemDescription\u001b[91G\u001b[39mgeneric.\u001b[100G\u001b[38;2;177;185;249mQuiet\u001b[106G\u001b[39mhas\u001b[110Gtwo\u001b[114Ghooks:\r\u001b[1B \u001b[3G  - \u001b[38;2;177;185;249mnext(const SimWorld&) → step\u001b[39m: the first step a\u001b[54G which \u001b[62Ghe system must really run, give\u001b[94G the sta\u001b[103Ge and\u001b[109Gn\u001b[112Gcommands\r\u001b[2C\u001b[1B    queued. It must\u001b[23Ghave no\u001b[31Gside \u001b[37Gffec\u001b[42Gs, and an earlier\u001b[60Ganswer\u001b[67Gis\u001b[70Galways\u001b[77Gsafe.\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mskip(SimWorld&, double lastBegan)\u001b[39m:\u001b[42Gleaves\u001b[49Gexactly\u001b[57Gthe\u001b[61Gstate\u001b[67Gthat\u001b[72Gstepping\u001b[81Gthe\u001b[85Ggap\u001b[89Gwould\u001b[95Ghave\u001b[100Gleft.\u001b[106GThe\u001b[110Gclock\u001b[116Ghas\r\u001b[1B \u001b[3G    already moved; \u001b[38;2;177;185;249mlastBegan\u001b[32G\u001b[39mis\u001b[35Gwhen\u001b[40Gthe\u001b[44Glast\u001b[49Gskipped\u001b[57Gstep\u001b[62Gbegan,\u001b[69Gwhich\u001b[75Gmatters\u001b[83Gbecause\u001b[91Gthe\u001b[95Gclock's\u001b[103Gtime\u001b[108Gis\u001b[111Ga\u001b[113Grunning\r\u001b[6C\u001b[1Bsum,\u001b[12Gnot\u001b[16Gstep\u001b[21G×\u001b[23Gdt.\r\u001b[1B \u001b[3G- \u001b[1mDefault:\u001b[22m a system with no hook must run every step. Until\u001b[63Gevery\u001b[69Gsystem\u001b[76Ghas\u001b[80Ga\u001b[82Ghook,\u001b[88Gthe\u001b[92Gworld\u001b[98Gsimply\u001b[105Gsteps.\r\u001b[1B  - \u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[K\u001