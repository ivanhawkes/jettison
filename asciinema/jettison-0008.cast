[0.956, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe contract\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHooks:\u001b[22m \u001b[38;2;177;185;249mSimWorld::RegisterSystem(desc, Sim::Quiet)\u001b[39m, wh\u001b[59Gch k\u001b[64Geps \u001b[38;2;177;185;249mEcs::SystemDescription\u001b[91G\u001b[39mgene\u001b[96Gic. \u001b[38;2;177;185;249mQuiet\u001b[106G\u001b[39mhas\u001b[110Gtwo\u001b[114Ghooks:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mnext(const SimWorld&) → step\u001b[39m: the first step at which the system must\u001b[77Greally run,\u001b[89Ggiven the \u001b[100Gtate and no\u001b[112Gcommands\r\u001b[4C\u001b[1B  queued.\u001b[15GIt\u001b[18Gmust\u001b[23Ghave\u001b[28Gno\u001b[31Gside\u001b[36Geffects,\u001b[45Gand\u001b[49Gan\u001b[52Gearlier\u001b[60Ganswer\u001b[67Gis\u001b[70Galways\u001b[77Gsafe.\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mskip(SimWorld&, double lastBegan)\u001b[39m:\u001b[42Gleaves\u001b[49Gexactly\u001b[57Gthe\u001b[61Gstate\u001b[67Gthat\u001b[72Gstepping\u001b[81Gthe\u001b[85Ggap\u001b[89Gwould\u001b[95Ghave\u001b[100Gleft.\u001b[106GThe\u001b[110Gclock\u001b[116Ghas\r\u001b[2C\u001b[1B    already moved;\u001b[22G\u001b[38;2;177;185;249mlastBegan\u001b[32G\u001b[39mis\u001b[35Gwhen\u001b[40Gthe\u001b[44Glast\u001b[49Gskipped\u001b[57Gstep\u001b[62Gbegan,\u001b[69Gwhich\u001b[75Gmatters\u001b[83Gbecause\u001b[91Gthe\u001b[95Gclock's\u001b[103Gtime\u001b[108Gis\u001b[111Ga\u001b[113Grunning\r\u001b[6C\u001b[1Bsum,\u001b[12Gnot\u001b[16Gstep\u001b[21G×\u001b[23Gdt.\r\u001b[2C\u001b[1B- \u001b[1mDefault:\u001b[22m a system\u001b[23Gwith\u001b[28Gno\u001b[31Ghook\u001b[36Gmust\u001b[41Grun\u001b[45Gevery\u001b[51Gstep.\u001b[57GUntil\u001b[63Gevery\u001b[69Gsystem\u001b[76Ghas\u001b[80Ga\u001b[82Ghook,\u001b[88Gthe\u001b[92Gworld\u001b[98Gsimply\u001b[105Gsteps.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- If commands\u001b[19Gare queued, or the soon\u001b[43Gst \u001b[38;2;177;185;249mnext\u001b[39m is \u001b[55Ghe next step, it takes one real step.\u001b[93G\u001b[K\r\u001b[2C\u001b[1B  - Otherwise it m\u001b[22Gve\u001b[26Gthe\u001b[30Gclock t\u001b[38G the\u001b[43Gstep\u001b[48Gbefore that soon\u001b[65Gst one, by repeated \u001b[38;2;177;185;249mAdvance\u001b[39m so the bits match\u001b[111G(23 M\u001b[K\r\u001b[4C\u001b[1B  additions is\u001b[20Gabout 25 ms). Then it calls\u001b[48Geach\u001b[53G\u001b[38;2;177;185;249mskip\u001b[58G\u001b[39min\u001b[61Gstep\u001b[66Gorder\u001b[72Gand\u001b[76Gruns\u001b[81Gthat\u001b[86Gstep\u001b[91Gfor\u001b[95Greal.\r\u001b[2C\u001b[1B- \u001b[1mWhat a quiet step promises:\u001b[22m it sends no\u001b[45Gevents,\u001b[53Gdraws\u001b[59Gno\u001b[62Grandom\u001b[69Gnumbers\u001b[77Gand\u001b[81Gapplies\u001b[89Gno\u001b[92Gcommands.\u001b[102GThe\u001b[106Gtests\u001b[112Genforce\r\u001b[2C\u001b[1B  this.\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEach engine system\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[10C\u001b[1Bphysics\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.888, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[2BManifest's stations\u001b[23Gdon't\u001b[29Gspin\u001b[34G(rotation\u001b[44Gperiod\u001b[51G0).\u001b[55GEven\u001b[60Gso,\u001b[64Ga\u001b[66Gpad's\u001b[72Gkinematic\u001b[82Gtarget\u001b[89Gis\u001b[92Gcomputed\u001b[101Gas\u001b[104G(station\u001b[113Gposition\r\u001b[2C\u001b[1B+\u001b[5Goffset)\u001b[13G−\u001b[15Gstation\u001b[23Gposition.\u001b[33GAbout\u001b[39G1.5\u001b[43G×\u001b[45G10¹¹\u001b[50Gm\u001b[52Gfrom\u001b[57Gthe\u001b[61Gstar,\u001b[67Gthat\u001b[72Grounds\u001b[79Gdifferently\u001b[91Gevery\u001b[97Gstep,\u001b[103Gby\u001b[106Gup\u001b[109Gto\u001b[112Gabout\u001b[118G30\r\u001b[2C\u001b[1Bµm. So \u001b[38;2;177;185;249mMoveKinematic\u001b[39m (\u001b[38;2;177;185;249mPhysicsWorld.cpp:1024\u001b[39m) always gets a\u001b[62Gnonzero velocity, every pad,\u001b[91Gd\u001b[93Gck, buggy and docked\u001b[114Gship\u001b[K\r\u001b[2C\u001b[1Bstays awake, and Jolt's state changes\u001b[41Gevery\u001b[51G. That probably explain\u001b[75G much of\u001b[84Gthe 13 µs Jolt-and-docks\u001b[109Gc\u001b[111Gst.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[22m for a body on the rails of the s\u001b[45Gm\u001b[47G body its\u001b[57Glocal frame belongs to,\u001b[81Ggive Jolt the\u001b[95Gt\u001b[97Grget in the frame's own\r\u001b[2C\u001b[1Bcoordinates, th\u001b[19G turned offset,\u001b[35Ginstead of the round trip.\u001b[62GThe target is then the s\u001b[87Gme every step, the bodies\u001b[113Gca\u001b[116G fall\r\u001b[2C\u001b[1Basleep, a\u001b[13Gd the worl\u001b[24G reaches\u001b[33Ga\u001b[35Gfixed\u001b[41Gpoint.\u001b[48GThis\u001b[53Gchanges\u001b[61Gthe\u001b[65Gstate\u001b[71Gon\u001b[74Gpurpose,\u001b[83Gso\u001b[86Gthe\u001b[90Gpinned\u001b[97Ghashes\u001b[104Gmove:\u001b[110GJettison's\r\u001b[2C\u001b[1Bphysics recorded runs, the 8 w\u001b[34Grld pins, and Manif\u001b[54Gst's on its next pin bump.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m