[0.105, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[49G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mCan you move gate rings to another reference frame to quiet their physics?\u001b[39m                                            \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMoving the ring to another\u001b[30Gframe\u001b[36Gwon't\u001b[42Gfix\u001b[46Git,\u001b[50Gsince\u001b[56Gno\u001b[59Gframe\u001b[65Gholds\u001b[71Gthe\u001b[75Gring\u001b[80Gstill.\u001b[87GJolt\u001b[92Gcan\u001b[96Gplace\u001b[102Gthe\u001b[106Gkinematic\u001b[116Gring\r\u001b[2C\u001b[1Bat\u001b[6Gits\u001b[10Grails\u001b[16Gpose\u001b[21Geach\u001b[26Gstep,\u001b[32Gwhich\u001b[38Gkeeps\u001b[44Git\u001b[47Gasleep,\u001b[55Gso\u001b[58GI'm\u001b[62Gchecking\u001b[71GJolt's\u001b[78Gbehaviour\u001b[88Gfor\u001b[92Gthat\u001b[97Gand\u001b[101Gwill\u001b[106Gremove\u001b[113Gthe\r\u001b[1B \u001b[3Gexact-target change I just\u001b[30Gmade.\u001b[38;2;153;153;153m · summary\u001b[46G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJolt works for this: resetting\u001b[34Ga\u001b[36Gbody's\u001b[43Gpose\u001b[48Gresets\u001b[55Gits\u001b[59Gsleep\u001b[65Gtest,\u001b[71Gso\u001b[74Gthe\u001b[78Gsaved\u001b[84Gstate\u001b[90Gdepends\u001b[98Gonly\u001b[103Gon\u001b[106Gpose,\u001b[112Gand\r\u001b[2C\u001b[1Bkinematic\u001b[13Gsensors\u001b[21Gonly\u001b[26Gsee\u001b[30Gdynamic\u001b[38Gbodies\u001b[45Ghere.\