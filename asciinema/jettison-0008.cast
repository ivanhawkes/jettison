[0.022, "o", "\u001b[H\r\u001b[4C\u001b[12Bthrowaway:\u001b[16Gyou w\u001b[22Git\u001b[25G the l\u001b[32Gast you need to measure or pr\u001b[62Gve one thing, rea\u001b[81Gthe result, th\u001b[96Gn delete it.\u001b[109GWhat\u001b[114Gyou\r\u001b[4C\u001b[1Bkeep is the ans\u001b[21Ger. The term comes\u001b[40Gfrom\u001b[45Gagil\u001b[50G practice: a narrow, deep\u001b[76Gprobe into an unknow\u001b[97G, rath\u001b[104Gr \u001b[107Ghan \u001b[112G slice\r\u001b[4C\u001b[1Bof finished\u001b[17Gwork.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BHere\u001b[10Gthe\u001b[14Gplan\u001b[19Gdepended\u001b[28Gon\u001b[31Gfacts\u001b[37Gnobody\u001b[44Ghad\u001b[48Gchecked,\u001b[57Gso\u001b[60GI\u001b[62Gran\u001b[66Gthe\u001b[70Gspike\u001b[76Gfirst:\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mWhat I added:\u001b[21G\u001b[22mtemporary\u001b[31Gcounters\u001b[40Gin\u001b[43G\u001b[38;2;177;185;249mPhysicsWorld::Step\u001b[39m,\u001b[63Gswitched\u001b[72Gon\u001b[75Gby\u001b[78Gan\u001b[81Genvironment\u001b[93Gvariable.\u001b[103GThey\u001b[108Greported\r\u001b[4C\u001b[1B \u001b[7Geach Jolt world's aw\u001b[28Gke\u001b[31Gb\u001b[33Gdies, whether its saved state\u001b[63Gchanged from one step t\u001b[87G the next, and how fa\u001b[109G each\u001b[K\r\u001b[6C\u001b[1Br\u001b[9Gils target moved. I als\u001b[33G added a \u001b[44Growaway test\u001b[57Gin \u001b[61Ghe s\u001b[66Gmple\u001b[71Gthat\u001b[76Gsw\u001b[79Gpt a day\u001b[88Gof rails t\u001b[99Grgets.\u001b[106G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mWhat I ran:\u001b[22m Manifest's existing cruising test and\u001b[57Gthe sample's s\u001b[72Gations, with those\u001b[91Gcounters on.\u001b[K\r\u001b[13C\u001b[1B\u001b[1mlearned:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B \u001b[7G- Jolt already settles\u001b[30Gto\u001b[33Gbyte-identical\u001b[48Gstate\u001b[54Gin\u001b[57Gboth\u001b[62Gworlds.\r\u001b[8C\u001b[1BThe rounding\u001b[22Gchang\u001b[28G to the targ\u001b[41Gts is rare (2–14 times a \u001b[67Gay)\u001b[71Gbut\u001b[75Gcan't\u001b[81Gbe\u001b[84Gpredicted,\u001b[95Gso\u001b[98Gthe\u001b[102Gexact-target\u001b[115Gfix\u001b[27;1H"]
