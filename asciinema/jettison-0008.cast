[0.077, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G   \u001b[2m 619 \u001b[22m } \u001b[38;2;117;113;94m// namespace\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 620 \u001b[12G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m21\u001b[15G\u001b[22m\u001b[38;2;117;113;94mA journey d\u001b[27Garer than half\u001b[42Gas much\u001b[50Gagain as it\u001b[62Gwas fail\u001b[71G. Timed only in\u001b[87Gan optimised buil\u001b[106Gwithout\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mOre to Brine now runs in 2.37 s through the console, about 120 times faster than the 4 min 50 s stepped baseline,\u001b[117Gso\r\u001b[2C\u001b[1BI'm setting that as the budget. Next I'll diff the full fixture loop under the old and new pins to confirm Manifest's\r\u001b[2C\u001b[1Bbehaviour is unchanged.\u001b[38;2;153;153;153m · summary\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/tools/console/tests/ManifestConsoleTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[2m 615 \u001b[22m \u001b[38;2;117;113;94m// Ore to Brine on the manned profile through the console's long step, its quiet steps passed over\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 616 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m// (Jettison::Sim::Quiet), in seconds: the best of three in Lythir's release build, measured 2026-11-2\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m     \u001b[22m \u001b[38;2;117;113;94m0\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 617 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m// (L27). Stepped, it took 4 min 50 s.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 618 -\u001b[38;2;248;248;242mconstexpr double kJourneySeconds = \u001b[48;2;92;2;0m10\u001b[48;2;61;1;0m.\u001b[48;2;92;2;0m0\u001b[48;2;61;1;0m;                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 618 +\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m kJourneySeconds = \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m2\u001b[48;2;2;40;0m.\u001b[48;2;4;71;0m37\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m;                                                              \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m619\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// namespace\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 620 \u001b[22m                                    \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
