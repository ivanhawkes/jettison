[0.121, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gphysics\u001b[15Gtest\u001b[20Gnow\u001b[24Gfails\u001b[30Gwithout\u001b[38Gthe\u001b[42Gfix\u001b[46Gand\u001b[50Gpasses\u001b[57Gwith\u001b[62Git,\u001b[66Gso\u001b[69Gthat\u001b[74Gstep\u001b[79Gis\u001b[82Gdone.\u001b[88GI'm\u001b[92Greading\u001b[100Gthe\u001b[104Gflight\u001b[111Gmodel\u001b[117Gand\r\u001b[2C\u001b[1Bthe\u001b[7Gdocks'\u001b[14Gdeck\u001b[19Gand\u001b[23Gqueue\u001b[29Gcode\u001b[34Gbefore\u001b[41Gwriting\u001b[49Gthe\u001b[53Gsim\u001b[57Gcontract.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mCan you move gate rings to another reference frame to quiet their physics?\u001b[39m                                            \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m Moving the ring to another frame won't fix it, since no frame holds the ring still. Jolt can place the kinematic ring\u001b[K\r\u001b[2C\u001b[1Bat\u001b[6Gits\u001b[10Grails\u001b[16Gpose\u001b[21Geach\u001b[26Gstep,\u001b[32Gwhich\u001b[38Gkeeps\u001b[44Git\u001b[47Gasleep,\u001b[55Gso\u001b[58GI'm\u001b[62Gchecking\u001b[71GJolt's\u001b[78Gbehaviour\u001b[88Gfor\u001b[92Gthat\u001b[97Gand\u001b[101Gwill\u001b[106Gremove\u001b[113Gthe\r\u001b[2C\u001b[1Bexact-target change I\u001b[25Gjust\u001b[30Gmade.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJolt works for this: rese\u001b[29Gting a body's pose\u001b[48Gresets\u001b[55Gits\u001b[59Gsleep\u001b[65Gtest,\u001b[71Gso\u001b[74Gthe\u001b[78Gsaved\u001b[84Gstate\u001b[90Gdepends\u001b[98Gonly\u001b[103Gon\u001b[106Gpose,\u001b[112Gand\r\u001b[2C\u001b[1Bkinematic\u001b[13Gsensors\u001b[21Gonly\u001b[26Gsee\u001b[30Gdynamic\u001b[38Gbodies\u001b[45Ghere.\u001b[51GI'm\u001b[55Greverting\u001b[65Gthe\u001b[69Gexact-target\u001b[82Gchange\u001b[89Gand\u001b[93Gimplementing\u001b[106Gthe\u001b[110Ghold\u001b[115Grule\r\u001b[1B \u001b[3Gn\u001b[5Gxt.\u001b[38;2;153;153;153m · summary\u001b[19G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[3GTi\u001b[38;2;235;159;127mnke\u001b[38;2;215;119;87mring… \u001b[42G\u001b[38;2;153;153;153mthought for 32s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
