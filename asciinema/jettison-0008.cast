[0.052, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 538 +\u001b[38;2;248;248;242mstep does. A change made to the registry                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 539 \u001b[22m between steps other than by a command is not seen until a step runs.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 540 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m41\u001b[12G\u001b[22mThe \u001b[17Gngine's syst\u001b[30Gms:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAll 33 suites pass. Before\u001b[30Gthe\u001b[34Ggate,\u001b[40Ga\u001b[42Gcheck\u001b[48Gthat\u001b[53Gthe\u001b[57Gstricter\u001b[66Gflight\u001b[73Grule\u001b[78Ghasn't\u001b[85Gstopped\u001b[93GManifest's\u001b[104Gcruise\u001b[111Gbeing\r\u001b[2C\u001b[1Bpassed\u001b[10Gover.\u001b[16GA\u001b[18Gship\u001b[23Gthat\u001b[28Gkeeps\u001b[34Ga\u001b[36Greference\u001b[46Gwhile\u001b[52Gcruising\u001b[61Gwould\u001b[67Gnow\u001b[71Gstep\u001b[76Gevery\u001b[82Gstep:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest is unaffected:\u001b[27Gstill\u001b[33G4,031\u001b[39Gcalls\u001b[45Gwith\u001b[50Gmatching\u001b[59Gstate,\u001b[66Gand\u001b[70G2.38\u001b[75Gs\u001b[77Gfrom\u001b[82GOre\u001b[86Gto\u001b[89GBrine.\u001b[96GRunning\u001b[104GJettison's\u001b[115Ggate\r\u001b[2C\u001b[1Bon\u001b[6Gthe\u001b[10Gfixes:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate passed\u001b[19G(510 s, every\u001b[33Gstage).\u001b[41GCommitting\u001b[52Gthe\u001b[56Gfixes\u001b[62Gwith\u001b[67Gthe\u001b[71Groadmap's\u001b[81Gstatus\u001b[88Gline\u001b[93Gbrought\u001b[101Gup\u001b[104Gto\u001b[107Gdate,\u001b[113Gthen\r\u001b[1B  pushing so Manifest can pin the result:\u001b[K\r\u001b[46C\u001b[2B\u001b[38;2;153;153;153mthought for 2s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
