[0.497, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- If commands\u001b[19Gare queued, or the soon\u001b[43Gst \u001b[38;2;177;185;249mnext\u001b[39m is \u001b[55Ghe next step, it takes one real step.\u001b[93G\u001b[K\r\u001b[2C\u001b[1B  - Otherwise it m\u001b[22Gve\u001b[26Gthe\u001b[30Gclock t\u001b[38G the\u001b[43Gstep\u001b[48Gbefore that soon\u001b[65Gst one, by repeated \u001b[38;2;177;185;249mAdvance\u001b[39m so the bits match\u001b[111G(23 M\u001b[K\r\u001b[4C\u001b[1B  additions is\u001b[20Gabout 25 ms). Then it calls\u001b[48Geach\u001b[53G\u001b[38;2;177;185;249mskip\u001b[58G\u001b[39min\u001b[61Gstep\u001b[66Gorder\u001b[72Gand\u001b[76Gruns\u001b[81Gthat\u001b[86Gstep\u001b[91Gfor\u001b[95Greal.\r\u001b[2C\u001b[1B- \u001b[1mWhat a quiet step promises:\u001b[22m it sends no\u001b[45Gevents,\u001b[53Gdraws\u001b[59Gno\u001b[62Grandom\u001b[69Gnumbers\u001b[77Gand\u001b[81Gapplies\u001b[89Gno\u001b[92Gcommands.\u001b[102GThe\u001b[106Gtests\u001b[112Genforce\r\u001b[2C\u001b[1B  this.\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEach engine system\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[10C\u001b[1Bphysics\r\u001b[8C\u001b[1BNext step, unless its Jolt state is a proven fixed point:\u001b[67Gno\u001b[70Gdynamic\u001b[78Gbody,\u001b[84Gno\u001b[87Gbody\u001b[92Gmade\u001b[97Gor\u001b[100Gremoved,\u001b[109Gand\u001b[113Geach\r\u001b[2C\u001b[1B  world's\u001b[14Gtate byt\u001b[23Gs\u001b[25Gunchanged over th\u001b[43G last two s\u001b[55Geps. Hash only whe\u001b[75Gnothing m\u001b[85Gved, so a busy\u001b[100Gst\u001b[103Gp costs no\u001b[115Ging.\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m Rails\u001b[15GTransforms\u001b[26Gand\u001b[30Gthe\u001b[34Grecords'\u001b[43Glast\u001b[48Gplacements\u001b[59Gat\u001b[62Gthe\u001b[66Gfinal\u001b[72Gtime;\u001b[78Geach\u001b[83Gframe's\u001b[91Gorigin\