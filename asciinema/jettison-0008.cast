[0.016, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 195 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m//   3. What the game wrote is applied: a static or dynamic body whose Transform was written is\r\u001b[1B\u001b[39m     \u001b[2m 196 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m//      placed there, a dynamic body whose Velocity was written takes it, and every kinematic body\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 197 -\u001b[38;2;248;248;242m//      is moved towards its Transform over the step\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mThen\u001b[48;2;61;1;0m \u001b[48;2;92;2;0meach\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mdynamic\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mbody\u001b[48;2;61;1;0m \u001b[48;2;92;2;0min\u001b[48;2;61;1;0m \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mdefined\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mframe\u001b[48;2;61;1;0m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 197 +\u001b[38;2;117;113;94m//      is moved towards its Transform over the step\u001b[48;2;4;71;0m;\u001b[48;2;2;40;0m \u001b[48;2;4;71;0min\u001b[48;2;2;40;0m \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mworld\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mwith\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mnothing\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mdynamic\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mit\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mis put\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 198 +\u001b[38;2;117;113;94m//      there instead, at rest and asleep, its Velocity what the move implies, so its state is its\u001b[38;2;248;248;242m    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 199 +\u001b[38;2;117;113;94m//      place alone (docs/architecture.md, \"Quiet steps\"). Then each dynamic body in a defined frame\u001b[38;2;248;248;242m  \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 200 \u001b[22m \u001b[38;2;117;113;94m//      gains what its frame's gravity gives it over the step, from where the bodies are as the\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 201 \u001b[22m \u001b[38;2;117;113;94m//      step begins.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 202 \u001b[22m \u001b[38;2;117;113;94m//   4. Each frame's worlds step, in identifier order, on one thread.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs\u001b[8Gdone.\u001b[14GNow\u001b[18Gthe\u001b[22Gformat\u001b[29Gcheck,\u001b[36Gdeclaration\u001b[48Gspacing\u001b[56Gand\u001b[60Gclang-tidy\u001b[71Gover\u001b[76Gthe\u001b[80Gchanged\u001b[88Gunits,\u001b[95Gthen\u001b[100Gthe\u001b[104Ggate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gfor\u001b[15Gf\u001b[17Gin\u001b[20G'source/engine/ai/src/BehaviourTree.cpp'…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ for f in 'source/engine/ai/src/BehaviourTree.cpp' 'source/engine/ai/src/Steering.cpp' \u001b[95G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m'source/engine/ai/tests/BehaviourTreeTests.cpp' 'source/engine/dock/src/Docks.cpp' \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m'source/engine/dock/tests/ApproachTests.cpp' 'source/engine/dock/tests/DeckTests.cpp' \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m'sour\u001b[12Ge/engine/physics/src/Flight.cpp' 'so…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
