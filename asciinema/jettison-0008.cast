[0.054, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(git s\u001b[14Ga\u001b[16Gh pu\u001b[21Gh\u001b[23G-- source/engine/physics/src/Flight.cpp source/engine/sim/src/SimWorld.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mSaved\u001b[12Gworking\u001b[20Gdirectory\u001b[30Gand\u001b[34Gindex\u001b[40Gstate\u001b[46GWIP\u001b[50Gon\u001b[53Gfeature-base:\u001b[67G800a5cc\u001b[75GSim:\u001b[80Ga\u001b[82Gquiet's\u001b[90Gskip\u001b[95Gis\u001b[98Gtold\u001b[103Ghow\u001b[107Gmany\u001b[112Gstep\r\u001b[1B \u001b[3G   s it passed\u001b[18Gover\u001b[23G\u001b[K\r\u001b[5C\u001b[1BUpdated \u001b[1msource/engine/sim/src/SimWorld.cpp\u001b[22m \u001b[38;2;179;89;107m-4\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated \u001b[1msource/engine/physics/src/Flight.cpp\u001b[51G\u001b[22m\u001b[38;2;56;166;96m+1\u001b[54G\u001b[38;2;179;89;107m-8\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(a git step in this command can move the working tree, so these may be its changes, not edits) \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m3\u001b[9G\u001b[22mshell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe F4 test passes even\u001b[27Gwithout\u001b[35Gits\u001b[39Gfix,\u001b[44Gso\u001b[47Git\u001b[50Gisn't\u001b[56Greproducing\u001b[68Gthe\u001b[72Gbug,\u001b[77Gsince\u001b[83Gthe\u001b[87Gship's\u001b[94Gchange\u001b[101Gnever\u001b[107Greaches\r\u001b[2C\u001b[1Bexactly\u001b[11Gzero.\u001b[17GI'm\u001b[21Greading\u001b[29Gthe\u001b[33Greviewer's\u001b[44Greproduction\u001b[57Gnext,\u001b[63Gwhich\u001b[69Gfirst\u001b[75Gmatches\u001b[83Gthe\u001b[87Gship's\u001b[94Gvelocity\u001b[103Gto\u001b[106Gthe\u001b[110Greference\r\u001b[1B \u001b[3Gexactly.\u001b[38;2;153;153;153m · summary\u001b[22G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe reviewer's version\u001b[26Ghas\u001b[30Gphysics\u001b[38Gcopy\u001b[43Gthe\u001b[47Greference's\u001b[59Gvelocity\u001b[68Gat\u001b[71Ga\u001b[73Gfixed\u001b[79Gstep,\u001b[85Gso\u001b[88Gflight\u001b[95Gnever\u001b[101Gsees\u001b[106Gthe\u001b[110Gchange.\u001b[118GI'm\r\u001b[1B  rewriting my test that way, using the turning ring as the reference.\u001b[38;2;153;153;153m · summary\r\u001b[46C\u001b[2Bthought for 5s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
