[3.226, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe finding that decides it\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BManifest's\u001b[14Gstations\u001b[23Gdon't\u001b[29Gspin\u001b[34G(rotation\u001b[44Gperiod\u001b[51G0).\u001b[55GEven\u001b[60Gso,\u001b[64Ga\u001b[66Gpad's\u001b[72Gkinematic\u001b[82Gtarget\u001b[89Gis\u001b[92Gcomputed\u001b[101Gas\u001b[104G(station\u001b[113Gposition\r\u001b[2C\u001b[1B+ of\u001b[8Gse\u001b[11G) − station\u001b[23Gp\u001b[25Gsi\u001b[28Gion. Abou\u001b[38G 1.5 × 10¹¹ m from the star, that\u001b[72Grounds diffe\u001b[85Gen\u001b[88Gly every step, by up t\u001b[111G ab\u001b[115Gut 30\u001b[K\r\u001b[2C\u001b[1Bµm. So \u001b[38;2;177;185;249mMoveKinematic\u001b[39m (\u001b[38;2;177;185;249mPhysicsWorld.cpp:1024\u001b[39m) always ge\u001b[58Gs a nonzero vel\u001b[74Gcity, every pad,\u001b[91Gdeck,\u001b[97Gbuggy\u001b[103Gand docked ship\u001b[K\r\u001b[2C\u001b[1Bstays awake, and Jolt's state changes every step. That probably explains much of the 13\u001b[91Gµs Jolt-and-docks \u001b[110Gost.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[12G\u001b[22mfor\u001b[16Ga\u001b[18Gbody\u001b[23Gon\u001b[26Gthe\u001b[30Grails\u001b[36Gof\u001b[39Gthe\u001b[43Gsame\u001b[48Gbody\u001b[53Gits\u001b[57Glocal\u001b[63Gframe\u001b[69Gbelongs\u001b[77Gto,\u001b[81Ggive\u001b[86GJolt\u001b[91Gthe\u001b[95Gtarget\u001b[102Gin\u001b[105Gthe\u001b[109Gframe's\u001b[117Gown\r\u001b[2C\u001b[1Bcoordinates,\u001b[16Gthe turned offset, instead\u001b[43Gof the round trip. The targ\u001b[71Gt is then\u001b[81Gthe same every step,\u001b[102Gthe bodies can\u001b[117Gfall\r\u001b[2C\u001b[1Basleep, and the world reaches a\u001b[35Gfixed point. This changes the s\u001b[68Gte on purpose, so th\u001b[90Gpinned hashes move: Jettison's\u001b[K\r\u001b[2C\u001b[1Bphysics\u001b[11Grecord\u001b[18Gd runs, the 8 world pins, and\u001b[48GManifest's on its next\u001b[71Gpin bump.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe contract\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHooks:\u001b[12G\u001b[22m\u001b[38;2;177;185;249mSimWorld::RegisterSystem(desc, Sim::Quiet)\u001b[39m,\u001b[56Gwhich\u001b[62Gkeeps\u001b[68G\u001b[38;2;177;185;249mEcs::SystemDescription\u001b[91G\u001b[39mgeneric.\u001b[100G\u001b[38;2;177;185;249mQuiet\u001b[106G\u001b[39mhas\u001b[110Gtwo\u001b[114Ghooks:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mnext(const SimWorld&) → step\u001b[39m: the first step at which th\u001b[64G system must really run, giv\u001b[94G the state and no commands\r\u001b[4C\u001b[1B \u001b[7Gqueued. It must have no side eff\u001b[40Gcts, and an\u001b[52Gearlier answer is always\u001b[77Gsafe.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mskip(SimWorld&, double lastBegan)\u001b[39m: leaves\u001b[49Gexactly the state\u001b[67Gthat stepping the\u001b[85Ggap\u001b[89Gwould\u001b[95Ghave\u001b[100Gleft.\u001b[106GThe\u001b[110Gclock\u001b[116Ghas\r\u001b[4C\u001b[1B \u001b[7Galready moved; \u001b[38;2;177;185;249mlastBegan\u001b[39m is when the las\u001b[76Gatters bec\u001b[87Guse the\u001b[95Gclock's \u001b[104Gime is a running\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.062, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mThe finding that decides it\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BManifest's\u001b[14Gstations\u001b[23Gdon't\u001b[29Gspin\u001b[34G(rotation\u001b[44Gperiod\u001b[51G0).\u001b[55GEven\u001b[60Gso,\u001b[64Ga\u001b[66Gpad's\u001b[72Gkinematic\u001b[82Gtarget\u001b[89Gis\u001b[92Gcomputed\u001b[101Gas\u001b[104G(station\u001b[113Gposition\r\u001b[2C\u001b[1B+ of\u001b[8Gse\u001b[11G) − station\u001b[23Gp\u001b[25Gsi\u001b[28Gion. Abou\u001b[38G 1.5 × 10¹¹ m from the star, that\u001b[72Grounds diffe\u001b[85Gen\u001b[88Gly every step, by up t\u001b[111G ab\u001b[115Gut 30\u001b[K\r\u001b[2C\u001b[1Bµm. So \u001b[38;2;177;185;249mMoveKinematic\u001b[39m (\u001b[38;2;177;185;249mPhysicsWorld.cpp:1024\u001b[39m) always ge\u001b[58Gs a nonzero vel\u001b[74Gcity, every pad,\u001b[91Gdeck,\u001b[97Gbuggy\u001b[103Gand docked ship\u001b[K\r\u001b[2C\u001b[1Bstays awake, and Jolt's state changes every step. That probably explains much of the 13\u001b[91Gµs Jolt-and-docks \u001b[110Gost.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[12G\u001b[22mfor\u001b[16Ga\u001b[18Gbody\u001b[23Gon\u001b[26Gthe\u001b[30Grails\u001b[36Gof\u001b[39Gthe\u001b[43Gsame\u001b[48Gbody\u001b[53Gits\u001b[57Glocal\u001b[63Gframe\u001b[69Gbelongs\u001b[77Gto,\u001b[81Ggive\u001b[86GJolt\u001b[91Gthe\u001b[95Gtarget\u001b[102Gin\u001b[105Gthe\u001b[109Gframe's\u001b[117Gown\r\u001b[2C\u001b[1Bcoordinates,\u001b[16Gthe turned offset, instead\u001b[43Gof the round trip. The targ\u001b[71Gt is then\u001b[81Gthe same every step,\u001b[102Gthe bodies can\u001b[117Gfall\r\u001b[2C\u001b[1Basleep, and the world reaches a\u001b[35Gfixed point. This changes the s\u001b[68Gte on purpose, so th\u001b[90Gpinned hashes move: Jettison's\u001b[K\r\u001b[2C\u001b[1Bphysics\u001b[11Grecord\u001b[18Gd runs, the 8 world pins, and\u001b[48GManifest's on its next\u001b[71Gpin bump.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe contract\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHooks:\u001b[12G\u001b[22m\u001b[38;2;177;185;249mSimWorld::RegisterSystem(desc, Sim::Quiet)\u001b[39m,\u001b[56Gwhich\u001b[62Gkeeps\u001b[68G\u001b[38;2;177;185;249mEcs::SystemDescription\u001b[91G\u001b[39mgeneric.\u001b[100G\u001b[38;2;177;185;249mQuiet\u001b[106G\u001b[39mhas\u001b[110Gtwo\u001b[114Ghooks:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mnext(const SimWorld&) → step\u001b[39m: the first step at which th\u001b[64G system must really run, giv\u001b[94G the state and no commands\r\u001b[4C\u001b[1B \u001b[7Gqueued. It must have no side eff\u001b[40Gcts, and an\u001b[52Gearlier answer is always\u001b[77Gsafe.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mskip(SimWorld&, double lastBegan)\u001b[39m: leaves\u001b[49Gexactly the state\u001b[67Gthat stepping the\u001b[85Ggap\u001b[89Gwould\u001b[95Ghave\u001b[100Gleft.\u001b[106GThe\u001b[110Gclock\u001b[116Ghas\r\u001b[4C\u001b[1B \u001b[7Galready moved; \u001b[38;2;177;185;249mlastBegan\u001b[39m is when the last\u001b[49Gskipped\u001b[57Gst\u001b[60Gp began, which matters bec\u001b[87Guse the\u001b[95Gclock's \u001b[104Gime is a running\r\u001b[6C\u001b[1Bsum, not st\u001b[19Gp × dt.     \u001b[32G  \u001b[35G    \u001b[40G   \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
