[0.598, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mHooks:\u001b[22m \u001b[38;2;177;185;249mSimWorld::RegisterSystem(desc, Sim::Quiet)\u001b[39m, which k\u001b[64Geps \u001b[38;2;177;185;249mEcs::SystemDescription\u001b[39m ge\u001b[95Gric. \u001b[38;2;177;185;249mQuiet\u001b[39m has\u001b[110Gtwo ho\u001b[117Gks:\r\u001b[2C\u001b[1B  - \u001b[38;2;177;185;249mnext(const SimWorld&) → step\u001b[39m: the first step at which the system must really\u001b[84Grun,\u001b[89Ggiven\u001b[95Gthe\u001b[99Gstate\u001b[105Gand\u001b[109Gno\u001b[112Gcommands\r\u001b[6C\u001b[1Bqueued.\u001b[15GIt\u001b[18Gmust\u001b[23Ghave\u001b[28Gno\u001b[31Gside\u001b[36Geffects,\u001b[45Gand\u001b[49Gan\u001b[52Gearlier\u001b[60Ganswer\u001b[67Gis\u001b[70Galways\u001b[77Gsafe.\r\u001b[2C\u001b[1B  - \u001b[38;2;177;185;249mskip(SimWorld&, double lastBegan)\u001b[39m:\u001b[42Gleaves\u001b[49Gexactly\u001b[57Gthe\u001b[61Gstate\u001b[67Gthat\u001b[72Gstepping\u001b[81Gthe\u001b[85Ggap\u001b[89Gwould\u001b[95Ghave\u001b[100Gleft.\u001b[106GThe\u001b[110Gclock\u001b[116Ghas\r\u001b[6C\u001b[1Balready\u001b[15Gmoved;\u001b[22G\u001b[38;2;177;185;249mlastBegan\u001b[32G\u001b[39mis\u001b[35Gwhen\u001b[40Gthe\u001b[44Glast\u001b[49Gskipped\u001b[57Gstep\u001b[62Gbegan,\u001b[69Gwhich\u001b[75Gmatters\u001b[83Gbecause\u001b[91Gthe\u001b[95Gclock's\u001b[103Gtime\u001b[108Gis\u001b[111Ga\u001b[113Grunning\r\u001b[2C\u001b[1B \u001b[5G  sum,\u001b[12Gnot step × dt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefault:\u001b[22m a system with no hook must\u001b[41Grun every step. Until \u001b[64Gvery system has a hook, the world simply\u001b[105Gsteps.\u001b[112G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mSimWorld::FastForward(until) → step reached\u001b[39m:\u001b[22m\u001b[K\r\u001b[6C\u001b[1BIf commands are queued, or the soonest \u001b[38;2;177;185;249mnext\u001b[39m is the n\u001b[60Gxt s\u001b[66Gp, i\u001b[72Gtakes one r\u001b[84Gal step.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GOth\u001b[11Grwise it moves the clock to the step before tha\u001b[59G soonest one, by rep\u001b[80Gated \u001b[38;2;177;185;249mAdvance\u001b[39m so the bits \u001b[106Gatch\u001b[111G(23 M\u001b[K\r\u001b[6C\u001b[1Badditi\u001b[14Gns is abou\u001b[25G 25\u001b[29Gms).\u001b[34GThen\u001b[39Git\u001b[42Gcalls\u001b[48Geach\u001b[53G\u001b[38;2;177;185;249mskip\u001b[58G\u001b[39min\u001b[61Gstep\u001b[66Gorder\u001b[72Gand\u001b[76Gruns\u001b[81Gthat\u001b[86Gstep\u001b[91Gfor\u001b[95Greal.\r\u001b[4C\u001b[1B\u001b[1mWhat a quiet step promises:\u001b[22m it\u001b[36Gsends no\u001b[48Gnts, draws no random\u001b[69Gnumb\u001b[74Grs \u001b[78Gnd applies no\u001b[92Gc\u001b[94Gmmands. The \u001b[108Gsts\u001b[112Genforce\r\u001b[2C\u001b[1B \u001b[5Gthis.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEach engine system\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSystem:\u001b[22m physics\u001b[K\r\u001b[2C\u001b[1B\u001b[1mnext:\u001b[22m Next\u001b[14Gstep,\u001b[20Gunless\u001b[27Gits\u001b[31GJolt\u001b[36Gstate\u001b[42Gis\u001b[45Ga\u001b[47Gproven\u001b[54Gfixed\u001b[60Gpoint:\u001b[67Gno\u001b[70Gdynamic\u001b[78Gbody,\u001b[84Gno\u001b[87Gbody\u001b[92Gmade\u001b[97Gor\u001b[100Gremoved,\u001b[109Gand\u001b[113Geach\r\u001b[4C\u001b[1Bworld's\u001b[13Gstate\u001b[19Gbytes\u001b[25Gunchanged\u001b[35Gover\u001b[40Gthe\u001b[44Glast\u001b[49Gtwo\u001b[53Gsteps.\u001b[60GHash\u001b[65Gonly\u001b[70Gwhen\u001b[75Gnothing\u001b[83Gmoved,\u001b[90Gso\u001b[93Ga\u001b[95Gbusy\u001b[100Gstep\u001b[105Gcosts\u001b[111Gnothing.\r\u001b[2C\u001b[1B\u001b[1mskip:\u001b[22m Rails Transforms\u001b[26Gand\u001b[30Gthe\u001b[34Grecords'\u001b[43Glast\u001b[48Gplacements\u001b[59Gat\u001b[62Gthe\u001b[66Gfinal\u001b[72Gtime;\u001b[78Geach\u001b[83Gframe's\u001b[91Gorigin\u001b[98Gand\u001b[102Gvelocity\u001b[111Gfrom\u001b[116Gthe\r\u001b[4C\u001b[1Blast\u001b[10Gtwo\u001b[14Gclock\u001b[20Gtimes.\u001b[27GJolt\