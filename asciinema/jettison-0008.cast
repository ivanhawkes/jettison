[0.427, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[2m  9 \u001b[22m`FlightAtRest`\u001b[25Gnow\u001b[29Greturns\u001b[37Gfalse\u001b[43Gfor\u001b[47Gany\u001b[51Gflown\u001b[57Gentity\u001b[64G(other\u001b[71Gthan\u001b[76Ga\u001b[78Gkinematic\u001b[88Gbody\u001b[93Gin\u001b[96Ga\u001b[98Gframe)\u001b[105Gwhose\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m`FlightControls::reference`\u001b[38Gis\u001b[41Gvalid,\u001b[48Gis\u001b[51Gnot\u001b[55Gitself\u001b[62Gand\u001b[66Ghas\u001b[70Ga\u001b[72G`Velocity`:\u001b[84Gthe\u001b[88Greference's\u001b[100Gvelocity\u001b[109Gmay\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153m… +18 lines \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound\u001b[9G3\u001b[11Gcleared\u001b[19GF1–F5\u001b[25Gbut\u001b[29Gleft\u001b[34GF6:\u001b[38Ga\u001b[40Gflown\u001b[46Gentity\u001b[53Gon\u001b[56Grails\u001b[62Gwithout\u001b[70Ga\u001b[72Gbody\u001b[77Gstill\u001b[83Ggets\u001b[88Gturned\u001b[95Gby\u001b[98Gphysics,\u001b[107Gso\u001b[110Gits\r\u001b[1B \u001b[3Gworld-\u001b[10Gpace v\u001b[17Glocity keeps changing and flight's\u001b[52Gskip\u001b[57Gmisses\u001b[64Git.\u001b[68GI'm\u001b[72Gmaking\u001b[79Gflight\u001b[86Grun\u001b[90Gevery\u001b[96Gstep\u001b[101Gfor\u001b[105Gsuch\u001b[110Gentities,\r\u001b[1B  except kinematic bodies\u001b[27Gin\u001b[30Ga\u001b[32Gframe,\u001b[39Gand\u001b[43Gadding\u001b[50Ga\u001b[52Gregression\u001b[63Gtest\u001b[68Gfrom\u001b[73Gthe\u001b[77Greviewer's\u001b[88Greproduction.\u001b[38;2;153;153;153m · summary\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe reviewer arranged an exact match: the rails' rotation is the identity at the moment the velocity is set. I'll\u001b[117Gdo\r\u001b[2C\u001b[1Bthe same in the test, with a small turning frame of its own:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(source/engine/physics/tests/RoomTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m62\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 472 \u001b[22m }                                  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
