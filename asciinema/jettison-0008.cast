[0.448, "o", "\u001b[?25l\u001b[H\u001b[3G  \u001b[6G- log\u001b[12Gthe\u001b[16Gjitter in the\u001b[30Glocal-fr\u001b[39Gme targets;\u001b[K\r\u001b[9C\u001b[1Bnfirm kinematic bod\u001b[30Ges sle\u001b[37Gp once\u001b[44Gtheir\u001b[50Gtargets\u001b[58Gare\u001b[62Gconstant;\r\u001b[7C\u001b[1Bc\u001b[10Gnfirm\u001b[16Ga quiet Jolt \u001b[38;2;177;185;249mUpdate\u001b[39m le\u001b[39Gv\u001b[41Gs \u001b[38;2;177;185;249mSaveState\u001b[53G\u001b[39mbyte-identical.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[5C\u001b[1BTwo risks\u001b[16Gto watch: a kinematic sen\u001b[42Gor (a gate's ring) can never\u001b[71Gsleep,\u001b[78Gand\u001b[82GJolt's\u001b[89Gcontact\u001b[97Gcache\u001b[103Gtakes\u001b[109Ga\u001b[111Gstep\u001b[116Gor\r\u001b[5C\u001b[1Btwo\u001b[10Gto\u001b[13Gsettle.\u001b[21GIf\u001b[24Gthe\u001b[28Gspike\u001b[34Gfails,\u001b[41Gthe\u001b[45Gplan\u001b[50Gchanges.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPhysics:\u001b[22m the\u001b[19Gexa\u001b[23Gt local-fr\u001b[34Gme target and\u001b[48Gthe fixed-point ch\u001b[67Gck.\u001b[71GRe-pin\u001b[78Gthe\u001b[82Ghashe\u001b[89Gwith evidenc\u001b[104Ghat only\u001b[K\r\u001b[5C\u001b[1Bkinematic positions in Jolt\u001b[34Gmoved\u001b[41Gby micrometres. Measure\u001b[65G\u001b[38;2;177;185;249mstep-budget\u001b[77G\u001b[39mas\u001b[80Gwell:\u001b[86Gsleeping\u001b[95Gpads\u001b[100Gmay\u001b[104Gcut\u001b[108Gthe\u001b[112Gcruising\r\u001b[2C\u001b[1B  \u001b[6Gstep on their own.\u001b[25G\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSim:\u001b[22m \u001b[38;2;177;185;249mQuiet\u001b[39m, \u001b[38;2;177;185;249mFastForward\u001b[39m and\u001b[34Gthe sim-suite tes\u001b[52Gs: fast-fo\u001b[63Gward and stepping give\u001b[86Gth\u001b[89G same\u001b[95Gh\u001b[97Gsh; \u001b[102G queued command\u001b[K\r\u001b[5C\u001b[1Btakes one step; \u001b[38;2;177;185;249muntil\u001b[28G\u001b[39mis\u001b[31Grespected;\u001b[42Ga\u001b[44Gsystem\u001b[51Gwith\u001b[56Gno\u001b[59Ghook\u001b[64Gstops\u001b[70Gany\u001b[74Gskip