[0.032, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m`PhysicsWorld::Skip`\u001b[31Gnow\u001b[35Gputs\u001b[40Ga\u001b[42Gstatic\u001b[49Grecord\u001b[56Gon\u001b[59Grails\u001b[65Gas\u001b[68GStep's\u001b[75G3\u001b[77Gdoes:\u001b[83Gif\u001b[86Gits\u001b[90Gnew\u001b[94GTransform\u001b[104Gdiffers\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m…\u001b[8G+23 \u001b[13Gines \u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gsecond revi\u001b[19Gw rou\u001b[27Grais\u001b[32Gd two new \u001b[43Gssues: a blocker where\u001b[66Ga ship with a moving ref\u001b[91Grenc\u001b[96G can't be tre\u001b[111Ged as\u001b[K\r\u001b[2C\u001b[1Bquiet, and a major\u001b[22Gone\u001b[26Gwhere\u001b[32GFastForward\u001b[44Gskips\u001b[50Gthe\u001b[54Gscheduler's\u001b[66Gdependency\u001b[77Gcheck.\u001b[84GSince\u001b[90Gtwo\u001b[94Grounds\u001b[101Gis\u001b[104Gthe\u001b[108Glimit,\u001b[115GI'll\r\u001b[2C\u001b[1Bfix\u001b[7Gboth\u001b[12Gwith\u001b[17Gtests\u001b[23Gand\u001b[27Gleave\u001b[33Gthe\u001b[37Gdecision\u001b[46Gon\u001b[49Ga\u001b[51Gthird\u001b[57Ground\u001b[63Gto\u001b[66Gyou,\u001b[71Gand\u001b[75GI'm\u001b[79Gchecking\u001b[88Gthe\u001b[92Gscheduler's\u001b[104Gvalidation\u001b[115Gcall\r\u001b[2C\u001b[1Bnow.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/sim/src/SimWorld.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[39m std::