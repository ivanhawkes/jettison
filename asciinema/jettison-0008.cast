[0.003, "o", "\u001b[?25l\u001b[H     \u001b[2m 201 \u001b[22m \u001b[38;2;117;113;94m//      step begins.\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 202 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m//   4. Each frame's worlds step, in identifier order, on one thread.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs done. Now the format check, declaration spacing and clang-tidy over the changed units, then the gate.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe grep\u001b[12Gpattern was escaped wrongly, so the tidy run was lost. I'll use the project's script, which checks\u001b[111Gthe\u001b[115Gwhole\r\u001b[2C\u001b[1Btree, and the declaration spacer's\u001b[38Gcheck\u001b[44Gmode:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTidy\u001b[8Gis\u001b[11Gclean.\u001b[18GThe\u001b[22Gonly\u001b[27Gtwo\u001b[31Gfiles\u001b[37Gthe\u001b[41Gspacer\u001b[48Gflags\u001b[54Gare\u001b[58Gin\u001b[61G\u001b[38;2;177;185;249mnet\u001b[39m,\u001b[66Gwhich\u001b[72GI\u001b[74Gdidn't\u001b[81Gtouch,\u001b[88Gand\u001b[92Gthey\u001b[97Gwere\u001b[102Galready\u001b[110Glike\u001b[115Gthat.\r\u001b[1B \u001b[3GRunning the gate now, about four\u001b[36Gminutes:\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning ./scripts/ci.sh\u001b[27G--werror\u001b[36G--asan\u001b[43G--log\u001b[49Gbuild/gate.…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ./scripts/ci.sh --werror --asan --log build/gate.log 2>&1 | tail -30 (1m 11s)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✶\u001b[3GTinkering… \u001b[38;2;153;153;153m(Run the full gate with werror and asan · 45m 34s · ↓\u001b[39m \u001b[38;2;153;153;153m120.5k tokens)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
