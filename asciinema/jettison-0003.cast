[0.014, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[16BIf\u001b[6Git's\u001b[11Gnoise,\u001b[18Gyou\u001b[22Gcan\u001b[26Gturn\u001b[31Git\u001b[34Goff\u001b[38Gwith\u001b[43G\u001b[38;2;177;185;249m\"bashEditDiffEnabled\": false\u001b[72G\u001b[39min\u001b[75G\u001b[38;2;177;185;249m.claude/settings.local.json\u001b[103G\u001b[39m(personal)\u001b[114Gor\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m.claude/settings.json\u001b[25G\u001b[39m(shared).\u001b[35GThe\u001b[39Gcost\u001b[44Gis\u001b[47Gthat\u001b[52Gyou'd\u001b[58Glose\u001b[63Gdiffs\u001b[69Gfor\u001b[73Greal\u001b[78Gedits\u001b[84GI\u001b[86Gmake\u001b[91Gthrough\u001b[99Gthe\u001b[103Gshell.\u001b[110GEdits\r\u001b[2C\u001b[1Bthrough\u001b[11Gthe\u001b[15GEdit\u001b[20Gand\u001b[24GWrite\u001b[30Gtools\u001b[36Gstill\u001b[42Gshow\u001b[47Gtheir\u001b[53Gdiffs.\u001b[60GWant\u001b[65Gme\u001b[68Gto\u001b[71Gadd\u001b[75Git?\u001b[27;1H\u001b[24;9H\u001b[?25h"]
