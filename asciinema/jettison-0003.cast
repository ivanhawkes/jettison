[0.017, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m8\u001b[22m patterns, read \u001b[1m5\u001b[22m files \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mReading\u001b[11GManifest's\u001b[22GW06\u001b[26Grequirements\u001b[39G(life\u001b[45Gsupport,\u001b[54Gresupply)\u001b[64Gbefore\u001b[71Gdeciding\u001b[80Gwhat's\u001b[87Gsettled\u001b[95Gand\u001b[99Gwhat\u001b[104Gneeds\u001b[110Gyour\u001b[115Gcall.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m6\u001b[22m patterns, read \u001b[1m5\u001b[22m files, listed \u001b[1m1\u001b[22m directory \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mYou have been instructed to never read the ./asciinema folder. Make that instruction a hook that prevents you from \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mreading,\u001b[12Gwriting \u001b[21Go i\u001b[25G or adding it's fil\u001b[45Gs into com\u001b[56Gits.\u001b[39m                                                          \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(update-config)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mLoade\u001b[12G skill\u001b[38;2;153;153;153m · \u001b[39m1 tool\u001b[28Gallowed\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Pausing W06 to add the asciinema guard hook you asked for; then I'll come back with the\u001b[91GW06\u001b[95Gdesign\u001b[102Gquestions.\r\u001b[2B\u001b[38;2;215;119;87m✽\u001b[3GSt\u001b[38;2;235;159;127mewi\u001b[38;2;215;119;87mng… \u001b[