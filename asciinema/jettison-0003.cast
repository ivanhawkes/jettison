001b[K\r\u001b[4C\u001b[1Btaking\u001b[12Ga tote of\u001b[22Gspace, until it is\u001b[41Gused up, and can't be\u001b[63Gunloaded.\u001b[73GA replaced cartridge is thrown\u001b[104Gaway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne-time grant:\u001b[22m the starter sh\u001b[36Gp\u001b[38Ggets full tanks\u001b[54Gand a\u001b[60Gfresh c\u001b[68Grtridge once, at p\u001b[87Gov\u001b[90Gsion\u001b[95Gng. D\u001b[101Gcking, reconnecting,\r\u001b[2C\u001b[1B \u001b[5Gretrying or loading\u001b[25Ga sav\u001b[31G never\u001b[38Gr\u001b[40Gfills them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlayers can see it:\u001b[25G\u001b[22mthe play\u001b[34Gr's\u001b[38Gview now includes\u001b[56Geach\u001b[61Gship's\u001b[68Goxygen,\u001b[76Gcartridges\u001b[87Gand\u001b[91Gconnection,\u001b[103Gand\u001b[107Gthe\u001b[111Gconsole\r\u001b[2C\u001b[1B \u001b[5Ghas \u001b[38;2;177;185;249mservice refill|replace\u001b[39m. Because the view changed, the network proto\u001b[77Gol version went from 2 to 3. One pin\u001b[114Ged save\r\u001b[7C\u001b[1Bh in the company tests mov\u001b[35Gd, b\u001b[40Gcause saves now hold the new life-support data.\u001b[88G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249mb9c879c\u001b[13G\u001b[39mupdates\u001b[21Gthe\u001b[25Groadmap\u001b[33Gand\u001b[37Ghistory:\u001b[46GW06\u001b[50Gis\u001b[53Gdone,\u001b[59GW07\u001b[63Gis\u001b[66Gnext.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m6042438\u001b[13G\u001b[39mis th\u001b[19G asciinema hook. I narrowed \u001b[76Gg\u001b[78Gits\u001b[82Gown\u001b[86Gfile,\u001b[92G\u001b[38;2;177;185;249mguard-asciinema.sh\u001b[39m.\u001b[112GIt\u001b[115Gnow\u001b[27;1H\u001b[24;3H\u001b[?25h"]
