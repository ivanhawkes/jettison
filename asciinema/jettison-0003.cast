;230;219;116m\"\u001b[36G'{hookSpecificOutput: {hookEventName: \"PreToolUse\",\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +29 lines \u001b[39m\u001b[K\r\u001b[12C\u001b[2B\u001b[38;2;153;153;153m2m 11s · ↓\u001b[39m \u001b[38;2;153;153;153m10.5k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
