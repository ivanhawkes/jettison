[0.080, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPerf\u001b[8Gis\u001b[11Gavailable.\u001b[22GNext:\u001b[28Gprofile\u001b[36Ga\u001b[38Gcruising\u001b[47Gstep\u001b[52Gin\u001b[55GManifest's\u001b[66Grelease\u001b[74Gbuild\u001b[80Gwith\u001b[85Ga\u001b[87Gtemporary\u001b[97Gtest\u001b[102Gcase,\u001b[108Gthen\u001b[113Gdesign\r\u001b[2C\u001b[1Bthe\u001b[7Gsliced\u001b[14Gstep.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIs game time stepping only enabled for non-networked builds? A network build shouldn't let anyone who isn't an admin \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mtime step the game.\u001b[39m                                                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m4\u001b[22m patterns, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m A server can't be time-stepped by anyone, admins included: the protocol only carries Welcome, Submit and Reply, and\u001b[K\r\u001b[2C\u001b[1Bthe\u001b[7Gconsole's\u001b[17Gstep\u001b[22Gonly\u001b[27Gadvances\u001b[36Ga\u001b[38Gworld\u001b[44Gstarted\u001b[52Glocally\u001b[60Gwith\u001b[65Ghost.\u001b[71GI'll\u001b[76Gmake\u001b[81Gstep\u001b[86Grefuse\u001b[93Gwhile\u001b[99Gconnected\u001b[109Gas\u001b[112Gpart\u001b[117Gof\r\u001b[2C\u001b[1BL26, and the profiling build is configuring now.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mok\u001b[39m                                                                                                                    \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;