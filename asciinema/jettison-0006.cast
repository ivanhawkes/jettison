[0.253, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/build-and-gates.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 57 \u001b[22m The console suite checks command registration, quoted paths and names, completion and history,\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 58 \u001b[22m typed errors, numeric bounds, configuration reloads and the load/generate/tick/trade-planning\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 59 \u001b[22m workflow. Run it without a terminal using `ctest --preset clang-debug -R '^console$'`.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m60\u001b[11G\u001b[38;2;248;248;242m`step-budget`\u001b[25Gruns\u001b[30Gone\u001b[34Gof\u001b[37Gits\u001b[41Gcases\u001b[47Galone\u001b[53G(`RUN_SERIAL`):\u001b[69Ga\u001b[71Gcruising\u001b[80Ghosted\u001b[87Gstep,\u001b[93Gtimed\u001b[99Gin\u001b[102Gan\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 61 +\u001b[38;2;248;248;242moptimised build without sanitisers and not on CI, fails above half as much again as the figure         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 62 +\u001b[38;2;248;248;242mmeasured on Lythir ([\u001b[38;2;230;219;116mL26\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-l26-2026-11-20)). A change that makes the  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 63 +\u001b[38;2;248;248;242mstep dearer on purpose measures it again and moves the figure.                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 64 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 65 \u001b[22m `MANIFEST_BUILD_TUI=OFF` omits the terminal\u001b[55Gand\u001b[59GFTXUI;\u001b[66Gan\u001b[69GSDK\u001b[73Gwithout\u001b[81Gpresentation\u001b[94Galso\u001b[99Gomits\u001b[105Gthe\r\u001b[1B     \u001b[2m 66 \u001b[22m development\u001b[23Gconsole,\u001b[32Gwhich\u001b[38Gis\u001b[41Gbuilt\u001b[47Gon\u001b[50Gthe\u001b[54Gengine's.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs written. Running Manifest's gate at full width, with \u001b[38;2;177;185;249m--werror --asan\u001b[39m:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[5C\u001b[1B--werror --asan --log build/gate-l26.log \u001b[76Gho \"exit=$?\" >> build/gate-l26.out; tail -30 \u001b[39m\u001b[27;1H\u001b[24;12H\u001b[?25h"]
