[0.025, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mW09\u001b[7G\u001b[22mhas\u001b[11Gto\u001b[14Gprove,\u001b[21Gthrough\u001b[29Gthe\u001b[33Gpublic\u001b[40Gcommands\u001b[49Gonly,\u001b[55Gthe\u001b[59Gfull\u001b[64Gloop:\u001b[70Gbuy\u001b[74G→\u001b[76Gload\u001b[81G→\u001b[83Gtravel\u001b[90G→\u001b[92Gdock\u001b[97G→\u001b[99Gunload\u001b[106G→\u001b[108Gsell\u001b[113G→\r\u001b[1B  upgrade. It also covers loading from a directory and from a pack, and replay across builds. W04 through W08 are all\u001b[K\r\u001b[1B  done, so nothing blocks it.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mL26\u001b[22m is \u001b[11Ghe console's long step: \u001b[38;2;177;185;249mstep 5d\u001b[39m blocks\u001b[50Gthe\u001b[54Gconsole\u001b[62Gfor\u001b[66Gabout\u001b[72G9.5\u001b[76Gminutes\u001b[84Gin\u001b[87Ga\u001b[89Grelease\u001b[97Gbuild,\u001b[104Gwith\u001b[109Gno\u001b[112Gprogress\r\u001b[1B  shown and no way to stop it. Manifest's queue says\u001b[54Git must\u001b[62Gbe fix\u001b[69Gd at the\u001b[78Glat\u001b[82Gst w\u001b[87Gen W09's fixture\u001b[104Gis played\u001b[114Gthrough\r\u001b[2C\u001b[1Bthe console. If the fixture runs a\u001b[39Ga test instead,\u001b[55GL26 can wait.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEngine side:\u001b[22m I\u001b[18Gdon't\u001b[24Gexpect\u001b[31Ga\u001b[33Ggap.\u001b[38GThe\u001b[42Gloop's\u001b[49Gparts\u001b[55Gwere\u001b[60Geach\u001b[65Gprovided\u001b[74Gfor\u001b[78GW03\u001b[82Gto\u001b[85GW08.\u001b[90GReplay\u001b[97Gacross\u001b[104Gbuilds\u001b[111Grests\u001b[117Gon\r\u001b[1B  the engine's existing determinism and save format. If W09 finds one, it gets provided here and the SDK pin moves.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mModel:\u001b[10G\u001b[22mOpus\u001b[15G5.5\u001b[19Gat\u001b[22Ghigh\u001b[27Geffort\u001b[34Gfor\u001b[38GW09.\u001b[43GIt's\u001b[48Gthe\u001b[52Gstage's\u001b[60Gacceptance\u001b[71Gfixture,\u001b[80Gand\u001b[84Ggetting\u001b[92Greplay\u001b[99Gor\u001b[102Gpack\u001b[107Gloading\u001b[115Gsubtly\r\u001b[1B \u001b[3Gwrong would be cos\u001b[22Gly later.\u001b[32GIf\u001b[35Gyou\u001b[39Gtake\u001b[44GL26\u001b[48Gfirst,\u001b[55GSonnet\u001b[62Gis\u001b[65Genough\u001b[72Gfor\u001b[76Gthe\u001b[80Gconsole\u001b[88Gpart,\u001b[94Gbut\u001b[98Gprofiling\u001b[108Gwhere\u001b[114Ga\r\u001b[1B  step's time goes is better done on Opus.\r\u001b[2B \u001b[3GShould I\u001b[12Gstart W09 in \u001b[38;2;177;185;249m../manifest\u001b[39m, \u001b[40G L26\u001b[45Gfirst?\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't open\u001b[17GW09's\u001b[23Gsection\u001b[31Gof\u001b[34Gthe\u001b[38GStage\u001b[44G4\u001b[46Gplan,\u001b[52Gso\u001b[55Gits\u001b[59Gexact\u001b[65Gacceptance\u001b[76Gtests\u001b[82Gare\u001b[86Gstill\u001b[92Gunread.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.041, "o", "\u001b]0;✳ jettison-0006\u0007"]
