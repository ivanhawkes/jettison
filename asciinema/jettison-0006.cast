C\u001b[65Gjob\u001b[69G' work\u001b[76Gt\u001b[78G ev\u001b[82Gry step. Tested by a\u001b[103Gworld\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[13G\u001b[38;2;248;248;242mfa\u001b[16Gt-forwarde\u001b[28Gand\u001b[32Gone stepped reac\u001b[53Gthe\u001b[57Gsame state hash, the\u001b[78Gpinned hashes holding.   \u001b[104G \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 90 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 91 \u001b[22m ### Next: what the game's next slices stand on\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 92 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[5C\u001b[1B--werror --asan --log build/gate-l26.log > build/gate-l26.out 2>&1; echo \"exit=$?\" >> build/gate-l26.out; tail -30 \r\u001b[5C\u001b[1Bbuild/gate-l26.out (31s)\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[3GKneading…\u001b[60G\u001b[38;2;153;153;153m3\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
