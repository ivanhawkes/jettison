[1.903, "o", "\u001b[?25l\u001b[H\u001b[3Gtrading\u001b[11Gfixture,\u001b[20Ghasn't\u001b[27Gbeen\u001b[32Gstarted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mW09\u001b[22m has to prove, through the public\u001b[40Gcommands only, the full loop: buy → \u001b[77Goad → travel → dock →\u001b[99Gunl\u001b[103Gad → sell →\u001b[115G\u001b[K\r\u001b[2C\u001b[1Bupgrade.\u001b[12GIt also\u001b[20Gcover\u001b[27Gloading\u001b[35Gfrom\u001b[40Ga\u001b[42Gdirectory\u001b[52Gand\u001b[56Gfrom\u001b[61Ga\u001b[63Gpack,\u001b[69Gand\u001b[73Greplay\u001b[80Gacross\u001b[87Gbuilds.\u001b[95GW04\u001b[99Gthrough\u001b[107GW08\u001b[111Gare\u001b[115Gall\r\u001b[2C\u001b[1Bdone,\u001b[9Gso\u001b[12Gnothing\u001b[20Gblocks\u001b[27Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mL26\u001b[22m is the console's l\u001b[26Gng step: \u001b[38;2;177;185;249mstep 5d\u001b[43G\u001b[39mblocks the\u001b[54Gconsole\u001b[62Gfor about 9.5 minu\u001b[83G in a relea\u001b[95Ge build,\u001b[104Gwith no prog\u001b[117Gess\u001b[K\r\u001b[2C\u001b[1Bs\u001b[5Gown and no\u001b[16Gway to\u001b[23Gstop it. Manifest's queue says it must be fixed\u001b[71Gat\u001b[74Gthe\u001b[78Glatest\u001b[85Gwhen\u001b[90GW09's\u001b[96Gfixture\u001b[104Gis\u001b[107Gplayed\u001b[114Gthrough\r\u001b[2C\u001b[1Bthe\u001b[7Gconsole.\u001b[16GIf\u001b[19Gthe\u001b[23Gfixture\u001b[31Gruns\u001b[36Gas\u001b[39Ga\u001b[41Gtest\u001b[46Ginstead,\u001b[55GL26\u001b[59Gcan\u001b[63Gwait.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEngine side:\u001b[16G\u001b[22mI don't expect a gap. The loop's p\u001b[51Grts were each pr\u001b[68Gvided for W03 to W08. Repl\u001b[95Gy across builds rests\u001b[117Gon\r\u001b[2C\u001b[1Bthe\u001b[7Gengine's\u001b[16Gexisting\u001b[25Gdeterminism\u001b[37Gand\u001b[41Gsave\u001b[46Gformat.\u001b[54GIf\u001b[57GW09\u001b[61Gfinds\u001b[67Gone,\u001b[72Git\u001b[75Ggets\u001b[80Gprovided\u001b[89Ghere\u001b[94Gand\u001b[98Gthe\u001b[102GSDK\u001b[106Gpin\u001b[110Gmoves.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mModel:\u001b[22m Opus\u001b[15G5.5 at high effort for W09. It's\u001b[48Gthe stage's acceptance fixture,\u001b[80Gand getting replay or pack loading subtly\r\u001b[2C\u001b[1Bwrong would\u001b[15Gbe costly later. If\u001b[35Gyou take\u001b[44GL26\u001b[48Gfirst,\u001b[55GSonnet\u001b[62Gis\u001b[65Genough\u001b[72Gfor\u001b[76Gthe\u001b[80Gconsole\u001b[88Gpart,\u001b[94Gbut\u001b[98Gprofiling\u001b[108Gwhere\u001b[114Ga\r\u001b[2C\u001b[1Bstep's\u001b[10Gtime\u001b[15Ggoes\u001b[20Gis\u001b[23Gbetter\u001b[30Gdone\u001b[35Gon\u001b[38GOpus.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gstart\u001b[18GW09\u001b[22Gin\u001b[25G\u001b[38;2;177;185;249m../manifest\u001b[39m,\u001b[38Gor\u001b[41GL26\u001b[45Gfirst?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Gopen\u001b[17GW09's\u001b[23Gsection\u001b[31Gof\u001b[34Gthe\u001b[38GStage\u001b[44G4\u001b[46Gplan,\u001b[52Gso\u001b[55Gits\u001b[59Gexact\u001b[65Gacceptance\u001b[76Gtests\u001b[82Gare\u001b[86Gstill\u001b[92Gunread.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
