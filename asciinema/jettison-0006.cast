[0.027, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m9\u001b[11G\u001b[22mworkflow. Run \u001b[27G without\u001b[36Ga terminal u\u001b[49Ging `ctest --prese\u001b[68G cl\u001b[73Gg-debug -R '^cons\u001b[91Gle$'`.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 60 +\u001b[38;2;248;248;242m`step-budget` runs one of its cases alone (`RUN_SERIAL`): a cruising hosted step, timed in an          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 61 +\u001b[38;2;248;248;242moptimised build without sanitisers and not on CI, fails above half as much again as the figure         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242mmeasured on Lythir\u001b[30G([\u001b[38;2;230;219;116mL26\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-l26-2026-11-20)). A change that makes the  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242mstep dearer on purpose me\u001b[37Gsure\u001b[42G it\u001b[47Ggai\u001b[51G and moves the figur\u001b[72G.    \u001b[78G  \u001b[81G    \u001b[86G     \u001b[92G  \u001b[95G   \u001b[99G      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 64 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 65 \u001b[22m `MANIFEST_BUILD_TUI=OFF` omits the terminal and FTXUI; an SDK without presentation also omits the\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22mdevelopment\u001b[23Gconsole,\u001b[32Gwhich\u001b[38Gis\u001b[41Gbuilt\u001b[47Gon\u001b[50Gthe\u001b[54Gengine's.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs written. Running Manifest's\u001b[36Ggate\u001b[41Gat\u001b[44Gfull\u001b[49Gwidth,\u001b[56Gwith\u001b[61G\u001b[38;2;177;185;249m--werror --asan\u001b[39m:\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cd '\u001b[16G./ma\u001b[22Gfest' && CMAKE_BUILD_PARALLEL_LEVEL=24…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m--werror --asan --log build/gate-l26.log > build/gate-l26.out 2>&1; echo \"exit=$?\" >> build/gate-l26.out; tail -30 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mbuild/gate-l26.out\u001b[25G(7s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ Queue it.\u001b[39m                                                                                                             \r\u001b[58C\u001b[2B\u001b[49m\u001b[38;2;153;153;153m9\r\u001b[2C\u001b[3B\u001b[39m\u001b[2mPress up to edit queued messages\r\u001b[37C\u001b[3B\u001b[22m\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
