[0.312, "o", "\u001b[?25l\u001b[H     \u001b[2m 57 \u001b[22m The console suite checks command registration, quoted paths and names, completion and history,\u001b[K\r\u001b[1B \u001b[3G   \u001b[2m 58 \u001b[22m typed errors, numeric bounds, configuration\u001b[55Greloads\u001b[63Gand\u001b[67Gthe\u001b[71Gload/generate/tick/trade-planning\r\u001b[1B     \u001b[2m 59 \u001b[22m workflow.\u001b[21GRun\u001b[25Git\u001b[28Gwithout\u001b[36Ga\u001b[38Gterminal\u001b[47Gusing\u001b[53G`ctest\u001b[60G--preset\u001b[69Gclang-debug\u001b[81G-R\u001b[84G'^console$'`.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 60 +\u001b[38;2;248;248;242m`step-budget` runs one of its cases alone (`RUN_SERIAL`): a cruising hosted step, timed in an          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 61 +\u001b[38;2;248;248;242moptimised build without sanitisers and not on CI, fails above half as much again as the figure         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 62 +\u001b[38;2;248;248;242mmeasured on Lythir ([\u001b[38;2;230;219;116mL26\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-l26-2026-11-20)). A change that makes the  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242mstep dearer on purp\u001b[31Gs\u001b[34Gmeasures it agai\u001b[51G and moves the figure.      \u001b[80G      \u001b[87G     \u001b[93G     \u001b[99G  \u001b[102G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 64 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 65 \u001b[22m `MANIFEST_BUILD_TUI=OFF` omits the terminal and FTXUI; an SDK without presentation also omits the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[22m development console, which is built on the engine's.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs\u001b[8Gwritten.\u001b[17GRunning\u001b[25GManifest's\u001b[36Ggate\u001b[41Gat\u001b[44Gfull\u001b[49Gwidth,\u001b[56Gwith\u001b[61G\u001b[38;2;177;185;249m--werror --asan\u001b[39m:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'../manifest'\u001b[28G&&\u001b[31GCMAKE_BUILD_PARALLEL_LEVEL=24…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[5C\u001b[1B--werror --asan --log build/gate-l26.log > build/gate-l26.out 2>&1; echo \"exit=$?\" >> build/gate-l26.out; tail -30 \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mbuild/gate-l26.out (4s)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m*\u001b[3G\u001b[38;2;235;159;127mKneading…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Run M\u001b[21Gifest gate with werror and asan · 19m 1s · ↓\u001b[39m \u001b[38;2;153;153;153m54.3k tokens)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;12H\u001b[?25h"]
