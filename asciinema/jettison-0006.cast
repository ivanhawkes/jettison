[0.184, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat changed\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine (\u001b[38;2;177;185;249m9e0274f\u001b[39m):\u001b[23G\u001b[22mphysics\u001b[31Gnow\u001b[35Gplaces\u001b[42Geach\u001b[47Gbody\u001b[52Gwith\u001b[57Gthings\u001b[64Gon\u001b[67Grails\u001b[73Gonce\u001b[78Gper\u001b[82Gstep,\u001b[88Ginstead\u001b[96Gof\u001b[99Gre-evaluating\u001b[113Ga\r\u001b[2C\u001b[1B \u001b[5Gstation's orbit for every\u001b[31Gpad, de\u001b[39Gk and buggy on it. A cruising step drop\u001b[80Gd\u001b[82Gfrom 26 µs to\u001b[96G13\u001b[99Gµs, so Ore to\u001b[113GBrine\r\u001b[4C\u001b[1Btakes about 4 min 50 s of\u001b[31Ga release\u001b[41Gbuild instead of\u001b[58G9\u001b[60Gmin 35 s. The\u001b[74Gresult is bit-identical:\u001b[99Gevery pinned hash\u001b[K\r\u001b[4C\u001b[1Bheld,\u001b[12Gnd a\u001b[17Gnew physics test ch\u001b[37Gcks\u001b[41Gthe body is placed\u001b[60Gonce per step.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest (\u001b[38;2;177;185;249me74aa34\u001b[39m, pin moved to \u001b[38;2;177;185;249m9e0274f\u001b[39m):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- A short \u001b[38;2;177;185;249mstep\u001b[39m still prints its report at\u001b[47Gonce.\u001b[53GA\u001b[55Glong\u001b[60Gone\u001b[64Gruns\u001b[69Gin\u001b[72G50\u001b[75Gms\u001b[78Gslices,\u001b[86Gso\u001b[89Gthe\u001b[93Gconsole\u001b[101Gkeeps\u001b[107Gtaking\r\u001b[4C\u001b[1B \u001b[7Gcommands and\u001b[20Gthe TUI shows progress.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mstop\u001b[39m ends a run at the step it ha\u001b[41G reached,\u001b[51Gwith\u001b[56Gthe\u001b[60Gusual\u001b[66Greport.\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249me\u001b[12G\u001b[39mis now\u001b[20Gefused while connected to a server.\u001b[56G\u001b[K\r\u001b[6C\u001b[1BMoving the pin also\u001b[27Gcopi\u001b[32Gd the engine's newer \u001b[38;2;177;185;249mdevenv.nix\u001b[39m,\u001b[65Gwhich\u001b[71Gadds\u001b[76G\u001b[38;2