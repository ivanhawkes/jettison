[0.029, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bti\u001b[8Gac\u001b[11Goss\u001b[15Gthe\u001b[19Ggap\u001b[23Git skips.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat\u001b[8Gwould\u001b[14Gwork\u001b[19Gis\u001b[22Ga\u001b[24G\u001b[1mfast-forward over quiet steps\u001b[22m.\u001b[55GEach\u001b[60Gsystem\u001b[67Gsays\u001b[72Gwhen\u001b[77Git\u001b[80Gnext\u001b[85Gneeds\u001b[91Ga\u001b[93Gstep\u001b[98G(a\u001b[101Gbatch\u001b[107Gdue,\u001b[112Gan\u001b[115Gorder\r\u001b[2C\u001b[1Bexpiring, a journey ending, a contact possible). While nothing but motio\u001b[77Gby\u001b[80Gformula i\u001b[91Ghapp\u001b[96Gning\u001b[101G(orbits, rails, a\u001b[K\r\u001b[2C\u001b[1Bcru\u001b[7Gse placed by its time)\u001b[31Gthe world\u001b[41Gjumps straig\u001b[54Gt to the \u001b[64Gext such step. Most of a 4.49-day cruise \u001b[106Gs exact\u001b[114Gy that.\r\u001b[2C\u001b[1BThe catch is that phys\u001b[26Gcs, docks and buggies would each\u001b[59Ghave to prove\u001b[73Gth\u001b[76Gy're quiet, or be placed by formul\u001b[111G across\u001b[K\r\u001b[2C\u001b[1Bt\u001b[7Gg\u001b[9Gp. That is a real engine design with its own\u001b[54Gdeterminism tests,\u001b[73Gnot someth\u001b[84Gng t\u001b[89G slip into L26.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22G\u001b[22mfinish\u001b[29GL26\u001b[33Gas\u001b[36Git\u001b[39Gstands\u001b[46G(the\u001b[51G2×\u001b[54Gfix,\u001b[59Gthe\u001b[63Gsliced\u001b[70Gand\u001b[74Gstoppable\u001b[84Gstep,\u001b[90Gthe\u001b[94Gbudget\u001b[101Gtest).\u001b[108GThen\u001b[113Gqueue\r\u001b[2C\u001b[1Bthe fast-forward as a separate item: an engine item \u001b[56Gn Jetti\u001b[64Gon's roa\u001b[73Gmap with a\u001b[84Gre-entry task in\u001b[101GManifest's deliv\u001b[118Gry\r\u001b[2C\u001b[1Border, decided before\u001b[25GW10's \u001b[32Graders add\u001b[43Gmore per-step work. Should I queue \u001b[80G?\u001b[82G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gengine\u001b[14Ggate\u001b[19Gis\u001b[22Gstill\u001b[28Grunning.\u001b[37GOnce\u001b[42Git\u001b[45Gpasses,\u001b[53GI'll\u001b[58Gcommit\u001b[65Gthe\u001b[69Gengine\u001b[76Gfix,\u001b[81Gmove\u001b[86GManifest's\u001b[97Gpin,\u001b[102Gmeasure\u001b[110Gthe\r\u001b[2C\u001b[1Bbudg\u001b[8Gt's fi\u001b[15Gur\u001b[19Gon\u001b[22Gan idle machine, and run Manifest's\u001b[58Ggate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gengine\u001b[14Ggate\u001b[19Gpassed\u001b[26G(347\u001b[31Gs),\u001b[35Gand\u001b[39Gno\u001b[42Gpinned\u001b[49Gworld\u001b[55Ghash\u001b[60Gmoved,\u001b[67Gwhich\u001b[73Gconfirms\u001b[82Gthe\u001b[86Gchange\u001b[93Gis\u001b[96Gbit-identical.\u001b[111GNow\u001b[115Gthe\r\u001b[1B \u001b[3Gengine's docs, following how earlier provisions were recorded:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(./scripts/ci.sh\u001b[24G--werror\u001b[33G--asan\u001b[40G--log\u001b[46Gbuild/gate.log)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39m==> ma\u001b[13Gkdown links (lychee\u001b[33G0.24.2, offlin\u001b[27;1H\u001b[24;12H\u001b[?25h"]
