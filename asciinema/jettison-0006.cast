[0.066, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 62 +\u001b[38;2;248;248;242mmeasured on Lythir ([\u001b[38;2;230;219;116mL26\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-l26-2026-11-20)). A change that makes the  \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 63 +\u001b[38;2;248;248;242mstep dearer on purpose measures it again and moves the figure.                                         \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 64 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m65\u001b[11G\u001b[22m`MANIFEST_BUILD_TUI=OFF`\u001b[36Gomits the terminal and FTXUI; \u001b[67Gn SDK without presentation also omits the\r\u001b[6C\u001b[1B\u001b[2m66\u001b[11G\u001b[22mdev\u001b[15Glopment co\u001b[26Gsole, which is\u001b[41Gbuilt on \u001b[51Ghe engine'\u001b[62G.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs written. Running Manifest's gate at full width, with \u001b[38;2;177;185;249m--werror --asan\u001b[39m:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mQueue it.\u001b[39m                                                                                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mQueuing\u001b[11Git in both repo\u001b[27Gitories. The Jettison entry goes in now.\u001b[68GThe\u001b[72GManifest\u001b[81Grow\u001b[85Gwaits\u001b[91Guntil\u001b[97Gits\u001b[101Ggate\u001b[106Gfinishes,\u001b[116Gso\r\u001b[2C\u001b[1Bthe\u001b[7Gtree\u001b[12Gdoesn't\u001b[20Gchange\u001b[27Gunder\u001b[33Gthe\u001b[37Ggate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'../manifest'\u001b[28G&&\u0