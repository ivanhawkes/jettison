[0.017, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m0\u001b[11G\u001b[38;2;248;248;242m`step-budget` runs\u001b[30Gone of its cases alone (`RUN_SERIAL`): a cruising hosted step, timed in an          \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[11G\u001b[38;2;248;248;242moptimised build without s\u001b[37Gniti\u001b[42Gers\u001b[47Gnd \u001b[51Got on CI, fails abov\u001b[72G half\u001b[78Gas\u001b[81Gmuch\u001b[86Gagain\u001b[92Gas\u001b[95Gthe\u001b[99Gfigure\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 62 +\u001b[38;2;248;248;242mmeasured on Lythir ([\u001b[38;2;230;219;116mL26\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-l26-2026-11-20)). A change that makes the  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 63 +\u001b[38;2;248;248;242mstep dearer on purpose measures it again and moves the figure.                                         \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m4\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 65 \u001b[11G\u001b[22m`MANIFEST_BUILD_TUI=OFF`\u001b[36Gomits\u001b[42Gthe\u001b[46Gterminal\u001b[55Gand\u001b[59GFTXUI;\u001b[66Gan\u001b[69GSDK\u001b[73Gwithout\u001b[81Gpresentation\u001b[94Galso\u001b[99Gomits\u001b[105Gthe\r\u001b[2C\u001b[1B   \u001b[2m 66 \u001b[22m development console,\u001b[32Gwhich\u001b[38Gis\u001b[41Gbuilt\u001b[47Gon\u001b[50Gthe\u001b[54Gengine's.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m Docs written. Running Manifest's gate at full width, with \u001b[38;2;177;185;249m--werror --asan\u001b[39m:\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mQueue it.\u001b[39m                                                                                                             \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mQueuing\u001b[11Git\u001b[14Gin\u001b[17Gboth\u001b[22Grepositories.\u001b[36GThe\u001b[40GJettison\u001b[49Gentry\u001b[55Ggoes\u001b[60Gin\u001b[63Gnow.\u001b[68GThe\u001b[72GManifest\u001b[81Grow\u001b[85Gwaits\u001b[91Guntil\u001b[97Gits\u001b[101Ggate\u001b[106Gfinishes,\u001b[116Gso\r\u001b[1B \u001b[3Gthe tree \u001b[13Goesn't change under the gate.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mEditing docs/roadmap.md\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(docs/roadmap.md) (29s)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
