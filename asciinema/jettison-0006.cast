[0.457, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gtrading fixture, hasn't been started.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mW09\u001b[7G\u001b[22mhas\u001b[11Gto\u001b[14Gprove,\u001b[21Gthrough\u001b[29Gthe\u001b[33Gpublic\u001b[40Gcommands\u001b[49Gonly,\u001b[55Gthe\u001b[59Gfull\u001b[64Gloop:\u001b[70Gbuy\u001b[74G→\u001b[76Gload\u001b[81G→\u001b[83Gtravel\u001b[90G→\u001b[92Gdock\u001b[97G→\u001b[99Gunload\u001b[106G→\u001b[108Gsell\u001b[113G→\r\u001b[2C\u001b[1Bupgrade. It also covers loading from\u001b[40Ga directory and from a pack, and rep\u001b[77Gay across builds. W04\u001b[99Gthr\u001b[103Gugh W08 are\u001b[115Gall\r\u001b[2C\u001b[1Bdone, so\u001b[12Gnothing\u001b[20Gblock\u001b[27Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mL26\u001b[7G\u001b[22mis\u001b[10Gthe\u001b[14Gconsole's\u001b[24Glong\u001b[29Gstep:\u001b[35G\u001b[38;2;177;185;249mstep 5d\u001b[43G\u001b[39mblocks\u001b[50Gthe\u001b[54Gconsole\u001b[62Gfor\u001b[66Gabout\u001b[72G9.5\u001b[76Gminutes\u001b[84Gin\u001b[87Ga\u001b[89Grelease\u001b[97Gbuild,\u001b[104Gwith\u001b[109Gno\u001b[112Gprogress\r\u001b[2C\u001b[1Bshown and no way to st\u001b[26Gp it. Manifest's\u001b[43Gqueue says\u001b[54Git must\u001b[62Gbe fixed at the la\u001b[83Gt when W09'\u001b[95G fixture\u001b[104Gis played th\u001b[117Gough\r\u001b[2C\u001b[1Bt\u001b[5Ge console.\u001b[16GIf the\u001b[23Gfixture runs as a test instead, L26 can wait.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEngine side:\u001b[16G\u001b[22mI\u001b[18Gdon't\u001b[24Gexpect\u001b[31Ga\u001b[33Ggap.\u001b[38GThe\u001b[42Gloop's\u001b[49Gparts\u001b[55Gwere\u001b[60Geach\u001b[65Gprovided\u001b[74Gfor\u001b[78GW03\u001b[82Gto\u001b[85GW08.\u001b[90GReplay\u001b[97Gacross\u001b[104Gbuilds\u001b[111Grests\u001b[117Gon\r\u001b[2C\u001b[1Bthe engine's\u001b[16Gexisting determinism and save form\u001b[51Gt. If W09 finds \u001b[68Gne, it gets provided here \u001b[95Gnd the SDK pin moves.\u001b[117G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mModel:\u001b[10G\u001b[22mOpus\u001b[15G5.5\u001b[19Gat\u001b[22Ghigh\u001b[27Geffort\u001b[34Gfor\u001b[38GW09.\u001b[43GIt's\u001b[48Gthe\u001b[52Gstage's\u001b[60Gacceptance\u001b[71Gfixture,\u001b[80Gand\u001b[84Ggetting\u001b[92Greplay\u001b[99Gor\u001b[102Gpack\u001b[107Gloading\u001b[115Gsubtly\r\u001b[2C\u001b[1Bwrong would\u001b[15Gbe costly later. If you take L26\u001b[48Gfirst, Sonnet is enough for the\u001b[80Gconsole part, but profiling where a\u001b[K\r\u001b[2C\u001b[1Bstep's time\u001b[15Ggoes is better done\u001b[35Gon Opus.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gstart\u001b[18GW09\u001b[22Gin\u001b[25G\u001b[38;2;177;185;249m../manifest\u001b[39m,\u001b[38Gor\u001b[41GL26\u001b[45Gfirst?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Gopen\u001b[17GW09's\u001b[23Gsection\u001b[31Gof\u001b[34Gthe\u001b[38GStage\u001b[44G4\u001b[46Gp\u001b[76Gtests\u001b[82Gare\u001b[86Gstill\u001b[92Gunread.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
