[0.052, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GThe job\u001b[13Gleav\u001b[18Gs out tenders\u001b[32Glarger\u001b[39Gthan\u001b[44Gits\u001b[48Gfree\u001b[53Ghold,\u001b[59Gand\u001b[63Git\u001b[66Gestimates\u001b[76Gthe\u001b[80Gbond\u001b[85Gfrom\u001b[90Gthe\u001b[94Gconfigured\u001b[105Grate\u001b[110Grather\u001b[117Gthan\r\u001b[2C\u001b[1B \u001b[5Gprocurement's own calculation.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA cargo seizure while a contract\u001b[38Gis\u001b[41Gunder\u001b[47Gway\u001b[51Gdrops\u001b[57Gthe\u001b[61Gcontract,\u001b[71Gwhich\u001b[77Gthen\u001b[82Gdefaults.\r\u001b[4C\u001b[1BIn \u001b[9Gn earl\u001b[16Ger probe, the NPC defaulted on\u001b[47Ga tin contract while anot\u001b[73Ger trader was buying\u001b[94Gtin\u001b[98Gat\u001b[101Gthe\u001b[105Gsame\u001b[110Gsource.\r\u001b[2C\u001b[1B \u001b[5GThat kind of competition\u001b[30Gcoul\u001b[35G disrupt\u001b[44Gslice 6's governance fixture.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSlice\u001b[9G6\u001b[11Gis\u001b[14Gnext:\u001b[20Gthe\u001b[24Ggovernance\u001b[35Gfixture,\u001b[44GW12's\u001b[50Gclose-out,\u001b[61Gthe\u001b[65Ggate\u001b[70Gand\u001b[74Gthe\u001b[78Gstage\u001b[84Gcross-review.\u001b[98GIt\u001b[101Gneeds\u001b[107Gthis\u001b[112Gsession's\r\u001b[2C\u001b[1Bcont\u001b[8Gxt, \u001b[13Go continu\u001b[24Gher\u001b[28G; \u001b[38;2;177;185;249m/compact\u001b[39m first would al\u001b[54Go work.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 19m 35s · done 6:39 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯\u001b[39m \u001b[38;2;255;255;255m/compact\u001b[39m                                                                                                              \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  \u001b[39m\u001b[2mCompacted (ctrl+o to see full summary)\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m../manifest/build/commit