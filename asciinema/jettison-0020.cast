[25Gclang-tidy\u001b[36Gon\u001b[39Gthe\u001b[43Gfour\u001b[48Gchanged\u001b[56Gunits,\u001b[63Gplus\u001b[68GManifest's\u001b[79Gformat\u001b[86Gcheck.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m10\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTidy\u001b[8Gand\u001b[12Gthe\u001b[16Gformat\u001b[23Gcheck\u001b[29Gare\u001b[33Gclean.\u001b[40GLast\u001b[45Glook\u001b[50Gat\u001b[53Gthe\u001b[57Gdiff\u001b[62Gbefore\u001b[69Gcommitting.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Two comment wordings to tidy (a ragged line and an ambiguous phrase), then commit.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
