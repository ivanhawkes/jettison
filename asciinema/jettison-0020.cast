[6.257, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[23B3\r\u001b[38C\u001b[3B\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
[0.406, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gtake up\u001b[13Gto s\u001b[18Gven days.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe job leaves out tenders larger\u001b[39Gthan\u001b[44Gits\u001b[48Gfree\u001b[53Ghold,\u001b[59Gand\u001b[63Git\u001b[66Gestimates\u001b[76Gthe\u001b[80Gbond\u001b[85Gfrom\u001b[90Gthe\u001b[94Gconfigured\u001b[105Grate\u001b[110Grather\u001b[117Gthan\r\u001b[2C\u001b[1B \u001b[5Gprocurement's own calculation.\u001b[K\r\u001b[4C\u001b[1BA c\u001b[9Grgo se\u001b[16Gzure while a contract is under\u001b[47Gway drops the contract, w\u001b[73Gich then defaults.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIn an earlier probe, the\u001b[30GNPC \u001b[35Gefaulted\u001b[44Gon a tin contract while another\u001b[76Gtrader\u001b[83Gwas\u001b[87Gbuying\u001b[94Gtin\u001b[98Gat\u001b[101Gthe\u001b[105Gsame\u001b[110Gsource.\r\u001b[4C\u001b[1BThat\u001b[10Gkind\u001b[15Gof\u001b[18Gcompetition\u001b[30Gcould\u001b[36Gdisrupt\u001b[44Gslice\u001b[50G6's\u001b[54Ggovernance\u001b[65Gfixture.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSlic\u001b[8G 6 i\u001b[13G next: th\u001b[24Ggov\u001b[28Grnance fixture, W12's clo\u001b[54Ge-out, the\u001b[65Ggate\u001b[70Gand\u001b[74Gthe\u001b[78Gstage\u001b[84Gcross-review.\u001b[98GIt\u001b[101Gneeds\u001b[107Gthis\u001b[112Gsession's\r\u001b[2C\u001b[1Bcontext,\u001b[12Gso\u001b[15Gcontinue\u001b[24Ghere;\u001b[30G\u001b[38;2;177;185;249m/compact\u001b[39G\u001b[39mfirst\u001b[45Gwould\u001b[51Galso\u001b[56Gwork.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 19m 35s · done 6:39 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯\u001b[39m \u001b[38;2;255;255;255m/compact\u001b[39m                                                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[2mCompacted (ctrl+o to see full summary)\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;153;153;153mad \u001b[1m../manifest/b