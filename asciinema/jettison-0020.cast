[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GThe full Manifest d\u001b[25Gbug suite\u001b[35G(55 tests) passed afte\u001b[58G the cod\u001b[67G changes.\u001b[77GAfter\u001b[83Gthat I added\u001b[96Gthe new tests and changed\r\u001b[4C\u001b[1Bcommen\u001b[12Gs, and re-ran \u001b[27Gnly the procur\u001b[42Gment\u001b[47Gsuite, which passes (28 cases, 7\u001b[80Gof\u001b[83Gthem\u001b[88Gnew).\u001b[94Gclang-tidy\u001b[105Gis\u001b[108Gclean\u001b[114Gon\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gfour changed files,\u001b[25Gand the format\u001b[40Gcheck\u001b[46Gpasse\u001b[52G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI broke the \"next step this system must run\" calcul\u001b[58Gi\u001b[61G on\u001b[65Gpurpos\u001b[72G to se\u001b[79G whether the new fa\u001b[99Gt-forward t\u001b[111Gst\u001b[K\r\u001b[4C\u001b[1Bnotices. At fi\u001b[20Gst it\u001b[26Gdidn't: \u001b[36G AI-run\u001b[44Gregi\u001b[49Gns the delive\u001b[63Gy close la\u001b[75Gs on a day bounda\u001b[93Gy, where\u001b[102Gthe system runs\r\u001b[4C\u001b[1Banyw\u001b[10Gy. I m\u001b[17Gved that test to a pla\u001b[40Ger-run tender whose closes fall off those boundaries, and now it catches\u001b[113Gth\u001b[116G\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gbreak.\u001b[12G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI di\u001b[10Gn't run the full gate: the plan calls for it after slices\u001b[68G3\u001b[70Gand\u001b[74G6\u001b[76Gonly.\r\u001b[2C\u001b[1B-\u001b[5GNo\u001b[8Gpinned\u001b[15Ghash\u001b[20Gmoved.\u001b[27GThe\u001b[31Gpinned\u001b[38Gworlds\u001b[45Gdo\u001b[48Ghold\u001b[53Gtenders,\u001b[62Gbut\u001b[66Gnone\u001b[71Ghas\u001b[75Ga\u001b[77Gdelivered\u001b[87Gtote,\u001b[93Gso\u001b[96Gthe\u001b[100Gnew\u001b[104Gcounter,\u001b[113Gleft\u001b[118Gat\r\u001b[2C\u001b[1B  zero,\u001b[11Gdoesn't\u001b[19Gseem\u001b[24Gto\u001b[27Gchange\u001b[34Gthe\u001b[38Gsave's\u001b[45Gbytes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWorth knowing\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe procur\u001b[16Gment suite now takes \u001b[38Gbout 20\u001b[46Gs instead\u001b[56Gof\u001b[59G8\u001b[61Gs,\u001b[64Gbecause\u001b[72Gthree\u001b[78Gof\u001b[81Gthe\u001b[85Gnew\u001b[89Gtests\u001b[95Gsimulate\u001b[104Gwhole\u001b[110Gdelivery\r\u001b[2C\u001b[1B \u001b[5Gwind\u001b[10Gws\u001b[13Gof 1 to 14 days.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA delivery take\u001b[21G cargo out of the hold\u001b[44Gwith\u001b[49Gut\u001b[52Gc\u001b[55Gcking whether a\u001b[71Gru\u001b[74Gning tra\u001b[83Ge job pl\u001b[92Gnned to sell it.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mCompany::Unload\u001b[21G\u001b[39mdoesn't check this \u001b[41Gither. Slice\u001b[54G5, where \u001b[64Gaved jobs take on\u001b[82Gc\u001b[84Gntr\u001b[88Gcts, is where\u001b[102Gthis matters.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSlice 5, \u001b[13Ghe saved\u001b[22Gjobs' contracts, is\u001b[42Gnext and builds directly on\u001b[70Gthis,\u001b[76Gso I'd\u001b[83Gcontinue\u001b[92Gin\u001b[95Gthis\u001b[100Gsession\u001b[108Grather\u001b[115Gthan\r\u001b[2C\u001b[1Bcompact.\u001b[K\r\u001b[4C\u001b[1B     \u001b[11G       \u001b[19G    \u001b[24G  \u001b[27G      \u001b[34G   \u001b[38G      \u001b[45G  \u001b[27;1H\u001b[24;3H\u001b[?25h"]
