[0.617, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCommitted \u001b[1m018e4cb\u001b[22m, ran \u001b[1m1\u001b[22m shell command \u001b[43G\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mW12 slice 5, sav\u001b[20Gd job\u001b[27Gbidding on tende\u001b[44Gs, is done and committed in Manifest as\u001b[84G\u001b[38;2;177;185;249m018e4cb\u001b[39m.\u001b[93GIt's not pushed, and it\u001b[K\r\u001b[2C\u001b[1Bneeded no\u001b[13Gengine change.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTurning it on:\u001b[22m a ship's policy has a\u001b[42Gnew\u001b[46G\u001b[38;2;177;185;249mcontracts\u001b[56G\u001b[39mswitch,\u001b[64Gset\u001b[68Gwith\u001b[73G\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m.\u001b[94GNPC\u001b[98Gtraders\u001b[106Gget\u001b[110Git\u001b[113Gon.\r\u001b[4C\u001b[1B\u001b[1mBidding:\u001b[22m a job with the switch on and n\u001b[45G con\u001b[50Gract \u001b[56Girst looks at the open tend\u001b[85Gs.\u001b[88GIt skips\u001b[97Gtenders whose\u001b[111Ggoods its\r\u001b[4C\u001b[1Bhol\u001b[9G can't tak\u001b[20G and\u001b[25Gones\u001b[30Gits\u001b[34Gcompany\u001b[42Galready\u001b[50Gbid\u001b[54Gon.\u001b[58GIt\u001b[61Gprices\u001b[68Gthe\u001b[72Ggoods\u001b[78Gat\u001b[81Gthe\u001b[85Gcheapest\u001b[94Gsource\u001b[101Gin\u001b[104Gits\u001b[108Gowner's\r\u001b[2C\u001b[1B \u001b[5Gmarket\u001b[12Grep\u001b[16Grts and adds\u001b[29Gthe trip's charges and\u001b[52Ga profit. It\u001b[65Gbids\u001b[70Gonly\u001b[75Gwithin\u001b[82Gthe\u001b[86Gtender's\u001b[95Gbudget\u001b[102Gand\u001b[106Gonly\u001b[111Gif\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gcompany can pay for the\u001b[29Gg\u001b[31Gods a\u001b[37Gd th\u001b[42G bond. Among th\u001b[58G tenders\u001b[67Git \u001b[71Gan bid on,\u001b[82Git picks th\u001b[94G \u001b[96Gn\u001b[99Gwith the most budget\r\u001b[4C\u001b[1Bleft\u001b[10Gover.\r\u001b[2C\u001b[1B- \u001b[1mThe profit:\u001b[17G\u001b[22mthe\u001b[21Gjob's\u001b[27Gtarget\u001b[34Gprofit,\u001b[42Gor\u001b[45Gone\u001b[49Gcredit\u001b[56Gmore\u001b[61Gthan\u001b[66Gthe\u001b[70Gbest\u001b[75Gordinary\u001b[84Gtrade\u001b[90Git\u001b[93Gcould\u001b[99Gmake,\u001b[105Gwhichever\u001b[115Gis\r\u001b[2C\u001b[1B \u001b[5Ghigher. This was my re\u001b[28Gd\u001b[30Gng\u001b[33Gof the plan's\u001b[47G\"above the best trade's\u001b[71Gestimate\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAfter the bid:\u001b[20G\u001b[22mthe job\u001b[28Gwait\u001b[34Gin a new \u001b[38;2;177;185;249mBidding\u001b[51G\u001b[39mpha\u001b[55Ge\u001b[57Guntil the bid clos\u001b[76G. If it wins, it buy\u001b[99Ghat's still owed\u001b[116Gat\r\u001b[4C\u001b[1Bthe source, carri\u001b[23Gs it\u001b[28Gto th\u001b[34G tender's v\u001b[46Gnue and delivers\u001b[63Git, making more t\u001b[81Gips while the d\u001b[97Glivery window\u001b[111Gallows. If\r\u001b[2C\u001b[1B \u001b[5Git loses, it \u001b[19Goes back to choosing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhen a contract ends early:\u001b[33G\u001b[22ma\u001b[35Gdefault,\u001b[44Gor\u001b[47Gtotes\u001b[53Gleft\u001b[58Gover\u001b[63Gafter\u001b[69Gthe\u001b[73Glast\u001b[78Gdelivery,\u001b[88Gturn\u001b[93Gthe\u001b[97Gcargo\u001b[103Ginto\u001b[108Gan\u001b[111Gordinary\r\u001b[2C\u001b[1B  trade lot to sell.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSaves:\u001b[22m a\u001b[14Gload refuses a\u001b[29Gbidding job\u001b[42Gh\u001b[44Gt \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[2.982, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mW12\u001b[7Gslice\u001b[13G5,\u001b[16Gsaved\u001b[22Gjobs\u001b[27Gbidding\u001b[35Gon\u001b[38Gtenders,\u001b[47Gis\u001b[50Gdone\u001b[55Gand\u001b[59Gcommitted\u001b[69Gin\u001b[72GManifest\u001b[81Gas\u001b[84G\u001b[38;2;177;185;249m018e4cb\u001b[39m.\u001b[93GIt's\u001b[98Gnot\u001b[102Gpushed,\u001b[110Gand\u001b[114Git\r\u001b[1B \u001b[3Gneeded no\u001b[13Gengine change.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTurning it on:\u001b[20G\u001b[22ma\u001b[22Gship's\u001b[29Gpolicy\u001b[36Ghas\u001b[40Ga\u001b[42Gnew\u001b[46G\u001b[38;2;177;185;249mcontracts\u001b[56G\u001b[39mswitch,\u001b[64Gset\u001b[68Gwith\u001b[73G\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m.\u001b[94GNPC\u001b[98Gtraders\u001b[106Gget\u001b[110Git\u001b[113Gon.\r\u001b[4C\u001b[1B\u001b[1mBidd\u001b[12G:\u001b[22m a job\u001b[20Gwit\u001b[24G the\u001b[29Gswit\u001b[34Gh\u001b[36Gon and no\u001b[46Gcontract firs\u001b[60G looks at \u001b[72Ge open tenders. It skips tenders whose go\u001b[114Gds\u001b[117Gits\r\u001b[2C\u001b[1B \u001b[5Ghold can't\u001b[16Gtake and\u001b[25Gon\u001b[28Gs its company already bid on. I\u001b[61Gprices \u001b[69Ghe go\u001b[75Gds a\u001b[80G th\u001b[84G cheape\u001b[92Gt source in its owner's\u001b[K\r\u001b[4C\u001b[1Bmarket reports and adds the trip's ch\u001b[43Grg\u001b[46Gs and a\u001b[54Gprofi\u001b[60G. It bids only within the t\u001b[88Gnd\u001b[91Gr's b\u001b[97Gdg\u001b[100Gt and only if the\r\u001b[4C\u001b[1Bcompany can pay for the\u001b[29Ggoods and the bond. Among the \u001b[60Genders it\u001b[70Gcan bid on,\u001b[82Git picks the\u001b[95Gone with the most budget\r\u001b[4C\u001b[1Bleft over.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe profit:\u001b[17G\u001b[22mthe\u001b[21Gjob's\u001b[27Gtarget\u001b[34Gprofit,\u001b[42Gor\u001b[45Gone\u001b[49Gcredit\u001b[56Gmore\u001b[61Gthan\u001b[66Gthe\u001b[70Gbest\u001b[75Gordinary\u001b[84Gtrade\u001b[90Git\u001b[93Gcould\u001b[99Gmake,\u001b[105Gwhichever\u001b[115Gis\r\u001b[2C\u001b[1B \u001b[5Ghigher. This was my reading of the plan's \"above \u001b[55Ghe b\u001b[60Gs\u001b[62G trade's \u001b[74Gimate\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAfter the bid:\u001b[22m the job waits in a new \u001b[38;2;177;185;249mBidding\u001b[39m phase until\u001b[64Ghe bid\u001b[71Gclose. If it\u001b[84Gwins,\u001b[90Git\u001b[93Gbuys\u001b[98Gwhat's\u001b[105Gstill\u001b[111Gowed\u001b[116Gat\r\u001b[2C\u001b[1B \u001b[5Gthe source, carri\u001b[23Gs it\u001b[28Gto \u001b[32Ghe tender's venue and d\u001b[56Glivers\u001b[63Git,\u001b[67Gmaking more tr\u001b[82Gps while \u001b[92Ghe delivery window\u001b[111Gallows.\u001b[119GIf\r\u001b[4C\u001b[1Bit loses, it goes back\u001b[31Gc\u001b[33Goosi\u001b[38Gg.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhen a contract ends early:\u001b[22m a default,\u001b[44Gor\u001b[47Gtotes\u001b[53Gleft\u001b[58Gover\u001b[63Gafter\u001b[69Gthe\u001b[73Glast\u001b[78Gdelivery,\u001b[88Gturn\u001b[93Gthe\u001b[97Gcargo\u001b[103Ginto\u001b[108Gan\u001b[111Gordinary\r\u001b[2C\u001b[1B \u001b[5Gtrade lot to sell.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSaves:\u001b[22m a load refuses\u001b[27Ga\u001b[29Gbidding\u001b[37Gjob\u001b[41Gthat\u001b[46Gnames\u001b[52Gno\u001b[55Gtender.\r\u001b[4C\u001b[1B\u001b[1mBuild order:\u001b[22m th\u001b[21G policy\u001b[29Gmo\u001b[32Gule now depends\u001b[76Gnt\u001b[79Gis\u001b[82Gnow\u001b[86Gadded\u001b[92Gbefore\u001b[99Git\u001b[102Gin\u001b[105Gthe\u001b[109Gbuild.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
