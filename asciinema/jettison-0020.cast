[0.062, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mTurning it on:\u001b[20G\u001b[22ma\u001b[22Gship's\u001b[29Gpolicy\u001b[36Ghas\u001b[40Ga\u001b[42Gnew\u001b[46G\u001b[38;2;177;185;249mcontracts\u001b[56G\u001b[39mswitch,\u001b[64Gset\u001b[68Gwith\u001b[73G\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m.\u001b[94GNPC\u001b[98Gtraders\u001b[106Gget\u001b[110Git\u001b[113Gon.\r\u001b[4C\u001b[1B\u001b[1mBidd\u001b[12G:\u001b[22m a job\u001b[20Gwit\u001b[24G the\u001b[29Gswit\u001b[34Gh\u001b[36Gon and no\u001b[46Gcontract firs\u001b[60G looks at \u001b[72Ge open tenders. It skips tenders whose go\u001b[114Gds\u001b[117Gits\r\u001b[2C\u001b[1B \u001b[5Ghold can't\u001b[16Gtake and\u001b[25Gon\u001b[28Gs its company already bid on. I\u001b[61Gprices \u001b[69Ghe go\u001b[75Gds a\u001b[80G th\u001b[84G cheape\u001b[92Gt source in its owner's\u001b[K\r\u001b[4C\u001b[1Bmarket reports and adds the trip's ch\u001b[43Grg\u001b[46Gs and a\u001b[54Gprofi\u001b[60G. It bids only within the t\u001b[88Gnd\u001b[91Gr's b\u001b[97Gdg\u001b[100Gt and only if the\r\u001b[4C\u001b[1Bcompany can pay for the\u001b[29Ggoods and the bond. Among the \u001b[60Genders it\u001b[70Gcan bid on,\u001b[82Git picks the\u001b[95Gone with the most budget\r\u001b[4C\u001b[1Bleft over.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe profit:\u001b[17G\u001b[22mthe\u001b[21Gjob's\u001b[27Gtarget\u001b[34Gprofit,\u001b[42Gor\u001b[45Gone\u001b[49Gcredit\u001b[56Gmore\u001b[61Gthan\u001b[66Gthe\u001b[70Gbest\u001b[75Gordinary\u001b[84Gtrade\u001b[90Git\u001b[93Gcould\u001b[99Gmake,\u001b[105Gwhichever\u001b[115Gis\r\u001b[2C\u001b[1B \u001b[5Ghigher. This was my reading of the plan's \"above \u001b[55Ghe b\u001b[60Gs\u001b[62G trade's \u001b[74Gimate\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAfter the bid:\u001b[22m the job waits in a new \u001b[38;2;177;185;249mBidding\u001b[39m phase until\u001b[64Ghe bid\u001b[71Gclose. If it\u001b[84Gwins,\u001b[90Git\u001b[93Gbuys\u001b[98Gwhat's\u001b[105Gstill\u001b[111Gowed\u001b[116Gat\r\u001b[2C\u001b[1B \u001b[5Gthe source, carri\u001b[23Gs it\u001b[28Gto \u001b[32Ghe tender's venue and d\u001b[56Glivers\u001b[63Git,\u001b[67Gmaking more tr\u001b[82Gps while \u001b[92Ghe delivery window\u001b[111Gallows.\u001b[119GIf\r\u001b[4C\u001b[1Bit loses, it goes back\u001b[31Gc\u001b[33Goosi\u001b[38Gg.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhen a contract ends early:\u001b[22m a default,\u001b[44Gor\u001b[47Gtotes\u001b[53Gleft\u001b[58Gover\u001b[63Gafter\u001b[69Gthe\u001b[73Glast\u001b[78Gdelivery,\u001b[88Gturn\u001b[93Gthe\u001b[97Gcargo\u001b[103Ginto\u001b[108Gan\u001b[111Gordinary\r\u001b[2C\u001b[1B \u001b[5Gtrade lot to sell.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSaves:\u001b[22m a load refuses\u001b[27Ga\u001b[29Gbidding\u001b[37Gjob\u001b[41Gthat\u001b[46Gnames\u001b[52Gno\u001b[55Gtender.\r\u001b[4C\u001b[1B\u001b[1mBuild order:\u001b[22m th\u001b[21G policy\u001b[29Gmo\u001b[32Gule now depends on pr\u001b[54Gcurem\u001b[60Gnt,\u001b[64Gso\u001b[67Gprocurement\u001b[79Gis\u001b[82Gnow\u001b[86Gadded\u001b[92Gbefore\u001b[99Git\u001b[102Gin\u001b[105Gthe\u001b[109Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests\r\u001b[2C\u001b[1B\u001b[22m- In the\u001b[12Ggovernance\u001b[23Gscenario,\u001b[33GAda's\u001b[39Gjob\u001b[43Gand\u001b[47Gan\u001b[50GNPC's\u001b[56Gboth\u001b[61Gknow\u001b[66Gonly\u001b[71GForge\u001b[77GHighport,\u001b[87Gso\u001b[90Gthe\u001b[94Gcopper\u001b[101Gtender\u001b[108Gis\u001b[111Gthe\u001b[115Gonly\r\u001b[2C\u001b[1B \u001b[5Go\u001b[7Ge either can supply. Ada's bid is lower\u001b[49Gd win\u001b[55G, her\u001b[61Gjob buys and d\u001b[76Glivers the\u001b[87Gnine totes with \u001b[104Go player\u001b[K\r\u001b[4C\u001b[1Bconn\u001b[10Gc\u001b[12Ged,\u001b[16Gand\u001b[20Gthe NPC\u001b[28Gchoo\u001b[33Ges again. The\u001b[76Gt-fo\u001b[81Gward matches stepp\u001b[100Gng\u001b[103Git\u001b[106Gbyte for\u001b[115Gbyte.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
