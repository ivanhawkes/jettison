[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Brounded\u001b[13Gto\u001b[16Gthe\u001b[20Gnearest\u001b[28Gcredit\u001b[35Gwith\u001b[40Ghalves\u001b[47Gup,\u001b[51Gand\u001b[55Gworked\u001b[62Gout\u001b[66Gexactly\u001b[74Gin\u001b[77Gwhole\u001b[83Gnumbers.\u001b[92GThe\u001b[96Gpayments\u001b[105Galways\u001b[112Gadd\u001b[116Gup\u001b[119Gto\r\u001b[1B \u001b[3G  the total.\u001b[16GThe last\u001b[25Gtote marks the tend\u001b[45Gr \u001b[38;2;177;185;249mFulfilled\u001b[39m and returns the bond.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mDefault:\u001b[22m a\u001b[16Gcontract still\u001b[31Gshort\u001b[37Gof\u001b[40Gtotes\u001b[46Gat\u001b[49Gits\u001b[53Gdelivery\u001b[62Gclose\u001b[68Gbecomes\u001b[76G\u001b[38;2;177;185;249mDefaulted\u001b[39m,\u001b[87Gand\u001b[91Gthe\u001b[95Gnew\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mManifest.Procurement.Abandon\u001b[34G\u001b[39mcommand\u001b[42Gdoes\u001b[47Gthe\u001b[51Gsame\u001b[56Gat\u001b[59Gonce.\u001b[65GWhatever\u001b[74Gis\u001b[77Gleft\u001b[82Gof\u001b[85Gthe\u001b[89Gtotal\u001b[95Ggoes\u001b[100Gback\u001b[105Gto\u001b[108Gthe\u001b[112Gregion.\r\u001b[2C\u001b[1B  The bond's\u001b[16Gshare\u001b[22Gfor\u001b[26Gthe\u001b[30Gmissing\u001b[38Gtotes\u001b[44Gis\u001b[47Gforfeit\u001b[55Gto\u001b[58Gthe\u001b[62Gregion,\u001b[70Grounded\u001b[78Gdown,\u001b[84Gand\u001b[88Gthe\u001b[92Grest\u001b[97Ggoes\u001b[102Gback\u001b[107Gto\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5Gcompany. Goods and payments already accepted stand. The AI then t\u001b[71Gnd\u001b[74Grs the\u001b[81Gmissing to\u001b[92Ges\u001b[95Gagain in the same\u001b[114Gte\u001b[117G.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSaves:\u001b[13G\u001b[22m load\u001b[19Gnow refuses a tender w\u001b[42Gose account d\u001b[56Gesn't ma\u001b[65Gch what it\u001b[76Gstill ow\u001b[85Gs, one with more delivered tha\u001b[116G it\r\u001b[4C\u001b[1Basked for,\u001b[16Gor one marked fulfilled before i\u001b[49Gs last tote.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChecks\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe full Manifest d\u001b[25Gbug suite\u001b[35G(55 tests) passed afte\u001b[58G the cod\u001b[67G changes.\u001b[77GAfter\u001b[83Gthat I added\u001b[96Gthe new tests and changed\r\u001b[4C\u001b[1Bcommen\u001b[12Gs, and re-ran \u001b[27Gnly the procur\u001b[42Gment\u001b[47Gsuite, which passes (28 cases, 7\u001b[80Gof\u001b[83Gthem\u001b[88Gnew).\u001b[94Gclang-tidy\u001b[105Gis\u001b[108Gclean\u001b[114Gon\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gfour changed files,\u001b[25Gand the format\u001b[40Gcheck\u001b[46Gpasse\u001b[52G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI broke the \"next step this system must run\" calcul\u001b[58Gi\u001b[61G on\u001b[65Gpurpos\u001b[72G to se\u001b[79G whether the new fa\u001b[99Gt-forward t\u001b[111Gst\u001b[K\r\u001b[4C\u001b[1Bnotices. At fi\u001b[20Gst it\u001b[26Gdidn't: \u001b[36G AI-run\u001b[44Gregi\u001b[49Gns the delive\u001b[63Gy close la\u001b[75Gs on a day bounda\u001b[93Gy, where\u001b[102Gthe system runs\r\u001b[4C\u001b[1Banyw\u001b[10Gy. I m\u001b[17Gved that test to a pla\u001b[40Ger-run tender whose closes fall off those boundaries, and now it catches\u001b[113Gth\u001b[116G\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gbreak.\u001b[12G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI di\u001b[10Gn't run the full gate: the plan calls for it after slices\u001b[68G3\u001b[70Gand\u001b[74G6\u001b[76Gonly.\r\u001b[2C\u001b[1B-\u001b[5GNo\u001b[8Gpinned\u001b[15Ghash\u001b[20Gmoved.\u001b[27GThe\u001b[31Gpinned\u001b[38Gworlds\u001b[45Gdo\u001b[48Ghold\u001b[53Gtenders,\u001b[62Gbut\u001b[66Gnone\u001b[71Ghas\u001b[75Ga\u001b[77Gdelivered\u001b[87Gtote,\u001b[93Gso\u001b[96Gthe\u001b[100Gnew\u001b[104Gcounter,\u001b[113Gleft\u001b[118Gat\r\u001b[2C\u001b[1B  zero,\u001b[11Gdoesn't\u001b[19Gseem\u001b[24Gto\u001b[27Gchange\u001b[34Gthe\u001b[38Gsave's\u001b[45Gby\u001b[27;1H\u001b[24;3H\u001b[?25h"]
