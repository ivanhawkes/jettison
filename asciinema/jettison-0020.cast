[0.072, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mCopper and tin:\u001b[22m she bu\u001b[28Gs the copper at Forge and fli\u001b[58Gs to Ca\u001b[66Gsiter, about 27,000\u001b[86Gsteps,\u001b[93Gto\u001b[96Gbuy\u001b[100Gthe\u001b[104Gtin.\u001b[109GA\u001b[111Gdelivery\r\u001b[4C\u001b[1Btried before\u001b[18Gthe bids\u001b[27Gclose is refused as \u001b[38;2;177;185;249mClosed\u001b[39m. Then she fli\u001b[68Gs back.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAward and delivery:\u001b[25G\u001b[22mshe wins both contra\u001b[46Gts. Each\u001b[55Gis fulfilled on delivery,\u001b[81Gpaid\u001b[86Gits\u001b[90Gfull\u001b[95Gtotal\u001b[101Gand\u001b[105Gits\u001b[109Gbond\r\u001b[4C\u001b[1Breturned.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe project:\u001b[22m in the step \u001b[31Gf t\u001b[35Ge las\u001b[42Gdelivery, the project uses up its inputs\u001b[83Gand\u001b[87Gstarts\u001b[94Gwork.\u001b[100GIts\u001b[104G7\u001b[106Gdays\u001b[111Gare\r\u001b[4C\u001b[1Bfast-forward\u001b[18Gd,\u001b[21Gand \u001b[26Ghe\u001b[29Gbronz\u001b[35G recipe is unlocked in Forge East\u001b[69Go\u001b[71Gly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDeterminism:\u001b[18G\u001b[22ma\u001b[20Gsave\u001b[25Gtaken\u001b[31Gwhile\u001b[37Gshe\u001b[41Gcruises\u001b[49Gto\u001b[52GCassiter,\u001b[62Gonce\u001b[67Gloaded,\u001b[75Greaches\u001b[83Gthe\u001b[87Gsame\u001b[92Gresults\u001b[100Gand\u001b[104Gthe\u001b[108Gsame\u001b[113Gworld.\r\u001b[4C\u001b[1BReplaying\u001b[15Gthe\u001b[19Grecorded\u001b[28Gcommands\u001b[37Gfrom\u001b[42Gthe\u001b[46Gstart,\u001b[53Gwith\u001b[58Gthe\u001b[62Ggaps\u001b[67Gbetween\u001b[75Gthem\u001b[80Gfast-forwarded,\u001b[96Greaches\u001b[104Gthe\u001b[108Gsame\u001b[113Gworld\r\u001b[2C\u001b[1B  too. Credits balance throughout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pin:\u001b[14G\u001b[22mthe\u001b[18Gfinal\u001b[24Ghash\u001b[29Gis\u001b[32Gpinned,\u001b[40Gand\u001b[44Git\u001b[47Gheld\u001b[52Gacross\u001b[59G