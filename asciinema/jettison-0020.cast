[0.150, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mRisks to know about\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe contract-versus-trade rule\u001b[36Gcompares\u001b[45Gtotal\u001b[51Gprofit,\u001b[59Gnot\u001b[63Gprofit\u001b[70Gper\u001b[74Ghour,\u001b[80Geven\u001b[85Gthough\u001b[92Gwaiting\u001b[100Gfor\u001b[104Gthe\u001b[108Gbid\u001b[112Gclose\u001b[118Gcan\r\u001b[2C\u001b[1B \u001b[5Gtake up\u001b[13Gto sev\u001b[20Gn days.\u001b[K\r\u001b[4C\u001b[1BThe job leaves out tend\u001b[29Grs larger than\u001b[44Gits free\u001b[53Gh\u001b[55Gld, and it \u001b[67Gstimat\u001b[74Gs\u001b[77Ghe bond from the\u001b[94Gco\u001b[97Gfigured\u001b[105Gr\u001b[107Gt\u001b[110Grather than\r\u001b[4C\u001b[1Bprocurement's \u001b[20Gwn calculation.\u001b[36G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gcargo\u001b[13Gseizure\u001b[21Gwhile\u001b[27Ga\u001b[29Gcontract\u001b[38Gis\u001b[41Gunder\u001b[47Gway\u001b[51Gdrops\u001b[57Gthe\u001b[61Gcontract,\u001b[71Gwhich\u001b[77Gthen\u001b[82Gdefaults.\r\u001b[2C\u001b[1B- In an\u001b[11Gearlier probe, the NPC default\u001b[42Gd\u001b[44Gon a tin contract while another trader was buying tin\u001b[98Ga\u001b[101Gth\u001b[104G \u001b[106Game \u001b[111Gource.\u001b[K\r\u001b[2C\u001b[1B  That kind\u001b[15Gof comp\u001b[23Gtition\u001b[30Gcould disrupt slice 6's gove\u001b[59Gnance\u001b[65Gfixture.\r\u001b[2B \u001b[3GSlice 6 is next: the governance fixture,\u001b[44GW12's\u001b[50Gclose-out,\u001b[61Gthe\u001b[65Ggate\u001b[70Gand\u001b[74Gthe\u001b[78Gstage\u001b[84Gcross-review.\u001b[98GIt\u001b[101Gneeds\u001b[107Gthis\u001b[112Gsession's\r\u001b[2C\u001b[1Bcontext,\u001b[12Gso\u001b[15Gcontinue\u001b[24Ghere;\u001b[30G\u001b[38;2;177;185;249m/compact\u001b[39G\u001b[39mfirst\u001b[45Gwould\u001b[51Galso\u001b[56Gwork.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mBaked for 19m 35s · done 6:39 pm\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[3