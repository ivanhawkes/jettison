o\u001b[77Ge trips\u001b[85Gwhile\u001b[91Gthe\u001b[95Gdelivery\u001b[104Gwindow\u001b[111Gallows.\u001b[119GIf\r\u001b[4C\u001b[1Bit loses, it goes b\u001b[25Gck to choosing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhen a contract ends early:\u001b[33G\u001b[22ma\u001b[35Gdefault,\u001b[44Gor\u001b[47Gtotes\u001b[53Gleft\u001b[58Gover\u001b[63Gafter\u001b[69Gthe\u001b[73Glast\u001b[78Gdelivery,\u001b[88Gturn\u001b[93Gthe\u001b[97Gcargo\u001b[103Ginto\u001b[108Gan\u001b[111Gordinary\r\u001b[4C\u001b[1Btrade\u001b[11Glot\u001b[15Gto\u001b[18Gsell.\r\u001b[2C\u001b[1B- \u001b[1mSaves:\u001b[22m a load refuses a bidding\u001b[37Gjob\u001b[41Gthat\u001b[46Gnames\u001b[52Gno\u001b[55Gtender.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBuild order:\u001b[18G\u001b[22mthe\u001b[22Gpolicy\u001b[29Gmodule\u001b[36Gnow\u001b[40Gdepends\u001b[48Gon\u001b[51Gprocurement,\u001b[64Gso\u001b[67Gprocurement\u001b[79Gis\u001b[82Gnow\u001b[86Gadded\u001b[92Gbefore\u001b[99Git\u001b[102Gin\u001b[105Gthe\u001b[109Gbuild.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests\r\u001b[1B\u001b[22m \u001b[3G- In \u001b[9Gh\u001b[11G governance scenario, Ada's job and\u001b[47Gan\u001b[50GNPC's\u001b[56Gboth\u001b[61Gknow\u001b[66Gonly\u001b[71GForge\u001b[77GHighport,\u001b[87Gso\u001b[90Gthe\u001b[94Gcopper\u001b[101Gtender\u001b[108Gis\u001b[111Gthe\u001b[115Gonly\r\u001b[1B    one either can supply. Ada's bid is lower and wins, her job buys and delivers\u001b[83Gthe\u001b[87Gnine\u001b[92Gtotes\u001b[98Gwith\u001b[103Gno\u001b[106Gplayer\r\u001b[4C\u001b[1Bconnected,\u001b[16Gand\u001b[20Gthe\u001b[24GNPC\u001b[28Gchooses\u001b[36Gagain.\u001b[43GThe\u001b[47Gsame\u001b[52Grun\u001b[56Gpassed\u001b[63Gover\u001b[68Gwith\u001b[73Gfast-forward\u001b[86Gmatches\u001b[94Gstepping\u001b[103Git\u001b[106Gbyte\u001b[111Gfor\u001b[115Gbyte.\r\u001b[1B \u001b[3G- The full debug suite passes (55 tests), and clang-tidy\u001b[60Gis\u001b[63Gclean\u001b[69Gon\u001b[72Gthe\u001b[76Gchanged\u001b[84Gf