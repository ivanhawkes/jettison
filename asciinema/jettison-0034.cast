ane C, and I'll merge it once\u001b[100Gthat\u001b[105Gpasses.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/jettison.lane-c'\u001b[52G&&\u001b[55G./scr…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && ./scripts/ci.sh --werror --asan --log build/gate.log (1m 35s · 11 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mlines)\u001b[39m\u001b[K\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mthought for 7s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
