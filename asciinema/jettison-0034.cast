[0.132, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m line\u001b[19G, r\u001b[23Gmoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22mst\u001b[14Gp's stat\u001b[23G ([\u001b[38;2;230;219;116mwhy\u001b[39m](decisions.md#script\u001b[51G)).\u001b[55GA script gran\u001b[69Ged `read:<Comp\u001b[84Gnent>` i\u001b[95Grts\u001b[K\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m`jettison_read_<C\u001b[29Gmponent>`,\u001b[40Gwhich takes an\u001b[55Gentity and return\u001b[73G its copy of the compo\u001b[96Gen\u001b[99G as the\r\u001b[5C\u001b[1B\u001b[2m 93 \u001b[22m snapshot has it, or null for an entity with none there; in Rust, `read_<Component>(entity, f)`\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m94\u001b[11G\u001b[38;2;248;248;242mgives the\u001b[21Gcopy\u001b[26Gto\u001b[29G`f`\u001b[33Gand\u001b[37Greturns\u001b[45Gwhat\u001b[50G`f`\u001b[54Ganswers,\u001b[63Gso\u001b[66Gsafe\u001b[71Gcode\u001b[76G\u001b[48;2;92;2;0mcannot\u001b[83G\u001b[48;2;61;1;0mkeep\u001b[48;2;92;2;0m a reference to it. The com\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mponent\u001b[48;2;61;1;0m                                                                                                 \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4\u001b[11G\u001b[38;2;248;248;242mgives the copy\u001b[27Go `f` \u001b[48;2;4;71;0mfor any lifetime at all \u001b[48;2;2;40;0mand returns w\u001b[71Gat `f` answer\u001b[85G, so\u001b[91Gafe code \u001b[48;2;4;71;0mcan\u001b[48;2;2;40;0m keep\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[11G\u001b[38;2;248;248;242mnothing of it, the copy,\u001b[36Ga string in it\u001b[51Gor\u001b[54Ga\u001b[56Greference:\u001b[67Geach\u001b[72Gis\u001b[75Grefused\u001b[83Gas\u001b[86Gthe\u001b[90Gscript\u001b[97Gcompiles\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 96 +\u001b[38;2;248;248;242m(the suite's `kept.rs`). The component                                                                 \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[11G\u001b[22mis one Reflect marks `Scri\u001b[38Gt` and the world shows in its snapshots\u001b[K\r\u001b[7C\u001b[1B\u001b[2m8\u001b[11G\u001b[22m(`Sim::SimWorld::ShowInSnapshots`), or\u001b[50Gthe grant does not\u001b[69Gload. The game giv\u001b[88Gs the host the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 99 \u001b[11G\u001b[22msnapshot\u001b[20Gonce,\u001b[26G`ScriptHost::ReadFrom`,\u001b[50Gas\u001b[53Gthe\u001b[57Gshell\u001b[63Ggives\u001b[69Gits\u001b[73Gstepper's\u001b[83Gcurrent\u001b[91Gone,\u001b[96Gthe\u001b[100Gone\u001b[104Gafter\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything\u001b[14Gis\u001b[17Gclean\u001b[23Gand\u001b[27Gall\u001b[31G33\u001b[34Gsuites\u001b[41Gpass.\u001b[47GCommitting\u001b[58Ground\u001b[64G3's\u001b[68Gfixes\u001b[74Gand\u001b[78Grunning\u001b[86Gthe\u001b[90Ggate.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Making \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+21\u001b[39m, committed \u001b[1m4ba5121\u001b[22m, searching for \u001b[1m1\u001b[22m pattern, running \u001b[1m3\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-b' && ./scripts/ci.sh --werror --asan --log build/gate.log\r\u001b[2C\u001b[2B\u001b[38;2;225;139;107mUndulating…\u001b[20G\u001b[38;2;153;153;153m1\r\u001b[18C\u001b[6B(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
