[0.007, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 68 \u001b[11G\u001b[22m**Why.**\u001b[20GA\u001b[22Gscript\u001b[29Gsees\u001b[34Gthe\u001b[38Gworld\u001b[44Gonly\u001b[49Gthrough\u001b[57Gthe\u001b[61Gevents\u001b[68Git\u001b[71Gis\u001b[74Ggiven\u001b[80Gand\u001b[84Gan\u001b[87Goption's\u001b[96Ginputs:\u001b[104Genough\r\u001b[5C\u001b[1B\u001b[2m 69 \u001b[11G\u001b[22mfor\u001b[15Ga\u001b[17Ghandler\u001b[25Gthat\u001b[30Greacts,\u001b[38Gnot\u001b[42Gfor\u001b[46Gone\u001b[50Gthat\u001b[55Glooks\u001b[61Garound.\u001b[69GReload\u001b[76Gand\u001b[80Gfuel\u001b[85Greports\u001b[93Gare\u001b[97Gwhat\u001b[102Ga\u001b[104Gmodder\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines, removed \u001b[1m2\u001b[22m line\u001b[37G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m66 \u001b[22m -\u001b[13GA\u001b[15Gscript\u001b[22Greloaded\u001b[31Gwhen\u001b[36Gits\u001b[40Gmodule\u001b[47Gchanges.\r\u001b[6C\u001b[1B\u001b[2m67 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 68 \u001b[22m **Why.** A script sees the world only through the events it is given and an option's inputs: enough\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 69 -\u001b[38;2;248;248;242mfor a handler that reacts, not for one that looks around. Reload \u001b[48;2;92;2;0mand\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfuel reports are \u001b[48;2;61;1;0mwhat a modder    \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 70 -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mneeds to write \u001b[48;2;61;1;0mscripts quickly.                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 69 +\u001b[38;2;248;248;242mfor a handler that reacts, not for one that looks around. Reload \u001b[48;2;4;71;0mis\u001b[48;2;2;40;0m what a modder\u001b[48;2;4;71;0m needs to write\u001b[48;2;2;40;0m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 70 +\u001b[38;2;248;248;242mscripts quickly.                                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[2m 71 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 72 \u001b[22m **What exists.** WAMR's interpreter, bounded by fuel and\u001b[68Gby\u001b[71Ga\u001b[73Gwall-time\r\u001b[5C\u001b[1B\u001b[2m 73 \u001b[11G\u001b[22m[\u001b[38;2;230;219;116mwatchdog\u001b[39m](glossary.md#watchdog)\u001b[44G(`script/ScriptHost.h`).\u001b[69GA\u001b[71Gscript\u001b[78Gis\u001b[81Ggranted\u001b[89G`log`,\u001b[96G`store`\u001b[104Gand\u001b[108Gone\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && rg -n \"#dependencies|^## Dependencies|^### Dependencies|#reasons\" \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mdocs/build-and-gates.md docs/simulation.md\u001b[39m\u001b[K\r\u001b[18C\u001b[8B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
