17G\u001b[22m\u001b[38;2;166;226;46mwasm_export_t\u001b[39m exported{};\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1023 \u001b[17G\u001b[22m\u001b[38;2;166;226;46mwasm_runtime_get_export_type\u001b[39m(pScript->\u001b[38;2;102;217;239mmodule\u001b[39m,\u001b[63Gindex,\u001b[70G&exported);\r\u001b[1B \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1024 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mif\u001b[38;2;248;248;242m (exported.kind == WASM_IMPORT_EXPORT_KIND_FUNC && exported.name != \u001b[38;2;190;132;255mnullptr\u001b[38;2;248;248;242m &&                 \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1025 +\u001b[38;2;248;248;242m        std::ranges::\u001b[38;2;166;226;46mfind\u001b[38;2;248;248;242m(kInstantiationCalls, std::string_view{exported.name}) !=                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1026 +\u001b[38;2;248;248;242m            kInstantiationCalls.\u001b[38;2;166;226;46mend\u001b[38;2;248;248;242m())                                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1027 +\u001b[38;2;248;248;242m      \u001b[38;2;249;38;114mthrow\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mfail\u001b[38;2;248;248;242m(std::format(                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1028 +\u001b[38;2;248;248;242m          \u001b[38;2;230;219;116m\"its module '{}' exports '{}', which would run as it is instantiated\"\u001b[38;2;248;248;242m,                     \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m1\u001b[9G29 +\u001b[38;2;248;248;242m          definition.\u001b[38;2;102;217;239mmodule\u001b[38;2;248;248;242m, exported.name));                        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 1030 \u001b[22m     \u001b[38;2;249;38;114mif\u001b[39m (exported.kind != WASM_IMPORT_EXPORT_KIND_MEMORY)\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1031 \u001b[22m       \u001b[38;2;249;38;114mcontinue\u001b[39m;  