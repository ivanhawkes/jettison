[0.016, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m79\u001b[11G\u001b[22mthe box\u001b[19Galong any one), so a\u001b[40Gcourse can\u001b[53Gart or\u001b[60Gend\u001b[64Gjust\u001b[69Gover\u001b[74Ga deck\u001b[81Gunder\u001b[87Ga pier, or bes\u001b[102Gde its\r\u001b[5C\u001b[1B\u001b[2m 80 \u001b[22m corner. Such an end is given a waypoint straight out from each of the box's faces to its ring. A\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m1\u001b[11G\u001b[38;2;248;248;242mcourse is given the radius of wh\u001b[44Gt flies it: f\u001b[58Gom an\u001b[64Gend\u001b[68Gnearer a\u001b[80G than that, as a vehicle \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m2\u001b[11G\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mresting on a \u001b[48;2;61;1;0mdeck is, the\u001b[37Gonly\u001b[42Gways\u001b[47Gout\u001b[51Gare\u001b[55Gstraight\u001b[64Gout\u001b[68Gfrom\u001b[73Gthe\u001b[77Gbox's\u001b[83Gfaces,\u001b[90Gso\u001b[93Git\u001b[96Glifts\u001b[102Goff\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 83 -\u001b[38;2;248;248;242mbefore it goes anywhere.                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[11G\u001b[38;2;248;248;242mcourse is told how near a box an end is\u001b[51Gresting on it: from \u001b[72Gn end tha\u001b[83Gnear,\u001b[89Gas a vehicle on a \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242mdeck is, the only ways out are stra\u001b[47Gght out from t\u001b[63G box's faces,\u001b[77Gso it lifts off\u001b[48;2;4;71;0m before it goes\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m3\u001b[11G\u001b[38;2;248;248;242manywhere. The docks give it\u001b[39Gthe vehicle's\u001b[53Gresting height and half its hover,\u001b[88Gshort\u001b[94Gof\u001b[97Gwhere\u001b[103Gany\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 84 +\u001b[38;2;248;248;242mpoint over a berth is, so a vehicle under a low roof still goes out level.                             \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m5\u001b[11G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22mA sphere \u001b[21Gr a box that moves while a vehicle flies the course stays where it was in the graph,\u001b[106Gso\u001b[109Ga\r\u001b[5C\u001b[1B\u001b[2m 87 \u001b[11G\u001b[22mcaller\u001b[18Gplots\u001b[24Gagain\u001b[30Gas\u001b[33Gthe\u001b[37Gvehicle\u001b[45Ggoes,\u001b[51Gor\u001b[54Gmakes\u001b[60Gthe\u001b[64Gcourse\u001b[71Gin\u001b[74Gan\u001b[77Gentity's\u001b[86Gaxes\u001b[91G(below).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDeparting\u001b[13Gfrom\u001b[18Gunder\u001b[24Gthe\u001b[28Glow\u001b[32Groof\u001b[37Gnow\u001b[41Gworks.\u001b[48GFlying\u001b[55Gin\u001b[58Gdoesn't\u001b[66Gdock\u001b[71Gyet,\u001b[76Gand\u001b[80Ga\u001b[82Gphysics\u001b[90Gtest\u001b[95Gfails.\u001b[102GLooking\u001b[110Gat\u001b[113Gboth.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  ~/projects/jettison.lane-b/build/reviews/stage-j02-j09/scratch/build-round3-inbound-cover.py\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
