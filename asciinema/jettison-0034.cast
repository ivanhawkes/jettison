[0.023, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m8\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m##\u001b[15GUsing\u001b[21Git\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/ai.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m4\u001b[22m \u001b[31Gi\u001b[34Gs\u001b[K\r\u001b[1B     \u001b[2m 483 \u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m-\u001b[14GUtility\u001b[22GAI\u001b[25Gand\u001b[29Gbehaviour\u001b[39Gtrees\u001b[45Ghave\u001b[50Gno\u001b[53Gconsumer\u001b[62Goutside\u001b[70Gthe\u001b[74G`ai`\u001b[79Gsuite\u001b[85Gtoday;\u001b[92GManifest\u001b[101Guses\r\u001b[8C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m \u001b[14Gpathfinding, courses and\u001b[39Gst\u001b[43Gring, a\u001b[51Gd\u001b[54Ghooses a job's next\u001b[74Gstep\u001b[79Gwith i\u001b[86Gs own\u001b[92G\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 486 -\u001b[38;2;248;248;242m  `Manifest::Policy::Choose`\u001b[48;2;92;2;0m ([J03](roadmap\u001b[48;2;61;1;0m.\u001b[48;2;92;2;0mmd#j03)).\u001b[48;2;61;1;0m                                                 \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m7\u001b[12G\u001b[38;2;248;248;242m-\u001b[14GBehaviour trees: no reactive or parallel nodes, no task\u001b[70Ghalt,\u001b[76Gno\u001b[79Gsubtrees,\u001b[89Gno\u001b[92Gblackboard,\u001b[104Gno\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m8\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gcommand giving an entity a tree, no tr\u001b[53Ge\u001b[55Gticked\u001b[62Gless often \u001b[74Gha\u001b[77G every step\u001b[89G  \u001b[92G           \u001b[104G  \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[14G\u001b[38;2;248;248;242m([J03](roadmap.md#j03)).\u001b[39G \u001b[41G     \u001b[47G  \u001b[50G    \u001b[55G      \u001b[62G    \u001b[67G     \u001b[73G    \u001b[78G     \u001b[84G    \