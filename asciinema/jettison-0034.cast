[0.032, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m0\u001b[12G\u001b[22mit, \u001b[17Goads\u001b[22Gthe script again\u001b[39Gby\u001b[42Gt\u001b[44Ge s\u001b[48Gme checks. A script\u001b[68Gloaded\u001b[75Gagain keeps its keys and makes its\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22mhandlers' instanc\u001b[30G afresh,\u001b[39Gso what a\u001b[49Ghandle\u001b[56G counted in memory\u001b[75Gis g\u001b[82G, and its\u001b[92Gin\u001b[95Guts and\u001b[103Gtasks\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 252 \u001b[22m answer from the new module from then on; a run that reloads is not one a replay repeats. A module\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m3\u001b[12G\u001b[38;2;248;248;242mthat no longer\u001b[27Glo\u001b[30Gds le\u001b[36Gves the script loaded\u001b[58Gbefore it\u001b[68Grunning,\u001b[77Glogged\u001b[48;2;92;2;0m, and is not tried again\u001b[48;2;61;1;0m   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 254 -\u001b[38;2;248;248;242muntil the file changes again. The shell looks every 500 ms where it hot-reloads its resources, and    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m3\u001b[12G\u001b[38;2;248;248;242mthat no longer loads\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mc\u001b[36Gnnot\u001b[41Gbe read or has gone \u001b[48;2;2;40;0mleaves the script \u001b[80Goaded b\u001b[88Gfo\u001b[91Ge\u001b[93Git running, logged   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m254\u001b[12G\u001b[38;2;248;248;242m\u001b[48;2;4;71;0monce, and is not tried again \u001b[48;2;2;40;0muntil\u001b[47Gthe\u001b[51Gfile\u001b[56Gchanges\u001b[64Gagain.\u001b[71GThe\u001b[75Gshell\u001b[81Glooks\u001b[87Gevery\u001b[93G500\u001b[97Gms\u001b[100Gwhere\u001b[106Git\u001b[109Ghot-r\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242meloads its resources, and                                                                             \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m5\u001b[12G\u001b[22mneve