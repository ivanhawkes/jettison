e tasks:\u001b[22m these run inside\u001b[55Gthe\u001b[59Gstep.\u001b[65GThe\u001b[69Gfuel\u001b[74Glimit\u001b[80Gis\u001b[83Gwhat\u001b[88Gkeeps\u001b[94Gtheir\u001b[100Gresult\u001b[107Gthe\u001b[111Gsame\u001b[116Gon\r\u001b[4C\u001b[1Bevery\u001b[11Gmachine,\u001b[20Gso\u001b[23Gthey\u001b[28Ghave\u001b[33Gto\u001b[36Gstay\u001b[41Ginterpreted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision for you: do I build ahead-of-tim\u001b[45G compilati\u001b[56Gn f\u001b[60Gr handlers o\u001b[73Gly as \u001b[80Gart of J04, or drop\u001b[100Git? I'd drop it for\r\u001b[2C\u001b[1Bnow:\u001b[8Ga handler call costs\u001b[29G0.27\u001b[34Gµs\u001b[37Ginterpreted,\u001b[50Gand\u001b[54Gno\u001b[57Gprofile\u001b[65Ghas\u001b[69Gfound\u001b[75Gscripts\u001b[83Gslow.\u001b[89GEither\u001b[96Gway\u001b[100G\u001b[38;2;177;185;249mwamrc\u001b[106G\u001b[39mstays\u001b[112Gon\u001b[115Gthe\r\u001b[2C\u001b[1Bpath\u001b[8Gfor\u001b[12Gwhen\u001b[17Gone\u001b[21Gdoes.\r\u001b[2C\u001b[1B     \u001b[9G     \u001b[15G     \u001b[21G      \u001b[28G         \u001b[38G    \u001b[43G   \u001b[76G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.063, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bhas\u001b[9Git, so the build takes\u001b[32Gabou\u001b[37G 90 seconds.\u001b[50G\u001b[38;2;177;185;249mdevenv.nix\u001b[61G\u001b[39madds\u001b[66Gthe\u001b[70Gpackage,\u001b[79Gand\u001b[83G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[107G\u001b[39mnotes\u001b[113Gthat\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gtwo WAMR pins have to move togeth\u001b[39Gr.\u001b[42G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[17G\u001b[39mt\u001b[19G a\u001b[22G2 KB \u001b[38;2;177;185;249m.aot\u001b[39m fi\u001b[35Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[22m your current\u001b[30Gshell won't see it until\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[4C\u001b[1Bthere\u001b[11G(\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor\u001b[30Gre-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts\u001b[32Gfuel only when \u001b[48Gt interprets a script. Its\u001b[75Gahead-of-tim\u001b[88G ru\u001b[92Gtime and compiler have no\u001b[K\r\u001b[2C\u001b[1Binstruction\u001b[15Gmetering at all, so compiled scripts would run with \u001b[68Go\u001b[70Gfu\u001b[73Gl limit, stopped on\u001b[93Gy by the 250 ms watchdog.\u001b[119G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHandlers:\u001b[22m these run \u001b[26Gutside\u001b[33Gthe\u001b[37Gstep,\u001b[43Gand\u001b[47Gthe\u001b[51Gcommands\u001b[60Gthey\u001b[65Gsend\u001b[70Gare\u001b[74Grecorded,\u001b[84Gso\u001b[87Gcompiled\u001b[96Ghandlers\u001b[105Gwould\u001b[111Gbe\u001b[114Gsafe\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Gfar as determinism goes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInputs and behaviour-tree tasks:\u001b[22m these run inside\u001b[55Gthe\u001b[59Gstep.\u001b[65GThe\u001b[69Gfuel\u001b[74Glimit\u001b[80Gis\u001b[83Gwhat\u001b[88Gkeeps\u001b[94Gtheir\u001b[100Gresult\u001b[107Gthe\u001b[111Gsame\u001b[116Gon\r\u001b[4C\u001b[1Bevery\u001b[11Gmachine,\u001b[20Gso\u001b[23Gthey\u001b[28Ghave\u001b[33Gto\u001b[36Gstay\u001b[41Ginterpreted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision for you: do I build ahead-of-tim\u001b[45G compilati\u001b[56Gn f\u001b[60Gr handlers o\u001b[73Gly as \u001b[80Gart of J04, or drop\u001b[100Git? I'd drop it for\r\u001b[2C\u001b[1Bnow:\u001b[8Ga handler call costs\u001b[29G0.27\u001b[34Gµs\u001b[37Ginterpreted,\u001b[50Gand\u001b[54Gno\u001b[57Gprofile\u001b[65Ghas\u001b[69Gfound\u001b[75Gscripts\u001b[83Gslow.\u001b[89GEither\u001b[96Gway\u001b[100G\u001b[38;2;177;185;249mwamrc\u001b[106G\u001b[39mstays\u001b[112Gon\u001b[115Gthe\r\u001b[2C\u001b[1Bpath\u001b[8Gfor\u001b[12Gwhen\u001b[17Gone\u001b[21Gdoes.\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.256, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat I did:\u001b[22m nixpkgs only packages WAMR's runtime, so the new\u001b[66G\u001b[38;2;177;185;249mnix/wamrc.nix\u001b[39m builds \u001b[38;2;177;185;249mwamrc\u001b[39m from WAMR 2.4.5, the releas\r\u001b[5C\u001b[1Bhe\u001b[9Gengine alre\u001b[21Gdy\u001b[24Gpins, agains\u001b[37G LLVM 18.\u001b[47GLLVM\u001b[52G18\u001b[55Gis\u001b[58Gthe\u001b[62Grelease\u001b[70GWAMR\u001b[75Gtests\u001b[81G\u001b[38;2;177;185;249mwamrc\u001b[87G\u001b[39mwith,\u001b[93Gand\u001b[97Gnixpkgs'\u001b[106Gbinary\u001b[113Gcache\r\u001b[2C\u001b[1B \u001b[5Ghas it, so the build\u001b[26Gt\u001b[28Gk\u001b[30Gs about 90 seconds. \u001b[38;2;177;185;249md\u001b[52Gvenv.nix\u001b[39m adds the package,\u001b[79Gand \u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[39m notes that the\r\u001b[4C\u001b[1Btwo WAMR pins h\u001b[21Gve\u001b[24Gto\u001b[27Gmove\u001b[32Gtog\u001b[36Gther.\r\u001b[4C\u001b[1B\u001b[1mH\u001b[7Gw I checked it:\u001b[22m in lane C, a\u001b[36Gfresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs \u001b[38;2;177;185;249mwamrc 2.4.5\u001b[39m on the\u001b[79Gpath, and it\u001b[92Gcompiled the script suite's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mevents.wasm\u001b[39m to a 2 KB\u001b[27G\u001b[38;2;177;185;249m.aot\u001b[39m file.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[17G\u001b[22myour\u001b[22Gcurrent\u001b[30Gshell\u001b[36Gwon't\u001b[42Gsee\u001b[46Git\u001b[49Guntil\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[2C\u001b[1B  there (\u001b[38;2;177;185;249mdirenv reload\u001b[39m, or re-enter \u001b[38;2;177;185;249mdevenv shell\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA c\u001b[7Gtch for J04:\u001b[22m WAMR\u001b[25Gcounts fuel\u001b[37Gonly when\u001b[47Git interprets a script. Its ahea\u001b[80G-of-time runtime \u001b[100G compiler have no\u001b[K\r\u001b[2C\u001b[1Binst\u001b[8Guction meter\u001b[21Gng\u001b[24Gat all,\u001b[32Gso\u001b[35Gcompiled\u001b[44Gscripts\u001b[52Gwould\u001b[58Grun\u001b[62Gwith\u001b[67Gno\u001b[70Gfuel\u001b[75Glimit,\u001b[82Gstopped\u001b[90Gonly\u001b[95Gby\u001b[98Gthe\u001b[102G250\u001b[106Gms\u001b[109Gwatchdog.\r\u001b[4C\u001b[1B\u001b[1mHandlers:\u001b[22m these run outside the s\u001b[39Gep, and the commands \u001b[61Ghey\u001b[65Gsend are\u001b[74Grecorded, so compiled handl\u001b[102Grs would\u001b[111Gbe safe\u001b[119Gas\r\u001b[4C\u001b[1Bfar as determinism goes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInputs and behaviour-tree tasks:\u001b[38G\u001b[22mthese\u001b[44Grun\u001b[48Ginside\u001b[55Gthe\u001b[59Gstep.\u001b[65GThe\u001b[69Gfuel\u001b[74Glimit\u001b[80Gis\u001b[83Gwhat\u001b[88Gkeeps\u001b[94Gtheir\u001b[100Gresult\u001b[107Gthe\u001b[111Gsame\u001b[116Gon\r\u001b[2C\u001b[1B  every machine, so they have to stay int\u001b[45Grpreted.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecisi\u001b[10Gn\u001b[12Gfor y\u001b[18Gu:\u001b[23G I build\u001b[32Gahead-of-time\u001b[46Gc\u001b[76Gas\u001b[79Gpart\u001b[84Gof\u001b[87GJ04,\u001b[92Gor\u001b[95Gdrop\u001b[100Git?\u001b[104GI'd\u001b[108Gdrop\u001b[113Git\u001b[116Gfor\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat I did:\u001b[22m nixpkgs o\u001b[27Gly\u001b[30Gpackages WA\u001b[42GR's runtime,\u001b[55Gso\u001b[62Gn\u001b[64Gw \u001b[38;2;177;185;249mnix/wamrc.nix\u001b[39m builds\u001b[87G\u001b[38;2;177;185;249mwamrc\u001b[93G\u001b[39mfrom WAMR 2.4.5, the rel\u001b[118Gase\r\u001b[4C\u001b[1Bthe\u001b[9Gengine\u001b[16Galready pins, ag\u001b[33Gins\u001b[38GLLVM 18. LLVM 18 is the releas\u001b[70GWAMR t\u001b[77Gsts \u001b[38;2;177;185;249mwamr\u001b[86G\u001b[39m with, and nixpkgs' binary\u001b[113Gcache\u001b[K\r\u001b[4C\u001b[1Bhas\u001b[9Git, so the build takes\u001b[32Gabou\u001b[37G 90 seconds.\u001b[50G\u001b[38;2;177;185;249mdevenv.nix\u001b[61G\u001b[39madds\u001b[66Gthe\u001b[70Gpackage,\u001b[79Gand\u001b[83G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[107G\u001b[39mnotes\u001b[113Gthat\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gtwo WAMR pins have to move togeth\u001b[39Gr.\u001b[42G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[17G\u001b[39mt\u001b[19G a\u001b[22G2 KB \u001b[38;2;177;185;249m.aot\u001b[39m fi\u001b[35Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[22m your current\u001b[30Gshell won't see it until\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[4C\u001b[1Bthere\u001b[11G(\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor\u001b[30Gre-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts\u001b[32Gfuel only when \u001b[48Gt interprets a script. Its\u001b[75Gahead-of-tim\u001b[88G ru\u001b[92Gtime and compiler have no\u001b[K\r\u001b[2C\u001b[1Binstruction\u001b[15Gmetering at all, so compiled scripts would run with \u001b[68Go\u001b[70Gfu\u001b[73Gl limit, stopped on\u001b[93Gy by the 250 ms watchdog.\u001b[119G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHandlers:\u001b[22m these run \u001b[26Gutside\u001b[33Gthe\u001b[37Gstep,\u001b[43Gand\u001b[47Gthe\u001b[51Gcommands\u001b[60Gthey\u001b[65Gsend\u001b[70Gare\u001b[74Grecorded,\u001b[84Gso\u001b[87Gcompiled\u001b[96Ghandlers\u001b[105Gwould\u001b[111Gbe\u001b[114Gsafe\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Gfar as determinism goes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInputs and behaviour-tree tasks:\u001b[22m these run inside\u001b[55Gthe\u001b[59Gstep.\u001b[65GThe\u001b[69Gfuel\u001b[74Glimit\u001b[80Gis\u001b[83Gwhat\u001b[88Gkeeps\u001b[94Gtheir\u001b[100Gresult\u001b[107Gthe\u001b[111Gsame\u001b[116Gon\r\u001b[4C\u001b[1Bevery\u001b[11Gmachine,\u001b[20Gso\u001b[23Gthey\u001b[28Ghave\u001b[33Gto\u001b[36Gstay\u001b[41Ginterpreted.\r\u001b[2C\u001b[1B        \u001b[12G   \u001b[16G    \u001b[21G  \u001b[24G \u001b[26G     \u001b[32G             \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
