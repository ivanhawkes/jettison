                                                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[2m 251 \u001b[22m   \u001b[38;2;117;113;94m// The radius of the smallest sphere about the body's origin holding the shape: a box's half\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 252 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// diagonal, a mesh's farthest vertex. What steering keeps clear of a body. Throws\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 253 \u001b[22m   \u001b[38;2;117;113;94m// std::invalid_argument for a shape that is not defined.\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m2\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[5C\u001b[1B\u001b[39m   \u001b[10G                                    \u001b[27;1H\u001b[24;3H\u001b[?25h"]
