[0.284, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5G docs/scope.md\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[38;2;153;153;153m+6 more\u001b[14G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  (a git step in this command can move the working tree, so these may be its changes, not edits) \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ03\u001b[7Gand\u001b[11GJ10\u001b[15Gare\u001b[19Gboth\u001b[24Gdone\u001b[29Gand\u001b[33Gmerged\u001b[40Gon\u001b[43G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[57Gand\u001b[61Gthe\u001b[65Gfull\u001b[70Ggate\u001b[75Gpassed\u001b[82G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[100G281\u001b[104Gs)\u001b[107Gon\u001b[110Gthe\r\u001b[2C\u001b[1Bcombined head. That run covers J35,\u001b[39GJ10 and J03. Nothing\u001b[60Gis\u001b[63Gpushed,\u001b[71Gand\u001b[75Gboth\u001b[80Glanes\u001b[86Gare\u001b[90Gparked\u001b[97Gand\u001b[101Gfree.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ10, the shell's log file (\u001b[38;2;177;185;249m7138f4d\u001b[39m).\u001b[40G\u001b[22mWritten\u001b[48Gby\u001b[51Gthe\u001b[55Gsubagent\u001b[64Gin\u001b[67Glane\u001b[72GB,\u001b[75Greviewed\u001b[84Gby\u001b[87Gme.\r\u001b[4C\u001b[1BEach run writes \u001b[38;2;177;185;249mjettison.log\u001b[39m to the stat\u001b[46G d\u001b[49Grectory: \u001b[38;2;177;185;249m~/.local/state/jettison/\u001b[39m, or \u001b[38;2;177;185;249m<dir>/state/\u001b[100G\u001b[39munder\u001b[106G\u001b[38;2;177;185;249m--user-dir\u001b[39m.\r\u001b[4C\u001b[1BIt takes Info and above, a\u001b[32Gd each run overwrit\u001b[52Gs\u001b[54Git. If\u001b[61Gthe file\u001b[70Gcan't be opened, the\u001b[91Grun logs a warning and carries\r\u001b[4C\u001b[1Bon.\u001b[K\r\u001b[4C\u001b[1BI fixed one\u001b[17Gthing i\u001b[26Greview: th\u001b[38Glog was\u001b[46Gcreating\u001b[55Gthe stat\u001b[64G direct\u001b[72Gry with default permissions.\u001b[101GIt's\u001b[106Gnow\u001b[110Gcreated\r\u001b[2C\u001b[1B \u001b[5Gfirst with mode\u001b[21G0700,\u001b[27Glike the oth\u001b[40Gr user d\u001b[49Grecto\u001b[55Gies.\u001b[K\r\u001b[4C\u001b[1BThe new test writes a log in a fresh directory and finds \u001b[63Ghe Info line in it but not the Debug one.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ03, b\u001b[10Ghav\u001b[14Gour tr\u001b[21Ge\u001b[24G(\u001b[38;2;177;185;249med57c63\u001b[39m).\u001b[22m All seven items are\u001b[57G:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReactive sequence and selector:\u001b[37G\u001b[22mthey\u001b[42Gcheck\u001b[48Gwhat\u001b[53Gcomes\u001b[59Gbefore\u001b[66Ga\u001b[68Grunning\u001b[76Gbranch\u001b[83Gon\u001b[86Gevery\u001b[92Gtick,\u001b[98Gand\u001b[102Gstop\u001b[107Gthe\u001b[111Gbranch\r\u001b[4C\u001b[1Bthey\u001b[10Gleave.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
