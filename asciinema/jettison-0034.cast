[0.039, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m3\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[2m 62 \u001b[22m - A script call\u001b[29Gfrom a behaviour\u001b[46Gtree's\u001b[53Gtask,\u001b[59Gas\u001b[62Gan\u001b[65Ginput\u001b[71Gis\u001b[74Gcalled\u001b[81Gfrom\u001b[86Ga\u001b[88Gconsideration.\r\u001b[7C\u001b[1B\u001b[2m3\u001b[22G\u001b[22mre\u001b[25Goa\u001b[28Ged when\u001b[36Gits mod\u001b[44Gle changes.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 65 -\u001b[38;2;248;248;242m**Why.** A script sees the world only through the events it is given and an option's inputs: enough    \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m6\u001b[11G\u001b[38;2;248;248;242mfor a handler that r\u001b[32Gac\u001b[35Gs,\u001b[38Gn\u001b[40Gt for one that looks\u001b[61Garound. Reload is what\u001b[85G m\u001b[88Gdder needs to write   \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m7\u001b[11G\u001b[38;2;248;248;242msc\u001b[14Gipts quickly.  \u001b[30G       \u001b[38G   \u001b[42G   \u001b[46G   \u001b[50G    \u001b[55G     \u001b[61G       \u001b[69G      \u001b[76G  \u001b[79G    \u001b[84G \u001b[86G      \u001b[93G     \u001b[99G  \u001b[102G     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 65 +\u001b[38;2;248;248;242m**Why.** A tree's task is where an NPC's script would act, and reload is what a modder needs to        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242mwrite scrip\u001b[23Gs quickly.\u001b[34G  \u001b[37G     \u001b[43G  \u001b[46G     \u001b[52G      \u001b[59G     \u001b[65G    \u001b[70G   \u001b[74G      \u001b[81G  \u001b[84G    \u001b[89G \u001b[91G      \u001b[98G     \u001b[104G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 67 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m8\u001b[11G\u001b[22m**What\u001b[18Gexists.**\u001b[28GWAMR's\u001b[35Ginterpreter,\u001b[48Gbounded\u001b[56Gby\u001b[59Gfuel\u001b[64Gand\u001b[68Gby\u001b[71Ga\u001b[73Gwall-time\r\u001b[7C\u001b[1B\u001b[2m9\u001b[11G\u001b[22m[\u001b[38;2;230;219;116mwatchdog\u001b[39m](glossary.md#watchdog) (`script/ScriptHost.h`). A\u001b[71Gscript is granted\u001b[89G`log`,\u001b[96G`store`\u001b[104Gand\u001b[108Gone\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m7\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gbuild,\u001b[14Gsuites,\u001b[22Gtidy\u001b[27Gand\u001b[31Glinks\u001b[37Gare\u001b[41Gall\u001b[45Gclean.\u001b[52GI'm\u001b[56Gfixing\u001b[63Gthe\u001b[67Gblank\u001b[73Glines\u001b[79Gin\u001b[82G\u001b[38;2;177;185;249mScriptHost.cpp\u001b[97G\u001b[39mand\u001b[101Gcommitting\u001b[112Gpart\u001b[117G2.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/jettison.lane-c'\u001b[52G&&\u001b[55Gpytho…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && python3 scripts/space-declarations.py\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
