[0.054, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m7\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWill there be a way to skip picking on static objects?\u001b[39m                                                                \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm\u001b[7Gadding\u001b[14Gan\u001b[17Goption\u001b[24Gto\u001b[27Gthe\u001b[31Gpicker\u001b[38Gthat\u001b[43Gexcludes\u001b[52Gstatic\u001b[59Gbodies,\u001b[67Gwith\u001b[72Ga\u001b[74Gmatching\u001b[83Gflag\u001b[88Gon\u001b[91GPickSpace\u001b[101Gso\u001b[104Gclick\u001b[110Gand\u001b[114Ghover\r\u001b[1B  can be set separately, and static bodies stay included by default. I'm checking the rest of Body and PickSpace first.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPickOptions gets \u001b[38;2;177;185;249mignore\u001b[39m, \u001b[38;2;177;185;249mstatics\u001b[39m and \u001b[38;2;177;185;249msensors\u001b[39m,\u001b[49GPi\u001b[52GkSpace gains a \u001b[38;2;177;185;249mstatics\u001b[39m flag, and the picker now\u001b[100Gbuilds its own Jol\u001b[119G\u001b[K\r\u001b[2C\u001b[1Bshapes from\u001b[15Gthe\u001b[19Gdefinitions\u001b[31Gthe\u001b[35Gphysics\u001b[43Gworld\u001b[49Gkeeps.\u001b[38;2;153;153;153m · summary\r\u001b[10C\u001b[2B\u001b[39mcd '/home/iv\u001b[25G/projects/jettison.lane-c'\u001b[52G&&\u001b[55G./scr…\r\u001b[42C\u001b[4B\u001b[38;2;153;153;153mthought for 9s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
