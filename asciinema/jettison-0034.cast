[0.091, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, remov\u001b[27Gd \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 250 \u001b[22m it, loads the script again by the same checks. A script loaded again keeps its keys and makes its\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 251 \u001b[22m handlers' instance afresh, so what a handler counted in memory is gone, and its inputs and tasks\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 252 \u001b[22m answer from the new module from then on; a run that reloads is not one a replay repeats. A module\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 253 -\u001b[38;2;248;248;242mthat no longer loads leaves the script loaded before it running, logged\u001b[48;2;92;2;0m, and is not tried again\u001b[48;2;61;1;0m       \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 254 -\u001b[38;2;248;248;242muntil the file changes again. The shell looks every 500 ms where it hot-reloads its resources, and    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 253 +\u001b[38;2;248;248;242mthat no longer loads\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mcannot be read or has gone \u001b[48;2;2;40;0mleaves the script loaded before it running, logged   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 254 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0monce, and is not tried again \u001b[48;2;2;40;0muntil the file changes again. The shell looks every 500 ms where it hot-r\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242meloads its resources, and                                                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 255 \u001b[12G\u001b[22mnever\u001b[18Gin\u001b[21Ga\u001b[23Grun\u001b[27Gwith\u001b[32G`--frame-step`\u001b[47G(the\u001b[52Gframe\u001b[58Gsystem\u001b[65G`scripts.reload`).\r\u001b[2C\u001b[1B   \u001b[2m 256 \u001b[22m\u001b[K\r\u001b[1B     