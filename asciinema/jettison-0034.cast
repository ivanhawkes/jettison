[0.063, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 62 \u001b[22m - A script reloaded when its module changes.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m**Why.**\u001b[20GA\u001b[22Gtree's\u001b[29Gtask\u001b[34Gis\u001b[37Gwhere\u001b[43Gan\u001b[46GNPC's\u001b[52Gscript\u001b[59Gwould\u001b[65Gact,\u001b[70Gand\u001b[74Greload\u001b[81Gis\u001b[84Gwhat\u001b[89Ga\u001b[91Gmodder\u001b[98Gneeds\u001b[104Gto\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m2\u001b[22m \u001b[31Gi\u001b[34Gs\u001b[K\r\u001b[1B     \u001b[2m 61 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m-\u001b[13GA\u001b[15Gscript\u001b[22Greloaded\u001b[31Gwhen\u001b[36Gits\u001b[40Gmodule\u001b[47Gchanges.\r\u001b[7C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 64 -\u001b[38;2;248;248;242m**Why.** A tree's task is where an NPC's script would act, and reload is what a modder needs to        \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m5\u001b[11G\u001b[38;2;248;248;242mwrite scrip\u001b[23Gs quickly.\u001b[34G  \u001b[37G     \u001b[43G  \u001b[46G     \u001b[52G      \u001b[59G     \u001b[65G    \u001b[70G   \u001b[74G      \u001b[81G  \u001b[84G    \u001b[89G \u001b[91G      \u001b[98G     \u001b[104G  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 64 +\u001b[38;2;248;248;242m**Why.** Reload is what a modder needs to write scripts quickly.                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 65 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22m**What\u001b[18Gexists.**\u001b[28GWAMR's\u001b[35Ginterpreter,\u001b[48Gbounded\u001b[56Gby\u001b[59Gfuel\u001b[64Gand\u001b[68Gby\u001b[71Ga\u001b[73Gwall-time\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m[\u001b[38;2;230;219;116mwatchdog\u001b[39m](glossary.md#watchdog) (`script/ScriptHost.h`). A\u001b[71Gscript is granted\u001b[89G`log`,\u001b[96G`store`\u001b[104Gand\u001b[108Gone\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Everything passes. I'm committing part 3.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
