[0.284, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 63 \u001b[22m - **The profilers** ([\u001b[38;2;230;219;116mprofiling\u001b[39m](#profiling)).\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22mA\u001b[13Gtree\u001b[18Gconfigured\u001b[29Gwithout\u001b[37Gthe\u001b[41Gscripts'\u001b[50Gcompilers\u001b[60Gbuilds\u001b[67Geverything\u001b[78Gbut\u001b[82Gthe\u001b[86Gscripts,\u001b[95Gwhose\u001b[101Gtargets\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+9\u001b[38;2;153;153;153m, committed \u001b[1m24218da\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mwamrc\u001b[9G\u001b[39mnow\u001b[13Gworks\u001b[19Gin\u001b[22Gthe\u001b[26Gdevenv.\u001b[34GThe\u001b[38Gpackage\u001b[46Gis\u001b[49Gbuilt\u001b[55Gand\u001b[59Gcommitted\u001b[69Gon\u001b[72Glane\u001b[77GC's\u001b[81GJ04\u001b[85Gbranch\u001b[92Gas\u001b[95G\u001b[38;2;177;185;249m24218da\u001b[39m,\u001b[104Gbut\u001b[108Git\u001b[111Gisn't\r\u001b[1B \u001b[3Gmerged yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat I did:\u001b[17G\u001b[22mnixpkgs\u001b[25Gonly\u001b[30Gpackages\u001b[39GWAMR's\u001b[46Gruntime,\u001b[55Gso\u001b[58Gthe\u001b[62Gnew\u001b[66G\u001b[38;2;177;185;249mnix/wamrc.nix\u001b[80G\u001b[39mbuilds\u001b[87G\u001b[38;2;177;185;249mwamrc\u001b[93G\u001b[39mfrom\u001b[98GWAMR\u001b[103G2.4.5,\u001b[110Gthe\u001b[114Grelease\r\u001b[2C\u001b[1B \u001b[5Gthe engine already pi\u001b[27Gs,\u001b[30Gagainst LLV\u001b[42G 18. LLVM 18\u001b[55Gis\u001b[62Gr\u001b[64Glease WAMR tests \u001b[38;2;177;185;249mwamrc\u001b[87G\u001b[39mwith,\u001b[93Gand nixpkgs' binary cach\u001b[118G\u001b[K\r\u001b[4C\u001b[1Bhas\u001b[9Git, so\u001b[16Gthe build takes \u001b[33Gbou\u001b[38G90 seconds. \u001b[38;2;177;185;249mdevenv.nix\u001b[39m adds th\u001b[70Gpackag\u001b[77G, and \u001b[38;2;177;185;249mdo\u001b[86Gs/build-and-gates.md\u001b[39m notes\u001b[113Gthat the\r\u001b[4C\u001b[1Btwo\u001b[9GWAMR pins have to move\u001b[32Gtoge\u001b[37Gher.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fr\u001b[39Gsh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[39m to a 2 KB \u001b[38;2;177;185;249m.aot\u001b[39m file.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[17G\u001b[22my\u001b[19Gur\u001b[22Gcurrent shel\u001b[35G won't\u001b[42Gsee\u001b[46Git\u001b[49Guntil\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[2C\u001b[1B \u001b[5Gthere (\u001b[38;2;177;185;249mdirenv reload\u001b[39m, or\u001b[30Gre-enter \u001b[38;2;177;185;249mdevenv s\u001b[76G\u001b[39m\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
