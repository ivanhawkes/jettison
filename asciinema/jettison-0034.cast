[0.060, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm\u001b[7Gchecking\u001b[16Gwhether\u001b[24Gflying\u001b[31Gthe\u001b[35Gcovered\u001b[43Gway\u001b[47Gin\u001b[50Gas\u001b[53Ga\u001b[55Gcorridor\u001b[64Gfixes\u001b[70Gthe\u001b[74Gstall.\u001b[81GThe\u001b[85Gvehicle\u001b[93Govershoots\u001b[104Gits\u001b[108Gfirst\r\u001b[2C\u001b[1Bwaypoint\u001b[12Gdownwards\u001b[22Gand\u001b[26Gends\u001b[31Gup\u001b[34Glevel\u001b[40Gwith\u001b[45Gthe\u001b[49Gdeck\u001b[54Gface,\u001b[60Gblocked.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/dock/src/Docks.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mlin\u001b[18G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m8\u001b[28G\u001b[22moffset = {\u001b[38;2;190;132;255m0.0\u001b[39m, *covered, \u001b[38;2;190;132;255m0.0\u001b[39m};\r\u001b[7C\u001b[1B\u001b[2m39\u001b[28G\u001b[22mwaypointsOnEntity\u001b[46G=\u001b[48G\u001b[38;2;190;132;255mtrue\u001b[39m;\r\u001b[5C\u001b[1B\u001b[2m 740 \u001b[22m     destination.byShape = \u001b[38;2;190;132;255mtrue\u001b[39m;\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 741 +\u001b[38;2;248;248;242m    destination.corridor = \u001b[38;2;190;132;255mtrue\u001b[38;2;248;248;242m;                                                                      \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m2\u001b[28G\u001b[22mspeed = kCoveredSpe\u001b[49G;\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[28G\u001b[22mpassR\u001b[34Gdius = kCoveredPass;\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 744 \u001b[16G\u001b[22mdestination.arrivalRadius\u001b[42G=\u001b[44GkCoveredRadius;\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFlying it as a corridor brings the vehicle over the berth, but then it never comes down, and it breaks the covered\u001b[K\r\u001b[2C\u001b[1Btest. I'm reverting that and looking\u001b[40Gat\u001b[43Gwhy\u001b[47Git\u001b[50Gstays\u001b[56Gover\u001b[61Gthe\u001b[65Gberth.\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mthought for 7s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
