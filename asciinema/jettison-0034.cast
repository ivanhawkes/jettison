[0.029, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m3\u001b[22m files, ran \u001b[1m7\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWill there be a way to skip picking on static objects?\u001b[39m                                                                \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm\u001b[7Gadding\u001b[14Gan option to the picker that excludes static bo\u001b[62Gies, with a\u001b[74Gmat\u001b[78Gh\u001b[83Gflag on PickSpace so\u001b[104Gclick \u001b[111Gnd\u001b[114Ghover\u001b[K\r\u001b[2C\u001b[1Bcan be set\u001b[14Gseparately,\u001b[26Gand\u001b[30Gstatic\u001b[37Gbodies\u001b[44Gstay\u001b[49Gincluded\u001b[58Gby\u001b[61Gdefault.\u001b[70GI'm\u001b[74Gchecking\u001b[83Gthe\u001b[87Grest\u001b[92Gof\u001b[95GBody\u001b[100Gand\u001b[104GPickSpace\u001b[114Gfirst.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPickOptions\u001b[15Ggets \u001b[38;2;177;185;249mignore\u001b[39m, \u001b[38;2;177;185;249mstatics\u001b[39m and \u001b[38;2;177;185;249msensors\u001b[39m,\u001b[49GPickSpace gains a\u001b[67G\u001b[38;2;177;185;249mstatics\u001b[75G\u001b[39mflag,\u001b[81Gand\u001b[85Gthe\u001b[89Gpicker\u001b[96Gnow\u001b[100Gbuilds\u001b[107Gits\u001b[111Gown\u001b[115GJolt\r\u001b[2C\u001b[1Bshapes\u001b[10Gfrom\u001b[15Gthe\u001b[19Gdefinitions\u001b[31Gthe\u001b[35Gphysics\u001b[43Gworld\u001b[49Gkeeps.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Writing ~/projects/jettison.lane-b/so