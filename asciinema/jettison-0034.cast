[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mwamrc\u001b[39m now works\u001b[19Gin\u001b[22Gthe\u001b[26Gdevenv.\u001b[34GThe\u001b[38Gpackage\u001b[46Gis\u001b[49Gbuilt\u001b[55Gand\u001b[59Gcommitted\u001b[69Gon\u001b[72Glane\u001b[77GC's\u001b[81GJ04\u001b[85Gbranch\u001b[92Gas\u001b[95G\u001b[38;2;177;185;249m24218da\u001b[39m,\u001b[104Gbut\u001b[108Git\u001b[111Gisn't\r\u001b[2C\u001b[1Bmerged\u001b[10Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat I did:\u001b[22m nixpkgs o\u001b[27Gly\u001b[30Gpackages WA\u001b[42GR's runtime,\u001b[55Gso\u001b[62Gn\u001b[64Gw \u001b[38;2;177;185;249mnix/wamrc.nix\u001b[39m builds\u001b[87G\u001b[38;2;177;185;249mwamrc\u001b[93G\u001b[39mfrom WAMR 2.4.5, the rel\u001b[118Gase\r\u001b[4C\u001b[1Bthe\u001b[9Gengine\u001b[16Galready pins, ag\u001b[33Gins\u001b[38GLLVM 18. LLVM 18 is the releas\u001b[70GWAMR t\u001b[77Gsts \u001b[38;2;177;185;249mwamr\u001b[86G\u001b[39m with, and nixpkgs' binary\u001b[113Gcache\u001b[K\r\u001b[4C\u001b[1Bhas\u001b[9Git, so the build takes\u001b[32Gabou\u001b[37G 90 seconds.\u001b[50G\u001b[38;2;177;185;249mdevenv.nix\u001b[61G\u001b[39madds\u001b[66Gthe\u001b[70Gpackage,\u001b[79Gand\u001b[83G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[107G\u001b[39mnotes\u001b[113Gthat\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gtwo WAMR pins have to move togeth\u001b[39Gr.\u001b[42G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[17G\u001b[39mt\u001b[19G a\u001b[22G2 KB \u001b[38;2;177;185;249m.aot\u001b[39m fi\u001b[35Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[22m your current\u001b[30Gshell won't see it until\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[4C\u001b[1Bthere\u001b[11G(\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor\u001b[30Gre-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts\u001b[32Gfuel only when \u001b[48Gt interprets a script. Its\u001b[75Gahead-of-tim\u001b[88G ru\u001b[92Gtime and compiler have no\u001b[K\r\u001b[2C\u001b[1Binstruction\u001b[15Gmetering at all, so compiled scripts would run with \u001b[68Go\u001b[70Gfu\u001b[73Gl limit, stopped on\u001b[93Gy by the 250 ms watchdog.\u001b[119G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHandlers:\u001b[22m these run \u001b[26Gutside\u001b[33Gthe\u001b[37Gstep,\u001b[43Gand\u001b[47Gthe\u001b[51Gcommands\u001b[60Gthey\u001b[65Gsend\u001b[70Gare\u001b[74Grecorded,\u001b[84Gso\u001b[87Gcompiled\u001b[96Ghandlers\u001b[105Gwould\u001b[111Gbe\u001b[114Gsafe\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Gfar as determinism goes.        \u001b[38G     \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
