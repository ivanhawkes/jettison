[0.002, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLane\u001b[8GC's\u001b[12Ggate\u001b[17Gholds\u001b[23Gthe\u001b[27Gbuild\u001b[33Glock.\u001b[39GAn\u001b[42Gincremental\u001b[54Gbuild\u001b[60Gof\u001b[63Gone\u001b[67Gtest\u001b[72Gtarget\u001b[79Gis\u001b[82Gallowed\u001b[90Galongside\u001b[100Ga\u001b[102Ggate,\u001b[108Gso\u001b[111GI'm\r\u001b[2C\u001b[1Bbuilding\u001b[12Gthe\u001b[16Gphysics\u001b[24Gtests\u001b[30Gdirectly,\u001b[40Gwithout\u001b[48G\u001b[38;2;177;185;249mheavy.sh\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ04's gate failed. The \u001b[38;2;177;185;249mscript\u001b[39m sui\u001b[39Gfails\u001b[45Gunder\u001b[51Gthe\u001b[55Gsanitisers,\u001b[67Gthough\u001b[74Git\u001b[77Gpasses\u001b[84Gin\u001b[87Gthe\u001b[91Gdebug\u001b[97Gand\u001b[101Grelease\u001b[109Gbuilds.\u001b[117GNext\r\u001b[2C\u001b[1BI'm\u001b[7Gfinding\u001b[15Gthe\u001b[19Gfailure\u001b[27Gin\u001b[30Gthe\u001b[34Ggate\u001b[39Glog.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe cause is that the sanitised\u001b[35Gbuild\u001b[41Gdoesn't\u001b[49Gbuild\u001b[55Gthe\u001b[59Gnew\u001b[63G\u001b[38;2;177;185;249mreads.wasm\u001b[74G\u001b[39mmodule.\u001b[82GI'm\u001b[86Gchecking\u001b[95Ghow\u001b[99G\u001b[38;2;177;185;249mci.sh\u001b[105G\u001b[39mpicks\u001b[111Gthe\r\u001b[2C\u001b[1Btargets\u001b[11Gfor\u001b[15Gthat\u001b[20Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mT\u001b[6G