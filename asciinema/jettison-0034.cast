[0.111, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[6C\u001b[1B\u001b[2m57\u001b[15G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m58\u001b[11G\u001b[22m- **Vulkan**:\u001b[25Gthe\u001b[29Gheaders,\u001b[38Gthe\u001b[42Gloader,\u001b[50Gthe\u001b[54Gvalidation\u001b[65Glayers\u001b[72Gand\u001b[76G`glslc`.\r\u001b[5C\u001b[1B\u001b[2m 59 \u001b[22m - **The scripts' compilers**: lld's `wasm-ld`, which links every script; clang for scripts in C;\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 60 -\u001b[38;2;248;248;242m  rustc for scripts in Rust, with the `wasm32-unknown-unknown` library nixpkgs ships with it\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 60 +\u001b[38;2;248;248;242m  rustc for scripts in Rust, with the `wasm32-unknown-unknown` library nixpkgs ships with it\u001b[48;2;4;71;0m; and\u001b[48;2;2;40;0m      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 61 +\u001b[38;2;248;248;242m  WAMR's ahead-of-time compiler, `wamrc`, built by `nix/wamrc.nix` from WAMR's release above           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 62 +\u001b[38;2;248;248;242m  against LLVM 18, since nixpkgs' `wamr` builds only the runtime. The two releases move together.      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[2m 63 \u001b[22m - **The profilers**\u001b[31G([\u001b[38;2;230;219;116mprofiling\u001b[39m](#profiling)).\r\u001b[5C\u001b[1B\u001b[2m 64 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 65 \u001b[22m A tree configured without the scripts' compilers builds everything but the scripts, whose targets\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mMaking\u001b[10G\u001b[1m1\u001b[12G\u001b[22mscratchpad\u001b[23Gedit\u001b[28G\u001b[38;2;56;166;96m+9\u001b[39m,\u001b[32Gcommitted\u001b[42G\u001b[1m24218da\u001b[22m,\u001b[51Grunning\u001b[59G\u001b[1m2\u001b[61G\u001b[22mshell\u001b[67Gcommands…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && git commit -F \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m'/tmp/claude-1\u001b[22G0/-home-ivan-projects-je\u001b[47Gtison/414e2912-7de0-46ef-\u001b[73Gba3-9\u001b[79G21\u001b[82G2ec86c7/scratchpad/msg-wamrc.txt'\r\u001b[23C\u001b[2B3\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m2\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
