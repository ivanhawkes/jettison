[0.608, "o", "\u001b[?25l\u001b[H\u001b[5Gthey\u001b[10Gleave.\r\u001b[2C\u001b[1B- \u001b[1mA task's halt:\u001b[22m \u001b[21G running task is\u001b[38Gt\u001b[40Gld wh\u001b[46Gn\u001b[48Git is stopped, so it can\u001b[73Glet\u001b[77Ggo of what it\u001b[91Gholds.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mParallel:\u001b[22m runs its children togeth\u001b[40Gr until\u001b[48Ga\u001b[50Gset\u001b[54Gnumber\u001b[61Gsucceed,\u001b[70Gor\u001b[73Gthat\u001b[78Gnumber\u001b[85Gcan't\u001b[91Gbe\u001b[94Greached.\u001b[103GIt\u001b[106Gtakes\u001b[112Gat\u001b[115Gmost\r\u001b[4C\u001b[1B32\u001b[8Gchildren.\r\u001b[2C\u001b[1B- \u001b[1mSubtrees:\u001b[22m a node can name a tree defined\u001b[46Gearlier,\u001b[55Gso\u001b[58Ga\u001b[60Grepeated\u001b[69Gloop\u001b[74Gis\u001b[77Gwritten\u001b[85Gonce.\r\u001b[4C\u001b[1B\u001b[1mA blackboard:\u001b[22m a saved per-entity memory of integers and entities by key, kept wh\u001b[86Gn \u001b[89Ghe entity's tree changes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA command that gives an entity a tree:\u001b[44G\u001b[22m\u001b[38;2;177;185;249mAssignBehaviour\u001b[39m.\u001b[61GIts\u001b[65Gnew\u001b[69Grefusal\u001b[77Greason,\u001b[85G\u001b[38;2;177;185;249mno_such_tree\u001b[39m,\u001b[99Ghas\u001b[103GEnglish\u001b[111Gand\u001b[115GGerman\r\u001b[2C\u001b[1B \u001b[5Gwording.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA tree ticked less often:\u001b[22m a d\u001b[35Gfinition\u001b[44Gcan set an interval. Entities using\u001b[80Git\u001b[83Gare\u001b[87Gspread\u001b[94Gacross\u001b[101Gthe\u001b[105Ginterval,\u001b[115Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gsteps\u001b[15Gbetween\u001b[23Gare\u001b[27Gskipped.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Galready\u001b[19Gsaved\u001b[25Gchanges,\u001b[34Gand\u001b[38Gno\u001b[41Gpinned\u001b[48Ghash\u001b[53Gmoved.\u001b[60GEach\u001b[65Gfeature\u001b[73Ghas\u001b[77Ga\u001b[79Gtest\u001b[84Gin\u001b[87Gthe\u001b[91G\u001b[38;2;177;185;249mai\u001b[94G\u001b[39msuite.\u001b[101GThe\u001b[105Gdocs,\u001b[111Gdecisions,\r\u001b[2C\u001b[1Bscope, roadmap\u001b[18Gand history are updated.\u001b[43G\u001b[K\r\u001b[2B \u001b[3GThree behaviour changes to know about:\r\u001b[2C\u001b[1B-\u001b[5GTaking\u001b[12Ga\u001b[14Gvehicle's\u001b[24Ghelm\u001b[29Gnow\u001b[33Gstops\u001b[39Gits\u001b[43Grunning\u001b[51Gtask\u001b[56Gthrough\u001b[64Gthe\u001b[68Ghalt,\u001b[74Gwhere\u001b[80Gbefore\u001b[87Git\u001b[90Gwas\u001b[94Gleft\u001b[99Gunfinished\u001b[110Gwithout\r\u001b[1B    notice.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWhile\u001b[11Ga\u001b[13Greactive\u001b[22Gnode\u001b[27Gis\u001b[30Grunning,\u001b[39Gits\u001b[43Gtree\u001b[48Gis\u001b[51Gticked\u001b[58Gevery\u001b[64Gstep,\u001b[70Gso\u001b[73Gthe\u001b[77Gworld\u001b[83Gcan't\u001b[89Gskip\u001b[94Gahead\u001b[100Gover\u001b[105Gthose\u001b[111Gsteps.\r\u001b[1B  - A tree with an interval notices a wait ending up to one interval late.\u001b[K\r\u001b[2B \u001b[3GI didn't run a Codex cross-review\u001b[37Gon\u001b[40GJ35,\u001b[45GJ10\u001b[49Gor\u001b[52GJ03;\u001b[57Gyour\u001b[62Grule\u001b[67Gkeeps\u001b[73Gthose\u001b[79Gfor\u001b[83Gthe\u001b[87Gend\u001b[91Gof\u001b[94Ga\u001b[96Gstage.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
