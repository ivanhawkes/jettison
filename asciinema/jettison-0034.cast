[0.027, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 65 -\u001b[38;2;248;248;242mwrite scripts quickly.                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 64 +\u001b[38;2;248;248;242m**Why.** Reload is what a modder needs to write scripts quickly.                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 65 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[22m **What exists.** WAMR's interpreter, bounded by fuel and by a wall-time\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m[\u001b[38;2;230;219;116mwatchdog\u001b[39m](glossary.md#watchdog)\u001b[44G(`script/ScriptHost.h`).\u001b[69GA\u001b[71Gscript\u001b[78Gis\u001b[81Ggranted\u001b[89G`log`,\u001b[96G`store`\u001b[104Gand\u001b[108Gone\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything passes. I'm\u001b[26Gcommitting\u001b[37Gpart\u001b[42G3.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+17\u001b[38;2;153;153;153m, committed \u001b[1m6d645ac\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPart 3 is committed, and since J05 changed the file system change-stamp\u001b[75Gcode\u001b[80Gthat\u001b[85GPart\u001b[90G4\u001b[92Gdepends\u001b[100Gon,\u001b[104GI'm\u001b[108Grebasing\u001b[117Glane\r\u001b[2C\u001b[1BC\u001b[5Gonto\u001b[10G\u001b[38;2;177;185;249mfeature-base\u001b[23G\u001b[39mbefore\u001b[30Gstarting\u001b[39GPart\u001b[44G4.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRebased onto \u001b[1mfeature-base\u001b[22m,\u001b[30Grunning \u001b[1m4\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && rg -n \"m_pResources->Update|hotReload|kReloadPeriod|CheckForChanges\" \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153msource/engine/app/src/Application.cpp source/engine/resource/src/ResourceManager.cpp \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153msource\u001b[13Gengine/resourc\u001b[28G/include/jettison/resource/ResourceManag\u001b[69Gr.h\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
