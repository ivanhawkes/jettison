[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242manywh\u001b[17Gre.\u001b[21GThe docks give it the v\u001b[45Ghicle's resting height and half i\u001b[79Gs hov\u001b[85Gr, short\u001b[94Gof where any\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242mpoint over a\u001b[24Gberth is,\u001b[34Gso a v\u001b[41Ghicle under a\u001b[55Glow roof\u001b[64Gstill\u001b[70Ggoes out leve\u001b[84G.   \u001b[89G                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 85 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 86 \u001b[22m A sphere or a box that moves while a vehicle flies the course stays where it was in the graph, so a\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22mcaller\u001b[18Gplots\u001b[24Gagain\u001b[30Gas\u001b[33Gthe\u001b[37Gvehicle\u001b[45Ggoes,\u001b[51Gor\u001b[54Gmakes\u001b[60Gthe\u001b[64Gcourse\u001b[71Gin\u001b[74Gan\u001b[77Gentity's\u001b[86Gaxes\u001b[91G(below).\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDeparting from under\u001b[24Gthe\u001b[28Glow\u001b[32Groof\u001b[37Gnow\u001b[41Gworks.\u001b[48GFlying\u001b[55Gin\u001b[58Gdoesn't\u001b[66Gdock\u001b[71Gyet,\u001b[76Gand\u001b[80Ga\u001b[82Gphysics\u001b[90Gtest\u001b[95Gfails.\u001b[102GLooking\u001b[110Gat\u001b[113Gboth.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWorking…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
