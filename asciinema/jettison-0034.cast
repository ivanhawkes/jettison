selector:\u001b[22m they check what comes\u001b[59Gbefore\u001b[66Ga\u001b[68Grunning\u001b[76Gbranch\u001b[83Gon\u001b[86Gevery\u001b[92Gtick,\u001b[98Gand\u001b[102Gstop\u001b[107Gthe\u001b[111Gbranch\r\u001b[2C\u001b[1B \u001b[5Gthey leave.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA task's halt:\u001b[20G\u001b[22ma\u001b[22Grunning\u001b[30Gtask\u001b[35Gis\u001b[38Gtold\u001b[43Gwhen\u001b[48Git\u001b[51Gis\u001b[54Gstopped,\u001b[63Gso\u001b[66Git\u001b[69Gcan\u001b[73Glet\u001b[77Ggo\u001b[80Gof\u001b[83Gwhat\u001b[88Git\u001b[91Gholds.\r\u001b[4C\u001b[1B\u001b[1mPar\u001b[9Gllel:\u001b[22m runs\u001b[20Gits ch\u001b[27Gldren together until\u001b[48Ga set\u001b[54Gnumber succeed, or\u001b[73Gthat number can'\u001b[91Gbe reached.\u001b[103GIt\u001b[106Gtakes\u001b[112Gat\u001b[115Gmost\r\u001b[2C\u001b[1B \u001b[5G32 children.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSubtrees:\u001b[22m a node\u001b[22Gcan\u001b[26Gname\u001b[31Ga\u001b[33Gtree\u001b[38Gdefined\u001b[46Gearlier,\u001b[55Gso\u001b[58Ga\u001b[60Grepeated\u001b[69Gloop\u001b[74Gis\u001b[77Gwritten\u001b[85Gonce.\r\u001b[4C\u001b[1B\u001b[1mA \u001b[8Glackboard:\u001b[22m a saved per-en\u001b[34Gity\u001b[38Gm\u001b[40Gmory of int\u001b[52Gger\u001b[56G and \u001b[62Gnti\u001b[66Gies by key, kep\u001b[82G whe\u001b[87G the\u001b[92Gentity's\u001b[101Gtree\u001b[106Gchanges.\r\u001b[6C\u001b[1B\u001b[1mcommand that gives an entity a tree:\u001b[22m \u001b[38;2;177;185;249mAssignBehaviour\u001b[39m.\u001b[61GIts new refusal reason, \u001b[38;2;177;185;249mno_such_tree\u001b[39m, has English and\u001b[115GGerman\r\u001b[2C\u001b[1B \u001b[5Gwording.                              \u001b[44G   \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
