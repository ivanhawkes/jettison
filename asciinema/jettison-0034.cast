t,\u001b[79Gand\u001b[83Gare\u001b[87Gfor\u001b[91Gthe\u001b[95Gsimulation's\r\u001b[1B \u001b[3G   \u001b[2m 188 \u001b[22m systems to call. Ste\u001b[33Gring sweeps a vehicle\u001b[55Gs\u001b[57Gshape wi\u001b[67G `CastShape`\u001b[80G([\u001b[38;2;230;219;116mAI\u001b[39m](ai.md)).\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 189 \u001b[12G\u001b[22m\u001b[K\r\u001b[3C\u001b[2Bunn\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell command…\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ cd '/home/ivan/projects/jettison.lane-b' && lychee --offline docs\r\u001b[18C\u001b[8B(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
