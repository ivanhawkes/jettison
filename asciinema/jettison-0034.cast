[0.080, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[17G\u001b[39mt\u001b[19G a\u001b[22G2 KB \u001b[38;2;177;185;249m.aot\u001b[39m fi\u001b[35Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[22m your current\u001b[30Gshell won't see it until\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[4C\u001b[1Bthere\u001b[11G(\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor\u001b[30Gre-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts\u001b[32Gfuel only when \u001b[48Gt interprets a script. Its\u001b[75Gahead-of-tim\u001b[88G ru\u001b[92Gtime and compiler have no\u001b[K\r\u001b[2C\u001b[1Binstruction\u001b[15Gmetering at all, so compiled scripts would run with \u001b[68Go\u001b[70Gfu\u001b[73Gl limit, stopped on\u001b[93Gy by the 250 ms watchdog.\u001b[119G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHandlers:\u001b[22m these run \u001b[26Gutside\u001b[33Gthe\u001b[37Gstep,\u001b[43Gand\u001b[47Gthe\u001b[51Gcommands\u001b[60Gthey\u001b[65Gsend\u001b[70Gare\u001b[74Grecorded,\u001b[84Gso\u001b[87Gcompiled\u001b[96Ghandlers\u001b[105Gwould\u001b[111Gbe\u001b[114Gsafe\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Gfar as determinism goes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInputs and behaviour-tree tasks:\u001b[22m these run inside\u001b[55Gthe\u001b[59Gstep.\u001b[65GThe\u001b[69Gfuel\u001b[74Glimit\u001b[80Gis\u001b[83Gwhat\u001b[88Gkeeps\u001b[94Gtheir\u001b[100Gresult\u001b[107Gthe\u001b[111Gsame\u001b[116Gon\r\u001b[4C\u001b[1Bevery\u001b[11Gmachine,\u001b[20Gso\u001b[23Gthey\u001b[28Ghave\u001b[33Gto\u001b[36Gstay\u001b[41Ginterpreted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision for you: do I build ahead-of-tim\u001b[45G compilati\u001b[56Gn f\u001b[60Gr handlers o\u001b[73Gly as \u001b[80Gart of J04, or drop\u001b[100Git? I'd drop it for\r\u001b[2C\u001b[1Bnow:\u001b[8Ga handler call costs\u001b[29G0.27\u001b[34Gµs\u001b[37Ginterpreted,\u001b[50Gand\u001b[54Gno\u001b[57Gprofile\u001b[65Ghas\u001b[69Gfound\u001b[75Gscripts\u001b[83Gslow.\u001b[89GEither\u001b[96Gway\u001b[100G\u001b[38;2;177;185;249mwamrc\u001b[106G\u001b[39mstays\u001b[112Gon\u001b[115Gthe\r\u001b[2C\u001b[1Bpath\u001b[8Gfor\u001b[12Gwhen\u001b[17Gone\u001b[21Gdoes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJ04's\u001b[9Gother\u001b[15Gparts\u001b[21Garen't\u001b[28Gaffected.\u001b[38GLane\u001b[43GB's\u001b[47GJ05\u001b[51Gis\u001b[54Gstill\u001b[60Grunning\u001b[68Gin\u001b[71Gthe\u001b[75Gbackground.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Work out how to get wamrc working in the devenv and on the path\u001b[39m                                                       \r\u001b[46C\u001b[17B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
