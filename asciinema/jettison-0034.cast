[0.115, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 218 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// task that calls Task.\u001b[38;2;248;248;242m                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 219 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::\u001b[38;2;166;226;46mvector\u001b[38;2;248;248;242m<\u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::\u001b[38;2;166;226;46mstring\u001b[38;2;248;248;242m> \u001b[38;2;166;226;46mTasks\u001b[38;2;253;151;31m()\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m;                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 220 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 221 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Ticks a tree's task that a script answers. The tick is inside the step, so it is held to the\u001b[38;2;248;248;242m     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 222 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// simulation's rules as an input is: it starts from the module as it was instantiated, and what\u001b[38;2;248;248;242m    \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 223 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// it keeps is the memory the tree saves. Its commands are applied at once\u001b[38;2;248;248;242m                          \u001b[39m\u001b[49m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 224 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// (Sim::SimWorld::Apply), as a tree's task's are, each Sim::Controller in them the call's\u001b[38;2;248;248;242m          \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 225 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// sender; it may ask the game for inputs, and may not store, load or read. Failure for a tick\u001b[38;2;248;248;242m      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 226 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// that trapped or a script stopped, the memory then as it was. Throws std::invalid_argument for\u001b[38;2;248;248;242m    \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 227 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// a task no script answers.\u001b[38;2;248;248;242m                                                                        \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 228 +\u001b[38;2;248;248;242m  TaskStatus \u001b[38;2;166;226;46mTask\u001b[38;2;253;151;31m(\u001b[38;2;166;226;46mstd\u001b[38;2;253;151;31m::string_view task, TaskCall &call)\u001b[38;2;248;248;242m;                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 229 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 230 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Tells a task a script answers that its tree has left it running (Ai::TaskHalt), so it can let\u001b[38;2;248;248;242m    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 231 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// go of what it holds, by its halt, if its script exports one; as Task, its status unread.\u001b[38;2;248;248;242m         \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 232 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mvoid\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mHaltTask\u001b[38;2;253;151;31m(\u001b[38;2;166;226;46mstd\u001b[38;2;253;151;31m::string_view task, TaskCall &call)\u001b[38;2;248;248;242m;                                               \u001b[115G\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 233 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 234 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// Calls an export taking and returning i32s, under the script's limits: the console's and the\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 235 \u001b[22m   \u001b[38;2;117;113;94m// tests' way in. Nothing when the call trapped, the reason logged; throws std::invalid_argument\r\u001b[1B\u001b[39m     \u001b[2m 236 \u001b[22m   \u001b[38;2;117;113;94m// for a script not loaded or a function it does not export with that many i32s.\r\u001b[18C\u001b[8B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?"]
