[0.409, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m li\u001b[17Ges, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 58 \u001b[11G\u001b[22mFrom\u001b[16Gthe\u001b[20Gsame\u001b[25Glayouts\u001b[33Gthe\u001b[37Ghost\u001b[42Gwrites\u001b[49Gthe\u001b[53Gbindings\u001b[62Ga\u001b[64Gscript\u001b[71Gis\u001b[74Gcompiled\u001b[83Gagainst,\u001b[92Ga\u001b[94GC\u001b[96Gheader\r\u001b[1B \u001b[3G   \u001b[2m 59 \u001b[22m (`jettison_scr\u001b[26Gpt.h`) and a Rust module (`jettison_script.rs`),\u001b[75Geach\u001b[80Gasserting\u001b[90Gevery\u001b[96Gstruct's\u001b[105Gsize\r\u001b[1B     \u001b[2m 60 \u001b[22m and ev\u001b[18Gry\u001b[21Gfield's\u001b[29Goffset,\u001b[37Gso\u001b[40Ga\u001b[42Gscript\u001b[49Gbuilt\u001b[55Gagainst\u001b[63Ganother\u001b[71Gbuild's\u001b[79Gtypes\u001b[85Gfails\u001b[91Gto\u001b[94Gcompile\u001b[102Grather\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 61 -\u001b[38;2;248;248;242mthan misread memory.                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 61 +\u001b[38;2;248;248;242mthan misread memory. In Rust a string, an array and a struct that holds either carry the lifetime      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 62 +\u001b[38;2;248;248;242mof the memory they point into, `'a`, with their pointer and count private: made from a `&str` or a     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 63 +\u001b[38;2;248;248;242mslice, or from a raw pointer only in `unsafe` (`jettison_string::from_raw`).                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 64 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 65 \u001b[22m Every pointer and count a script hands back is checked against its memory's bounds, and every bool\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[22m and enumerator against its legal values. Only bytes cross the boundary.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/pr\u001b[15Gj\u001b[17Gcts/j\u001b[23Gt\u001b[25Gison.lane-b/docs/scripts.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m1\u001b[22m li\u001b[34Ge\u001b[K\r\u001b[7C\u001b[1B\u001b[2m1\u001b[12G\u001b[22mte\u001b[15G's state ([\u001b[38;2;230;219;116mwhy\u001b[39m](deci\u001b[36Gions.m\u001b[43G#scripts)). A\u001b[58Gcript granted `read:<Component>`\u001b[91Gimpor\u001b[97Gs\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 92 \u001b[11G\u001b[22m`jettison_read_<Component>`,\u001b[40Gwhich\u001b[46Gtakes\u001b[52Gan\u001b[55Gentity\u001b[62Gand\u001b[66Greturns\u001b[74Gits\u001b[78Gcopy\u001b[83Gof\u001b[86Gthe\u001b[90Gcomponent\u001b[100Gas\u001b[103Gthe\r\u001b[2C\u001b[1B   \u001b[2m 93 \u001b[22m snapshot has it,\u001b[28Gor\u001b[31Gnull\u001b[36Gfor\u001b[40Gan\u001b[43Gentity\u001b[50Gwith\u001b[55Gnone\u001b[60Gthere;\u001b[67Gin\u001b[70GRust,\u001b[76G`read_<Component>(entity,\u001b[102Gf)`\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 94 -\u001b[38;2;248;248;242mgives the copy to `f` and returns what `f` answers, so safe code \u001b[48;2;92;2;0mcannot\u001b[48;2;61;1;0m keep\u001b[48;2;92;2;0m a reference to it. The com\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mponent\u001b[48;2;61;1;0m                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 94 +\u001b[38;2;248;248;242mgives the copy to `f` \u001b[48;2;4;71;0mfor any lifeti\u001b[76G\u001b[48;2;2;40;0m` answers, so safe code \u001b[48;2;4;71;0mcan\u001b[48;2;2;40;0m keep      \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
