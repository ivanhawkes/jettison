[5G\u001b[1mNothing new is saved.\u001b[22m The ru\u001b[35Gs \u001b[38Gre start-up, \u001b[52Go\u001b[54G sta\u001b[60G; what\u001b[67Gver\u001b[71Ga rule\u001b[78Greads\u001b[84Gis\u001b[87Gthe\u001b[91Ggame's\u001b[98Gown\u001b[102Gsaved\u001b[108Gcomponents.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWith no rules set\u001b[22m, the docks\u001b[34Gbehav\u001b[40G exactly\u001b[49Gas to\u001b[55Gay\u001b[58G(first come,\u001b[71Gfirst\u001b[77Gserved),\u001b[86Gso\u001b[89Gthe\u001b[93Gexisting\u001b[102Gdock\u001b[107Gtests\u001b[113Gand\r\u001b[4C\u001b[1Bpinned hashes\u001b[19Gdon't\u001b[25Gmove.\u001b[31G\u001b[38;2;177;185;249mDocks::Park\u001b[43G\u001b[39mskips\u001b[49Gboth\u001b[54Ghooks.\r\u001b[1B  - \u001b[1mProof:\u001b[22m a dock test that refuses one vehicle with its own reason and moves a later arrival up the queue. Then\u001b[114Gthe\r\u001b[4C\u001b[1Bdocs (\u001b[38;2;177;185;249mdocks.md\u001b[39m),\u001b[22Gthe\u001b[26Groadmap\u001b[34Grow\u001b[38Gmoved\u001b[44Gto\u001b[47Ghistory,\u001b[56Gand\u001b[60Gthe\u001b[64Ggate.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot doing:\u001b[16G\u001b[22mchecking\u001b[25Ga\u001b[27Gqueued\u001b[34Gvehicle\u001b[42Gagain\u001b[48Gwhen\u001b[53Gthe\u001b[57Ggame's\u001b[64Gstate\u001b[70Gchanges\u001b[78Gafter\u001b[84Gits\u001b[88Grequest,\u001b[97Gand\u001b[101Gletting\u001b[109Gthe\u001b[113Ggame\r\u001b[1B \u001b[3G  choose which ber\u001b[22Gh a vehicle gets. L04 ask\u001b[48G for\u001b[53Gneith\u001b[59Gr. A booki\u001b[70Gg accept\u001b[79Gd before a policy\u001b[97Gchange\u001b[104Gkeeps\u001b[110Gits\u001b[114Gterms,\r\u001b[1B    and Manifest's rank can encode that.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mModel:\u001b[22m Opus at high\u001b[23Geffort for the hook design and\u001b[54Gthe\u001b[58G\u001b[38;2;177;185;249mServe\u001b[64G\u001b[39mchange.\u001b[72GThe\u001b[76Granking\u001b[84Gtouches\u001b[92Gdeterminism\u001b[104Gand\u001b[108Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.140, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mTwo hooks on \u001b[38;2;177;185;249mDock::Docks\u001b[39m.\u001b[22m T\u001b[33Gey're\u001b[39Gplain function types,\u001b[61Gthe\u001b[65Gsame\u001b[70Gidiom\u001b[76Gas\u001b[79G\u001b[38;2;177;185;249mScriptHost::Sender\u001b[39m,\u001b[99Gand\u001b[103Gthe\u001b[107Ggame\u001b[112Gsets\u001b[117Gthem\r\u001b[4C\u001b[1Bat\u001b[8Gstart-up\u001b[17Gthe\u001b[21Gway\u001b[25Git\u001b[28Gsets\u001b[33Gdefinitions:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mAdmit(world, RequestBerth) -> std::optional<Sim::Reason>\u001b[39m:\u001b[65Gthis\u001b[71Gs asked\u001b[79Gafter the engine's ow\u001b[101G checks for control,\r\u001b[4C\u001b[1B  frame and\u001b[17Gfit. If\u001b[28Gr\u001b[31Gurns a reason,\u001b[46Gthe\u001b[50Grequest\u001b[58Gis\u001b[61Grefused\u001b[69Gwith\u001b[74Ga\u001b[76G\u001b[38;2;177;185;249mBerthRefused\u001b[89G\u001b[39mcarrying\u001b[98Gthe\u001b[102Ggame's\u001b[109Greason\u001b[116Gkey\r\u001b[4C\u001b[1B \u001b[7G(e.g. \u001b[38;2;177;185;249mreason.<gam\u001b[25G>.<name>\u001b[39m).\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mRank(world, platform, vehicle) -> std::int64_t\u001b[39m: a h\u001b[59Ggher number is\u001b[74Gserved first. The platform's qu\u001b[106Gue\u001b[109Gk\u001b[111Geps\u001b[K\r\u001b[6C\u001b[1Barrival order, and the queue\u001b[36Gis\u001b[39Gserved\u001b[46Gsorted\u001b[53Gby\u001b[56Grank\u001b[61Gwith\u001b[66Gties\u001b[71Gkept\u001b[76Gin\u001b[79Garrival\u001b[87Gorder,\u001b[94Gso\u001b[97Gthe\u001b[101Gresult\u001b[108Gis\r\u001b[4C\u001b[1B \u001b[7Gdeterministic. \u001b[38;2;177;185;249mBerthQueued\u001b[39m's place uses the ranked ord\u001b[63G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNothing new is saved.\u001b[22m The rul\u001b[35Gs are start-up, not st\u001b[58Gte; whatev\u001b[69Gr\u001b[71Ga rule reads is\u001b[87Gthe game's own saved\u001b[108Gcomponents.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWith no rules set\u001b[22m, the docks behave exactly as today\u001b[58G(first\u001b[65Gcome,\u001b[71Gfirst\u001b[77Gserved),\u001b[86Gso\u001b[89Gthe\u001b[93Gexisting\u001b[102Gdock\u001b[107Gtests\u001b[113Gand\r\u001b[2C\u001b[1B \u001b[5Gpinned hashes don't move.\u001b[31G\u001b[38;2;177;185;249mDocks::Park\u001b[39m skips both hooks.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mProof:\u001b[22m a dock test\u001b[26Gat refuses on\u001b[41Gvehic\u001b[47Ge\u001b[49Gwith its\u001b[58Gown reas\u001b[67Gn and move\u001b[78G a later arrival up the\u001b[102Gqueue. Then the\r\u001b[4C\u001b[1Bdocs (\u001b[38;2;177;185;249mdocks.md\u001b[39m), the roadmap row moved to history, and the\u001b[64Ggate.\r\u001b[4C\u001b[1B\u001b[1mNot doing:\u001b[22m \u001b[17Ghecking a queued vehicle again when the game's state changes after its \u001b[89Gequest, and letting\u001b[109Gt\u001b[112G gam\r\u001b[4C\u001b[1Bchoose which berth a\u001b[26Gvehicle\u001b[34Ggets. L04\u001b[44Gasks for neither. A\u001b[64Gbooking\u001b[72Gaccepted\u001b[81Gbefore\u001b[88Ga\u001b[90Gpolicy\u001b[97Gchange\u001b[104Gkeeps\u001b[110Gits\u001b[114Gterms,\r\u001b[2C\u001b[1B \u001b[5Gand Manifest's ra\u001b[23Gk\u001b[25Gcan \u001b[30Gncode that.\u001b[42G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mModel:\u001b[22m Opus a\u001b[17G high effort for the hook\u001b[43Gdesign\u001b[50Gand\u001b[54Gthe\u001b[58G\u001b[38;2;177;185;249mServe\u001b[64G\u001b[39mchange.\u001b[72GThe\u001b[76Granking\u001b[84Gtouches\u001b[92Gdeterminism\u001b[104Gand\u001b[108Gthe\r\u001b[2C\u001b[1Bquiet-step\u001b[14Glogic,\u001b[21Gand\u001b[25Ga\u001b[27Gcheaper\u001b[35Gmodel\u001b[41Gis\u001b[44Glikelier\u001b[53Gto\u001b[56Gget\u001b[60Gthat\u001b[65Gwrong.\u001b[72GThe\u001b[76Gdocs\u001b[81Gand\u001b[85Gthe\u001b[89Ghistory\u001b[97Gentry\u001b[103Gcan\u001b[107Ggo\u001b[110Gto\u001b[113GSonnet.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
