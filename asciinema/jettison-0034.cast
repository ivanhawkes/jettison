[0.033, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m8\u001b[11G\u001b[22m(`Sim::SimWorld::ShowInSna\u001b[38Gshots`), or the grant does not load. The\u001b[79Ggame\u001b[84Ggives\u001b[90Gthe\u001b[94Ghost\u001b[99Gthe\r\u001b[7C\u001b[1B\u001b[2m9\u001b[11G\u001b[22msnapshot once, `ScriptHost::ReadFrom`,\u001b[50Gas the shell gives\u001b[69Gits stepper's curr\u001b[88Gnt one, the one\u001b[104Gafter\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything\u001b[14Gis\u001b[17Gclean\u001b[23Gand\u001b[27Gall\u001b[31G33\u001b[34Gsuites\u001b[41Gpass.\u001b[47GCommitting\u001b[58Ground\u001b[64G3's\u001b[68Gfixes\u001b[74Gand\u001b[78Grunning\u001b[86Gthe\u001b[90Ggate.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+21\u001b[38;2;153;153;153m, committed \u001b[1m4ba5121\u001b[22m, searched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gpassed\u001b[19G(249\u001b[24Gs).\u001b[28GWriting\u001b[36Gthe\u001b[40Ground\u001b[46G3\u001b[48Greply\u001b[54Gand\u001b[58Gstarting\u001b[67Ground\u001b[73G4.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+48\u001b[38;2;153;153;153m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound\u001b[9G4\u001b[11Gis\u001b[14Grunning\u001b[22Gin\u001b[25Gthe\u001b[29Gbackground.\u001b[41GI'll\u001b[46Gpick\u001b[51Gup\u001b[54Gits\u001b[58Gfindings\u001b[67Gwhen\u001b[72Git\u001b[75Gfinishes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;107;128m●\u001b[3G\u001b[39mBackground\u001b[14Gcommand\u001b[22G\"C