g\u001b[10G in lane C and\u001b[25Gdo a test bu\u001b[38Gld with the\u001b[50Gdevenv's own nixpkgs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWriting\u001b[11G~/projects/jettison.lane-c/nix/wamrc.nix\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  Write(~/projects/jettison.lane-c/nix/wamrc.nix)\r\u001b[2C\u001b[2B\u001b[38;2;220;129;97mMetamorphosing…\u001b[24G\u001b[38;2;153;153;153m2\u001b[34G2\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
