[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m nixpkgs ships only the WAMR 2.4.4 runtime without \u001b[38;2;177;185;249mwamrc\u001b[39m, so I'll\u001b[68Gbuild\u001b[74G\u001b[38;2;177;185;249mwamrc\u001b[80G\u001b[39mfrom\u001b[85Gthe\u001b[89G2.4.5\u001b[95Gsource\u001b[102Gthe\u001b[106Gengine\u001b[113Gpins\u001b[118Gand\r\u001b[2C\u001b[1Bcheck\u001b[9Gwhich\u001b[15GLLVM\u001b[20Gthat\u001b[25Gsource\u001b[32Gexpects.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWAMR's own LLVM build script pins release/18.x,\u001b[51Gbut\u001b[55Gthe\u001b[59Gdevenv\u001b[66Galready\u001b[74Gships\u001b[80GLLVM\u001b[85G21.\u001b[89GI'm\u001b[93Gchecking\u001b[102Gwhether\u001b[110Gthe\u001b[114Gbinary\r\u001b[2C\u001b[1Bcache\u001b[9Ghas\u001b[13GLLVM\u001b[18G21\u001b[21Gready\u001b[27Gfor\u001b[31Gthe\u001b[35Gdevenv's\u001b[44Gnixpkgs\u001b[52Gso\u001b[55Gthe\u001b[59Gbuild\u001b[65Gcan\u001b[69Gskip\u001b[74Gcompiling\u001b[84Git.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Both versions of LLVM are in the binary cache. I'm using LLVM\u001b[65G18,\u001b[69Gthe\u001b[73Gone\u001b[77GWAMR\u001b[82G2.4.5\u001b[88Gis\u001b[91Gtested\u001b[98Gwith.\u001b[104GI'll\u001b[109Gwrite\u001b[115Gthe\r\u001b[2C\u001b[1Bpackage\u001b[11Gin\u001b[14Glane\u001b[19GC\u001b[21Gand\u001b[25Gdo\u001b[28Ga\u001b[30Gtest\u001b[35Gbuild\u001b[41Gwith\u001b[46Gthe\u001b[50Gdevenv's\u001b[59Gown\u001b[63Gnixpkgs.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWor\u001b[7Ging…\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
