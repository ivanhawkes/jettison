[0.202, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m+6 more\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  (a\u001b[9Ggit step in this command can move the working tree, so these may be its changes, not edits) \r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ03\u001b[7Gand\u001b[11GJ10\u001b[15Gare\u001b[19Gboth\u001b[24Gdone\u001b[29Gand\u001b[33Gmerged\u001b[40Gon\u001b[43G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[57Gand\u001b[61Gthe\u001b[65Gfull\u001b[70Ggate\u001b[75Gpassed\u001b[82G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[100G281\u001b[104Gs)\u001b[107Gon\u001b[110Gthe\r\u001b[1B \u001b[3Gcombi\u001b[9Ged head. Tha\u001b[22G run covers J35, J10\u001b[43Gand J03. Nothing is pushed, \u001b[72Gnd\u001b[75Gboth lanes are parked and free.\u001b[107G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ10, the shell's log file (\u001b[38;2;177;185;249m7138f4d\u001b[39m).\u001b[40G\u001b[22mWritten\u001b[48Gby\u001b[51Gthe\u001b[55Gsubagent\u001b[64Gin\u001b[67Glane\u001b[72GB,\u001b[75Greviewed\u001b[84Gby\u001b[87Gme.\r\u001b[2C\u001b[1B- Each run writes \u001b[38;2;177;185;249mjettison.log\u001b[39m to the sta\u001b[46G directory: \u001b[38;2;177;185;249m~/.local/state/jettison/\u001b[39m,\u001b[84Gor\u001b[87G\u001b[38;2;177;185;249m<dir>/state/\u001b[100G\u001b[39munder\u001b[106G\u001b[38;2;177;185;249m--user-dir\u001b[39m.\r\u001b[4C\u001b[1BIt takes\u001b[14GInfo and above, and\u001b[34Geach run ov\u001b[46Grwrites it.\u001b[58GIf the file can't be opened,\u001b[87Gthe run logs\u001b[100Ga wa\u001b[105Gning and carries\r\u001b[2C\u001b[1B \u001b[5Gon.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI fixed\u001b[13Gone\u001b[17Gthing\u001b[23Gin\u001b[26Greview:\u001b[34Gthe\u001b[38Glog\u001b[42Gwas\u001b[46Gcreating\u001b[55Gthe\u001b[59Gstate\u001b[65Gdirectory\u001b[75Gwith\u001b[80Gdefault\u001b[88Gpermissions.\u001b[101GIt's\u001b[106Gnow\u001b[110Gcreated\r\u001b[2C\u001b[1B \u001b[5Gfirst with mode 0700, lik\u001b[31G the other\u001b[42Guser directories.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe ne\u001b[12G \u001b[14Gest writes a\u001b[28Gog in a\u001b[36Gfresh\u001b[42Gdirecto\u001b[50Gy and finds\u001b[62Gthe\u001b[66GInfo\u001b[71Gline\u001b[76Gin\u001b[79Git\u001b[82Gbut\u001b[86Gnot\u001b[90Gthe\u001b[94GDebug\u001b[100Gone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ03, behaviour trees (\u001b[38;2;177;185;249med57c63\u001b[39m).\u001b[35G\u001b[22mAll\u001b[39Gseven\u001b[45Gitems\u001b[51Gare\u001b[55Gin:\r\u001b[2C\u001b[1B- \u001b[1mReactive sequenc\u001b[22G and selector:\u001b[22m they check what comes\u001b[59Gbefore\u001b[66Ga\u001b[68Grunning\u001b[76Gbranch\u001b[83Gon\u001b[86Gevery\u001b[92Gtick,\u001b[98Gand\u001b[102Gstop\u001b[107Gthe\u001b[111Gbranch\r\u001b[2C\u001b[1B \u001b[5Gthey leave.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA task's halt:\u001b[20G\u001b[22ma\u001b[22Grunning\u001b[30Gtask\u001b[35Gis\u001b[38Gtold\u001b[43Gwhen\u001b[77Ggo\u001b[80Gof\u001b[83Gwhat\u001b[88Git\u001b[91Gholds.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
