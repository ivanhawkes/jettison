[0.078, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m6\u001b[11G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[38;2;117;113;94mLLVM\u001b[17G18 is\u001b[23Gthe\u001b[27Grele\u001b[32Gse WAMR 2.4.5 builds and t\u001b[59Gsts wamrc against (build-scripts/build_llvm.py,\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m8\u001b[11G\u001b[22m\u001b[38;2;117;113;94m release/18.x); the engine's own toolchain stays at LLVM 21.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m9\u001b[10G\u001b[22m{\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m  lib,\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +49 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m she\u001b[13Gl command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe package builds in\u001b[25Gabout\u001b[31G90\u001b[34Gseconds.\u001b[43GI'm\u001b[47Gchecking\u001b[56Gthat\u001b[61Gthe\u001b[65Gproduced\u001b[74Gcompiler\u001b[83Gruns\u001b[88Ga\u001b[90Gtest\u001b[95Gscript,\u001b[103Gand\u001b[107Gwhether\u001b[115GWAMR's\r\u001b[2C\u001b[1BAOT\u001b[7Gmode\u001b[12Gcounts\u001b[19Gfuel,\u001b[25Gsince\u001b[31Gthe\u001b[35Gsimulation\u001b[46Gdepends\u001b[54Gon\u001b[57Git.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWAMR's fuel metering o\u001b[26Gly\u001b[29Gcovers the \u001b[41Gnterp\u001b[47Gete\u001b[51Gs, not\u001b[58GAOT, so\u001b[66GAOT-compiled\u001b[79Gscripts\u001b[87Gwould\u001b[93Grely\u001b[98Gsolely\u001b[105Gon\u001b[108Gthe\u001b[112Gwall-time\r\u001b[1B  watchdog. I'm adding the package to \u001b[38;2;177;185;249mdevenv.nix\u001b[39m and checking that the shell picks it up.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[45C\u001b[2B\u001b[38;2;153;153;153mthought for 5s)\u001b[39m\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
