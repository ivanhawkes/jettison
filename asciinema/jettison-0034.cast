[0.058, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 390 \u001b[16G\u001b[22mApp::Application\u001b[33Gshell{\u001b[38;2;166;226;46mWindowlessArguments\u001b[39m(user),\u001b[66G\u001b[38;2;230;219;116m\"Reports\"\u001b[39m};\r\u001b[1B     \u001b[2m 391 \u001b[12G\u001b[22m \u001b[14G  App::ApplicationProbe::\u001b[38;2;166;226;46mStart\u001b[39m(shell);\r\u001b[8C\u001b[1B\u001b[2m2\u001b[32G\u001b[22mProbe::\u001b[38;2;166;226;46mShutdown\u001b[39m(shell);\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 393 -\u001b[38;2;248;248;242m    Core::Log(Core::Severity::Info, \"Test\", \"Reported after the teardown\");                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 393 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m Core::Category kTest{\u001b[38;2;230;219;116m\"test\"\u001b[38;2;248;248;242m};                                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 394 +\u001b[38;2;248;248;242m    Core::\u001b[38;2;166;226;46mLog\u001b[38;2;248;248;242m(Core::Severity::Info, kTest, \u001b[38;2;230;219;116m\"Reported after the teardown\"\u001b[38;2;248;248;242m);                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 395 \u001b[22m   }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 396 \u001b[22m   std::ifstream log{user / \u001b[38;2;230;219;116m\"state\"\u001b[39m / App::kRunLogFile};\u001b[K\r\u001b[8C\u001b[1B\u001b[2m7\u001b[14G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[20G\u001b[39mstd::string\u001b[32Gtext{std::istreambuf_iterator<\u001b[38;2;166;226;46mchar\u001b[39m>{log},\u001b[74G{}};\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mF15, F21, F22 and F23\u001b[25Gare\u001b[29Gin,\u001b[33Gand\u001b[37Gtheir\u001b[43Gsuites\u001b[50Gpass.\u001b[56GNow\u001b[60Gthe\u001b[64Gsteering\u001b[73Gc