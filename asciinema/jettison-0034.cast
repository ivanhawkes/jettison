[0.047, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mIs there work we cna run concurrently in another lane that doesn't interfere with this?\u001b[39m                               \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe leftovers build, their suites pass,\u001b[43Gand\u001b[47Gformat\u001b[54Gand\u001b[58Gtidy\u001b[63Gare\u001b[67Gclean.\u001b[74GI'll\u001b[79Gcommit\u001b[86Gthem\u001b[91Gand\u001b[95Gstart\u001b[101Gthe\u001b[105Ggate\u001b[110Gin\u001b[113Glane\u001b[118GB\r\u001b[2C\u001b[1Bwhile\u001b[9GI\u001b[11Gwrite\u001b[17GJ35\u001b[21Gin\u001b[24Glane\u001b[29GC.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+12\u001b[38;2;153;153;153m, ran \u001b[1m5\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted as \u001b[38;2;177;185;249me2b1f25\u001b[39m. Starting the gate in lane B now:\u001b[K\r\u001b[2C\u001b[2BWhile \u001b[10Ghe\u001b[13Ggate runs, I'll read\u001b[38Gdock\u001b[43Gtests J35\u001b[53Gwill\u001b[58Gextend.\r\u001b[4B\u001b[38;2;215;119;87m·\u001b[3GIonizing… \u001b[67G\u001b[38;2;153;153;153mthought for 15s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;10H\u001b[?25h"]
