[0.101, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m9\u001b[14G\u001b[22mlines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[17G\u001b[22m\u001b[38;2;117;113;94meverything it made, on the\u001b[44Gpath that r\u001b[56Gturn\u001b[61G from Run() and on the \u001b[85Gn\u001b[88Gthat\u001b[93Gthrows \u001b[101Gut of\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// it. Shutdown() is noexcept and idempotent, so a loop that already tore down costs nothing.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 765 \u001b[22m   \u001b[38;2;166;226;46mShutdown\u001b[39m();\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[14G\u001b[38;2;248;248;242m                                                                                                    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[17G\u001b[38;2;117;113;94mThe \u001b[22Gog is closed last, so what Run reports after\u001b[67Gth\u001b[70G teardown is in the file too; then the\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;117;113;94m// headless run's scratch directory, which holds it, goes.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m69\u001b[14G\u001b[38;2;248;248;242mCore::\u001b[38;2;166;226;46mShutdownLogging\u001b[38;2;248;248;242m();   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[14G\u001b[38;2;249;38;114mif\u001b[38;2;248;248;242m (!m_scratchUser.\u001b[38;2;166;226;46mempty\u001b[38;2;248;248;242m())                                                                         \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[14G\u001b[38;2;248;248;242m{\u001b[16G               \u001b[32G        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[21G\u001b[38;2;248;248;242merror_code ignored;                                                                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[14G\u001b[38;2;248;248;242m \u001b[16Gstd::filesystem::\u001b[38;2;166;226;46mremove_all\u001b[38;2;248;248;242m(m_scratchUser, ignored);                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 774 +\u001b[38;2;248;248;242m  }                                                                                                   \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m5\u001b[12G\u001b[22m}\r\u001b[8C\u001b[1B\u001b[2m6\r\u001b[5C\u001b[1B 777 \r\u001b[1B\u001b[22m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m4\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Updat\u001b[12G(~/projects\u001b[24Gj\u001b[26Gt\u001b[28Gison.lane-b/source/\u001b[48Gngine/app/tests/GameTests.cpp)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
