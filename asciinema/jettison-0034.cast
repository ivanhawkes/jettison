[0.086, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+9\u001b[38;2;153;153;153m, committed \u001b[1m24218da\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mwamrc\u001b[39m now works\u001b[19Gin\u001b[22Gthe\u001b[26Gdevenv.\u001b[34GThe\u001b[38Gpackage\u001b[46Gis\u001b[49Gbuilt\u001b[55Gand\u001b[59Gcommitted\u001b[69Gon\u001b[72Glane\u001b[77GC's\u001b[81GJ04\u001b[85Gbranch\u001b[92Gas\u001b[95G\u001b[38;2;177;185;249m24218da\u001b[39m,\u001b[104Gbut\u001b[108Git\u001b[111Gisn't\r\u001b[2C\u001b[1Bmerged\u001b[10Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat I did:\u001b[22m nixpkgs o\u001b[27Gly\u001b[30Gpackages WA\u001b[42GR's runtime,\u001b[55Gso\u001b[62Gn\u001b[64Gw \u001b[38;2;177;185;249mnix/wamrc.nix\u001b[39m builds\u001b[87G\u001b[38;2;177;185;249mwamrc\u001b[93G\u001b[39mfrom WAMR 2.4.5, the rel\u001b[118Gase\r\u001b[4C\u001b[1Bthe\u001b[9Gengine\u001b[16Galready pins, ag\u001b[33Gins\u001b[38GLLVM 18. LLVM 18 is the releas\u001b[70GWAMR t\u001b[77Gsts \u001b[38;2;177;185;249mwamr\u001b[86G\u001b[39m with, and nixpkgs' binary\u001b[113Gcache\u001b[K\r\u001b[4C\u001b[1Bhas\u001b[9Git, so the build takes\u001b[32Gabou\u001b[37G 90 seconds.\u001b[50G\u001b[38;2;177;185;249mdevenv.nix\u001b[61G\u001b[39madds\u001b[66Gthe\u001b[70Gpackage,\u001b[79Gand\u001b[83G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[107G\u001b[39mnotes\u001b[113Gthat\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gtwo WAMR pins have to move togeth\u001b[39Gr.\u001b[42G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[17G\u001b[39mt\u001b[19G a\u001b[22G2 KB \u001b[38;2;177;185;249m.aot\u001b[39m fi\u001b[35Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[22m your current\u001b[30Gshell won't see it until\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[4C\u001b[1Bthere\u001b[11G(\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor\u001b[30Gre-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts\u001b[32Gfuel only when \u001b[48Gt interprets a script. Its\u001b[75Gahead-of-tim\u001b[88G ru\u001b[92Gtime and compiler have no\u001b[K\r\u001b[2C\u001b[1Binstruction\u001b[15Gmetering at all, so compiled scripts would run with \u001b[68Go\u001b[70Gfu\u001b[73Gl limit, stopped on\u001b[93Gy by the 250 ms watchdog.\u001b[119G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHandlers:\u001b[22m these run \u001b[26Gutside\u001b[33Gthe\u001b[37Gstep,\u001b[43Gand\u001b[76Gcorded,\u001b[84Gso\u001b[87Gcompiled\u001b[96Ghandlers\u001b[105Gwould\u001b[111Gbe\u001b[114Gsafe\u001b[119Gas\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.039, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[2m 65 \u001b[22m A tree configured without the scripts' compilers builds everything\u001b[78Gbut\u001b[82Gthe\u001b[86Gscripts,\u001b[95Gwhose\u001b[101Gtargets\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+9\u001b[38;2;153;153;153m, committed \u001b[1m24218da\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mwamrc\u001b[9G\u001b[39mnow\u001b[13Gworks\u001b[19Gin\u001b[22Gthe\u001b[26Gdevenv.\u001b[34GThe\u001b[38Gpackage\u001b[46Gis\u001b[49Gbuilt\u001b[55Gand\u001b[59Gcommitted\u001b[69Gon\u001b[72Glane\u001b[77GC's\u001b[81GJ04\u001b[85Gbranch\u001b[92Gas\u001b[95G\u001b[38;2;177;185;249m24218da\u001b[39m,\u001b[104Gbut\u001b[108Git\u001b[111Gisn't\r\u001b[2C\u001b[1Bmerged yet.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat I did:\u001b[22m nixpkgs only packages WAMR's runtime, so the new\u001b[66G\u001b[38;2;177;185;249mnix/wamrc.nix\u001b[39m builds \u001b[38;2;177;185;249mwamrc\u001b[39m from WAMR 2.4.5, the releas\r\u001b[5C\u001b[1Bhe\u001b[9Gengine alre\u001b[21Gdy\u001b[24Gpins, agains\u001b[37G LLVM 18.\u001b[47GLLVM\u001b[52G18\u001b[55Gis\u001b[58Gthe\u001b[62Grelease\u001b[70GWAMR\u001b[75Gtests\u001b[81G\u001b[38;2;177;185;249mwamrc\u001b[87G\u001b[39mwith,\u001b[93Gand\u001b[97Gnixpkgs'\u001b[106Gbinary\u001b[113Gcache\r\u001b[2C\u001b[1B \u001b[5Ghas it, so the build\u001b[26Gt\u001b[28Gk\u001b[30Gs about 90 seconds. \u001b[38;2;177;185;249md\u001b[52Gvenv.nix\u001b[39m adds the package,\u001b[79Gand \u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[39m notes that the\r\u001b[4C\u001b[1Btwo WAMR pins h\u001b[21Gve\u001b[24Gto\u001b[27Gmove\u001b[32Gtog\u001b[36Gther.\r\u001b[4C\u001b[1B\u001b[1mH\u001b[7Gw I checked it:\u001b[22m in lane C, a\u001b[36Gfresh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs \u001b[38;2;177;185;249mwamrc 2.4.5\u001b[39m on the\u001b[79Gpath, and it\u001b[92Gcompiled the script suite's\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mevents.wasm\u001b[39m to a 2 KB\u001b[27G\u001b[38;2;177;185;249m.aot\u001b[39m file.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[17G\u001b[22myour\u001b[22Gcurrent\u001b[30Gshell\u001b[36Gwon't\u001b[42Gsee\u001b[46Git\u001b[49Guntil\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[2C\u001b[1B  there (\u001b[38;2;177;185;249mdirenv reload\u001b[39m, or re-enter \u001b[38;2;177;185;249mdevenv shell\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA c\u001b[7Gtch for J04:\u001b[22m WAMR\u001b[25Gcounts fuel\u001b[37Gonly when\u001b[76Ghea\u001b[80G-of-time runtime \u001b[100G compiler have no\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
