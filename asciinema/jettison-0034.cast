[0.164, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm writing the picker's tests now in the physics suite's room fixture. They compare it with the world's own \u001b[38;2;177;185;249mCastRay\u001b[39m,\r\u001b[2C\u001b[1Band cover interpolation, the \u001b[38;2;177;185;249mstatics\u001b[39m option\u001b[47Gand\u001b[51Ga\u001b[53Gray\u001b[57Gof\u001b[60Gno\u001b[63Glength.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/jettison.lane-b/source/engine/physics/tests/RoomTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m60\u001b[22m lin\u001b[19Gs, removed \u001b[1m1\u001b[32G\u001b[22mline\r\u001b[6C\u001b[1B\u001b[2m1 \u001b[22m \u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<jettison/physics/PhysicsWorld.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 2 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 3 \u001b[10G\u001b[22m\u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<jettison/physics/Flight.h>\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4 +\u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<jettison/physics/SnapshotPicker.h>\u001b[38;2;248;248;242m                                                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 5 \u001b[22m \u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<jettison/sim/SimWorld.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 6 \u001b[22m \u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<jettison/sim/Snapshot.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 7 \u001b[22m\u0