[0.320, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gthe engine already pi\u001b[27Gs,\u001b[30Gagainst LLV\u001b[42G 18. LLVM 18\u001b[55Gis\u001b[62Gr\u001b[64Glease WAMR tests \u001b[38;2;177;185;249mwamrc\u001b[87G\u001b[39mwith,\u001b[93Gand nixpkgs' binary cach\u001b[118G\u001b[K\r\u001b[4C\u001b[1Bhas\u001b[9Git, so\u001b[16Gthe build takes \u001b[33Gbou\u001b[38G90 seconds. \u001b[38;2;177;185;249mdevenv.nix\u001b[39m adds th\u001b[70Gpackag\u001b[77G, and \u001b[38;2;177;185;249mdo\u001b[86Gs/build-and-gates.md\u001b[39m notes\u001b[113Gthat the\r\u001b[4C\u001b[1Btwo\u001b[9GWAMR pins have to move\u001b[32Gtoge\u001b[37Gher.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in lane C, a fr\u001b[39Gsh\u001b[42G\u001b[38;2;177;185;249mdevenv shell\u001b[55G\u001b[39mputs\u001b[60G\u001b[38;2;177;185;249mwamrc 2.4.5\u001b[72G\u001b[39mon\u001b[75Gthe\u001b[79Gpath,\u001b[85Gand\u001b[89Git\u001b[92Gcompiled\u001b[101Gthe\u001b[105Gscript\u001b[112Gsuite's\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[39m to a 2 KB \u001b[38;2;177;185;249m.aot\u001b[39m file.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mYour shell:\u001b[17G\u001b[22my\u001b[19Gur\u001b[22Gcurrent shel\u001b[35G won't\u001b[42Gsee\u001b[46Git\u001b[49Guntil\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[2C\u001b[1B \u001b[5Gthere (\u001b[38;2;177;185;249mdirenv reload\u001b[39m, or\u001b[30Gre-enter \u001b[38;2;177;185;249mdevenv shell\u001b[39m).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[20G\u001b[22mWAMR\u001b[25Gcounts\u001b[32Gfuel\u001b[37Gonly\u001b[42Gwhen\u001b[47Git\u001b[50Ginterprets\u001b[61Ga\u001b[63Gscript.\u001b[71GIts\u001b[75Gahead-of-time\u001b[89Gruntime\u001b[97Gand\u001b[101Gcompiler\u001b[110Ghave\u001b[115Gno\r\u001b[2C\u001b[1Binstruction metering at all,\u001b[32Gso compiled scr\u001b[48Gpts would run with no fuel\u001b[75Glimit, stopp\u001b[88Gd o\u001b[92Gly by the 250 ms watchdog.\r\u001b[2C\u001b[1B- \u001b[1mHandlers:\u001b[15G\u001b[22mthese run outside the step, and the commands they se\u001b[68Gd\u001b[70Gar\u001b[73G recorded, so compi\u001b[93Ged handlers would be safe\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Gfar as determinism g\u001b[26Ges.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInputs and behaviour-tree tasks:\u001b[38G\u001b[22mthese\u001b[44Grun\u001b[48Ginside\u001b[55Gthe\u001b[59Gstep.\u001b[65GThe\u001b[69Gfuel\u001b[74Glimit\u001b[80Gis\u001b[83Gwhat\u001b[88Gkeeps\u001b[94Gtheir\u001b[100Gresult\u001b[107Gthe\u001b[111Gsame\u001b[116Gon\r\u001b[2C\u001b[1B \u001b[5Gevery machine, so they have to stay interpreted.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision\u001b[12Gfor\u001b[16Gyou:\u001b[21Gdo\u001b[24GI\u001b[26Gbuild\u001b[32Gahead-of-time\u001b[46Gcompilation\u001b[58Gfor\u001b[62Ghandlers\u001b[71Gonly\u001b[76Gas\u001b[79Gpart\u001b[84Gof\u001b[87GJ04,\u001b[92Gor\u001b[95Gdrop\u001b[100Git?\u001b[104GI'd\u001b[108Gdrop\u001b[113Git\u001b[116Gfor\r\u001b[2C\u001b[1Bnow: a handler call costs 0.27 µs interpr\u001b[45Gte\u001b[76Gcri\u001b[80Gts slow. Either way\u001b[100G\u001b[38;2;177;185;249mwamrc\u001b[39m stays on the\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
