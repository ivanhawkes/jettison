[0.035, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 487 -\u001b[38;2;248;248;242m- A script called from a tree's task, as an input is from a consideration ([J04](roadmap.md#j04)).    \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[12G\u001b[22m-\u001b[14GSteering: no\u001b[27Gcourse round the inside of a platform,\u001b[66Gand\u001b[70Gno\u001b[73Gmeasurement\u001b[85Gyet\u001b[89Gfor\u001b[93Ga\u001b[95Glane\u001b[100Gbusier\u001b[107Gthan\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22m \u001b[14Ga platform's traffic ([\u001b[38;2;230;219;116mJ08\u001b[39m](roadmap.md#j08)).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 489 \u001b[12G\u001b[22m-\u001b[14GThe\u001b[18Gway\u001b[22Gin\u001b[25Gto\u001b[28Ga\u001b[30Gberth,\u001b[37Gwhich\u001b[43Gsteering\u001b[52Gflies\u001b[58Gfor\u001b[62Gthe\u001b[66Gdocks\u001b[72G([\u001b[38;2;230;219;116mJ09\u001b[39m](roadmap.md#j09)).\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/ai.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m lin\u001b[18G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22mapplied at\u001b[23Gonce ([\u001b[38;2;230;219;116ma step\u001b[39m](simulation.md#a-s\u001b[56Gep)), carrying the\u001b[75Gagent as \u001b[86Ge\u001b[88Gr sender wher\u001b[102G they\u001b[K\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22mcarry o\u001b[20Ge. A task may be defined with a halt (`Ai::TaskHalt`),\u001b[75Gcalled with its context when it is\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 228 \u001b[22m left running, so it can let go of what it holds (a berth asked for); its memory is discarded after.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m229\u001b[12G\u001b[38;2;248;248;242mA mod's\u001b[20Gscript\u001b[27Gmay\u001b[31Ganswer\u001b[38Ga\u001b[40Gtask,\u001b[46Gwhich\u001b[52Gthe\u001b[56Ggame\u001b[61Gdefines\u001b[69Gin\u001b[72Gits\u001b[76Gtrees\u001b[82G([\u001b[38;2;230;219;116mscripts\u001b[38;2;248;248;242m](scripts.md#a-trees-ta\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242msk)).                                                                                                 \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m0\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m**Th\u001b[17G blackboard.**\u001b[32G`Ai::Blackboard` is an entity's memory \u001b[72Gha\u001b[75G its tasks\u001b[86Gshare, by key: integ\u001b[107Grs\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 232 \u001b[12G\u001b[22mand\u001b[16Gentities,\u001b[26Gsaved\u001b[32Gwith\u001b[37Gthe\u001b[41Gworld\u001b[47Gand\u001b[51Gkept\u001b[56Gwhen\u001b[61Gits\u001b[65Gtree\u001b[70Gstarts\u001b[77Gagain\u001b[83Gor\u001b[86Gis\u001b[89Gchanged.\u001b[98GA\u001b[100Gtask\u001b[105Greads\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Reading \u001b[1m1\u001b[22m file\u001b[38;2;153;153;153m · 58s\u001b[39m…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && ctest --test-dir build/clang-debug -R '^(scri\u001b[98Gt|sim|app|ai)$' 2>&1 | \r\u001b[5C\u001b[1Bta\u001b[9Gl\u001b[11G-3\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
