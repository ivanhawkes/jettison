[0.046, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 297 \u001b[22m events are reflected, so a session can be recorded and replayed.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 298 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m## Using it\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/ai.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m4\u001b[30G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 483 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 484 \u001b[12G\u001b[22m-\u001b[14GUtility AI and behaviour\u001b[39Gtrees\u001b[45Ghave\u001b[50Gno\u001b[53Gconsumer\u001b[62Goutside\u001b[70Gthe\u001b[74G`ai`\u001b[79Gsuite\u001b[85Gtoday;\u001b[92GManifest\u001b[101Guses\r\u001b[8C\u001b[1B\u001b[2m5\u001b[14G\u001b[22mpathfinding,\u001b[27Gcourses\u001b[35Gand\u001b[39Gsteering,\u001b[49Gand\u001b[53Gchooses\u001b[61Ga\u001b[63Gjob's\u001b[69Gnext\u001b[74Gstep\u001b[79Gwith\u001b[84Gits\u001b[88Gown\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 486 -\u001b[38;2;248;248;242m  `Manifest::Policy::Choose`\u001b[48;2;92;2;0m ([J03](roadmap\u001b[48;2;61;1;0m.\u001b[48;2;92;2;0mmd#j03)).\u001b[48;2;61;1;0m                                                 \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 487 -\u001b[38;2;248;248;242m- Behaviour trees: no reactive or parallel nodes, no task halt, no subtrees, no blackboard, no        \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m8\u001b[14G\u001b[38;2;248;248;242mcommand giving an entity a tree, no tree ticked less\u001b[67Goften\u001b[73Gthan\u001b[78Gevery\u001b[84Gstep\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[12G\u001b[38;2;248;248;242m \u001b[14G([J03](roadmap.md#j03)).    \u001b[43G  \u001b[46G        \u001b[55G      \u001b[62G  \u001b[65G    \u001b[70G     \u001b[76G  \u001b[79G         \u001b[89G  \u001b[92G           \u001b[104G  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 486 +\u001b[38;2;248;248;242m  `Manifest::Policy::Choose`.                                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 487 \u001b[22m - A script called from a tree's task, as an input is from a consideration ([\u001b[38;2;230;219;116mJ04\u001b[39m](roadmap.md#j04)).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 488 \u001b[22m - Steering: no course round the inside of a platform, and no measurement yet for a lane busier than\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m \u001b[14Ga\u001b[16Gplatform's tra\u001b[31Gfic\u001b[35G([\u001b[38;2;230;219;116mJ08\u001b[39m](roadmap.md#j08)).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWorking…\u001b[14G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
