[0.107, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ03, behaviour trees (\u001b[38;2;177;185;249med57c63\u001b[39m).\u001b[22m All \u001b[40Geven items are in:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReactive sequence and selector:\u001b[37G\u001b[22mthey\u001b[42Gcheck\u001b[48Gwhat\u001b[53Gcomes\u001b[59Gbefore\u001b[66Ga\u001b[68Grunning\u001b[76Gbranch\u001b[83Gon\u001b[86Gevery\u001b[92Gtick,\u001b[98Gand\u001b[102Gstop\u001b[107Gthe\u001b[111Gbranch\r\u001b[2C\u001b[1B  they leave.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA task's\u001b[14Ghalt:\u001b[22m a running task is told when\u001b[48Git is stopped, so\u001b[66Git ca\u001b[72G let go of\u001b[83Gwhat it holds.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mParallel:\u001b[22m runs\u001b[20Gits\u001b[24Gchildren\u001b[33Gtogether\u001b[42Guntil\u001b[48Ga\u001b[50Gset\u001b[54Gnumber\u001b[61Gsucceed,\u001b[70Gor\u001b[73Gthat\u001b[78Gnumber\u001b[85Gcan't\u001b[91Gbe\u001b[94Greached.\u001b[103GIt\u001b[106Gtakes\u001b[112Gat\u001b[115Gmost\r\u001b[2C\u001b[1B \u001b[5G32 children.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSubtre\u001b[12Gs\u001b[15G\u001b[22ma \u001b[18Gode can name a\u001b[34Gre\u001b[37G d\u001b[40Gfined earli\u001b[52Gr, so a repeat\u001b[68G l\u001b[71Gop is writt\u001b[83Gn\u001b[85Gonce.\u001b[91G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA blackboard:\u001b[19G\u001b[22ma\u001b[21Gsaved\u001b[27Gper-entity\u001b[38Gmemory\u001b[45Gof\u001b[48Gintegers\u001b[57Gand\u001b[61Gentities\u001b[70Gby\u001b[73Gkey,\u001b[78Gkept\u001b[83Gwhen\u001b[88Gthe\u001b[92Gentity's\u001b[101Gtree\u001b[106Gchanges.\r\u001b[4C\u001b[1B\u001b[1mA command that gives an entity a tree:\u001b[22m \u001b[38;2;177;185;249mAssignBehaviour\u001b[39m. Its n\u001b[67Gw\u001b[69Grefusal\u001b[77Greason,\u001b[85G\u001b[38;2;177;185;249mno_such_tree\u001b[39m,\u001b[99Ghas\u001b[103GEnglish\u001b[111Gand\u001b[115GGerman\r\u001b[2C\u001b[1B \u001b[5Gwording.\u001b[K\r\u00