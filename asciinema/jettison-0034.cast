[0.030, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m7\u001b[12G\u001b[38;2;248;248;242m      \u001b[19G          \u001b[30G \u001b[32G      \u001b[39G     \u001b[45G   \u001b[49G      \u001b[56G  \u001b[59G \u001b[61G                                 \u001b[95G    \u001b[100G  \u001b[103G    \u001b[108G   \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m8\u001b[12G\u001b[38;2;248;248;242m**Why.** A vehicle reaches\u001b[39Ga berth only by coming straigh\u001b[70G dow\u001b[75G from outside the platform's\u001b[104Gsphere, \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[12G\u001b[38;2;248;248;242mso a layout must leave that column clear. Ste\u001b[58Gring has been\u001b[72Gmeasur\u001b[79Gd for sixteen\u001b[93Gvehicles,\u001b[103Gone\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m90\u001b[12G\u001b[38;2;248;248;242mplatform's\u001b[23Gtraffic;\u001b[32Ga\u001b[34Gbusier\u001b[41Glane's\u001b[48Gcost\u001b[53Gis\u001b[56Gunknown.\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m91\u001b[12G\u001b[38;2;248;248;242m        \u001b[21G \u001b[23G       \u001b[31G       \u001b[39G \u001b[41G     \u001b[47G    \u001b[52G  \u001b[55G      \u001b[62G        \u001b[71G    \u001b[76G    \u001b[81G       \u001b[89G   \u001b[93G          \u001b[104G       \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m92\u001b[12G\u001b[38;2;248;248;242m**What exists.**\u001b[29GAn obs\u001b[36Gacle is the sphere about its body that holds\u001b[81Gits\u001b[86Ghap\u001b[90G  \u001b[93G         \u001b[103G   \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m3\u001b[12G\u001b[38;2;248;248;242m(`source/engine/ai/incl\u001b[36Gde/jettison/ai/Steeri\u001b[58Gg.h`)\u001b[65GA\u001b[67Gdestination\u001b[79Gflown\u001b[85G`byShape`\u001b[95Gsweeps\u001b[102Gthe\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m4\u001b[12G\u001b[38;2;248;248;242mvehicle's\u001b[22Gown\u001b[26Gshape\u001b[32Galong\u001b[38Gits\u001b[42Gway\u001b[46G(`PhysicsWorld::CastShape`),\u001b[75Gwhich\u001b[81Gslows\u001b[87Git\u001b[90Gbut\