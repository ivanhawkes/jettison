[0.121, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mevents.wasm\u001b[17G\u001b[39mto\u001b[20Ga\u001b[22G2\u001b[24GKB\u001b[27G\u001b[38;2;177;185;249m.aot\u001b[32G\u001b[39mfile.\r\u001b[1B  - \u001b[1mYour shell:\u001b[22m your curr\u001b[27Gnt shell\u001b[36Gwon't\u001b[42Gsee\u001b[46Git\u001b[49Guntil\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gmerged\u001b[76Gto\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand\u001b[96Gyou\u001b[100Greload\u001b[107Gthe\u001b[111Gdevenv\r\u001b[4C\u001b[1Bthere\u001b[11G(\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor\u001b[30Gre-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts fu\u001b[35Gl only when\u001b[47Git interprets a script. Its ahead-of-time runtime and compiler\u001b[110Ghave\u001b[115Gno\r\u001b[2C\u001b[1Binstruction metering at all, so compiled scripts would run with no fuel limit, stopped only by the 250 ms watchdog.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHandlers:\u001b[22m these run outside the step, and the commands they send are recorded, so compiled handlers would be safe\u001b[119Gas\r\u001b[4C\u001b[1Bfar as determinism goes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInputs and behaviour-tree tasks:\u001b[22m these run inside the step. The fuel limit is what keeps their result the same\u001b[116Gon\r\u001b[4C\u001b[1Bevery\u001b[11Gmachin\u001b[18G, s\u001b[22G th\u001b[26Gy have to stay interpreted.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision fo\u001b[15G you: do I build ahead-of-time compilat\u001b[55Gon for handl\u001b[68Grs only as par\u001b[83G of J04, or\u001b[95Gdr\u001b[98Gp i\u001b[102G? I'd drop\u001b[113Git\u001b[116Gfor\r\u001b[2C\u001b[1Bnow:\u001b[8Ga\u001b[10Ghandler\u001b[18Gcall\u001b[23Gcosts\u001b[29G0.27\u001b[34Gµs\u001b[37Ginterpreted,\u001b[50Gand\u001b[54Gno\u001b[57Gprofile\u001b[65Ghas\u001b[69Gfound\u001b[75Gscripts\u001b[83Gslow.\u001b[89GEither\u001b[96Gway\u001b[100G\u001b[38;2;177;185;249mwamrc\u001b[106G\u001b[39mstays\u001b[112Gon\u001b[115Gthe\r\u001b[1B \u001b[3Gp\u001b[5Gth for\u001b[12Gwhen one \u001b[22Go\u001b[24Gs.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJ04's other parts aren't affected. Lane B's J05 is still running in the background.\u001b[K\r\u001b[33C\u001b[2B\u001b[38;2;153;153;153m6\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
