[0.018, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mleave main for now, we will merge big chunks of work, after the cross review, into main\u001b[39m                               \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRecalled \u001b[1m1\u001b[22m memory, wrote \u001b[1m2\u001b[22m memories \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mOkay, I'll leave \u001b[38;2;177;185;249mmain\u001b[39m alone. It only\u001b[40Gtakes\u001b[46Gbig\u001b[50Gchunks\u001b[57Gof\u001b[60Gwork,\u001b[66Gmerged\u001b[73Gafter\u001b[79Gthe\u001b[83Gstage's\u001b[91Gcross-review,\u001b[105Gand\u001b[109GI'll\u001b[114Gstop\r\u001b[2C\u001b[1Bsuggesting\u001b[14Ga\u001b[16Gmerge\u001b[22Gafter\u001b[28Ga\u001b[30Gsingle\u001b[37Gtask.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI've \u001b[9Gaved\u001b[14Gthat rule in my\u001b[30Gmemory\u001b[37Gnotes\u001b[43Gon\u001b[46Glanes\u001b[52Gand\u001b[56G\u001b[38;2;177;185;249mfeature-base\u001b[39m.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 15s · done 4:24 pm\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mwhat's next on the roadmap? let's kick off a complementary pair at a time\u001b[39m                                             \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[39m Searching for \u001b[1m2\u001b[22m patterns, reading \u001b[1m3\u001b[22m files, running \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ bash -c 'wc -l source/engine/script/src/*.cpp source/engine/script/include/jettison/script/*.h \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153msource/engine/vfs/src/*.cpp source/engine/vfs/include/jettison/vfs/*.h source/engine/registry/src/*.cpp \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m2>/dev/null; ls \u001b[23Gource/engine'\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
