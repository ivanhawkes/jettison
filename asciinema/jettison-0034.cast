[0.102, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/j\u001b[23Gttison.lane-b/docs/scripts.md\u001b[53G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, \u001b[23Gmoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m1\u001b[12G\u001b[22mte\u001b[15G's state\u001b[24G([\u001b[38;2;230;219;116mwhy\u001b[39m](decisi\u001b[38Gns.md#scripts)).\u001b[55GA script granted `read:<Component>` impor\u001b[97Gs\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 92 \u001b[22m `jettison_read_<Component>`, which takes an entity and returns its copy of the component as the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 93 \u001b[22m snapshot has it, or null for an entity with none there; in Rust, `read_<Component>(entity, f)`\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 94 -\u001b[38;2;248;248;242mgives the copy to `f` and returns what `f` answers, so safe code \u001b[48;2;92;2;0mcannot\u001b[48;2;61;1;0m keep\u001b[48;2;92;2;0m a reference to it. The com\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mponent\u001b[48;2;61;1;0m                                                                                                 \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4\u001b[11G\u001b[38;2;248;248;242mgiv\u001b[15Gs the copy to `f` \u001b[48;2;4;71;0mfor any lifetime at all \u001b[48;2;2;40;0mand\u001b[61Greturns\u001b[69Gwhat\u001b[74G`f`\u001b[78Ganswers,\u001b[87Gso\u001b[90Gsafe\u001b[95Gcode\u001b[100G\u001b[48;2;4;71;0mcan\u001b[104G\u001b[48;2;2;40;0mkeep\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 95 +\u001b[38;2;248;248;242mnothing of it, the copy, a string in it or a reference: each is refused as the script compiles         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 96 +\u001b[38;2;248;248;242m(the suite's `kept.rs`). The component                                                                 \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[11G\u001b[22mis one Reflect\u001b[26Gmarks `Script` \u001b[42Gnd the world shows in \u001b[65Gts snapshots\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 98 \u001b[11G\u001b[22m(`Sim::SimWorld::ShowInSnapshots`),\u001b[47Gor\u001b[50Gthe\u001b[54Ggrant\u001b[60Gdoes\u001b[65Gnot\u001b[69Gload.\u001b[75GThe\u001b[79Ggame\u001b[84Ggives\u001b[90Gthe\u001b[94Ghost\u001b[99Gthe\r\u001b[1B \u001b[3G   \u001b[2m 99 \u001b[11G\u001b[22msnapshot \u001b[21Gnce, `ScriptHost::ReadFrom`,\u001b[50Gas\u001b[53Gthe\u001b[57Gshell\u001b[63Ggives\u001b[69Gits\u001b[73Gstepper's\u001b[83Gcurrent\u001b[91Gone,\u001b[96Gthe\u001b[100Gone\u001b[104Gafter\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '\u001b[13Ghome/iv\u001b[21Gn\u001b[23Gprojects/jettison.lane-b' &&\u001b[52Gpython3 scripts/space-dec\u001b[78Gar\u001b[85Gs.\u001b[88Gy\u001b[90G&& python3 \r\u001b[6C\u001b[1Bcripts/spac\u001b[19G-declara\u001b[28Gions.py --check && ./scripts/format-check.sh | tail -1\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
