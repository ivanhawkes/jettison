[0.017, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m7\u001b[12G\u001b[38;2;248;248;242m                          \u001b[39G  \u001b[42G       \u001b[50G     \u001b[56G \u001b[58G     \u001b[64G   \u001b[68G        \u001b[77G        \u001b[86G   \u001b[90G \u001b[92G    \u001b[97G      \u001b[104G    \u001b[109G   \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m8\u001b[12G\u001b[38;2;248;248;242m**Why.** A\u001b[23Gvehicle reach\u001b[37Gs a berth on\u001b[50Gy\u001b[52Gby coming straight down from outside\u001b[89Gthe\u001b[93Gplatform's\u001b[104Gsphere,\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[12G\u001b[38;2;248;248;242mso\u001b[15Ga\u001b[17Glayout\u001b[24Gmust\u001b[29Gleave\u001b[35Gthat\u001b[40Gcolumn\u001b[47Gclear.\u001b[54GSteering\u001b[63Ghas\u001b[67Gbeen\u001b[72Gmeasured\u001b[81Gfor\u001b[85Gsixteen\u001b[93Gvehicles,\u001b[103Gone\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m90\u001b[12G\u001b[38;2;248;248;242mplatform's\u001b[23Gtraffic; a busier\u001b[41Glane's cost is unk\u001b[60Gown.      \u001b[71G    \u001b[76G    \u001b[81G       \u001b[89G   \u001b[93G          \u001b[104G       \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m91\u001b[12G\u001b[38;2;248;248;242m  \u001b[15G \u001b[17G      \u001b[24G    \u001b[29G     \u001b[35G    \u001b[40G      \u001b[47G      \u001b[54G        \u001b[63G   \u001b[67G    \u001b[72G        \u001b[81G   \u001b[85G       \u001b[93G         \u001b[103G   \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m2\u001b[12G\u001b[38;2;248;248;242m**What exis\u001b[24Gs.** An\u001b[32Gobstacle\u001b[41Gis the\u001b[48Gsphere about its\u001b[65Gbody\u001b[70Gthat\u001b[75Gholds\u001b[81Gits\u001b[85Gshape\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m3\u001b[12G\u001b[38;2;248;248;242m(`source/engine/ai/include/jettison/ai/Steering.h`).\u001b[65GA\u001b[67Gdestination\u001b[79Gflown\u001b[85G`byShape`\u001b[95Gsweeps\u001b[102Gthe\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m4\u001b[12G\u001b[38;2;248;248;242mvehicle's own shape\u001b[32Galong its way (`PhysicsWorld::CastShape`),\u001b[75Gwhich\u001b[81Gslow\u001b[86G it but\u001b[94Gdoes\u001b[99Gnot\u001b[103Gturn\u001b[108Git.\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m5\u001b[12G\u001b[38;2;248;248;242m                                                    \u001b[65G \u001b[67G           \u001b[79G     \u001b[85G         \u001b[95G      \u001b[102G   \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m6\u001b[12G\u001b[38;2;248;248;242m**Feature\u001b[22Gdoc:** [AI](ai.md).\u001b[42G   \u001b[46G                            \u001b[75G     \u001b[81G     \u001b[87G  \u001b[90G   \u001b[94G    \u001b[99G   \u001b[103G    \u001b[108G   \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m7\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m  81 \u001b[22m <a \u001b[38;2;166;226;46mid\u001b[39m=\u001b[38;2;230;219;116m\"j09\"\u001b[39m></a>\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  82 \u001b[22m ### J09. The way in to a berth, done properly\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cd\u001b[14G'/home/ivan/projects/jettison.lane-c'\u001b[52G&&\u001b[55G./scr…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-c' && ./scripts/heavy.sh cmake --build --preset clang-debug > \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m'/tmp/claude-1000/-home-ivan-projects-jettison/414e2912-7de0-46ef-bba3-922122ec86c7/scratchpad'/b8.log 2>&1; echo \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mexit\u001b[11G$?\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
