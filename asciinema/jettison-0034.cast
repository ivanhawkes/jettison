[0.093, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m It docks now, but its hull touches the underside of the roof\u001b[64Gtwice\u001b[70Gon\u001b[73Gthe\u001b[77Gway\u001b[81Gin.\u001b[85GI'm\u001b[89Glogging\u001b[97Gits\u001b[101Gattitude\u001b[110Garound\r\u001b[2C\u001b[1Bthose\u001b[9Gcontacts.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+5\u001b[38;2;153;153;153m, read \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B  ⎿  Found \u001b[1m10\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The approach comes down to the corner, passes level under the pier,\u001b[71Gand\u001b[75Gsettles\u001b[83Gover\u001b[88Gthe\u001b[92Gberth\u001b[98Gbefore\u001b[105Gcontact.\u001b[114GOn\u001b[117Gthe\r\u001b[2C\u001b[1Bdescent\u001b[11Git\u001b[14Gclimbs\u001b[21Gat\u001b[24G6\u001b[26Gm/s\u001b[30Ginto\u001b[35Gthe\u001b[39Groof,\u001b[45Gso\u001b[48GI'm\u001b[52Gtracking\u001b[61Gdown\u001b[66Gwhat's\u001b[73Gpushing\u001b[81Git\u001b[84Gup.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m3\u001b[22m scratchpad edits \u001b[38;2;56;166;96m+15\u001b[38;2;153;153;153m, ran \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m10\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[1B  ⎿  Found \u001b[1m10\u001b[22m new \u001b[20Giagno\u001b[26Gtic issues in 1 file (ctrl+o to expand)\r\u001b[2B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The vehicle is rolled about 48° under the pier, so the limiter\u001b[66Ganswers\u001b[74G\"move\u001b[80Gaway\"\u001b[86Gby\u001b[89Gdriving\u001b[97Git\u001b[100Gup\u001b[103Ginto\u001b[108Gthe\u001b[112Groof.\u001b[118GI'm\r\u001b[2C\u001b[1Breading\