[0.032, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bmerged\u001b[10Gyet.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mWhat I did:\u001b[17G\u001b[22mnixpkgs\u001b[25Gonly\u001b[30Gpackages\u001b[39GWAMR's\u001b[46Gruntime,\u001b[55Gso\u001b[58Gthe\u001b[62Gnew\u001b[66G\u001b[38;2;177;185;249mnix/wamrc.nix\u001b[80G\u001b[39mbuilds\u001b[87G\u001b[38;2;177;185;249mwamrc\u001b[93G\u001b[39mfrom\u001b[98GWAMR\u001b[103G2.4.5,\u001b[110Gthe\u001b[114Grelease\r\u001b[4C\u001b[1Bthe\u001b[9Gengine\u001b[16Galready\u001b[24Gpins,\u001b[30Gagainst\u001b[38GLLVM 18.\u001b[47GLLVM\u001b[52G18\u001b[55Gis\u001b[58Gthe\u001b[62Grelease\u001b[70GWAMR\u001b[75Gtests\u001b[81G\u001b[38;2;177;185;249mwamrc\u001b[87G\u001b[39mwith,\u001b[93Gand\u001b[97Gnixpkgs'\u001b[106Gbinary\u001b[113Gcache\r\u001b[2C\u001b[1B \u001b[5Ghas it, so the build takes about 90 seconds. \u001b[38;2;177;185;249mdevenv.nix\u001b[39m adds\u001b[66Gthe package, and \u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[39m notes that th\r\u001b[5C\u001b[1Bwo\u001b[9GWAMR pins h\u001b[21Gve\u001b[24Gto move toge\u001b[37Gher.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHow I checked it:\u001b[22m in\u001b[26Gl\u001b[28Gn\u001b[30G C, a fresh \u001b[38;2;177;185;249mdevenv sh\u001b[52Gll\u001b[39m puts \u001b[38;2;177;185;249mwamrc 2.4.5\u001b[39m on the\u001b[79Gpath, and it compiled the script suite's\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mevents.wasm\u001b[39m to \u001b[21G 2\u001b[24GKB\u001b[27G\u001b[38;2;177;185;249m.aot\u001b[32G\u001b[39mfil\u001b[36G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mY\u001b[7Gur shell:\u001b[22m your current shell\u001b[36Gwon't\u001b[42Gsee it until\u001b[55Gthe change is merged to\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[92G\u001b[39mand you reload the devenv\u001b[K\r\u001b[4C\u001b[1Bthere (\u001b[38;2;177;185;249mdirenv reload\u001b[39m,\u001b[27Gor re-enter\u001b[39G\u001b[38;2;177;185;249mdevenv shell\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA catch for J04:\u001b[22m WAMR counts fuel only when it interprets\u001b[61Ga\u001b[63Gscript.\u001b[71GIts\u001b[75Gahead-of-time\u001b[89Gruntime\u001b[97Gand\u001b[101Gcompiler\u001b[110Ghave\u001b[115Gno\r\u001b[2C\u001b[1Binstruction\u001b[15Gmetering\u001b[24Gat\u001b[27Gall,\u001b[32Gso\u001b[35Gcompiled\u001b[44Gscripts\u001b[52Gwould\u001b[58Grun\u001b[62Gwith\u001b[67Gno\u001b[70Gfuel\u001b[75Glimit,\u001b[82Gstopped\u001b[90Gonly\u001b[95Gby\u001b[98Gthe\u001b[102G250\u001b[106Gms\u001b[109Gwatchdog.\r\u001b[2C\u001b[1B- \u001b[1mH\u001b[7Gndlers:\u001b[22m these run\u001b[25Goutside the\u001b[37Gstep, and\u001b[47Gthe commands they send are recor\u001b[80Ged, so compiled h\u001b[100Glers would be safe\u001b[119Gas\r\u001b[2C\u001b[1B  fa\u001b[8G as determin\u001b[21Gsm\u001b[24Ggoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mInputs and behaviour-tree tasks:\u001b[22m \u001b[39Ghese run inside the s\u001b[61Gep.\u001b[65GThe fuel\u001b[74Glimit is what keeps their r\u001b[102Gsult the\u001b[111Gsame on\u001b[119G\u001b[K\r\u001b[4C\u001b[1Bevery machine, so they have\u001b[33Gto\u001b[36Gstay\u001b[41Ginterp\u001b[27;1H\u001b[21;3H\u001b[?25h"]
