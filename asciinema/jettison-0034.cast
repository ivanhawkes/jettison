an.\u001b[52GI'm\u001b[56Gfixing\u001b[63Gthe\u001b[67Gblank\u001b[73Glines\u001b[79Gin\u001b[82G\u001b[38;2;177;185;249mScriptHost.cpp\u001b[97G\u001b[39mand\u001b[101Gcommitting\u001b[112Gpart\u001b[117G2.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+16\u001b[38;2;153;153;153m, committed \u001b[1m8625139\u001b[22m, ran \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPart\u001b[8G2\u001b[10Gis\u001b[13Gcommitted\u001b[23G(\u001b[38;2;177;185;249m8625139\u001b[39m).\u001b[34GNext\u001b[39Gis\u001b[42Gpart\u001b[47G3,\u001b[50Ga\u001b[52Gbehaviour-tree\u001b[67Gtask\u001b[72Ganswered\u001b[81Gby\u001b[84Ga\u001b[86Gscript.\u001b[94GI'm\u001b[98Greading\u001b[106Ghow\u001b[110Gan\u001b[113Ginput\r\u001b[1B \u001b[3Gc\u001b[5Gll\u001b[8Gis made, so the task call\u001b[34Gcan follow \u001b[46Ghe s\u001b[51Gme p\u001b[56Gth.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mReading\u001b[11G\u001b[1m1\u001b[13G\u001b[22mfile…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  ~/projects/jettison.lane-c/source/engine/script/src/ScriptHost.cpp\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
