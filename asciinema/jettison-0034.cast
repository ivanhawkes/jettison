[0.159, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m8\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// Halts the running tasks of the entity's tree and starts it again from the top at its next tick,\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 299 -\u001b[38;2;248;248;242m  // as taking its helm or giving it another tree does.                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 299 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// as taking its helm or giving it another tree does.\u001b[48;2;4;71;0m Asked by a command one of the tree's own tasks\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 300 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// applies as it is ticked, the rest of that tick does nothing and the halts come as it ends, since\u001b[38;2;248;248;242m \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m301\u001b[17G\u001b[38;2;117;113;94muntil then its nodes are the\u001b[46Gtick's.\u001b[38;2;248;248;242m                                                             \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 302 \u001b[22m   \u001b[38;2;166;226;46mvoid\u001b[39m \u001b[38;2;166;226;46mStop\u001b[38;2;253;151;31m(Sim::SimWorld &world, entt::entity entity)\u001b[39m;\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 303 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[14G\u001b[22mprivate:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m7\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery check is clean.\u001b[25GI'm\u001b[29Gcommitting\u001b[40Ground\u001b[46G1's\u001b[50Gfixes\u001b[56Gon\u001b[59Gthe\u001b[63Greview\u001b[70Gbranch,\u001b[78Grunning\u001b[86Gthe\u001b[90Ggate,\u001b[96Gand\u001b[100Gwriting\u001b[108Gthe\u001b[112Ground\u001b[118G1\r\u001b[2C\u001b[1Breply.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+27