[0.004, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mSubtree\u001b[13G:\u001b[22m a node\u001b[22Gca\u001b[25G name \u001b[32G tree\u001b[38Gdefined earlier, s\u001b[57G a repeated\u001b[69Gloop is\u001b[77Gwritten once.\u001b[91G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA blackboard:\u001b[22m a saved pe\u001b[30G-en\u001b[34Gity m\u001b[40Gmory of\u001b[48Gint\u001b[52Ggers and\u001b[61Gentities\u001b[70Gby\u001b[73Gkey,\u001b[78Gkept when the \u001b[93Gntity's tree\u001b[106Gchanges.\u001b[115G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA command that gives an entity a tree:\u001b[44G\u001b[22m\u001b[38;2;177;185;249mAssignBehaviour\u001b[39m.\u001b[61GIts\u001b[65Gnew\u001b[69Grefusal\u001b[77Greason,\u001b[85G\u001b[38;2;177;185;249mno_such_tree\u001b[39m,\u001b[99Ghas\u001b[103GEnglish\u001b[111Gand\u001b[115GGerman\r\u001b[2C\u001b[1B \u001b[5Gwording.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mtree ticked less often:\u001b[22m a definiti\u001b[42Gn can\u001b[48Gse\u001b[51G an interval. Entities using i\u001b[83Gar\u001b[86G spr\u001b[91Gad acros\u001b[102Gh\u001b[104G interval,\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Gthe steps between are skipped.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing already saved changes, and no pinned\u001b[48Ghash moved. E\u001b[62Gch\u001b[65Gfeatur\u001b[72G ha\u001b[76G a test in\u001b[87Gthe \u001b[38;2;177;185;249mai\u001b[94G\u001b[39msuite.\u001b[101GT\u001b[105Gdocs, decisions,\r\u001b[2C\u001b[1Bscop\u001b[8G, roadmap and history ar\u001b[33G updated.\r\u001b[2C\u001b[2BThree behaviour\u001b[19Gchanges to know about:\u001b[K\r\u001b[2C\u001b[1B- Taking \u001b[13G vehicle's helm now stops its\u001b[43Grunning\u001b[51Gtask\u001b[56Gthrough\u001b[64Gthe\u001b[68Ghalt,\u001b[74Gwhere\u001b[80Gbefore\u001b[87Git\u001b[90Gwas\u001b[94Gleft\u001b[99Gunfinished\u001b[110Gwithout\r\u001b[4C\u001b[1Bnotice.\r\u001b[2C\u001b[1B- While a reactive \u001b[23Gode\u001b[27Gis\u001b[30Grunning, its\u001b[43Gtree\u001b[48Gis\u0