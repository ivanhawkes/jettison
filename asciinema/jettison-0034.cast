[0.050, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/jettison.lane-b/docs/files-and-mods.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jetti\u001b[27Gon.lane-b/docs/physics.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, r\u001b[22Gmoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22m`C\u001b[15GstRay` finds the first body along a\u001b[51Gray. `CastShape` find\u001b[73G the firs\u001b[83G body a defined shape\r\u001b[5C\u001b[1B\u001b[2m 184 \u001b[22m meets, swept along a direction: whether a vehicle fits through a gap, or how far it can go. Both\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 185 \u001b[22m search every local frame of one frame, and both return a `CastHit` (entity, distance, point,\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 186 -\u001b[38;2;248;248;242mnormal) or nothing. `CastOptions` leaves out the caster's own body (`ignore`) and, unless             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 186 +\u001b[38;2;248;248;242mnormal) or nothing\u001b[48;2;4;71;0m; of two hits as near, the lower entity's, whichever local frame is searched first\u001b[48;2;2;40;0m. \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242m`CastOptions` leaves out the caster's own body (`ignore`) and, unless                                 \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[12G\u001b[22masked\u001b[18Gfor,\u001b[23Gsensors.\u001b[32GCasts\u001b[38Gread\u001b[43Gthe\u001b[47Gworld\u001b[53Gas\u001b[56Gthe\u001b[60Glast\u001b[65Gstep\u001b[70Gleft\u001b[75Git,\u001b[79Gand\u001b[83Gare\u001b[87Gfor\u001b[91Gthe\u001b[95Gsimulation's\r\u001b[5C\u001b[1B\u001b[2m 188 \u001b[12G\u001b[22msystems\u001b[20Gto\u001b[23Gcall.\u001b[29GSteering\u001b[38Gsweeps\u001b[45Ga\u001b[47Gvehicle's\u001b[57Gshape\u001b[63Gwith\u001b[68G`CastShape`\u001b[80G([\u001b[38;2;230;219;116mAI\u001b[39m](ai.md)).\r\u001b[1B \u001b[3G   \u001b[2m 189 \u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file, running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lan\u001b[45G-b' && pyth\u001b[57Gn3 scripts/space-declarations.py\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
