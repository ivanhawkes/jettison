[0.446, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[22m and enumerator against its legal values. Only bytes cross the boundary.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/pr\u001b[15Gj\u001b[17Gcts/j\u001b[23Gt\u001b[25Gison.lane-b/docs/scripts.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m1\u001b[22m li\u001b[34Ge\u001b[K\r\u001b[7C\u001b[1B\u001b[2m1\u001b[12G\u001b[22mte\u001b[15G's state ([\u001b[38;2;230;219;116mwhy\u001b[39m](deci\u001b[36Gions.m\u001b[43G#scripts)). A\u001b[58Gcript granted `read:<Component>`\u001b[91Gimpor\u001b[97Gs\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 92 \u001b[11G\u001b[22m`jettison_read_<Component>`,\u001b[40Gwhich\u001b[46Gtakes\u001b[52Gan\u001b[55Gentity\u001b[62Gand\u001b[66Greturns\u001b[74Gits\u001b[78Gcopy\u001b[83Gof\u001b[86Gthe\u001b[90Gcomponent\u001b[100Gas\u001b[103Gthe\r\u001b[2C\u001b[1B   \u001b[2m 93 \u001b[22m snapshot has it,\u001b[28Gor\u001b[31Gnull\u001b[36Gfor\u001b[40Gan\u001b[43Gentity\u001b[50Gwith\u001b[55Gnone\u001b[60Gthere;\u001b[67Gin\u001b[70GRust,\u001b[76G`read_<Component>(entity,\u001b[102Gf)`\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 94 -\u001b[38;2;248;248;242mgives the copy to `f` and returns what `f` answers, so safe code \u001b[48;2;92;2;0mcannot\u001b[48;2;61;1;0m keep\u001b[48;2;92;2;0m a reference to it. The com\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mponent\u001b[48;2;61;1;0m                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 94 +\u001b[38;2;248;248;242mgives the copy to `f` \u001b[48;2;4;71;0mfor any lifetime at all \u001b[48;2;2;40;0mand returns what `f` answers, so safe code \u001b[48;2;4;71;0mcan\u001b[48;2;2;40;0m keep      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 95 +\u001b[38;2;248;248;242mnothing of it, the copy, a string in it or a reference: each is refused as the script compiles         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 96 +\u001b[38;2;248;248;242m(the suite's `kept.rs`). The component                                                                 \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 97 \u001b[22m is on\u001b[17G Reflect marks `Script` and the world shows in its snapshots\r\u001b[5C\u001b[1B\u001b[2m 98 \u001b[11G\u001b[22m(`Sim::SimWorld::ShowInSnapshots`),\u001b[47Gor\u001b[50Gthe\u001b[54Ggrant\u001b[60Gdoes\u001b[65Gnot\u001b[69Gload.\u001b[75GThe\u001b[79Ggame\u001b[84Ggives\u001b[90Gthe\u001b[94Ghost\u001b[99Gthe\r\u001b[2C\u001b[1B   \u001b[2m 99 \u001b[22m snapshot once, `ScriptHost::ReadFrom`, as\u001b[53Gthe\u001b[57Gshell\u001b[63Ggives\u001b[69Gits\u001b[73Gstepper's\u001b[83Gcurrent\u001b[91Gone,\u001b[96Gthe\u001b[100Gone\u001b[104Gafter\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverythi\u001b[12Gg\u001b[14Gis clean and all 33 suites pass. Committing round 3's fixes\u001b[74Gand\u001b[78Grunning\u001b[86Gthe\u001b[90Ggate.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
