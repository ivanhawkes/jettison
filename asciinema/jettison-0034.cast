[0.073, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mOnly the Rust module changed, so I'm copying just that file. I'm also taking tidy's \u001b[38;2;177;185;249memplace_back\u001b[39m suggestion in the\u001b[118Gnew\r\u001b[2C\u001b[1Btest.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/jettison.lane-b/source/engine/ai/tests/BehaviourTreeTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 820 \u001b[22m           context.world.\u001b[38;2;166;226;46mApply\u001b[39m(Ai::AssignBehaviour{{}, context.entity, \u001b[38;2;230;219;116m\"errand\"\u001b[39m});\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 821 \u001b[20G\u001b[22m\u001b[38;2;249;38;114mreturn\u001b[27G\u001b[39mStatus::Running;\r\u001b[2C\u001b[1B   \u001b[2m 822 \u001b[22m       },\u001b[K\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 823 -\u001b[38;2;248;248;242m      {}, [&](Ai::TaskContext &) { trees.trace.\u001b[48;2;92;2;0mpush_back\u001b[48;2;61;1;0m(\"!\"); });                                    \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 823 +\u001b[38;2;248;248;242m      {}, [&](Ai::TaskContext &) { trees.trace.\u001b[38;2;166;226;46m\u001b[48;2;4;71;0memplace_back\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m(\u001b[38;2;230;219;116m\"!\"\u001b[38;2;248;248;242m); });                                 \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 824 \u001b[14G\u001b[22mtrees.behaviours.\u001b[38;2;166;226;46mDefineTree\u001b[39m(\u001b[38;2;230;219;116m\"errand\"\u001b[39m,\u001b[52G{\u001b[38;2;166;226;46mTaskNode\u001b[39m(\u001b[38;2;230;219;116m\"again\"\u001b[39m)});\r\u001b[1B \u00