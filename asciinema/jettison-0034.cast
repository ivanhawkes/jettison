[0.073, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m  94 \u001b[22m   \u001b[38;2;166;226;46mCHECK\u001b[39m(read.total == \u001b[38;2;190;132;255m-40\u001b[39m);\u001b[K\r\u001b[1B     \u001b[2m  95 \u001b[12G\u001b[22m \u001b[14G\u001b[38;2;166;226;46mCHECK\u001b[39m(read.text\u001b[30G==\u001b[33G\u001b[38;2;230;219;116m\"copper\"\u001b[39m);\r\u001b[8C\u001b[1B\u001b[2m6\u001b[25G\u001b[22mitems\u001b[34Gpong.items);\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  97 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(read.why == pong.why);                                                                        \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m8\u001b[14G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  99 \u001b[22m   \u001b[38;2;166;226;46mSUBCASE\u001b[39m(\u001b[38;2;230;219;116m\"a pointer past the end of memory is refused, naming the field\"\u001b[39m)\u001b[K\r\u001b[6C\u001b[1B\u001b[2m100\u001b[14G\u001b[22m{\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBuild passes. Next I'll regenerate the scripts'\u001b[51GC\u001b[53Gand\u001b[57GRust\u001b[62Gbindings\u001b[71Gso\u001b[74Gthey\u001b[79Ginclude\u001b[87Gthe\u001b[91Gnew\u001b[95Greason\u001b[102Gfield,\u001b[109Gthen\u001b[114Grun\u001b[118Gthe\r\u001b[2C\u001b[1Bscript\u001b[10Gsuite.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe script and app suites pass. Now I'm adding\u001b[50Gtests\u001b[56Gfor\u001b[60Gthe\u001b[64Greason\u001b[71Gkey,\u001b[76Ga\u001b[78Grefused\u001b[86Greason\u001b[93Gname,\u001b[99Gand\u001b[103Gthe\u0