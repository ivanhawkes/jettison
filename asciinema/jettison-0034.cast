[0.102, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/source/e\u001b[47Gine/dock/include/je\u001b[67Gtison/dock/Docks.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines, removed \u001b[1m3\u001b[22m l\u001b[34Ges\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 107 \u001b[12G\u001b[22m{\r\u001b[1B \u001b[3G   \u001b[2m 108 \u001b[22m   \u001b[38;2;117;113;94m// Waiting in the platform's queue for a berth.\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 109 \u001b[12G\u001b[22m \u001b[14GQueued,\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 110 -\u001b[38;2;248;248;242m  // Given a berth and on its way to \u001b[48;2;92;2;0mthe point above \u001b[48;2;61;1;0mit: round the platform's sphere to \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpoint\u001b[48;2;61;1;0m       \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 111 -\u001b[38;2;248;248;242m  // further out along the berth's normal, stopped there, then straight down the normal.              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 110 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Given a berth and on its way to it: round the platform's sphere to \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mmouth of its corridor out\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 111 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// along its normal; under a cover, among the decks and piers to the point over it.\u001b[38;2;248;248;242m                 \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 112 \u001b[22m   Inbound,\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 113 -\u001b[38;2;248;248;242m  // Coming down onto the berth from above it.                                                        \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m113\u001b[14G\u001b[38;2;117;113;94m// Coming down onto the berth: down its corridor without stopping, or from the point over it.\r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m114\u001b[14G\u001b[22mDescending,\r\u001b[6C\u001b[1B\u001b[2m115\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// Clamped to the berth: held in the platform's frame, on its rails, out of flight.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m116\u001b[14G\u001b[22mDocked,\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mReading \u001b[1m2\u001b[22m files…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  ~/projects/jettison.lane-c/docs/ai.md\u001b[39m\u001b[K\r\u001b[18C\u001b[8B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
