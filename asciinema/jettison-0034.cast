[0.024, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 91 \u001b[11G\u001b[22mstep's\u001b[18Gstate\u001b[24G([\u001b[38;2;230;219;116mwhy\u001b[39m](decisions.md#scripts)).\u001b[55GA\u001b[57Gscript\u001b[64Ggranted\u001b[72G`read:<Component>`\u001b[91Gimports\r\u001b[1B     \u001b[2m 92 \u001b[22m `jettison_\u001b[23Gad_<Component>`,\u001b[40Gwhich\u001b[46Gtakes\u001b[52Gan\u001b[55Gentity\u001b[62Gand\u001b[66Greturns\u001b[74Gits\u001b[78Gcopy\u001b[83Gof\u001b[86Gthe\u001b[90Gcomponent\u001b[100Gas\u001b[103Gthe\r\u001b[7C\u001b[1B\u001b[2m3\u001b[12G\u001b[22mna\u001b[15Gshot has\u001b[24Git, or null f\u001b[38Gr an entity with\u001b[55Gnone there; in Rust, `read_<Component>(en\u001b[97Gity,\u001b[102Gf)`\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 94 -\u001b[38;2;248;248;242mgives the copy to `f` and returns what `f` answers, so safe code \u001b[48;2;92;2;0mcannot\u001b[48;2;61;1;0m keep\u001b[48;2;92;2;0m a reference to it. The com\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mponent\u001b[48;2;61;1;0m                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 94 +\u001b[38;2;248;248;242mgives the copy to `f` \u001b[48;2;4;71;0mfor any lifetime at all \u001b[48;2;2;40;0mand returns what `f` answers, so safe code \u001b[48;2;4;71;0mcan\u001b[48;2;2;40;0m keep      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 95 +\u001b[38;2;248;248;242mnothing of it, the copy, a string in it or a reference: each is refused as the script compiles         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242m(th\u001b[15G suite's `kept.rs`). The component           \u001b[61G       \u001b[69G    \u001b[74G   \u001b[78G        \u001b[87G  \u001b[90G    \u001b[95G    \u001b[100G   \u001b[104G    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 97 \u001b[22m is one Reflect marks `Script` and the world shows in its snapshots\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 98 \u001b[22m (`Sim::SimWorld::ShowInSnapshots`), or the grant does not load. The game gives the host the\u001b[K\r\u001b[7C\u001b[1B\u001b[2m9\u001b[11G\u001b[22msnapshot once,\u001b[26G`ScriptHost::Re\u001b[42GdFrom`, as the shell g\u001b[65Gves its stepper's\u001b[83Gcurrent\u001b[91Gone,\u001b[96Gthe\u001b[100Gone\u001b[104Gafter\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything is clean and\u001b[27Gall\u001b[31G33\u001b[34Gsuites\u001b[41Gpass.\u001b[47GCommitting\u001b[58Ground\u001b[64G3's\u001b[68Gfixes\u001b[74Gand\u001b[78Grunning\u001b[86Gthe\u001b[90Ggate.\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd\u001b[14G'/hom\u001b[20G/iv\u001b[25G/projects/je\u001b[38Gtison.lane-b' && git c…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-b' && git commit -F \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m'/tmp/claude-1000/-home-ivan-projects-jettison/414e2912-7de0-46ef-bba3-922122ec86c7/scratchpad/msg-cr3.txt'\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
