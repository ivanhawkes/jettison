[0.083, "o", "\u001b[?25l\u001b[H\u001b[5Gfirst\u001b[11Gwith\u001b[16Gmode\u001b[21G0700,\u001b[27Glike\u001b[32Gthe\u001b[36Gother\u001b[42Guser\u001b[47Gdirectories.\r\u001b[1B  - The new test writes a log in\u001b[34Ga\u001b[36Gfresh\u001b[42Gdirectory\u001b[52Gand\u001b[56Gfinds\u001b[62Gthe\u001b[66GInfo\u001b[71Gline\u001b[76Gin\u001b[79Git\u001b[82Gbut\u001b[86Gnot\u001b[90Gthe\u001b[94GDebug\u001b[100Gone.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ03, behaviour trees (\u001b[38;2;177;185;249med57c63\u001b[39m).\u001b[22m A\u001b[37Gl\u001b[39Gseven\u001b[45Gitems\u001b[51Gare\u001b[55Gin:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReactive sequence and selector:\u001b[37G\u001b[22mthey\u001b[42Gcheck\u001b[48Gwhat\u001b[53Gcomes\u001b[59Gbefore\u001b[66Ga\u001b[68Grunning\u001b[76Gbranch\u001b[83Gon\u001b[86Gevery\u001b[92Gtick,\u001b[98Gand\u001b[102Gstop\u001b[107Gthe\u001b[111Gbranch\r\u001b[1B    they l\u001b[12Gave.\u001b[K\r\u001b[1B  - \u001b[1mA task's halt:\u001b[22m a running task is told when\u001b[48Git\u001b[51Gis\u001b[54Gstopped,\u001b[63Gso\u001b[66Git\u001b[69Gcan\u001b[73Glet\u001b[77Ggo\u001b[80Gof\u001b[83Gwhat\u001b[88Git\u001b[91Gholds.\r\u001b[1B  - \u001b[1mParallel:\u001b[22m runs its children\u001b[33Gtogether\u001b[42Guntil\u001b[48Ga\u001b[50Gset\u001b[54Gnumber\u001b[61Gsucceed,\u001b[70Gor\u001b[73Gthat\u001b[78Gnumber\u001b[85Gcan't\u001b[91Gbe\u001b[94Greached.\u001b[103GIt\u001b[106Gtakes\u001b[112Gat\u001b[115Gmost\r\u001b[1B    32 chil\u001b[13Gren.\u001b[K\r\u001b[1B  - \u001b[1mSubtrees:\u001b[22m a node can name a\u001b[33Gtree\u001b[38Gdefined\u001b[46Gearlier,\u001b[55Gso\u001b[58Ga\u001b[60Grepeated\u001b[69Gloop\u001b[74Gis\u001b[77Gwritten\u001b[85Gonce.\r\u001b[1B  - \u001b[1mA blackboard:\u001b[22m a saved\u001b[27Gper-entity\u001b[38Gmemory\u001b[45Gof\u001b[48Gintegers\u001b[57Gand\u001b[61Gentities\u001b[70Gby\u001b[73Gkey,\u001b[78Gkept\u001b[83Gwhen\u001b[88Gthe\u001b[92Gentity's\u001b[101Gtree\u001b[106Gchanges.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA command that gives an entity a tree:\u001b[44G\u001b[22m\u001b[38;2;177;185;249mAssignBehaviour\u001b[39m.\u001b[61GIts\u001b[65Gnew\u001b[69Grefusal\u001b[77Greason,\u001b[85G\u001b[38;2;177;185;249mno_such_tree\u001b[39m,\u001b[99Ghas\u001b[103GEnglish\u001b[111Gand\u001b[115GGerman\r\u001b[4C\u001b[1Bwording.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA tree ticked less often:\u001b[31G\u001b[22ma\u001b[33Gdefinition\u001b[44Gcan\u001b[48Gset\u001b[52Gan\u001b[55Ginterval.\u001b[65GEntities\u001b[74Gusing\u001b[80Git\u001b[83Gare\u001b[87Gspread\u001b[94Gacross\u001b[101Gthe\u001b[105Ginterval,\u001b[115Gand\r\u001b[4C\u001b[1Bthe steps\u001b[15Gbetween\u001b[23Gare\u001b[27Gskipped.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNothing\u001b[11Galready\u001b[19Gsaved\u001b[25Gchanges,\u001b[34Gand\u001b[38Gno\u001b[41Gpinned\u001b[48Ghash\u001b[53Gmoved.\u001b[60GEach\u001b[65Gfeature\u001b[73Ghas\u001b[77Ga\u001b[79Gtest\u001b[84Gin\u001b[87Gthe\u001b[91G\u001b[38;2;177;185;249mai\u001b[94G\u001b[39msuite.\u001b[101GThe\u001b[105Gdocs,\u001b[111Gdecisions,\r\u001b[1B \u001b[3Gscope, roadmap and history\u001b[30Gare\u001b[34Gupdated.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThree\u001b[9Gbehaviour\u001b[19Gchanges\u001b[27Gto\u001b[30Gknow\u001b[35Gabout:\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
