[0.237, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m# WAMR's ahead-of-time compiler, wamrc (docs/scripts.md): a script's .wasm compiled to an .aot the\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m# runtime loads in place of interpreting it. nixpkgs' wamr package builds only iwasm, so this builds\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  3 \u001b[22m\u001b[38;2;117;113;94m# wamr-compiler from the same release the engine's runtime is fetched at\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# (source/external/CMakeLists.txt, GIT_TAG): an .aot file carries the format version of the wamrc\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# that wrote it, and a runtime of another release may refuse it. Bump the two together.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m#\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  7 \u001b[22m\u001b[38;2;117;113;94m# LLVM 18 is the release WAMR 2.4.5 builds and tests wamrc against (build-scripts/build_llvm.py,\r\u001b[1B\u001b[39m     \u001b[2m  8 \u001b[22m\u001b[38;2;117;113;94m# release/18.x); the engine's own toolchain stays at LLVM 21.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  9 \u001b[22m{\r\u001b[1B \u001b[3G   \u001b[2m 10 \u001b[22m  lib,\u001b[17G\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m… +49 lines \u001b[19G\u001b[39m\u001b[K\r\u001b[10C\u001b[2B\u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[58C\u001b[3B\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[3GMetamorphosing…\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m2\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
