[0.102, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/jettison.lane-c/source/external/wamr/fuel-left.patch)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, r\u001b[22Gmoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[2m 69 \u001b[22m +#endif\u001b[K\r\u001b[6C\u001b[1B\u001b[2m70\u001b[11G\u001b[22m       \u001b[20Greturn;\r\u001b[7C\u001b[1B\u001b[2m1\u001b[20G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 72 -\u001b[38;2;248;248;242m #if WASM_ENABLE_LABELS_AS_VALUES == 0                                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m    \u001b[2m\\ No newline at end of file\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 72 +\u001b[38;2;248;248;242m #if WASM_ENABLE_LABELS_AS_VALUES == 0                                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The WAMR patch is ready as three small hunks that return unused fuel from a call. I'm applying it once\u001b[106Gthe\u001b[110Gbuild\u001b[116Gis\r\u001b[2C\u001b[1Bconfigured, then wiring the fuel count into \u001b[38;2;177;185;249mScriptHost\u001b[39m and the \u001b[38;2;177;185;249mscripts\u001b[39m console\u001b[82Gcommand.\u001b[38;2;153;153;153m · summary\r\u001b[39C\u001b[2Bthought for 6s)\u001b[39m\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
