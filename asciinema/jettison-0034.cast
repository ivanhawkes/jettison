[0.102, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/physics/src/PhysicsWorld.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m4\u001b[14G\u001b[22mlines\u001b[20G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22m \u001b[18G{\u001b[20G\u001b[38;2;249;38;114mreturn\u001b[27G\u001b[39mstd::\u001b[38;2;166;226;46mtie\u001b[39m(a.distance,\u001b[48Ga.entity)\u001b[58G<\u001b[60Gstd::\u001b[38;2;166;226;46mtie\u001b[39m(b.distance,\u001b[81Gb.entity);\u001b[92G});\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m}\r\u001b[5C\u001b[1B\u001b[2m 435 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[12G\u001b[38;2;117;113;94m// How much further along a cast than its nearest hit another is still met, a share of its length.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mfloat\u001b[38;2;248;248;242m kLevelFraction = \u001b[38;2;190;132;255m1.0e-5f\u001b[38;2;248;248;242m;                                                             \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\r\u001b[5C\u001b[1B 439 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m0\u001b[15G\u001b[22m\u001b[38;2;117;113;94mEvery hit\u001b[25Gas near as the\u001b[40Gnear\u001b[45Gst: Jolt's closest-hit collector keeps th\u001b[87G f\u001b[90Grst of two as near that\r\u001b[8C\u001b[1B\u001b[39m\u001b[2m1\u001b[15G\u001b[22m\u001b[38;2;117;113;94mi\u001b[17G mee\u001b[23G, whichever body it searched first,\u001b[59Gwhere the tie is the lower entity's (NearestPerBody).\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 442 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m// Its hits are named as Jolt's own collectors name theirs.\r\u001b[1B\u001b[39m\u001b[K\r