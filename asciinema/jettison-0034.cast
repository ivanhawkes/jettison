[0.148, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhy is the steering being so difficult to code without error and omission?\u001b[39m                                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth the planner and the steering each hold half the picture, so courses that look correct on paper can still fail\u001b[118Gin\r\u001b[2C\u001b[1Bflight; I'm adding corner slowing and capping the resting floor by clearance, then moving on to F22.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/script/src/ScriptHost.c\u001b[75Gp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m10\u001b[15G\u001b[22mlines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m1\u001b[15G\u001b[22m\u001b[38;2;249;38;114mif\u001b[18G\u001b[39m(pScript->\u001b[38;2;102;217;239mmodule\u001b[35G\u001b[39m==\u001b[38G\u001b[38;2;190;132;255mnullptr\u001b[39m)\r\u001b[8C\u001b[1B\u001b[2m1\u001b[17G\u001b[22m\u001b[38;2;249;38;114mthrow\u001b[39m \u001b[38;2;166;226;46mfail\u001b[39m(std::f\u001b[36Gmat(\u001b[38;2;230;219;116m\"'{}' is not a module it can run: {}\"\u001b[39m,\u001b[79Gdefinition.\u001b[38;2;102;217;239mmodule\u001b[39m,\u001b[98Gerror.\u001b[38;2;166;226;46mdata\u001b[39m()));\r\u001b[8C\u001b[1B\u001b[2m1\u001b[17G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[15G\u001b[38;2;117;113;94m// WAMR runs a start function and these exports as it instantiates, before a call's fuel and time\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[15G\u001b[38;2;117;113;94m// limit are set, so a module with any of them is refused rather than run unbounded.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[15G\u001b[38;2;249;38;114mif\u001b[38;2;248;248;242m (\u001b[38;2;166;226;46mHasStart\u001b[38;2;248;248;242m(pScript->bytes))       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[17G\u001b[38;2;249;38;114mthrow\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mfail\u001b[38;2;248;248;242m(std::format(\u001b[38;2;230;219;116m\"its module '{}' has a start function\"\u001b[38;2;248;248;242m,\u001b[80Gdefinition.\u001b[38;2;102;217;239mmodule\u001b[38;2;248;248;242m));\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 1018 \u001b[22m   pScript->memoryPages = definition.memoryPages;\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1019 \u001b[22m   \u001b[38;2;166;226;46mconst\u001b[39m std::\u001b[38;2;166;226;46mint32_t\u001b[39m exports = \u001b[38;2;166;226;46mwasm_runtime_get_export_count\u001b[39m(pScript->\u001b[38;2;102;217;239mmodule\u001b[39m);\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[15G\u001b[22m\u001b[38;2;249;38;114mfor\u001b[39m (std::\u001b[38;2;166;226;46mint32_t\u001b[39m index = \u001b[38;2;190;132;255m0\u001b[39m; index < exports; ++index\r\u001b[8C\u001b[1B\u001b[2m2\u001b[15G\u001b[22m{\u001b[19G         \u001b[27;1H\u001b[24;3H\u001b[?25h"]
