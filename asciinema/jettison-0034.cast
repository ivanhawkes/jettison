[0.397, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ10, the shell's log file (\u001b[38;2;177;185;249m7138f4d\u001b[39m).\u001b[40G\u001b[22mWritten\u001b[48Gby\u001b[51Gthe\u001b[55Gsubagent\u001b[64Gin\u001b[67Glane\u001b[72GB,\u001b[75Greviewed\u001b[84Gby\u001b[87Gme.\r\u001b[4C\u001b[1BEach run writes \u001b[38;2;177;185;249mjettison.log\u001b[39m to the stat\u001b[46G d\u001b[49Grectory: \u001b[38;2;177;185;249m~/.local/state/jettison/\u001b[39m, or \u001b[38;2;177;185;249m<dir>/state/\u001b[100G\u001b[39munder\u001b[106G\u001b[38;2;177;185;249m--user-dir\u001b[39m.\r\u001b[4C\u001b[1BIt takes Info and above, a\u001b[32Gd each run overwrit\u001b[52Gs\u001b[54Git. If\u001b[61Gthe file\u001b[70Gcan't be opened, the\u001b[91Grun logs a warning and carries\r\u001b[4C\u001b[1Bon.\u001b[K\r\u001b[4C\u001b[1BI fixed one\u001b[17Gthing i\u001b[26Greview: th\u001b[38Glog was\u001b[46Gcreating\u001b[55Gthe stat\u001b[64G direct\u001b[72Gry with default permissions.\u001b[101GIt's\u001b[106Gnow\u001b[110Gcreated\r\u001b[2C\u001b[1B \u001b[5Gfirst with mode\u001b[21G0700,\u001b[27Glike the oth\u001b[40Gr user d\u001b[49Grecto\u001b[55Gies.\u001b[K\r\u001b[4C\u001b[1BThe new test writes a log in a fresh directory and finds \u001b[63Ghe Info line in it but not the Debug one.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ03, b\u001b[10Ghav\u001b[14Gour tr\u001b[21Ge\u001b[24G(\u001b[38;2;177;185;249med57c63\u001b[39m).\u001b[22m All seven items are\u001b[57G:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReactive sequence and selector:\u001b[37G\u001b[22mthey\u001b[42Gcheck\u001b[48Gwhat\u001b[53Gcomes\u001b[59Gbefore\u001b[66Ga\u001b[68Grunning\u001b[76Gbranch\u001b[83Gon\u001b[86Gevery\u001b[92Gtick,\u001b[98Gand\u001b[102Gstop\u001b[107Gthe\u001b[111Gbranch\r\u001b[4C\u001b[1Bthey\u001b[10Gleave.\r\u001b[2C\u001b[1B- \u001b[1mA task's halt:\u001b[22m \u001b[21G running task is\u001b[38Gt\u001b[40Gld wh\u001b[46Gn\u001b[48Git is stopped, so it can\u001b[73Glet\u001b[77Ggo of what it\u001b[91Gholds.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mParallel:\u001b[22m runs its children togeth\u001b[40Gr until\u001b[48Ga\u001b[50Gset\u001b[54Gnumber\u001b[61Gsucceed,\u001b[70Gor\u001b[73Gthat\u001b[78Gnumber\u001b[85Gcan't\u001b[91Gbe\u001b[94Greached.\u001b[103GIt\u001b[106Gtakes\u001b[112Gat\u001b[115Gmost\r\u001b[4C\u001b[1B32\u001b[8Gchildren.\r\u001b[2C\u001b[1B- \u001b[1mSubtrees:\u001b[22m a node can name a tree defined\u001b[46Gearlier,\u001b[55Gso\u001b[58Ga\u001b[60Grepeated\u001b[69Gloop\u001b[74Gis\u001b[77Gwritten\u001b[85Gonce.\r\u001b[4C\u001b[1B\u001b[1mA blackboard:\u001b[22m a saved per-entity memory of integers and entities by key, kept wh\u001b[86Gn \u001b[89Ghe entity's tree changes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA command that gives an entity a tree:\u001b[44G\u001b[22m\u001b[38;2;177;185;249mAssignBehaviour\u001b[39m.\u001b[61GIts\u001b[65Gnew\u001b[69Grefusal\u001b[77Greason,\u001b[85G\u001b[38;2;177;185;249mno_such_tree\u001b[39m,\u001b[99Ghas\u001b[103GEnglish\u001b[111Gand\u001b[115GGerman\r\u001b[2C\u001b[1B \u001b[5Gwording.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA tree ticked less often:\u001b[22m a d\u001b[35Gfinition\u001b[44Gcan\u001b[76Ging\u001b[80Git\u001b[83Gare\u001b[87Gspread\u001b[94Gacross\u001b[101Gthe\u001b[105Ginterval,\u001b[115Gand\u001b[27;1H\u001b[24;3H\u001b[?25h"]
