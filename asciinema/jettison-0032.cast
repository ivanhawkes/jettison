to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.                      \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[3.117, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So Manifes\u001b[30G has to be\u001b[41Gpinned to that\u001b[56Gengine commit\u001b[70Grath\u001b[75Gr than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the dev \u001b[100Ghell files\u001b[111Ghaven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhere\u001b[10Ghings stand:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite has a test\u001b[39Gfor\u001b[43Gthe\u001b[47G0600 write, and\u001b[63Gthe full gate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[4C\u001b[1Bcommitted.\r\u001b[2C\u001b[1B- \u001b[1mManifes\u001b[13G\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m, branch \u001b[38;2;177;185;249madopt-encryption\u001b[39m), bui\u001b[62Gt against the local engine:\u001b[90G\u001b[K\r\u001b[2C\u001b[1B  - \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--replace]\u001b[39m writes the sec\u001b[68Get key at 0600 (default\u001b[K\r\u001b[2C\u001b[1B    \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m),\u001b[47Grints the public\u001b[64Gkey once, and r\u001b[80Gfuses\u001b[86Gto overwrite a\u001b[101G \u001b[103Gxisting key\u001b[115Gunless\r\u001b[2C\u001b[1B    giv\u001b[11Gn \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B  - \u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe server won't start if the key file\u001b[77Gis missing or\u001b[91Gdo\u001b[94Gsn't\u001b[99Ghold a key,\u001b[111Gand the\r\u001b[2C\u001b[1B    error\u001b[13Gnames\u001b[19Gthe\u001b[23Gfile.\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mRemote::Client\u001b[22G\u001b[39mnow\u001b[26Gtakes\u001b[32Gthe\u001b[36Gserver's\u001b[45Gpublic\u001b[52Gkey.\u001b[57GThe\u001b[61Gconsole's\u001b[71G\u001b[38;2;177;185;249mconnect\u001b[79G\u001b[39mlooks\u001b[85Git\u001b[88Gup\u001b[91Gby\u001b[94Gexact\u001b[100G\u001b[38;2;177;185;249mhost:port\u001b[110G\u001b[39min\u001b[113Gthe\r\u001b[2C\u001b[1B    player's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/servers.yaml\u001b[39m,\u001b[56Gor\u001b[59Gfailing\u001b[67Gthat\u001b[72Gthe\u001b[76Gbuild's\u001b[84G\u001b[38;2;177;185;249mshare/manifest/servers.yaml\u001b[39m.\u001b[113GThe\r\u001b[2C\u001b[1B \u001b[5G  shipped list is empty, and\u001b[34G\u001b[38;2;177;185;249mstage-bundle.sh\u001b[39m adds it to the bund\u001b[70Ge.\u001b[K\r\u001b[4C\u001b[1B- Tes\u001b[11Gs:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G  - \u001b[38;2;177;185;249mremote\u001b[39m covers a client\u001b[32Gpin\u001b[36Ged\u001b[39Gto the wrong key (\u001b[38;2;177;185;249mKeyMismatch\u001b[39m), the 0600 file, and\u001b[90Gmissing\u001b[98Gor\u001b[101Gbad\u001b[105Gkey\u001b[109Gfiles.\r\u001b[4C\u001b[1B \u001b[7G- \u001b[38;2;177;185;249mconsole\u001b[39m covers an endpoint with no pinned key and a k\u001b[63Gy mismatch.\u001b[75G\u001b[K\r\u001b[6C\u001b[1B- \u001b[38;2;177;185;249mcli_serve\u001b[39m covers 0600, refusing to ove\u001b[48Gwrite, \u001b[38;2;177;185;249m--replace\u001b[39m, and a missing or bad key.\u001b[K\r\u001b[6C\u001b[1B- \u001b[38;2;177;185;249mbundle_smoke\u001b[39m connects\u001b[31Gthe\u001b[35Gterminal\u001b[44GUI\u001b[76Gt.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
