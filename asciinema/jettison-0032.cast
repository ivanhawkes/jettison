[0.052, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m \u001b[31Gi\u001b[34G\u001b[K\r\u001b[1B     \u001b[2m 11 \u001b[22m \u001b[38;2;117;113;94m// keys made with the secret key manifest-token key wrote, whose public half each client pins, and\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m2\u001b[14G\u001b[22m\u001b[38;2;117;113;94mstops cl\u001b[23Ganly on SIGINT or SIGTERM: i\u001b[52G admits nothing more, runs what it admitted i\u001b[98G one last step,\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m3\u001b[14G\u001b[22m\u001b[38;2;117;113;94manswers it and writes a\u001b[38Gsnapshot, losing no\u001b[58Ghi\u001b[61Gg. The\u001b[68Gp\u001b[71Gt defaults \u001b[83Go 0, an ephemeral one, which\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 14 -\u001b[38;2;248;248;242m// the serving line names.                                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 14 +\u001b[38;2;117;113;94m// the serving line names\u001b[48;2;4;71;0m, with the public half of the key\u001b[48;2;2;40;0m.\u001b[38;2;248;248;242m                                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 15 \u001b[22m \u001b[38;2;117;113;94m// manifest <options> --restore <backup> [--world <directory>]: restores the backup into the\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[14G\u001b[22m\u001b[38;2;117;113;94mdirectory, wh\u001b[28Gch must be empty, and recovers it to check it,\u001b[75Gfor --serve to serve. The backup is\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m7\u001b[14G\u001b[22m\u001b[38;2;117;113;94monly read.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m1\u001b[19G\u001b[22mpattern\u001b[38;2;153;153;153m · 59s\u001b[39m…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/mani