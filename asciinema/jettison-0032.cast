[0.158, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m4\u001b[10G\u001b[22ma statement \u001b[38;2;249;38;114mor\u001b[39m a block, so the code before it stands \u001b[38;2;249;38;114mas\u001b[39m its own block (docs/coding-standards.md).\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 5 -\u001b[38;2;248;248;242mWith --check it fails naming the files that lack them.                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 5 +\u001b[38;2;248;248;242mIt changes nothing inside a raw string literal, which \u001b[38;2;249;38;114mis\u001b[38;2;248;248;242m data, \u001b[38;2;249;38;114mnot\u001b[38;2;248;248;242m code. With --check it fails          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 6 +\u001b[38;2;248;248;242mnaming the files that lack them.                                                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 7 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 8 \u001b[22m clang-\u001b[38;2;166;226;46mformat\u001b[39m cannot: SeparateDefinitionBlocks leaves declarations alone \u001b[38;2;249;38;114mand\u001b[39m collapses two blank\u001b[K\r\u001b[6C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mlines\u001b[16Gto\u001b[19Gone.\u001b[24GSo\u001b[27Gclang-query\u001b[39Gfinds\u001b[45Gthe\u001b[49Gdeclarations,\u001b[63G\u001b[38;2;249;38;114min\u001b[66G\u001b[39mevery\u001b[72Gtracked\u001b[80Gunit\u001b[85Gof\u001b[88Gthe\u001b[92Gclang-debug\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRule added to \u001b[38;2;177;185;249mdocs/coding-standards.md\u001b[39m. Waiting for lane C's build and suites.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison builds and all\u001b[27G32\u001b[30Gsuites\u001b[37Gpass\u001b[42Gwith\u001b[47Gthe\u001b[51Gspacing.\u001b[60GNow\u001b[64GManifest:\u001b[74Gchecking\u001b[