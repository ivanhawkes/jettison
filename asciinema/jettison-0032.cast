[0.041, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m2\u001b[12G\u001b[22m\u001b[38;2;117;113;94mUpdating\u001b[21Gthis commit and th\u001b[40G development she\u001b[58G is one SDK ch\u001b[73Gnge. Fetch the engine\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;117;113;94mfirs\u001b[17G: EnTT, yaml-cpp and doct\u001b[43Gst must be its targets, never second copies h\u001b[89Gre.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 4 -\u001b[38;2;248;248;242mset(MANIFEST_JETTISON_REVISION 70cd4dee871888c306e8ef074eb186f60be29077)                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 4 +\u001b[38;2;249;38;114mset\u001b[38;2;248;248;242m(MANIFEST_JETTISON_REVISION \u001b[38;2;190;132;255m7\u001b[38;2;248;248;242ma2d93698bf6735208b549f6e7bd1197ecb45bf9)                                \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 5 \u001b[22m \u001b[38;2;249;38;114mset\u001b[39m(JETTISON_SOURCE_DIR \u001b[38;2;230;219;116m\"\"\u001b[39m CACHE PATH \u001b[38;2;230;219;116m\"Use a local Jettison checkout instead of the pinned revision\"\u001b[39m)\u001b[K\r\u001b[6C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[38;2;249;38;114mif\u001b[39m(\u001b[38;2;249;38;114mNOT\u001b[39m \u001b[38;2;249;38;114mTARGET\u001b[39m Jettison::\u001b[38;2;249;38;114mMath\u001b[39m)\u001b[K\r\u001b[6C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;2;249;38;114mif\u001b[39m(JETTISON_SOURCE_DIR)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mAdd the lines of code to print the public key in the server startup output.\u001b[39m                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAdding\u001b[10Git:\u001b[14Gthe\u001b[18Gserver\u001b[25Gkeeps\u001b[31Gthe\u001b[35Gpublic\u001b[42Ghalf\u001b[47Gof\u001b[50Gits\u001b[54Gkey\u001b[58Gand\u001b[62Gputs\u001b[67Git\u001b[70Gin\u001b[73Gthe\u001b[77Gserving\u001b[85Gline.\u001b[91GThe\u001b[95Gsmoke\u001b[101Gtest\u001b[106Gwill\u001b[111Gcheck\u001b[117Git\r\u001b[1B \u001b[3Gmatches wha\u001b[15G \u001b[38;2;177;185;249mmanifest-token key\u001b[36G\u001b[39mrinted.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m1\u001b[19G\u001b[22mpattern,\u001b[28Grunning\u001b[36G\u001b[1m1\u001b[38G\u001b[22mshell\u001b[44Gcommand…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/manifest.lane-b' && cmake --preset clang-debug -DJETTISON_SOURCE_DIR= > \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mbuild/reconfigure.log 2>&1; echo $?; gr\u001b[46Gp -n \"JETTISON_SOURCE_DIR\" build/clang-debug/CMakeCache.txt\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.166, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 190 +\u001b[38;2;248;248;242m      world.\u001b[38;2;166;226;46mClock\u001b[38;2;248;248;242m().\u001b[38;2;166;226;46mStep\u001b[38;2;248;248;242m(), journal.\u001b[38;2;166;226;46mWorld\u001b[38;2;248;248;242m(), journal.\u001b[38;2;166;226;46mHead\u001b[38;2;248;248;242m(), server.\u001b[38;2;166;226;46mPublicKey\u001b[38;2;248;248;242m());                     \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m191 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 192 \u001b[22m   Jettison::Time::FixedStepAccumulator steps{world.\u001b[38;2;166;226;46mFixedStep\u001b[39m()};\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 193 \u001b[22m   \u001b[38;2;249;38;114mauto\u001b[39m last = std::chrono::steady_clock::\u001b[38;2;166;226;46mnow\u001b[39m();\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest.lane-b/source/apps/manifest/main.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 11 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// keys made with the secret key manifest-token key wrote, whose public half each client pins, and\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 12 \u001b[22m \u001b[38;2;117;113;94m// stops cleanly on SIGINT or SIGTERM: it admits nothing more, runs what it admitted in one last step,\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 13 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// answers it and writes a snapshot, losing nothing. The port defaults to 0, an ephemeral one, which\r\u001b[1B\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 14 -\u001b[38;2;248;248;242m// the serving line names.                                                                             \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 14 +\u001b[38;2;117;113;94m// the serving line names\u001b[48;2;4;71;0m, with the public half of the key\u001b[48;2;2;40;0m.\u001b[38;2;248;248;242m                                            \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 15 \u001b[22m \u001b[38;2;117;113;94m// manifest <options> --restore <backup> [--world <directory>]: restores the backup into the\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 16 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// directory, which must be empty, and recovers it to check it, for --serve to serve. The backup is\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 17 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// only read.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Searching for \u001b[1m1\u001b[22m pattern…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Foun\u001b[11G \u001b[1m4\u001b[22m new diagnostic issues in\u001b[39G4 files (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;218;124;92mReticulating…\u001b[22G\u001b[38;2;153;153;153m4\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
