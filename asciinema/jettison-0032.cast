[0.016, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 330 \u001b[12G\u001b[22m```cpp\r\u001b[1B     \u001b[2m 331 \u001b[12G\u001b[22mClie\u001b[17Gt player{\"127.0.0.1\",\u001b[39Gport,\u001b[45GserverKey,\u001b[56GadaToken};\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manif\u001b[27Gst.lane-b/docs/server.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, remov\u001b[27Gd\u001b[29G\u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 370 \u001b[22m The settled choices are in [\u001b[38;2;230;219;116mdecisions\u001b[39m](decision-ledger.md#the-dedicated-server-and-remote-clients):\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 371 \u001b[22m the split between Jettison's networking and Manifest's server ([\u001b[38;2;230;219;116mD-057\u001b[39m](decision-ledger.md#d-057)),\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 372 \u001b[22m UDP through ENet ([\u001b[38;2;230;219;116mD-079\u001b[39m](decision-ledger.md#d-079)), bearer tokens\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 373 -\u001b[38;2;248;248;242m([D-080](decision-ledger.md#d-080)), every connection sealed to the server's key\u001b[48;2;92;2;0m ([D-081](decision-led\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m     -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mger.md#d-081)),\u001b[48;2;61;1;0m                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 373 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-080\u001b[38;2;248;248;242m](decision-ledger.md#d-080)), every connection sealed to the server's key                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 374 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-081\u001b[38;2;248;248;242m](decision-ledger.md#d-081)),                                                                  \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 375 \u001b[12G\u001b[22mand\u001b[16Gthree\u001b[22Gsessions\u001b[31Gan\u001b[34Gactor\u001b[40G([\u001b[38;2;230;219;116mD-082\u001b[39m](decision-ledger.md#d-082)).\u001b[77GHow\u001b[81Gthe\u001b[85Gserver\u001b[92Gcame\u001b[97Gto\u001b[100Gbe\u001b[103Gis\u001b[106Gin\u001b[109Gthe\r\u001b[1B \u001b[3G   \u001b[2m 376 \u001b[22m records:\u001b[21Gthe\u001b[25G[network\r\u001b[1B     \u001b[2m 377 \u001b[22m contract](history/gameplay-and-server-plan.md#network-contract-n01-2026-11-20),\u001b[92G[the\u001b[97Gdedicated\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~/projects/manifest.lane-b/docs/decision-ledger.md) (3m 16s)\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[39m\u001b[27;1H\u001b[24;49H\u001b[?25h"]
