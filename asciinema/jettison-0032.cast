[0.030, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 75 \u001b[22m   m_pSwapchain->Recreate();\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m  // The\u001b[20Gpipelines\u001b[30Gwere\u001b[35Gbuilt\u001b[41Gfor\u001b[45Gthe\u001b[49Gswapchain's\u001b[61Gformat,\u001b[69Gand\u001b[73Gthe\u001b[77Gsurface\u001b[85Gis\u001b[88Gthe\u001b[92Gsame\u001b[97Gone,\u001b[102Gso\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 78 -\u001b[38;2;248;248;242m  // only the targets the size names are made again.                                                   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 79 -\u001b[38;2;248;248;242m  RecreateTargets();                                                                                   \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 78 +\u001b[38;2;248;248;242m  // the format is too; a surface that changed its mind would need them rebuilt.                       \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 79 +\u001b[38;2;248;248;242m  if (m_pSwapchain->GetImageFormat() != format)                                                        \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m80\u001b[11G\u001b[22m```\u001b[K\r\u001b[6C\u001b[1B\u001b[2m81\r\u001b[6C\u001b[1B82\u001b[11G\u001b[22mclang-format ca\u001b[27Gnot add\u001b[35Gthese\u001b[41Glines, so `s\u001b[54Gripts/space-declara\u001b[74Gion\u001b[78G.py` doe\u001b[87G, run by ha\u001b[99Gd rather\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe comment-spacing rule is applied to Jettison (1,264 blank lines across 258 files, verified as blank-only changes);\r\u001b[2C\u001b[1BI'm waiting on the Manifest gate before committing and then applying the rule to Manifest.\u001b[38;2;153;153;153m · summary\u001b[39m\u0