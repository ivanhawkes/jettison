[0.090, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m8\u001b[10G\u001b[22mclang-\u001b[38;2;166;226;46mformat\u001b[23G\u001b[39mcannot:\u001b[31GSeparateDefinitionBlocks\u001b[56Gleaves\u001b[63Gdeclarations\u001b[76Galone\u001b[82G\u001b[38;2;249;38;114mand\u001b[86G\u001b[39mcollapses\u001b[96Gtwo\u001b[100Gblank\r\u001b[6C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mlines to one. So clang-query finds \u001b[46Ghe declarations,\u001b[63G\u001b[38;2;249;38;114min\u001b[39m every tracked unit of the clang-de\u001b[101Gug\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRule\u001b[8Gadded\u001b[14Gto\u001b[17G\u001b[38;2;177;185;249mdocs/coding-standards.md\u001b[39m.\u001b[43GWaiting\u001b[51Gfor\u001b[55Glane\u001b[60GC's\u001b[64Gbuild\u001b[70Gand\u001b[74Gsuites.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison\u001b[12Gbuilds\u001b[19Gand\u001b[23Gall\u001b[27G32\u001b[30Gsuites\u001b[37Gpass\u001b[42Gwith\u001b[47Gthe\u001b[51Gspacing.\u001b[60GNow\u001b[64GManifest:\u001b[74Gchecking\u001b[83Gits\u001b[87Gformat-check\u001b[100Gexclusions,\u001b[112Gthen\r\u001b[1B \u001b[3Grunn\u001b[8Gng the script with\u001b[27G\u001b[38;2;177;185;249m--root\u001b[39m in\u001b[37Gl\u001b[39Gne\u001b[42GB.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gscript\u001b[14Ghanded\u001b[21Gclang-query\u001b[33Grelative\u001b[42Gpaths,\u001b[49Gwhich\u001b[55Gonly\u001b[60Gworked\u001b[67Gfrom\u001b[72GJettison's\u001b[83Gown\u001b[87Groot.\u001b[93GFixing\u001b[100Git\u001b[103Gto\u001b[106Gpass\u001b[111Gabsolute\r\u001b