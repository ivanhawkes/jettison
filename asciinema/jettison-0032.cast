[0.025, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mOnly the file-permission change tou\u001b[40Ges non-n\u001b[49Gtwork\u001b[55Gengine code, and my Manifest diff\u001b[89Gdoesn't touch the simulation,\u001b[119Gso\r\u001b[2C\u001b[1Bthe\u001b[7Gcause\u001b[13Gmay\u001b[17Glie\u001b[21Goutside\u001b[29Gthis\u001b[34Gbranch.\u001b[42GI'm\u001b[46Gchecking\u001b[55Gthe\u001b[59G\u001b[38;2;177;185;249mtrade\u001b[65G\u001b[39mfailure\u001b[73Gand\u001b[77Gwhich\u001b[83Gstage\u001b[89Gbroke\u001b[95Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe \u001b[38;2;177;185;249mtrade\u001b[13G\u001b[39mfailure is content:\u001b[33Gwater's\u001b[41Gbase price com\u001b[56Gs \u001b[61G 0.75\u001b[67Ginstead\u001b[75Gof\u001b[78G1.\u001b[81GThat\u001b[86Gpoints\u001b[93Gat\u001b[96Gthe\u001b[100Glane's\u001b[107Ggenerated\r\u001b[2C\u001b[1Bdata,\u001b[9Gnot\u001b[13Gthe\u001b[17Gcode.\u001b[23GComparing\u001b[33Git\u001b[36Gwith\u001b[41Gthe\u001b[45Gprimary\u001b[53Gcheckout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, ran \u001b[1m9\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249mtrade\u001b[39m fails \u001b[17G the primary checkout's build too,\u001b[52Gso\u001b[55Git\u001b[58Gpredates\u001b[67Gthis\u001b[72Gbranch.\u001b[80GChecking\u001b[89Gwhether\u001b[97Git's\u001b[102Gthe\u001b[106Gcontent\r\u001b[2C\u001b[1Btoolchain,\u001b[14Gsince\u001b[20Gthe\u001b[24Gdata\u001b[29Gis\u001b[32Ggenerated\u001b[42Gby\u001b[45Gyq.\r\u001b[1B\u001b[K\r\u001b[1B\u00