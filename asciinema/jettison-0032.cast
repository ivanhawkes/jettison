[0.017, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 3 \u001b[10G\u001b[22mincluded:\u001b[20Gone\u001b[24G\u001b[38;2;249;38;114min\u001b[27G\u001b[39ma\u001b[29Gheader,\u001b[37Gtwo\u001b[41G\u001b[38;2;249;38;114min\u001b[44G\u001b[39ma\u001b[46Gsource\u001b[53Gfile;\u001b[59G\u001b[38;2;249;38;114mand\u001b[63G\u001b[39mone\u001b[67Gabove\u001b[73Gevery\u001b[79Gcomment\u001b[87Gthat\u001b[92Gfollows\u001b[100Gthe\u001b[104Gend\u001b[108Gof\r\u001b[1B \u001b[3G   \u001b[2m 4 \u001b[22m a stat\u001b[17Gment \u001b[38;2;249;38;114mor\u001b[39m a block, so the code before it stands \u001b[38;2;249;38;114mas\u001b[39m its\u001b[70Gown\u001b[74Gblock\u001b[80G(docs/coding-standards.md).\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 5 -\u001b[38;2;248;248;242mWith --check it fails naming the files that lack them.                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 5 +\u001b[38;2;248;248;242mIt changes nothing inside a raw string literal, which \u001b[38;2;249;38;114mis\u001b[38;2;248;248;242m data, \u001b[38;2;249;38;114mnot\u001b[38;2;248;248;242m code. With --check it fails          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 6 +\u001b[38;2;248;248;242mnaming the files that lack them.                                                                        \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[10G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 8 \u001b[22m clang-\u001b[38;2;166;226;46mformat\u001b[39m cannot: SeparateDefinitionBlocks leaves declarations alone \u001b[38;2;249;38;114mand\u001b[39m collapses two blank\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[22m lines to one. So clang-query finds the declarations, \u001b[38;2;249;38;114min\u001b[39m every tracked unit of the clang-debug\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRule added\u001b[14Gto\u001b[17G\u001b[38;2;177;185;249mdocs/coding-standards.md\u001b[39m.\u001b[43GWaitin