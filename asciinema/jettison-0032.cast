[0.041, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gpublic\u001b[14Gkey\u001b[18Gnow\u001b[22Gprints\u001b[29Gin\u001b[32Gthe\u001b[36Gserving\u001b[44Gline,\u001b[50Gand\u001b[54Gthe\u001b[58Gsmoke\u001b[64Gtests\u001b[70Gcheck\u001b[76Git,\u001b[80Gbuilt\u001b[86Gagainst\u001b[94Gthe\u001b[98Gpinned\u001b[105Gengine\u001b[112Gfrom\r\u001b[2C\u001b[1BGitHub.\u001b[11GRunning\u001b[19GManifest's\u001b[30Gfull\u001b[35Ggate\u001b[40Gat\u001b[43Gwidth\u001b[49G24\u001b[52Gwith\u001b[57Gtidy.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI noticed a lot of\u001b[22Gth\u001b[25G c\u001b[28Gde\u001b[31Ghas comments b\u001b[46Go\u001b[48Gks that precede code blocks, and those have no whitespace linefeed \u001b[39m  \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mbetween them\u001b[16Gand a\u001b[22Gprevious\u001b[31Gcode\u001b[36Gblock.\u001b[43GAll\u001b[47Gcode blocks should have a l\u001b[76Gefeed whi\u001b[86Gespace af\u001b[96Ger t\u001b[101Gem, except when \u001b[39m  \r\u001b[5C\u001b[1B\u001b[38;2;255;255;255my are the fin\u001b[20Gl block in th\u001b[34Gt nested {}.\u001b[47GPlease updat\u001b[61Gthe l\u001b[68Ge\u001b[70Gspacing script to ensure this happens, add it to \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255mthe coding standards, and go back and apply it to all the existing code.\u001b[39m                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBig\u001b[7Gon\u001b[10G; I'll \u001b[18Gake it in a\u001b[30Gseparate\u001b[39Glane\u001b[44Gwhile\u001b[50Gthe\u001b[54GManifest\u001b[63Ggate\u001b[68Gruns.\u001b[74GFirst,\u001b[81Ga\u001b[83Glook\u001b[88Gat\u001b[91Gthe\u001b[95Gexisting\u001b[104Gspacing\u001b[112Gscript\r\u001b[2C\u001b[1Band\u001b[7Gthe\u001b[11Grule\u001b[16Git\u001b[19Genforces.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22