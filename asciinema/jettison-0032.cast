[0.017, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m4\u001b[12G\u001b[22m-\u001b[14GThe\u001b[18Gplayers'\u001b[27Gcommands\u001b[36Gdrop\u001b[41Gthe\u001b[45Gprincipal\u001b[55Gargument,\u001b[65Gsince\u001b[71Gthe\u001b[75Gactor\u001b[81Gis\u001b[84Gthe\u001b[88Gtoken's.\r\u001b[8C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m \u001b[14G`provision` needs an a\u001b[37Gministrator's token.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs\u001b[8Gare\u001b[12Gdone.\u001b[18GWaiting\u001b[26Gfor\u001b[30Gthe\u001b[34Gbuild.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mMake a note, you are allowed to write code, and run an incremental build on it while the gate runs on another \u001b[39m        \r\u001b[1B  \u001b[38;2;255;255;255mworktree. You may even run light\u001b[36Ge\u001b[38Gght testing.\u001b[51GWhat is \u001b[60Got allowed to happen is for\u001b[89Gwo\u001b[96Gs to ru\u001b[106Gt \u001b[111G same \r\u001b[2C\u001b[1Btime if they are h\u001b[22Gavy\u001b[26Ggates.\u001b[39m                                                                                     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command, recalled \u001b[1m1\u001b[22m memory, searched memories \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNoted\u001b[9Gin\u001b[12Gmemory:\u001b[20Gonly\u001b[25Gtwo\u001b[29Gheavy\u001b[35Ggates\u001b[41Gat\u001b[44Gonce\u001b[49Gare\u001b[53Gforbidden;\u001b[64Gedits,\u001b[71Gincremental\u001b[83Gbuilds\u001b[90Gand\u001b[94Glight\u001b[100Gtests\u001b[106Gare\u001b[110Gfine\u001b[115Gbeside\r\u001b[1B \u001b[3Ga gate in an\u001b[16Gther lane. The build hit\u001b[41Gone test compile error. F\u001b[67Gxing it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m1\u001b[19G\u001b[22mpattern,\u001b[28Grecalling\u001b[38G\u001b[1m1\u001b[40G\u001b[22mmemory,\u001b[48Gwriting\u001b[56G\u001b[1m2\u001b[58G\u001b[22mmemories\u001b[38;2;153;153;153m · 17s\u001b[39m…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/manifest.lane-b' && CMAKE_BUILD_PARALLEL_LEVEL=24 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m'/home\u001b[13Givan\u001b[18Gprojects/je\u001b[30Gtiso\u001b[35G.lane-b'/scripts/heavy.sh sh -c 'cmake --build\u001b[82G--preset clang-debug > build/build.log \r\u001b[5C\u001b[1B2>&1; echo build=$?; grep -E \"error:|FAILED\" build/build.log\u001b[67G| head\u001b[75G30; ctest --t\u001b[89Gst-dir build/clang-debug … (17s\r\u001b[5C\u001b[1B· 2 lines)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
