[0.927, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[35G\u001b[22mJettison's\u001b[46Gdurable\u001b[54Gwrite\u001b[60Galways\u001b[67Gcreated\u001b[75Gfiles\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001b[64G permissions parameter to\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m; the\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe\u001b[42Gserver\u001b[49Gwon't\u001b[55Gstart\u001b[61Gif\u001b[64Gthe\u001b[68Gkey\u001b[72Gfile\u001b[77Gis\u001b[80Gmissing\u001b[88Gor\u001b[91Gdoesn't\u001b[99Ghold\u001b[104Ga\u001b[106Gkey,\u001b[111Gand\u001b[115Gthe\r\u001b[4C\u001b[1B \u001b[7Gerror names the file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mRemote::Client\u001b[39m now takes\u001b[32Gthe\u001b[36Gserver's\u001b[45Gpublic\u001b[52Gkey.\u001b[57GThe\u001b[61Gconsole's\u001b[71G\u001b[38;2;177;185;249mconnect\u001b[79G\u001b[39mlooks\u001b[85Git\u001b[88Gup\u001b[91Gby\u001b[94Gexact\u001b[100G\u001b[38;2;177;185;249mhost:port\u001b[110G\u001b[39min\u001b[113Gthe\r\u001b[4C\u001b[1B \u001b[7Gplayer's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/servers.yaml\u001b[39m, or failing that the bui\u001b[80Gd's \u001b[38;2;177;185;249mshare/manifest/servers.yaml\u001b[39m.\u001b[113GT\r\u001b[6C\u001b[1Bshipped list is empty, and \u001b[38;2;177;185;249mstag\u001b[39G-bundle.\u001b[76G\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.384, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[35G\u001b[22mJettison's\u001b[46Gdurable\u001b[54Gwrite\u001b[60Galways\u001b[67Gcreated\u001b[75Gfiles\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001b[64G permissions parameter to\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m; the\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe\u001b[42Gserver\u001b[49Gwon't\u001b[55Gstart\u001b[61Gif\u001b[64Gthe\u001b[68Gkey\u001b[72Gfile\u001b[77Gis\u001b[80Gmissing\u001b[88Gor\u001b[91Gdoesn't\u001b[99Ghold\u001b[104Ga\u001b[106Gkey,\u001b[111Gand\u001b[115Gthe\r\u001b[4C\u001b[1B \u001b[7Gerror names the file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mRemote::Client\u001b[39m now takes\u001b[32Gthe\u001b[36Gserver's\u001b[45Gpublic\u001b[52Gkey.\u001b[57GThe\u001b[61Gconsole's\u001b[71G\u001b[38;2;177;185;249mconnect\u001b[79G\u001b[39mlooks\u001b[85Git\u001b[88Gup\u001b[91Gby\u001b[94Gexact\u001b[100G\u001b[38;2;177;185;249mhost:port\u001b[110G\u001b[39min\u001b[113Gthe\r\u001b[4C\u001b[1B \u001b[7Gplayer's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/servers.yaml\u001b[39m, or failing that the bui\u001b[80Gd's \u001b[38;2;177;185;249mshare/manifest/servers.yaml\u001b[39m.\u001b[113GT\r\u001b[6C\u001b[1Bshipped list is empty, and \u001b[38;2;177;185;249mstag\u001b[39G-bundle.sh\u001b[39m adds it to the bundle.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GTests: \u001b[15G    \u001b[20G  \u001b[23G      \u001b[30G   \u001b[34G             \u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.096, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001b[64G permissions parameter to\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m; the\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe\u001b[42Gserver\u001b[49Gwon't\u001b[55Gstart\u001b[61Gif\u001b[64Gthe\u001b[68Gkey\u001b[72Gfile\u001b[77Gis\u001b[80Gmissing\u001b[88Gor\u001b[91Gdoesn't\u001b[99Ghold\u001b[104Ga\u001b[106Gkey,\u001b[111Gand\u001b[115Gthe\r\u001b[4C\u001b[1B \u001b[7Gerror names the file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mRemote::Client\u001b[39m now takes\u001b[32Gthe\u001b[36Gserver's\u001b[45Gpublic\u001b[52Gkey.\u001b[57GThe\u001b[61Gconsole's\u001b[71G\u001b[38;2;177;185;249mconnect\u001b[79G\u001b[39mlooks\u001b[85Git\u001b[88Gup\u001b[91Gby\u001b[94Gexact\u001b[100G\u001b[38;2;177;185;249mhost:port\u001b[110G\u001b[39min\u001b[113Gthe\r\u001b[4C\u001b[1B \u001b[7Gplayer's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/servers.yaml\u001b[39m, or failing that the bui\u001b[80Gd's \u001b[38;2;177;185;249mshare/manifest/servers.yaml\u001b[39m.\u001b[113GT\r\u001b[6C\u001b[1Bshipped list is empty, and \u001b[38;2;177;185;249mstag\u001b[39G-bundle.sh\u001b[39m adds it to the bundle.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GTests:\u001b[K\r\u001b[4C\u001b[1B \u001b[7G- \u001b[38;2;177;185;249mremote\u001b[16G\u001b[39mcovers\u001b[23Ga\u001b[25Gclient\u001b[32Gpinned\u001b[39Gto\u001b[42Gthe\u001b[46Gw\u001b[76G600\u001b[80Gfile,\u001b[86Gand\u001b[90Gmissing\u001b[98Gor\u001b[101Gbad\u001b[105Gkey\u001b[109Gfiles.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.152, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;1