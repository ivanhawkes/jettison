[0.033, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[2m 11 \u001b[22m \u001b[38;2;117;113;94m// keys made with the secret key manifest-token key wrote, whose public half each client pins, and\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m2\u001b[14G\u001b[22m\u001b[38;2;117;113;94mstops cl\u001b[23Ganly on SIGINT or SIGTERM: i\u001b[52G admits nothing more, runs what it admitted i\u001b[98G one last step,\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m3\u001b[14G\u001b[22m\u001b[38;2;117;113;94manswers it and writes a\u001b[38Gsnapshot, losing no\u001b[58Ghi\u001b[61Gg. The\u001b[68Gp\u001b[71Gt defaults \u001b[83Go 0, an ephemeral one, which\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 14 -\u001b[38;2;248;248;242m// the serving line names.                                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 14 +\u001b[38;2;117;113;94m// the serving line names\u001b[48;2;4;71;0m, with the public half of the key\u001b[48;2;2;40;0m.\u001b[38;2;248;248;242m                                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 15 \u001b[22m \u001b[38;2;117;113;94m// manifest <options> --restore <backup> [--world <directory>]: restores the backup into the\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[14G\u001b[22m\u001b[38;2;117;113;94mdirectory, wh\u001b[28Gch must be empty, and recovers it to check it,\u001b[75Gfor --serve to serve. The backup is\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m7\u001b[14G\u001b[22m\u001b[38;2;117;113;94monly read.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m1\u001b[19G\u001b[22mpattern\u001b[38;2;153;153;153m · 1m 39s\u001b[39m…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest.lane-b' && cmake --build --preset clang-debug 2>&1 | grep -E \"error:|FAILED\" ; \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mctest --test-dir build/clang-debug -R \"^(remote|console|c\u001b[64Gi_serv\u001b[71G|bund\u001b[77Ge_smoke)$\" -j 8 --output-on-failure 2>&1\u001b[118G|\r\u001b[5C\u001b[1Btail -25 (1m 37s)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m4\u001b[22m new diagnostic issues in 4 files (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✢\u001b[3G\u001b[38;2;235;159;127mReticulating…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(3m 10s · ↓\u001b[29G5.7k tokens)\r\u001b[1B  ⎿  Tip: Use Plan Mode\u001b[25Gto prepare for a complex request before making changes. Press shift+tab twice to enable.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0032 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39mI noticed a lot of the code has comments blocks that precede code blocks, and those have no whitespace linefeed\u001b[K\r\u001b[1B  between them and a\u001b[22Gpr\u001b[25Gvi\u001b[28Gus\u001b[31Gcode block. Al\u001b[46G \u001b[48Gode blocks should have a linefeed whitespace after them, except when\r\u001b[2C\u001b[1Bthey are the\u001b[16Gfinal\u001b[22Gblock in\u001b[31Gthat\u001b[36Gnested\u001b[43G{}.\u001b[47GPlease update the line spac\u001b[76Gg script \u001b[86Go ensure \u001b[96Ghis \u001b[101Gappens, add it to\r\u001b[3C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
