[0.250, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mEngine:\u001b[13G\u001b[22mthe\u001b[17G\u001b[38;2;177;185;249mcore\u001b[22G\u001b[39msuite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B  committed.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMan\u001b[9Gf\u001b[11Gst\u001b[22m (\u001b[38;2;177;185;249mmanif\u001b[21Gst.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m), built against\u001b[72Gthe local engine:\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--replace]\u001b[53G\u001b[39mwrites\u001b[60Gthe\u001b[64Gsecret\u001b[71Gkey\u001b[75Gat\u001b[78G0600\u001b[83G(default\r\u001b[2C\u001b[1B \u001b[5G  \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/m\u001b[27Gifest/server-key\u001b[39m), prints the public\u001b[64Gkey once, and refuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[4C\u001b[1B \u001b[7Ggiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <fil\u001b[35G>\u001b[39m: the serve\u001b[48G won'\u001b[54G start \u001b[62Gf\u001b[64Gthe\u001b[68Gkey file is mi\u001b[83Gsing or doesn't\u001b[99Ghold a key,\u001b[111Gand\u001b[115Gthe\u001b[K\r\u001b[6C\u001b[1Berror\u001b[13Gnames the file.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mRemot\u001b[13G::Client\u001b[39m now takes the serv\u001b[41Gr's public key. The\u001b[61Gconsole's \u001b[38;2;177;185;249mconnect\u001b[39m look\u001b[84G it\u001b[88Gup\u001b[91Gby exact \u001b[38;2;177;185;249mhost:port\u001b[39m in the\u001b[K\r\u001b[6C\u001b[1Bplayer's \u001b[38;2;177;185;249m$XD