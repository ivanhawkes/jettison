[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mRemote::Client\u001b[22G\u001b[39mnow\u001b[26Gtakes\u001b[32Gthe\u001b[36Gserver's\u001b[45Gpublic\u001b[52Gkey.\u001b[57GThe\u001b[61Gconsole's\u001b[71G\u001b[38;2;177;185;249mconnect\u001b[79G\u001b[39mlooks\u001b[85Git\u001b[88Gup\u001b[91Gby\u001b[94Gexact\u001b[100G\u001b[38;2;177;185;249mhost:port\u001b[110G\u001b[39min\u001b[113Gthe\r\u001b[2C\u001b[1B    player's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/servers.yaml\u001b[39m,\u001b[56Gor\u001b[59Gfailing\u001b[67Gthat\u001b[72Gthe\u001b[76Gbuild's\u001b[84G\u001b[38;2;177;185;249mshare/manifest/servers.yaml\u001b[39m.\u001b[113GThe\r\u001b[2C\u001b[1B \u001b[5G  shipped list is empty, and\u001b[34G\u001b[38;2;177;185;249mstage-bundle.sh\u001b[39m adds it to the bund\u001b[70Ge.\u001b[K\r\u001b[4C\u001b[1B- Tes\u001b[11Gs:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G  - \u001b[38;2;177;185;249mremote\u001b[39m covers a client\u001b[32Gpin\u001b[36Ged\u001b[39Gto the wrong key (\u001b[38;2;177;185;249mKeyMismatch\u001b[39m), the 0600 file, and\u001b[90Gmissing\u001b[98Gor\u001b[101Gbad\u001b[105Gkey\u001b[109Gfiles.\r\u001b[4C\u001b[1B \u001b[7G- \u001b[38;2;177;185;249mconsole\u001b[39m covers an endpoint with no pinned key and a k\u001b[63Gy mismatch.\u001b[75G\u001b[K\r\u001b[6C\u001b[1B- \u001b[38;2;177;185;249mcli_serve\u001b[39m covers 0600, refusing to ove\u001b[48Gwrite, \u001b[38;2;177;185;249m--replace\u001b[39m, and a missing or bad key.\u001b[K\r\u001b[6C\u001b[1B- \u001b[38;2;177;185;249mbundle_smoke\u001b[39m connects\u001b[31Gthe\u001b[35Gterminal\u001b[44GUI\u001b[47Gthrough\u001b[55Ga\u001b[57Gplayer's\u001b[66Gserver\u001b[73Glist.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mremote\u001b[39m, \u001b[38;2;177;185;249mconsole\u001b[39m, \u001b[38;2;177;185;249mcli_*\u001b[39m,\u001b[31G\u001b[38;2;177;185;249mtoken_*\u001b[39G\u001b[39mand\u001b[43G\u001b[38;2;177;185;249mbundl