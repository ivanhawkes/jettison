[0.087, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe manifest is pushed and both lanes are parked. I'm now running the full script on Jettison\u001b[97Gagainst\u001b[105Glane\u001b[110GC's\u001b[114Gbuild,\r\u001b[2C\u001b[1Bwith\u001b[8Gthe\u001b[12Gcomment\u001b[20Gspacing\u001b[28Gfixed.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSix files still need lines from\u001b[35Gthe\u001b[39Gdeclaration\u001b[51Gpass,\u001b[57Glikely\u001b[64Gwhere\u001b[70Gmy\u001b[73Gone\u001b[77Gblank\u001b[83Gline\u001b[88Gsits\u001b[93Gabove\u001b[99Ga\u001b[101Gfunction's\u001b[112Gcomment\r\u001b[2C\u001b[1Bthat\u001b[8Gshould\u001b[15Gget\u001b[19Gtwo.\u001b[24GApplying\u001b[33Gand\u001b[37Gchecking.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBlank lines inside a raw\u001b[28Gstring\u001b[35Gliteral\u001b[43Gwould\u001b[49Gchange\u001b[56Gdata,\u001b[62Gand\u001b[66G\u001b[38;2;177;185;249mcomment-only.sh\u001b[82G\u001b[39mcan't\u001b[88Gcatch\u001b[94Gthat.\u001b[100GChecking\u001b[109Gthe\u001b[113G12\r\u001b[2C\u001b[1Btouched\u001b[11Gfiles\u001b[17Gwith\u001b[22Graw\u001b[26Gstrings.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m12\u001b[22m files, ran \u001b[1m13\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mOne hit: a\u001b[14Graw \u001b[19Gtring \u001b[27G \u001b[38;2;177;185;249mBindings.cpp\u001b[39m hol\u001b[45Ging\u001b[49Ggenerated\u001b[59GRust,\u001b[65Gwhere\u001b[71Ga\u001b[73Gblank\u001b[79Gline\u001b[84Gwould\u001b[90Gchange\u001b[97Gthe\u001b[101Ggenerated\u001b[111Gbindings.\r\u001b[1B  Reverting that file and teaching the script to skip raw string literals.\u001b[K\r\u001b[41C\u001b[2B\u001b[38;2;153;153;153mthought for 3s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
