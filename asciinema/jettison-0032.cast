y\u001b[38;2;248;248;242m(path, std::string_view{\u001b[38;2;230;219;116m\"private\"\u001b[38;2;248;248;242m}, kPrivate);                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 146 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(\u001b[38;2;166;226;46mReadFile\u001b[38;2;248;248;242m(path) == \u001b[38;2;230;219;116m\"private\"\u001b[38;2;248;248;242m);                                                                 \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 147 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(\u001b[38;2;166;226;46mmode\u001b[38;2;248;248;242m(path) == kPrivate);                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 148 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK_FALSE\u001b[38;2;248;248;242m(std::filesystem::\u001b[38;2;166;226;46mexists\u001b[38;2;248;248;242m(partial));                                                      \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 149 +\u001b[38;2;248;248;242m  std::filesystem::\u001b[38;2;166;226;46mremove_all\u001b[38;2;248;248;242m(directory);                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 150 +\u001b[38;2;248;248;242m}                                                                                                     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 151 +\u001b[38;2;248;248;242m                                                                                                      \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 152 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 153 \u001b[12G\u