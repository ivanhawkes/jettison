[0.004, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7G\u001b[38;2;177;185;249mRemote::Client\u001b[39m now\u001b[26Gtakes\u001b[32Gthe\u001b[36Gserver's\u001b[45Gpublic\u001b[52Gkey.\u001b[57GThe\u001b[61Gconsole's\u001b[71G\u001b[38;2;177;185;249mconnect\u001b[79G\u001b[39mlooks\u001b[85Git\u001b[88Gup\u001b[91Gby\u001b[94Gexact\u001b[100G\u001b[38;2;177;185;249mhost:port\u001b[110G\u001b[39min\u001b[113Gthe\r\u001b[4C\u001b[1B \u001b[7Gplayer's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/servers.yaml\u001b[39m, or fa\u001b[62Gling that\u001b[72Gthe build'\u001b[83G \u001b[38;2;177;185;249mshare/manifest/servers.yaml\u001b[39m. The\u001b[K\r\u001b[6C\u001b[1Bshipped li\u001b[18Gt is\u001b[23Gempty,\u001b[30Gand\u001b[34G\u001b[38;2;177;185;249mstage-bundle.sh\u001b[50G\u001b[39madds\u001b[55Git\u001b[58Gto\u001b[61Gthe\u001b[65Gbundle.\r\u001b[6C\u001b[1BTests:\u001b[K\r\u001b[6C\u001b[1B- \u001b[38;2;177;185;249mremote\u001b[16G\u001b[39mcovers a client pinned to the wrong key\u001b[56G(\u001b[38;2;177;185;249mKeyMismatch\u001b[39m), the 0600 file, and missing or bad key files.\u001b[K\r\u001b[6C\u001b[1B- \u001b[38;2;177;185;249mconsole\u001b[39m covers an endpoint with no pinned key\u001b[55Gand a\u001b[61Gkey\u001b[65Gmismatch.\r\u001b[4C\u001b[1B \u001b[7G- \u001b[38;2;177;185;249mcli_serve\u001b[19G\u001b[39mcovers\u001b[26G0600,\u001b[32Grefusing\u001b[41Gto\u001b[44Goverwrite,\u001b[55G\u001b[38;2;177;185;249m--replace\u001b[39m,\u001b[66Gand\u001b[70Ga\u001b[72Gmissing\u001b[80Gor\u001b[83Gbad\u001b[87Gkey.\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mbundl\u001b[15G_smoke\u001b[39m connects the t\u001b[37Grminal UI through a player's server list.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mremote\u001b[39m, \u001b[38;2;177;185;249mconsole\u001b[39m, \u001b[38;2;177;185;249mcli_*\u001b[39m, \u001b[38;2;177;185;249mtoken_*\u001b[39m and \u001b[38;2;177;185;249mbundle_smoke\u001b[39m all pass.\u001b[66G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GDocs: D-081, \u001b[38;2;177;185;249mserver.md\u001b[39m (\u001b[35Gplaintext secti\u001b[51Gn is now \"Connections\u001b[73Gare sealed\",\u001b[86Gplus\u001b[91Gusage\u001b[97Gexamples),\u001b[108G\u001b[38;2;177;185;249mscope.md\u001b[39m,\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mroadmap.md\u001b[39m,\u001b[19GL01,\u001b[24G\u001b[38;2;177;185;249mhost.md\u001b[32G\u001b[39mand\u001b[36G\u001b[38;2;177;185;249mconsole.md\u001b[39m.\u001b[48GAll\u001b[52Gthe\u001b[56Gdead\u001b[61GJ01\u001b[65Glinks\u001b[71Gnow\u001b[75Gpoint\u001b[81Gto\u001b[84Gthe\u001b[88Gengine's\u001b[97Ghistory\u001b[105Gentry.\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext, once you say go:\u001b[22m I commit\u001b[35Gand push th\u001b[47G engine change, pin Manifest to that hash, r\u001b[92Gn Manifest's full gate at\r\u001b[2C\u001b[1Bwidth 24 with tidy, then commit Manifest. Shal\u001b[50G I go\u001b[56Gahead?\u001b[K\r\u001b[2C\u001b[2BI didn't add a check that refuses a\u001b[39Gkey fil\u001b[48Gother users can read (as \u001b[74Gsh does),\u001b[84Gand I\u001b[90Gdidn't prin\u001b[102G the public key\u001b[118Gin\r\u001b[2C\u001b[1Bthe server's s\u001b[18Gartup li\u001b[27Ge. So if the operator \u001b[50Goses the public\u001b[66Gkey,\u001b[71Gthe\u001b[75Gonly\u001b[80Gway\u001b[84Gback\u001b[89Gis\u001b[92G\u001b[38;2;177;185;249m--replace\u001b[39m,\u001b[103Gand\u001b[107Gevery\u001b[113Gclient\r\u001b[2C\u001b[1Bmust\u001b[8Gthen\u001b[13Gpin\u001b[17Gthe\u001b[21Gnew\u001b[25Gone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 18m 4s · done 10:55 am\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
