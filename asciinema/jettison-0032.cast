[0.149, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe public key now prints in the serving line, and the smoke tests check it, built against the pinned engine from\r\u001b[2C\u001b[1BGitHub. Running Manifest's full gate at wid\u001b[47Gh 24\u001b[52Gwith tidy.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI noticed a lot of the code has comments blocks that precede code blocks, and those have no whitespace linefeed \u001b[39m      \r\u001b[1B  \u001b[38;2;255;255;255mbetween them and a previous code block. All code blocks should have a linefeed whitespace after them, except when \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mthey are the final block in that nested {}. Please update the line spacing script to ensure this happens, add it to \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mthe coding standards, and go back and apply it to all the existing code.\u001b[39m                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mB\u001b[5Gg one; I'll take \u001b[23Gt in a\u001b[30Gseparate l\u001b[41Gne while the Manifest\u001b[63Ggate\u001b[68Gruns.\u001b[74GFirst,\u001b[81Ga\u001b[83Glook\u001b[88Gat\u001b[91Gthe\u001b[95Gexisting\u001b[104Gspacing\u001b[112Gscript\r\u001b[2C\u001b[1Band\u001b[7Gthe\u001b[11Grule\u001b[16Git\u001b[19Genforces.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[39m Running cd '/home/ivan/projects/manifest.lane-b' && CMAKE…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest.lane-b' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS=24 ./scripts/ci.sh --werror --asan --tidy --log build/gate.log (18s · 140 lines)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✽\u001b[3GReticulating… \u001b[43G\u001b[38;2;153;153;153mthought for 14s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
