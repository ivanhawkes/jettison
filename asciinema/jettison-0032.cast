[0.100, "o", "\u001b[?25l\u001b[H\u001b[12G\u001b[1m2\u001b[18G\u001b[22ms, removed \u001b[1m1\u001b[22m line\r\u001b[6C\u001b[1B\u001b[2m384 \u001b[22m - `source/game/remote`: the module, on `query`, `host` and `Jettison::Net`.\u001b[K\r\u001b[6C\u001b[1B\u001b[2m385 \u001b[22m   - `include/manifest/remote/Protocol.h`: `kProtocol`, `kVersion`, `kMaxMessageBytes`, `Kind`,\u001b[K\r\u001b[6C\u001b[1B\u001b[2m386 \u001b[22m     `Welcome`, `Submit`, `Reply`, `RegisterTypes`.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m387 -\u001b[38;2;248;248;242m \u001b[14G- `include/manifest/remote/Server.h`:\u001b[52G`Server`\u001b[61G(`Poll`,\u001b[70G`Publish`,\u001b[81G`Stop`,\u001b[89G`Stopping`\u001b[48;2;92;2;0m).\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m387 +\u001b[38;2;248;248;242m  - `include/manifest/remote/Server.h`: `Server` (`Poll`, `Publish`, `Stop`, `Stopping`\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 388 +\u001b[38;2;248;248;242m    `PublicKey`).                                                                                     \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m389 \u001b[22m   - `include/manifest/remote/Client.h`: `Client` (`Poll`, `Submit`, `Retry`, `Disconnect`,\u001b[K\r\u001b[6C\u001b[1B\u001b[2m390 \u001b[22m     `Welcomed`,\u001b[28G`Closed`,\u001b[38G`Latest`).\r\u001b[5C\u001b[1B\u001b[2m 391 \u001b[14G\u001b[22m-\u001b[16G`include/manifest/remote/Tokens.h`:\u001b[52G`Credential`,\u001b[66G`TokenFile`,\u001b[79G`ReadTokens`,\u001b[93G`WriteTokens`,\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest.lane-b' && cmake --bui\u001b[64Gd --pr\u001b[71Gset c\u001b[77Gang-debug 2>&1 | grep -E \"error:|FAILED\"\u001b[118G;\r\u001b[5C\u001b[1Bctest --test-dir build/clang-debug -R \"^(remote|console|cli_serve|bundle_smoke)$\" -j 8 --output-on-failure 2>&1 | \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mtail -25\u001b[39m\u001b[K\r\u001b[18C\u001b[12B\u001b[38;2;153;153;153m(shift+tab to cycle)\u001b[39m\u001b[27;1H\u001b[24;49H\u001b[?25h"]
