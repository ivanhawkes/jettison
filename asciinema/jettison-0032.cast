[0.196, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m0\u001b[14G\u001b[38;2;117;113;94m// A partial a crash left, open to everyone, is not reused.\u001b[38;2;248;248;242m                                         \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[14G\u001b[38;2;248;248;242mstd::filesystem::path partial\u001b[44G=\u001b[46Gpath;\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[14G\u001b[38;2;248;248;242mpartial += kPartialSuffix;                                                                          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[19G\u001b[38;2;248;248;242mofstream{partial} << \u001b[38;2;230;219;116m\"left\"\u001b[38;2;248;248;242m;    \u001b[52G                  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[14G\u001b[38;2;248;248;242mstd::filesystem::\u001b[38;2;166;226;46mpermissions\u001b[38;2;248;248;242m(partial, kFilePermissions);      \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;166;226;46mWriteFileDurably\u001b[38;2;248;248;242m(path, std::string_view{\u001b[38;2;230;219;116m\"private\"\u001b[38;2;248;248;242m},\u001b[66GkPrivate);\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[20G\u001b[38;2;166;226;46mReadFile\u001b[38;2;248;248;242m(path) == \u001b[38;2;230;219;116m\"private\"\u001b[38;2;248;248;242m);\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[19G\u001b[38;2;248;248;242m(\u001b[38;2;166;226;46mmode\u001b[38;2;248;248;242m(pa\u001b[28Gh) == kPrivate);                \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;166;226;46mCHECK_FALSE\u001b[38;2;248;248;242m(std::filesystem::\u001b[38;2;166;226;46mexists\u001b[38;2;248;248;242m(partial));\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m49\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gstd::filesystem::\u001b[38;2;166;226;46mremove_all\u001b[38;2;248;248;242m(directory);                                                             \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[12G\u001b[38;2;248;248;242m}\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\r\u001b[5C\u001b[1B 152 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;166;226;46mTEST_CASE\u001b[39m(\u001b[38;2;230;219;116m\"FileLock: one holder at a time in a process, and the next once it lets go\"\u001b[39m)\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m{\u001b[14G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 155 \u001b[14G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[20G\u001b[39mstd::filesystem::path\u001b[42Gdirectory\u001b[52G=\u001b[54G\u001b[38;2;166;226;46mScratch\u001b[39m();\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Listing \u001b[1m1\u001b[22m directory, running \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Wr\u001b[9Gte(~/projects/je\u001b[26Gtison.lane-b/docs/history/neutral-sdk.md)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
