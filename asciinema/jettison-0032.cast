[0.026, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;230;219;116m\"\"\"Puts blank lines above every function and method declaration, its comment and template line\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3\u001b[10G\u001b[22minclud\u001b[17Gd: one \u001b[38;2;249;38;114min\u001b[27G\u001b[39ma header,\u001b[38Gwo\u001b[41G\u001b[38;2;249;38;114min\u001b[39m a\u001b[46Gsourc\u001b[53Gfile; \u001b[38;2;249;38;114mand\u001b[63G\u001b[39mone above every comment that follows the end\u001b[108Gof\r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[22m a statement \u001b[38;2;249;38;114mor\u001b[39m a block, so the code before it stands \u001b[38;2;249;38;114mas\u001b[39m its own block (docs/coding-standards.md).\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 5 -\u001b[38;2;248;248;242mWith --check it fails naming the files that lack them.                                                  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[10G\u001b[38;2;248;248;242mIt changes\u001b[21Gnothing inside a raw string\u001b[49Gliteral,\u001b[58Gwhich\u001b[64G\u001b[38;2;249;38;114mis\u001b[38;2;248;248;242m data, \u001b[38;2;249;38;114mnot\u001b[38;2;248;248;242m code. With --check it fails          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 6 +\u001b[38;2;248;248;242mnaming the files that lack them.                                                                        \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m7\u001b[10G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mclang-\u001b[38;2;166;226;46mformat\u001b[39m cannot: SeparateDefini\u001b[46GionBlocks leaves\u001b[63Gdeclarations alone \u001b[38;2;249;38;114mand\u001b[39m collapses two \u001b[101Glank\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[10G\u001b[22mlines\u001b[16Gto\u001b[19Gone.\u001b[24GSo\u001b[27Gclang-query\u001b[39Gfinds\u001b[45Gthe\u001b[49Gdeclarations,\u001b[63G\u001b[38;2;249;38;114min\u001b[66G\u001b[39mevery\u001b[72Gtracked\u001b[80Gunit\u001b[85Gof\u001b[88Gthe\u001b[92Gclang-debug\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRule\u001b[8Gadded\u001b[14Gto\u001b[17G\u001b[38;2;177;185;249mdocs/coding-standards.md\u001b[39m.\u001b[43GWaiting\u001b[51Gfor\u001b[55Glane\u001b[60GC's\u001b[64Gbuild\u001b[70Gand\u001b[74Gsuites.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJett\u001b[8Gson builds and all\u001b[27G32 suites\u001b[37Gp\u001b[39Gss\u001b[42Gwith\u001b[47Gthe\u001b[51Gspacing.\u001b[60GNow\u001b[64GManifest:\u001b[74Gchecking\u001b[83Gits\u001b[87Gformat-check\u001b[100Gexclusions,\u001b[112Gthen\r\u001b[2C\u001b[1Brunning\u001b[11Gthe\u001b[15Gscript\u001b[22Gwith\u001b[27G\u001b[38;2;177;185;249m--root\u001b[34G\u001b[39min\u001b[37Glane\u001b[42GB.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Searching for \u001b[1m1\u001b[22m pattern, running \u001b[1m3\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ git -C '/home/ivan\u001b[27Gprojects/m\u001b[39Gifest.lane-b' diff --sho\u001b[64Gtstat\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
