[0.049, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifes\u001b[29G.lane-b/docs/console.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m4\u001b[14G\u001b[22mlines, removed \u001b[1m2\u001b[31G\u001b[22mlines\u001b[K\r\u001b[6C\u001b[1B\u001b[2m146\u001b[12G\u001b[22m### Connected to a \u001b[32Gerver\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 147 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m148\u001b[12G\u001b[22m`connect <host:port> <token>` play\u001b[47G on a dedicated\u001b[63Gserver\u001b[70G([\u001b[38;2;230;219;116mthe server\u001b[39m](server.md))\u001b[96Gas\u001b[99Gthe\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 149 -\u001b[38;2;248;248;242mtoken's actor. A failed connect keeps the connection there was; a new one replaces it. While          \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 150 -\u001b[38;2;248;248;242mconnected:                                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 149 +\u001b[38;2;248;248;242mtoken's actor, pinning the server's key from the                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 150 +\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mserver list\u001b[38;2;248;248;242m](server.md#connections-are-sealed); an endpoint the list does not name is refused,       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 151 +\u001b[38;2;248;248;242mand a server that does not hold the pinned key ends in `Disconnected from ...: key mismatch.`. A      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 152 +\u001b[38;2;248;248;242mfailed connect keeps the connection there was; a new one replaces it. While connected:                \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 153 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 154 \u001b[22m - Th\u001b[17G players'\u001b[27Gcommands\u001b[36Gdrop\u001b[41Gthe\u001b[45Gprincipal\u001b[55Gargument,\u001b[65Gsince\u001b[71Gthe\u001b[75Gactor\u001b[81Gis\u001b[84Gthe\u001b[88Gtoken's.\r\u001b[1B     \u001b[2m 155 \u001b[22m   `provision` needs an administrator's token.\u001b[K\r\u001b[20C\u001b[10B\u001b[38;2;0;204;204m1\u001b[38G\u001b[39m\u001b[K\u001b[27;1H\u001b[24;7H\u001b[?25h"]
