[0.253, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m86 +\u001b[38;2;248;248;242mNo\u001b[14Gformatting change, by hand or by a script, reaches inside a string or other literal: a raw string   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 87 +\u001b[38;2;248;248;242mholding generated code, a shader or a test's expected text is data, and spacing it changes what the    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 88 +\u001b[38;2;248;248;242mprogram says. The spacing script skips raw string literals for that reason.                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 89 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 90 \u001b[11G\u001b[22m##\u001b[14GNaming\r\u001b[2C\u001b[1B   \u001b[2m 91 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 92 \u001b[11G\u001b[22m|\u001b[13GThing\u001b[19G|\u001b[21GStyle\u001b[27G|\u001b[29GExample\u001b[37G|\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jet\u001b[25Gison.lane-c/scripts/space-declarations.py)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B     \u001b[2m 2 \u001b[22m \u001b[38;2;230;219;116m\"\"\"Puts blank lines above every function and method declaration, its comment and template line\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 3 \u001b[10G\u001b[22mincluded:\u001b[20Gone\u001b[24G\u001b[38;2;249;38;114min\u001b[27G\u001b[39ma\u001b[29Gheader,\u001b[37Gtwo\u001b[41G\u001b[38;2;249;38;114min\u001b[44G\u001b[39ma\u001b[46Gsource\u001b[53Gfile;\u001b[59G\u001b[38;2;249;38;114mand\u001b[63G\u001b[39mone\u001b[67Gabove\u001b[73Gevery\u001b[79Gcomment\u001b[87Gthat\u001b[92Gfollows\u001b[100Gthe\u001b[104Gend\u001b[108Gof\r\u001b[1B \u001b[3G   \u001b[2m 4 \u001b[10G\u001b[22ma statem\u001b[19Gnt \u001b[38;2;249;38;114mor\u001b[25G\u001b[39ma block, so the code before i\u001b[56Gstands \u001b[38;2;249;38;114mas\u001b[39m i\u001b[68Gs own block (docs/coding-standards.md).\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 5 -\u001b[38;2;248;248;242mWith --check it fails naming the files that lack them.                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 5 +\u001b[38;2;248;248;242mIt changes nothing inside a raw string literal, which \u001b[38;2;249;38;114mis\u001b[38;2;248;248;242m data, \u001b[38;2;249;38;114mnot\u001b[38;2;248;248;242m code. With --check it fails          \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 6 +\u001b[38;2;248;248;242mnaming the files that lack them.                                                                        \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 7 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 8 \u001b[22m clang-\u001b[38;2;166;226;46mformat\u001b[39m cannot: SeparateDefinitionBlocks leaves declarations alone \u001b[38;2;249;38;114mand\u001b[39m collapses two blank\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[22m lines to one. So clang-query finds the declarations, \u001b[38;2;249;38;114min\u001b[39m every tracked unit\u001b[85Gof\u001b[88Gthe\u001b[92Gclang-debug\r\u001b[2C\u001b[2B\u001b[38;2;220;129;97mImagining…\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m1\u001b[38G\u001b[38;2;153;153;153m · esc to inter\u001b[54Gupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
