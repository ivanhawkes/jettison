[0.063, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes, the docs could be\u001b[26Gwritten\u001b[34Gduring\u001b[41Gthe\u001b[45Gbuild,\u001b[52Gand\u001b[56Gthey're\u001b[64Gdone.\u001b[70GThe\u001b[74Gengine\u001b[81Ggate\u001b[86Ghas\u001b[90Gsince\u001b[96Gpassed,\u001b[104Gso\u001b[107Gthe\u001b[111Gwork\u001b[116Gis\r\u001b[2C\u001b[1Bwaiting\u001b[11Gon\u001b[14Gyour\u001b[19GOK\u001b[22Gto\u001b[25Gcommit.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSaved to memory:\u001b[22m never run \u001b[31Gwo\u001b[34Gheavy\u001b[40Ggates\u001b[46Gat\u001b[49Gonce.\u001b[55GCode\u001b[60Gedits,\u001b[67Gincremental\u001b[79Gbuilds\u001b[86Gand\u001b[90Glight\u001b[96Gtests\u001b[102Gare\u001b[106Gfine\u001b[111Gbeside\u001b[118Ga\r\u001b[2C\u001b[1Bgate\u001b[8Gin\u001b[11Ganother\u001b[19Glane.\u001b[25GThis\u001b[30Greplaces\u001b[39Gthe\u001b[43Gold\u001b[47G\"nothing\u001b[56Gbeside\u001b[63Gclang\"\u001b[70Gnote.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[22m J\u001b[37Gttison's durable write always created files\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould\u001b[9Gnever\u001b[15Gbe\u001b[18G0600\u001b[23Gfrom\u001b[28Gthe\u001b[32Gmoment\u001b[39Git\u001b[42Gwas\u001b[46Gwritten.\u001b[55GI\u001b[57Gadded\u001b[63Ga\u001b[65Gpermissions\u001b[77Gparameter\u001b[87Gto\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m;\u001b[114Gthe\r\u001b[2C\u001b[1Bdefault stays 0644. It also now\u001b[35Gr\u001b[37Gplaces a\u001b[46Gpa\u001b[49Gtial\u001b[54Gfile left by\u001b[67Ga crash\u001b[75Ginstead of reusing it, since reusing it would\r\u001b[2C\u001b[1Bkeep th\u001b[11G old mode. This is in \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch\u001b[57G\u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, recorded in the engine's history and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So Manife\u001b[29Gt\u001b[31Ghas\u001b[35Gto be pinned to that engine commit \u001b[72Gt\u001b[74Ger than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the dev shell files haven't\u001b[K\r\u001b[2C\u001b[1Bchanged.\u001b[12G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mEngine:\u001b[13G\u001b[22mthe\u001b[17G\u001b[38;2;177;185;249mcore\u001b[22G\u001b[39msuite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B  committed.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMan\u001b[9Gf\u001b[11Gst\u001b[22m (\u001b[38;2;177;185;249mmanif\u001b[21Gst.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m), built against\u001b[72Gthe local engine:\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--replace]\u001b[53G\u001b[39mwrites\u001b[60Gthe\u001b[64Gsecret\u001b[71Gkey\u001b[75Gat\u001b[78G0600\u001b[83G(default\r\u001b[2C\u001b[1B \u001b[5G  \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/m\u001b[27Gifest/server-key\u001b[39m), p\u001b[76Gd refuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.041, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Gthe\u001b[12Gdocs\u001b[17Gcould\u001b[23Gbe\u001b[26Gwritten\u001b[34Gduring\u001b[41Gthe\u001b[45Gbuild,\u001b[52Gand\u001b[56Gthey're\u001b[64Gdone.\u001b[70GThe\u001b[74Gengine\u001b[81Ggate\u001b[86Ghas\u001b[90Gsince\u001b[96Gpassed,\u001b[104Gso\u001b[107Gthe\u001b[111Gwork\u001b[116Gis\r\u001b[1B \u001b[3Gwaiting on your OK to commi\u001b[31G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSaved to memory:\u001b[20G\u001b[22mnever\u001b[26Grun\u001b[30Gtwo\u001b[34Gheavy\u001b[40Ggates\u001b[46Gat\u001b[49Gonce.\u001b[55GCode\u001b[60Gedits,\u001b[67Gincremental\u001b[79Gbuilds\u001b[86Gand\u001b[90Glight\u001b[96Gtests\u001b[102Gare\u001b[106Gfine\u001b[111Gbeside\u001b[118Ga\r\u001b[2C\u001b[1Bgate in another lane. This\u001b[30Greplaces the old \"n\u001b[50Gthing beside clang\" not\u001b[74G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[35G\u001b[22mJettison's\u001b[46Gdurable\u001b[54Gwrite\u001b[60Galways\u001b[67Gcreated\u001b[75Gfiles\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001b[64G permissions parameter to\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m; the\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.                      \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.520, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gwaiting on your OK to commi\u001b[31G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSaved to memory:\u001b[20G\u001b[22mnever\u001b[26Grun\u001b[30Gtwo\u001b[34Gheavy\u001b[40Ggates\u001b[46Gat\u001b[49Gonce.\u001b[55GCode\u001b[60Gedits,\u001b[67Gincremental\u001b[79Gbuilds\u001b[86Gand\u001b[90Glight\u001b[96Gtests\u001b[102Gare\u001b[106Gfine\u001b[111Gbeside\u001b[118Ga\r\u001b[2C\u001b[1Bgate in another lane. This\u001b[30Greplaces the old \"n\u001b[50Gthing beside clang\" not\u001b[74G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[35G\u001b[22mJettison's\u001b[46Gdurable\u001b[54Gwrite\u001b[60Galways\u001b[67Gcreated\u001b[75Gfiles\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001b[64G permissions parameter to\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m; the\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe\u001b[42Gserve\u001b[77Gis\u001b[80Gmissing\u001b[88Gor\u001b[91Gdoesn't\u001b[99Ghold\u001b[104Ga\u001b[106Gkey,\u001b[111Gand\u001b[115Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.083, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSaved to memory:\u001b[20G\u001b[22mnever\u001b[26Grun\u001b[30Gtwo\u001b[34Gheavy\u001b[40Ggates\u001b[46Gat\u001b[49Gonce.\u001b[55GCode\u001b[60Gedits,\u001b[67Gincremental\u001b[79Gbuilds\u001b[86Gand\u001b[90Glight\u001b[96Gtests\u001b[102Gare\u001b[106Gfine\u001b[111Gbeside\u001b[118Ga\r\u001b[2C\u001b[1Bgate in another lane. This\u001b[30Greplaces the old \"n\u001b[50Gthing beside clang\" not\u001b[74G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[35G\u001b[22mJettison's\u001b[46Gdurable\u001b[54Gwrite\u001b[60Galways\u001b[67Gcreated\u001b[75Gfiles\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001b[64G permissions parameter to\u001b[90G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m; the\r\u001b[2C\u001b[1Bdefault stays 0644.\u001b[23GIt also now replaces a\u001b[46Gpar\u001b[50Gial file l\u001b[61Gft by a crash inste\u001b[81Gd of reusing it, since reusing it would\r\u001b[2C\u001b[1Bk\u001b[5Gep the old mode. This i\u001b[29G i\u001b[32G \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mprivate-durable-files\u001b[39m, rec\u001b[84Grded in the eng\u001b[101Ge's hi\u001b[108Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gplace]\u001b[39m writes the\u001b[64Gsecret key at 0600 (default\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), prints\u001b[53Gthe public\u001b[64Gk\u001b[66Gy once, and\u001b[78Grefuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe\u001b[42Gserver\u001b[49Gwon't\u001b[55Gstart\u001b[61Gif\u001b[64Gthe\u001b[68Gkey\u001b[72Gfile\u001b[77Gis\u001b[80Gmissing\u001b[88Gor\u001b[91Gdoesn't\u001b[99Ghold\u001b[104Ga\u001b[106Gkey,\u001b[111Gand\u001b[115Gthe\r\u001b[4C\u001b[1B \u001b[7Gerror names the file.         \u001b[38G   \u001b[42G     \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
