[0.147, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest.lan\u001b[34G-b/d\u001b[39Gcs/host.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m li\u001b[17Ge\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 331 \u001b[22m # validate: mount 1: manifest, from <bundle>/share/manifest/manifest.pack\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m# validat\u001b[22G: valid: scenario trading, game\u001b[54Gmode\u001b[59Gmanifest,\u001b[69Gcontent\u001b[77G<fingerprint>\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22mtoke\u001b[17G=\"$(bin/man\u001b[29Gfest-token issue adminis\u001b[54Gra\u001b[57Gor\u001b[60GOperator)\"\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 334 +\u001b[38;2;248;248;242mkey=\"$(bin/manifest-token key)\"                                                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 335 \u001b[12G\u001b[22mbin/manifest\u001b[25G--scenario\u001b[36Gtrading\u001b[44G--serve\u001b[52G&\r\u001b[2C\u001b[1B   \u001b[2m 336 \u001b[22m # manifest:\u001b[24Gserving\u001b[32Gon\u001b[35G127.0.0.1:<port>\u001b[52Gat\u001b[55Gstep\u001b[60G0,\u001b[63Gworld\u001b[69G<id>\u001b[74Gat\u001b[77Gbatch\u001b[83G<n>\r\u001b[5C\u001b[1B\u001b[2m 337 \u001b[12G\u001b[22mkill\u001b[17G-TERM\u001b[23G%1\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Main docs done (server, D-081, scope, roadmap, L01, host). Updating \u001b[38;2;177;185;249mconsole.md\u001b[39m's\u001b[84G\u001b[38;2;177;185;249mconnect\u001b[92G\u001b[39mtext\u001b[97Gwhile\u001b[103Gthe\u001b[107Gbuild\u001b[113Gruns.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~