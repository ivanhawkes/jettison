[0.001, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite has a\u001b[34Gtest for the 0600 write, and the fu\u001b[70Gl gate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[4C\u001b[1Bcommi\u001b[11Gted.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbra\u001b[36Gch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m), built against the local engine:\u001b[90G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--replace]\u001b[39m writes th\u001b[63G secret key\u001b[75Gat\u001b[78G0600\u001b[83G(default\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manifest/server-key\u001b[39m), p\u001b[48Gints the public key once, and refuses to overwrite\u001b[99Gan\u001b[102Gexisting\u001b[111Gkey\u001b[115Gunless\r\u001b[6C\u001b[1Bgiven \u001b[38;2;177;185;249m--replace\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mmanifest --serve --key <file>\u001b[39m:\u001b[38Gthe\u001b[42Gserver\u001b[49Gwon't\u001b[55Gstart\u001b[61Gif\u001b[64Gthe\u001b[68Gkey\u001b[72Gfile\u001b[77Gis\u001b[80Gmissing\u001b[88Gor\u001b[91Gdoesn't\u001b[99Ghold\u001b[104Ga\u001b[106Gkey,\u001b[111Gand\u001b[115Gthe\r\u001b[6C\u001b[1Berror names the file.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mRemote::Client\u001b[39m now takes the server's\u001b[45Gpubl\u001b[50Gc key. The c\u001b[64Gsole's \u001b[38;2;177;185;249mconnect\u001b[39m looks it \u001b[89Gp\u001b[91Gby exact \u001b[38;2;177;185;249mhost:port\u001b[39m in the\u001b[K\r\u001b[6C\u001b[1Bplayer's \u001b[38;2;177;185;249m$XDG_CONFIG_HOME/manife\u001b[40Gt/servers.yaml\u001b[39m,\u001b[56Gor failing that the build's\u001b[84G\u001b[3