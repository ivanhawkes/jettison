8Gtory and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So\u001b[22GManife\u001b[29Gt has to be pinned to that engine commit rather than \u001b[38;2;177;185;249m24bd3ec\u001b[39m; the d\u001b[97Gv sh\u001b[102Gll\u001b[105Gf\u001b[107Gles haven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere things stand:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngine:\u001b[22m the \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[28Ghas\u001b[32Ga\u001b[34Gtest\u001b[39Gfor\u001b[43Gthe\u001b[47G0600\u001b[52Gwrite,\u001b[59Gand\u001b[63Gthe\u001b[67Gfull\u001b[72Ggate\u001b[77Gpassed\u001b[84G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[102G231\u001b[106Gs).\u001b[110GNot\r\u001b[2C\u001b[1B \u001b[5Gcommitted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[32Gbranch\u001b[39G\u001b[38;2;177;185;249madopt-encryption\u001b[39m),\u001b[58Gbuilt\u001b[64Gagainst\u001b[72Gthe\u001b[76Glocal\u001b[82Gengine:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mmanifest-token [--key <file>] key [--r\u001b[46Gp\u001b[76G\u001b[39mt 0600 (default\u001b[27;1H\u001b[24;3H\u001b[?25h"]
