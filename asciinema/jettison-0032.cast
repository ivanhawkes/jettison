[0.461, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFormatted;\u001b[14GManifest's\u001b[25Gformat\u001b[32Gcheck\u001b[38Gpasses.\u001b[46GRunning\u001b[54Gthe\u001b[58Gengine's\u001b[67Gformat\u001b[74Gcheck\u001b[80Gand\u001b[84Gits\u001b[88Ggate\u001b[93G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m)\u001b[111Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mjettison.lane-b\u001b[39m now. That is the only heavy run.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes, the docs could be wri\u001b[30Gten during\u001b[41Gthe build, and\u001b[56Gthey're done.\u001b[70GThe \u001b[75Gngine gate has since pas\u001b[100Ged, so the\u001b[111Gwork is\r\u001b[2C\u001b[1Bwaiting on\u001b[14Gyour\u001b[19GOK\u001b[22Gto\u001b[25Gcommit.\r\u001b[2C\u001b[2B\u001b[1mSaved\u001b[10Go memory:\u001b[22m never\u001b[26Grun\u001b[30Gtwo\u001b[34Gheavy\u001b[40Ggates\u001b[46Gat\u001b[49Gonce.\u001b[55GCode\u001b[60Gedits,\u001b[67Gincremental\u001b[79Gbuilds\u001b[86Gand\u001b[90Glight\u001b[96Gtests\u001b[102Gare\u001b[106Gfine\u001b[111Gbeside\u001b[118Ga\r\u001b[2C\u001b[1Bgate in another lane. This replaces\u001b[39Gthe\u001b[43Gold\u001b[47G\"nothing beside\u001b[63Gclang\" note.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne devia\u001b[13Gion from the handoff.\u001b[22m Jettison's durable write a\u001b[62Gways created files as 0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the moment it was written. I added a pe\u001b[68Gmissions parameter to \u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m;\u001b[114Gthe\r\u001b[2C\u001b[1Bdefault stays 0644. It also now replaces a\u001b[47Gartial file left\u001b[64Gby a crash inst\u001b[80Gad of\u001b[86Greusing it, si\u001b[101Gc\u001b[103G reusing it\u001b[115Gwould\u001b[K\r\u001b[2C\u001b[1Bkeep th\u001b[11G old mode. This\u001b[27Gis\u001b[30Gin\u001b[33G\u001b[38;2;177;185;249mjettison.lane-b\u001b[39m,\u001b[50Gbranch\u001b[57G\u001b[38;2;177;185;249mprivate-durable-files\u001b[39m,\u001b[80Grecorded\u001b[89Gin\u001b[92Gthe\u001b[96Gengine's\u001b[105Ghistory\u001b[113Gand\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpersistence.md\u001b[39m. So Manifest has to\u001b[38Gbe pinned to that engine commit rather\u001b[77Gthan \u001b[38;2;177;185;249m24bd3ec\u001b[39m;\u001b[91Gth\u001b[94G dev\u001b[99Gshell files\u001b[111Ghaven't\r\u001b[2C\u001b[1Bchanged.\u001b[K\r\u001b[4C\u001b[1B \u001b[7G              \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G        \u001b[45G  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[6.170, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFormatted;\u001b[14GManifest's\u001b[25Gformat\u001b[32Gcheck\u001b[38Gpasses.\u001b[46GRunning\u001b[54Gthe\u001b[58Gengine's\u001b[67Gformat\u001b[74Gcheck\u001b[80Gand\u001b[84Gits\u001b[88Ggate\u001b[93G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m)\u001b[111Gin\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249mjettison.lane-b\u001b[39m now. That is\u001b[32Gt\u001b[35G only h\u001b[43Gavy ru\u001b[50G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Gthe\u001b[12Gdocs\u001b[17Gcould\u001b[23Gbe\u001b[26Gwritten\u001b[34Gduring\u001b[41Gthe\u001b[45Gbuild,\u001b[52Gand\u001b[56Gthey're\u001b[64Gdone.\u001b[70GThe\u001b[74Gengine\u001b[81Ggate\u001b[86Ghas\u001b[90Gsince\u001b[96Gpassed,\u001b[104Gso\u001b[107Gthe\u001b[111Gwork\u001b[116Gis\r\u001b[1B \u001b[3Gwaiting on your OK to commi\u001b[31G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSaved to memory:\u001b[20G\u001b[22mnever\u001b[26Grun\u001b[30Gtwo\u001b[34Gheavy\u001b[40Ggates\u001b[46Gat\u001b[49Gonce.\u001b[55GCode\u001b[60Gedits,\u001b[67Gincremental\u001b[79Gbuilds\u001b[86Gand\u001b[90Glight\u001b[96Gtests\u001b[102Gare\u001b[106Gfine\u001b[111Gbeside\u001b[118Ga\r\u001b[2C\u001b[1Bgate in another lane. This\u001b[30Greplaces the old \"n\u001b[50Gthing beside clang\" not\u001b[74G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne deviation from the handoff.\u001b[35G\u001b[22mJettison's\u001b[46Gdurable\u001b[54Gwrite\u001b[60Galways\u001b[67Gcreated\u001b[75Gfiles\u001b[81Gas\u001b[84G0644,\u001b[90Gso\u001b[93Gthe\u001b[97Gserver's\u001b[106Gsecret\u001b[113Gkey\r\u001b[2C\u001b[1Bcould never be 0600 from the momen\u001b[38G \u001b[40Gt wa\u001b[46Gwritten. I added \u001