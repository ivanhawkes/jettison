[0.014, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1Bshare\u001b[12Gan\u001b[15Geffect.\u001b[23GIt\u001b[26Gdid\u001b[30G\u001b[1mnot\u001b[34G\u001b[22mcheck\u001b[40Gthe\u001b[44Gnode's\u001b[51Gtype\u001b[56Gor\u001b[59Gthe\u001b[63Geffect's\u001b[72Gdomain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe gap Codex found:\u001b[25G\u001b[22muppose a mod or overlay changes a\u001b[59Gtechnology\u001b[70Gno\u001b[73Ge (say \u001b[38;2;177;185;249mAgeStone\u001b[39m, a \u001b[38;2;177;185;249mTech\u001b[39m node) so i\u001b[108G targets the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mCargoHolds\u001b[14G\u001b[39meffect. A\u001b[24Gsave could then list \u001b[38;2;177;185;249m{AgeStone, 1}\u001b[39m on a ship, and loading would accept it \u001b[99Gnd give\u001b[107Gthe\u001b[112Ghip a\u001b[K\r\u001b[2C\u001b[1B2,560-tote hold. Yet no purchase co\u001b[40Gd\u001b[42Gever have produced that entry: technolog\u001b[84Gis the civilisation's, not\u001b[111Gsomething\u001b[K\r\u001b[2C\u001b[1Bfitted to a\u001b[15Gship. Similarly, if a hull gained\u001b[49Ga \u001b[38;2;177;185;249mDrydock\u001b[39m slot, a save could car\u001b[82Gy \u001b[38;2;177;185;249mSkillYardDrydock\u001b[39m, which is a shipyard\r\u001b[2C\u001b[1Beffect, not\u001b[15Ga\u001b[17Gship\u001b[22Gone.\u001b[27GSo\u001b[30Gloading\u001b[38Genforced\u001b[47Ga\u001b[49Glooser\u001b[56Grule\u001b[61Gthan\u001b[66Gbuying,\u001b[74Gwhich\u001b[80Gbreaks\u001b[87Gthe\u001b[91Gcoding\u001b[98Gstandards'\u001b[109G\"one\u001b[114Grule,\r\u001b[2C\u001b[1Bone\u001b[7Gowner\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[22m \u001b[38;2;177;185;249mFits\u001b[39m now also\u001b[26Grequire\u001b[34G \u001b[36Gach entry \u001b[47Go be a\u001b[54G\u001b[38;2;177;185;249mSkill\u001b[39m node\u001b[65Gwhose\u001b[71Geffect\u001b[78Gis\u001b[81Ga\u001b[83GShip-domain\u001b[95Geffect\u001b[102Gin\u001b[105Gthe\u001b[109Gcatalogue.\r\u001b[2C\u001b[1BBuying\u001b[10Gand\u001b[14Gloading\u001b[22Gnow\u001b[26Ghold\u001b[31Gsystems\u001b[39Gto\u001b[42Gexactly\u001b[50Gthe\u001b[54Gsame\u001b[59Grule.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe test:\u001b[22m in the company suite I added a variant of the conten\u001b[66G with a\u001b[74G\u001b[38;2;177;185;249mTech\u001b[39m copy of \u001b[89Ge c\u001b[93Grgo-hold\u001b[103Gnode,\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mTechCargoHolds\u001b[39m.\u001b[19GA\u001b[21Gship\u001b[26Ggiven\u001b[32Gthat\u001b[37Gentry\u001b[43Gis\u001b[46Gsaved,\u001b[53Gand\u001b[57Gloading\u001b[65Gthe\u001b[69Gsave\u001b[74Gis\u001b[77Grefused\u001b[85Gwith\u001b[90G\"has\u001b[95Gsystems\u001b[103Git\u001b[106Gcannot\u001b[113Gcarry\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTh\u001b[6G gate is running\u001b[25G this final\u001b[37Gtree now.\u001b[47GThat\u001b[52Gwas\u001b[56Gthe\u001b[60Gsecond\u001b[67Gand\u001b[71Glast\u001b[76Greview\u001b[83Ground,\u001b[90Gso\u001b[93Gwhether\u001b[101Ga\u001b[103Gthird\u001b[109Ground\u001b[115Gis\r\u001b[2C\u001b[1Bneeded\u001b[10Gis\u001b[13Gyour\u001b[18Gcall\u001b[23Gonce\u001b[28Gthe\u001b[32Ggate\u001b[37Gresult\u001b[44Gis\u001b[47Gin.\r\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRunning\u001b[11Gcd '../manifest'\u001b[28G&& CMAKE_BUILD_PARA\u001b[48GLEL_LEVEL=24…\u001b[K\r\u001b[2C\u001b[1B⎿\u001b[6G$ cd '../manifest' && CMAKE_BUILD_PARALLE\u001b[76GEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci\u001b[117Gsh\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
