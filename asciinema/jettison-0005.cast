[0.101, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m2\u001b[11G\u001b[22mdistinct f\u001b[22Gom the new compact\u001b[41G32-tote ship below. 160\u001b[65Gtotes is the selected starting hold\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 13 -\u001b[38;2;248;248;242mcapacity; upgrade rules and                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 14 -\u001b[38;2;248;248;242mother starter specifications remain open.                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 13 +\u001b[38;2;248;248;242mcapacity. Its first upgrade is a tier of cargo holds, 2,400 totes more                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 14 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-096\u001b[38;2;248;248;242m](decision-ledger.md#d-096)); other upgrade rules and starter specifications remain open.       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 15 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 16 \u001b[22m The subsequently selected initial starter supply is 30 kg of oxygen and one fresh\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22minstalled\u001b[21Gstandard\u001b[30Gscrubber\u001b[39Gcartridge,\u001b[50Gproviding\u001b[60G30\u001b[63Goccupant-days\u001b[77Gof\u001b[80Gscrubbing\u001b[90Gcapacity.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command, recalled \u001b[1m1\u001b[22m memory \u001b[63G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs are updated. Running Manifest's full gate (werror, asan,\u001b[65Gtidy)\u001b[71Gat\u001b[74Gfull\u001b[79Gwidth.\u001b[86GMemory\u001b[93Gis\u001b[96Gfree:\u001b[102G52\u001b[105GGB\u001b[108Gavailable.\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m--werror --asan --tidy --log build/gate-w08.log > build/gate-w08.out 2>&1; echo \"exit=$?\" >> build/gate-w08.out (1m\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m50s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ start a cross code review while the gate is running\u001b[39m                                                                   \r\u001b[2C\u001b[5B\u001b[49m\u001b[2mPress up to edit queued messages\u001b[22m\u001b[K\r\u001b[37C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
