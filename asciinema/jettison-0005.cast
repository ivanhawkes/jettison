[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/g\u001b[39Gme/content/src/Content.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m15\u001b[15G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[2m 446 \u001b[22m     checker.\u001b[38;2;166;226;46mRequire\u001b[39m(\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 447 \u001b[20G\u001b[22mregistry.\u001b[38;2;166;226;46mFind\u001b[39m<Dock::HullDefinition>(name)\u001b[62G!=\u001b[65G\u001b[38;2;190;132;255mnullptr\u001b[39m,\u001b[74G\u001b[38;2;230;219;116m\"dock\"\u001b[39m,\r\u001b[1B \u001b[3G   \u001b[2m 448 \u001b[22m \u001b[13G     \u001b[19G st\u001b[23G::format(\u001b[38;2;230;219;116m\"has no Dock.HullDefinition '{}'\"\u001b[39m,\u001b[67Gname));\u001b[75G\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 449 +\u001b[38;2;248;248;242m    \u001b[38;2;117;113;94m// A ship is a box of its dock hull's size, whose largest moment of inertia, its mass times its\u001b[38;2;248;248;242m   \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 450 +\u001b[38;2;248;248;242m    \u001b[38;2;117;113;94m// two larger sides squared over 12, Jolt keeps and decomposes in floats: held far below a\u001b[38;2;248;248;242m        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 451 +\u001b[38;2;248;248;242m    \u001b[38;2;117;113;94m// float's largest, so that arithmetic cannot overflow.\u001b[38;2;248;248;242m                                           \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 452 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m kMaxInertia = \u001b[38;2;190;132;255m1e18\u001b[38;2;248;248;242m;                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 453 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mif\u001b[38;2;248;248;242m (\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::optional<\u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m> mass = registry.\u001b[38;2;166;226;46mFind\u001b[38;2;248;248;242m<Core::ShipClassSpec>(name)->mass)            \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 454 +\u001b[38;2;248;248;242m    {                                                                                                 \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 455 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m Dock::HullDefinition &dock = *registry.\u001b[38;2;166;226;46mFind\u001b[38;2;248;248;242m<Dock::HullDefinition>(name);                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 456 +\u001b[38;2;248;248;242m      std::array<\u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m, 3> sides{dock.length, dock.beam, dock.height};                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 457 +\u001b[38;2;248;248;242m      std::ranges::\u001b[38;2;166;226;46msort\u001b[38;2;248;248;242m(sides);                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 458 +\u001b[38;2;248;248;242m      checker.\u001b[38;2;166;226;46mRequire\u001b[38;2;248;248;242m(                                                                                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;248;248;242m      *mass * (sides[\u001b[38;2;190;132;255m1\u001b[38;2;248;248;242m] * sides[\u001b[38;2;190;132;255m1\u001b[38;2;248;248;242m] + sides[\u001b[38;2;190;132;255m2\u001b[38;2;248;248;242m] * sides[\u001b[38;2;190;132;255m2\u001b[38;2;248;248;242m]) / \u001b[38;2;190;132;255m12.0\u001b[38;2;248;248;242m <= kMaxInertia, \u001b[38;2;230;219;116m\"mass\"\u001b[38;2;248;248;242m,       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[16G\u001b[38;2;248;248;242m      std::format(                                                                                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[16G\u001b[38;2;248;248;242m          \u001b[38;2;230;219;116m\"gives its {} x {} x {} m box an inertia past {} kg m^2\"\u001b[38;2;248;248;242m,\u001b[84Gdock.length,\u001b[97Gdock.beam,\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[16G\u001b[38;2;248;248;242m          dock.height, kMaxInertia));                                                             \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[16G\u001b[38;2;248;248;242m}                              \u001b[76G                                      \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
