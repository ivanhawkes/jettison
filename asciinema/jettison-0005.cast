} kg m^2\"\u001b[38;2;248;248;242m, dock.length, dock.beam,       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 462 +\u001b[38;2;248;248;242m              dock.height, kMaxInertia));                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 463 +\u001b[38;2;248;248;242m    }                              \u001b[76G                                      \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
