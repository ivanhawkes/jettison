[0.043, "o", "\u001b[?25l\u001b[H     \u001b[2m 10 \u001b[22m The starte\u001b[22G ship is\u001b[31Gthe entry\u001b[41Gpoint\u001b[47Gfor\u001b[51Ga\u001b[53Glone\u001b[58Gtrader\u001b[65Gand\u001b[69Ghas\u001b[73Ga\u001b[75Gcargo\u001b[81Ghold\u001b[86Gof\u001b[89G160\u001b[93Gtotes\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22m(20\u001b[15Gm³, a tote be\u001b[29Gng an\u001b[36Gighth \u001b[43Gf a\u001b[47Gcubic\u001b[53Gmetre, [\u001b[38;2;230;219;116mD-087\u001b[39m](decision-ledger.md#d-087)). It\u001b[99Gis\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22mdistinct fr\u001b[23Gm th\u001b[28G \u001b[30Gew compac\u001b[40G 32-tote ship below. 160 totes \u001b[73G the sel\u001b[82Gcte\u001b[86G starting\u001b[96Ghold\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 13 -\u001b[38;2;248;248;242mcapacity; upgrade rules and                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m4\u001b[11G\u001b[38;2;248;248;242mother starter sp\u001b[28Gcifications\u001b[40Gremain\u001b[47Gopen.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 13 +\u001b[38;2;248;248;242mcapacity. Its first upgrade is a tier of cargo holds, 2,400 totes more                                 \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-096\u001b[38;2;248;248;242m](decision-ledger.md#d-096)); other upgrade rules and starter specifications remain open.       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 15 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22mThe\u001b[15Gsubsequently\u001b[28Gselected\u001b[37Ginitial\u001b[45Gstarter\u001b[53Gsupply\u001b[60Gis\u001b[63G30\u001b[66Gkg\u001b[69Gof\u001b[72Goxygen\u001b[79Gand\u001b[83Gone\u001b[87Gfresh\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22minstalled standard scrubber cartridge, p\u001b[52Goviding\u001b[60G30\u001b[63Goccupant-da\u001b[75Gs of scrubbing capacity.\r\u001b[5