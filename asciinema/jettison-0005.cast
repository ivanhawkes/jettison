[0.037, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/small-trader-and-docking-plan.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m The starter ship is the entry point for a lone trader and has a cargo hold of 160 totes\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 11 \u001b[22m (20 m³, a tote being an eighth of a cubic metre, [\u001b[38;2;230;219;116mD-087\u001b[39m](decision-ledger.md#d-087)). It is\u001b[K\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22mdistinct\u001b[20Gfrom\u001b[25Gthe\u001b[29Gnew\u001b[33Gcompact\u001b[41G32-tote\u001b[49Gship\u001b[54Gbelow.\u001b[61G160\u001b[65Gtotes\u001b[71Gis\u001b[74Gthe\u001b[78Gselected\u001b[87Gstarting\u001b[96Ghold\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 13 -\u001b[38;2;248;248;242mcapacity; upgrade rules and                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 14 -\u001b[38;2;248;248;242mother starter specifications remain open.                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 13 +\u001b[38;2;248;248;242mcapacity. Its first upgrade is a tier of cargo holds, 2,400 totes more                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 14 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-096\u001b[38;2;248;248;242m](decision-ledger.md#d-096)); other upgrade rules and starter specifications remain open.       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 15 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 16 \u001b[22m The subseque\u001b[24Gtly select\u001b[35Gd initia\u001b[45Gstarter supply is 30 kg of oxygen\u001b[79Gan\u001b[82G one fresh\u001b[93G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 17 \u001b[11G\u001b[22minstalled\u001b[21Gstandard\u001b[30Gscrubber\u001b[39Gcartridge,\u001b[50Gproviding\u001b[60G30\u001b[63Goccupant-days\u001b[77Gof\u001b[80Gscrubbing\u001b[90Gcapacity.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command, recalled \u001b[1m1\u001b[22m memory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs are\u001b[12Gupdated.\u001b[21GRunning\u001b[29GManifest's\u001b[40Gfull\u001b[45Ggate\u001b[50G(werror,\u001b[59Gasan,\u001b[65Gtidy)\u001b[71Gat\u001b[74Gfull\u001b[79Gwidth.\u001b[86GMemory\u001b[93Gis\u001b[96Gfree:\u001b[102G52\u001b[105GGB\u001b[108Gavailable.\r\u001b[2C\u001b[7B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
