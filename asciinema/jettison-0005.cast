[0.114, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[14G\u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m (\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[38;2;249;38;114mauto\u001b[38;2;248;248;242m &[fitted, problem] : broken)                                                        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;248;248;242m{\u001b[16G                                                                                                  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m799\u001b[16G\u001b[38;2;166;226;46mCAPTURE\u001b[38;2;248;248;242m(problem);                                                                                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[16G\u001b[38;2;248;248;242msy\u001b[21Gms.fitt\u001b[30G =\u001b[33Gfitted;\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;248;248;242mHosted refused;                                                                                   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::\u001b[38;2;166;226;46muint64\u001b[34Gt\u001b[38;2;248;248;242m before\u001b[43G=\u001b[45Grefused.world.\u001b[38;2;166;226;46mStateHash\u001b[38;2;248;248;242m();\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[16G\u001b[38;2;166;226;46mCHECK_THROWS_WITH_AS\u001b[38;2;248;248;242m(                       \u001b[61G                                  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[20G\u001b[38;2;248;248;242mr\u001b[22Gfused.world.\u001b[38;2;166;226;46mLoad\u001b[38;2;248;248;242m(hosted.world.\u001b[38;2;166;226;46mSave\u001b[38;2;248;248;242m()), doctest::\u001b[38;2;166;226;46mContains\u001b[38;2;248;248;242m(problem.\u001b[38;2;166;226;46mdata\u001b[38;2;248;248;242m()),                   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;248;248;242m    Jettison::Serialise::FormatError);                                