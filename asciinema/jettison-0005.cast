[3.634, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1Bshare an\u001b[15Geffec\u001b[21G. It did \u001b[1mnot\u001b[22m check the\u001b[44Gnode's type \u001b[59Gthe\u001b[69G's domain.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe gap Codex found:\u001b[24G\u001b[22msuppose\u001b[32Ga\u001b[34Gmod\u001b[38Gor\u001b[41Goverlay\u001b[49Gchanges\u001b[57Ga\u001b[59Gtechnology\u001b[70Gnode\u001b[75G(say\u001b[80G\u001b[38;2;177;185;249mAgeStone\u001b[39m,\u001b[90Ga\u001b[92G\u001b[38;2;177;185;249mTech\u001b[97G\u001b[39mnode)\u001b[103Gso\u001b[106Git\u001b[109Gtargets\u001b[117Gthe\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mCargoHolds\u001b[39m effect. A\u001b[25Gave could then list \u001b[38;2;177;185;249m{AgeStone, 1}\u001b[59G\u001b[39mon a ship,\u001b[70Gan\u001b[73G loading would accept it and give \u001b[108Ghe ship a\u001b[K\r\u001b[2C\u001b[1B2,560-tote\u001b[14Ghold. Yet\u001b[24Gno purchase could ever have produced that entry: technology is the civilis\u001b[99Gtion's,\u001b[107Gnot\u001b[112Gomething\r\u001b[2C\u001b[1Bfitted to a ship. Similarly, if a h\u001b[40Gl\u001b[42Ggained a \u001b[38;2;177;185;249mDrydock\u001b[39m slot, a save could carr\u001b[84G\u001b[38;2;177;185;249mSkillYardDrydock\u001b[39m, which is\u001b[111Ga shipyard\r\u001b[2C\u001b[1Beffect, not\u001b[15Ga ship one. So loading enforced a\u001b[49Glooser rule than buying, which b\u001b[82Geaks the coding standards' \"one rule,\u001b[K\r\u001b[2C\u001b[1Bone owner\".\u001b[15G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[12G\u001b[22m\u001b[38;2;177;185;249mFits\u001b[17G\u001b[39mnow\u001b[21Galso\u001b[26Grequires\u001b[35Geach\u001b[40Gentry\u001b[46Gto\u001b[49Gbe\u001b[52Ga\u001b[54G\u001b[38;2;177;185;249mSkill\u001b[60G\u001b[39mnode\u001b[65Gwhose\u001b[71Geffect\u001b[78Gis\u001b[81Ga\u001b[83GShip-domain\u001b[95Geffect\u001b[102Gin\u001b[105Gthe\u001b[109Gcatalogue.\r\u001b[2C\u001b[1BBuying and loading now\u001b[26Ghold sy\u001b[34Gt\u001b[36Gms to exac\u001b[47Gly the\u001b[54Gsame rule.\u001b[65G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe test:\u001b[13G\u001b[22min\u001b[16Gthe\u001b[20Gcompany\u001b[28Gsuite\u001b[34GI\u001b[36Gadded\u001b[42Ga\u001b[44Gvariant\u001b[52Gof\u001b[55Gthe\u001b[59Gcontent\u001b[67Gwith\u001b[72Ga\u001b[74G\u001b[38;2;177;185;249mTech\u001b[79G\u001b[39mcopy\u001b[84Gof\u001b[87Gthe\u001b[91Gcargo-holds\u001b[103Gnode,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mTechCargoHolds\u001b[39m. A ship given that entry is saved, and loading \u001b[66Ghe save\u001b[74Gis refused wi\u001b[89G \"h\u001b[93Gs system\u001b[103Git cannot\u001b[113Gcarry\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Ggate\u001b[12Gis\u001b[15Grunning\u001b[23Gon\u001b[26Gthis\u001b[31Gfinal\u001b[37Gtree\u001b[42Gnow.\u001b[47GThat\u001b[52Gwas\u001b[56Gthe\u001b[60Gsecond\u001b[67Gand\u001b[71Glast\u001b[76Greview\u001b[83Ground,\u001b[90Gso\u001b[93Gwhether\u001b[101Ga\u001b[103Gthird\u001b[109Ground\u001b[115Gis\r\u001b[2C\u001b[1Bne\u001b[6Gded is your call\u001b[25Gce the gate\u001b[37Gresult is\u001b[47Gin.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m                                            \u001b[27;1H\u001b[24;3H\u001b[?25h"]
