                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[38;2;249;38;114ma\u001b[22Gto\u001b[25G\u001b[38;2;248;248;242mtierOf\u001b[32G=\u001b[34G[&systems](std::string_view\u001b[62GskillId)\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242m{\u001b[16G                                                                                                  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[22G\u001b[38;2;249;38;114mauto\u001b[27G\u001b[38;2;248;248;242mfitted =\u001b[36Gstd::ranges::\u001b[38;2;166;226;46mfind\u001b[38;2;248;248;242m(systems.fitted,\u001b[70GskillId,\u001b[79G&World::Fitting::skillId);\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[16G\u001b[38;2;249;38;114mreturn\u001b[38;2;248;248;242m fitted == systems.fitted.\u001b[38;2;166;226;46mend\u001b[38;2;248;248;242m() ? \u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m : fitted->tier;                                         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242m};\u001b[20G                           \u001b[75G                                       \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.296, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bgate's \u001b[38;2;177;185;249mbuild/\u001b[39m. Wa\u001b[21Gting for both.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gpassed:\u001b[20Gwerror,\u001b[28Gasan,\u001b[34Grelease\u001b[42Gand\u001b[46Gtidy\u001b[51Gat\u001b[54Gfull\u001b[59Gwidth,\u001b[66G45/45\u001b[72Gsuites\u001b[79Gin\u001b[82Geach\u001b[87Gpreset,\u001b[95G\u001b[38;2;177;185;249mexit=0\u001b[39m.\u001b[103GWaiting\u001b[111Gfor\u001b[115Gthe\r\u001b[1B \u001b[3Greview.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound 1 left\u001b[16Gthe\u001b[20Gtree\u001b[25Gunchanged\u001b[35Gwith\u001b[40Gthree\u001b[46Gfindings,\u001b[56Gall\u001b[60Gof\u001b[63Gwhich\u001b[69GI\u001b[71Gaccept:\u001b[79Ga\u001b[81Gsave\u001b[86Gcan\u001b[90Gload\u001b[95Gsystems\u001b[103Gpurchase\u001b[112Grules\r\u001b[2C\u001b[1Bwould refuse, a tiny mass like 1e-100 becomes zero as a float, and shared effects can shrink the hold. I'll fix\u001b[115Gthem\r\u001b[2C\u001b[1Bthrough one shared fitting check and stricter mass and hold rules.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/source/game/company/src/Company.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m57\u001b[22m lines, removed \u001b[1m21\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  58 \u001b[22m };\u001b[K\r\