[0.060, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 12 \u001b[11G\u001b[22mdistinct\u001b[20Gfrom\u001b[25Gthe\u001b[29Gnew\u001b[33Gcompact\u001b[41G32-tote\u001b[49Gship\u001b[54Gbelow.\u001b[61G160\u001b[65Gtotes\u001b[71Gis\u001b[74Gthe\u001b[78Gselected\u001b[87Gstarting\u001b[96Ghold\r\u001b[1B \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 13 -\u001b[38;2;248;248;242mcapacity; upgrade rules and                                                                            \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 14 -\u001b[38;2;248;248;242mother starter specifications remain open.                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 13 +\u001b[38;2;248;248;242mcapacity. Its first upgrade is a tier of cargo holds, 2,400 totes more                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 14 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-096\u001b[38;2;248;248;242m](decision-ledger.md#d-096)); other upgrade rules and starter specifications remain open.       \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m5\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 16 \u001b[22m The subsequently selected initial starter supply is 30 kg of oxygen and one fresh\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 17 \u001b[22m installed standard scrubber cartridge, providing 30 occupant-days of scrubbing capacity.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command, recalled \u001b[1m1\u001b[22m memory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs are updated. Ru\u001b[24Gning Manif\u001b[35Gst's ful\u001b[45Ggate (werror, asan, tidy) at full\u001b[79Gwi\u001b[82Gth. Memory\u001b[93Gis\u001b[96Gfree:\u001b[102G52\u001b[105GGB\u001b[108Gavailable.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mstart a cross code review while the gate is running\u001b[39m                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'../manifest'\u001b[28G&&\u001b[31GCMAKE_BUILD_PARALLEL_LEVEL=24…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[5C\u001b[1B--werror --asan --tidy --log build/gate-w08.log > build/gate-w08.out 2>&1; echo \"exit=$?\" >> build/gate-w08.out (1m\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m57s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
