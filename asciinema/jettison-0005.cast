[0.258, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m  \u001b[38;2;255;255;255mto be a Skill node of a ship effect. I'm fixing that in Fits and adding a test.\"\u001b[39m                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe save\u001b[12Gcheck\u001b[18Gcould\u001b[24Gstill\u001b[30Gaccept\u001b[37Ga\u001b[39G\"system\"\u001b[48Gthat\u001b[53Gthe\u001b[57Gpurchase\u001b[66Gcommand\u001b[74Gwould\u001b[80Gnever\u001b[86Gsell.\u001b[92GThe\u001b[96Gnew\u001b[100Gcheck\u001b[106Gcloses\u001b[113Gthat\r\u001b[2C\u001b[1Bgap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a \"system\" is here:\u001b[22m a ship's saved \u001b[38;2;177;185;249mSystems\u001b[39m lis\u001b[55G records w\u001b[66Gat it\u001b[77Gany bought, e.g. \u001b[38;2;177;185;249m{SkillShipCargoHolds, tier \r\u001b[2C\u001b[1B1}\u001b[39m.\u001b[7GEach\u001b[12Gentry\u001b[18Gnames\u001b[24Ga\u001b[26Gnode\u001b[31Gof\u001b[34Gthe\u001b[38Gskill\u001b[44Gtree,\u001b[50Gand\u001b[54Gthe\u001b[58Gship's\u001b[65Ghold\u001b[70Gis\u001b[73Gcomputed\u001b[82Gfrom\u001b[87Gthose\u001b[93Gentries.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo places decide what a ship may carry:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mBuying.\u001b[22m Content only lets\u001b[32Gan offer sell\u001b[46Ga\u001b[48Gnode\u001b[53Gof\u001b[56Gtype\u001b[61G\u001b[38;2;177;185;249mSkill\u001b[67G\u001b[39mwhose\u001b[73Geffect\u001b[80Gbelongs\u001b[88Gto\u001b[91Gthe\u001b[95G\u001b[3mShip\u001b[100G\u001b[23mdomain.\u001b[108GSo\u001b[111G\u001b[38;2;177;185;249mUpgrade\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gcan only ever fit g\u001b[26Gnuine ship\u001b[37Gsystems.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mLoading a save.\u001b[22m After round 1, both path\u001b[48Gshare one rule, \u001b[38;2;177;185;249mFits\u001b[39m. It checked that the node exists in\u001b[105Gthe game mode,\r\u001b[5C\u001b[1Bits tier\u001b[15Gis wi\u001b[21Ghin \u001b[38;2;177;185;249mmaxTiers\u001b[39m, the hull\u001b[44Ghas a slot f\u001b[59Gits\u001b[69G, its prerequisites\u001b[89Gare\u001b[93Gfitted,\u001b[101Gand\u001b[105Gno\u001b[108Gtwo\u001b[112Gsystems\r\u001b[5C\u001b[1Bshare\u001b[12Gan\u001b[15Geffect.\u001b[23GIt\u001b[26Gdid\u001b[30G\u001b[1mnot\u001b[34G\u001b[22mcheck\u001b[40Gthe\u001b[44Gnode's\u001b[51Gtype\u001b[56Gor\u001b[59Gthe\u001b[63Geffect's\u001b[72Gdomain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe gap Codex found:\u001b[25G\u001b[22muppose a mod or overlay changes a\u001b[59Gtechnology\u001b[70Gno\u001b[73Ge (say \u001b[38;2;177;185;249mAgeStone\u001b[39m, a \u001b[38;2;177;185;249mTech\u001b[39m node) so i\u001b[108G targets the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mCargoHolds\u001b[14G\u001b[39meffect. A\u001b[24Gsave could then list \u001b[38;2;177;185;249m{AgeStone, 1}\u001b[39m on a ship, and loading would accept it \u001b[99Gnd give\u001b[107Gthe\u001b[112Ghip a\u001b[K\r\u001b[2C\u001b[1B2,560-tote hold. Yet no purchase co\u001b[40Gd\u001b[42Gever have produced that entry: technolog\u001b[84Gis the civilisation's, not\u001b[111Gsomething\u001b[K\r\u001b[2C\u001b[1Bfitted to a\u001b[15Gship. Similarly, if a hull gained\u001b[49Ga \u001b[38;2;177;185;249mDrydock\u001b[39m slot, a save could car\u001b[82Gy \u001b[38;2;177;185;249mSkillYardDrydock\u001b[39m, which is a shipyard\r\u001b[2C\u001b[1Beffect, not\u001b[15Ga\u001b[17Gship\u001b[22Gone.\u001b[27GSo\u001b[30Gloading\u001b[38Genforced\u001b[76Gich\u001b[80Gbreaks\u001b[87Gthe\u001b[91Gcoding\u001b[98Gstandards'\u001b[109G\"one\u001b[114Grule,\u001b[27;1H\u001b[24;3H\u001b[?25h"]
