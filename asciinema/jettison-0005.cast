[0.880, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound 2 surfaced another valid gap: the shared rule doesn't yet require each system to be a Skill node of a ship\r\u001b[2C\u001b[1Beffect. I'm fixing that in \u001b[38;2;177;185;249mFits\u001b[39m and adding a test.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/company/src/Company.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[6C\u001b[1B\u001b[2m59\u001b[11G\u001b[22m};\r\u001b[5C\u001b[1B\u001b[2m 60 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 61 \u001b[22m\u001b[K\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 62 -\u001b[38;2;248;248;242m// Whether a ship of the hull can carry the systems: each a \u001b[48;2;92;2;0mskill\u001b[48;2;61;1;0m of the game mode \u001b[48;2;92;2;0mat\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mmost\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 63 -\u001b[38;2;248;248;242m// maxTiers, the effect of none another's, the hull with a slot for each effect, and each prerequisite \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 62 +\u001b[38;2;117;113;94m// Whether a ship of the hull can carry the systems: each a \u001b[48;2;4;71;0mSkill\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mnode \u001b[48;2;2;40;0mof the game mode\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mof\u001b[48;2;2;40;0m \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mship\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 63 +\u001b[38;2;117;113;94m// \u001b[48;2;4;71;0meffect, at most its \u001b[48;2;2;40;0mmaxTiers, the effect of none another's, the hull with a slot for each effect, an\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;117;113;94md each prerequisite\u001b[38;2;248;248;242m             \u001b[44G        \u001b[53G \u001b[55G                                                     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 64 \u001b[22m \u001b[38;2;117;113;94m// fitted among them at its tier. What Upgrade fits, and what a save may hold.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 65 \u001b[22m \u001b[38;2;166;226;46mbool\u001b[39m \u001b[38;2;166;226;46mFits\u001b[38;2;253;151;31m(\u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m Rules &rules, \u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m Core::ShipClassSpec &hull, \u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m World::Systems &systems)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[22m {\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/project\u001b[20G/manif\u001b[27Gst/source/game/compa\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
