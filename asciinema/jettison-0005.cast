[0.034, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;2;215;119;87m✶\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.047, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mTwo places decide what a ship may carry:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mBuying.\u001b[22m Content only lets an offer sell a node of type \u001b[38;2;177;185;249mSkill\u001b[39m whose effect belongs to the \u001b[3mShip\u001b[23m domain. So \u001b[38;2;177;185;249mUpgrade\r\u001b[5C\u001b[1B\u001b[39mcan only ever fit genuine ship systems.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mLoading a save.\u001b[22m After round 1, both paths share one rule, \u001b[38;2;177;185;249mFits\u001b[39m. It checked that the node exists in the game mode,\r\u001b[5C\u001b[1Bits tier is within \u001b[38;2;177;185;249mmaxTiers\u001b[39m, the hull has a slot for its effect, its prerequisites are fitted, and no two systems\r\u001b[5C\u001b[1Bshare an effect. It did \u001b[1mnot\u001b[22m check the node's type or the effect's domain.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe gap Codex found:\u001b[22m suppose a mod or overlay change\u001b[56G a tec\u001b[63Gnology node (say \u001b[38;2;177;185;249mAgeStone\u001b[39m, a \u001b[38;2;177;185;249mTech\u001b[97G\u001b[39mnode)\u001b[103Gso\u001b[106Git\u001b[109Gtargets\u001b[117Gthe\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mCargoHolds\u001b[14G\u001b[39meffect. A save\u001b[29Gcould\u001b[35Gthen\u001b[40Glist\u001b[45G\u001b[38;2;177;185;249m{AgeStone, 1}\u001b[59G\u001b[39mon\u001b[62Ga\u001b[64Gship,\u001b[70Gand\u001b[74Gloading\u001b[82Gwould\u001b[88Gaccept\u001b[95Git\u001b[98Gand\u001b[102Ggive\u001b[107Gthe\u001b[111Gship\u001b[116Ga\r\u001b[2C\u001b[1B2,560-tote\u001b[14Ghold.\u001b[20GYet\u001b[24Gno\u001b[27Gpurchase\u001b[36Gcould\u001b[42Gever\u001b[47Ghave\u001b[52Gproduced\u001b[61Gthat\u001b[66Gentry:\u001b[73Gtechnology\u001b[84Gis\u001b[87Gthe\u001b[91Gcivilisation's,\u001b[107Gnot\u001b[111Gsomething\r\u001b[2C\u001b[1Bfitted to a ship. Similarly,\u001b[32Gif\u001b[35Ga\u001b[37Ghull\u001b[42Ggained\u001b[49Ga\u001b[51G\u001b[38;2;177;185;249mDrydock\u001b[59G\u001b[39mslot,\u001b[65Ga\u001b[67Gsave\u001b[72Gcould\u001b[78Gcarry\u001b[84G\u001b[38;2;177;185;249mSkillYardDrydock\u001b[39m,\u001b[102Gwhich\u001b[108Gis\u001b[111Ga\u001b[113Gshipyard\r\u001b[2C\u001b[1Beffect,\u001b[11Gnot\u001b[15Ga\u001b[17Gship\u001b[22Gone.\u001b[27GSo\u001b[30Gloading\u001b[38Genforced\u001b[47Ga\u001b[49Glooser\u001b[56Grule\u001b[61Gthan\u001b[66Gbuying,\u001b[74Gwhich\u001b[80Gbreaks\u001b[87Gthe\u001b[91Gcoding\u001b[98Gstandards'\u001b[109G\"one\u001b[114Grule,\r\u001b[1B \u001b[3Gone owner\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[12G\u001b[22m\u001b[38;2;177;185;249mFits\u001b[17G\u001b[39mnow\u001b[21Galso\u001b[26Grequires\u001b[35Geach\u001b[40Gentry\u001b[46Gto\u001b[49Gbe\u001b[52Ga\u001b[54G\u001b[38;2;177;185;249mSkill\u001b[60G\u001b[39mnode\u001b[65Gwhose\u001b[71Geffect\u001b[78Gis\u001b[81Ga\u001b[83GShip-domain\u001b[95Geffect\u001b[102Gin\u001b[105Gthe\u001b[109Gcatalogue.\r\u001b[2C\u001b[1BBuying and loading now\u001b[26Ghold\u001b[31Gsystems\u001b[39Gto\u001b[42Gexactly\u001b[50Gthe\u001b[54Gsame\u001b[59Grule.\r\u001b[2B  \u001b[1mThe test:\u001b[22m in the company suite I added a variant of the content with a \u001b[38;2;177;185;249mTech\u001b[39m copy of the cargo-holds node,\u001b[K\r\u001b[1B  \u001b[38;2;177;185;249mTechCargoHolds\u001b[39m. A ship given that entry is saved, and loading the save is refused with \"has systems it cannot carry\".\u001b[K\r\u001b[2B \u001b[3GThe gate is running on this final tree now. That was the second and last review round, so\u001b[93Gwhether\u001b[101Ga\u001b[103Gthird\u001b[109Ground\u001b[115Gis\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.236, "o", "\u001b[?25l\u001b[H\r\u001b[46C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m1\u001b[49G1\u001b[53G8\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.066, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[38;2;177;185;249mCargoHolds\u001b[39m effect. A save could then list\u001b[45G\u001b[38;2;177;185;249m{AgeStone, 1}\u001b[59G\u001b[39mon\u001b[62Ga\u001b[64Gship,\u001b[70Gand\u001b[74Gloading\u001b[82Gwould\u001b[88Gaccept\u001b[95Git\u001b[98Gand\u001b[102Ggive\u001b[107Gthe\u001b[111Gship\u001b[116Ga\r\u001b[2C\u001b[1B2,560-tote\u001b[14Gh\u001b[16Gld. Yet no\u001b[27Gpurch\u001b[33Gse could \u001b[43Gver have produced\u001b[61Gthat entry:\u001b[73Gtechnology is the\u001b[91Gcivilisati\u001b[102Gn's, not\u001b[111Gsomething\r\u001b[2C\u001b[1Bfitted\u001b[10Gto a\u001b[15Gship. Similarly,\u001b[32Gif a\u001b[37Ghull gained\u001b[49Ga\u001b[51G\u001b[38;2;177;185;249mDrydock\u001b[59G\u001b[39mslot,\u001b[65Ga\u001b[67Gsave\u001b[72Gcould\u001b[78Gcarry\u001b[84G\u001b[38;2;177;185;249mSkillYardDrydock\u001b[39m,\u001b[102Gwhich\u001b[108Gis\u001b[111Ga\u001b[113Gshipyard\r\u001b[2C\u001b[1Beffect, not a ship\u001b[22Gone. So loading enforced a looser rule than buying, which bre\u001b[84Gks the coding \u001b[100Gandards'\u001b[109G\"on\u001b[114Grul\r\u001b[2C\u001b[1Bone owner\".\u001b[15G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[12G\u001b[22m\u001b[38;2;177;185;249mFits\u001b[17G\u001b[39mnow\u001b[21Galso\u001b[26Grequires\u001b[35Geach\u001b[40Gentry\u001b[46Gto\u001b[49Gbe\u001b[52Ga\u001b[54G\u001b[38;2;177;185;249mSkill\u001b[60G\u001b[39mnode\u001b[65Gwhose\u001b[71Geffect\u001b[78Gis\u001b[81Ga\u001b[83GShip-domain\u001b[95Geffect\u001b[102Gin\u001b[105Gthe\u001b[109Gcatalogue.\r\u001b[2C\u001b[1BBuying and loading now hold systems to exactly the same\u001b[59Grule.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe test:\u001b[22m in the\u001b[20Gcompany suite I\u001b[36Gadde\u001b[42Ga vari\u001b[49Gnt\u001b[52Gof the content with a \u001b[38;2;177;185;249mTech\u001b[39m c\u001b[81Gp\u001b[84Gof\u001b[92Gargo-holds node,\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mTechCargoHolds\u001b[39m. A\u001b[21Gship given\u001b[32Gthat\u001b[37Gentry is saved, and loading\u001b[65Gthe save is refused with \"has systems it cannot\u001b[113Gcarr\u001b[118G\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTh\u001b[7Ggat\u001b[11G is\u001b[15Grunning\u001b[23Gon\u001b[26Gthis\u001b[31Gfinal\u001b[37Gtree\u001b[42Gnow.\u001b[47GThat\u001b[52Gwas\u001b[56Gthe\u001b[60Gsecond\u001b[67Gand\u001b[71Glast\u001b[76Greview\u001b[83Ground,\u001b[90Gso\u001b[93Gwhether\u001b[101Ga\u001b[103Gthird\u001b[109Ground\u001b[115Gis\r\u001b[2C\u001b[1Bneeded\u001b[10Gis\u001b[13Gyour\u001b[18Gcall\u001b[23Gonce\u001b[28Gthe\u001b[32Ggate\u001b[37Gresult\u001b[44Gis\u001b[47Gin.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mR\u001b[5Gnning c\u001b[14G'../manifest' &&\u001b[31GCMAKE_BUILD_PARALLEL_LEVEL=24…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 ./scripts/ci.sh \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m--werror --asan --tidy --log build/gate-w08c.log > build/gate-w08c.out 2>&1; echo \"exit=$?\" >> build/gate-w08c.out \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m(3m 16s)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GSub\u001b[38;2;235;159;127mlim\u001b[38;2;215;119;87mating… \u001b[38;2;153;153;153m(Run the gate on the final tree · 32m 5s · ↓\u001b[39m \u001b[38;2;153;153;153m92.7k tokens)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
