[0.447, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mTwo places decide what a ship may carry:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mBuying.\u001b[22m Content only lets\u001b[32Gan offer sell\u001b[46Ga\u001b[48Gnode\u001b[53Gof\u001b[56Gtype\u001b[61G\u001b[38;2;177;185;249mSkill\u001b[67G\u001b[39mwhose\u001b[73Geffect\u001b[80Gbelongs\u001b[88Gto\u001b[91Gthe\u001b[95G\u001b[3mShip\u001b[100G\u001b[23mdomain.\u001b[108GSo\u001b[111G\u001b[38;2;177;185;249mUpgrade\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gcan only ever fit g\u001b[26Gnuine ship\u001b[37Gsystems.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mLoading a save.\u001b[22m After round 1, both path\u001b[48Gshare one rule, \u001b[38;2;177;185;249mFits\u001b[39m. It checked that the node exists in\u001b[105Gthe game mode,\r\u001b[5C\u001b[1Bits tier\u001b[15Gis wi\u001b[21Ghin \u001b[38;2;177;185;249mmaxTiers\u001b[39m, the hull\u001b[44Ghas a slot f\u001b[59Gits\u001b[69G, its prerequisites\u001b[89Gare\u001b[93Gfitted,\u001b[101Gand\u001b[105Gno\u001b[108Gtwo\u001b[112Gsystems\r\u001b[5C\u001b[1Bshare\u001b[12Gan\u001b[15Geffect.\u001b[23GIt\u001b[26Gdid\u001b[30G\u001b[1mnot\u001b[34G\u001b[22mcheck\u001b[40Gthe\u001b[44Gnode's\u001b[51Gtype\u001b[56Gor\u001b[59Gthe\u001b[63Geffect's\u001b[72Gdomain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe gap Codex found:\u001b[25G\u001b[22muppose a mod or overlay changes a\u001b[59Gtechnology\u001b[70Gno\u001b[73Ge (say \u001b[38;2;177;185;249mAgeStone\u001b[39m, a \u001b[38;2;177;185;249mTech\u001b[39m node) so i\u001b[108G targets the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mCargoHolds\u001b[14G\u001b[39meffect. A\u001b[24Gsave could then list \u001b[38;2;177;185;249m{AgeStone, 1}\u001b[39m on a ship, and loading would accept it \u001b[99Gnd give\u001b[107Gthe\u001b[112Ghip a\u001b[K\r\u001b[2C\u001b[1B2,560-tote hold. Yet no purchase co\u001b[40Gd\u001b[42Gever have produced that entry: technolog\u001b[84Gis the civilisation's, not\u001b[111Gsomething\u001b[K\r\u001b[2C\u001b[1Bfitted to a\u001b[15Gship. Similarly, if a hull gained\u001b[49Ga \u001b[38;2;177;185;249mDrydock\u001b[39m slot, a save could car\u001b[82Gy \u001b[38;2;177;185;249mSkillYardDrydock\u001b[39m, which is a shipyard\r\u001b[2C\u001b[1Beffect, not\u001b[15Ga\u001b[17Gship\u001b[22Gone.\u001b[27GSo\u001b[30Gloading\u001b[38Genforced\u001b[47Ga\u001b[49Glooser\u001b[56Grule\u001b[61Gthan\u001b[66Gbuying,\u001b[74Gwhich\u001b[80Gbreaks\u001b[87Gthe\u001b[91Gcoding\u001b[98Gstandards'\u001b[109G\"one\u001b[114Grule,\r\u001b[2C\u001b[1Bone\u001b[7Gowner\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix:\u001b[22m \u001b[38;2;177;185;249mFits\u001b[39m now also\u001b[26Grequire\u001b[34G \u001b[36Gach entry \u001b[47Go be a\u001b[54G\u001b[38;2;177;185;249mSkill\u001b[39m node\u001b[65Gwhose\u001b[71Geffect\u001b[78Gis\u001b[81Ga\u001b[83GShip-domain\u001b[95Geffect\u001b[102Gin\u001b[105Gthe\u001b[109Gcatalogue.\r\u001b[2C\u001b[1BBuying\u001b[10Gand\u001b[14Gloading\u001b[22Gnow\u001b[26Ghold\u001b[31Gsystems\u001b[39Gto\u001b[42Gexactly\u001b[50Gthe\u001b[54Gsame\u001b[59Grule.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe test:\u001b[22m in the company suite I added a variant of the conten\u001b[66G with a\u001b[74G\u001b[38;2;177;185;249mTech\u001b[39m copy of \u001b[89Ge c\u001b[93Grgo-hold\u001b[103Gnode,\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mTechCargoHolds\u001b[39m.\u001b[19GA\u001b[21Gship\u001b[26Ggiven\u001b[32Gthat\u001b[37Gentry\u001b[43Gis\u001b[46Gsaved,\u001b[53Gand\u001b[57Gloading\u001b[65Gthe\u001b[69Gsave\u001b[74Gis\u001b[77Grefused\u001b[85Gwith\u001b[90G\"has\u001b[95Gsystems\u001b[103Git\u001b[106Gcannot\u001b[113Gcarry\".\r\u001b[2C\u001b[1B   \u001b[7G    \u001b[12G  \u001b[15G       \u001b[23G  \u001b[26G    \u001b[31G     \u001b[37G    \u001b[42G    \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
