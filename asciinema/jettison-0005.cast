[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gpassed:\u001b[20Gwerror,\u001b[28Gasan,\u001b[34Grelease\u001b[42Gand\u001b[46Gtidy\u001b[51Gat\u001b[54Gfull\u001b[59Gwidth,\u001b[66G45/45\u001b[72Gsuites\u001b[79Gin\u001b[82Geach\u001b[87Gpreset,\u001b[95G\u001b[38;2;177;185;249mexit=0\u001b[39m.\u001b[103GWaiting\u001b[111Gfor\u001b[115Gthe\r\u001b[1B \u001b[3Greview.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound\u001b[9G1\u001b[11Gleft\u001b[16Gthe\u001b[20Gtree\u001b[25Gunchanged\u001b[35Gwith\u001b[40Gthree\u001b[46Gfindings,\u001b[56Gall\u001b[60Gof\u001b[63Gwhich\u001b[69GI\u001b[71Gaccept:\u001b[79Ga\u001b[81Gsave\u001b[86Gcan\u001b[90Gload\u001b[95Gsystems\u001b[103Gpurchase\u001b[112Grules\r\u001b[1B \u001b[3Gw\u001b[6Gl\u001b[9Grefuse, a tiny mass lik\u001b[33G 1e-100 becomes zero as a float, and shar\u001b[75Gd effects can shrink the hold. I'll fix them\r\u001b[2C\u001b[1Bthrough one sh\u001b[18Gred fitting ch\u001b[33Gck and strict\u001b[47Gr\u001b[49Gmass\u001b[55Gnd ho\u001b[61Gd rules.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/source/game/company/src/Company.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m57\u001b[22m lines, removed \u001b[1m21\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m  58 \u001b[12G\u001b[22m};\u001b[15G\u001b[K\r\u0