8;242m      starter, \u001b[38;2;230;219;116m\"version: 1\\nmass: 1e38\\n\"\u001b[38;2;248;248;242m,                                                            \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 346 +\u001b[38;2;248;248;242m      \u001b[38;2;230;219;116m\"mass gives its 9.8 x 6.4 x 1.8 m box an inertia past 1e+18 kg m^2\"\u001b[38;2;248;248;242m);                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 347 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCheckRefused\u001b[38;2;248;248;242m(                                                                                       \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 348 \u001b[22m       starter, \u001b[38;2;230;219;116m\"version: 1\\nmass: null\\n\"\u001b[39m,\u001b[K\r\u001b[1B     \u001b[2m 349 \u001b[12G\u001b[22m \u001b[14G    \u001b[38;2;230;219;116m\"starterHull 'HullLoneTraderStarter' has no mass to fly with\"\u001b[39m);\r\u001b[7C\u001b[1B\u001b[2m5\u001b[14G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B     \u001b[14G                                 \u001b[27;1H\u001b[24;3H\u001b[?25h"]
