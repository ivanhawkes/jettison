[0.421, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G   \u001b[2m 2 \u001b[22mdff379ca300b50c5007dd0bbc80ff\u001b[39G32c4eb307d19c183acb332b4ff05a7cb73\u001b[75G-\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound 3's\u001b[13Gfixes\u001b[19Ghol\u001b[23G, but round 4 found a new issue, F7: a mass\u001b[67Gof 1e38\u001b[75Gpasses\u001b[82Gthe\u001b[86Gfloat\u001b[92Gcheck\u001b[98Gyet\u001b[102Goverflows\u001b[112GJolt's\r\u001b[2C\u001b[1Bmoment-of-inertia arithmetic once the ship is dynamic. I'm bounding it in Manifest's content check against the hull's\r\u001b[2C\u001b[1Bdock dimensions next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/content/src/Content.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m15\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 446 \u001b[22m     checker.\u001b[38;2;166;226;46mRequire\u001b[39m(\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 447 \u001b[22m         registry.\u001b[38;2;166;226;46mFind\u001b[39m<Dock::HullDefinition>(name) != \u001b[38;2;190;132;255mnullptr\u001b[39m, \u001b[38;2;230;219;116m\"dock\"\u001b[39m,\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 448 \u001b[22m         std::format(\u001b[38;2;230;219;116m\"has no Dock.HullDefinition '{}'\"\u001b[39m, name));\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4\u001b[16G\u001b[38;2;117;113;94m// A ship is a box of its dock hull's size, whose largest moment of inertia, its mass times its\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;117;113;94m// two larger sides squared over 12, Jolt keeps and decomposes in floats: held far below a\u001b[38;2;248;248;242m        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;117;113;94m// float's largest, so that arithmetic cannot overflow.\u001b[38;2;248;248;242m            \u001b[84G            \u001b[97G          \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m kMaxInertia = \u001b[38;2;190;132;255m1e18\u001b[38;2;248;248;242m;                                                              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;249;38;114mif\u001b[38;2;248;248;242m (\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::optional<\u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m>\u001b[76GhipClassSpec>(name)->mass)            \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
