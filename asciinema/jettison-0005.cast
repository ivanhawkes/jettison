[0.106, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/effects/include/manifest/effects/ShipEffectEngine.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m6\u001b[14G\u001b[22mlines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// what a fill log, a UI and a test all need.\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[14G\u001b[22m\u001b[38;2;166;226;46mbool\u001b[19GRecompute\u001b[38;2;253;151;31m(EntityStore &world, \u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m \u001b[38;2;166;226;46mstd\u001b[38;2;253;151;31m::\u001b[38;2;166;226;46mstring\u001b[38;2;253;151;31m &shipId, \u001b[38;2;166;226;46mstd\u001b[38;2;253;151;31m::\u001b[38;2;166;226;46mstring\u001b[38;2;253;151;31m &errorMessage)\u001b[39m;\r\u001b[5C\u001b[1B\u001b[2m 154 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[17G\u001b[38;2;117;113;94mWhat Recompute\u001b[32Gwrites, from\u001b[45Ga hull's base stats and the tier of e\u001b[83Gch\u001b[86Geffect on\u001b[96Gi\u001b[98G, by \u001b[104Gffect\u001b[38;2;248;248;242m \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[17G\u001b[38;2;117;113;94mid: a world of its own, the hosted one, keeps \u001b[64Gts ships' systems and reads the stats here. An\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;117;113;94m// effect the catalogue does not define buys nothing.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::\u001b[38;2;166;226;46mmap\u001b[38;2;248;248;242m<EffectStat, \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m> \u001b[38;2;166;226;46mStats\u001b[38;2;253;151;31m(\u001b[38;2;248;248;242m   \u001b[53G      \u001b[60G     \u001b[66G                     \u001b[88G    \u001b[93G       \u001b[101G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m59\u001b[18G\u001b[38;2;1