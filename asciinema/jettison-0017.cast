[0.071, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 27 +\u001b[38;2;248;248;242mEvery Manifest suite and pinned hash held on the local engine at Jettison `359ad42`.                   \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 28 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[2m 29 \u001b[22m ## User'\u001b[21Grequired boundary\u001b[K\r\u001b[6C\u001b[1B\u001b[2m30\u001b[10G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m31\u001b[11G\u001b[22mManifest\u001b[20Gowns\u001b[25Gits\u001b[29Gproduction\u001b[40Ggame\u001b[45Gcode\u001b[50Gand\u001b[54Gcontent.\u001b[63GJettison\u001b[72Gsupplies\u001b[81Greusable\u001b[90Gengine\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+12\u001b[38;2;153;153;153m, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest committed locally\u001b[30G(\u001b[38;2;177;185;249m6df4647\u001b[39m,\u001b[40Gnot\u001b[44Gpushed).\u001b[53GWriting\u001b[61Gthe\u001b[65Gcross-review\u001b[78Gbrief\u001b[84Gover\u001b[89Gthe\u001b[93Gwhole\u001b[99Gextraction\u001b[110G(slices\u001b[118G1\r\u001b[2C\u001b[1Bto\u001b[6G8b) and\u001b[14Gstarting\u001b[23Gthe\u001b[27Greview.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(build/reviews/extraction-br\u001b[37Gef.md)\u001b[K\r\u001b[2C\u001b[1B⎿\u001b[5G Wrote \u001b[1m43\u001b[22m lines to \u001b[1mbuild/reviews/extraction-brief.md\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  1 \u001b[22m#\u001b[12GCros\u001b[17G-review:\u001b[26Gthe\u001b[30Gspace\u001b[36Gextraction,\u001b[48Gslices\u001b[55G1\u001b[57Gto\u001b[60G8\u001b[62G(Jettison)\r\u001b[5C\u001b[1B\u001b[2m  2 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  3 \u001b[22mBase: the commit before slice\u001b[40G1\u001b[42G(`b4bdb41^`).\u001b[56GHead:\u001b[62G`359ad42`.\u001b[73GPlan:\u001b[79Gdocs/space-extraction-plan.md;\r\u001b[1B     \u001b[2m  4 \u001b[22mroadmap row \"Space extraction\" (docs/roadmap.md, current priority).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m##\u001b[13GWhat\u001b[18Git\u001b[21Gis\u001b[24Gfor\r\u001b[1B \u001b[3G   \u001b[2m  7 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m  8 \u001b[22mThe engine keeps a concept only when it has a neutral name and serves more\u001b[85Gthan\u001b[90Gone\u001b[94Ggenre;\u001b[101Gthe\u001b[105Gspace\u001b[27;1H\u001b[24;3H\u001b[?25h"]
