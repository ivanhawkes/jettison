[0.149, "o", "\u001b[?25l\u001b[H\u001b[11Gsave game's version-1 s\u001b[35Ge\u001b[37G,\u001b[39Gwhich also settles the open\u001b[67G\"To revisit\" item;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe component chai\u001b[26Gs\u001b[28Gof \u001b[38;2;177;185;249mInFrame\u001b[39m, \u001b[38;2;177;185;249mDestination\u001b[39m and \u001b[38;2;177;185;249mBody\u001b[39m, plus\u001b[67Gthe\u001b[71Gdock's;\r\u001b[6C\u001b[1Bp\u001b[9Gysics'\u001b[16Greaders for layouts 3 and 4;\u001b[45G\u001b[K\r\u001b[10C\u001b[1Bd\u001b[13Gck d\u001b[18Gfinitio\u001b[27G' steps, and\u001b[40Gthe scene's\u001b[52Gversion-2\u001b[62Gstep.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept:\u001b[22m\u001b[K\r\u001b[10C\u001b[1Bmigration machinery in \u001b[38;2;177;185;249mserialise\u001b[39m, with its own test\u001b[63G on test\u001b[72Gformats,\u001b[81Gready\u001b[87Gfor\u001b[91Glater;\r\u001b[2C\u001b[1B \u001b[5G- the\u001b[11G\u001b[38;2;177;185;249mDock::*Migrations()\u001b[31G\u001b[39mfunctions,\u001b[42Gnow\u001b[46Gwith\u001b[51Gno\u001b[54Gsteps,\u001b[61Gbecause\u001b[69GManifest's\u001b[80G\u001b[38;2;177;185;249mcontent\u001b[88G\u001b[39mcalls\u001b[94Gthem;\r\u001b[6C\u001b[1Bloadin\u001b[14G \u001b[16G save writt\u001b[28Gn by another Jolt vers\u001b[51Gon\u001b[54Gby rebuildi\u001b[66Gg its\u001b[72Gb\u001b[74Gdies. That handles a dependency\u001b[106Gchange,\u001b[114Gnot\u001b[118Gour\r\u001b[4C\u001b[1B \u001b[7Gown\u001b[11Gformat, and costs nothing.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis also makes\u001b[19Greview findings F5\u001b[38Gand\u001b[42GF6\u001b[45Gmoot,\u001b[51Gand\u001b[55Gdeletes\u001b[63Gmost\u001b[68Gof\u001b[71Gthe\u001b[75Ground\u001b[81G1–2\u001b[85Gfixes.\r\u001b[2C\u001b[2B\u001b[1mThe documents\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mJettison:\u001b[22m a\u001b[17Gdated\u001b[23Gdecision\u001b[32Gin\u001b[35G\u001b[38;2;177;185;249mdecisions.md\u001b[39m,\u001b[49Grecording\u001b[59Gyour\u001b[64Gcall\u001b[69Gand\u001b[73Gits\u001b[77Gtrigger.\u001b[86GIt\u001b[89Greplaces\u001b[98G\"migrations\u001b[110Gare\u001b[114Ga\r\u001b[4C\u001b[1Bchain…,\u001b[13Gsaves\u001b[19Gnever\u001b[25Gregenerated\"\u001b[38Gand\u001b[42G\"definitions\u001b[55Gmigrate\".\u001b[65GThe\u001b[69Grule\u001b[74Galso\u001b[79Ggoes\u001b[84Ginto\u001b[89G\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[108G\u001b[39m(unit\u001b[114Gtests)\r\u001b[2C\u001b[1B \u001b[5Gand architectur\u001b[21G's per\u001b[29Gstence section.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m a decision-ledg\u001b[32G entry, plus the stage-2 pl\u001b[60Gn's section on versi\u001b[81Gn\u001b[84Ga\u001b[86Gd migration.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe trigger to turn migrations back on\u001b[22m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
