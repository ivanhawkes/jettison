[0.469, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m9\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\u001b[1m\u001b[3m\u001b[4mPlan: no migrations until player testing\r\u001b[1B\u001b[24m\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's safe.\u001b[18G\u001b[22mEvery\u001b[24Gfile\u001b[29Ganything\u001b[38Greads\u001b[44Gis\u001b[47Gin\u001b[50Gone\u001b[54Gof\u001b[57Gthe\u001b[61Gtwo\u001b[65Grepositories:\r\u001b[2C\u001b[1B- Jettison has\u001b[18Gfive binary save fixture\u001b[44Gand ab\u001b[51Gut\u001b[54G45\u001b[57Gversioned YAML fil\u001b[77G (test\u001b[84Gcontent,\u001b[93Gthe\u001b[97Gground\u001b[104Gsample,\u001b[112Gthe\u001b[116Gdock\r\u001b[2C\u001b[1B \u001b[5Gfix\u001b[9Gures).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has\u001b[18G18\u001b[21Gdefinition\u001b[32Gdirectories,\u001b[45Gall\u001b[49Gstill\u001b[55Gat\u001b[58Gversion\u001b[66G1\u001b[68Gwith\u001b[73Gno\u001b[76Gmigration\u001b[86Gsteps.\r\u001b[4C\u001b[1BNo third-p\u001b[16Grty mods or player saves \u001b[42Gxist. The only file outside \u001b[72Ge repos is your\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/.local/share/jettison/saves/quicksave.save\u001b[39m, which\u001b[57Gcan simply be d\u001b[73Gleted.\u001b[80G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule, until player testing\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in place.\u001b[51G\u001b[22mNo\u001b[54Gversion\u001b[62Gbump\u001b[67Gand\u001b[71Gno\u001b[74Gmigration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\r\u001b[2C\u001b[1B  \u001b[6Gthe format is rewritten in the same commit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mVersion numbers stay at their current values.\u001b[52G\u001b[22mPinned\u00