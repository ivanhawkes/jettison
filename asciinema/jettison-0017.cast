[0.066, "o", "\u001b[?25l\u001b[H\u001b[5G- The frame r\u001b[19Gason\u001b[24Gk\u001b[26Gy\u001b[28G are \u001b[38;2;177;185;249mother_frame\u001b[39m, \u001b[38;2;177;185;249mother_local_frame\u001b[39m,\u001b[65G\u001b[38;2;177;185;249mdestination_other_frame\u001b[89G\u001b[39mand\r\u001b[5C\u001b[1B \u001b[38;2;177;185;249mdestination_other_local_frame\u001b[39m.\r\u001b[4C\u001b[1B- The English and German string tables now speak \u001b[55Gf a \u001b[61Ghicle, a pla\u001b[74Gform \u001b[80Gnd a b\u001b[87Grth. The saves list shows\u001b[113Ga\u001b[115Gsave's\r\u001b[5C\u001b[1B \u001b[38;2;177;185;249mplace\u001b[39m,\u001b[14Gand\u001b[18Gthe test textures moved to \u001b[38;2;177;185;249mtextures/panels\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B- No pinned hash\u001b[22Gmov\u001b[26Gd\u001b[28Gand every ref\u001b[42Grence frame he\u001b[57Gd.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m8b, \u001b[38;2;177;185;249m359ad42\u001b[39m:\u001b[22m the\u001b[22Gdocuments\u001b[32Gdescribe\u001b[41Gthe\u001b[45Gboundary\u001b[54Gas\u001b[57Git\u001b[60Gnow\u001b[64Gis.\r\u001b[4C\u001b[1B-\u001b[7GArchitecture's\u001b[22GJumps,\u001b[29GGates\u001b[35Gand\u001b[39GCruising\u001b[48Gsections\u001b[57Gmoved\u001b[63Ginto\u001b[68Ga\u001b[70Gnew\u001b[74G\"Space\"\u001b[82Gsection\u001b[90Gof\u001b[93GManifest's\u001b[104Garchitecture.\r\u001b[2C\u001b[1B  - The rest of architecture.md, scope,\u001b[43Ggame\u001b[48Gintegration\u001b[60Gand\u001b[64Gthe\u001b[68Gsamples\u001b[76Gdoc\u001b[80Gno\u001b[83Glonger\u001b[90Gdescribe\u001b[99Gthe\u001b[103Gspace\u001b[109Gsample\u001b[116Gas\r\u001b[6C\u001b[1Bcurrent.\r\u001b[1B \u001b[3G- \u001b[1mManifest, \u001b[38;2;177;185;249m6df4647\u001b[39m:\u001b[22m that S\u001b[31Gace sect\u001b[40Gon, plus a status\u001b[58Gnote in the boundary assessment.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mConsumer matrix:\u001b[22G\u001b[22mall 54\u001b[30Gf Manifest's \u001b[44Gu\u001b[46Gtes pass\u001b[55Gon th\u001b[62Glocal \u001b[69Gngi