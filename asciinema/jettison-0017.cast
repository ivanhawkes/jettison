[0.658, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets deleted now\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBinary fixtures and their tests:\u001b[22m \u001b[38;2;177;185;249mworld-v1.save\u001b[39m, \u001b[38;2;177;185;249mworld-v2.save\u001b[39m, \u001b[38;2;177;185;249msave-v1.save\u001b[39m, \u001b[38;2;177;185;249mreplay-layout3.save\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mharbour-version-4.world\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMigration steps, leaving each chain reading only the current version:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe\u001b[11Gw\u001b[14Gld's\u001b[19Gsteps 1–4: the type\u001b[39Grenames,\u001b[48Grenaming\u001b[57Gfields\u001b[64Gof\u001b[67Gqueued\u001b[74Gcommands\u001b[83G(the\u001b[88Gnested\u001b[95Gdestination\u001b[107Gand\u001b[111Gthe\u001b[115Gpick's\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249msystem\u001b[14G\u001b[39mincluded)\u001b[24Gand\u001b[28Gskipping\u001b[37Gthe\u001b[41Gretired\u001b[49Gdock\u001b[54Gcomponents;\r\u001b[2C\u001b[1B  - the save game's vers\u001b[28Gon-1 \u001b[34Gtep, which\u001b[45Galso settles th\u001b[61G open \"To\u001b[71Grevisit\" item;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe\u001b[11Gcomponent\u001b[21Gchains\u001b[28Gof\u001b[31G\u001b[38;2;177;185;249mInFrame\u001b[39m,\u001b[40G\u001b[38;2;177;185;249mDestination\u001b[52G\u001b[39mand\u001b[56G\u001b[38;2;177;185;249mBody\u001b[39m,\u001b[62Gplus\u001b[67Gthe\u001b[71Gdock's;\r\u001b[2C\u001b[1B  - physics' readers\u001b[24Gfor\u001b[28Glayouts\u001b[36G3\u001b[38Gand\u001b[42G4;\r\u001b[4C\u001b[1B-\u001b[7Gthe\u001b[11Gdock\u001b[16Gdefinitions'\u001b[29Gsteps,\u001b[36Gand\u001b[40Gthe\u001b[44Gscene's\u001b[52Gversion-2\u001b[62Gstep.\r\u001b[4C\u001b[1B\u001b[1mK\u001b[7Gp\u001b[9G:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- the migratio\u001b[20G machinery in \u001b[38;2;177;185;249mserialise\u001b[39m, w\u001b[47Gth \u001b[51Gts own tests on test formats, ready for later;\u001b[K\r\u001b[4C\u001b[1B- the \u001b[38;2;177;185;249mDock::*Migrations()\u001b[39m functions, \u001b[43Gow\u001b[46Gwith\u001b[51Gno\u001b[54Gsteps,\u001b[61Gbecause\u001b[69GManifest's\u001b[80G\u001b[38;2;177;185;249mcontent\u001b[88G\u001b[39mcalls\u001b[94Gthem;\r\u001b[2C\u001b[1B \u001b[5G- loading\u001b[17Gsave writt\u001b[28Gn by\u001b[33Ga\u001b[35Gother Jolt v\u001b[48Gr\u001b[50Gion by\u001b[57Grebuilding \u001b[69Gts\u001b[72Gbodi\u001b[77Gs. That handles a dependency\u001b[106Gchange,\u001b[114Gnot\u001b[118Gour\r\u001b[6C\u001b[1Bown\u001b[11Gformat,\u001b[19Gand\u001b[23Gcosts\u001b[29Gnothing.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis\u001b[8Galso\u001b[13Gmakes\u001b[19Greview\u001b[26Gfindings\u001b[35GF5\u001b[38Gand\u001b[42GF6\u001b[45Gmoot,\u001b[51Gand\u001b[55Gdeletes\u001b[63Gmost\u001b[68Gof\u001b[71Gthe\u001b[75Ground\u001b[81G1–2\u001b[85Gfixes.\r\u001b[2C\u001b[1B   \u001b[7G     \u001b[13G     \u001b[19G     \u001b[25G  \u001b[28G      \u001b[35G       \u001b[43G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.351, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1Bthe\u001b[10Gformat\u001b[17Gis\u001b[20Grewritten\u001b[30Gin\u001b[33Gthe\u001b[37Gsame\u001b[42Gcommit.\r\u001b[2C\u001b[1B2. \u001b[1mVersion numb\u001b[19Grs stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[5C\u001b[1Bmoves\u001b[12Gfrom\u001b[17Gversioning.\u001b[29GA\u001b[31Gpin\u001b[35Gmoves\u001b[41Gonly\u001b[46Gwhen\u001b[51Gthe\u001b[55Gbytes\u001b[61Greally\u001b[68Gchange,\u001b[76Gand\u001b[80Gis\u001b[83Gre-pinned\u001b[93Gwith\u001b[98Gthe\u001b[102Gusual\u001b[108Gproof\u001b[114Gthat\r\u001b[2C\u001b[1B \u001b[5G only bytes changed, not state.\u001b[K\r\u001b[2C\u001b[1B3. \u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[2C\u001b[1B \u001b[5G a foreign version by name. One new rule closes the remaining gap: if\u001b[75Ga\u001b[77Gfield's\u001b[85Gmeaning\u001b[93Gor\u001b[96Gtype\u001b[101Gchanges,\u001b[110Git\u001b[113Ggets\u001b[118Ga\r\u001b[4C\u001b[1B new name, so\u001b[19Gan old file is\u001b[34Grefused rather th\u001b[52Gn read wrongly. An a\u001b[73Gded field\u001b[83Gkeeps its \u001b[94Gefault, which is\u001b[111Gharmless.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's co\u001b[63Gent\u001b[67Gvalidation\u001b[78Galready\u001b[86Greads\u001b[92Gall\u001b[96Gof\u001b[99Gits\u001b[103Gdata.\u001b[109GOn\r\u001b[4C\u001b[1B Jetti\u001b[12Gon's side I'd check that the test conten\u001b[53G, the sampl\u001b[65G's assets and the dock\u001b[88Gfixtures\u001b[97Gare\u001b[101Gall\u001b[105Gloaded\u001b[112Gby\u001b[115Ga\r\u001b[4C\u001b[1B suite, and add\u001b[21Gone \"every file loads\" case per format if any\u001b[67Gfile isn\u001b[76Gt.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets deleted now\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBinary fixtures and their tests:\u001b[22m \u001b[38;2;177;185;249mworld-v1.save\u001b[39m, \u001b[38;2;177;185;249mworld-v2.save\u001b[39m, \u001b[38;2;177;185;249msave-v1.save\u001b[39m, \u001b[38;2;177;185;249mreplay-layout3.save\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mharbour-version-4.world\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMigration steps, leaving each chain reading only the current version:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe\u001b[11Gw\u001b[14Gld's\u001b[19Gsteps 1–4: the type\u001b[39Grenames,\u001b[48Grenaming\u001b[57Gfields\u001b[64Gof\u001b[67Gqueued\u001b[74Gcommands\u001b[83G(the\u001b[88Gnested\u001b[95Gdestination\u001b[107Gand\u001b[111Gthe\u001b[115Gpick's\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249msystem\u001b[14G\u001b[39mincluded)\u001b[24Gand\u001b[28Gskipping\u001b[37Gthe\u001b[41Gretired\u001b[49Gdock\u001b[54Gcomponents;\r\u001b[2C\u001b[1B  - the save game's vers\u001b[28Gon-1 \u001b[34Gtep, which\u001b[45Galso settles th\u001b[61G open \"To\u001b[71Grevisit\" item;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe\u001b[11Gcomponent\u001b[21Gchains\u001b[28Gof\u001b[31G\u001b[38;2;177;185;249mInFrame\u001b[39m,\u001b[40G\u001b[38;2;177;185;249mDestina\u001b[76G\u001b[39ms;\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.134, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhy it's safe.\u001b[22m Every fil\u001b[28G anything reads is in\u001b[50Gone\u001b[54Gof\u001b[57Gthe\u001b[61Gtwo\u001b[65Grepositories:\r\u001b[2C\u001b[1B- Jettison has five binary save fixtures and about 45 versioned YAML files\u001b[78G(te\u001b[82Gt content\u001b[93Gthe ground sampl\u001b[110G, the dock\r\u001b[4C\u001b[1Bfixtures).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMa\u001b[8Gifest has 18 d\u001b[23Gfinition directories,\u001b[45Gall\u001b[49Gstill\u001b[55Gat\u001b[58Gversion\u001b[66G1\u001b[68Gwith\u001b[73Gno\u001b[76Gmigration\u001b[86Gsteps.\r\u001b[2C\u001b[1B- No third-party mods or player saves exist. The only file outside the repos is\u001b[83Gyour\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m~/.local/share/jettison/saves/quicksave.save\u001b[39m, which\u001b[57Gcan simply be deleted.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule, until player testing\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in place.\u001b[22m No version bump\u001b[67Gand no migration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\r\u001b[5C\u001b[1Bthe\u001b[10Gformat\u001b[17Gis\u001b[20Grewritten\u001b[30Gin\u001b[33Gthe\u001b[37Gsame\u001b[42Gcommit.\r\u001b[2C\u001b[1B2. \u001b[1mVersion numb\u001b[19Grs stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[5C\u001b[1Bmoves\u001b[12Gfrom\u001b[17Gversioning.\u001b[29GA\u001b[31Gpin\u001b[35Gmoves\u001b[41Gonly\u001b[46Gwhen\u001b[51Gthe\u001b[55Gbytes\u001b[61Greally\u001b[68Gchange,\u001b[76Gand\u001b[80Gis\u001b[83Gre-pinned\u001b[93Gwith\u001b[98Gthe\u001b[102Gusual\u001b[108Gproof\u001b[114Gthat\r\u001b[2C\u001b[1B \u001b[5G only bytes changed, not state.\u001b[K\r\u001b[2C\u001b[1B3. \u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[2C\u001b[1B \u001b[5G a foreign version by name. One new rule closes the remaining gap: if\u001b[75Ga\u001b[77Gfield's\u001b[85Gmeaning\u001b[93Gor\u001b[96Gtype\u001b[101Gchanges,\u001b[110Git\u001b[113Ggets\u001b[118Ga\r\u001b[4C\u001b[1B new name, so\u001b[19Gan old file is\u001b[34Grefused rather th\u001b[52Gn read wrongly. An a\u001b[73Gded field\u001b[83Gkeeps its \u001b[94Gefault, which is\u001b[111Gharmless.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's co\u001b[63Gent\u001b[67Gvalidation\u001b[78Galready\u001b[86Greads\u001b[92Gall\u001b[96Gof\u001b[99Gits\u001b[103Gdata.\u001b[109GOn\r\u001b[4C\u001b[1B Jetti\u001b[12Gon's side I'd check that the test conten\u001b[53G, the sampl\u001b[65G's assets and the dock\u001b[88Gfixtures\u001b[97Gare\u001b[101Gall\u001b[105Gloaded\u001b[112Gby\u001b[115Ga\r\u001b[4C\u001b[1B suite, and add\u001b[21Gone \"every file loads\" cas\u001b[76Gt.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.219, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mBefore we do any of the fixes that the review surfaced I want to drop some restrictions from the migration policy. \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mAll the save games are in manifest and jettison and under our control. We can simply rewrite those files for each \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mmigration and save the effort of writing a new migration set for every file change. I want you to offer a plan for a \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255msafe way to move forward without adding migrations with every change. We will rewrite those save files each time \u001b[39m     \r\u001b[1B  \u001b[38;2;255;255;255muntil we start player testing, at which point it becomes worth migration costs.\u001b[39m                                       \r\u001b[4C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m9\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\u001b[1m\u001b[3m\u001b[4mPlan: no migrations until player testing\r\u001b[2C\u001b[1B\u001b[24m\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's safe.\u001b[22m Every fil\u001b[28G anything reads is in\u001b[50Gone\u001b[54Gof\u001b[57Gthe\u001b[61Gtwo\u001b[65Grepositories:\r\u001b[2C\u001b[1B- Jettison has five binary save fixtures and about 45 versioned YAML files\u001b[78G(te\u001b[82Gt content\u001b[93Gthe ground sampl\u001b[110G, the dock\r\u001b[4C\u001b[1Bfixtures).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMa\u001b[8Gifest has 18 d\u001b[23Gfinition directories,\u001b[45Gall\u001b[49Gstill\u001b[55Gat\u001b[58Gversion\u001b[66G1\u001b[68Gwith\u001b[73Gno\u001b[76Gmigration\u001b[86Gsteps.\r\u001b[2C\u001b[1B- No third-party mods or player saves exist. The only file outside the repos is\u001b[83Gyour\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m~/.local/share/jettison/saves/quicksave.save\u001b[39m, which\u001b[57Gcan simply be deleted.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule, until player testing\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in pla\u001b[76G\u001b[22mgration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\u001b[27;1H\u001b[24;3H\u001b[?25h"]
