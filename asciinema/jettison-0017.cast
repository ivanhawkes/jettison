[0.064, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in place.\u001b[51G\u001b[22mNo\u001b[54Gversion\u001b[62Gbump\u001b[67Gand\u001b[71Gno\u001b[74Gmigration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\r\u001b[2C\u001b[1B  \u001b[6Gt\u001b[8Ge format is rewritten in the\u001b[37Gsame commit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mVersion numbers stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[2C\u001b[1B   moves from versi\u001b[23Gning. A pin moves only\u001b[46Gwhen the bytes\u001b[61Greally\u001b[68Gchange,\u001b[76Gand\u001b[80Gis\u001b[83Gre-pinned\u001b[93Gwith\u001b[98Gthe\u001b[102Gusual\u001b[108Gproof\u001b[114Gthat\r\u001b[5C\u001b[1Bonly\u001b[11Gbytes\u001b[17Gchanged,\u001b[26Gnot\u001b[30Gstate.\r\u001b[1B \u001b[3G3. \u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[5C\u001b[1Ba\u001b[8Gforeign\u001b[16Gversion\u001b[24Gby\u001b[27Gname.\u001b[33GOne\u001b[37Gnew\u001b[41Grule\u001b[46Gcloses\u001b[53Gthe\u001b[57Gremaining\u001b[67Ggap:\u001b[72Gif\u001b[75Ga\u001b[77Gfield's\u001b[85Gmeaning\u001b[93Gor\u001b[96Gtype\u001b[101Gchanges,\u001b[110Git\u001b[113Ggets\u001b[118Ga\r\u001b[1B     new name, so an old file is refused rather than read wrongly. An added field keeps its default, which is harmless.\u001b[K\r\u001b[1B  4. \u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's content validation already reads all of its data. On\u001b[K\r\u001b[1B     Jettison's side I'd check that the test content, the sample's assets and the dock fixtures are all loaded by a\u001b[K\r\u001b[1B     suite, and add one \"every file loads\" case per format if any file isn't.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets deleted now\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  - \u001b[1mBinary fixtures and their tests:\u001b[22m \u001b[38;2;177;185;249mworld-v1.save\u001b[39m,\u001b[53G\u001b[38;2;177;185;249mworld-v2.save\u001b[39m,\u001b[68G\u001b[38;2;177;185;249msave-v1.save\u001b[39m,\u001b[82G\u001b[38;2;177;185;249mreplay-layout3.save\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mharbour-version-4.world\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMigration steps, leaving each chain reading only the current version:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- the world's steps 1–4: the type renames,\u001b[48Grenaming\u001b[57Gfields\u001b[64Gof\u001b[67Gqueued\u001b[74Gcommands\u001b[83G(the\u001b[88Gnested\u001b[95Gdestination\u001b[107Gand\u001b[111Gthe\u001b[115Gpick's\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249msystem\u001b[14G\u001b[39mincluded)\u001b[24Gand\u001b[28Gskipping\u001b[37Gthe\u001b[41Gretired\u001b[49Gdock\u001b[54Gcomponents;\r\u001b[1B \u001b[3G  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
