[0.079, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  \u001b[6Gthe format is rewritten in the same commit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mVersion numbers stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[2C\u001b[1B  \u001b[6Gmoves from versioning. A pin moves only when the bytes really \u001b[69Ghange, and i\u001b[82G re-pinned\u001b[93Gwith \u001b[99Ghe usual\u001b[108Gproof\u001b[114Gthat\u001b[K\r\u001b[5C\u001b[1Bonly bytes\u001b[17Gchanged, not state.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[2C\u001b[1B  \u001b[6Ga foreign version by name. One new rule closes the r\u001b[59Gmaining g\u001b[69Gp: if a field's meaning or type chang\u001b[107Gs, it gets\u001b[119G\u001b[K\r\u001b[5C\u001b[1Bnew name,\u001b[16Gso an old file is r\u001b[36Gfused rather than r\u001b[56Gad wro\u001b[63Ggly. An added\u001b[82G keeps \u001b[90Gts\u001b[93Gdefault, which is harmless.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's\u001b[59Gcontent validation already reads all of its data. On\u001b[K\r\u001b[2C\u001b[1B  \u001b[6GJettison's side I'd check that the test content, \u001b[56Ghe\u001b[59Gsample's \u001b[69Gssets a\u001b[77Gd th\u001b[82G \u001b[84Gock fixtures are all loaded\u001b[112Gby\u001b[115Ga\r\u001b[5C\u001b[1Bsui\u001b[10Ge, and\u001b[17Gad\u001b[20G one \"ev\u001b[29Gry\u001b[32Gfile\u001b[37Gloads\" case p\u001b[51Gr format if any file i\u001b[74Gn't.\u001b[79G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets deleted now\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBinary fixtures and their tests:\u001b[38G\u001b[22m\u001b[38;2;177;185;249mworld-v1.save\u001b[39m,\u001b[53G\u001b[38;2;177;185;249mworld-v2.save\u001b[39m,\u001b[68G\u001b[38;2;177;185;249msave-v1.save\u001b[39m,\u001b[82G\u001b[38;2;177;185;249mreplay-layout3.save\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mharbour-version-4.world\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMigration steps, leaving each chain reading only the current version:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- the world's steps 1–4: the type renames, renaming fields of queued commands\u001b[83G(the\u001b[88Gnested\u001b[95Gdestination\u001b[107Gand\u001b[111Gthe\u001b[115Gpick's\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249msystem\u001b[39m included) and skipping the retired dock components;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe save game's version-1 step, which also settles th\u001b[61G open\u001b[67G\"To\u001b[71Grevisit\"\u001b[80Gitem;\r\u001b[10C\u001b[1Bcomponent chain\u001b[27G \u001b[29Gf \u001b[38;2;177;185;249mInFrame\u001b[39m, \u001b[38;2;177;185;249mDestina\u001b[76G\u001b[39ms;\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.061, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mVersion numbers stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[2C\u001b[1B  \u001b[6Gmoves from versioning. A pin moves only when the bytes really \u001b[69Ghange, and i\u001b[82G re-pinned\u001b[93Gwith \u001b[99Ghe usual\u001b[108Gproof\u001b[114Gthat\u001b[K\r\u001b[5C\u001b[1Bonly bytes\u001b[17Gchanged, not state.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[2C\u001b[1B  \u001b[6Ga foreign version by name. One new rule closes the r\u001b[59Gmaining g\u001b[69Gp: if a field's meaning or type chang\u001b[107Gs, it gets\u001b[119G\u001b[K\r\u001b[5C\u001b[1Bnew name,\u001b[16Gso an old file is r\u001b[36Gfused rather than r\u001b[56Gad wro\u001b[63Ggly. An added\u001b[82G keeps \u001b[90Gts\u001b[93Gdefault, which is harmless.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's\u001b[59Gcontent validation already reads all of its data. On\u001b[K\r\u001b[2C\u001b[1B  \u001b[6GJettison's side I'd check that the test content, \u001b[56Ghe\u001b[59Gsample's \u001b[69Gssets a\u001b[77Gd th\u001b[82G \u001b[84Gock fixtures are all loaded\u001b[112Gby\u001b[115Ga\r\u001b[5C\u001b[1Bsui\u001b[10Ge, and\u001b[17Gad\u001b[20G one \"ev\u001b[29Gry\u001b[32Gfile\u001b[37Gloads\" case p\u001b[51Gr format if any file i\u001b[74Gn't.\u001b[79G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat gets deleted now\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBinary fixtures and their tests: