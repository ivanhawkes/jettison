[0.252, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison:\u001b[15G\u001b[22ma\u001b[17Gdated\u001b[23Gdecision\u001b[32Gin\u001b[35G\u001b[38;2;177;185;249mdecisions.md\u001b[39m,\u001b[49Grecording\u001b[59Gyour\u001b[64Gcall\u001b[69Gand\u001b[73Gits\u001b[77Gtrigger.\u001b[86GIt\u001b[89Greplaces\u001b[98G\"migrations\u001b[110Gare\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gchain…, saves n\u001b[21Gver regenerated\" and \"definitions mi\u001b[58Grate\". The\u001b[69Grule also goes into\u001b[89G\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[39m (unit\u001b[114Gtests)\r\u001b[4C\u001b[1Band architectur\u001b[21G's persistenc\u001b[35G section.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m a decision-ledger entry, plus\u001b[45Gthe\u001b[49Gstage-2\u001b[57Gplan's\u001b[64Gsection\u001b[72Gon\u001b[75Gversions\u001b[84Gand\u001b[88Gmigration.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe trigger to turn migrations back on\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfirst\u001b[13Gbuild\u001b[19Ggiven\u001b[25Gto\u001b[28Ganyone\u001b[35Goutside\u001b[43Gthe\u001b[47Gtwo\u001b[51Grepositories:\u001b[65Ga\u001b[67Gplayer\u001b[74Gtest,\u001b[80Gor\u001b[83Ga\u001b[85Gmod\u001b[89Gauthor.\u001b[97GAt\u001b[100Gthat\u001b[105Gpoint:\r\u001b[2C\u001b[1B- the then-current versions become the bas\u001b[46Gline;\u001b[K\r\u001b[4C\u001b[1Bfixtur\u001b[12Gs are writt\u001b[24Gn by that build and n\u001b[46Gver regenerated\u001b[62Gagain;\r\u001b[4C\u001b[1Bevery format\u001b[18Gchang\u001b[24G carries a m\u001b[37Ggration st\u001b[48Gp\u001b[50Gfrom then on.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOrder of work\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6GThe\u001b[10Gdecision\u001b[19Gand\u001b[23Gdocuments,\u001b[34Gin\u001b[37Gboth\u001b[42Grepositories.\r\u001b[2C\u001b[1B2\u001b[12Glet\u001b[18Gs, as \u001b[25Gne Je\u001b[31Gtiso\u001b[37Gc\u001b[39Gmmit with its \u001b[54Guites.\r\u001b[2C\u001b[1B3\u001b[6GVerifica\u001b[18G: no pi\u001b[26Gned hash should move, s\u001b[50Gnce no version\u001b[65Gnumbers\u001b[73Gor\u001b[76Gcurrent-format\u001b[91Gbytes\u001b[97Gchange.\u001b[105GThen\u001b[110GManifest's\r\u001b[2C\u001b[1B  \u001b[6G54 su\u001b[12Gtes \u001b[18G the\u001b[23Glocal engine, the gate, and Manifest re-pi\u001b[66Gned.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GThe cov\u001b[14Grage\u001b[19Gc\u001b[22Gck from rule 4, if\u001b[41Git finds files no test loads\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.151, "o", "\u001b[?25l\u001b[H\u001b[5Gand\u001b[9Garchitecture's\u001b[24Gpersistence\u001b[36Gsection.\r\u001b[4C\u001b[1B\u001b[1mManifest\u001b[18G\u001b[22mecision-ledger entry, plus the\u001b[49Gstage-2 plan's\u001b[64Gsectio\u001b[71G on vers\u001b[80Gons and migration.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe trigger to turn migrations back on\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfirst\u001b[13Gbuild\u001b[19Ggiven\u001b[25Gto\u001b[28Ganyone\u001b[35Goutside\u001b[43Gthe\u001b[47Gtwo\u001b[51Grepositories:\u001b[65Ga\u001b[67Gplayer\u001b[74Gtest,\u001b[80Gor\u001b[83Ga\u001b[85Gmod\u001b[89Gauthor.\u001b[97GAt\u001b[100Gthat\u001b[105Gpoint:\r\u001b[2C\u001b[1B- the then-current versions become the\u001b[42Gbaseline;\r\u001b[2C\u001b[1B-\u001b[5Gfixtures\u001b[14Gare\u001b[18Gwritten\u001b[26Gby\u001b[29Gthat\u001b[34Gbuild\u001b[40Gand\u001b[44Gnever\u001b[50Gregenerated\u001b[62Gagain;\r\u001b[2C\u001b[1B- \u001b[6Gvery format change\u001b[25Gcarries a\u001b[35Gmigration step f\u001b[52Gom then on.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOrder of work\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6GThe\u001b[10Gdecision\u001b[19Gand\u001b[23Gdocuments,\u001b[34Gin\u001b[37Gboth\u001b[42Grepositories.\r\u001b[2C\u001b[1B2. The deletions,\u001b[21Gas\u001b[24Gone\u001b[28GJettison\u001b[37Gcommit\u001b[44Gwith\u001b[49Gits\u001b[53Gsuites.\r\u001b[2C\u001b[1B3.\u001b[6GVerification:\u001b[20Gno\u001b[23Gpinned\u001b[30Ghash\u001b[35Gshould\u001b[42Gmove,\u001b[48Gsince\u001b[54Gno\u001b[57Gversion\u001b[65Gnumbers\u001b[73Gor\u001b[76Gcurrent-format\u001b[91Gbytes\u001b[97Gchange.\u001b[105GThen\u001b[110GManifest's\r\u001b[2C\u001b[1B  \u001b[6G54 suite\u001b[15G \u001b[19Gthe\u001b[23Gl\u001b[26Gal engine,\u001b[37Gthe gate, and Manifest\u001b[60Gre-pinned.\r\u001b[2C\u001b[1B4\u001b[10Gcov\u001b[14Grage check from rule 4, if \u001b[4