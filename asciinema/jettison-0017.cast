[0.078, "o", "\u001b[?25l\u001b[H\u001b[5Gcomponents),\u001b[18Gthe\u001b[22Gsave\u001b[27Ggame's\u001b[34Gversion-1\u001b[44Gstep,\u001b[50Gthe\u001b[54Gcomponent\u001b[64Gchains\u001b[71Gof\u001b[74G\u001b[38;2;177;185;249mInFrame\u001b[39m,\u001b[83G\u001b[38;2;177;185;249mDestination\u001b[39m,\u001b[96G\u001b[38;2;177;185;249mBody\u001b[101G\u001b[39mand\u001b[105Gthe\u001b[109Gdocks,\u001b[116Gthe\r\u001b[1B \u001b[3G  dock de\u001b[14Gnitions', the scene's, and physics' readers\u001b[58Gfor layouts 3 and 4. Each ch\u001b[87Gin\u001b[90Gnow r\u001b[96Gads only its current\r\u001b[2C\u001b[1B  version,\u001b[14Gwhich\u001b[20Gis\u001b[23Gstill\u001b[29Gchecked,\u001b[38Gso\u001b[41Ga\u001b[43Gforeign\u001b[51Gfile\u001b[56Gis\u001b[59Grefused\u001b[67Gby\u001b[70Gname.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFixtures deleted:\u001b[23G\u001b[22mthe\u001b[27Gfive\u001b[32Gsaves\u001b[38Gwritten\u001b[46Gby\u001b[49Gearlier\u001b[57Gbuilds,\u001b[65Gand\u001b[69Gthe\u001b[73Gcases\u001b[79Gthat\u001b[84Gread\u001b[89Gthem\u001b[94Gor\u001b[97Gbuilt\u001b[103Gold\u001b[107Gdata\u001b[112Ginline.\r\u001b[2C\u001b[1B- \u001b[1mKept:\u001b[22m the migration\u001b[25Gmachinery\u001b[35Gand\u001b[39Gits\u001b[43Gown\u001b[47Gsuites,\u001b[55Gready\u001b[61Gfor\u001b[65Gplayer\u001b[72Gtesting.\u001b[81GAlso\u001b[86Gkept:\u001b[92Gloading\u001b[100Ga\u001b[102Gsave\u001b[107Gwritten\u001b[115Gby\r\u001b[4C\u001b[1Banother\u001b[13GJolt\u001b[18Gversion.\r\u001b[1B \u001b[3G- \u001b[1mDocuments:\u001b[22m \u001b[17G n\u001b[20Gw\u001b[23Ge\u001b[25Gisi\u001b[29Gn in \u001b[38;2;177;185;249mdecisions.md\u001b[39m (\"Fo\u001b[52Gma\u001b[55Gs\u001b[57Gc\u001b[59Gange in place until play\u001b[84Gr testing\"). The two older migration\r\u001b[2C\u001b[1B  decisions\u001b[15Gare\u001b[19Gmarked\u001b[26Gsuspended.\u001b[37GArchitecture's\u001b[52Gpersistence\u001b[64Gsection\u001b[72Gand\u001b[76Gthe\u001b[80Gunit-tests\u001b[91Gparagraph\u001b[101Gin\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[24G\u001b[39mnow\u001b[28Gstate\u001b[34Gthe\u001b[38Grule.\u001b[44GThe\u001b[48Gplan's\u001b[55G\"To\u001b[59Grevisit\"\u001b[68Gitem\u001b[73Gis\u001b[76Gclosed,\u001b[84Gsince\u001b[90Gthe\u001b[94Gversion-1\u001b[104Gstep\u001b[109Git\u001b[112Gwas\u001b[116Gabout\r\u001b[2C\u001b[1B  is deleted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCoverage check:\u001b[21G\u001b[22mevery\u001b[27Gversioned\u001b[37Gfile\u001b[42GJettison\u001b[51Gholds\u001b[57Gis\u001b[60Gread\u001b[65Gby\u001b[68Gthe\u001b[72Ggate,\u001b[78Gthrough\u001b[86Ga\u001b[88Gsuite,\u001b[95Gthe\u001b[99Gsmoke\u001b[105Grun\u001b[109Gor\u001b[112Ga\r\u001b[1B \u001b[3G  reference frame. Some scenes a\u001b[36Ge\u001b[38Gread only\u001b[48Gby the reference frames\u001b[73Gso the\u001b[80Gwritten rule\u001b[93Gsays \"th\u001b[102G gate loads\u001b[114Geach\"\r\u001b[4C\u001b[1Brather\u001b[12Gthan\u001b[17G\"a\u001b[20Gsuite\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest \u001b[38;2;177;185;249m46fbf12\r\u001b[1B\u001b[22m\u001b[39m \u001b[3G- The content suite's inl\u001b[29Gne dock definitions are\u001b[53Grewritten to the current\u001b[78Gversions; they\u001b[93Gwere\u001b[98Gthe\u001b[102Gonly\u001b[107GManifest\r\u001b[4C\u001b[1Binputs\u001b[12Gthat\u001b[17Gneeded\u001b[24Gthe\u001b[28Gdeleted\u001b[36Gsteps.\r\u001b[1B \u001b[3G- Decision-ledger entry D-109\u001b[34Gand a line\u001b[45Gin the stage-2 plan po\u001b[69Gting to it.\u001b[81G\u001b[K\r\u001b[1B  - Manifest's tracked dock sources (\u001b[38;2;177;185;249mdata/docks/\u001b[39m) were already\u001b[64Gcurrent.\u001b[73GThe\u001b[77Gold-version\u001b[89Gfiles\u001b[95GI\u001b[97Gfound\u001b[103Gwere\u001b[108Gstale\u001b[114Gbuild\r\u001b[4C\u001b[1Boutput\u001b[12Gin\u001b[15Gthe\u001b[19Ggitignored\u001b[30G\u001b[38;2;177;185;249mdata/definitions/\u001b[39m,\u001b[49Gwhich\u001b[55GI\u001b[57Grewrote\u001b[65Gtoo,\u001b[70Gharmlessly.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.138, "o", "\u001b[?25l\u001b[H\u001b[5Gversion, which is still checked, s\u001b[40G a for\u001b[47Gign file is r\u001b[61Gfused by name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFixtures deleted:\u001b[22m the fiv\u001b[31G saves written by earli\u001b[56G builds, and the cases\u001b[79Gthat\u001b[84Gre\u001b[87Gd them\u001b[94Gor built old data inline.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept:\u001b[22m the m\u001b[17Ggration machin\u001b[32Gry and its\u001b[43Gown suites, ready \u001b[62Gor pla\u001b[69Ger t\u001b[74Gsting.\u001b[81GAlso\u001b[86Gkept:\u001b[92Gloading\u001b[100Ga\u001b[102Gsave\u001b[107Gwritten\u001b[115Gby\r\u001b[2C\u001b[1B \u001b[5Ganother Jolt version.\u001b[27G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mDocuments:\u001b[22m a new decision in \u001b[38;2;177;185;249mdecisions.md\u001b[47G\u001b[39m(\"Formats change in place un\u001b[77Gl player\u001b[86Gt\u001b[88Gs\u001b[90Ging\"). The two older migration\r\u001b[4C\u001b[1Bdecisions are marked suspended.\u001b[37GArchitecture's\u001b[52Gpersistence\u001b[64Gsection\u001b[72Gand\u001b[76Gthe\u001b[80Gunit-tests\u001b[91Gparagraph\u001b[101Gin\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[39m now state\u001b[34Gthe rule. The plan's \"To revis\u001b[65Gt\" item\u001b[73Gis c\u001b[78Gosed, since the version-1 step it was ab\u001b[119Gut\r\u001b[4C\u001b[1Bis deleted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCoverage check:\u001b[22m every versioned file Jettison holds is read by\u001b[68Gth\u001b[71G gate, through a suit\u001b[93G, the smoke run\u001b[109Gor\u001b[112Ga\u001b[K\r\u001b[4C\u001b[1Breferenc\u001b[14G frame.\u001b[22GSome\u001b[27Gscenes\u001b[34Gare\u001b[38Gread\u001b[43Gonly\u001b[48Gby\u001b[51Gthe\u001b[55Greference\u001b[65Gframes,\u001b[73Gso\u001b[76Gthe\u001b[80Gwritten\u001b[88Grule\u001b[93Gsays\u001b[98G\"the\u001b[103Ggate\u001b[108Gloads\u001b[114Geach\"\r\u001b[2C\u001b[1B \u001b[5Grather than \"a suite\".\u001b[K\r\u001b[4