[0.301, "o", "\u001b[H\r\u001b[4C\u001b[12Band a\u001b[11Gfew th\u001b[18Gngs c\u001b[24Gme with it.    \u001b[40G    \u001b[45G    \u001b[50G    \u001b[55G   \u001b[59G   \u001b[63G        \u001b[72G   \u001b[76G  \u001b[79G  \u001b[82G \u001b[84G      \u001b[91G  \u001b[94G       \u001b[102G   \u001b[106G \u001b[108G        \r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWhat it would mean\r\u001b[4C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249mdocs/architecture.md\u001b[28G\u001b[39m(\"Persistence\")\u001b[44Gsays\u001b[49Gthat\u001b[54Gwhat\u001b[59Ga\u001b[61Gbuild\u001b[67Gwrote,\u001b[74Gevery\u001b[80Glater\u001b[86Gbuild\u001b[92Gloads.\u001b[99GIt\u001b[102Galso\u001b[107Gsays\u001b[112Gthe\r\u001b[4C\u001b[1B \u001b[7Gfixtures (\u001b[38;2;177;185;249mworld-v1.save\u001b[39m, \u001b[38;2;177;185;249mworld-v2.save\u001b[39m, \u001b[38;2;177;185;249msave-v1.save\u001b[39m,\u001b[61G\u001b[38;2;177;185;249mreplay-layout3.save\u001b[39m, and\u001b[86Gthe \u001b[91Gock's\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mharbour-version\u001b[23G4.world\u001b[39m from slice 7) are \"never regenerated\". That rule woul\u001b[86Gc\u001b[88Gange to something\u001b[106Glike\u001b[111G\"until\r\u001b[6C\u001b[1Bplayers keep saves, a format\u001b[36Gchange rew\u001b[47Gites the\u001b[56Gfixtures instead of migrating\". It needs wri\u001b[101Ging down in the\u001b[K\r\u001b[6C\u001b[1Bdocs and in \u001b[38;2;177;185;249mdecisions.md\u001b[39m, or\u001b[36Ga lat\u001b[42Gr rev\u001b[48Gew will\u001b[57Glag the\u001b[65Gmi\u001b[68Gsing\u001b[73Gmigrations again.\u001b[91G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GY\u001b[9Gur\u001b[12Gearl\u001b[17Ger instruction f\u001b[36Gslice 7\u001b[44Gwas \"a\u001b[51Gsave\u001b[56Gwritten before loads\". Dropping migrations\u001b[99Greverses\u001b[108Gthat,\u001b[114Gso\u001b[117Git\r\u001b[4C\u001b[1B \u001b[7Gshould be recorded as your decision with\u001b[48Ga date.\u001b[56G\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[4C\