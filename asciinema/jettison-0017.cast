[0.037, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mits th\u001b[20Gpa\u001b[24Ged tree,\u001b[33Gkeeping\u001b[41Gthe li\u001b[48Ges\u001b[51Ga mis\u001b[57Gake is\u001b[64G   \u001b[68G         \u001b[78G    \u001b[83G           \u001b[95G      \u001b[102G  \u001b[105G        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 646 \u001b[22m reported at. Definitions migrate the same way ([\u001b[38;2;230;219;116mdecided\u001b[39m](decisions.md)). A version newer than\u001b[K\r\u001b[6C\u001b[1B\u001b[2m647 \u001b[22m the build's, or one th\u001b[35G chain d\u001b[44Ges\u001b[47Gnot reach, is\u001b[61Gre\u001b[64Gus\u001b[67Gd b\u001b[72Gn\u001b[74Gme\u001b[77Gbefore\u001b[84Gany \u001b[89Gtep runs, and\u001b[103Gevery\r\u001b[6C\u001b[1B\u001b[2m648 \u001b[22m read leaves what it\u001b[32Gw\u001b[34Gs \u001b[37Geadin\u001b[43G into\u001b[49Gas i\u001b[55Gwas when the dat\u001b[73Gdoes not fit.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m1832\u001b[14G\u001b[22m `Summa\u001b[22Gy`)\u001b[26Gare\u001b[30Gthe\u001b[34Ggate.\r\u001b[5C\u001b[1B\u001b[2m 1833 \u001b[13G\u001b[22m-\u001b[15G**Scene**\u001b[25G(`engine/scene`).\u001b[43GAn\u001b[46GEnTT\u001b[51Gregistry\u001b[60Gloaded\u001b[67Gfrom\u001b[72Gand\u001b[76Gsaved\u001b[82Gto\u001b[85GYAML\r\u001b[2C\u001b[1B   \u001b[2m 1834 \u001b[22m   (`source/test/content/scene/orbit.yaml`\u001b[55Gat\u001b[58Greal\u001b[63Gscale,\u001b[70Gand\u001b[74G`main.yaml`,\u001b[87Gthe\u001b[91Gmodels,\u001b[99Gthe\u001b[103Gdefault)\u001b[112Gth\r\u001b[5C\u001b[1B\u001b[2m      \u001b[13G\u001b[22mrough\u001b[19G`serialise`'s\u001b[33Garchives,\u001b[43Gat\r\u001b[1B \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 1832 -\u001b[38;2;248;248;242m  file version 2: a field the file does not know is refused, naming its path and line, and the       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1835 +\u001b[38;2;248;248;242m  file version 3, a file of version 2 read through its migration (its `celestial` record is `body`): \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1836 +\u001b[38;2;248;248;242m  a field the file does not know is refused, naming its path and line, and the                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 1837 \u001b[15G\u001b[22mloader\u001b[22Gand\u001b[26Gthe\u001b[30Gwriter\u001b[37Gshare\u001b[43Gone\u001b[47Gcheck\u001b[53Gof\u001b[56Gwhat\u001b[61Ga\u001b[63Gfile\u001b[68Gmay\u001b[72Gsay.\u001b[77GIt\u001b[80Ghas\u001b[84Gtransform,\u001b[95Gparent,\r\u001b[1B \u001b[3G   \u001b[2m 1838 \u001b[22m   worl\u001b[20G-transfo\u001b[29Gm, came\u001b[37Ga, light (a\u001b[49Gpoint\u001b[55Gor\u001b[58Ga\u001b[60Gspot,\u001b[66Gwith\u001b[71Ga\u001b[73Grange),\u001b[81Gsun,\u001b[86Gsky,\u001b[91Gcolour\u001b[98Ggrade\u001b[104Gand\u001b[108Gmesh\r\u001b[5C\u001b[1B\u001b[2m 1839 \u001b[15G\u001b[22mcomponents\u001b[26G(a\u001b[29GglTF\u001b[34Gmodel\u001b[40Gby\u001b[43Gvirtual\u001b[51Gpath\u001b[56Gor\u001b[59Ga\u001b[61Gprocedural\u001b[72Gshape\u001b[78G-\u001b[80GUV,\u001b[84Gico\u001b[88Gor\u001b[91Gcube\u001b[96Gsphere,\u001b[104Gbox,\u001b[109Gring,\r\u001b[1B \u001b[3G   \u001b[2m      \u001b[22m  cylinder\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[10G\u001b[22mscratchpad edit \u001b[38;2;56;166;96m+16\u001b[38;2;153;153;153m, ran \u001b[1m4\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound-1 fixes committed (\u001b[38;2;177;185;249mdb22a74\u001b[39m). Running the gate so round 2 reads a current log.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
