[0.167, "o", "\u001b[?25l\u001b[H \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 2 -\u001b[38;2;248;248;242m# Rebuilds the \u001b[48;2;92;2;0msample\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mhull\u001b[48;2;61;1;0m textures in source/test/content/textures/panels:                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2 +\u001b[38;2;117;113;94m# Rebuilds the \u001b[48;2;4;71;0mtest\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mcontent's\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mpanel \u001b[48;2;2;40;0mtextures in source/test/content/textures/panels:\u001b[38;2;248;248;242m                    \r\u001b[1B\u001b[39m\u001b[49m     \u001b[2m 3 \u001b[22m \u001b[38;2;117;113;94m# painted plating (its colour) and a mask of lit windows (its emissive), both 256x256 and tileable. Writ\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m   \u001b[22m \u001b[38;2;117;113;94mes the PNGs to the\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[22m \u001b[38;2;117;113;94m# current directory; the KTX 2 files are encoded from them with KTX-Software's ktx tool (nixpkgs\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 5 \u001b[22m \u001b[38;2;117;113;94m# ktx-tools, the version the engine reads, in devenv):\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 12 \u001b[22m \u001b[38;2;117;113;94m#       --generate-mipmap panels-emissive.png \\\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 13 \u001b[22m \u001b[38;2;117;113;94m#       source/test/content/textures/panels/panels-emissive.ktx2\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 14 \u001b[22m \u001b[38;2;117;113;94m#\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m15 -\u001b[38;2;248;248;242m# The two enc\u001b[25Gdings are\u001b[35GBasis Unive\u001b[47Gsal's two mode\u001b[62G, UASTC\u001b[70Gand ETC1S,\u001b[81Gso\u001b[84Gthe\u001b[88G\u001b[48;2;92;2;0msample\u001b[95Gassets\u001b[102Gtake\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 15 +\u001b[38;2;117;113;94m# The two encodings are Basis Universal's two modes, UASTC and ETC1S, so the \u001b[48;2;4;71;0mtest\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mcontent\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mtakes\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 16 \u001b[22m \u001b[38;2;117;113;94m# both through the transcoder. The seed is fixed: the same script makes the same images.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 17 \u001b[22m \u001b[38;2;249;38;114mimport\u001b[39m random, struct, zlib\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 18 \u001b[22m\u001b[K\r\u001b[10C\u001b[2B\u001b[1m23\u001b[22m shell commands…\u001b[K\r\u001b[14C\u001b[1B\u001b[38;2;153;153;153m90\u001b[18G94\u001b[67Gcene/include/jettison/scene/Components.h'\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m*\u001b[17G\u001b[38;2;153;153;153m6m 19s · ↓\u001b[39m \u001b[38;2;153;153;153m34.4k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
