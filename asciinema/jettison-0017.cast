[0.076, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[14G\u001b[38;2;248;248;242m                                                                                                    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;117;113;94m// As every build before the space extraction's close-out wrote it.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[14G\u001b[38;2;248;248;242mSerialise::BinaryDocument\u001b[40Gdocument\u001b[49G=\u001b[51GSerialise::BinaryDocument::\u001b[38;2;166;226;46mParse\u001b[38;2;248;248;242m(save, \u001b[38;2;230;219;116m\"Jettison.World\"\u001b[38;2;248;248;242m);      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m60\u001b[14G\u001b[38;2;248;248;242mdocument.\u001b[38;2;166;226;46mRename\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"frame\"\u001b[38;2;248;248;242m, \u001b[38;2;230;219;116m\"system\"\u001b[38;2;248;248;242m);                                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m61\u001b[14G\u001b[38;2;248;248;242mFixture loaded;          \u001b[40G        \u001b[49G \u001b[51G                                                               \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[14G\u001b[38;2;248;248;242ml\u001b[16Gaded.world.\u001b[38;2;166;226;46mLoad\u001b[38;2;248;248;242m(document.\u001b[38;2;166;226;46mEmit\u001b[38;2;248;248;242m()\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[14G\u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(loaded.world.\u001b[38;2;166;226;46mSave\u001b[38;2;248;248;242m() == save);                                                                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m}\u001b[14G                                                                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSuites, format and tidy\u001b[27Gare\u001b[31Gclean.\u001b[38GRunning\u001b[46Gthe\u001b[50Greference\u001b[60Gframes\u001b[67Gto\u001b[70Gsee\u001b[74Gwhether\u001b[82Gthe\u001b[86Gsaves\u001b[92Gscreen\u001b[99Gframe\u001b[105Gmoved.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNo frame moved (the saves\u001b[29Glist\u001b[34Gis\u001b[37Gempty\u001b[43Gin\u001b[46Gthat\u001b[51Gview).\u001b[58GRecording\u001b[68G8a\u001b[71Gin\u001b[74Gthe\u001b[78Gplan\u001b[83Gand\u001b[87Gcommitting.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mW\u001b[5Grking…\u001b[12G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
