[0.059, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's safe.\u001b[18G\u001b[22mEvery\u001b[24Gfile\u001b[29Ganything\u001b[38Greads\u001b[44Gis\u001b[47Gin\u001b[50Gone\u001b[54Gof\u001b[57Gthe\u001b[61Gtwo\u001b[65Grepositories:\r\u001b[2C\u001b[1B- Jettison has\u001b[18Gfive binary save fixture\u001b[44Gand ab\u001b[51Gut\u001b[54G45\u001b[57Gversioned YAML fil\u001b[77G (test\u001b[84Gcontent,\u001b[93Gthe\u001b[97Gground\u001b[104Gsample,\u001b[112Gthe\u001b[116Gdock\r\u001b[2C\u001b[1B \u001b[5Gfix\u001b[9Gures).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has\u001b[18G18\u001b[21Gdefinition\u001b[32Gdirectories,\u001b[45Gall\u001b[49Gstill\u001b[55Gat\u001b[58Gversion\u001b[66G1\u001b[68Gwith\u001b[73Gno\u001b[76Gmigration\u001b[86Gsteps.\r\u001b[4C\u001b[1BNo third-p\u001b[16Grty mods or player saves \u001b[42Gxist. The only file outside \u001b[72Ge repos is your\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/.local/share/jettison/saves/quicksave.save\u001b[39m, which\u001b[57Gcan simply be d\u001b[73Gleted.\u001b[80G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule, until player testing\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in place.\u001b[51G\u001b[22mNo\u001b[54Gversion\u001b[62Gbump\u001b[67Gand\u001b[71Gno\u001b[74Gmigration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\r\u001b[2C\u001b[1B  \u001b[6Gthe format is rewritten in the same commit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mVersion numbers stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[2C\u001b[1B  \u001b[6Gmoves from versioning. A pin moves only when the bytes really \u001b[69Ghange, and i\u001b[82G re-pinned\u001b[93Gwith \u001b[99Ghe usual\u001b[108Gproof\u001b[114Gthat\u001b[K\r\u001b[5C\u001b[1Bonly bytes\u001b[17Gchanged, not state.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[2C\u001b[1B  \u001b[6Ga foreign version by name. One new rule closes the r\u001b[59Gmaining g\u001b[69Gp: if a field's meaning or type chang\u001b[107Gs, it gets\u001b[119G\u001b[K\r\u001b[5C\u001b[1Bnew name,\u001b[16Gso an old file is r\u001b[36Gfused rather than r\u001b[56Gad wro\u001b[63Ggly. An added\u001b[82G keeps \u001b[90Gts\u001b[93Gdefault, which is harmless.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's\u001b[59Gcontent validation already reads all of its data. On\u001b[K\r\u001b[2C\u001b[1B  \u001b[6GJettison's side I'd check that the test c\u001b[77Gd th\u001b[82G \u001b[84Gock fixtures are all loaded\u001b[112Gby\u001b[115Ga\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.061, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhy it's safe.\u001b[18G\u001b[22mEvery\u001b[24Gfile\u001b[29Ganything\u001b[38Greads\u001b[44Gis\u001b[47Gin\u001b[50Gone\u001b[54Gof\u001b[57Gthe\u001b[61Gtwo\u001b[65Grepositories:\r\u001b[2C\u001b[1B- Jettison has\u001b[18Gfive binary save fixture\u001b[44Gand ab\u001b[51Gut\u001b[54G45\u001b[57Gversioned YAML fil\u001b[77G (test\u001b[84Gcontent,\u001b[93Gthe\u001b[97Gground\u001b[104Gsample,\u001b[112Gthe\u001b[116Gdock\r\u001b[2C\u001b[1B \u001b[5Gfix\u001b[9Gures).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has\u001b[18G18\u001b[21Gdefinition\u001b[32Gdirectories,\u001b[45Gall\u001b[49Gstill\u001b[55Gat\u001b[58Gversion\u001b[66G1\u001b[68Gwith\u001b[73Gno\u001b[76Gmigration\u001b[86Gsteps.\r\u001b[4C\u001b[1BNo third-p\u001b[16Grty mods or player saves \u001b[42Gxist. The only file outside \u001b[72Ge repos is your\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/.local/share/jettison/saves/quicksave.save\u001b[39m, which\u001b[57Gcan simply be d\u001b[73Gleted.\u001b[80G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule, until player testing\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in place.\u001b[51G\u001b[22mNo\u001b[54Gversion\u001b[62Gbump\u001b[67Gand\u001b[71Gno\u001b[74Gmigration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\r\u001b[2C\u001b[1B  \u001b[6Gthe format is rewritten in the same commit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mVersion numbers stay at their current values.\u001b[52G\u001b[22mPinned\u001b[59Ghashes\u001b[66Ginclude\u001b[74Gthe\u001b[78Gversion\u001b[86Gbytes,\u001b[93Gso\u001b[96Gnot\u001b[100Gbumping\u001b[108Gmeans\u001b[114Gno\u001b[117Gpin\r\u001b[2C\u001b[1B  \u001b[6Gmoves from versioning. A pin moves only when the bytes really \u001b[69Ghange, and i\u001b[82G re-pinned\u001b[93Gwith \u001b[99Ghe usual\u001b[108Gproof\u001b[114Gthat\u001b[K\r\u001b[5C\u001b[1Bonly bytes\u001b[17Gchanged, not state.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mStale data fails loudly instead of being misread.\u001b[56G\u001b[22mThe\u001b[60Greaders\u001b[68Galready\u001b[76Grefuse\u001b[83Gan\u001b[86Gunknown\u001b[94Gfield\u001b[100Gby\u001b[103Gname\u001b[108Gand\u001b[112Gline,\u001b[118Gand\r\u001b[2C\u001b[1B  \u001b[6Ga foreign version by name. One new rule closes the r\u001b[59Gmaining g\u001b[69Gp: if a field's meaning or type chang\u001b[107Gs, it gets\u001b[119G\u001b[K\r\u001b[5C\u001b[1Bnew name,\u001b[16Gso an old file is r\u001b[36Gfused rather than r\u001b[56Gad wro\u001b[63Ggly. An added\u001b[82G keeps \u001b[90Gts\u001b[93Gdefault, which is harmless.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mEvery file we own is loaded by some test.\u001b[22m Manifest's\u001b[59Gcontent validation already reads all of its data. On\u001b[K\r\u001b[2C\u001b[1B  \u001b[6GJettison's side I'd check that the test content, \u001b[56Ghe\u001b[59Gsample's \u001b[69Gssets a\u001b[77Gd th\u001b[82G \u001b[84Gock fixtures are all loaded\u001b[112Gby\u001b[115Ga\r\u001b[5C\u001b[1Bsui\u001b[10Ge, and\u001b[17Gad\u001b[20G one \"ev\u001b[29Gry\u001b[32Gfile\u001b[37Gloads\" cas\u001b[76Gt.\u001b[79G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
