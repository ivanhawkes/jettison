[7.877, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m  \u001b[38;2;255;255;255mAll the save\u001b[16Ggames are in manifes\u001b[38Gand\u001b[42Gj\u001b[44Gttison and under our\u001b[65Gc\u001b[67Gnt\u001b[71Gl. We can simply rewrite\u001b[98Gose files for ea\u001b[115Gh \u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mmigration and save\u001b[22Gth\u001b[26Geffort of writing a new migration set for every\u001b[74Gfile change. I want you to o\u001b[103Gfer a plan for a \r\u001b[2C\u001b[1Bsafe way to move forward without\u001b[36Gadding migrations with ev\u001b[62Gry chang\u001b[71G. We will rewrite\u001b[89Gthose save files e\u001b[108Gch time \u001b[39m    \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255muntil we\u001b[12Gstart player test\u001b[30Gng, at wh\u001b[40Gch\u001b[43Gpoint \u001b[50Gt becomes wo\u001b[63Gth migration\u001b[76Gcosts.\u001b[39m                                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m9\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\u001b[1m\u001b[3m\u001b[4mPlan: no migrations until player testing\r\u001b[1B\u001b[24m\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's safe.\u001b[18G\u001b[22mEvery\u001b[24Gfile\u001b[29Ganything\u001b[38Greads\u001b[44Gis\u001b[47Gin\u001b[50Gone\u001b[54Gof\u001b[57Gthe\u001b[61Gtwo\u001b[65Grepositories:\r\u001b[2C\u001b[1B- Jettison has\u001b[18Gfive binary save fixture\u001b[44Gand ab\u001b[51Gut\u001b[54G45\u001b[57Gversioned YAML fil\u001b[77G (test\u001b[84Gcontent,\u001b[93Gthe\u001b[97Gground\u001b[104Gsample,\u001b[112Gthe\u001b[116Gdock\r\u001b[2C\u001b[1B \u001b[5Gfix\u001b[9Gures).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest has\u001b[18G18\u001b[21Gdefinition\u001b[32Gdirectories,\u001b[45Gall\u001b[49Gstill\u001b[55Gat\u001b[58Gversion\u001b[66G1\u001b[68Gwith\u001b[73Gno\u001b[76Gmigration\u001b[86Gsteps.\r\u001b[4C\u001b[1BNo third-p\u001b[16Grty mods or player saves \u001b[42Gxist. The only file outside \u001b[72Ge repos is your\u001b[K\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/.local/share/jettison/saves/quicksave.save\u001b[39m, which\u001b[57Gcan simply be d\u001b[73Gleted.\u001b[80G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule, until player testing\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA format change updates the format in place.\u001b[51G\u001b[22mNo\u001b[54Gversion\u001b[62Gbump\u001b[67Gand\u001b[71Gno\u001b[74Gmigration\u001b[84Gstep.\u001b[90GEvery\u001b[96Gfile\u001b[101Gwe\u001b[104Gown\u001b[108Gthat\u001b[113Gholds\r\u001b[2C\u001b[1B  \u001b[6Gthe format is rewritten in the same commi\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
