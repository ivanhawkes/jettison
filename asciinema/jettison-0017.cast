[0.004, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done yet:\u001b[17G\u001b[22mthe roadmap row moving t\u001b[42G hi\u001b[46Gtory, marking 8c\u001b[63Gdone in the\u001b[75Gplan, upda\u001b[86Ging th\u001b[93G \"decouple\u001b[104Gspace first\"\r\u001b[2C\u001b[1Bmemory,\u001b[11Gand\u001b[15Gmoving Manif\u001b[28Gst's SDK pin, wh\u001b[46Gh\u001b[48Gne\u001b[51Gds Jettison pushed first.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision\u001b[12Gfor\u001b[16Gyou:\r\u001b[2C\u001b[1B1. Should I fix F5/F6 now, \u001b[31Gr\u001b[33Grecord\u001b[41Ghem as known limits since no such\u001b[75Gsaves\u001b[81Gexis\u001b[86G?\u001b[K\r\u001b[2C\u001b[1B2. The plan's \"To revisit\" item: I'd keep t\u001b[47Ge save's ver\u001b[60Gion-1 migration in\u001b[79Gthe\u001b[83Gengine,\u001b[91Gbecause\u001b[99Gversion\u001b[107G1's\u001b[111Ginfo\u001b[116Gwas\r\u001b[5C\u001b[1Bthe\u001b[10Gengine's\u001b[19Gown\u001b[23Grecord.\u001b[31GAgree?\r\u001b[2C\u001b[1B3. Shall\u001b[12GI push both\u001b[24Grepositories\u001b[37Gand\u001b[41Gmove\u001b[46GManifest's\u001b[57Gpin?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis is a \u001b[14Gatural\u001b[21Gpoint \u001b[28Go\u001b[30G\u001b[38;2;177;185;249m/compact\u001b[39m before clo\u001b[50Ging out.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 1h 3m 47s · done 9:48 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mBefore we do any of the fixes that the review surfaced I want to drop some restrictions from the migration policy. \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mAll the save games are in manifest and jettison and under our control. We can simply rewrite those files for each \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mmigration and save the effort of writing a new migration set for every file change. I want you to offer a plan for a \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255msafe way to move forward without adding migrations with every change. We will rewrite those save files each time \u001b[39m     \r\u001b[1B  \u001b[38;2;255;255;255muntil we start player testing, at which point it becomes worth migration costs.\u001b[39m                                       \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m·\u001b[3GZigzagging… \u001b[16G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0017 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.011, "o", "\u001b[?25l\u001b[H\r\u001b[14C\u001b[20B\u001b[38;2;153;153;153m(Tracking ponytail mode...… · 0s)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
