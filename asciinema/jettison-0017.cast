2Gversion-2\u001b[62Gstep.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept:\u001b[11G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- the\u001b[11Gmigration\u001b[21Gmachinery\u001b[31Gin\u001b[34G\u001b[38;2;177;185;249mserialise\u001b[39m,\u001b[45Gwith\u001b[50Gits\u001b[54Gown\u001b[58Gtests\u001b[64Gon\u001b[67Gtest\u001b[72Gformats,\u001b[81Gready\u001b[87Gfor\u001b[91Glater;\r\u001b[10C\u001b[1B\u001b[38;2;177;185;249mDock::*Migrations()\u001b[31G\u001b[39mfunctions, now with no\u001b[54Gsteps, because Manifest'\u001b[79G \u001b[38;2;177;185;249mcontent\u001b[39m cal\u001b[92Gs them;\r\u001b[6C\u001b[1Bloading a save written by another Jolt\u001b[46Gversion\u001b[54Gby rebuilding its bodies.\u001b[80GThat handles a d\u001b[97Gpendency\u001b[106Gchange,\u001b[114Gnot\u001b[118Gour\r\u001b[4C\u001b[1B \u001b[7Gown form\u001b[16Gt, and cos\u001b[27Gs nothi\u001b[35Gg.\u001b[K\r\u001b[6C\u001b[1B   \u001b[11G       \u001b[19G   \u001b[23G     \u001b[29G        \u001b[27;1H\u001b[24;3H\u001b[?25h"]
