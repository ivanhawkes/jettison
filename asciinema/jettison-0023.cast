[0.041, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gat 10 s and about\u001b[23Gfive at 30\u001b[34Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[16G\u001b[22mat\u001b[19Gthe\u001b[23GDebug\u001b[29Grate\u001b[34Gthe\u001b[38Gserialise\u001b[48Gstep\u001b[53Galone\u001b[59Gwould\u001b[65Gbe\u001b[68Gabout\u001b[74G1.5\u001b[78Gs\u001b[80Gper\u001b[84Gsnapshot;\u001b[94GRelease\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BFrequent\u001b[12Gwhole-world\u001b[24Gsnapshots are\u001b[38Gfine at today's size and wrong at the size you are aimi\u001b[94Gg for. The design\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose\u001b[9Gup\u001b[12Gto\u001b[15G30\u001b[18Gs\"\u001b[21Gat\u001b[24Gboth\u001b[29Gsizes\u001b[35Gis\u001b[38Ga\u001b[40Gjournal\u001b[48Gflushed\u001b[56Gevery\u001b[62G10–30\u001b[68Gs\u001b[70Gplus\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gabout\u001b[92Gonce\u001b[97Gan\u001b[100Ghour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│                                  │        Journal flushed every 30 s + hourly snapshot        │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, 256 players         │ About 3.5 GB/day (0.9 GB of requests, 2.6 GB of snapshots) │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's world, idle │ About 25 MB/day                                            │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                          │ 2 per 30 s, plus the hourly snapsho