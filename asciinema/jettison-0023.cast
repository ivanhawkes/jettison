[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├\u001b[38G┼\u001b[99G┤\r\u001b[4C\u001b[1BDisk\u001b[10Gwrites,\u001b[18G256\u001b[22Gplayers\u001b[40GAbout\u001b[46G3.5 GB/day (0.9 GB of requests, 2.6 GB of snapshots)\r\u001b[17C\u001b[2Btoday's world,\u001b[33Gidle\u001b[46G25 MB/day \u001b[57G    \u001b[62G  \u001b[65G  \u001b[68G         \u001b[78G   \u001b[82G  \u001b[85G  \u001b[88G          \r\u001b[4C\u001b[2BFlushes     \u001b[18G       \u001b[26G      \u001b[33G    \u001b[40G2 per\u001b[46G30\u001b[49Gs, plus\u001b[57Gthe\u001b[61Ghourly\u001b[68Gsnapshot\r\u001b[4C\u001b[2BLost in\u001b[13Ga\u001b[15Gcrash\u001b[40GUp to\u001b[50G \u001b[52G    \u001b[57G   \u001b[61G      \u001b[68G        \r\u001b[4C\u001b[2BRecovery \u001b[15G     \u001b[40GLoad the\u001b[50Gnapshot,\u001b[59Greplay\u001b[66Gup\u001b[69Gto\u001b[72Gan\u001b[75Ghour\u001b[80Gof\u001b[83Gbatches\r\u001b[2C\u001b[1B└\u001b[38G┴\u001b[99G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mKept from R03:\u001b[22m the batch files, catalogue, chain and replay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[14G\u001b[22mbatches\u001b[22Gare\u001b[26Gwritten\u001b[34Gafter\u001b[40Gthe\u001b[44Gsteps\u001b[50Ghave\u001b[55Grun,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B \u001b[5Gare no longer held\u001b[26Gck.\u001b[30G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mR04:\u001b[22m still adds the snapshot\u001b[35Gnd \u001b[39Geplay from\u001b[50Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay go\u001b[10Gand I'll make that t\u001b[31Ge start of R04, with the\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[2BNot\u001b[7Gmeasured: Release serialise time, and th\u001b[76G player\u001b[27;1H\u001b[24;3H\u001b[?25h"]
