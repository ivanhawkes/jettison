[0.212, "o", "\u001b[?25l\u001b[H\u001b[3G├──────────────────────────────┼─────────────────────────────┼────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes when idle        │ 47 files/s, about 16 GB/day │ One 462 KB file per 30 s, about 1.3 GB/day │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────┼────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                      │ About 188/s                 │ 2 per 30 s                                 │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────┼────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash or power cut │ Nothing acknowledged        │ Up to 30 s of everything                   │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────┼────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a clean stop         │ Nothing                     │ Nothing                                    │\r\u001b[2C\u001b[1B├──────────────────────────────┼─────────────────────────────┼────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Recovery                     │ Replay every batch          │ Load one file                              │\r\u001b[2C\u001b[1B└──────────────────────────────┴─────────────────────────────┴────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7G462\u001b[11GKB\u001b[14Gis\u001b[17Gthe\u001b[21Gtrading\u001b[29Gworld's\u001b[37Gsave\u001b[42Gat\u001b[45Gstep\u001b[50G0;\u001b[53Git\u001b[56Gwill\u001b[61Ggrow\u001b[66Gwith\u001b[71Gthe\u001b[75Gworld.\u001b[82GThe\u001b[86Ginterval\u001b[95Gwould\u001b[101Gbe\u001b[104Ga\u001b[106Gsetting,\u001b[115Gso\u001b[118G60\r\u001b[2C\u001b[1Bs halves the writes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you give up:\r\u001b[2C\u001b[1B\u001b[22m- A trade a player\u001b[22Gsaw\u001b[26Gconfirmed\u001b[36Gin\u001b[39Gthe\u001b[43Glast\u001b[48G30\u001b[51Gs\u001b[53Gbefore\u001b[60Ga\u001b[62Gcrash\u001b[68Gun-happens.\u001b[80GEveryone\u001b[89Grolls\u001b[95Gback\u001b[100Gtogether\u001b[109Gto\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gstep, so the wo\u001b[21Gld stays consisten\u001b[40G and nothing\u001b[53Gis duplicated;\u001b[68Gclients hold no autho\u001b[90Gitative state.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA receipt m\u001b[17Gans \"it r\u001b[27Gn\", not \"it survives a crash\".\u001b[K\r\u001b[4C\u001b[1BThere \u001b[12Gs no command-by-command record of wh\u001b[49Gt h\u001b[53Gppened.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.106, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1BFlushes    \u001b[17G    \u001b[22G    \u001b[36GAbout 188/s\u001b[48G     \u001b[54G  \u001b[57G      \u001b[66G2 per 30 s\u001b[77G    \u001b[82G   \u001b[86G  \u001b[89G  \u001b[92G     \u001b[98G   \u001b[102G      \r\u001b[4C\u001b[2BLost in\u001b[13Ga\u001b[15Gcrash\u001b[21Gor\u001b[24Gpower\u001b[30Gcut\u001b[36GNothing acknowledged\u001b[66GUp to\u001b[77Gof\u001b[80Geverything\r\u001b[15C\u001b[2Blean\u001b[21Gsto\u001b[25G    \u001b[30G   \u001b[44G            \u001b[66GNothing \u001b[75G \u001b[77G  \u001b[80G          \r\u001b[4C\u001b[2BRecovery \u001b[15G     \u001b[21G    \u001b[36GReplay every\u001b[49Gbatch\u001b[66GL\u001b[68Gad one\u001b[75Gfile\r\u001b[2C\u001b[1B└\u001b[34G┴\u001b[64G┴\u001b[109G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe 462 KB is the trading world's save at step 0; it will grow with the world. The interval would be a setting,\u001b[115Gso\u001b[118G60\r\u001b[2C\u001b[1Bs\u001b[5Ghalves\u001b[12Gthe\u001b[16Gwrites.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you give up:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gtrade\u001b[13Ga\u001b[15Gplayer\u001b[22Gsaw\u001b[26Gconfirmed\u001b[36Gin\u001b[39Gthe\u001b[43Glast\u001b[48G30\u001b[51Gs\u001b[53Gbefore\u001b[60Ga\u001b[62Gcrash\u001b[68Gun-happens.\u001b[80GEveryone\u001b[89Grolls\u001b[95Gback\u001b[100Gtogether\u001b[109Gto\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B  step, so the world\u001b[24Gstays\u001b[30Gconsistent\u001b[41Gand\u001b[45Gnothing\u001b[53Gis\u001b[56Gduplicated;\u001b[68Gclients\u001b[76Ghold\u001b[81Gno\u001b[84Gauthoritative\u001b[98Gstate.\r\u001b[6C\u001b[1Breceipt\u001b[15Gme\u001b[18Gns \"it ran\", not \"\u001b[37Gt\u001b[39Gsurvives\u001b[48Ga crash\".\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTh\u001b[8Gre\u001b[11Gis\u001b[14Gno command-by-command r\u001b[38Gcord of what happened.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does to the work:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[27;1H\u001b[24;3H\u001b[?25h"]
