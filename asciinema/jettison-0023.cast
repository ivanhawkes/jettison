[0.122, "o", "\u001b[?25l\u001b[H\u001b[14G batch averages under 500 bytes. It would \u001b[57Gnly\u001b[61Ggrow past\u001b[71G16\u001b[74GGB once batches\u001b[90Gexceed 4 KiB,\u001b[104Gwhich is several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequests a second.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfour\u001b[58Gmillion\u001b[66Gfiles\u001b[72Ga\u001b[74Gday\u001b[78Galso\u001b[83Gcosts\u001b[89Ga\u001b[91Gdirectory\u001b[101Gentry,\u001b[108Gan\u001b[111Ginode\u001b[117Gand\r\u001b[2C\u001b[1B \u001b[5Gfilesystem-journal writes, forced out by\u001b[46Gabout 188 flushes a\u001b[66Gsecond.\u001b[74GI gues\u001b[81Ged two to\u001b[91Gfour \u001b[97Gimes, so 30–60 GB a\u001b[117Gday\r\u001b[4C\u001b[1Breaching the SSD; this i\u001b[30G not m\u001b[37Gasured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[60G\u001b[22mThe\u001b[64G16\u001b[67GGB\u001b[70Ga\u001b[72Gday\u001b[76Gaccumulates\u001b[88Guntil\u001b[94GR04\u001b[98Gadds\u001b[103Gretention,\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Grecovery replays from step 0. With an hourly snapshot of a\u001b[65G10 MB world, add about\u001b[88G2.6 GB a d\u001b[99Gy.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gcurrent\u001b[18Gdesign\u001b[25Gcosts\u001b[31Gthe\u001b[35Gsame\u001b[40Gheavy,\u001b[47Gconstant\u001b[56Gamount\u001b[63Gregardless\u001b[74Gof\u001b[77Gload:\u001b[83Git\u001b[86Gis\u001b[89Gas\u001b[92Gexpensive\u001b[102Gidle\u001b[107Gwith\u001b[112Gone\r\u001b[2C\u001b[1Bplayer\u001b[10Gas busy\u001b[18Gwith 256. The 30-\u001b[36Gecond flush de\u001b[51Gig\u001b[54G costs about 25 MB a day i\u001b[81Gle and about 3.5 GB a \u001b[104Gay\u001b[107Gat 256\u001b[K\r\u001b[8C\u001b[1Bs, because it\u001b[23Gpays\u001b[28Gper\u001b[32Grequ\u001b[37Gst rather than per step.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 10:13 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mDoes this mean the journal would actually cause less write wear on an SSD when there are 256 players and need less \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mstorage?\u001b[39m                                                                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLess\u001b[8Gwear,\u001b[14Gyes;\u001b[19Gless\u001b[24Gstorage,\u001b[33Gno.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWear at 256 players (writes per day):\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.534, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[22m The 16 GB a day accumul\u001b[85Ges until R04 adds retention, and\u001b[K\r\u001b[4C\u001b[1Brecov\u001b[11Gry replay\u001b[22Gfrom step 0.\u001b[35GWith\u001b[40Gan\u001b[43Ghourly\u001b[50Gsnapshot\u001b[59Gof\u001b[62Ga\u001b[64G110\u001b[68GMB\u001b[71Gworld,\u001b[78Gadd\u001b[82Gabout\u001b[88G2.6\u001b[92GGB\u001b[95Ga\u001b[97Gday.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo th\u001b[9G current design cost\u001b[30G the same heav\u001b[45G, c\u001b[49Gnstant\u001b[56Gamount regardless\u001b[74Gof load: i\u001b[85G is as expensive idle with\u001b[112Gone\u001b[K\r\u001b[2C\u001b[1Bplayer as busy\u001b[18Gwith\u001b[23G256.\u001b[28GThe 30-s\u001b[37Gcond flush\u001b[48Gdesign\u001b[55Gcosts\u001b[61Gabout\u001b[67G25\u001b[70GMB\u001b[73Ga\u001b[75Gday\u001b[79Gidle\u001b[84Gand\u001b[88Gabout\u001b[94G3.5\u001b[98GGB\u001b[101Ga\u001b[103Gday\u001b[107Gat\u001b[110G256\r\u001b[2C\u001b[1Bplayers, because it pays per request rather than per step.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 10:13 am\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mDoes this mean the journal would actually cause less write wear on an SSD when there are 256 players and need less \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mstorage?\u001b[39m                                                                                                              \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLess wear, yes; less storage,\u001b[33Gno.\r\u001b[2B  \u001b[1mWear at 256 players (writes per day):\u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────────────┬──────────────────────────────────────────────────────────────────┐\r\u001b[1B \u001b[3G│   \u001b[8G     \u001