[0.019, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept from R03:\u001b[22m the\u001b[26Gtch\u001b[30Gfiles,\u001b[37Gcatalogue,\u001b[48Gchain\u001b[54Gand\u001b[58Greplay.\r\u001b[4C\u001b[1B\u001b[1mChanged:\u001b[22m batches are written\u001b[35Gfte\u001b[39G the steps\u001b[50Ghave\u001b[55Grun,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[4C\u001b[1Bare\u001b[9Gno\u001b[12Glonger\u001b[19Gheld\u001b[24Gback.\r\u001b[2C\u001b[1B- \u001b[1mR04:\u001b[10G\u001b[22mstill adds the snaps\u001b[31Got and replay from it.\u001b[K\r\u001b[2C\u001b[2BSay\u001b[7Ggo and I'll make that the start of R04, with the flush int\u001b[66Grval as a setting\r\u001b[2B \u001b[3GNot measured: Release serialise time,\u001b[41Gand\u001b[45Gthe\u001b[49Greal\u001b[54Gsplit\u001b[60Gof\u001b[63Gthe\u001b[67G76\u001b[70GKB\u001b[73Gper\u001b[77Gplayer.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCrunched for 1m 56s · done 10:10 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Groughly:\u001b[17Gabout\u001b[23G16\u001b[26GGB\u001b[29Ga\u001b[31Gday\u001b[35Gof\u001b[38Gfile\u001b[43Gblocks\u001b[50Gfor\u001b[54Gthe\u001b[58Gjournal\u001b[66Gitself,\u001b[74Gand\u001b[78Gthat\u001b[83Gfigure\u001b[90Gis\u001b[93Gthe\u001b[97Gsame\u001b[102Gwith\u001b[107G256\u001b[111Gplayers\u001b[119Gas\r\u001b[2C\u001b[1Bwith none. Three qualifications matter.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe server writes about 47\u001b[104Gbat\u001b[110Gfiles a\u001b[K\r\u001b[4C\u001b[1Bsecond,\u001b[13Gand \u001b[18Gach\u001b[22Gtak\u001b[26Gs one\u001b[32G4\u001b[34GKiB\u001b[38Gblock\u001b[44Gwhether\u001b[52Git\u001b[55Gholds\u001b[61G235\u001b[65Gbytes\u001b[71Gor\u001b[74Ga\u001b[76Gfew\u001b[80Grequests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, a batch averages under 500 bytes. It would only gr\u001b[64Gw\u001b[66Gpast 16\u001b[74GGB once batches exce\u001b[95Gd 4 KiB, which is several\r\u001b[4C\u001b[1Bhundred requests a\u001b[24Gsecond.\u001b[32G      \u001b[39G   \u001b[43G  \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
