[0.262, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Groughly:\u001b[17Gabout\u001b[23G16\u001b[26GGB\u001b[29Ga\u001b[31Gday\u001b[35Gof\u001b[38Gfile\u001b[43Gblocks\u001b[50Gfor\u001b[54Gthe\u001b[58Gjournal\u001b[66Gitself,\u001b[74Gand\u001b[78Gthat\u001b[83Gfigure\u001b[90Gis\u001b[93Gthe\u001b[97Gsame\u001b[102Gwith\u001b[107G256\u001b[111Gplayers\u001b[119Gas\r\u001b[1B \u001b[3Gwith\u001b[8Gn\u001b[10Gne. Three qualifications\u001b[35Gmatter.\u001b[43G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, and each takes one 4 KiB block whether it holds 235 bytes or a few requests. A\u001b[92G my assumed\u001b[104G26 request\r\u001b[13C\u001b[1B batch averages under 500 bytes. It would \u001b[57Gnly\u001b[61Ggrow past\u001b[71G16\u001b[74GGB once batches\u001b[90Gexceed 4 KiB,\u001b[104Gwhich is several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequests a second.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfour\u001b[58Gmillion\u001b[66Gfiles\u001b[72Ga\u001b[74Gday\u001b[78Galso\u001b[83Gcosts\u001b[89Ga\u001b[91Gdirectory\u001b[101Gentry,\u001b[108Gan\u001b[111Ginode\u001b[117Gand\r\u001b[2C\u001b[1B \u001b[5Gfilesystem-journal writes, forced out by\u001b[46Gabout 188 flushes a\u001b[66Gsecond.\u001b[74GI gues\u001b[81Ged two to\u001b[91Gfour \u001b[97Gimes, so 30–60 GB a\u001b[117Gday\r\u001b[4C\u001b[1Breaching the SSD; this i\u001b[30G not m\u001b[37Gasured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[60G\u001b[22mThe\u001b[64G16\u001b[67GGB\u001b[70Ga\u001b[72Gday\u001b[76Gaccumulates\u001b[88Guntil\u001b[94GR04\u001b[98Gadds\u001b[103Gretention,\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Grecovery replays from step 0. With an hourly snapshot of a\u001b[65G10 MB world, add about\u001b[88G2.6 GB a d\u001b[99Gy.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gcurrent\u001b[18Gdesign\u001b[25Gcosts\u001b[31Gthe\u001b[35Gsame\u001b[40Gheavy,\u001b[47Gconstant\u001b[56Gamount\u001b[63Gregardless\u001b[74Gof\u001b[77Gload:\u001b[83Git\u001b[86Gis\u001b[89Gas\u001b[92Gexpensive\u001b[102Gidle\u001b[107Gwith\u001b[112Gone\r\u001b[2C\u001b[1Bplayer\u001b[10Gas busy\u001b[18Gwith 256. The 30-\u001b[36Gecond flush de\u001b[51Gig\u001b[54G costs about 25 MB a day i\u001b[81Gle and about 3.5 GB a \u001b[104Gay\u001b[107Gat 256\u001b[K\r\u001b[8C\u001b[1Bs, because it\u001b[23Gpays\u001b[28Gper\u001b[32Grequ\u001b[37Gst rather than per step.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 10:13 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0023 ─\r\u001b[1B\u001b[39m❯ Does this mean the journal would actually cause less write wear on an SSD when there are 256 players and need less\u001b[K\r\u001b[1B  st\u001b[K\u001b[27;1H\u001b[24;5H\u001b[?25h"]
