[0.211, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this mean\u001b[18G\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFrequent whole-world snapsho\u001b[32Gs\u001b[34Gar\u001b[38Gfine at today's siz\u001b[59Gand wrong at \u001b[73Ghe size you are aiming for. The\u001b[105Gdesign that\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose\u001b[9Gup\u001b[12Gto\u001b[15G30\u001b[18Gs\"\u001b[21Gat\u001b[24Gboth\u001b[29Gsizes\u001b[35Gis\u001b[38Ga\u001b[40Gjournal\u001b[48Gflushed\u001b[56Gevery\u001b[62G10–30\u001b[68Gs\u001b[70Gplus\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gabout\u001b[92Gonce\u001b[97Gan\u001b[100Ghour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│       \u001b[12G           \u001b[24G         \u001b[34G   \u001b[38G│   \u001b[43G  \u001b[46G Journal flushe\u001b[63Gevery\u001b[69G30\u001b[72Gs +\u001b[76Ghourl\u001b[82G sn\u001b[86Gpshot    \u001b[96G   │\u001b[101G\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GDisk\u001b[10Gwrites,\u001b[18G256\u001b[22Gplayers\u001b[38G│\u001b[40GAbout\u001b[46G3.5\u001b[50GGB/day\u001b[57G(0.9\u001b[62GGB\u001b[65Gof\u001b[68Grequests,\u001b[78G2.6\u001b[82GGB\u001b[85Gof\u001b[88Gsnapshots)\u001b[99G│\r\u001b[2C\u001b[1B├\u001b[38G┼\u001b[99G┤\r\u001b[4C\u001b[1BDisk\u001b[10Gwrites,\u001b[18Gtoday's\u001b[26Gworld,\u001b[33Gidle\u001b[40GAbout\u001b[46G25 MB/day       \u001b[63G     \u001b[69G  \u001b[72G \u001b[74G \u001b[76G      \u001b[83G        \r\u001b[4C\u001b[2BFlushes     \u001b[18G   \u001b[22G       \u001b[40G2 per\u001b[47G0 s, plus\u001b[57Gthe hourly\u001b[68Gsnapshot \u001b[78G   \u001b[82G  \u001b[85G  \u001b[88G          \r\u001b[4C\u001b[2BLo\u001b[8Gt\u001b[10Gin a crash     \u001b[26G      \u001b[33G    \u001b[40GUp to\u001