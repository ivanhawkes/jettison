[0.241, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA batch is a run of steps, not one step.\u001b[46G\u001b[22mA\u001b[48Gslow\u001b[53Gdisk\u001b[58Gthen\u001b[63Gholds\u001b[69Gthe\u001b[73Gworld\u001b[79Gback\u001b[84Gby\u001b[87Gputting\u001b[95Gmore\u001b[100Gsteps\u001b[106Gin\u001b[109Ga\u001b[111Gbatch,\r\u001b[2C\u001b[1B  with no queue of\u001b[22Gbatches.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReplay from the first step is in R03\u001b[22m,\u001b[43Gthough\u001b[50Gthe\u001b[54Gdelivery\u001b[63Gorder\u001b[69Ggives\u001b[75Gstartup\u001b[83Greplay\u001b[90Gto\u001b[93GR04.\u001b[98GA\u001b[100Gjournal\u001b[108Gnothing\u001b[116Ghas\r\u001b[2C\u001b[1B  rea\u001b[10Gproves littl\u001b[23G;\u001b[25GR04 s\u001b[31Gart\u001b[35G it from a snapshot\u001b[62G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured (Debug, no client, 20 s on Lythir's NVMe)\r\u001b[2C\u001b[2B\u001b[22m- 1,194 steps in\u001b[20G931\u001b[24Gbatches,\u001b[33Gabout\u001b[39G11\u001b[42Gms\u001b[45Ga\u001b[47Gcommit,\u001b[55Gno\u001b[58Gtime\u001b[63Gdropped.\r\u001b[2C\u001b[1B-\u001b[5GAn\u001b[8Gidle\u001b[13Gserver\u001b[20Gwrites\u001b[27Gabout\u001b[33G47\u001b[36Gfiles\u001b[42Ga\u001b[44Gsecond:\u001b[52Groughly\u001b[60G16\u001b[63GGB\u001b[66Gof\u001b[69G4\u001b[71GKiB\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\r\u001b[2C\u001b[1B \u001b[5Gremoves a batch until\u001b[27GR04's retention.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShoul\u001b[9G an idle server commit a second's steps\u001b[49Gahead instead of\u001b[66Geve\u001b[70Gy\u001b[72G21\u001b[75Gms? That would cut i\u001b[96G to o\u001b[102Ge \u001b[105Gile a second,\r\u001b[2C\u001b[1Bbut a r\u001b[11Gque\u001b[15Gt arriving mid-second would\u001b[43Gwait\u001