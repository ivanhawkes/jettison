[36G(`fixture_\u001b[47Gra\u001b[50Gfic`, 2026-11-22), to be taken up when i\u001b[91G fails. A \u001b[102Gommit is\r\u001b[7C\u001b[1B\u001b[2m9\u001b[11G\u001b[22mgat\u001b[15Gd in th\u001b[23G second ch\u001b[34Gckout, `build/gate-tree`, with `--tidy`,\u001b[75Gediting alone\u001b[89Gbeside it\u001b[99G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+36\u001b[38;2;153;153;153m, ran \u001b[1m5\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitting\u001b[14GR03\u001b[18Gin\u001b[21GManifest\u001b[30Glocally,\u001b[39Gthen\u001b[44Grunning\u001b[52Gits\u001b[56Gfull\u001b[61Ggate\u001b[66G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m)\u001b[91Gin\u001b[94Gthe\u001b[98Gsecond\u001b[105Gcheckout.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest/'build/gate-tree…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest/'build/gate-tree && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS=24 ./\u001b[31Gcripts/ci.sh --werror --asan --tidy > '/home/ivan/projects/manifest/'build/gate-r03.out \r\u001b[5C\u001b[1B2>&1; echo \"exit=$?\" >> '/hom\u001b[36G/ivan/projects/manifest/'build/gate-r03.out\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
