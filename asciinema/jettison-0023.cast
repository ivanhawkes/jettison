[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│                                  │        Journal flushed every 30 s + hourly snapshot        │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, 256 players         │ About 3.5 GB/day (0.9 GB of requests, 2.6 GB of snapshots) │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's world, idle │ About 25 MB/day                                            │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                          │ 2 per 30 s, plus the hourly snapshot                       │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash                  │ Up to 30 s                                                 │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Recovery                         │ Load the snapshot, replay up to an hour of batches         │\r\u001b[2C\u001b[1B└──────────────────────────────────┴────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mKept from R03:\u001b[22m the batch files, catalogue, chain and replay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[22m batches are written\u001b[34Gafter\u001b[40Gthe\u001b[44Gsteps\u001b[50Ghave\u001b[55Grun,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B \u001b[5Gare no longer held back.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR04:\u001b[10G\u0