\u001b[1B\u001b[2m 110 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m  73 -\u001b[38;2;248;248;242m  // Takes every committed batch's steps in a world as Host::Start left it, its requests run where    \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  74 -\u001b[38;2;248;248;242m  // they first ran, so the world and its request ledger are as the journal's last step left them.    \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m75\u001b[17G\u001b[38;2;248;248;242mA batch written\u001b[33Gbut\u001b[37Gnever named by the catal\u001b[62Ggue is\u001b[69Gn\u001b[71Gt\u001b[73Gru\u001b[76G. Throws\u001b[85Gstd::runtime_error\u001b[104Gnaming\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  76 -\u001b[38;2;248;248;242m  // the file for a batch that is missing, damaged or not the next in the chain; the world is then    \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  77 -\u001b[38;2;248;248;242m  // part-way through the journal and is discarded.                                                   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  78 -\u001b[38;2;248;248;242m  void Replay(Jettison::Sim::SimWorld &world) const;                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 111 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Brings a world as Host::Start \u001b[76G flushed step: the newest snapshot\u001b[38;2;248;248;242m    \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
