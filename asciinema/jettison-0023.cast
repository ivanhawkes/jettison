[0.210, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat this means\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BFrequent\u001b[12Gwhole-world\u001b[24Gsnapshots\u001b[34Gare\u001b[38Gfine\u001b[43Gat\u001b[46Gtoday's\u001b[54Gsize\u001b[59Gand\u001b[63Gwrong\u001b[69Gat\u001b[72Gthe\u001b[76Gsize\u001b[81Gyou\u001b[85Gare\u001b[89Gaiming\u001b[96Gfor.\u001b[101GThe\u001b[105Gdesign\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose up\u001b[12Gto 30 s\" at\u001b[24Gboth sizes is\u001b[38Ga journal flushed every 10–30 s plus a snapshot about o\u001b[94Gce an hour:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│                                  │        Journal flushed every 30 s + hourly snapshot        │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, 256 players         │ About 3.5 GB/day (0.9 GB of requests, 2.6 GB of snapshots) │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's world, idle │ About 25 MB/day                                            │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                          │ 2 per 30 s, plus the hourly snapshot                       │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash                  │ Up to 30 s                                                 │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Recovery                         │ Load the snapshot, replay up to an hour of batches         │\r\u001b[2C\u001b[1B└──────────────────────────────────┴────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept from R03:\u001b[20G\u001b[22mthe\u001b[24Gbatch\u001b[30Gfiles,\u001b[37Gcatalogue,\u001b[48Gchain\u001b[54Gand\u001b[58Greplay.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
