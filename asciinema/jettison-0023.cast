[0.022, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B \u001b[5Gfits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey rewrite\u001b[41Geverything\u001b[52Gevery\u001b[58Gtime.\u001b[64GA\u001b[66Gtypical\u001b[74G600\u001b[78GTB-rated\u001b[87Gdrive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B \u001b[5Gat 10 s and about\u001b[23Gfive at 30\u001b[34Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[16G\u001b[22mat\u001b[19Gthe\u001b[23GDebug\u001b[29Grate\u001b[34Gthe\u001b[38Gserialise\u001b[48Gstep\u001b[53Galone\u001b[59Gwould\u001b[65Gbe\u001b[68Gabout\u001b[74G1.5\u001b[78Gs\u001b[80Gper\u001b[84Gsnapshot;\u001b[94GRelease\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BFrequent\u001b[12Gwhole-world\u001b[24Gsnapshots are\u001b[38Gfine at today's size and wrong at the size you are aimi\u001b[94Gg for. The design\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose\u001b[9Gup\u001b[12Gto\u001b[15G30\u001b[18Gs\"\u001b[21Gat\u001b[24Gboth\u001b[29Gsizes\u001b[35Gis\u001b[38Ga\u001b[40Gjournal\u001b[48Gflushed\u001b[56Gevery\u001b[62G10–30\u001b[68Gs\u001b[70Gplus\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gabout\u001b[92Gonce\u001b[97Gan\u001b[100Ghour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│                                  │        Journal flushed every 30 s + hourly snapshot        │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, 256 players         │ About 3.5 GB/day (0.9 GB of requests, 2.6 GB of snapshots) │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's world, idle │ About 25 MB/day                                            │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                          │ 2 per 3\u001b[76G                       │\u001b[27;1H\u001b[24;3H\u001b[?25h"]
