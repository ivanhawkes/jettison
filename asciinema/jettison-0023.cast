[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cd '/home/ivan/\u001b[27Groj\u001b[31Gcts/manife\u001b[42Gt/'build/gate-tree…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest/'build/gate-tree && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS=24 ./scripts/ci.sh --werror --asan --tidy > '/home/ivan/projects/manifest/'build/gate-r04.out \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m2>&1; echo \"exit=$?\" >> '\u001b[32Ghome/ivan/projec\u001b[49Gs/manife\u001b[58Gt/'build/gate-r04.out\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
