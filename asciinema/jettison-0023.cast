[13.387, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GRecovery\u001b[21G│\u001b[23GReplay\u001b[30Gevery\u001b[36Gbatch\u001b[44G│\u001b[46GLoad\u001b[51Gone\u001b[55Gfile\u001b[86G│\u001b[88GLoad\u001b[93Gone\u001b[97Gfile\u001b[108G│\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B  fits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey\u001b[33Grewrite\u001b[41Geverything every time. A t\u001b[68Gpical\u001b[74G600 TB-rated drive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B  at 10 s and about five at 30 s.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[22m at the Debug rate\u001b[34Gthe\u001b[38Gserialise step alone would\u001b[65Gbe\u001b[68Gabo\u001b[72Gt 1.5\u001b[78Gs per snap\u001b[89Ghot; Release\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFreq\u001b[8Gent whole-world\u001b[24Gsnapshots\u001b[34Gare\u001b[38Gfine at\u001b[46Gtoday's size and w\u001b[65Gong at t\u001b[74Ge size\u001b[81Gyou\u001b[85Gare\u001b[89Gaiming\u001b[96Gfor.\u001b[101GThe\u001b[105Gdesign\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose up to 30 s\" at both sizes is a journal flushed every 10–30 s plus a snapshot about once an hour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌\u001b[38G┬\u001b[99G┐\r\u001b[4C\u001b[1B        \u001b[40G    \u001b[45G  Journal flush\u001b[61Gd every\u001b[69G30\u001b[72Gs + hourly\u001b[83Gsnapshot\r\u001b[2C\u001b[1B├\u001b[38G┼\u001b[99G┤\r\u001b[2C\u001b[1B│\u001b[5GDisk\u001b[10Gwrites,\u001b[18G256\u001b[22Gplayers\u001b[38G│\u001b[40GAbout\u001b[46G3.5\u001b[50GGB/day\u001b[57G(0.9\u001b[62GGB\u001b[65Gof\u001b[68Grequests,\u001b[78G2.6\u001b[82GGB\u001b[85Gof\u001b[88Gsnapshots)\u001b[99G│\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────\u001b[76G───────────────────────┤\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[4.841, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B┌\u001b[21G┬\u001b[44G┬\u001b[86G┬\u001b[108G┐\r\u001b[4C\u001b[1B        \u001b[23G Now (R03 journal)\u001b[46G    \u001b[51G   \u001b[55G Snapshot\u001b[65Gevery\u001b[71G10\u001b[74Gs\u001b[88GSn\u001b[91Gpshot\u001b[97Gevery\u001b[103G30\u001b[106Gs\r\u001b[2C\u001b[1B├\u001b[21G┼\u001b[44G┼\u001b[86G┼\u001b[108G┤\r\u001b[2C\u001b[1B│\u001b[5GDisk\u001b[10Gwrites\u001b[21G│\u001b[23GAbout\u001b[29G16\u001b[32GGB/day\u001b[44G│\u001b[46GAbout\u001b[52G950\u001b[56GGB/day\u001b[86G│\u001b[88GAbout\u001b[94G317\u001b[98GGB/day\u001b[108G│\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GFlu\u001b[9Ghes \u001b[14G \u001b[16G   \u001b[20G │ About\u001b[29G188\u001b[33Gper\u001b[37Gsecond\u001b[44G│\u001b[46G2\u001b[48Gper\u001b[52G10\u001b[55Gs\u001b[86G│\u001b[88G2\u001b[90Gper\u001b[94G30\u001b[97Gs\u001b[108G│\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[110G\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GPause\u001b[11Gper save  │\u001b[23GNon\u001b[28G  \u001b[31G  \u001b[34G  \u001b[44G│\u001b[46G110\u001b[50GMB\u001b[53Gserialised\u001b[64Gand\u001b[68Gwritten\u001b[76Geach\u001b[81Gtime\u001b[86G│\u001b[88GSame\u001b[108G│\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GLost\u001b[10Gin\u001b[13Ga\u001b[15Gcrash\u001b[21G│\u001b[23GNothing\u001b[31Gacknowledged\u001b[44G│\u001b[46GUp\u001b[49Gto\u001b[52G10\u001b[55Gs\u001b[86G│\u001b[88GUp\u001b[91Gto\u001b[94G30\u001b[97Gs\u001b[108G│\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GRecovery\u001b[21G│\u001b[23GReplay\u001b[30Gevery\u001b[36Gbatch\u001b[44G│\u001b[46GLoad\u001b[51Gone\u001b[55Gfile\u001b[86G│\u001b[88GLoad\u001b[93Gone\u001b[97Gfile\u001b[108G│\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B  fits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey\u001b[33Grewrite\u001b[41Geverything every time. A t\u001b[68Gpical\u001b[74G600 TB-rated drive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B  at 10 s and about five at 30 s.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[22m at the Debug rate\u001b[34Gthe\u001b[38Gserialise step alone would\u001b[65Gbe\u001b[68Gabo\u001b[72Gt 1.5\u001b[78Gs per snap\u001b[89Ghot; Release\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B                                            \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[6.951, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[4.747, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────┬──────────────────────┬─────────────────────────────────────────┬─────────────────────┐\r\u001b[2C\u001b[1B│                 │  Now (R03 journal)   │           Snapshot every 10 s           │ Snapshot every 30 s │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes     │ About 16 GB/day      │ About 950 GB/day                        │ About 317 GB/day    │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Flushes         │ About 188 per second │ 2 per 10 s                              │ 2 per 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Pause per save  │ None                 │ 110 MB serialised and written each time │ Same                │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash │ Nothing acknowledged │ Up to 10 s                              │ Up to 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Recovery        │ Replay every batch   │ Load one file                           │ Load one file       │\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B \u001b[5Gfits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey rewrite\u001b[41Geverything\u001b[52Gevery\u001b[58Gtime.\u001b[64GA\u001b[66Gtypical\u001b[74G600\u001b[78GTB-rated\u001b[87Gdrive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B \u001b[5Gat 10 s and about\u001b[23Gfive at 30\u001b[34Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[16G\u001b[22mat\u001b[19Gthe\u001b[23GDebug\u001b[29Grate\u001b[34Gthe\u001b[38Gserialise\u001b[76G5\u001b[78Gs\u001b[80Gper\u001b[84Gsnapshot;\u001b[94GRelease\u001b[102Gis\u001b[105Gunmeasured.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.530, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mThe tables again, at 256 players\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B┌─────────────────┬──────────────────────┬─────────────────────────────────────────┬─────────────────────┐\r\u001b[2C\u001b[1B│                 │  Now (R03 journal)   │           Snapshot every 10 s           │ Snapshot every 30 s │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes     │ About 16 GB/day      │ About 950 GB/day                        │ About 317 GB/day    │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Flushes         │ About 188 per second │ 2 per 10 s                              │ 2 per 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Pause per save  │ None                 │ 110 MB serialised and written each time │ Same                │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash │ Nothing acknowledged │ Up to 10 s                              │ Up to 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Recovery        │ Replay every batch   │ Load one file                           │ Load one file       │\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B \u001b[5Gfits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey rewrite\u001b[41Geverything\u001b[52Gevery\u001b[58Gtime.\u001b[64GA\u001b[66Gtypical\u001b[74G600\u001b[78GTB-rated\u001b[87Gdrive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B \u001b[5Gat 10 s and about\u001b[23Gfive at 30\u001b[34Gs. \u001b[38G         \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[23.691, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GLost\u001b[10Gin\u001b[13Ga\u001b[15Gcrash\u001b[21G│\u001b[23GNothing\u001b[31Gacknowledged\u001b[44G│\u001b[46GUp\u001b[49Gto\u001b[52G10\u001b[55Gs\u001b[86G│\u001b[88GUp\u001b[91Gto\u001b[94G30\u001b[97Gs\u001b[108G│\r\u001b[2C\u001b[1B├\u001b[21G┼\u001b[44G┼\u001b[86G┼\u001b[108G┤\r\u001b[4C\u001b[1BRecovery\u001b[23GReplay every batch\u001b[46GLoad\u001b[51Gone\u001b[55Gfile     \u001b[65G     \u001b[71G  \u001b[74G \u001b[88GLo\u001b[91Gd one\u001b[97Gfile \u001b[103G  \u001b[106G \r\u001b[2C\u001b[1B└\u001b[21G┴\u001b[44G┴\u001b[86G┴\u001b[108G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mWhy the journal stays at 16 GB:\u001b[22m it writes what happened, not the whole world, and a batch with a few requests\u001b[115Gstill\r\u001b[2C\u001b[1B \u001b[5Gfit\u001b[9G one\u001b[14G4\u001b[16GKiB\u001b[20Gblock.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mWhy snapshots balloon:\u001b[22m they rewrite everything every time. A typical 600 TB-rated drive would last under\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B \u001b[5Gat 10\u001b[11Gs and about\u001b[23Gfiv\u001b[28Gat\u001b[31G30\u001b[34Gs.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mThe pause:\u001b[22m at the Debug rate the serialise step alone would be about 1.5 s per snapshot; Release is unmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFrequent whole-world snapshots are fine at today's size and wrong at the size you are aiming for. The design\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose\u001b[9Gup\u001b[12Gto\u001b[15G30\u001b[18Gs\"\u001b[21Gat\u001b[24Gboth\u001b[29Gsizes\u001b[35Gis\u001b[38Ga\u001b[40Gjournal\u001b[48Gflushed\u001b[56Gevery\u001b[62G10–30\u001b[68Gs\u001b[70Gplus\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gabout\u001b[92Gonce\u001b[97Gan\u001b[100Ghour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[5G                      \u001b[28G    \u001b[33G     │ \u001b[41G      Journal flushed ever\u001b[68G 30 s\u001b[74G+ hourly snapshot \u001b[93G     \u001b[99G│\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────\u001b[76G───────────────────────┤\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.197, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mThe pause:\u001b[22m at the Debug rate the serialise step alone would be about 1.5 s per snapshot; Release is unmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFrequent whole-world snapshots are fine at today's size and wrong at the size you are aiming for. The design\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose\u001b[9Gup\u001b[12Gto\u001b[15G30\u001b[18Gs\"\u001b[21Gat\u001b[24Gboth\u001b[29Gsizes\u001b[35Gis\u001b[38Ga\u001b[40Gjournal\u001b[48Gflushed\u001b[56Gevery\u001b[62G10–30\u001b[68Gs\u001b[70Gplus\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gabout\u001b[92Gonce\u001b[97Gan\u001b[100Ghour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[5G                      \u001b[28G    \u001b[33G     │ \u001b[41G      Journal flushed ever\u001b[68G 30 s\u001b[74G+ hourly snapshot \u001b[93G     \u001b[99G│\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GDisk writes, 256 players    \u001b[34G   \u001b[38G│ About 3.5 GB/day (0.9 GB\u001b[65Gof\u001b[68Greq\u001b[72Gests,\u001b[78G2.6 GB of \u001b[89Gnapshots) │\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's\u001b[26Gworld,\u001b[33Gidle\u001b[38G│\u001b[40GAbout\u001b[46G25\u001b[49GMB/day\u001b[99G│\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Fl\u001b[8Gshes           \u001b[24G         \u001b[34G   \u001b[38G│ 2 per\u001b[46G30 s, plus the hou\u001b[65Gly snaps\u001b[74Got    \u001b[81G   \u001b[85G   \u001b[89G      \u001b[96G   │\u001b[101G\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GLost\u001b[10Gin\u001b[13Ga\u001b[15Gcrash\u001b[38G│\u001b[40GUp\u001b[43Gto\u001b[46G30\u001b[49Gs\u001b[99G│\r\u001b[2C\u001b[1B├\u001b[38G┼\u001b[99G┤\r\u001b[4C\u001b[1BRecovery\u001b[40GLoad\u001b[45Gthe snapshot, r\u001b[61Gplay up\u001b[69Gto\u001b[72Gan hour of\u001b[83Gbatches \r\u001b[2C\u001b[1B└\u001b[38G┴\u001b[99G┘\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.199, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│\u001b[5GDisk writes, 256 players    \u001b[34G   \u001b[38G│ About 3.5 GB/day (0.9 GB\u001b[65Gof\u001b[68Greq\u001b[72Gests,\u001b[78G2.6 GB of \u001b[89Gnapshots) │\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's\u001b[26Gworld,\u001b[33Gidle\u001b[38G│\u001b[40GAbout\u001b[46G25\u001b[49GMB/day\u001b[99G│\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Fl\u001b[8Gshes           \u001b[24G         \u001b[34G   \u001b[38G│ 2 per\u001b[46G30 s, plus the hou\u001b[65Gly snaps\u001b[74Got    \u001b[81G   \u001b[85G   \u001b[89G      \u001b[96G   │\u001b[101G\u001b[K\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GLost\u001b[10Gin\u001b[13Ga\u001b[15Gcrash\u001b[38G│\u001b[40GUp\u001b[43Gto\u001b[46G30\u001b[49Gs\u001b[99G│\r\u001b[2C\u001b[1B├\u001b[38G┼\u001b[99G┤\r\u001b[4C\u001b[1BRecovery\u001b[40GLoad\u001b[45Gthe snapshot, r\u001b[61Gplay up\u001b[69Gto\u001b[72Gan hour of\u001b[83Gbatches \r\u001b[2C\u001b[1B└\u001b[38G┴\u001b[99G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mKept from R03:\u001b[22m the batch files, catalogue, chain and replay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[22m batches are\u001b[27Gritten after\u001b[40Gthe steps have run,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B  are no longer held back.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR04:\u001b[22m still\u001b[16Gadds\u001b[21Gthe\u001b[25Gsnapshot\u001b[34Gand\u001b[38Greplay from it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay go\u001b[10Ga\u001b[12Gd I'll make\u001b[24Gthat\u001b[29Gthe\u001b[33Gstart of R04, with\u001b[52Gthe\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\u001b[99G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot measured:\u001b[17GRelease\u001b[25Gserialise\u001b[35Gtime, an\u001b[49Gre\u001b[52Gl split of the 76 KB per player.\u001b[K\r\u001b[2C\u001b[1B                                            \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.179, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mKept from R03:\u001b[22m the batch files, catalogue, chain and replay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[22m batches are\u001b[27Gritten after\u001b[40Gthe steps have run,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B  are no longer held back.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR04:\u001b[22m still\u001b[16Gadds\u001b[21Gthe\u001b[25Gsnapshot\u001b[34Gand\u001b[38Greplay from it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay go\u001b[10Ga\u001b[12Gd I'll make\u001b[24Gthat\u001b[29Gthe\u001b[33Gstart of R04, with\u001b[52Gthe\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\u001b[99G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot measured:\u001b[17GRelease\u001b[25Gserialise\u001b[35Gtime, an\u001b[49Gre\u001b[52Gl split of the 76 KB per player.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[4C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes, rough\u001b[14Gy: abou\u001b[22G 16 GB a day of\u001b[38Gfile blocks\u001b[50Gfor\u001b[54Gthe\u001b[58Gjournal\u001b[66Gitself,\u001b[74Gand\u001b[78Gthat\u001b[83Gfigure\u001b[90Gis\u001b[93Gthe\u001b[97Gsame\u001b[102Gwith\u001b[107G256\u001b[111Gplayers\u001b[119Gas\r\u001b[2C\u001b[1Bwith\u001b[8Gnone.\u001b[14GThree\u001b[20Gqualifications\u001b[35Gmatter.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[2C\u001b[1B  second, and\u001b[17Geach takes one 4 KiB block whether it holds 235 bytes or a few r\u001b[82Gquests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[4C\u001b[1Bsecond,\u001b[13Ga\u001b[15Gbatch\u001b[21Gaverages\u001b[30Gunder\u001b[36G500\u001b[40Gbytes.\u001b[77Gonce\u001b[82Gbatches\u001b[90Gexceed\u001b[97G4\u001b[99GKiB,\u001b[104Gwhich\u001b[110Gis\u001b[113Gseveral\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.200, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[4C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes, rough\u001b[14Gy: abou\u001b[22G 16 GB a day of\u001b[38Gfile blocks\u001b[50Gfor\u001b[54Gthe\u001b[58Gjournal\u001b[66Gitself,\u001b[74Gand\u001b[78Gthat\u001b[83Gfigure\u001b[90Gis\u001b[93Gthe\u001b[97Gsame\u001b[102Gwith\u001b[107G256\u001b[111Gplayers\u001b[119Gas\r\u001b[2C\u001b[1Bwith\u001b[8Gnone.\u001b[14GThree\u001b[20Gqualifications\u001b[35Gmatter.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[2C\u001b[1B  second, and\u001b[17Geach takes one 4 KiB block whether it holds 235 bytes or a few r\u001b[82Gquests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[4C\u001b[1Bsecond,\u001b[13Ga\u001b[15Gbatch\u001b[21Gaverages\u001b[30Gunder\u001b[36G500\u001b[40Gbytes.\u001b[47GIt\u001b[50Gwould\u001b[56Gonly\u001b[61Ggrow\u001b[66Gpast\u001b[71G16\u001b[74GGB\u001b[77Gonce\u001b[82Gbatches\u001b[90Gexceed\u001b[97G4\u001b[99GKiB,\u001b[104Gwhich\u001b[110Gis\u001b[113Gseveral\r\u001b[1B \u001b[3G  hundred requests a second.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfour\u001b[58Gmillion\u001b[66Gfiles\u001b[72Ga\u001b[74Gday\u001b[78Galso\u001b[83Gcosts\u001b[89Ga\u001b[91Gdirectory\u001b[101Gentry,\u001b[108Gan\u001b[111Ginode\u001b[117Gand\r\u001b[1B    filesystem-journal writes, forced out by about 188 flushes a second. I guessed two to four times, so 30–60 GB a day\u001b[K\r\u001b[4C\u001b[1Breaching\u001b[14Gthe\u001b[18GSSD;\u001b[23Gthis\u001b[28Gis\u001b[31Gnot\u001b[35Gmeasured.\r\u001b[1B \u001b[3G- \u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[22m The 16 GB a day accumulates until R04 \u001b[99Gdds retention, and\u001b[K\r\u001b[2C\u001b[1B  recovery\u001b[14Greplays from step 0.\u001b[35GWi\u001b[38Gh an\u001b[43Ghourly\u001b[50Gsnapshot\u001b[59Gof\u001b[62Ga\u001b[64G110\u001b[68GMB\u001b[71Gworld,\u001b[78Gadd\u001b[82Gabout\u001b[88G2.6\u001b[92GGB\u001b[95Ga\u001b[97Gday.\r\u001b[2C\u001b[2BSo the current design costs the same heavy, constant amount regardless of\u001b[77Gload: it is as \u001b[93Gxpensive idle with one\u001b[116G\u001b[K\r\u001b[2C\u001b[1Bplayer as\u001b[13Gbusy with 256.\u001b[28GTh\u001b[32G30-second flush d\u001b[50Gsign\u001b[55Gc\u001b[57Gst\u001b[61Gabout 25 MB a day idle and about 3.5 GB a day\u001b[107Gat 256\u001b[K\r\u001b[2C\u001b[1Bplayers, because it pays per r\u001b[34Gquest\u001b[40Gra\u001b[43Gher\u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.383, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Yes, roughly: about 16 GB a day of file blocks for the journal itself, and that figure is the same with 256 players as\r\u001b[2C\u001b[1Bwith\u001b[8Gnone.\u001b[14GThree\u001b[20Gqualifications\u001b[35Gmatter.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[4C\u001b[1Bsecond,\u001b[13Gand\u001b[17Geach\u001b[22Gtakes\u001b[28Gone\u001b[32G4\u001b[34GKiB\u001b[38Gblock\u001b[44Gwhether\u001b[52Git\u001b[55Gholds\u001b[61G235\u001b[65Gbytes\u001b[71Gor\u001b[74Ga\u001b[76Gfew\u001b[80Grequests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, a batch averages under 500 bytes. It would only grow past 16 GB\u001b[77Gonce batches exceed 4 KiB,\u001b[104Gwhi\u001b[110Gis several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequ\u001b[18Gsts\u001b[22Ga s\u001b[26Gcond.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[22m Each of the four milli\u001b[64Gn\u001b[66Gfiles a\u001b[74Gday also costs a dir\u001b[95Gctory entry, an inode and\r\u001b[4C\u001b[1Bfilesystem-journal\u001b[24Gwrites,\u001b[32Gforced\u001b[39Gout\u001b[43Gby\u001b[46Gabout\u001b[52G188\u001b[56Gflushes\u001b[64Ga\u001b[66Gsecond.\u001b[74GI\u001b[76Gguessed\u001b[84Gtwo\u001b[88Gto\u001b[91Gfour\u001b[96Gtimes,\u001b[103Gso\u001b[106G30–60\u001b[112GGB\u001b[115Ga\u001b[117Gday\r\u001b[2C\u001b[1B \u001b[5Greaching the SSD; this is not measured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[22m The\u001b[64G16 GB a day\u001b[76Gaccumula\u001b[85Ges\u001b[88Guntil R04 adds\u001b[103Gretention, and\u001b[K\r\u001b[6C\u001b[1Bcovery\u001b[14Greplays from step 0.\u001b[35GWith an hourly\u001b[50Gsnapshot\u001b[59Gof\u001b[62Ga\u001b[64G110\u001b[68GMB\u001b[71Gworld,\u001b[78Gadd\u001b[82Gabout\u001b[88G2.6\u001b[92GGB\u001b[95Ga\u001b[97Gday.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo the current de\u001b[21Gign co\u001b[29Gs the\u001b[35Gsame\u001b[40Gheavy, con\u001b[51Gt\u001b[53Gnt amount regardless of loa\u001b[81G: it is as\u001b[92Gexpensive\u001b[102Gidle\u001b[107Gwith\u001b[112Gone\r\u001b[2C\u001b[1Bplayer\u001b[10Gas\u001b[13Gbusy\u001b[18Gwith\u001b[23G256.\u001b[28GThe\u001b[32G30-second\u001b[42Gflush\u001b[48Gdesign\u001b[55Gcosts\u001b[61Gabout\u001b[67G25\u001b[70GMB\u001b[73Ga\u001b[75Gday\u001b[79Gidle\u001b[84Gand\u001b[88Gabout\u001b[94G3.5\u001b[98GGB\u001b[101Ga\u001b[103Gday\u001b[107Gat\u001b[110G256\r\u001b[2C\u001b[1Bplayers, because it pays per r\u001b[34Gquest\u001b[40Grather\u001b[47Gthan per\u001b[56Gstep.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 10:13 am\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
