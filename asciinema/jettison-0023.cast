[0.091, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 4 \u001b[22m{\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5 \u001b[22mcon\u001b[14G std::string_view kGameRevision = \"@VERSION@+@game@\";\u001b[K\r\u001b[6C\u001b[1B\u001b[2m6 \u001b[22mconst\u001b[15Gstd::string_view\u001b[32GkSdkRevision\u001b[45G=\u001b[47G\"@sdk@\";\r\u001b[6C\u001b[1B\u001b[2m7 \u001b[22m} //\u001b[14Gnamespace Ma\u001b[27Gifest::Hos\u001b[38G\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWrite\u001b[22m(~/projects/manifest/cmake/Revision.c\u001b[47Gke)\u001b[K\r\u001b[5C\u001b[1BWrote\u001b[13G\u001b[1m0\u001b[22m lines\u001b[21Gto \u001b[1m~/projects/manifest/cmake/Revision.cmake\r\u001b[6C\u001b[1B\u001b[22m\u001b[2m 1\u001b[10G\u001b[22m\u001b[38;2;117;113;94m# Run at every build (source/game/host): writes OUT from IN with the trees the build is made from, so\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 2\u001b[10G\u001b[22m\u001b[38;2;117;113;94m# that two builds whose code differs never share an identity (D-111), a build from uncommitted\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 3\u001b[10G\u001b[22m\u001b[38;2;117;113;94m# changes included. A tree is git's\u001b[46Gown hash\u001b[55Gof a checkout's build inputs\u001b[85Gs the\u001b[92Gare on\u001b[99Gdisk,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# tracked or not, taken in an index and an object store of the build tree's: the checkout's own are\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# not touched, and the index kept between builds means only changed files are read again. OUT is\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m# rewritten only when a tree has changed. GAME and SDK are directories anywhere inside each checkout.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 7\u001b[10G\u001b[22m\u001b[38;2;102;217;239mfunction\u001b[39m(manifest_tree\u001b[33Gout\u001b[37Gcheckout\u001b[46Gname)\r\u001b[6C\u001b[1B\u001b[2m 8\u001b[11G\u001b[22m \u001b[14G\u001b[38;2;249;38;114mset\u001b[39m(git\u001b[22G\u001b[38;2;230;219;116m\"${CMAKE_COMMAND}\"\u001b[41G\u001b[39m-E\u001b[44Genv\u001b[48G\u001b[38;2;230;219;116m\"GIT_INDEX_FILE=${WORK}/${name}.index\"\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 9\u001b[13G\u001b[22m    \u001b[18G\u001b[38;2;230;219;116m\"GIT_OBJECT_DIRECTORY=${WORK}/${name}.objects\"\u001b[65G\"${GIT}\"\u001b[74G\u001b[39m-C\u001b[77G\u001b[38;2;230;219;116m\"${checkout}\"\u001b[39m)\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[14G\u001b[22m\u001b[38;2;249;38;114mfile\u001b[39m(\u001b[38;2;249;38;114mMAKE_DIRECTORY\u001b[34G\u001b[38;2;230;219;116m\"${WORK}/${name}.objects\"\u001b[39m)\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153m… +10 lines \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;153;153;153m Found \u001b[1m1\u001b[22m new diagnost\u001b[27Gc issue in 1 f\u001b[42Gle (ctrl+o to expand)\r\u001b[18C\u001b[2B10m 10s · ↓\u001b[39m \u001b[38;2;153;153;153m56.7k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
