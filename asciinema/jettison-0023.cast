[0.279, "o", "\u001b[?25l\u001b[H\u001b[3G├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Files written                │ 47 per second        │ 1 per 10 s (8,640 a day) │ 1 per 30 s (2,880 a day) │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes when idle        │ About 16 GB/day      │ About 4.0 GB/day         │ About 1.3 GB/day         │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                      │ About 188 per second │ 2 per 10 s               │ 2 per 30 s               │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash or power cut │ Nothing acknowledged │ Up to 10 s of everything │ Up to 30 s of everything │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a clean stop         │ Nothing              │ Nothing                  │ Nothing                  │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Recovery                     │ Replay every batch   │ Load one file            │ Load one file            │\r\u001b[2C\u001b[1B└──────────────────────────────┴──────────────────────┴──────────────────────────┴──────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo 10 s costs\u001b[17Gthree\u001b[23Gtimes\u001b[29Gthe\u001b[33Gwrit\u001b[38Gs of\u001b[43G30 s,\u001b[49Gand still\u001b[59Ga quart\u001b[67Gr of what\u001b[77Gthe\u001b[81Gjournal writ\u001b[94Gs now\u001b[100Gwith\u001b[105Gabout\u001b[111G1/900th