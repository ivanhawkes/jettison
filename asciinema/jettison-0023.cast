[0.046, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GAn\u001b[8Gidle\u001b[13Gserver\u001b[20Gwrites\u001b[27Gabout\u001b[33G47\u001b[36Gfiles\u001b[42Ga\u001b[44Gsecond:\u001b[52Groughly\u001b[60G16\u001b[63GGB\u001b[66Gof\u001b[69G4\u001b[71GKiB\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\r\u001b[2C\u001b[1B \u001b[5Gremoves a batch until\u001b[27GR04's retention.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShoul\u001b[9G an idle server commit a second's steps\u001b[49Gahead instead of\u001b[66Geve\u001b[70Gy\u001b[72G21\u001b[75Gms? That would cut i\u001b[96G to o\u001b[102Ge \u001b[105Gile a second,\r\u001b[2C\u001b[1Bbut a r\u001b[11Gque\u001b[15Gt arriving mid-second would\u001b[43Gwait\u001b[48Gfor\u001b[52Gthe\u001b[56Gnext\u001b[61Gcommit.\u001b[69GI\u001b[71Gleft\u001b[76Git\u001b[79Gas\u001b[82Gmeasured,\u001b[92Gsince\u001b[98Gthe\u001b[102Gplan\u001b[107Gsays\u001b[112Gmeasure\r\u001b[2C\u001b[1Bbefore\u001b[10Gchanging\u001b[19Gthe\u001b[23Gprotocol.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[5C\u001b[1Bny edit under \u001b[38;2;177;185;249msource\u001b[39m or\u001b[30G\u001b[38;2;177;185;249mcmake\u001b[39m makes a\u001b[44Gw\u001b[46Grld from the previous\u001b[68Gbuild unopenable,\u001b[86Gby\u001b[89Gdesign\u001b[96Gof\u001b[99GD-111;\u001b[106Gdelete\u001b[113Gthe\r\u001b[2C\u001b[1B \u001b[5Gworld directory.\u001b[K\r\u001b[4C\u001b[1BJet\u001b[9Gison's roadmap and history are updat\u001b[46Gd in \u001b[38;2;177;185;249m487915c\u001b[39m, docs \u001b[66Gnly,\u001b[71Gso no engine gat\u001b[88G was run.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNext \u001b[11Gs R04:\u001b[18Gboundary\u001b[27Gsnapshots,\u001b[38Gretention\u001b[48Gand\u001b[52Greplay\u001b[59Gfrom\u001b[64Ga\u001b[66Gsnapshot.\u001b[76GIt\u001b[79Gis\u001b[82Gdesign-heavy\u001b[95Gagain\u001b[101G(save\u001b[107Gsection,\r\u001b[4C\u001b[1Bcandidate\u001b[15Gworld),\u001b[23Gso\u001b[26GI'd\u001b[30Gkeep\u001b[35Gthis\u001b[40Gmodel\u001b[46Gat\u001b[49Ghigh\u001b[54Geffort,\u001b[62Gand\u001b[66Gstart\u001b[72Git\u001b[75Gin\u001b[78Ga\u001b[80Gfresh\u001b[86Gsession;\u001b[95Gthe\u001b[99Ghandoff\u001b[107Gis\u001b[110Gin\r\u001b[1B \u001b[3G  Manifest's \u001b[38;2;177;185;249mdocs/session-handoff.md\u001b[39m.\r\u001b[2B  Not done or not checked:\u001b[K\r\u001b[2B \u001b[3G- A kill at each exact\u001b[26Gcommit boundary in a separate process is\u001b[67Gleft\u001b[72Gto\u001b[75GR04;\u001b[80G\u001b[38;2;177;185;249mcli_serve\u001b[90G\u001b[39mkills\u001b[96Gbetween\u001b[104Gsteps\u001b[110Gonly.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
