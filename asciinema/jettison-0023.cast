[0.109, "o", "\u001b[?25l\u001b[H\u001b[3Grequest every 10 s, about 26 a second.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe tables again, at 256 players\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────┬──────────────────────┬─────────────────────────────────────────┬─────────────────────┐\u001b[K\r\u001b[2C\u001b[1B│\u001b[6G               │  Now (R03 journal)   │           Snapshot every 10 s           │ Snapshot every 30 s │\u001b[K\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GDisk writes     │ About 16 GB/day      │ About 950 GB/day                        │ About 317 GB/day    │\u001b[K\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GFlushes         │ About 188 per second │ 2 per 10 s                              │ 2 per 30 s          │\u001b[K\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GPause per save  │ None                 │ 110 MB serialised and written each time │ Same                │\u001b[K\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GLost in a crash │ Nothing acknowledged │ Up to 10 s                              │ Up to 30 s          │\u001b[K\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GRecovery        │ Replay every batch   │ Load one file                           │ Load one file       │\u001b[K\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\r\u001b[1B\u001b[K\r\u001b[1B  - \u001b[1mWhy the journal stays at 16 GB:\u001b[22m it writes what happened, not\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[4C\u001b[1Bfits\u001b[10Gone\u001b[14G4\u001b[16GKiB\u001b[20Gblock.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.460, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey\u001b[33Grewrite\u001b[41Geverything\u001b[52Gevery\u001b[58Gtime.\u001b[64GA\u001b[66Gtypical\u001b[74G600\u001b[78GTB-rated\u001b[87Gdrive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.108, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mThe tables again, at 256 players\u001b[22m\u001b[K\r\u001b[2C\u001b[2B┌─────────────────┬──────────────────────┬─────────────────────────────────────────┬─────────────────────┐\r\u001b[2C\u001b[1B│\u001b[21G│\u001b[24GNow\u001b[28G(R03\u001b[33Gjournal)\u001b[44G│\u001b[56GSnapshot\u001b[65Gevery\u001b[71G10\u001b[74Gs\u001b[86G│\u001b[88GSnapshot\u001b[97Gevery\u001b[103G30\u001b[106Gs\u001b[108G│\r\u001b[2C\u001b[1B├\u001b[21G┼\u001b[44G┼\u001b[86G┼\u001b[108G┤\r\u001b[4C\u001b[1BDisk\u001b[10Gwrites\u001b[23GAb\u001b[26Gut 16 GB/day   \u001b[46GAbout\u001b[52G950\u001b[56GGB/day  \u001b[65G     \u001b[71G  \u001b[74G \u001b[88GAbout 317 GB/day \u001b[106G \r\u001b[4C\u001b[2BFlushes    \u001b[30G88 per second\u001b[46G2 per\u001b[52G10 s      \u001b[88G2 per\u001b[95G0 s      \r\u001b[4C\u001b[2BPa\u001b[9Ge per\u001b[15Gsave\u001b[23GNone \u001b[29G   \u001b[33G   \u001b[37G      \u001b[46G110 MB serialised\u001b[64Gand\u001b[68Gwritten\u001b[76Geach\u001b[81Gtime\u001b[88GSam\u001b[92G \u001b[94G  \u001b[97G \r\u001b[4C\u001b[2BLost in a\u001b[15Gcrash\u001b[25Gthing\u001b[31Gacknowledged\u001b[46GUp to 10 s       \u001b[64G   \u001b[68G       \u001b[76G    \u001b[81G    \u001b[88GUp to\u001b[94G30\u001b[97Gs\r\u001b[4C\u001b[2BRecovery \u001b[15G     \u001b[23GReplay every batch  \u001b[46GLoad one\u001b[55Gfile\u001b[88GLoad one\u001b[97Gfile\r\u001b[2C\u001b[1B└\u001b[21G┴\u001b[44G┴\u001b[86G┴\u001b[108G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mWhy the journal stays at 16 GB:\u001b[22m it writes what happened, not the whole world, and a batch with a few requests\u001b[115Gstill\r\u001b[4C\u001b[1Bfits\u001b[10Gone\u001b[14G4\u001b[16GKiB\u001b[20Gblock.\r\u001b[8C\u001b[1B\u001b[1msnapshots balloon:\u001b[22m they rewr\u001b[39Ge everything\u001b[52Gevery time. A\u001b[67Gypical 600 TB-rate\u001b[87Gdrive would l\u001b[101Gst und\u001b[108Gr two years\u001b[K\r\u001b[4C\u001b[1Bat 10 s and about five\u001b[28Gat\u001b[31G30\u001b[34Gs.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.421, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B┌─────────────────┬──────────────────────┬─────────────────────────────────────────┬─────────────────────┐\r\u001b[2C\u001b[1B│                 │  Now (R03 journal)   │           Snapshot every 10 s           │ Snapshot every 30 s │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes     │ About 16 GB/day      │ About 950 GB/day                        │ About 317 GB/day    │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Flushes         │ About 188 per second │ 2 per 10 s                              │ 2 per 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Pause per save  │ None                 │ 110 MB serialised and written each time │ Same                │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash │ Nothing acknowledged │ Up to 10 s                              │ Up to 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Recovery        │ Replay every batch   │ Load one file                           │ Load one file       │\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B \u001b[5Gfits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey\u001b[33Grewrite\u001b[41Geverything\u001b[52Gevery\u001b[58Gtime.\u001b[64GA\u001b[66Gtypical\u001b[74G600\u001b[78GTB-rated\u001b[87Gdrive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B \u001b[5Gat 10 s and about five\u001b[28Gat 30 s.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[22m at the\u001b[23GDebug rate\u001b[34Gthe\u001b[38Gserialise\u001b[48Gstep\u001b[53Galone\u001b[59Gwould\u001b[65Gbe\u001b[68Gabout\u001b[74G1.5\u001b[78Gs\u001b[80Gper\u001b[84Gsnapshot;\u001b[94GRelease\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.105, "o", "\u001b[?25l\u001b[H\u001b[3G│\u001b[21G│\u001b[24GNow\u001b[28G(R03\u001b[33Gjournal)\u001b[44G│\u001b[56GSnapshot\u001b[65Gevery\u001b[71G10\u001b[74Gs\u001b[86G│\u001b[88GSnapshot\u001b[97Gevery\u001b[103G30\u001b[106Gs\u001b[108G│\r\u001b[2C\u001b[1B├\u001b[21G┼\u001b[44G┼\u001b[86G┼\u001b[108G┤\r\u001b[4C\u001b[1BDisk\u001b[10Gwrites\u001b[23GAb\u001b[26Gut 16 GB/day   \u001b[46GAbout\u001b[52G950\u001b[56GGB/day  \u001b[65G     \u001b[71G  \u001b[74G \u001b[88GAbout 317 GB/day \u001b[106G \r\u001b[4C\u001b[2BFlushes    \u001b[30G88 per second\u001b[46G2 per\u001b[52G10 s      \u001b[88G2 per\u001b[95G0 s      \r\u001b[4C\u001b[2BPa\u001b[9Ge per\u001b[15Gsave\u001b[23GNone \u001b[29G   \u001b[33G   \u001b[37G      \u001b[46G110 MB serialised\u001b[64Gand\u001b[68Gwritten\u001b[76Geach\u001b[81Gtime\u001b[88GSam\u001b[92G \u001b[94G  \u001b[97G \r\u001b[4C\u001b[2BLost in a\u001b[15Gcrash\u001b[25Gthing\u001b[31Gacknowledged\u001b[46GUp to 10 s       \u001b[64G   \u001b[68G       \u001b[76G    \u001b[81G    \u001b[88GUp to\u001b[94G30\u001b[97Gs\r\u001b[4C\u001b[2BRecovery \u001b[15G     \u001b[23GReplay every batch  \u001b[46GLoad one\u001b[55Gfile\u001b[88GLoad one\u001b[97Gfile\r\u001b[2C\u001b[1B└\u001b[21G┴\u001b[44G┴\u001b[86G┴\u001b[108G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mWhy the journal stays at 16 GB:\u001b[22m it writes what happened, not the whole world, and a batch with a few requests\u001b[115Gstill\r\u001b[4C\u001b[1Bfits\u001b[10Gone\u001b[14G4\u001b[16GKiB\u001b[20Gblock.\r\u001b[8C\u001b[1B\u001b[1msnapshots balloon:\u001b[22m they rewr\u001b[39Ge everything\u001b[52Gevery time. A\u001b[67Gypical 600 TB-rate\u001b[87Gdrive would l\u001b[101Gst und\u001b[108Gr two years\u001b[K\r\u001b[4C\u001b[1Bat 10 s and about five\u001b[28Gat\u001b[31G30\u001b[34Gs.\r\u001b[4C\u001b[1B\u001b[1mT\u001b[7Ge\u001b[9Gpause:\u001b[22m at the Debug rate the s\u001b[40Grialise step alone would be about\u001b[74G1.5\u001b[78Gs per snapshot; Re\u001b[97Gease is unmeasured.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\u001b[19G\u001b[22m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.523, "o", "\u001b[?25l\u001b[H\u001b[3G├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes     │ About 16 GB/day      │ About 950 GB/day                        │ About 317 GB/day    │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Flushes         │ About 188 per second │ 2 per 10 s                              │ 2 per 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Pause per save  │ None                 │ 110 MB serialised and written each time │ Same                │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash │ Nothing acknowledged │ Up to 10 s                              │ Up to 30 s          │\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│ Recovery        │ Replay every batch   │ Load one file                           │ Load one file       │\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B \u001b[5Gfits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey\u001b[33Grewrite\u001b[41Geverything\u001b[52Gevery\u001b[58Gtime.\u001b[64GA\u001b[66Gtypical\u001b[74G600\u001b[78GTB-rated\u001b[87Gdrive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B \u001b[5Gat 10 s and about five\u001b[28Gat 30 s.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[22m at the\u001b[23GDebug rate\u001b[34Gthe\u001b[38Gserialise\u001b[48Gstep\u001b[53Galone\u001b[59Gwould\u001b[65Gbe\u001b[68Gabout\u001b[74G1.5\u001b[78Gs\u001b[80Gper\u001b[84Gsnapshot;\u001b[94GRelease\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BFrequent\u001b[12Gwhole-world\u001b[24Gsnapshots\u001b[34Gare\u001b[38Gfine\u001b[43Gat\u001b[46Gtoday's\u001b[54Gsize\u001b[59Gand\u001b[63Gwrong\u001b[69Gat\u001b[72Gthe\u001b[76Gsize\u001b[81Gyou\u001b[85Gare\u001b[89Gaiming\u001b[96Gfor.\u001b[101GThe\u001b[105Gdesign\u001b[112Gthat\u001b[117Gfits\u001b[27;1H\u001b[24;3H\u001b[?25h"]
