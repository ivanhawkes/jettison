[0.018, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\"lose up to 30 s\" at both sizes is a journal flushed every 10–30 s plus a snapshot about once an hour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌\u001b[38G┬\u001b[99G┐\r\u001b[4C\u001b[1B    \u001b[10G       \u001b[18G   \u001b[22G       \u001b[40G     \u001b[46G Journal flushed every 30 s + hourly snapshot       \r\u001b[17C\u001b[2B256 players   \u001b[33G    \u001b[46G3.5 GB/day\u001b[57G(0.9\u001b[62GGB\u001b[65Gof\u001b[68Grequests,\u001b[78G2.6\u001b[82GGB\u001b[85Gof\u001b[88Gsnapshots)\r\u001b[4C\u001b[2BDisk writes,\u001b[18Gtoday's\u001b[26Gworld,\u001b[33Gidle\u001b[40GAbout\u001b[46G25\u001b[49GMB/day \u001b[57G   \u001b[61G      \u001b[68G        \r\u001b[4C\u001b[2BFlushes\u001b[13G \u001b[15G     \u001b[40G2 per\u001b[50G,\u001b[52Gplus\u001b[57Gthe\u001b[61Ghourly\u001b[68Gsnapshot\r\u001b[4C\u001b[2BLost in a\u001b[15Gcrash\u001b[40GUp to 30\u001b[50G        \u001b[59G      \u001b[66G  \u001b[69G  \u001b[72G  \u001b[75G    \u001b[80G  \u001b[83G       \r\u001b[2C\u001b[1B├\u001b[38G┼\u001b[99G┤\r\u001b[2C\u001b[1B│\u001b[5GRecovery\u001b[38G│\u001b[40GLoad\u001b[45Gthe\u001b[49Gsnapshot,\u001b[59Greplay\u001b[66Gup\u001b[69Gto\u001b[72Gan\u001b[75Ghour\u001b[80Gof\u001b[83Gbatches\u001b[99G│\r\u001b[2C\u001b[1B└──────────────────────────────────┴────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept from R03:\u001b[22m the\u001b[26Gtch\u001b[30Gfiles,\u001b[37Gcatalogue,\u001b[48Gchain\u001b[54Gand\u001b[58Greplay.\r\u001b[4C\u001b[1B\u001b[1mChanged:\u001b[22m batches are written\u001b[35Gfte\u001b[39G the steps\u001b[50Ghave\u001b[55Grun,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[4C\u001b[1Bare\u001b[9Gno\u001b[12Glonger\u001b[19Gheld\u001b[24Gback.\r\u001b[2C\u001b[1B- \u001b[1mR04:\u001b[10G\u001b[22mstill adds the snaps\u001b[31Got and replay fr\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.043, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BFrequent\u001b[12Gwhole-world\u001b[24Gsnapshots are\u001b[38Gfine at today's size and wrong at the size you are aimi\u001b[94Gg for. The design\u001b[112Gthat\u001b[117Gfits\r\u001b[2C\u001b[1B\"lose\u001b[9Gup\u001b[12Gto\u001b[15G30\u001b[18Gs\"\u001b[21Gat\u001b[24Gboth\u001b[29Gsizes\u001b[35Gis\u001b[38Ga\u001b[40Gjournal\u001b[48Gflushed\u001b[56Gevery\u001b[62G10–30\u001b[68Gs\u001b[70Gplus\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gabout\u001b[92Gonce\u001b[97Gan\u001b[100Ghour:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────────────────────────┬────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│                                  │        Journal flushed every 30 s + hourly snapshot        │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, 256 players         │ About 3.5 GB/day (0.9 GB of requests, 2.6 GB of snapshots) │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Disk writes, today's world, idle │ About 25 MB/day                                            │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Flushes                          │ 2 per 30 s, plus the hourly snapshot                       │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash                  │ Up to 30 s                                                 │\r\u001b[2C\u001b[1B├──────────────────────────────────┼────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Recovery                         │ Load the snapshot, replay up to an hour of batches         │\r\u001b[2C\u001b[1B└───────