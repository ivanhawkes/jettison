[0.608, "o", "\u001b[?25l\u001b[H\u001b[3G└──────────────────────────────────┴────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKept from R03:\u001b[20G\u001b[22mthe\u001b[24Gbatch\u001b[30Gfiles,\u001b[37Gcatalogue,\u001b[48Gchain\u001b[54Gand\u001b[58Greplay.\r\u001b[4C\u001b[1B\u001b[1mChanged:\u001b[22m batches are written after the steps have run, each request\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B \u001b[5Gare no longer held back.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR04:\u001b[22m still adds the snapshot\u001b[34Gand\u001b[38Greplay\u001b[45Gfrom\u001b[50Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay\u001b[7Ggo\u001b[10Gand\u001b[14GI'll\u001b[19Gmake\u001b[24Gthat\u001b[29Gthe\u001b[33Gstart\u001b[39Gof\u001b[42GR04,\u001b[47Gwith\u001b[52Gthe\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Gmeasured:\u001b[17GRelease\u001b[25Gserialise\u001b[35Gtime,\u001b[41Gand\u001b[45Gthe\u001b[49Greal\u001b[54Gsplit\u001b[60Gof\u001b[63Gthe\u001b[67G76\u001b[70GKB\u001b[73Gper\u001b[77Gplayer.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Groughly:\u001b[17Gabout\u001b[23G16\u001b[26GGB\u001b[29Ga\u001b[31Gday\u001b[35Gof\u001b[38Gfile\u001b[43Gblocks\u001b[50Gfor\u001b[54Gthe\u001b[58Gjournal\u001b[66Gitself,\u001b[74Gand\u001b[78Gthat\u001b[83Gfigure\u001b[90Gis\u001b[93Gthe\u001b[97Gsame\u001b[102Gwith\u001b[107G256\u001b[111Gplayers\u001b[119Gas\r\u001b[1B \u001b[3Gwith\u001b[8Gn\u001b[10Gne. Three qualifications\u001b[35Gmatter.\u001b[43G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, and each takes one 4 KiB block whether it holds 235 bytes or a few requests. A\u001b[92G my assumed\u001b[104G26 request\r\u001b[13C\u001b[1B batch averages under 500 bytes. It would \u001b[57Gnly\u001b[61Ggrow past\u001b[71G16\u001b[74GGB once batches\u001b[90Gexceed 4 KiB,\u001b[104Gwhich is several\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.110, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mKept from R03:\u001b[22m the batch files, catalogue, chain and replay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[14G\u001b[22mbatches\u001b[22Gare\u001b[26Gwritten\u001b[34Gafter\u001b[40Gthe\u001b[44Gsteps\u001b[50Ghave\u001b[55Grun,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B \u001b[5Gare no longer held\u001b[26Gck.\u001b[30G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mR04:\u001b[22m still adds the snapshot\u001b[35Gnd \u001b[39Geplay from\u001b[50Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay go\u001b[10Gand I'll make that t\u001b[31Ge start of R04, with the\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[2BNot\u001b[7Gmeasured: Release serialise time, and the real split of th\u001b[66G 76 KB per player\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Yes, roughly: about 16 GB a day of file blocks for the journal itself, and that figure is the same with 256 players as\r\u001b[2C\u001b[1Bwith\u001b[8Gnone.\u001b[14GThree\u001b[20Gqualifications\u001b[35Gmatter.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[4C\u001b[1Bsecond,\u001b[13Gand\u001b[17Geach\u001b[22Gtakes\u001b[28Gone\u001b[32G4\u001b[34GKiB\u001b[38Gblock\u001b[44Gwhether\u001b[52Git\u001b[55Gholds\u001b[61G235\u001b[65Gbytes\u001b[71Gor\u001b[74Ga\u001b[76Gfew\u001b[80Grequests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, a batch averages under 500 bytes. It would only grow past 16 GB\u001b[77Gonce batches exceed 4 KiB,\u001b[104Gwhi\u001b[110Gis several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequ\u001b[18Gsts\u001b[22Ga s\u001b[26Gcond.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.242, "o", "\u001b]0;◐ jettison-0023\u0007"]
[0.224, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mThe real wear is higher than 16 GB.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfour\u001b[58Gmillion\u001b[66Gfiles\u001b[72Ga\u001b[74Gday\u001b[78Galso\u001b[83Gcosts\u001b[89Ga\u001b[91Gdirectory\u001b[101Gentry,\u001b[108Gan\u001b[111Ginode\u001b[117Gand\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.527, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mChanged:\u001b[22m batches are written after the steps have run, each request\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B \u001b[5Gare no longer held back.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR04:\u001b[22m still adds the snapshot\u001b[34Gand\u001b[38Greplay\u001b[45Gfrom\u001b[50Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay\u001b[7Ggo\u001b[10Gand\u001b[14GI'll\u001b[19Gmake\u001b[24Gthat\u001b[29Gthe\u001b[33Gstart\u001b[39Gof\u001b[42GR04,\u001b[47Gwith\u001b[52Gthe\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Gmeasured:\u001b[17GRelease\u001b[25Gserialise\u001b[35Gtime,\u001b[41Gand\u001b[45Gthe\u001b[49Greal\u001b[54Gsplit\u001b[60Gof\u001b[63Gthe\u001b[67G76\u001b[70GKB\u001b[73Gper\u001b[77Gplayer.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Groughly:\u001b[17Gabout\u001b[23G16\u001b[26GGB\u001b[29Ga\u001b[31Gday\u001b[35Gof\u001b[38Gfile\u001b[43Gblocks\u001b[50Gfor\u001b[54Gthe\u001b[58Gjournal\u001b[66Gitself,\u001b[74Gand\u001b[78Gthat\u001b[83Gfigure\u001b[90Gis\u001b[93Gthe\u001b[97Gsame\u001b[102Gwith\u001b[107G256\u001b[111Gplayers\u001b[119Gas\r\u001b[1B \u001b[3Gwith\u001b[8Gn\u001b[10Gne. Three qualifications\u001b[35Gmatter.\u001b[43G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, and each takes one 4 KiB block whether it holds 235 bytes or a few requests. A\u001b[92G my assumed\u001b[104G26 request\r\u001b[13C\u001b[1B batch averages under 500 bytes. It would \u001b[57Gnly\u001b[61Ggrow past\u001b[71G16\u001b[74GGB once batches\u001b[90Gexceed 4 KiB,\u001b[104Gwhich is several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequests a second.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[41G\u001b[22mEach\u001b[46Gof\u001b[49Gthe\u001b[53Gfour\u001b[58Gmillion\u001b[66Gfiles\u001b[72Ga\u001b[74Gday\u001b[78Galso\u001b[83Gcosts\u001b[89Ga\u001b[91Gdirectory\u001b[101Gentry,\u001b[108Gan\u001b[111Ginode\u001b[117Gand\r\u001b[2C\u001b[1B \u001b[5Gfilesystem-journal writes, forced out by\u001b[46Gabout 188 flushes a\u001b[66Gsecond.\u001b[74GI gues\u001b[81Ged two to\u001b[91Gfour \u001b[97Gimes, so 30–60 GB a\u001b[117Gday\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.106, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mR04:\u001b[22m still adds the snapshot\u001b[35Gnd \u001b[39Geplay from\u001b[50Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay go\u001b[10Gand I'll make that t\u001b[31Ge start of R04, with the\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[2BNot\u001b[7Gmeasured: Release serialise time, and the real split of th\u001b[66G 76 KB per player\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Yes, roughly: about 16 GB a day of file blocks for the journal itself, and that figure is the same with 256 players as\r\u001b[2C\u001b[1Bwith\u001b[8Gnone.\u001b[14GThree\u001b[20Gqualifications\u001b[35Gmatter.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[4C\u001b[1Bsecond,\u001b[13Gand\u001b[17Geach\u001b[22Gtakes\u001b[28Gone\u001b[32G4\u001b[34GKiB\u001b[38Gblock\u001b[44Gwhether\u001b[52Git\u001b[55Gholds\u001b[61G235\u001b[65Gbytes\u001b[71Gor\u001b[74Ga\u001b[76Gfew\u001b[80Grequests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, a batch averages under 500 bytes. It would only grow past 16 GB\u001b[77Gonce batches exceed 4 KiB,\u001b[104Gwhi\u001b[110Gis several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequ\u001b[18Gsts\u001b[22Ga s\u001b[26Gcond.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[22m Each of the four milli\u001b[64Gn\u001b[66Gfiles a\u001b[74Gday also costs a dir\u001b[95Gctory entry, an inode and\r\u001b[4C\u001b[1Bfilesystem-journal\u001b[24Gwrites,\u001b[32Gforced\u001b[39Gout\u001b[43Gby\u001b[46Gabout\u001b[52G188\u001b[56Gflushes\u001b[64Ga\u001b[66Gsecond.\u001b[74GI\u001b[76Gguessed\u001b[84Gtwo\u001b[88Gto\u001b[91Gfour\u001b[96Gtimes,\u001b[103Gso\u001b[106G30–60\u001b[112GGB\u001b[115Ga\u001b[117Gday\r\u001b[2C\u001b[1B \u001b[5Greaching the SSD; this is not measured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.103, "o", "\u001b]0;◑ jettison-0023\u0007"]
[0.338, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[60G\u001b[22mThe\u001b[64G16\u001b[67GGB\u001b[70Ga\u001b[72Gday\u001b[76Gaccumulates\u001b[88Guntil\u001b[94GR04\u001b[98Gadds\u001b[103Gretention,\u001b[114Gand\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.455, "o", "\u001b[?25l\u001b[H\u001b[3GSay go\u001b[10Gand I'll make that t\u001b[31Ge start of R04, with the\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[2BNot\u001b[7Gmeasured: Release serialise time, and the real split of th\u001b[66G 76 KB per player\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Yes, roughly: about 16 GB a day of file blocks for the journal itself, and that figure is the same with 256 players as\r\u001b[2C\u001b[1Bwith\u001b[8Gnone.\u001b[14GThree\u001b[20Gqualifications\u001b[35Gmatter.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mIt is flat because of block rounding, not because the journal is small.\u001b[77G\u001b[22mThe\u001b[81Gserver\u001b[88Gwrites\u001b[95Gabout\u001b[101G47\u001b[104Gbatch\u001b[110Gfiles\u001b[116Ga\r\u001b[4C\u001b[1Bsecond,\u001b[13Gand\u001b[17Geach\u001b[22Gtakes\u001b[28Gone\u001b[32G4\u001b[34GKiB\u001b[38Gblock\u001b[44Gwhether\u001b[52Git\u001b[55Gholds\u001b[61G235\u001b[65Gbytes\u001b[71Gor\u001b[74Ga\u001b[76Gfew\u001b[80Grequests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, a batch averages under 500 bytes. It would only grow past 16 GB\u001b[77Gonce batches exceed 4 KiB,\u001b[104Gwhi\u001b[110Gis several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequ\u001b[18Gsts\u001b[22Ga s\u001b[26Gcond.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[22m Each of the four milli\u001b[64Gn\u001b[66Gfiles a\u001b[74Gday also costs a dir\u001b[95Gctory entry, an inode and\r\u001b[4C\u001b[1Bfilesystem-journal\u001b[24Gwrites,\u001b[32Gfo