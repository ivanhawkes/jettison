[0.016, "o", "\u001b[?25l\u001b[H\u001b[5GLost in\u001b[13Ga\u001b[15Gcrash\u001b[40GUp to\u001b[50G \u001b[52G    \u001b[57G   \u001b[61G      \u001b[68G        \r\u001b[4C\u001b[2BRecovery \u001b[15G     \u001b[40GLoad the\u001b[50Gnapshot,\u001b[59Greplay\u001b[66Gup\u001b[69Gto\u001b[72Gan\u001b[75Ghour\u001b[80Gof\u001b[83Gbatches\r\u001b[2C\u001b[1B└\u001b[38G┴\u001b[99G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mKept from R03:\u001b[22m the batch files, catalogue, chain and replay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanged:\u001b[14G\u001b[22mbatches\u001b[22Gare\u001b[26Gwritten\u001b[34Gafter\u001b[40Gthe\u001b[44Gsteps\u001b[50Ghave\u001b[55Grun,\u001b[60Geach\u001b[65Grequest\u001b[73Grecorded\u001b[82Gwith\u001b[87Gthe\u001b[91Gstep\u001b[96Git\u001b[99Gran\u001b[103Gat,\u001b[107Gand\u001b[111Greceipts\r\u001b[2C\u001b[1B \u001b[5Gare no longer held\u001b[26Gck.\u001b[30G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mR04:\u001b[22m still adds the snapshot\u001b[35Gnd \u001b[39Geplay from\u001b[50Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSay go\u001b[10Gand I'll make that t\u001b[31Ge start of R04, with the\u001b[56Gflush\u001b[62Ginterval\u001b[71Gas\u001b[74Ga\u001b[76Gsetting.\r\u001b[2C\u001b[2BNot\u001b[7Gmeasured: Release serialise time, and the real split of th\u001b[66G 76 KB per player\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 1m 56s · done 10:10 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSo the current system would only need to write 16gb a day with 256 players?\u001b[39m                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
