[0.299, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│\u001b[5GLost\u001b[10Gin\u001b[13Ga\u001b[15Gcrash\u001b[21G│\u001b[23GNothing\u001b[31Gacknowledged\u001b[44G│\u001b[46GUp\u001b[49Gto\u001b[52G10\u001b[55Gs\u001b[86G│\u001b[88GUp\u001b[91Gto\u001b[94G30\u001b[97Gs\u001b[108G│\r\u001b[2C\u001b[1B├─────────────────┼──────────────────────┼─────────────────────────────────────────┼─────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GRecovery\u001b[21G│\u001b[23GReplay\u001b[30Gevery\u001b[36Gbatch\u001b[44G│\u001b[46GLoad\u001b[51Gone\u001b[55Gfile\u001b[86G│\u001b[88GLoad\u001b[93Gone\u001b[97Gfile\u001b[108G│\r\u001b[2C\u001b[1B└─────────────────┴──────────────────────┴─────────────────────────────────────────┴─────────────────────┘\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy the journal stays at 16 GB:\u001b[37G\u001b[22mit\u001b[40Gwrites\u001b[47Gwhat\u001b[52Ghappened,\u001b[62Gnot\u001b[66Gthe\u001b[70Gwhole\u001b[76Gworld,\u001b[83Gand\u001b[87Ga\u001b[89Gbatch\u001b[95Gwith\u001b[100Ga\u001b[102Gfew\u001b[106Grequests\u001b[115Gstill\r\u001b[2C\u001b[1B  fits one 4 KiB block.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy snapshots balloon:\u001b[28G\u001b[22mthey\u001b[33Grewrite\u001b[41Geverything every time. A t\u001b[68Gpical\u001b[74G600 TB-rated drive\u001b[93Gwould\u001b[99Glast\u001b[104Gunder\u001b[110Gtwo\u001b[114Gyears\r\u001b[2C\u001b[1B  at 10 s and about five at 30 s.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe pause:\u001b[22m at the Debug rate\u001b[34Gthe\u001b[38Gserialise step alone would\u001b[65Gbe\u001b[68Gabo\u001b[72Gt 1.5\u001b[78Gs per snap\u001b[89Ghot; Release\u001b[102Gis\u001b[105Gunmeasured.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat this means\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFreq\u001b[8Gent whole-world\u001b[24Gsnapshots\u001b[34Gare\u001b[38Gfine at\u001b[46Gtoday's size and w\u001b[65Gong at t\u001b[74Ge size\u001b[81Gyou\u001