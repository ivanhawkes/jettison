le or address the server could not take, or a \u001b[48;2;92;2;0mcommit\u001b[48;2;61;1;0m that failed.                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 197 +\u001b[38;2;248;248;242m    \u001b[38;2;117;113;94m// file or address the server could not take, or a \u001b[48;2;4;71;0mwrite\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mof the journal's \u001b[48;2;2;40;0mthat failed.\u001b[38;2;248;248;242m            \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m98\u001b[14G\u001b[22m  Jettison::Core::\u001b[38;2;166;226;46mLog\u001b[39m(Severity::Error,\u001b[53GkManifest,\u001b[64G\u001b[38;2;230;219;116m\"{}\"\u001b[39m,\u001b[70Gerror.\u001b[38;2;166;226;46mwhat\u001b[39m());\r\u001b[7C\u001b[1B\u001b[2m99\u001b[16G\u001b[22m\u001b[38;2;249;38;114mreturn\u001b[39m \u001b[38;2;190;132;255m1\u001b[39m;\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 200 \u001b[14G\u001b[22m}\u001b[27;1H\u001b[24;3H\u001b[?25h"]
