[0.174, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m6\u001b[9G\u001b[22mconst\u001b[15Gstd::string_view\u001b[32GkSdkRevision\u001b[45G=\u001b[47G\"@sdk@\";\r\u001b[6C\u001b[1B\u001b[2m7\u001b[9G\u001b[22m} // namespace Manif\u001b[30Gst::Host\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/project\u001b[19G/manifest/cmake/Revision.cmake)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m20\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1m~/projects/manifest/cmake/Revision.cmake\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m# Run at every build (source/game/host): writes OUT from IN with the trees the build is made from, so\r\u001b[1B\u001b[39m     \u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m# that two builds whose code differs never share an identity (D-111), a build from uncommitted\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;117;113;94mchanges included. A tree is git's own hash of\u001b[58Ga checkout's build inputs as they are on disk,\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[13G\u001b[22m\u001b[38;2;117;113;94mr\u001b[15Gcked or not,\u001b[28Gtaken\u001b[34Gin an \u001b[41Gnd\u001b[44Gx a\u001b[48Gd an\u001b[53Gobject stor\u001b[65G of the build tree's: the check\u001b[97Gut's own are\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[12G\u001b[22m\u001b[38;2;117;113;94mnot touched, an\u001b[28G the index kep\u001b[43G bet\u001b[48Geen builds means \u001b[66Gnly changed file\u001b[85Gre r\u001b[90Gad agai\u001b[98G. OUT is\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m6\u001b[12G\u001b[22m\u001b[38;2;117;113;94mrewritten o\u001b[24Gly when a\u001b[34Gtree has changed. GAME and SDK are\u001b[69Gdirectories anywhere inside each\u001b[102Gcheckout.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m7\u001b[10G\u001b[22m\u001b[38;2;102;217;239mfunction\u001b[39m(manifest_tree out checkout name)\u001b[K\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m    \u001b[38;2;249;38;114mset\u001b[39m(git \u001b[38;2;230;219;116m\"${CMAKE_COMMAND}\"\u001b[39m -E env \u001b[38;2;230;219;116m\"GIT_INDEX_FILE=${WORK}/${name}.index\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m        \u001b[38;2;230;219;116m\"GIT_OBJECT_DIRECTORY=${WORK}/${name}.objects\"\u001b[65G\"${GIT}\"\u001b[74G\u001b[39m-C\u001b[77G\u001b[38;2;230;219;116m\"${checkout}\"\u001b[39m)\r\u001b[6C\u001b[1B\u001b[2m10\u001b[14G\u001b[22m\u001b[38;2;249;38;114mfile\u001b[39m(\u001b[38;2;249;38;114mMAKE_DIRECTORY\u001b[39m \u001b[38;2;230;219;116m\"${WORK}/${name}.objects\"\u001b[39m)\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +10 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Working…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[75G\u001b[38;2;153;153;153m7\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
