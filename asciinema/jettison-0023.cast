[0.016, "o", "\u001b[?25l\u001b[H\u001b[5Gsecond,\u001b[13Gand\u001b[17Geach\u001b[22Gtakes\u001b[28Gone\u001b[32G4\u001b[34GKiB\u001b[38Gblock\u001b[44Gwhether\u001b[52Git\u001b[55Gholds\u001b[61G235\u001b[65Gbytes\u001b[71Gor\u001b[74Ga\u001b[76Gfew\u001b[80Grequests.\u001b[90GAt\u001b[93Gmy\u001b[96Gassumed\u001b[104G26\u001b[107Grequests\u001b[116Ga\r\u001b[2C\u001b[1B \u001b[5Gsecond, a batch averages under 500 bytes. It would only grow past 16 GB\u001b[77Gonce batches exceed 4 KiB,\u001b[104Gwhi\u001b[110Gis several\r\u001b[4C\u001b[1Bhundred\u001b[13Grequ\u001b[18Gsts\u001b[22Ga s\u001b[26Gcond.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe real wear is higher than 16 GB.\u001b[22m Each of the four milli\u001b[64Gn\u001b[66Gfiles a\u001b[74Gday also costs a dir\u001b[95Gctory entry, an inode and\r\u001b[4C\u001b[1Bfilesystem-journal\u001b[24Gwrites,\u001b[32Gforced\u001b[39Gout\u001b[43Gby\u001b[46Gabout\u001b[52G188\u001b[56Gflushes\u001b[64Ga\u001b[66Gsecond.\u001b[74GI\u001b[76Gguessed\u001b[84Gtwo\u001b[88Gto\u001b[91Gfour\u001b[96Gtimes,\u001b[103Gso\u001b[106G30–60\u001b[112GGB\u001b[115Ga\u001b[117Gday\r\u001b[2C\u001b[1B \u001b[5Greaching the SSD; this is not measured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR03 alone never deletes anything and has no snapshots.\u001b[22m The\u001b[64G16 GB a day\u001b[76Gaccumula\u001b[85Ges\u001b[88Guntil R04 adds\u001b[103Gretention, and\u001b[K\r\u001b[6C\u001b[1Bcovery\u001b[14Greplays from step 0.\u001b[35GWith an hourly\u001b[50Gsnapshot\u001b[59Gof\u001b[62Ga\u001b[64G110\u001b[68GMB\u001b[71Gworld,\u001b[78Gadd\u001b[82Gabout\u001b[88G2.6\u001b[92GGB\u001b[95Ga\u001b[97Gday.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo the current de\u001b[21Gign co\u001b[29Gs the\u001b[35Gsame\u001b[40Gheavy, con\u001b[51Gt\u001b[53Gnt amount regardless of loa\u001b[81G: it is as\u001b[92Gexpensive\u001b[102Gidle\u001b[107Gwith\u001b[112Gone\r\u001b[2C\u001b[1Bplayer\u001b[10Gas\u001b[13Gbusy\u001b[18Gwith\u001b[23G256.\u001b[28GThe\u001b[32G30-second\u001b[42Gflush\u001b[48Gdesign\u001b[55Gcosts\u001b[61Gabout\u001b[67G25\u001b[70GMB\u001b[73Ga\u001b[75Gday\u001b[79Gidle\u001b[84Gand\u001b[88Gabout\u001b[94G3.5\u001b[98GGB\u001b[101Ga\u001b[103Gday\u001b[107Gat\u001b[110G256\r\u001b[2C\u001b[1Bplayers, because it pays per r\u001b[34Gquest\u001b[40Grather\u001b[47Gthan per\u001b[56Gstep.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 12s · done 10:13 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mDoes this mean the journal would actually cause less write wear on an SSD when there are 256 players and need less \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mstorage?\u001b[39m                                                                                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
