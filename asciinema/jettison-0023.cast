6 +\u001b[38;2;117;113;94m// A batch is flushed early once it holds this many requests, so a flood cannot grow one without\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 47 +\u001b[38;2;117;113;94m// bound; a step adds at most a full queue to it.\u001b[38;2;248;248;242m                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 48 +\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m std::\u001b[38;2;166;226;46msize_t\u001b[38;2;248;248;242m kMaxBatchRequests = \u001b[38;2;190;132;255m4'096\u001b[38;2;248;248;242m;                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 49 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 50 \u001b[22m \u001b[38;2;249;38;114mconstexpr\u001b[39m std::\u001b[38;2;166;226;46msize_t\u001b[39m kChecksumBytes = \u001b[38;2;166;226;46msizeof\u001b[39m(std::\u001b[38;2;166;226;46muint64_t\u001b[39m);\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m\u001b[38;2;117;113;94m// The longest file of each kind read: nothing larger is one, so nothing larger is taken into memory.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 40 -\u001b[38;2;248;248;242m// A batch is at most a full queue of the largest payloads, \u001b[48;2;92;2;0m4\u001b[48;2;61;1;0m MiB, and\u001b[48;2;92;2;0m each request's names; a\u001b[48;2;61;1;0m         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 41 -\u001b[38;2;248;248;242m// content manifest is a few hundred KiB.                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m52\u001b[14G\u001b[38;2;117;113;94mA batch is at most \u001b[48;2;4;71;0mkMaxBatchRequests and \u001b[48;2;2;40;0ma \u001b[48;2;4;71;0mstep's \u001b[48;2;2;40;0mfu\u001b[67Gl queue of the larg\u001b[87Gst payloads, \u001b[48;2;4;71;0m21\u001