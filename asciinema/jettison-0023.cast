[0.155, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[10G\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m37 \u001b[22m \u001b[38;2;249;38;114mconstexpr\u001b[39m std::string_view\u001b[38GkIdentityName\u001b[52G=\u001b[54G\u001b[38;2;230;219;116m\"identity\"\u001b[39m;\r\u001b[5C\u001b[1B\u001b[2m 38 \u001b[11G\u001b[22m\u001b[38;2;249;38;114mconstexpr\u001b[21G\u001b[39mstd::string_view\u001b[38GkCatalogueName\u001b[53G=\u001b[55G\u001b[38;2;230;219;116m\"catalogue\"\u001b[39m;\r\u001b[6C\u001b[1B\u001b[2m39\u001b[11G\u001b[22m\u001b[38;2;249;38;114mco\u001b[14Gstexpr\u001b[39m std::string_view kJournalName\u001b[51G=\u001b[53G\u001b[38;2;230;219;116m\"journal\"\u001b[39m;\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 40 +\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m std::string_view kSnapshotsName = \u001b[38;2;230;219;116m\"snapshots\"\u001b[38;2;248;248;242m;                                               \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m41\u001b[11G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m42\u001b[11G\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m Jettison::Core::Category\u001b[46GkJournal{\u001b[38;2;230;219;116m\"journal\"\u001b[38;2;248;248;242m};\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 43 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 44 +\u001b[38;2;117;113;94m// The newest, and the one before it for a start to fall back to when the newest does not load.\u001b[38;2;248;248;242m        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 45 +\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m std::\u001b[38;2;166;226;46msize_t\u001b[38;2;248;248;242m kKeptSnapshots = \u001b[38;2;190;132;255m2\u001b[38;2;248;248;242m;                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 46 +\u001b[38;2;117;113;94m// A batch is flushed early once it holds this many requests, so a flood cannot grow one without\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 47 +\u001b[38;2;117;113;94m// bound; a step adds at most a full queue to it.\u001b[38;2;248;248;242m                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 48 +\u001b[38;2;249;38;114mconstexpr\u001b[38;2;248;248;242m std::\u001b[38;2;166;226;46msize_t\u001b[38;2;248;248;242m kMaxBatchRequests = \u001b[38;2;190;132;255m4'096\u001b[38;2;248;248;242m;                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 49 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 50 \u001b[22m \u001b[38;2;249;38;114mconstexpr\u001b[39m std::\u001b[38;2;166;226;46msize_t\u001b[39m kChecksumBytes = \u001b[38;2;166;226;46msizeof\u001b[39m(std::\u001b[38;2;166;226;46muint64_t\u001b[39m);\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m\u001b[38;2;117;113;94m// The longest file of each kind read: nothing larger is one, so nothing larger is taken into memory.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 40 -\u001b[38;2;248;248;242m// A batch is at most a full queue of the largest payloads, \u001b[48;2;92;2;0m4\u001b[48;2;61;1;0m MiB, and\u001b[48;2;92;2;0m each request's names; a\u001b[48;2;61;1;0m         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 41 -\u001b[38;2;248;248;242m// content manifest is a few hundred KiB.                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m52\u001b[14G\u001b[38;2;117;113;94mA batch is at most \u001b[48;2;4;71;0mkMaxBatchRequests and \u001b[48;2;2;40;0ma \u001b[48;2;4;71;0mstep's \u001b[48;2;2;40;0mfu\u001b[67Gl queue of the larg\u001b[87Gst payloads, \u001b[48;2;4;71;0m21\u001