[0.156, "o", "\u001b[?25l\u001b[H\u001b[3G│ Flushes                      │ About 188 per second │ 2 per 10 s               │ 2 per 30 s               │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a crash or power cut │ Nothing acknowledged │ Up to 10 s of everything │ Up to 30 s of everything │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Lost in a clean stop         │ Nothing              │ Nothing                  │ Nothing                  │\r\u001b[2C\u001b[1B├──────────────────────────────┼──────────────────────┼──────────────────────────┼──────────────────────────┤\r\u001b[2C\u001b[1B│ Recovery                     │ Replay every batch   │ Load one file            │ Load one file            │\r\u001b[2C\u001b[1B└──────────────────────────────┴──────────────────────┴──────────────────────────┴──────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6G10\u001b[9Gs\u001b[11Gcosts\u001b[17Gthree\u001b[23Gtimes\u001b[29Gthe\u001b[33Gwrites\u001b[40Gof\u001b[43G30\u001b[46Gs,\u001b[49Gand\u001b[53Gstill\u001b[59Ga\u001b[61Gquarter\u001b[69Gof\u001b[72Gwhat\u001b[77Gthe\u001b[81Gjournal\u001b[89Gwrites\u001b[96Gnow\u001b[100Gwith\u001b[105Gabout\u001b[111G1/900th\u001b[119Gof\r\u001b[2C\u001b[1Bthe flushe\u001b[14G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gwrite\u001b[13Gfigure\u001b[20Gscales\u001b[27Gwith\u001b[32Gthe\u001b[36Gsave's\u001b[43Gsize,\u001b[49Gwhich\u001b[55Gwill\u001b[60Ggrow\u001b[65Gas\u001b[68Gthe\u001b[72Gworld\u001b[78Gdoes:\u001b[84Ga\u001b[86G2\u001b[88GMB\u001b[91Gworld\u001b[97Gat\u001b[100G10\u001b[103Gs\u001b[105Gwould\u001b[111Gbe\u001b[114Gabout\r\u001b[2C\u001b[1B17 GB/day, back where the journal is today. That is\u001b[55Gthe main argument for 30 s over 10 s, or for\u001b[100Gmaking the\u001b[111Ginterval\u001b[120Ga\r\u001b[2C\u001b[1Bsetting.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gfigures\u001b[17Gare\u001b[21Garithmetic\u001b[32Gfrom\u001b[37Gthe\u001b[41Gone\u001b[45Gmeasured\u001b[54Gsave\u001b[59Gsize;\u001b[65Gfilesystem\u001b[76Goverhead\u001b[85Gand\u001b[89Gthe\u001b[93Gpause\u001b[99Ga\u001b[101Gsnapshot\u001b[110Gcauses\u001b[117Gin\r\u001b[2C\u001b[1Bt\u001b[6G step loop\u001b[21Gst\u001b[24Gll unmeasured.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 8s · done 10:07 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0023 ─\r\u001b[1B\u001b[39m❯ try and gues how much data we would be saving if there were 256 players and enough worlds and trades scaled up from\u001b[K\r\u001b[1B  w\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
