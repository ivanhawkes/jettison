[0.001, "o", "\u001b[?25l\u001b[H\u001b[3GSo against frequent snapshots the current journal wears the SSD far less at that\u001b[84Gsize.\u001b[90GThe\u001b[94Gcrossover\u001b[104Gis\u001b[107Ga\u001b[109Gworld\u001b[115Gof\r\u001b[2C\u001b[1Broughly 6–20 MB, which\u001b[26Gu\u001b[28Gder my ass\u001b[39Gmp\u001b[42Gi\u001b[44Gns is s\u001b[52Gmewhere around 15–50 players.\u001b[82GBelow\u001b[88Gthat,\u001b[94G30-second\u001b[104Gsnapshots\u001b[114Gwrite\r\u001b[2C\u001b[1Bless; above it, the journal does.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStorage held on disk at any moment:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B┌───────────────────────────────────────────────────────────┬──────────────┐\u001b[80G\u001b[K\r\u001b[2C\u001b[1B│     \u001b[10G   \u001b[14G      \u001b[21G  \u001b[24G      Design\u001b[37G   \u001b[41G    \u001b[46G          \u001b[63G│\u001b[68GSpace\u001b[78G│\r\u001b[2C\u001b[1B├───────────────────────────────────────────────────────────┼──────────────┤\r\u001b[2C\u001b[1B│ Snapshot only (two kept) \u001b[31G     \u001b[37G   \u001b[41G       \u001b[49G   \u001b[53G  \u001b[56G    \u001b[61G  │ Abou\u001b[71G220 MB │\u001b[K\r\u001b[2C\u001b[1B├───────────────────────────────────────────────────────────┼──────────────┤\u001b[K\r\u001b[2C\u001b[1B│ Current journal (two\u001b[26Gsnapshots\u001b[36Gplus\u001b[41Gtwo\u001b[45Ghours\u001b[51Gof\u001b[54Gbatches)\u001b[63G│\u001b[65GAbout\u001b[71G1.6\u001b[75GGB\u001b[78G│\r\u001b[2C\u001b[1B├───────────────────────────────────────────────────────────┼──────────────┤\r\u001b[2C\u001b[1B│ Journal flushed\u001b[21Gevery 30 s\u001b[32G(same rete\u001b[43Gtion)\u001b[49G          \u001b[60G   │ About\u001b[71G300 MB │\u001b[K\r\u001b[2C\u001b[1B└───────────────────────────────────────────────────────────┴──────────────┘\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gjournal\u001b[15Galways\u001b[22Gneeds\u001b[28Ga\u001b[30Gsnapshot\u001b[39Gto\u001b[42Gstart\u001b[48Gfrom\u0