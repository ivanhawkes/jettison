eep this model at\u001b[49Ghigh effort, and\u001b[66Gsta\u001b[70Gt\u001b[72Git\u001b[75Gin a fresh session; \u001b[96Ghe ha\u001b[102Gdo\u001b[105Gf is in\u001b[K\r\u001b[2C\u001b[1B  Manif\u001b[11Gst'\u001b[15G \u001b[38;2;177;185;249mdocs/session-handoff.md\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Gdone\u001b[12Gor\u001b[15Gnot\u001b[19Gchecked:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gkill\u001b[12Gat\u001b[15Geach\u001b[20Gexact\u001b[26Gcommit\u001b[33Gboundary\u001b[42Gin\u001b[45Ga\u001b[75GR04;\u001b[80G\u001b[38;2;177;185;249mcli_serve\u001b[90G\u001b[39mkills\u001b[96Gbetween\u001b[104Gsteps\u001b[110Gonly.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[2.831, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GAn idle\u001b[13Gserver wri\u001b[24Ges\u001b[27Gabout\u001b[33G47 files a\u001b[44Gsecond:\u001b[52Groughly\u001b[60G16\u001b[63GGB\u001b[66Gof\u001b[69G4\u001b[71GKiB\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\r\u001b[4C\u001b[1Bremoves\u001b[13Ga\u001b[15Gbatch\u001b[21Guntil\u001b[27GR04's\u001b[33Gretention.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BShould an idle ser\u001b[22Ger commit a second's\u001b[43Gsteps ahead i\u001b[57Gstead of every 21 ms?\u001b[79GThat wo\u001b[87Gld cut it to one file a second,\u001b[K\r\u001b[3C\u001b[1But a request arriving mid-second\u001b[37Gwould\u001b[43Gwait\u001b[48Gfor\u001b[52Gthe\u001b[56Gnext\u001b[61Gcommit.\u001b[69GI\u001b[71Gleft\u001b[76Git\u001b[79Gas\u001b[82Gmeasured,\u001b[92Gsince\u001b[98Gthe\u001b[102Gplan\u001b[107Gsays\u001b[112Gmeasure\r\u001b[2C\u001b[1Bbefore\u001b[10Gchanging\u001b[19Gthe\u001b[23Gprotocol.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAny edit unde\u001b[19G \u001b[38;2;177;185;249msource\u001b[27G\u001b[39mor\u001b[30G\u001b[38;2;177;185;249mcmake\u001b[36G\u001b[39mmakes\u001b[42Ga\u001b[44Gworld\u001b[50Gfrom\u001b[55Gthe\u001b[59Gprevious\u001b[68Gbuild\u001b[74Gunopenable,\u001b[86Gby\u001b[89Gdesign\u001b[96Gof\u001b[99GD-111;\u001b[106Gdelete\u001b[113Gthe\r\u001b[2C\u001b[1B \u001b[5Gworld direct\u001b[18Gry.\u001b[K\r\u001b[4C\u001b[1BJ\u001b[7Gt\u001b[9Gison's roadmap and history are updated\u001b[48Gi\u001b[50G \u001b[38;2;177;185;249m487915c\u001b[39m, d\u001b[62Gcs only, s\u001b[73G no engine gate was run.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNext is R04: boundary snapshots, retention and replay from a\u001b[67Gn\u001b[69Gpsho\u001b[74G. It is design-heavy\u