[0.137, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/cmake/Revision.cmake)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m20\u001b[22m lines to \u001b[1m~/projects/manifest/cmake/Revision.cmake\r\u001b[1B\u001b[22m     \u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m# Run at every build (source/game/host): writes OUT from IN with the trees the build is made from, so\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m2\u001b[12G\u001b[22m\u001b[38;2;117;113;94mthat \u001b[18Gwo builds whose cod\u001b[38G differs never share an\u001b[62Gidentity (D-111), a build from uncom\u001b[99Gitted\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;117;113;94mc\u001b[15Gnges inclu\u001b[26Ged. A tree is git's own hash of a checkout's\u001b[71Gbuild inputs as they are \u001b[97Gn disk,\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m4\u001b[12G\u001b[22m\u001b[38;2;117;113;94mtr\u001b[15Gck\u001b[18Gd\u001b[20Gor not, taken in\u001b[37Gan\u001b[40Gindex\u001b[46Gand\u001b[50Gan object\u001b[60Gstore of the build tree's:\u001b[90G check\u001b[97Gut's own are\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[12G\u001b[22m\u001b[38;2;117;113;94mnot touched, and th\u001b[32G index kept between builds means only changed fil\u001b[82Gs are r\u001b[90Gad again. OUT is\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m\u001b[38;2;117;113;94mrewritten only when a tr\u001b[37Ge\u001b[39Ghas chang\u001b[49Gd.\u001b[52GGAME and SDK\u001b[65Gare directories anywh\u001b[87Gre inside each checkout.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m7\u001b[10G\u001b[22m\u001b[38;2;102;217;239mfunction\u001b[39m(manifest_tree out checkout name)\u001b[K\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m    \u001b[38;2;249;38;114mset\u001b[39m(git \u001b[38;2;230;219;116m\"${CMAKE_COMMAND}\"\u001b[39m -E env \u001b[38;2;230;219;116m\"GIT_INDEX_FILE=${WORK}/