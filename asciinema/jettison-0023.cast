[0.474, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 108 +\u001b[38;2;248;248;242m    \u001b[38;2;249;38;114mreturn\u001b[38;2;248;248;242m m_catalogue.head;                                                                          \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 109 \u001b[22m   }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 110 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m  73 -\u001b[38;2;248;248;242m  // Takes every committed batch's steps in a world as Host::Start left it, its requests run where    \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  74 -\u001b[38;2;248;248;242m  // they first ran, so the world and its request ledger are as the journal's last step left them.    \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m75\u001b[17G\u001b[38;2;248;248;242mA batch written\u001b[33Gbut\u001b[37Gnever named by the catal\u001b[62Ggue is\u001b[69Gn\u001b[71Gt\u001b[73Gru\u001b[76G. Throws\u001b[85Gstd::runtime_error\u001b[104Gnaming\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  76 -\u001b[38;2;248;248;242m  // the file for a batch that is missing, damaged or not the next in the chain; the world is then    \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  77 -\u001b[38;2;248;248;242m  // part-way through the journal and is discarded.                                                   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  78 -\u001b[38;2;248;248;242m  void Replay(Jettison::Sim::SimWorld &world) const;                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 111 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Brings a world as Host::Start left it to the journal's last flushed step: the newest snapshot\u001b[38;2;248;248;242m    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m12\u001b[14G\u001b[38;2;117;113;94m// that loads, or the one before it, or the world's own start while every batch is still kept,\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 113 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// then each batch after it, its requests run at the steps they first ran at. The request ledger\u001b[38;2;248;248;242m    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 114 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// is the snapshot's and the replay's, so a retry is answered as before the stop. Throws\u001b[38;2;248;248;242m            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 115 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// std::runtime_error naming the file when no snapshot loads, or for a batch that is missing,\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 116 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// damaged or not the next in the chain; the world is then part-way and is discarded.\u001b[38;2;248;248;242m               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 117 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mvoid\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mRecover\u001b[38;2;253;151;31m(Jettison::Sim::SimWorld &world)\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m;                                                 \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 118 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m80\u001b[17G\u001b[38;2;248;248;242mCommits the next\u001b[34Gst\u001b[37Gps of the world, at least one,\u001b[68Gfrom\u001b[73Gthe\u001b[77Gstep\u001b[82Gits\u001b[86Gclock\u001b[92Gis\u001b[95Gat,\u001b[99Gwith\u001b[104Gthe\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m81\u001b[14G\u001b[38;2;248;248;242m// requests queued on it: nothing else may be queued.\u001b[68GReturns\u001b[76Gonce\u001b[81Gboth\u001b[86Gfiles\u001b[92Gare\u001b[96Gon\u001b[99Gthe\u001b[103Gdisk;\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  82 -\u001b[38;2;248;248;242m  // until then no request of the b\u001b[76Gtep of it taken. A failure throws     \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.444, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m12\u001b[14G\u001b[38;2;117;113;94m// that loads, or the one before it, or the world's own start while every batch is still kept,\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 113 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// then each batch after it, its requests run at the steps they first ran at. The request ledger\u001b[38;2;248;248;242m    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 114 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// is the snapshot's and the replay's, so a retry is answered as before the stop. Throws\u001b[38;2;248;248;242m            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 115 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// std::runtime_error naming the file when no snapshot loads, or for a batch that is missing,\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 116 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// damaged or not the next in the chain; the world is then part-way and is discarded.\u001b[38;2;248;248;242m               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 117 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mvoid\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mRecover\u001b[38;2;253;151;31m(Jettison::Sim::SimWorld &world)\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m;                                                 \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 118 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m80\u001b[17G\u001b[38;2;248;248;242mCommits the next\u001b[34Gst\u001b[37Gps of the world, at least one,\u001b[68Gfrom\u001b[73Gthe\u001b[77Gstep\u001b[82Gits\u001b[86Gclock\u001b[92Gis\u001b[95Gat,\u001b[99Gwith\u001b[104Gthe\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m81\u001b[14G\u001b[38;2;248;248;242m// requests queued on it: nothing else may be queued.\u001b[68GReturns\u001b[76Gonce\u001b[81Gboth\u001b[86Gfiles\u001b[92Gare\u001b[96Gon\u001b[99Gthe\u001b[103Gdisk;\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  82 -\u001b[38;2;248;248;242m  // until then no request of the batch is acknowledged and no step of it taken. A failure throws     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  83 -\u001b[38;2;248;248;242m  // what the writer threw and leaves the commit uncertain, since the catalogue may already name      \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  84 -\u001b[38;2;248;248;242m  // the batch: the journal then refuses every later commit with std::logic_error, and the next       \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  85 -\u001b[38;2;248;248;242m  // opening finds which it was. Throws std::logic_error too for a world not at the step the          \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  86 -\u001b[38;2;248;248;242m  // journal ends at.                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m  87 -\u001b[38;2;248;248;242m  void Commit(Jettison::Sim::SimWorld &world, std::uint64_t steps);                                   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m9\u001b[14G\u001b[38;2;117;113;94m// Takes the world's next steps, the requests queued on it running at the start of the first, and\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 120 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// writes a batch or a snapshot when one is due. Nothing but requests may be queued. A write that\u001b[38;2;248;248;242m   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 121 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// fails throws what the writer threw and leaves the files uncertain, since the catalogue may\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 122 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// already name what was written: the journal then refuses every later call with\u001b[38;2;248;248;242m                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 123 +\u00