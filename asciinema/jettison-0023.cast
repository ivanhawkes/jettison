[0.313, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bthe\u001b[9Gcatalogue\u001b[19Gto\u001b[22Gfind\u001b[27Gwhat\u001b[32Gwas\u001b[36Gcommitted.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1m--serve\u001b[13G\u001b[39mnow requires \u001b[38;2;177;185;249m--world <directory>\u001b[39m:\u001b[22m it makes the world there,\u001b[73Gor repl\u001b[81Gys\u001b[84Gthe committed batche\u001b[106Gfrom\u001b[111Gthe first\r\u001b[4C\u001b[1Bstep.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mBui\u001b[9Gd identi\u001b[18Gy:\u001b[22m a world opens only for the build\u001b[54Gand content that made it. The build\u001b[90Gis\u001b[93Gnamed by git's\u001b[108Gtree has\u001b[117G of\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource\u001b[39m, \u001b[38;2;177;185;249mcmake\u001b[39m, \u001b[38;2;177;185;249mCMakeLists.txt\u001b[39m and\u001b[39G\u001b[38;2;177;185;249mCMakePresets.json\u001b[39m as they\u001b[65Gare\u001b[69Gon\u001b[72Gdisk,\u001b[78Gtaken\u001b[84Gat\u001b[87Gevery\u001b[93Gbuild.\r\u001b[2C\u001b[2BTests cover a replay matching the live world's state\u001b[56Ghash\u001b[61Gand\u001b[65Grequest\u001b[73Goutcomes,\u001b[83Ga\u001b[85Gwrite\u001b[91Gfailing\u001b[99Gat\u001b[102Geach\u001b[107Gof\u001b[110Gthe\u001b[114Gthree\r\u001b[2C\u001b[1Bcommit\u001b[10Gboundaries,\u001b[22Gdamaged\u001b[30Gor\u001b[33Gmissing\u001b[41Gfiles,\u001b[48Gand\u001b[52Ga\u001b[54Gserver\u001b[61Gkilled\u001b[68Gwith\u001b[73GSIGKILL\u001b[81Gand\u001b[85Grestarted\u001b[95Gon\u001b[98Gits\u001b[102Gworld.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I departed from the plan (recorded as D-112, yours to review)\u001b[71G\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA batch is a run of steps, not one step.\u001b[46G\u001b[22mA\u001b[48Gslow\u001b[53Gdisk\u001b[58Gthen\u001b[63Gholds\u001b[69Gthe\u001b[73Gworld\u001b[79Gback\u001b[84Gby\u001b[87Gputting\u001b[95Gmore\u001b[100Gsteps\u001b[106Gin\u001b[109Ga\u001b[111Gbatch,\r\u0