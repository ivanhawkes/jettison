[0.111, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mFailure:\u001b[22m a com\u001b[20Git that fails\u001b[34Gstops the server with nothing of \u001b[68Ghat\u001b[72Gbatch\u001b[78Gacknowledged or run; the next\u001b[108Gstart\u001b[114Greads\r\u001b[4C\u001b[1Bthe catalogue to find what was committed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1m--serve\u001b[39m now requires \u001b[38;2;177;185;249m--world <directory>\u001b[39m:\u001b[47G\u001b[22mit\u001b[50Gmakes\u001b[56Gthe\u001b[60Gworld\u001b[66Gthere,\u001b[73Gor\u001b[76Greplays\u001b[84Gthe\u001b[88Gcommitted\u001b[98Gbatches\u001b[106Gfrom\u001b[111Gthe\u001b[115Gfirst\r\u001b[1B \u001b[3G  step.\u001b[K\r\u001b[1B  - \u001b[1mBuild identity:\u001b[21G\u001b[22ma w\u001b[25Grl\u001b[29Gopens only\u001b[40Gfor\u001b[44Gthe\u001b[48Gbuild\u001b[54Gand\u001b[58Gcontent\u001b[66Gthat\u001b[71Gmade\u001b[76Git.\u001b[80GThe\u001b[84Gbuild\u001b[90Gis\u001b[93Gnamed\u001b[99Gby\u001b[102Ggit's\u001b[108Gtree\u001b[113Ghash\u001b[118Gof\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource\u001b[39m, \u001b[38;2;177;185;249mcmake\u001b[39m,\u001b[20G\u001b[38;2;177;185;249mCMakeLists.txt\u001b[39m and \u001b[38;2;177;185;249mCMakePresets.json\u001b[57G\u001b[39mas th\u001b[63Gy are on\u001b[72Gd\u001b[74Gsk, taken at every build.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTests cover a r\u001b[19Gplay matching the live world's state h\u001b[58Gsh\u001b[61Gand request outcomes, a write\u001b[91Gfailing\u001b[99Gat e\u001b[104Gch\u001b[107Gof\u001b[110Gthe\u001b[114Gthree\r\u001b[2C\u001b[1Bcommit boundaries, damaged or missing files, and a server killed with SIGKILL and restarted on its world.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I departed from the plan (recorded as D-112, yours to review)\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA batch is a run of steps, not one step.\u001b[22m A slow disk\u001b[58Gthen holds the world ba\u001b[82Gk by putting more steps in a batch,\r\u001b[4C\u001b[1Bwith no\u001b[13Gque\u001b[17Ge of batch\u001b[28Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReplay from the first step is in R03\u001b[22m,\u001b[43Gthough the deliv\u001b[60Gry or\u001b[66Ger gives startup\u001b[83Greplay to R04.\u001b[98GA\u001b[100Gjournal\u001b[108Gnothing\u001b[116Ghas\r\u001b[4C\u001b[1Bread proves little; R04 starts it from a snapshot\u001b[55Ginstead.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mMeasured (Debug, no client, 20 s on Lythir's NVMe)\u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G1,194\u001b[11Gsteps\u001b[17Gin\u001b[20G931\u001b[24Gbatches,\u001b[33Gabout\u001b[39G11\u001b[42Gms\u001b[45Ga\u001b[47Gcommit,\u001b[55Gno\u001b[58Gtime\u001b[63Gdropped.\r\u001b[1B \u001b[3G- An idle server writes about 47 files a second:\u001b[52Groughly\u001b[60G16\u001b[63GGB\u001b[66Gof\u001b[69G4\u001b[71GKiB\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.103, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mBu\u001b[9Gd identity:\u001b[22m a\u001b[23Gworld opens only\u001b[40Gfor\u001b[44Gthe build and content that made it. The build is named\u001b[99Gby git's\u001b[108Gtree hash of\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource\u001b[39m, \u001b[38;2;177;185;249mcmake\u001b[39m, \u001b[38;2;177;185;249mCMakeLists.txt\u001b[39m and \u001b[38;2;177;185;249mCMakePresets.json\u001b[57G\u001b[39mas\u001b[60Gthey\u001b[65Gare\u001b[69Gon\u001b[72Gdisk,\u001b[78Gtaken\u001b[84Gat\u001b[87Gevery\u001b[93Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTe\u001b[7Gs cover\u001b[15Ga\u001b[17Greplay\u001b[24Gmatching\u001b[33Gthe\u001b[37Glive\u001b[42Gworld's\u001b[50Gstate\u001b[56Ghash\u001b[61Gand\u001b[65Grequest\u001b[73Goutcomes,\u001b[83Ga\u001b[85Gwrite\u001b[91Gfailing\u001b[99Gat\u001b[102Geach\u001b[107Gof\u001b[110Gthe\u001b[114Gthree\r\u001b[2C\u001b[1Bcommit boundaries, damaged or missing files,\u001b[48Gand a\u001b[54Gserver killed with SIGKILL and restarted on its\u001b[102Gworld.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I departed from the plan (recorded as D-112, yours to review)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mA batch is a run of steps, not one step.\u001b[22m A\u001b[48Gslow disk then hol\u001b[67Gs the\u001b[73Gworld back by putting\u001b[95Gmore \u001b[101Gteps in\u001b[109Ga\u001b[111Gbatch,\r\u001b[4C\u001b[1Bwith\u001b[10Gno\u001b[13Gqueue\u001b[19Gof\u001b[22Gbatches.\r\u001b[2C\u001b[1B- \u001b[1mReplay from the firs\u001b[26G step is in R03\u001b[22m, though the delivery order gives\u001b[75Gstartup\u001b[83Greplay\u001b[90Gto\u001b[93GR04.\u001b[98GA\u001b[100Gjournal\u001b[108Gnothing\u001b[116Ghas\r\u001b[4C\u001b[1Bread\u001b[10Gproves\u001b[17Glittle;\u001b[25GR04\u001b[29Gstarts\u001b[36Git\u001b[39Gfrom\u001b[44Ga\u001b[46Gsnapshot\u001b[55Ginstead.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured (Debug, no client, 20 s on Lythir's NVMe)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G1,194 step\u001b[17Gin 931 batches, abou\u001b[39G11 \u001b[43Gs a commit,\u001b[55Gno \u001b[59Gime dropped.\r\u001b[2C\u001b[1B-\u001b[5GAn\u001b[8Gidle\u001b[13Gserver\u001b[20Gwrites\u001b[27Gabout\u001b[33G47\u001b[36Gfiles\u001b[42Ga\u001b[44Gsecond:\u001b[52Groughly\u001b[60G16\u001b[63GGB\u001b[66Gof\u001b[69G4\u001b[71GKiB\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\r\u001b[2C\u001b[1B  removes a batch until R04's retention.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mDecision for you\u001b[20G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.357, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249msource\u001b[39m, \u001b[38;2;177;185;249mcmake\u001b[39m, \u001b[38;2;177;185;249mCMakeLists.txt\u001b[35G\u001b[39ma\u001b[37Gd \u001b[38;2;177;185;249mCMakePresets.json\u001b[39m as th\u001b[63Gy are on disk, taken\u001b[84Gat every\u001b[93Gbuil\u001b[98G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTests\u001b[9Gcover\u001b[15Ga\u001b[17Greplay\u001b[24Gmatching\u001b[33Gthe\u001b[37Glive\u001b[42Gworld's\u001b[50Gstate\u001b[56Ghash\u001b[61Gand\u001b[65Grequest\u001b[73Goutcomes,\u001b[83Ga\u001b[85Gwrite\u001b[91Gfailing\u001b[99Gat\u001b[102Geach\u001b[107Gof\u001b[110Gthe\u001b[114Gthree\r\u001b[2C\u001b[1Bcommit bound\u001b[16Gri\u001b[19Gs, da\u001b[26Gged or\u001b[33Gmissing files, and \u001b[53G server\u001b[61Gkilled with\u001b[73GSIGKILL and\u001b[85Gres\u001b[89Garted o\u001b[97G its\u001b[102Gworld.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I departed from the plan (recorded as D-112, yours to review)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA batch is a run of steps, not one step.\u001b[46G\u001b[22mA\u001b[48Gslow\u001b[53Gdisk\u001b[58Gthen\u001b[63Gholds\u001b[69Gthe\u001b[73Gworld\u001b[79Gback\u001b[84Gby\u001b[87Gputting\u001b[95Gmore\u001b[100Gsteps\u001b[106Gin\u001b[109Ga\u001b[111Gbatch,\r\u001b[2C\u001b[1B \u001b[5Gwith no queue of batches.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReplay from the first step is in R03\u001b[22m,\u001b[43Gthough\u001b[50Gthe\u001b[54Gdelivery\u001b[63Gorder\u001b[69Ggives\u001b[75Gstartup\u001b[83Greplay\u001b[90Gto\u001b[93GR04.\u001b[98GA\u001b[100Gjournal\u001b[108Gnothing\u001b[116Ghas\r\u001b[2C\u001b[1B \u001b[5Gread proves little; R04 starts it from a snaps\u001b[52Got inst\u001b[60Gad.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured (Debug, no client, 20 s on Lythir's NVMe)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2