[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA batch\u001b[13Gis a run of steps, not one step.\u001b[22m A slow disk then holds the\u001b[73Gworld b\u001b[81Gck\u001b[84Gby putting more step\u001b[106Gin a\u001b[111Gbatch,\u001b[K\r\u001b[4C\u001b[1Bwith no\u001b[13Gqueue\u001b[19Gof\u001b[22Gbatches.\r\u001b[4C\u001b[1B\u001b[1mRep\u001b[9Gay from \u001b[18Ghe first step is in R03\u001b[22m, though the\u001b[54Gdelivery order gives startup replay\u001b[90Gto\u001b[93GR04. A journal\u001b[108Gnothing \u001b[117Gas\u001b[K\r\u001b[4C\u001b[1Bread proves little; R04 starts it\u001b[39Gfrom a snapshot instead.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mMeasured (Debug, no client, 20 s on Lythir's NVMe)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G1,194\u001b[11Gsteps\u001b[17Gin\u001b[20G931\u001b[24Gbatches,\u001b[33Gabout\u001b[39G11\u001b[42Gms\u001b[45Ga\u001b[47Gcommit,\u001b[55Gno\u001b[58Gtime\u001b[63Gdropped.\r\u001b[2C\u001b[1B- An idle server writes about 47 files a second: roughly 16 GB of 4\u001b[71GKiB\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\r\u001b[4C\u001b[1Bremoves\u001b[13Ga\u001b[15Gbatch\u001b[21Guntil\u001b[27GR04's\u001b[33Gretention.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShoul\u001b[10Gan idle serv\u001b[23Gr\u001b[25Gcommi\u001b[31G a \u001b[35Gecond's steps ahead\u001b[62G of\u001b[66Gevery\u001b[72G21\u001b[75Gms?\u001b[79GThat\u001b[84Gwould\u001b[90Gcut\u001b[94Git\u001b[97Gto\u001b[100Gone\u001b[104Gfile\u001b[109Ga\u001b[111Gsecond,\r\u001b[2C\u001b[1Bbut\u001b[7Ga\u001b[9Grequest\u001b[17Garriving\u001b[26Gmid-second\u001b[37Gwould\u001b[43Gwait\u001b[48Gfor\u001b[52Gthe\u001b[56Gnext\u001b[61Gcommit.\u001b[69GI\u001b[71Gleft\u001b[76Git\u001b[79Gas\u001b[82Gmeasured,\u001b[92Gsince\u001b[98Gthe\u001b[102Gplan\u001b[107Gsays\u001b[112Gmeasure\r\u001b[2C\u001b[1Bbefore changing the protocol.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G  \u001b[8G    \u001b[13G      \u001b[20G      \u001b[27G     \u001b[33G  \u001b[36G     \u001b[42G \u001b[44G   \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
