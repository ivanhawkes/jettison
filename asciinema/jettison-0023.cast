[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  the catalogue\u001b[19Gto find what was committed.\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1m--serve\u001b[39m now requires \u001b[38;2;177;185;249m--world <directory>\u001b[39m:\u001b[47G\u001b[22mit\u001b[50Gmakes\u001b[56Gthe\u001b[60Gworld\u001b[66Gthere,\u001b[73Gor\u001b[76Greplays\u001b[84Gthe\u001b[88Gcommitted\u001b[98Gbatches\u001b[106Gfrom\u001b[111Gthe\u001b[115Gfirst\r\u001b[4C\u001b[1Bstep.\r\u001b[2C\u001b[1B- \u001b[1mBuild id\u001b[14Gnt\u001b[17Gty:\u001b[22m a world opens only\u001b[40Gfor\u001b[44Gthe\u001b[48Gbuild\u001b[54Gand\u001b[58Gcontent\u001b[66Gthat\u001b[71Gmade\u001b[76Git.\u001b[80GThe\u001b[84Gbuild\u001b[90Gis\u001b[93Gnamed\u001b[99Gby\u001b[102Ggit's\u001b[108Gtree\u001b[113Ghash\u001b[118Gof\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource\u001b[39m,\u001b[13G\u001b[38;2;177;185;249mcmake\u001b[39m,\u001b[20G\u001b[38;2;177;185;249mCMakeLists.txt\u001b[35G\u001b[39mand\u001b[39G\u001b[38;2;177;185;249mCMakePresets.json\u001b[57G\u001b[39mas\u001b[60Gthey\u001b[65Gare\u001b[69Gon\u001b[72Gdisk,\u001b[78Gtaken\u001b[84Gat\u001b[87Gevery\u001b[93Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTests\u001b[9Gcover a replay matching the\u001b[37Glive\u001b[42Gworld's\u001b[50Gstate\u001b[56Ghash\u001b[61Gand\u001b[65Grequest\u001b[73Goutcomes,\u001b[83Ga\u001b[85Gwrite\u001b[91Gfailing\u001b[99Gat\u001b[102Geach\u001b[107Gof\u001b[110Gthe\u001b[114Gthree\r\u001b[2C\u001b[1Bcommit boundaries,\u001b[22Gdamaged or missing\u001b[41Gfil\u001b[45Gs, and\u001b[52Ga server killed wit\u001b[73GSIGKILL and re\u001b[88Gtarted\u001b[95Gon its world.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere I departed from the plan (recorded as D-112, yours to review)\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA batch\u001b[13Gis a run of steps, not one step.\u001b[22m A slow disk then holds the\u001b[73Gworld b\u001b[81Gck\u001b[84Gby putting more step\u001b[106Gin a\u001b[111Gbatch,\u001b[K\r\u001b[4C\u001b[1Bwith no\u001b[13Gqueue\u001b[19Gof\u001b[22Gbatches.\r\u001b[4C\u001b[1B\u001b[1mRep\u001b[9Gay from \u001b[18Ghe first step is in R03\u001b[22m, though the\u001b[54Gdelivery order gives startup replay\u001b[90Gto\u001b[93GR04. A journal\u001b[108Gnothing \u001b[117Gas\u001b[K\r\u001b[4C\u001b[1Bread proves little; R04 starts it\u001b[39Gfrom a snapshot instead.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mMeasured (Debug, no client, 20 s on Lythir's NVMe)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G1,194\u001b[11Gsteps\u001b[17Gin\u001b[20G931\u001b[24Gbatches,\u001b[33Gabout\u001b[39G11\u001b[42Gms\u001b[45Ga\u001b[47Gcommit,\u001b[55Gno\u001b[58Gtime\u001b[63Gdropped.\r\u001b[2C\u001b[1B- An idle server writes about 47 files a sec\u001b[75Gblocks\u001b[82Gand\u001b[86Gfour\u001b[91Gmillion\u001b[99Gfiles\u001b[105Ga\u001b[107Gday.\u001b[112GNothing\u001b[27;1H\u001b[24;3H\u001b[?25h"]
