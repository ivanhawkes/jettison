[0.005, "o", "\u001b[H\r\u001b[10B←  ☒ Slow burn \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Policy goal \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mWhat should a standing\u001b[24Gtrade policy optimise when it\u001b[54Gp\u001b[56Gcks a burn?\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[2B\u001b[38;2;177;185;249mPer hour, \u001b[17Gverride (Recommended)\r\u001b[6C\u001b[1B\u001b[38;2;153;153;153my def\u001b[13Gult it picks the trade and b\u001b[42Grn making\u001b[52Gthe most per\u001b[65Ghour of the\u001b[77Gjob, fuel and\u001b[91Gtransit\u001b[99Glife support co\u001b[115Gnted;\r\u001b[5C\u001b[1Bthe player can fix a bu\u001b[30Gn sha\u001b[36Ge on the policy\u001b[52Ginstead.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[6G\u001b[39mPer run\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;153;153;153mThe most profit per job, whatever the time, which nearly always means the slowest burn.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[39mPlayer sets it\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mNo automa\u001b[16Gic choice:\u001b[28Ghe policy flies at the burn share the player\u001b[73Gsets.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m4\r\u001b[2C\u001b[2B\u001b[39m5\u001b[27;1H\u001b[15;1H"]
