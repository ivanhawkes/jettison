[0.078, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 36 \u001b[22m `cli_*` tests run the `manifest` executable from an unrelated directory with no display: both\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 37 \u001b[22m content forms start, and a missing source and bad command lines fail. `cli_serve` runs the server\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 38 \u001b[22m with no client, checks that it stepped, and stops it with SIGINT; the `token_*` tests run\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/world/in\u001b[51Glude/manifest/world/State.h)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m li\u001b[17Ge, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 293 \u001b[12G\u001b[22m{\r\u001b[1B \u001b[3G   \u001b[2m 294 \u001b[22m   \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46mstring\u001b[39m needId;\u001b[K\r\u001b[1B     \u001b[2m 295 \u001b[12G\u001b[22m \u001b[14G\u001b[38;2;166;226;46mdouble\u001b[39m quantity{\u001b[38;2;190;132;255m0.0\u001b[39m};\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 296 -\u001b[38;2;248;248;242m  // Its unmet share smoothed over \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mday\u001b[48;2;61;1;0m, 0 to 1 (D-102).                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 296 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Its unmet share smoothed over \u001b[48;2;4;71;0man\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mhour\u001b[48;2;2;40;0m, 0 to 1 (D-102).\u001b[38;2;248;248;242m                                           \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m7\u001b[21G\u001b[22mpressure\r\u001b[5C\u001b[1B\u001b[2m 298 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 299 \u001b[22m   \u001b[38;2;166;226;46mbool\u001b[39m operator==(\u001b[38;2;166;226;46mconst\u001b[39m Unmet &) \u001b[38