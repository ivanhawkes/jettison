[3.149, "o", "\u001b[?25l\u001b[H\u001b[5G \u001b[7Gto carry\u001b[17Gg Ore's furs to Brine (26,615).\u001b[K\r\u001b[6C\u001b[1B\u001b[1mGlut:\u001b[22m Brine's broker is given five\u001b[42Gtimes it\u001b[51G copper\u001b[59Gtarget. Ada then buys\u001b[81Gcopp\u001b[86Gr\u001b[88Gat Brine and\u001b[101Gcarries\u001b[109Git\u001b[112Gto\u001b[115GOre.\r\u001b[4C\u001b[1B-\u001b[7GBoth\u001b[12Gruns,\u001b[18Gfast-forwarded,\u001b[34Gmatch\u001b[40Ga\u001b[42Gstep-by-step\u001b[55Grun\u001b[59Gbyte\u001b[64Gfor\u001b[68Gbyte,\u001b[74Gand\u001b[78Gno\u001b[81Gpinned\u001b[88Ghash\u001b[93Gmoved.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision for you: to set up these shoc\u001b[42Gs, the \u001b[50Gest writes to the world dire\u001b[79Gtly. It\u001b[87Ggiv\u001b[91Gs\u001b[93GB\u001b[95G's com\u001b[102Gany 1,000,000\u001b[K\r\u001b[2C\u001b[1Bcredits and adds copper to Brine's broker. That\u001b[51Gbreaks\u001b[61G fixtu\u001b[68Ge's \"only c\u001b[80Gmmands after\u001b[93Gbootstrap\" style, as th\u001b[117G\u001b[K\r\u001b[2C\u001b[1Bexisting \u001b[38;2;177;185;249mprofile.reset()\u001b[39m alre\u001b[33Gdy does.\u001b[42GIf you'd rather\u001b[58Gthese\u001b[64Gshortages\u001b[74Gcome\u001b[79Gout\u001b[83Gof\u001b[86Ga\u001b[88Glong\u001b[93Gnatural\u001b[101Grun,\u001b[106Git\u001b[109Gwould\u001b[115Gneed\r\u001b[2C\u001b[1Bcontent\u001b[11Gchanges\u001b[19Gor\u001b[22Gmany\u001b[27Gsimulated\u001b[37Gdays\u001b[42Gper\u001b[46Gtest.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNot checked:\u001b[22m the prices settling ov\u001b[41Gr long runs is stil\u001b[61G open; I've left it fo\u001b[84G the close-out (slic\u001b[105G 5).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mShortcut:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mTenderPrice\u001b[39m and \u001b[38;2;177;185;249mReliefs\u001b[39m rebuild the\u001b[51Gmarke\u001b[57G rules from\u001b[69Gcontent on every call, a\u001b[95G\u001b[38;2;177;185;249mQuote\u001b[39m already does.\r\u001b[2C\u001b[1B \u001b[5GThere's a \u001b[38;2;177;185;249mshor\u001b[20Gcut:\u001b[39m commen\u001b[32G saying\u001b[40GW12 should keep\u001b[56Gthe rules if a profile shows\u001b[89Gc\u001b[91Glls c\u001b[97Gs\u001b[100Gtoo much.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate time:\u001b[22m \u001b[38;2;177;185;249mfixture_cruise\u001b[39m t\u001b[33Gok\u001b[36G576\u001b[40Gs under\u001b[48GASan at\u001b[56G24 parallel jobs, which made the gate about 17 minutes. I\u001b[114Gdidn't\r\u001b[4C\u001b[1Bc\u001b[7Gange that \u001b[18Gest;\u001b[23Gthe\u001b[27Gslowdown\u001b[36Gmay\u001b[40Gbe\u001b[43Gfrom\u001b[48Gearlier\u001b[56Gslices\u001b[63Gor\u001b[66Gfrom\u001b[71Grunning\u001b[79G24\u001b[82Gjobs\u001b[87Gat\u001b[90Gonce.\u001b[96GIt's\u001b[101Gworth\u001b[107Ga\u001b[109Glook\u001b[114Gbefore\r\u001b[4C\u001b[1Bthe\u001b[9Gclose-out.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSlice\u001b[9G5\u001b[11Gis\u001b[14Gdocumentation,\u001b[29Gso\u001b[32GSonnet\u001b[39Gat\u001b[42Gmedium\u001b[49Geffort\u001b[56Gis\u001b[59Genough\u001b[66Gfor\u001b[70Git.\u001b[74GThis\u001b[79Gis\u001b[82Ga\u001b[84Ggood\u001b[89Gpoint\u001b[95Gto\u001b[98G\u001b[38;2;177;185;249m/compact\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 34m 53s · done 2:21 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯\u001b[39m \u001b[38;2;255;255;255m/compact\u001b[39m                                                                                                              \u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
