[4.710, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BHere\u001b[8Gthey\u001b[13Gare,\u001b[18Gwith\u001b[23Gmy\u001b[26Grecommendation\u001b[41Gfirst:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mHow a slower, cheaper run flies.\r\u001b[2C\u001b[1B\u001b[22m  \u001b[6G- \u001b[1mCo\u001b[11Gst (r\u001b[17Gcommended):\u001b[22m burn up to\u001b[40Ga\u001b[42Gcruise\u001b[49Gspeed,\u001b[56Gcoast,\u001b[63Gthen\u001b[68Gburn\u001b[73Gto\u001b[76Gstop.\u001b[82GIt\u001b[85Gneeds\u001b[91Ga\u001b[93Gsmall,\u001b[100Greusable\u001b[109GJettison\r\u001b[5C\u001b[1B \u001b[8Gchange: an optional coast\u001b[34Gphase\u001b[40Gin the cruis\u001b[53G profile.\u001b[63G\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mThrottle:\u001b[22m acceler\u001b[26Gte the whole way\u001b[43Gat a lower\u001b[54Grate. No\u001b[63Gengine\u001b[70Gchange,\u001b[78Gbut\u001b[82Git\u001b[85Gsaves\u001b[91Gmuch\u001b[96Gless\u001b[101Gfuel\u001b[106Gfor\u001b[110Gthe\u001b[114Gsame\r\u001b[5C\u001b[1B \u001b[8Gextra time.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mCargo weight in the burn.\r\u001b[2C\u001b[1B\u001b[22m  \u001b[6G- \u001b[1mYes\u001b[12G(recomme\u001b[21Gded):\u001b[22m fuel\u001b[32Gscales\u001b[39Gwith\u001b[44Gthe\u001b[48Ghull's\u001b[55Gmass\u001b[60Gplus\u001b[65Gthe\u001b[69Gcargo's,\u001b[78Gso\u001b[81Gheavy\u001b[87Gcheap\u001b[93Ggoods\u001b[99Gtend\u001b[104Gto\u001b[107Ggo\u001b[110Gslow\u001b[115Gand\r\u001b[5C\u001b[1B \u001b[8Glight valuable ones fast.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mNo:\u001b[22m every cargo faces the\u001b[34Gsame\u001b[39Gtrade-off.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mRefuelling.\u001b[18G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- \u001b[1mAt the pump (recommended):\u001b[35G\u001b[22ma\u001b[37GRefuel\u001b[44Gcommand\u001b[52Gbuys\u001b[57Ghydrogen\u001b[66Gfrom\u001b[71Gthe\u001b[75Gvenue's\u001b[83Gmarket\u001b[90Gstraight\u001b[99Ginto\u001b[104Gthe\u001b[108Gtanks.\u001b[115GLiquid\r\u001b[5