[0.040, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22mThe\u001b[14Guser's:\u001b[22Ga\u001b[24Gkm/s\u001b[29Gcosts\u001b[35Gthe\u001b[39Gacceleration\u001b[52Gin\u001b[55Gg\u001b[57Gsquared\u001b[65Gabove\u001b[71G1\u001b[73Gg,\u001b[76Gso\u001b[79Ga\u001b[81Ghard\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22mburn is punishingly expensive but can wi\u001b[52Ga race, such\u001b[66Gs to\u001b[71Gcolonise a new\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22msystem;\u001b[18Ga journey choos\u001b[34Gs \u001b[37Gts\u001b[40Gaccelerat\u001b[50Gon within\u001b[60Gthe mode's\u001b[72Gaps a\u001b[78G well as\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22mit\u001b[13G burn.\u001b[20GThe mass burn\u001b[34Gd\u001b[36Gagainst is everyth\u001b[55Gng aboard: hull, fuel tanks and\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mtheir fuel, occupants an\u001b[36Gpassenger\u001b[46G, and cargo. The tanks are apar\u001b[78G from the\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mhold and grow on the tech\u001b[36Gtree, the st\u001b[49Grter given a Fuel Bunk\u001b[72Grs slot and\u001b[84Goffer.\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mCo-Authored-By:\u001b[26GClaude\u001b[33GOpus\u001b[38G5.5\u001b[42G<noreply@anthropic.com>\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything\u001b[14Gis\u001b[17Gcommitted\u001b[27Gand\u001b[31Gboth\u001b[36Grepos\u001b[42Gare\u001b[46Gclean,\u001b[53Gso\u001b[56Git's\u001b[61Gsafe\u001b[66Gto\u001b[69Gclose\u001b[75Gthe\u001b[79Gsession.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRecorded in the W21 plan\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFuel cost\u001b[15Grises steeply with acceleration:\u001b[48G\u001b[22mup\u001b[51Gto\u001b[54G1\u001b[56Gg,\u001b[59Geach\u001b[64Gkm/s\u001b[69Gof\u001b[72Gspeed\u001b[78Gchange\u001b[85Gcosts\u001b[91Gthe\u001b[95Gbase\u001b[100Gamount.\u001b[108GAbove\u001b[114G1\u001b[116Gg\u001b[118Git\r\u001b[2C\u001b[1B \u001b[5Gcosts that times the acceleration squared:\u001b[48G4 times\u001b[56Gat\u001b[59G2 g,\u001b[64G16 times at 4\u001b[78Gg \u001b[82Gd 144 \u001b[89Gimes at 12\u001b[100Gg. A journey now\u001b[K\r\u001b[5C\u001b[1Bhoo\u001b[10Ges i\u001b[15Gs acceleration, up \u001b[35Go the g\u001b[43Gm\u001b[45G mode's caps,\u001b[59Gas well\u001b[67Gas how much of the full burn to use.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExample:\u001b[22m \u001b[15Go\u001b[17Gcross from Ore to Brin\u001b[40G, th\u001b[46Gstarter burns about 453\u001b[70Gkg at 1 g. An unmanned 20\u001b[97G ship racing\u001b[110Gat\u001b[113G12\u001b[116Gg\r\u001b[2C\u001b[1B \u001b[5Gwould need about 197 t\u001b[28Gof fuel and arrive \u001b[76Gy\u001b[78Gto\u001b[81Gwin a rac\u001b[91G to colon\u001b[101Gse \u001b[105G system.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
