[47Gand\u001b[51Gthe cargo\u001b[61Gwith\u001b[66Gits opened oxygen \u001b[86Gd\u001b[88Gca\u001b[91Gtridg\u001b[98Gtotes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTanks are separate from the cargo hold and grow on the tech tree:\u001b[22m through th\u001b[82G existing Fuel Bunk\u001b[102Grs\u001b[105Gupgrade.\u001b[114GThe\r\u001b[2C\u001b[1B \u001b[5Gstarter ship gets a slot and an offer for it, like its cargo-hold\u001b[71Gupgrade.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThose\u001b[9Gnumbers\u001b[17Gare\u001b[21Gstarting\u001b[30Gpoints\u001b[37Gfor\u001b[41Gyou\u001b[45Gto\u001b[48Greview.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits to push\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mManifest\u001b[14G\u001b[38;2;177;185;249mfeature-base\u001b[39m:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[38;2;177;185;249m21e9c6b\u001b[39m: the re-pin to\u001b[30GJettison\u001b[39G\u001b[38;2;177;185;249mf14c288\u001b[39m.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
