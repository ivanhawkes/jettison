[0.723, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mTanks are separate from the cargo hold and grow on the tech tree:\u001b[22m through the existing Fuel\u001b[97GBunkers up\u001b[108Grade.\u001b[114GThe\r\u001b[4C\u001b[1Bstarter\u001b[13Gship gets a slo\u001b[29G and an o\u001b[39Gf\u001b[41Gr for\u001b[47Git,\u001b[51Glike its cargo-hold upgrade.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThose\u001b[9Gnumbers\u001b[17Gare\u001b[21Gstarting\u001b[30Gpoints\u001b[37Gfor\u001b[41Gyou\u001b[45Gto\u001b[48Greview.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mCommits to push\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest \u001b[38;2;177;185;249mfeature-base\u001b[39m:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249m21e9c6b\u001b[39m:\u001b[16Gthe\u001b[20Gre-pin\u001b[27Gto\u001b[30GJettison\u001b[39G\u001b[38;2;177;185;249mf14c288\u001b[39m.\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249ma264c6d\u001b[39m: W19 slice 4.\u001b[29G\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mdce4cd1\u001b[39m: W19 done.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249m1dcdc4f\u001b[39m: fuel b\u001b[25G added to the roadmap.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mfda4c9a\u001b[39m: the\u001b[20GW21\u001b[24Gplan.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249ma6e6baf\u001b[39m:\u001b[16Gth\u001b[19G acceler\u001b[28Gtion curve and the t\u001b[50Gks.\u001b[K\r\u001b[4C\u001b[1B- Older unpushed commi\u001b[28Gs sit under thes\u001b[45G, from \u001b[38;2;177;185;249m8c86722\u001b[60G\u001b[39mdown.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mcc5c9cb\u001b[39m,\u001b[24Gthe\u001b[28Groadmap\u001b[36Grow\u001b[40Gfor\u001b[44Gthe\u001b[48Gcoast\u001b[54Gphase.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfull\u001b[12Gtest\u001b[17Ggate\u001b[22Gpassed\u001b[29Gon\u001b[32G\u001b[38;2;177;185;249m1dcdc4f\u001b[39m;\u001b[41Gthe\u001b[45Gtwo\u001b[49Glater\u001b[55Gcommits\u001b[63Gchange\u001b[70Gonly\u001b[75Gdocs.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mNext session:\u001b[22m W21 slice 1, the coast phase in Jettison. Opus\u001b[64Gat\u001b[67Gmedium\u001b[74Geffort\u001b[81Gsuits\u001b[87Git.\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3GCrunching…\u001b[18G\u001b[38;2;153;153;153m32\u001b[28G9\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
