[0.703, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+7\u001b[38;2;153;153;153m, ran \u001b[1m6\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GW21\u001b[11Gplan\u001b[16Gfor\u001b[20Gfuel\u001b[25Gburn\u001b[30Gis\u001b[33Gwritten\u001b[41Gand\u001b[45Gcommitted,\u001b[56Gin\u001b[59G\"W21\u001b[64Gplan\"\u001b[70Gin\u001b[73GManifest's\u001b[84G\u001b[38;2;177;185;249mdocs/stage-4-trading-plan.md\u001b[39m.\u001b[114GNothing\r\u001b[2C\u001b[1Bis pushed, \u001b[15Gnd\u001b[18Gthere's\u001b[26Gno\u001b[29Gcode\u001b[34Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mYour choices, as recorded\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mDrive fuel\u001b[22m (\u001b[38;2;177;185;249mItemDriveFuel\u001b[39m)\u001b[32Gis\u001b[35Ga\u001b[37Gnew\u001b[41Gfuel\u001b[46Gonly\u001b[51Gships\u001b[57Guse,\u001b[62G8\u001b[64Gcredits\u001b[72Ga\u001b[74Gkilogram\u001b[83Gat\u001b[86Ga\u001b[88G90\u001b[91Gkg\u001b[94Gtote.\u001b[100GEvery\u001b[106Gstation\u001b[114Gmakes\r\u001b[2C\u001b[1B \u001b[5Gabout\u001b[11Ga\u001b[13Gtote\u001b[18Ga\u001b[20Gday,\u001b[25Gand\u001b[29Gits\u001b[33Gprice\u001b[39Gfollows\u001b[47Gthe\u001b[51Gstock\u001b[57Gthe\u001b[61Gstation's\u001b[71Gmarket\u001b[78Gholds.\u001b[85GLPG\u001b[89Gstays\u001b[95Ga\u001b[97Gplanetary\u001b[107Gfuel.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBurn rate:\u001b[22m fuel\u001b[21Gused\u001b[26G=\u001b[28G0.005\u001b[34Gkg\u001b[37G×\u001b[39Gship\u001b[44Gmass\u001b[49Gin\u001b[52Gtonnes\u001b[59G(hull\u001b[65Gplus\u001b[70Gcargo)\u001b[77G×\u001b[79Gthe\u001b[83Gleg's\u001b[89Gchange\u001b[96Gin\u001b[99Gspeed\u001b[105Gin\u001b[108Gkm/s.\u001b[114GSo\r\u001b[4C\u001b[1Bharder\u001b[12Gacceleration\u001b[25Gempties\u001b[33Gthe\u001b[37Gtanks\u001b[43Gfaster,\u001b[51Gand\u001b[55Gweight\u001b[62Gcosts\u001b[68Gfuel.\r\u001b[4C\u001b[1B\u001b[1mSlow runs coast:\u001b[22m a journey sets\u001b[37Ga burn share. The ship burns that share of the f\u001b[86Gll speed change,\u001b[103Gthen coasts\u001b[K\r\u001b[4C\u001b[1Bbetween its\u001b[17Gburns. O\u001b[26Ge \u001b[29Go Brine:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B|\u001b[5GBurn  | Days |\u001b[K\r\u001b[2C\u001b[1B|-------|------|\u001b[20G\u001b[K\r\u001b[2C\u001b[1B|\u001b[5G100%  | 4.5  |\u001b[K\r\u001b[2C\u001b[1B|\u001b[5G50%\u001b[9G  | 5.7  |\u001b[K\r\u001b[2C\u001b[1B|\u001b[5G25%\u001b[11G|\u001b[13G9.7\u001b[18G|\r\u001b[2C\u001b[1B| 12.5% | 18.8 |\u001b[20G   \u001b[24G      \u001b[31G       \u001b[39G    \u001b[44G  \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
