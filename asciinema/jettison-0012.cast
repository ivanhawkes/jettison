[0.067, "o", "\u001b[?25l\u001b[H\u001b[3G|\u001b[5GBurn \u001b[11G|\u001b[13GDays\u001b[18G|\r\u001b[2C\u001b[1B|-------|------|\u001b[K\r\u001b[2C\u001b[1B|\u001b[5G100%\u001b[11G|\u001b[13G4.5\u001b[18G|\r\u001b[2C\u001b[1B| 50%   | 5.7  |\u001b[K\r\u001b[2C\u001b[1B|\u001b[5G25%\u001b[11G|\u001b[13G9.7\u001b[18G|\r\u001b[1B \u001b[3G| 12.5% | 18.8 |\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[22m The starter with 2 totes of copper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[4C\u001b[1Ba full\u001b[12Ghold\u001b[17Gof\u001b[20Gcopper\u001b[27Git\u001b[30Gwould\u001b[36Gneed\u001b[41G3,390\u001b[47Gkg,\u001b[51Gfar\u001b[55Gpast\u001b[60Gits\u001b[64G0.8\u001b[68Gt\u001b[70Gtanks,\u001b[77Gso\u001b[80Ga\u001b[82Gheavy\u001b[88Gcargo\u001b[94Ghas\u001b[98Gto\u001b[101Ggo\u001b[104Gslow.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAutomatic refuelling:\u001b[22m \u001b[28Gac\u001b[31G ship has\u001b[41Ga \u001b[44Gefuel set\u001b[54Ging, on by default;\u001b[74Git's the flag\u001b[88Gbehind\u001b[95Gyour\u001b[100Gcheckbox.\u001b[110GAs\u001b[113Gthe\u001b[117Gship\r\u001b[4C\u001b[1Bleaves a station, it fills its tanks at the\u001b[49Gmarket's liv\u001b[63Gprice, as far as the\u001b[84Gcompany\u001b[92Gcan\u001b[96Gpay\u001b[100Gafter\u001b[106Gthe\u001b[110Gdocking\r\u001b[4C\u001b[1Bfee. A leg the tanks can't\u001b[32Gfinish \u001b[40Gs refused with a new \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m res\u001b[82Glt.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStanding policy:\u001b[22m by default i\u001b[35G prices\u001b[43Geach\u001b[48Gtrade\u001b[54Gat 100%,\u001b[63G50%, 25% and 12.5%\u001b[82Gburn\u001b[87Gand\u001b[91Gtakes\u001b[97Gthe\u001b[101Gone\u001b[105Gmaking\u001b[112Gthe\u001b[116Gmost\r\u001b[4C\u001b[1Bper hour.\u001b[15GThe owner can fix a\u001b[35Gburn \u001b[41Gh\u001b[43Gre\u001b[46Ginstead.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison change:\u001b[22m the cruise profile gets an optional coast phase.\u001b[69GI\u001b[71Gadded\u001b[77Git\u001b[80Gas\u001b[83Ga\u001b[85Grow\u001b[89Gin\u001b[92GJettison's\u001b[103Groadmap,\u001b[112Gcommitted\r\u001b[2C\u001b[1Bas\u001b[6G\u001b[38;2;177;185;249mcc5c9cb\u001b[39m;\u001b[15Git's\u001b[20Gthe\u001b[24Gplan's\u001b[31Gfirst\u001b[37Gslice.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mSlices:\u001b[22m (1) the coast phase in Jettison, (2) the fuel and tanks,\u001b[68G(3)\u001b[72Gthe\u001b[76Gburn\u001b[81Gand\u001b[85Grefuelling,\u001b[97G(4)\u001b[101Gthe\u001b[105Gpolicy's\r\u001b[2C\u001b[1Bper-hour\u001b[12Gchoice,\u001b[20G(5)\u001b[24Gthe\u001b[28Gtrading\u001b[36Gfixture\u001b[44Gflying\u001b[51Ga\u001b[53Glight\u001b[59Glot\u001b[63Gfast\u001b[68Gand\u001b[72Ga\u001b[74Gheavy\u001b[80Gone\u001b[84Gslow,\u001b[90G(6)\u001b[94Gclose-out.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
