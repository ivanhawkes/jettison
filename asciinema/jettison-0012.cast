[0.040, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7G\u001b[38;2;177;185;249mReliefs\u001b[39m:\u001b[16Gfor\u001b[20Geach\u001b[25Gessential\u001b[35Gneed\u001b[40Gwith\u001b[45Gpressure\u001b[54Gabove\u001b[60G0.25,\u001b[66Gthe\u001b[70Gday's\u001b[76Gshortfall\u001b[86Gin\u001b[89Gwhole\u001b[95Gtotes\u001b[101Gof\u001b[104Gits\u001b[108Gcheapest\r\u001b[2C\u001b[1B    go\u001b[10Gd, budgeted at urgency 3 ×\u001b[37Gpressure.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B  These have unit tests in the \u001b[38;2;177;185;249mtrade\u001b[39m suite.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mFixture test \u001b[38;2;177;185;249mfixture_prices\u001b[39m.\u001b[22m Six simulated days\u001b[53Gwith\u001b[58Gtwo\u001b[62Gtraders\u001b[70Gproduced\u001b[79Gno\u001b[82Gshortage\u001b[91Gor\u001b[94Gglut\u001b[99Gby\u001b[102Gthemselves:\u001b[114Gevery\r\u001b[4C\u001b[1Bbroker\u001b[12Gstayed\u001b[19Gnear\u001b[24Gits\u001b[28Gtarget\u001b[35Gand\u001b[39Gno\u001b[42Gneed's\u001b[49Gpressure\u001b[58Grose.\u001b[64GSo\u001b[67Gthe\u001b[71Gtest\u001b[76Gcreates\u001b[84Gthem:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mShortag\u001b[15G:\u001b[22m a s\u001b[21Gcond play\u001b[31Gr, Bo,\u001b[38Gbuys\u001b[43Gout B\u001b[49Gi\u001b[51Ge's furs. Ada's first\u001b[73Gjob changes\u001b[85Gfrom c\u001b[92Gpper (estimated profit\u001b[115G9,542)\r\u001b[2C\u001b[1B \u001b[5G  to carrying Ore's furs to Brine\u001b[39G(26,615).\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mGlut:\u001b[13G\u001b[22mBrine's broker is given five times its co\u001b[55Gper targ\u001b[64Gt. Ad\u001b[71Gthen buy\u001b[80G copper at Brine and carries it\u001b[112Gto\u001b[115GOre.\r\u001b[2C\u001b[1B \u001b[5G- Both runs, fast-forwarded, match\u001b[40Ga\u001b[42Gstep-by-step run\u001b[59Gbyte for\u001b[68Gbyte\u001b[74Gand no pinned hash moved.\u001b[100G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision for you:\u001b[21Gto\u001b[24Gset\u001b[28Gup\u001b[31Gthese\u001b[37Gshocks,\u001b[45Gthe\u001b[49Gtest\u001b[54Gwrites\u001b[61Gto\u001b[64Gthe\u001b[68Gworld\u001b[74Gdirectly.\u001b[84GIt\u001b[87Ggives\u001b[93GBo's\u001b[98Gcompany\u001b[106G1,000,000\r\u001b[2C\u001b[1Bcredits\u001b[11Gand\u001b[15Gadds\u001b[20Gcopper\u001b[27Gto\u001b[30GBrine's\u001b[38Gbroker.\u001b[46GThat\u001b[51Gbreaks\u001b[58Gthe\u001b[62Gfixture's\u001b[72G\"only\u001b[78Gcommands\u001b[87Gafter\u001b[93Gbootstrap\"\u001b[104Gstyle,\u001b[111Gas\u001b[114Gthe\r\u001b[2C\u001b[1Bex\u001b[6Gsting \u001b[38;2;177;185;249mprofile.reset()\u001b[39m already does.\u001b[42GIf you'd rather these shortages\u001b[74Gcome\u001b[79Gout of a long na\u001b[96Gural run, it\u001b[109Gwould\u001b[115Gneed\r\u001b[2C\u001b[1Bcontent\u001b[11Gchanges\u001b[19Gor\u001b[22Gmany\u001b[27Gsimulated\u001b[37Gdays\u001b[42Gper\u001b[46Gtest.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot checked:\u001b[18G\u001b[22mthe\u001b[22Gprices\u001b[29Gsettling\u001b[38Gover\u001b[43Glong\u001b[48Gruns\u001b[53Gis\u001b[56Gstill\u001b[62Gopen;\u001b[68GI've\u001b[73Gleft\u001b[78Git\u001b[81Gfor\u001b[85Gthe\u001b[89Gclose-out\u001b[99G(slice 5).\r\u001b[1B  - \u001b[1mShortcut:\u001b[22m \u001b[38;2;177;185;249mTenderPrice\u001b[39m and \u001b[38;2;177;185;249mReliefs\u001b[39m rebuild the market rules from content on every call, as \u001b[38;2;177;185;249mQuote\u001b[39m already does.\u001b[K\r\u001b[4C\u001b[1BThere's\u001b[13Ga\u001b[15G\u001b[38;2;177;185;249mshortcut:\u001b[25G\u001b[39mcomment\u001b[33Gsaying\u001b[40GW12\u001b[44Gshould\u001b[51Gkeep\u001b[56Gthe\u001b[60Grules\u001b[66Gif\u001b[69Ga\u001b[71Gprofile\u001b[79Gshows\u001b[85Gthe\u001b[89Gcalls\u001b[95Gcost\u001b[100Gtoo\u001b[104Gmuch.\r\u001b[1B \u001b[3G- \u001b[1mGate time:\u001b[22m \u001b[38;2;177;185;249mfixture_cruise\u001b[39m took\u001b[36G576\u001b[40Gs\u001b[42Gunder\u001b[48GASan\u001b[53Gat\u001b[56G24\u001b[59Gparallel\u001b[68Gjobs,\u001b[74Gwhich\u001b[80Gmade\u001b[85Gthe\u001b[89Ggate\u001b[94Gabou