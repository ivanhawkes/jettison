[0.328, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mW19 close-out (\u001b[38;2;177;185;249mdce4cd1\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mPrice\u001b[11G set\u001b[16Gling over long runs, the last thing W19 had to prove:\u001b[70G\u001b[22ma\u001b[72Gnew\u001b[76Gtest\u001b[81Gruns\u001b[86Geight\u001b[92Gdays\u001b[97Gwith\u001b[102Gtwo\u001b[106Gtraders.\u001b[115GEvery\r\u001b[2C\u001b[1B \u001b[5Gbroker's stock of every good stays between half and twice its target, with one tote of\u001b[92Gslack a\u001b[100G the small\u001b[111Gst targets\r\u001b[4C\u001b[1B(2,338 checks).\u001b[K\r\u001b[4C\u001b[1B- What\u001b[12Gmoves the\u001b[22Gstocks\u001b[29Gis\u001b[32Gmakers'\u001b[40Gbatches\u001b[48Glanding\u001b[56Gand\u001b[60Ghouseholds\u001b[71Gdrawing\u001b[79Gthem\u001b[84Gdown;\u001b[90Gnone\u001b[95Gswings\u001b[102Gback\u001b[107Gand\u001b[111Gforth.\r\u001b[6C\u001b[1BDrinking wa\u001b[19Ger\u001b[22Gdrift\u001b[29Gby\u001b[32Ga f\u001b[36Gw totes a day out of 2,000, w\u001b[66Gich only matters over mo\u001b[91Gths. I \u001b[99Goted that for the\u001b[K\r\u001b[4C\u001b[1B \u001b[7Gbalance work.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe test adds\u001b[21Gabout\u001b[27G45\u001b[30Gs\u001b[32Gin\u001b[35GDebug\u001b[41Gand\u001b[45Gabout\u001b[51G250\u001b[55Gs\u001b[57Gunder\u001b[63Gthe\u001b[67Gsanitiser\u001b[77Gbuild.\u001b[84GIt\u001b[87Gruns\u001b[92Gin\u001b[95G\u001b[38;2;177;185;249mfixture_prices\u001b[39m,\u001b[111Gwhich\u001b[117Gat\r\u001b[4C\u001b[1B \u001b[7G319\u001b[11Gs \u001b[15Gill finishes before\u001b[35Gthe slowest fixture\u001b[55Gtest (\u001b[38;2;177;185;249mfixture_cruise\u001b[39m,\u001b[77G575 s), so the\u001b[92Ggate takes no longer.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[11G\u001b[22mW19 \u001b[16Gs wr\u001b[21Gtten up as d\u001b[34Gliv\u001b[38Gred in \u001b[46Ghe s\u001b[51Gag\u001b[55G4 plan, D-102 is marked implemented,\u001b[92Gand the delivery order,\r\u001b[2C\u001b[1B \u001b[5Ghistory and handoff are\u001b[29Gupdated.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo stale notes fixed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- The gate notes now list\u001b[31G\u001b[38;2;177;185;249mfixture_prices\u001b[39m.\r\u001b[10C\u001b[1Bcomme\u001b[17Gt on\u001b[23Geed pressure in \u001b[38;2;177;185;249mStat\u001b[44G.h\u001b[47G\u001b[39mnow\u001b[51Gsays\u001b[56Git's\u001b[61Gsmoothed\u001b[70Gover\u001b[75Gan\u001b[78Ghour,\u001b[84Gas\u001b[87Gthe\u001b[91Gcode\u001b[96Gdoes.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuel burn (\u001b[38;2;177;185;249m1dcdc4f\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m- It's recorded as decision\u001b[31GD-107\u001b[37Gand\u001b[41Gtask\u001b[46GW21.\u001b[51GI\u001b[53Gplaced\u001b[60Git\u001b[63Gnext,\u001b[69Gahead\u001b[75Gof\u001b[78GW12,\u001b[83Gsince\u001b[89Gits\u001b[93Gcost\u001b[98Gbelongs\u001b[106Gin\u001b[109Gevery\u001b[115Gtrade\r\u001b[2C\u001b[1B \u001b[5Gestimate; move it if you meant l\u001b[38Gter.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe design sits in the small-ship plan\u001b[44Gwith\u001b[49Gits\u001b[53Gopen\u001b[58Gchoices:\r\u001b[2C\u001b[1B \u001b[5G- which fuel \u001b[19Go\u001b[21Gburn (LPG or a drive fuel \u001b[75Gefuelling;\u001b[27;1H\u001b[24;3H\u001b[?25h"]
