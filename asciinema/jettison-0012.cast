[1.147, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mYour choices, as recorded\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mD\u001b[7Give fu\u001b[14Gl\u001b[22m (\u001b[38;2;177;185;249mItemDriveFuel\u001b[39m)\u001b[32Gis\u001b[35Ga\u001b[37Gnew\u001b[41Gfuel\u001b[46Gonly\u001b[51Gships\u001b[57Guse,\u001b[62G8\u001b[64Gcredits\u001b[72Ga\u001b[74Gkilogram\u001b[83Gat\u001b[86Ga\u001b[88G90\u001b[91Gkg\u001b[94Gtote.\u001b[100GEvery\u001b[106Gstation\u001b[114Gmakes\r\u001b[2C\u001b[1B \u001b[5Gabout a tote a day, and its price follows the\u001b[52Gtock\u001b[57Gth\u001b[60G station's m\u001b[73Gr\u001b[75Get holds. LPG stays a planetary fuel.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBurn rate:\u001b[22m fuel used = 0.005 kg ×\u001b[39Gship mass in \u001b[54Gnnes (hull plus cargo) × the leg's\u001b[89Gch\u001b[92Gnge in sp\u001b[102Ged in km/s.\u001b[114GSo\r\u001b[2C\u001b[1B \u001b[5Gharder acceleration empties the\u001b[37Gtanks faster, and w\u001b[57Gight costs fuel.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSlow runs coast:\u001b[22m a journey sets\u001b[37Ga burn share.\u001b[51GThe\u001b[55Gsh\u001b[58Gp burn\u001b[65G that share\u001b[77Gof\u001b[80Gthe\u001b[84Gfull\u001b[89Gspeed\u001b[95Gchange,\u001b[103Gthen\u001b[108Gcoasts\r\u001b[2C\u001b[1B \u001b[5Gbetween its burns.\u001b[24GOre to Brine:\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B|\u001b[5GBurn\u001b[11G|\u001b[13GDays\u001b[18G|\r\u001b[3C\u001b[1B-------\u001b[12G------\r\u001b[3C\u001b[1B 100%  \u001b[12G 4.5  \r\u001b[4C\u001b[1B5\u001b[7G% \u001b[13G5\u001b[15G7\r\u001b[4C\u001b[1B25\u001b[13G9\r\u001b[4C\u001b[1B12.5%\u001b[13G18.8\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[33G\u001b[22mThe\u001b[37Gstarter\u001b[45Gwith\u001b[50G2\u001b[52Gtotes\u001b[58Gof\u001b[61Gcopper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[2C\u001b[1B \u001b[5Ga full hold of copper it would need 3,390 kg, far past its 0.8\u001b[68Gt tanks, so a heavy\u001b[88Gcargo\u001b[94Ghas to go slow.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAutomatic refuelling:\u001b[27G\u001b[22meach ship has\u001b[41Ga refuel setting, on by default; it'\u001b[78G the flag\u001b[88Gbehind your checkb\u001b[107Gx\u001b[110GAs\u001b[113Gthe\u001b[117Gship\r\u001b[2C\u001b[1B \u001b[5Gleaves a station, it fills\u001b[32Gits tanks at th\u001b[48G market's live price, as far as the company can pay\u001b[100Gafter the\u001b[110Gdocking\u001b[K\r\u001b[4C\u001b[1Bf\u001b[7Ge. A\u001b[12Gleg the tanks\u001b[26Gcan't\u001b[32Gfinish i\u001b[42Grefus\u001b[76G\u001b[38;2;177;185;249ml\u001b[39m result.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.061, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mD\u001b[7Give fu\u001b[14Gl\u001b[22m (\u001b[38;2;177;185;249mItemDriveFuel\u001b[39m)\u001b[32Gis\u001b[35Ga\u001b[37Gnew\u001b[41Gfuel\u001b[46Gonly\u001b[51Gships\u001b[57Guse,\u001b[62G8\u001b[64Gcredits\u001b[72Ga\u001b[74Gkilogram\u001b[83Gat\u001b[86Ga\u001b[88G90\u001b[91Gkg\u001b[94Gtote.\u001b[100GEvery\u001b[106Gstation\u001b[114Gmakes\r\u001b[2C\u001b[1B \u001b[5Gabout a tote a day, and its price follows the\u001b[52Gtock\u001b[57Gth\u001b[60G station's m\u001b[73Gr\u001b[75Get holds. LPG stays a planetary fuel.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBurn rate:\u001b[22m fuel used = 0.005 kg ×\u001b[39Gship mass in \u001b[54Gnnes (hull plus cargo) × the leg's\u001b[89Gch\u001b[92Gnge in sp\u001b[102Ged in km/s.\u001b[114GSo\r\u001b[2C\u001b[1B \u001b[5Gharder acceleration empties the\u001b[37Gtanks faster, and w\u001b[57Gight costs fuel.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSlow runs coast:\u001b[22m a journey sets\u001b[37Ga burn share.\u001b[51GThe\u001b[55Gsh\u001b[58Gp burn\u001b[65G that share\u001b[77Gof\u001b[80Gthe\u001b[84Gfull\u001b[89Gspeed\u001b[95Gchange,\u001b[103Gthen\u001b[108Gcoasts\r\u001b[2C\u001b[1B \u001b[5Gbetween its burns.\u001b[24GOre to Brine:\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B|\u001b[5GBurn\u001b[11G|\u001b[13GDays\u001b[18G|\r\u001b[3C\u001b[1B-------\u001b[12G------\r\u001b[3C\u001b[1B 100%  \u001b[12G 4.5  \r\u001b[4C\u001b[1B5\u001b[7G% \u001b[13G5\u001b[15G7\r\u001b[4C\u001b[1B25\u001b[13G9\r\u001b[4C\u001b[1B12.5%\u001b[13G18.8\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[33G\u001b[22mThe\u001b[37Gstarter\u001b[45Gwith\u001b[50G2\u001b[52Gtotes\u001b[58Gof\u001b[61Gcopper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[2C\u001b[1B \u001b[5Ga full hold of copper it would need 3,390 kg, far past its 0.8\u001b[68Gt tanks, so a heavy\u001b[88Gcargo\u001b[94Ghas to go slow.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAutomatic refuelling:\u001b[27G\u001b[22meach ship has\u001b[41Ga refuel setting, on by default; it'\u001b[78G the flag\u001b[88Gbehind your checkb\u001b[107Gx\u001b[110GAs\u001b[113Gthe\u001b[117Gship\r\u001b[2C\u001b[1B \u001b[5Gleaves a station, it fills\u001b[32Gits tanks at th\u001b[48G market's live price, as far as the company can pay\u001b[100Gafter the\u001b[110Gdocking\u001b[K\r\u001b[4C\u001b[1Bf\u001b[7Ge. A\u001b[12Gleg the tanks\u001b[26Gcan't\u001b[32Gfinish i\u001b[42Grefus\u001b[48Gd with a new \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m result.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStanding policy:\u001b[22m by default \u001b[34Gt prices \u001b[44Gach\u001b[76G12.5% burn\u001b[87Gand\u001b[91Gtakes\u001b[97Gthe\u001b[101Gone\u001b[105Gmaking\u001b[112Gthe\u001b[116Gmost\u001b[27;1H\u001b[24;3H\u001b[?25h"]
