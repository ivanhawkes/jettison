[0.063, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[14G\u001b[38;2;117;113;94m// 125 kg a day, short by the pressure, is a tote of 125 kg, rounded up.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(relief.totes == \u001b[38;2;190;132;255m1\u001b[38;2;248;248;242m);                                                                       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m59\u001b[14G\u001b[38;2;117;113;94m// Nothing is offered at Ore, so the tote at its native price, three times the pressure over it.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::optional<std::\u001b[38;2;166;226;46mint64_t\u001b[38;2;248;248;242m> price =       \u001b[63G               \u001b[79G     \u001b[85G          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[14G\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mTenderPrice\u001b[38;2;248;248;242m(hosted.world,\u001b[44Ghosted.identities,\u001b[63Ghosted.content,\u001b[79GkOre,\u001b[85GkMedical);\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[14G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(price);    \u001b[34G  \u001b[37G              \u001b[52G      \u001b[59G              \u001b[74G \u001b[76G           \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[34G\u001b[38;2;248;248;242m== \u001b[59GkReliefUrgency\u001b[74G*\u001b[76Gpressure));\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m \u001b[14G\u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(relief.budget > *\u001b[38;2;166;226;46mBudget\u001b[38;2;248;248;242m(*price, \u001b[38;2;190;132;255m125.0\u001b[38;2;248;248;242m, \u001b[38;2;190;132;255m0.0\u001b[38;2;248;248;242m));                                                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m}\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\r\u001b[5C\u001b[1B 467 +\u001b[38;