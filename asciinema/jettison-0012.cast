12\u001b[100Gg.\u001b[103GA\u001b[105Gjourney\u001b[113Gnow\r\u001b[2C\u001b[1B  chooses its acceleration,\u001b[31Gup\u001b[34Gto\u001b[37Gthe\u001b[41Ggame\u001b[46Gmode's\u001b[53Gcaps,\u001b[59Gas\u001b[62Gwell\u001b[67Gas\u001b[70Ghow\u001b[74Gmuch\u001b[79Gof\u001b[82Gthe\u001b[86Gfull\u001b[91Gburn\u001b[96Gto\u001b[99Guse.\r\u001b[4C\u001b[1B\u001b[1mExample:\u001b[22m to cross from\u001b[28GOre\u001b[32Gto\u001b[35GBrine,\u001b[42Gthe\u001b[46Gstarter\u001b[54Gburns\u001b[60Gabout\u001b[66G453\u001b[70Gkg\u001b[73Gat\u001b[76G1\u001b[78Gg.\u001b[81GAn\u001b[84Gunmanned\u001b[93G20\u001b[96Gt\u001b[98Gship\u001b[103Gracing\u001b[110Gat\u001b[113G12\u001b[116Gg\r\u001b[4C\u001b[1Bwould need\u001b[16Gabout 197 t \u001b[29Gf fuel a\u001b[38Gd arrive in\u001b[50G1.34\u001b[55Gdays,\u001b[61Gan\u001b[64Gexpensive\u001b[74Gway\u001b[78Gto\u001b[81Gwin\u001b[85Ga\u001b[87Grace\u001b[92Gto\u001b[95Gcolonise\u001b[104Ga\u001b[106Gsystem.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEverything aboard counts toward the mass:\u001b[47G\u001b[22mthe\u001b[51Ghull,\u001b[57Gthe\u001b[61Gfuel\u001b[66Gtanks\u001b[72G(0.25\u001b[78Gt\u001b[80Gof\u001b[83Gtank\u001b[88Gper\u001b[92Gtonne\u001b[98Gof\u001b[101Gcapacity),\u001b[112Gthe\u001b[116Gfuel\r\u001b[4C\u001b[1Bin them, the peopl\u001b[24G aboard\u001b[32G(100\u001b[37Gkg\u001b[40Geach),\u001b[47Gand\u001b[51Gthe\u001b[55Gcargo\u001b[61Gwith\u001b[66Gits\u001b[70Gopened\u001b[77Goxygen\u001b[84Gand\u001b[88Gcartridge\u001b[98Gtotes.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTanks are separate from the cargo hold and\u001b[76G\u001b[22mgh\u001b[79Gthe\u001b[83Gexisting\u001b[92GFuel\u001b[97GBunkers\u001b[105Gupgrade.\u001b[114GThe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
