[0.032, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mhold and grow on the tech\u001b[36Gtree, the st\u001b[49Grter given a Fuel Bunk\u001b[72Grs slot and\u001b[84Goffer.\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mCo-Authored-By:\u001b[26GClaude\u001b[33GOpus\u001b[38G5.5\u001b[42G<noreply@anthropic.com>\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything\u001b[14Gis\u001b[17Gcommitted\u001b[27Gand\u001b[31Gboth\u001b[36Grepos\u001b[42Gare\u001b[46Gclean,\u001b[53Gso\u001b[56Git's\u001b[61Gsafe\u001b[66Gto\u001b[69Gclose\u001b[75Gthe\u001b[79Gsession.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRecorded in the W21 plan\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFuel cost\u001b[15Grises steeply with acceleration:\u001b[48G\u001b[22mup\u001b[51Gto\u001b[54G1\u001b[56Gg,\u001b[59Geach\u001b[64Gkm/s\u001b[69Gof\u001b[72Gspeed\u001b[78Gchange\u001b[85Gcosts\u001b[91Gthe\u001b[95Gbase\u001b[100Gamount.\u001b[108GAbove\u001b[114G1\u001b[116Gg\u001b[118Git\r\u001b[2C\u001b[1B \u001b[5Gcosts that times the acceleration squared:\u001b[48G4 times\u001b[56Gat\u001b[59G2 g,\u001b[64G16 times at 4\u001b[78Gg \u001b[82Gd 144 \u001b[89Gimes at 12\u001b[100Gg. A journey now\u001b[K\r\u001b[5C\u001b[1Bhoo\u001b[10Ges i\u001b[15Gs acceleration, up \u001b[35Go the g\u001b[43Gm\u001b[45G mode's caps,\u001b[59Gas well\u001b[67Gas how much of the full burn to use.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExample:\u001b[22m \u001b[15Go\u001b[17Gcross from Ore to Brin\u001b[40G, th\u001b[46Gstarter burns about 453\u001b[70Gkg at 1 g. An unmanned 20\u001b[97G ship racing\u001b[110Gat\u001b[113G12\u001b[116Gg\r\u001b[2C\u001b[1B \u001b[5Gwould need about 197 t\u001b[28Gof fuel and arrive in 1.34 day\u001b[59G, an expensive way\u001b[78Gto\u001b[81Gwin a rac\u001b[91G to colon\u001b[101Gse \u001b[105G system.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEverything aboard counts toward the mass:\u001b[47G\u001b[22mthe hull, the\u001b[61Gfuel ta\u001b[69Gks (0.25\u001b[79G of tank per\u001b[94Gnne \u001b[99Gf cap\u001b[105Gcity), the\u001b[116Gfuel\r\u001b[2C\u001b[1B \u001b[5Gin them, the people aboard (100 kg each),\u001b[47Gand\u001b[51Gthe cargo\u001b[61Gwith\u001b[66Gits opened oxygen \u001b[86Gd\u001b[88Gca\u001b[91Gtridg\u001b[98Gtotes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTanks are separate from the cargo hold and grow on the tech tree:\u001b[22m through th\u001b[82G existing Fuel Bunk\u001b[102Grs\u001b[105Gupgrade.\u001b[114GThe\r\u001b[2C\u001b[1B \u001b[5Gstarter ship gets a slot and an offer for it, like its cargo-hold\u001b[71Gupgrade.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThose\u001b[9Gnumbers\u001b[17Gare\u001b[21Gstarting\u001b[30Gpoints\u001b[37Gfor\u001b[41Gyou\u001b[45Gto\u001b[27;1H\u001b[24;3H\u001b[?25h"]
