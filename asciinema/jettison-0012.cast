[0.485, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B|\u001b[5GBurn\u001b[11G|\u001b[13GDays\u001b[18G|\r\u001b[3C\u001b[1B-------\u001b[12G------\r\u001b[3C\u001b[1B 100%  \u001b[12G 4.5  \r\u001b[4C\u001b[1B5\u001b[7G% \u001b[13G5\u001b[15G7\r\u001b[4C\u001b[1B25\u001b[13G9\r\u001b[4C\u001b[1B12.5%\u001b[13G18.8\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[33G\u001b[22mThe\u001b[37Gstarter\u001b[45Gwith\u001b[50G2\u001b[52Gtotes\u001b[58Gof\u001b[61Gcopper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[2C\u001b[1B \u001b[5Ga full hold of copper it would need 3,390 kg, far past its 0.8\u001b[68Gt tanks, so a heavy\u001b[88Gcargo\u001b[94Ghas to go slow.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAutomatic refuelling:\u001b[27G\u001b[22meach ship has\u001b[41Ga refuel setting, on by default; it'\u001b[78G the flag\u001b[88Gbehind your checkb\u001b[107Gx\u001b[110GAs\u001b[113Gthe\u001b[117Gship\r\u001b[2C\u001b[1B \u001b[5Gleaves a station, it fills\u001b[32Gits tanks at th\u001b[48G market's live price, as far as the company can pay\u001b[100Gafter the\u001b[110Gdocking\u001b[K\r\u001b[4C\u001b[1Bf\u001b[7Ge. A\u001b[12Gleg the tanks\u001b[26Gcan't\u001b[32Gfinish i\u001b[42Grefus\u001b[48Gd with a new \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m result.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStanding policy:\u001b[22m by default \u001b[34Gt prices \u001b[44Gach trade at\u001b[57G100%, 50%, 25% and 12.5% burn\u001b[87Gand\u001b[91Gtakes\u001b[97Gthe\u001b[101Gone\u001b[105Gmaking\u001b[112Gthe\u001b[116Gmost\r\u001b[2C\u001b[1B \u001b[5Gper hour. The owner\u001b[25Gcan fix\u001b[33Ga bu\u001b[38Gn share instead.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison change:\u001b[20G\u001b[22mthe\u001b[24Gcruise\u001b[31Gprofile\u001b[39Ggets\u001b[44Gan\u001b[47Goptional\u001b[56Gcoast\u001b[62Gphase.\u001b[69GI\u001b[71Gadded\u001b[77Git\u001b[80Gas\u001b[83Ga\u001b[85Grow\u001b[89Gin\u001b[92GJettison's\u001b[103Groadmap,\u001b[112Gcommitted\r\u001b[2C\u001b[1Bas \u001b[38;2;177;185;249mcc5c9cb\u001b[39m; it's\u001b[24Gplan's\u001b[31Gfirst slice.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlices:\u001b[11G\u001b[22m(1)\u001b[15Gthe\u001b[19Gcoast\u001b[25Gphase\u001b[31Gin\u001b[34GJettison,\u001b[44G(2)\u001b[48Gthe\u001b[52Gfuel\u001b[57Gand\u001b[61Gtanks,\u001b[68G(3)\u001b[72Gthe\u001b[76Gburn\u001b[81Gand\u001b[85Grefuelling,\u001b[97G(4)\u001b[101Gthe\u001b[105Gpolicy's\r\u001b[2C\u001b[1Bper-hour choic\u001b[18G, (5) the trading fixture\u001b[44Gfly\u001b[76Gavy one slow, (6) close-out.\u001b[105G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.062, "o", "\u001b[?25l\u001b[H\r\u001b[3C\u001b[1B-------\u001b[12G------\r\u001b[3C\u001b[1B 100%  \u001b[12G 4.5  \r\u001b[4C\u001b[1B5\u001b[7G% \u001b[13G5\u001b[15G7\r\u001b[4C\u001b[1B25\u001b[13G9\r\u001b[4C\u001b[1B12.5%\u001b[13G18.8\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[33G\u001b[22mThe\u001b[37Gstarter\u001b[45Gwith\u001b[50G2\u001b[52Gtotes\u001b[58Gof\u001b[61Gcopper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[2C\u001b[1B \u001b[5Ga full hold of copper it would need 3,390 kg, far past its 0.8\u001b[68Gt tanks, so a heavy\u001b[88Gcargo\u001b[94Ghas to go slow.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAutomatic refuelling:\u001b[27G\u001b[22meach ship has\u001b[41Ga refuel setting, on by default; it'\u001b[78G the flag\u001b[88Gbehind your checkb\u001b[107Gx\u001b[110GAs\u001b[113Gthe\u001b[117Gship\r\u001b[2C\u001b[1B \u001b[5Gleaves a station, it fills\u001b[32Gits tanks at th\u001b[48G market's live price, as far as the company can pay\u001b[100Gafter the\u001b[110Gdocking\u001b[K\r\u001b[4C\u001b[1Bf\u001b[7Ge. A\u001b[12Gleg the tanks\u001b[26Gcan't\u001b[32Gfinish i\u001b[42Grefus\u001b[48Gd with a new \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m result.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStanding policy:\u001b[22m by default \u001b[34Gt prices \u001b[44Gach trade at\u001b[57G100%, 50%, 25% and 12.5% burn\u001b[87Gand\u001b[91Gtakes\u001b[97Gthe\u001b[101Gone\u001b[105Gmaking\u001b[112Gthe\u001b[116Gmost\r\u001b[2C\u001b[1B \u001b[5Gper hour. The owner\u001b[25Gcan fix\u001b[33Ga bu\u001b[38Gn share instead.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison change:\u001b[20G\u001b[22mthe\u001b[24Gcruise\u001b[31Gprofile\u001b[39Ggets\u001b[44Gan\u001b[47Goptional\u001b[56Gcoast\u001b[62Gphase.\u001b[69GI\u001b[71Gadded\u001b[77Git\u001b[80Gas\u001b[83Ga\u001b[85Grow\u001b[89Gin\u001b[92GJettison's\u001b[103Groadmap,\u001b[112Gcommitted\r\u001b[2C\u001b[1Bas \u001b[38;2;177;185;249mcc5c9cb\u001b[39m; it's\u001b[24Gplan's\u001b[31Gfirst slice.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlices:\u001b[11G\u001b[22m(1)\u001b[15Gthe\u001b[19Gcoast\u001b[25Gphase\u001b[31Gin\u001b[34GJettison,\u001b[44G(2)\u001b[48Gthe\u001b[52Gfuel\u001b[57Gand\u001b[61Gtanks,\u001b[68G(3)\u001b[72Gthe\u001b[76Gburn\u001b[81Gand\u001b[85Grefuelling,\u001b[97G(4)\u001b[101Gthe\u001b[105Gpolicy's\r\u001b[2C\u001b[1Bper-hour choic\u001b[18G, (5) the trading fixture\u001b[44Gflying a light lo\u001b[62G fa\u001b[66Gt\u001b[68Gand\u001b[72Ga heavy one slow, (6) close-out.\u001b[105G\u001b[K\r\u001b[2C\u001b[1B        \u001b[12G       \u001b[20G   \u001b[24G   \u001b[28G       \u001b[36G       \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
