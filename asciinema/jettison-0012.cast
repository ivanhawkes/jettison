[92GJettison's\u001b[103Groadmap,\u001b[112Gcommitted\r\u001b[2C\u001b[1Bas \u001b[38;2;177;185;249mcc5c9cb\u001b[39m; it's\u001b[24Gplan's\u001b[31Gfirst slice.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlices:\u001b[11G\u001b[22m(1)\u001b[15Gthe\u001b[19Gcoast\u001b[25Gphase\u001b[31Gin\u001b[34GJettison,\u001b[44G(2)\u001b[48Gthe\u001b[52Gfuel\u001b[57Gand\u001b[61Gtanks,\u001b[68G(3)\u001b[72Gthe\u001b[76Gburn\u001b[81Gand\u001b[85Grefuelling,\u001b[97G(4)\u001b[101Gthe\u001b[105Gpolicy's\r\u001b[2C\u001b[1Bper-hour choic\u001b[18G, (5) the trading fixture\u001b[44Gflying a light lo\u001b[62G fa\u001b[66Gt\u001b[68Gand\u001b[72Ga heavy one slow, (6) close-out.\u001b[105G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNumbers to review:\u001b[22G\u001b[22mthe\u001b[26G8-credit\u001b[35Gprice,\u001b[42Gthe\u001b[46G0.005\u001b[52Gburn\u001b[57Gconstant\u001b[66Gand\u001b[70Gthe\u001b[74G0.8\u001b[78Gt\u001b[80Gstarter\u001b[88Gtank\u001b[93Gare\u001b[97Gmy\u001b[100Gbest\u001b[105Gguesses.\u001b[114GThe\r\u001b[2C\u001b[1Btable is designed so a\u001b[26Glight cargo \u001b[39Gomes out about the same per hour at full\u001b[80Gor half\u001b[88Gburn, and slower\u001b[105Gonly pays for\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.151, "o", "\u001b[?25l\u001b[H\u001b[5G25% \u001b[13G9\u001b[15G7\r\u001b[4C\u001b[1B12.5%\u001b[13G18.8\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[33G\u001b[22mThe\u001b[37Gstarter\u001b[45Gwith\u001b[50G2\u001b[52Gtotes\u001b[58Gof\u001b[61Gcopper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[4C\u001b[1Ba\u001b[7Gfull\u001b[12Ghold\u001b[17Gof\u001b[20Gcopper\u001b[27Git\u001b[30Gwould\u001b[36Gneed\u001b[41G3,390\u001b[47Gkg,\u001b[51Gfar\u001b[55Gpast\u001b[60Gits\u001b[64G0.8\u001b[68Gt\u001b[70Gtanks,\u001b[77Gso\u001b[80Ga\u001b[82Gheavy\u001b[88Gcargo\u001b[94Ghas\u001b[98Gto\u001b[101Ggo\u001b[104Gslow.\r\u001b[4C\u001b[1B\u001b[1mAutomatic refuelling:\u001b[22m each ship\u001b[37Ghas a \u001b[44Gefuel\u001b[50Gse\u001b[53Gting, on by defa\u001b[70Glt;\u001b[74Git's the flag\u001b[88Gbehind your checkbox. As the\u001b[117Gship\r\u001b[4C\u001b[1Bleaves\u001b[12Ga station, it f\u001b[28Glls its\u001b[36Gtanks at the market's live price,\u001b[70Gas far\u001b[77Gas\u001b[80Gthe company can pay after the\u001b[110Gdocking\r\u001b[2C\u001b[1B \u001b[5Gfee. A leg the tanks can't\u001b[32Gfinis\u001b[38G is refus\u001b[48Gd\u001b[50Gwi\u001b[53Gh a new \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m result.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStanding policy:\u001b[22m by default it\u001b[36Gprices eac\u001b[47G tr\u001b[51Gde at 100%,\u001b[63G50%, 25% and 12.5% burn and takes the on\u001b[104G making the most\r\u001b[4C\u001b[1Bp\u001b[7Gr hour. The owner can fix a burn \u001b[41Ghare instead.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison change:\u001b[22m th\u001b[23G cruise profile gets an op\u001b[50Gional\u001b[56Gcoast\u001b[62Gphase.\u001b[69GI\u001b[71Gadded\u001b[77Git\u001b[80Gas\u001b[83Ga\u001b[85Grow\u001b[89Gin\u001b[92GJettison's\u