[0.110, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gacceleration. That makes hard bur\u001b[39Gs drain the tanks f\u001b[59Gster, and \u001b[70Ghe faster\u001b[80Grun\u001b[84Gcosts\u001b[90Gmore\u001b[95Gfuel\u001b[100Goverall.\r\u001b[4C\u001b[1B\u001b[1mRefuelling:\u001b[22m auto\u001b[23Gtic at stations, as life support \u001b[57Gs. It's\u001b[65Ga per-ship\u001b[76Gse\u001b[79Gting, the checkbox, on by d\u001b[107Gfault. Wh\u001b[117Gle\r\u001b[4C\u001b[1Bdo\u001b[8Gked, \u001b[14Ghe ship \u001b[23Gops up\u001b[30Gits tanks at the\u001b[47Gvenue's live price as\u001b[69Gfar\u001b[73Gas \u001b[77Ghe\u001b[80Gcompany'\u001b[90Gfunds al\u001b[99Gow.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThree things are still open:\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mAnsw\u001b[8Gred Claude's questions\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  · How should a slower, cheaper run fly? (Either way, higher acceleration burns fuel faster.) → Coast (Recommended)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m· What should a standing trade policy optimise when it picks a burn? → Per hour, override (Recommended)\r\u001b[1B\u001b[39m     \u001b[8G\u001b[38;2;153;153;153mWhat should the drive fuel be called\u001b[47GIt's authored as a\u001b[66Gnew item; the name\u001b[85Gis easy \u001b[94Go change la\u001b[106Ger.) → Driv\u001b[118G \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mfuel\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWriting\u001b[11Gthe\u001b[15GW21\u001b[19Gplan\u001b[24Gon\u001b[27Gthose\u001b[33Ganswers.\u001b[42GFirst\u001b[48GI'm\u001b[52Gchecking\u001b[61Gthe\u001b[65Gcruise\u001b[72Gmaths\u001b[78Gand\u001b[82Gthe\u001b[86GOre–Brine\u001b[96Gdistance\u001b[105Gso\u001b[108Gthe\u001b[112Gnumbers\u001b[120GI\r\u001b[2C\u001b[1Bpick\u001b[8Ghold\u001b[13Gup.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m6\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe answers settle \u001b[23Ghe desig\u001b[32G. Writing the W21 plan\u001b[55Ginto\u001b[60GManifest's\u001b[71Gstage\u001b[77G4\u001b[79Gplan,\u001b[85Gand\u001b[89Grecording\u001b[99Gthe\u001b[103GJettison\u001b[112Gprovision\r\u001b[1B  in Jettison's roadmap.\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3G\u001b[38;2;235;159;127mPe\u001b[38;2;215;119;87mrambulating… \u001b[23G\u001b[38;2;153;153;153m2\u001b[45Gthought for 16s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
