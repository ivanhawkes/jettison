like its cargo-hold\u001b[71Gupgrade.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThose\u001b[9Gnumbers\u001b[17Gare\u001b[21Gstarting\u001b[30Gpoints\u001b[37Gfor\u001b[41Gyou\u001b[45Gto\u001b[48Greview.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits to push\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mManifest\u001b[14G\u001b[38;2;177;185;249mfeature-base\u001b[39m:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[38;2;177;185;249m21e9c6b\u001b[39m: the re-pin to\u001b[30GJettison\u001b[39G\u001b[38;2;177;185;249mf14c288\u001b[39m.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249ma264\u001b[13Gd\u001b[16G\u001b[39mW19\u001b[20Gslice 4.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mdce\u001b[12Gd1\u001b[20G\u001b[39mdone.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249m1dcd\u001b[12G4f\u001b[16G\u001b[39mfuel burn\u001b[26Gadded\u001b[32Gto\u001b[35Gthe\u001b[39Groadmap.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mf\u001b[9Ga4\u001b[12G9a\u001b[16G\u001b[39mth\u001b[19G W21 pl\u001b[27Gn.  \u001b[32G  \u001b[35G   \u001b[39G        \u001b[27;1H\u001b[24;3H\u001b[?25h"]
