[0.133, "o", "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd '/home/ivan/projects/manifest'\u001b[45G&&\u001b[48GCMAKE_BUILD_…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m./scripts/ci.sh --wer\u001b[28Gor\u001b[31G--asan --tidy --log build/gate.l\u001b[64Gg > bui\u001b[72Gd/gate-w19s4.out 2>&1; echo \"exit=$?\" >> \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mbuild/gate-w19s4.out; tail -25 build/gate-w19s4.out (14m 50s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m·\u001b[3G\u001b[38;2;228;144;112mDeliberating…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(30m\u001b[22G48s ·\u001b[28G↓\u001b[39m \u001b[38;2;153;153;153m56.8k tokens)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mTip: Use\u001b[15G/config\u001b[23Gto change your default permission mode (including Plan Mode)\r\u001b[1B\u001b[38;2;177;185;249m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/btw does a ship use fuel yet?\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;177;185;249m\u001b[1m/btw \u001b[22m\u001b[38;2;153;153;153mgive me a progrss report\u001b[39m\u001b[K\r\u001b[2B \u001b[3G  The SDK re-pin is done and W19 sl\u001b[39Gc\u001b[41G 4 is committed in Manifest;\u001b[70Gthe\u001b[74Gfull\u001b[79Ggate\u001b[84Gis\u001b[87Gstill\u001b[93Grunning,\u001b[102Gand\u001b[106Gnothing\u001b[114Ghas\r\u001b[1B    been pushed.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1m1. Re-pin (Manifest \u001b[38;2;177;185;249m21e9c6b\u001b[39m).\u001b[22m \u001b[38;2;177;185;249mMANIFEST_JETTISON_REVISION\u001b[39m now points\u001b[73Gat\u001b[76GJettison\u001b[85G\u001b[38;2;177;185;249mf14c288\u001b[39m.\u001b[94GThe\u001b[98Gparity\u001b[105Gcheck\u001b[111Gpasses\r\u001b[4C\u001b[1Band\u001b[9GManifest\u001b[18Gbuilds\u001b[25Gagainst\u001b[33Gthe\u001b[37Gnew\u001b[41Gpin.\u001b[46GSince\u001b[52G\u001b[38;2;177;185;249m0f973b2\u001b[60G\u001b[39mthe\u001b[64Gengine\u001b[71Gchanged\u001b[79Gonly\u001b[84Gits\u001b[88Gdevenv\u001b[95Gand\u001b[99Gdocs.\u001b[105G\u001b[38;2;177;185;249mf14c288\u001b[113G\u001b[39mis\u001b[116Gon\r\u001b[1B \u001b[3G  GitHub's \u001b[38;2;177;185;249mfeature-base\u001b[39m, so Manifest's CI\u001b[45Gcan\u001b[49Gfetch\u001b[55Git.\r\u001b[1B\u001b[K\r\u001b[1B    \u001b[1m2. W19 slice 4 (Manifest \u001b[38;2;177;185;249ma264c6d\u001b[39m).\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  - \u001b[1mPricing functions for W12's tenders:\r\u001b[2C\u001b[1B\u001b[22m    - \u001b[38;2;177;185;249mBudget\u001b[39m is the cost at the\u001b[35Gprice,\u001b[42Gtimes\u001b[48Gone\u001b[52Gplus\u001b[57Gthe\u001b[61Gurgency,\u001b[70Grounded\u001b[78Gup.\r\u001b[6C\u001b[1B-\u001b[9G\u001b[38;2;177;185;249mTenderPrice\u001b[21G\u001b[39mis\u001b[24Gthe\u001b[28Glowest\u001b[35Gask\u001b[39Gon\u001b[42Gthe\u001b[46Gvenue's\u001b[54Gbook,\u001b[60Gor\u001b[63Gthe\u001b[67Gnative\u001b[74Gprice\u001b[80Gwhen\u001b[85Gnothing\u001b[93Gis\u001b[96Goffered.\r\u001b[4C\u001b[1B \u001b[7G- \u001b[38;2;177;185;249mReliefs\u001b[39m returns\u001b[25Ga\u001b[27Grelief\u001b[34Gtender\u001b[41Gfor\u001b[45Geach\u001b[50Gessential\u001b[60Gneed\u001b[65Gwhose\u001b[71Gpressure\u001b[80Gis\u001b[83Gabove\u001b[89G0.25.\u001b[95GIt\u001b[98Gasks\u001b[103Gfor\u001b[107Gthe\u001b[111Gday's\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153m\u001b[3m↑/↓ to sc\u001b[14Gll · ⇧←/→ to browse · c to\u001b[41Gcopy ·\u001b[48Gf to fork · x to clear history · Esc to close\u001b[23m\u001b[39m\u001b[27;1H"]
