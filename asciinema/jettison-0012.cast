[0.129, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 34 +\u001b[38;2;248;248;242m`host`, `content`, `effects`, `remote`, `data`, `packaging`, `mod`, `fixture` (its longest cases       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 35 +\u001b[38;2;248;248;242mapart, as `fixture_cruise`\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m \u001b[48;2;4;71;0m`fixture_alone` \u001b[48;2;2;40;0mand `\u001b[48;2;4;71;0mfixture_prices\u001b[48;2;2;40;0m`, so the \u001b[48;2;4;71;0mfour\u001b[48;2;2;40;0m run side by side) and `sd\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242mk_import`, plus `console` when the TUI is enabled. The                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 36 \u001b[22m `cli_*` tests run the `manifest` executable from an unrelated directory with no display: both\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 37 \u001b[22m content forms start, and a missing source and bad command lines fail. `cli_serve` runs the server\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3\u001b[9G \u001b[22m with\u001b[16Gno\u001b[19Gcli\u001b[23Gnt, checks that it stepped, and stops it\u001b[64Gwith SIGINT; the `token_*` tests run\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/world/include/manifest/world/State.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[2m 293 \u001b[22m {\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 294 \u001b[14G\u001b[22m\u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46mstring\u001b[26G\u001b[39mneedId;\r\u001b[1B \u001b[3G   \u001b[2m 295 \u001b[22m   \u001b[38;2;166;226;46mdouble\u001b[21G\u001b[39mquantity{\u001b[38;2;190;132;255m0.0\u001b[39m};\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 296 -\u001b[38;2;248;248;242m  // Its unmet share smoothed over \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mday\u001b[48;2;61;1;0m, 0 to 1 (D-102).                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 296 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Its unmet share smoothed over \u001b[48;2;4;71;0man\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mhour\u001b[48;2;2;40;0m, 0 to 1 (D-102).\u001b[38;2;248;248;242m                                           \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[2m 297 \u001b[22m   \u001b[38;2;166;226;46mdouble\u001b[39m pressure{\u001b[38;2;190;132;255m0.0\u001b[39m};\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 298 \r\u001b[1B\u001b[22m     \u001b[2m 299 \u001b[22m   \u001b[38;2;166;226;46mbool\u001b[39m operator==(\u001b[38;2;166;226;46mconst\u001b[39m Unmet &) \u001b[38;2;166;226;46mconst\u001b[39m = \u001b[38;2;249;38;114mdefault\u001b[39m;\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[39m Searching for \u001b[1m1\u001b[22m pattern…\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;218;124;92mFrosting…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
