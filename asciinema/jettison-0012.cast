d\u001b[91Gtakes\u001b[97Gthe\u001b[101Gone\u001b[105Gmaking\u001b[112Gthe\u001b[116Gmost\r\u001b[2C\u001b[1B \u001b[5Gper hour. The owner\u001b[25Gcan fix\u001b[33Ga bu\u001b[38Gn share instead.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison change:\u001b[20G\u001b[22mthe\u001b[24Gcruise\u001b[31Gprofile\u001b[39Ggets\u001b[44Gan\u001b[47Goptional\u001b[56Gcoast\u001b[62Gphase.\u001b[69GI\u001b[71Gadded\u001b[77Git\u001b[80Gas\u001b[83Ga\u001b[85Grow\u001b[89Gin\u001b[92GJettison's\u001b[103Groadmap,\u001b[112Gcommitted\r\u001b[2C\u001b[1Bas \u001b[38;2;177;185;249mcc5c9cb\u001b[39m; it's\u001b[24Gplan's\u001b[31Gfirst slice.\u001b[44G  \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
