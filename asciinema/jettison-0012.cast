[0.004, "o", "\u001b[?25l\u001b[H\u001b[3G3\u001b[6G\u001b[1mRefuellin\u001b[16G.\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[1mAt the pu\u001b[18Gp (r\u001b[23Gcommended):\u001b[22m a Refuel\u001b[44Gcommand buys hydrogen from the venue's market straight\u001b[99Ginto\u001b[105Ghe tanks.\u001b[115GLiquid\r\u001b[7C\u001b[1Bhydrogen p\u001b[19Gcks\u001b[25Gly\u001b[28Gabout\u001b[34G8\u001b[36Gkg\u001b[39Ginto\u001b[44Ga\u001b[46Gtote,\u001b[52Gso\u001b[55G600\u001b[59Gkg\u001b[62Gloaded\u001b[69Gthrough\u001b[77Gthe\u001b[81Ghold\u001b[86Gwould\u001b[92Gtake\u001b[97G75\u001b[100Gof\u001b[103Gthe\u001b[107Gstarter's\u001b[117G160\r\u001b[5C\u001b[1B \u001b[8Gtotes.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- \u001b[1mThrough the hold:\u001b[26G\u001b[22mas\u001b[29Goxygen\u001b[36Gworks\u001b[42Gtoday.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mWha\u001b[11Ga standing policy optimises when it picks the burn.\u001b[22m\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mProfit per hour, with an override (recommended):\u001b[22m by default the policy picks the trade and burn that mak\u001b[113G the\u001b[K\r\u001b[7C\u001b[1Bm\u001b[10Gst per\u001b[17Ghour\u001b[22Gof\u001b[25Gthe\u001b[29Gjob,\u001b[34Gcounting\u001b[43Gfuel\u001b[48Gand\u001b[52Gthe\u001b[56Goxygen\u001b[63Gused\u001b[68Gin\u001b[71Gtransit.\u001b[80GYou\u001b[84Gcan\u001b[88Gfix\u001b[92Ga\u001b[94Gburn\u001b[99Gshare\u001b[105Gon\u001b[108Gthe\u001b[112Gpolicy\r\u001b[5C\u001b[1B \u001b[8Ginstead.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- \u001b[1mProfit per run:\u001b[22m this nearly always means the slowest burn.\r\u001b[7C\u001b[1B\u001b[1mYour setting:\u001b[22m the policy just flies at the burn share yo\u001b[65G give it.\u001b[K\r\u001b[7C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 2m 52s · done 2:56 am\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mFuel is a new type of drive fuel specific to the ships. Name to be decided upon. LPG is for cooking and vehicles on \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mplanets where solar and other energy types are less practical. Higher accelerations should use the fuel more rapidly.\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mCargo weight and ship weight both affect the burn rate. Space stations can offer refueling and it should be \u001b[39m          \r\u001b[1B  \u001b[38;2;255;255;255mavailable automatically the same as life support is (funds available, and at the discretion of the player, maybe a \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mcheckbox in the UI to enable this feature).\u001b[39m                                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[3GPerambulating… \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0012 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
