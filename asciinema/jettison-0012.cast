r\u001b[4C\u001b[1B5\u001b[7G% \u001b[13G5\u001b[15G7\r\u001b[4C\u001b[1B25\u001b[13G9\r\u001b[4C\u001b[1B12.5%\u001b[13G18.8\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCargo weight matters a lot.\u001b[33G\u001b[22mThe\u001b[37Gstarter\u001b[45Gwith\u001b[50G2\u001b[52Gtotes\u001b[58Gof\u001b[61Gcopper\u001b[68Gburns\u001b[74G432\u001b[78Gkg\u001b[81G(about\u001b[88G3,500\u001b[94Gcredits)\u001b[103Gat\u001b[106Gfull\u001b[111Gburn.\u001b[117GWith\r\u001b[2C\u001b[1B \u001b[5Ga full hold of copper it would need 3,390 \u001b[76G so a heavy\u001b[88Gcargo\u001b[94Ghas to go slow.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
