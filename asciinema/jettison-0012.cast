[0.006, "o", "\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNoted:\r\u001b[1B \u001b[3G- \u001b[1mThe fuel:\u001b[15G\u001b[22ma\u001b[17Gnew\u001b[21Gdrive\u001b[27Gfuel\u001b[32Gused\u001b[37Gonly\u001b[42Gby\u001b[45Gships.\u001b[52GLPG\u001b[56Gstays\u001b[62Ga\u001b[64Gplanetary\u001b[74Gfuel.\r\u001b[4C\u001b[1B\u001b[1mBurn rate:\u001b[22m I'll\u001b[21Gmake fuel b\u001b[33Grned per\u001b[42Gsecond proportional\u001b[62Gto the ship's total\u001b[82Gmass\u001b[87G(hull,\u001b[94Gcargo\u001b[100Gand\u001b[104Gfuel)\u001b[110Gtimes\u001b[116Gits\r\u001b[2C\u001b[1B \u001b[5Gacceleration. That makes hard burns drain the tanks faster,\u001b[65Gand\u001b[69Gt\u001b[71Ge fas\u001b[77Ger run costs more fuel\u001b[100Goverall.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefuelling:\u001b[22m automatic at\u001b[30Gstations, as l\u001b[45Gfe support is. It's\u001b[66G per-ship s\u001b[78Gtting, the checkbox, on by default.\u001b[114GWhile\r\u001b[2C\u001b[1B \u001b[5Gdocked, the\u001b[17Gship tops\u001b[27Gup\u001b[30Gi\u001b[32Gs ta\u001b[37Gks\u001b[41Gt\u001b[43Gthe venue's l\u001b[57Gve\u001b[60Gprice as far as\u001b[76Gthe company's funds all\u001b[100Gw.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThree\u001b[9Gthings\u001b[16Gare\u001b[20Gstill\u001b[26Gopen:\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m←  ☒ Slow burn  ☒ Policy goal \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Fuel name \u001b[39m\u001b[49m ✔ Submit  →\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mWhat should the drive fuel be called? (It's authored as a new item; the name is easy to change later.)\r\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mDrive fuel\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;2;153;153;153mPlain and clear in the UI and the market list.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[39mTorch fuel\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mAfter th\u001b[15G torch drives of\u001b[32Ghard scienc\u001b[45Gfiction, which hold 1 g for days.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[39mFusion pellets\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mDense frozen pell\u001b[24Gts for\u001b[31Ga fusion\u001b[40Gdrive; small tanks, high price per kg.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m4\u001b[6G\u001b[39mRe\u001b[9Gction mass\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mThe physics term for\u001b[27Gw\u001b[29Gat a drive throws\u001b[47Gout\u001b[51Gto pu\u001b[58G the shi\u001b[67G.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m5\r\u001b[2C\u001b[2B\u001b[39m6\u001b[27;1H\u001b[14;1H"]
