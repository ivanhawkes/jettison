[3.092, "o", "\u001b[?25l\u001b[H\u001b[6G-\u001b[8G\u001b[1mCoast (recommended):\u001b[22m burn\u001b[34Gup to\u001b[40Ga cruise spe\u001b[53Gd, coast,\u001b[63Gthen\u001b[68Gburn\u001b[73Gto\u001b[76Gstop.\u001b[82GIt\u001b[85Gneeds\u001b[91Ga\u001b[93Gsmall,\u001b[100Greusable\u001b[109GJettison\r\u001b[5C\u001b[1B \u001b[8Gchange: an option\u001b[26Gl coast phase in\u001b[43Gthe cruise\u001b[54Gprofile.\u001b[63G\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mThrottle:\u001b[22m accelerate\u001b[29Gthe\u001b[33Gwhole\u001b[39Gway\u001b[43Gat\u001b[46Ga\u001b[48Glower\u001b[54Grate.\u001b[60GNo\u001b[63Gengine\u001b[70Gchange,\u001b[78Gbut\u001b[82Git\u001b[85Gsaves\u001b[91Gmuch\u001b[96Gless\u001b[101Gfuel\u001b[106Gfor\u001b[110Gthe\u001b[114Gsame\r\u001b[2C\u001b[1B  \u001b[6G  extra time.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mCargo\u001b[12Gweight i\u001b[21G the burn.\u001b[32G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mYes (recommended):\u001b[22m fuel scales\u001b[39Gwith\u001b[44Gthe\u001b[48Ghull's\u001b[55Gmass\u001b[60Gplus\u001b[65Gthe\u001b[69Gcargo's,\u001b[78Gso\u001b[81Gheavy\u001b[87Gcheap\u001b[93Ggoods\u001b[99Gtend\u001b[104Gto\u001b[107Ggo\u001b[110Gslow\u001b[115Gand\r\u001b[5C\u001b[1B \u001b[8Glight valuable ones fast.\u001b[34G\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- \u001b[1mNo:\u001b[22m every\u001b[18Gcargo\u001b[24Gfaces\u001b[30Gthe\u001b[34Gsame\u001b[39Gtrade-off.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mRefuelling.\u001b[22m\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mAt the pump (recommended):\u001b[22m a Refuel\u001b[44Gcommand\u001b[52Gbuys hydrogen from the venu\u001b[80G's market str\u001b[94Gight into the \u001b[110Gnks. Liquid\r\u001b[7C\u001b[1Bhydrogen\u001b[17Gpacks\u001b[23Gonly\u001b[28Gabout\u001b[34G8\u001b[36Gkg\u001b[39Ginto\u001b[44Ga\u001b[46Gtote,\u001b[52Gso\u001b[55G600\u001b[59Gkg\u001b[62Gloaded\u001b[69Gthrough\u001b[77Gthe\u001b[81Ghold\u001b[86Gwould\u001b[92Gtake\u001b[97G75\u001b[100Gof\u001b[103Gthe\u001b[107Gstarter's\u001b[117G160\r\u001b[5C\u001b[1B \u001b[8Gtotes.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- \u001b[1mThrough the hold:\u001b[22m as oxygen works today.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mWhat a standing policy optimises when it picks the burn.\u001b[22m\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mProfit per hour, with an override (recommended):\u001b[22m b\u001b[59G default\u001b[68Gthe policy picks the trade and\u001b[99Gburn that make the\u001b[K\r\u001b[7C\u001b[1Bmo\u001b[12G per\u001b[17Ghour\u001b[22Gof\u001b[25Gthe\u001b[29Gjob,\u001b[34Gcounting\u001b[43Gfuel\u001b[48Gand\u001b[52Gthe\u001b[56Goxygen\u001b[63Gused\u001b[68Gin\u001b[71Gtransit.\u001b[80GYou\u001b[84Gcan\u001b[88Gfix\u001b[92Ga\u001b[94Gburn\u001b[99Gshare\u001b[105Gon\u001b[108Gthe\u001b[112Gpolicy\r\u001b[5C\u001b[1B \u001b[8Ginstead.\u001b[K\r\u001b[7C\u001b[1B\u001b[1mProfit per run:\u001b[22m this nearly always means the slowest burn.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8G\u001b[1mYour setting:\u001b[22G\u001b[22mthe\u001b[26Gpolicy\u001b[33Gjust\u001b[38Gflies\u001b[44Gat\u001b[47Gthe\u001b[51Gburn\u001b[56Gshare\u001b[62Gyou\u001b[66Ggive\u001b[71Git.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;65H\u001b[?25h"]
