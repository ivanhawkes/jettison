[0.013, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m49\u001b[16G\u001b[38;2;248;248;242mwindfall of five tim\u001b[37Gs Brine's copper t\u001b[56Grget\u001b[61Ghas her buy c\u001b[75Gpper\u001b[80Gthere\u001b[86Gand\u001b[90Gcarry\u001b[96Git\u001b[99Gto\u001b[102GOre;\u001b[107Geach\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1350 +\u001b[38;2;248;248;242m   fast-forwarded to the bytes stepping leaves. Every pin unmoved.                                   \r\u001b[9C\u001b[1B\u001b[49m\u001b[39m\u001b[2m1\u001b[13G\u001b[22m5.\u001b[16GClose-out.\r\u001b[9C\u001b[1B\u001b[2m2\u001b[13G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1353 \u001b[13G\u001b[22m##\u001b[16GHandoff\u001b[24Gto\u001b[27Gstage\u001b[33G5\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands,\u001b[49Gdi\u001b[53Gnot run\u001b[61G\u001b[1m1\u001b[22m oth\u001b[67Gr call\u001b[K\r\u001b[2C\u001b[1B⎿\u001b[5G $ cd '/\u001b[15Gme/ivan/projects/\u001b[33Gan\u001b[36Gfest' && git\u001b[49Gadd\u001b[53G-A\u001b[56Gdocs\u001b[61Gsource\u001b[68G&&\u001b[71Ggit\u001b[75Gcommit\u001b[82G-q\u001b[85G-m\u001b[88G'Trade:\u001b[96Gtenders\u001b[104Gpriced\u001b[111Gby\u001b[114Gneed,\r\u001b[5C\u001b[1Band a shortage and a glut moving a trader\u001b[K\r\u001b[2C\u001b[1B \u001b[5G W19'\\''s\u001b[15Gf\u001b[17Gurth slic\u001b[27G (D-102). Budget\u001b[44Gis\u001b[47Ga\u001b[49Gtender'\\''s\u001b[61Gunits\u001b[67Gat\u001b[70Gthe\u001b[74Gprice\u001b[80Gtimes…\r\u001b[2C\u001b[1B⎿\u001b[5G 1\u001b[8Gacti\u001b[14G not run · permissi\u001b[34Gn d\u001b[38Gnied\u001b[K\r\u001b[5C\u001b[1B\u001b[2m│\u001b[8G\u001b[22mReason:\u001b[16GPreToolUse:Bash\u001b[32Ghook\u001b[37Gerror:\u001b[44Ggit\u001b[48Gadd\u001b[52G-A/--all/.\u001b[63Gwould\u001b[69Gstage\u001b[75G./asciinema:\u001b[88Gadd\u001b[92Gthe\u001b[96Gfiles\u001b[102Gby\u001b[105Gname.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3