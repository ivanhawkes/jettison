[0.002, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m\u001b[1ma264c6d\u001b[39m — slice 4.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFunction\u001b[14G for\u001b[19GW12\u001b[23G\u001b[22m(in\u001b[27G\u001b[38;2;177;185;249mTrade.h\u001b[39m):\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mBudget(price, units, urg\u001b[32Gncy)\u001b[39m:\u001b[38Ga\u001b[40Gtender's\u001b[49Gbudget,\u001b[57Grounded\u001b[65Gup.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mTend\u001b[12GrPrice\u001b[39m: the lowest ask resting on the venue's book, or the\u001b[71Gnative\u001b[78Gprice\u001b[84Gwhen\u001b[89Gnothing\u001b[97Gis\u001b[100Goffered.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mR\u001b[9Gli\u001b[12Gfs\u001b[39m: for\u001b[20Geach essential\u001b[35Gn\u001b[37Ged with pressure above 0.25, the day's sho\u001b[80Gtfall i\u001b[89Gwhole totes o\u001b[103G its cheapest\r\u001b[4C\u001b[1B \u001b[7Ggood, budgeted at\u001b[25Gurg\u001b[30Gcy 3\u001b[35G× pressure.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BThese\u001b[11Ghave\u001b[16Gunit\u001b[21Gtests\u001b[27Gin\u001b[30Gthe\u001b[34G\u001b[38;2;177;185;249mtrade\u001b[40G\u001b[39msuite.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFixture test \u001b[38;2;177;185;249mfixture_prices\u001b[39m.\u001b[34G\u001b[22mSix sim\u001b[42Glated\u001b[48Gdays\u001b[53Gwith\u001b[58Gtwo\u001b[62Gtraders\u001b[70Gproduced\u001b[79Gno\u001b[82Gshortage\u001b[91Gor\u001b[94Gglut\u001b[99Gby\u001b[102Gthemselves:\u001b[114Gevery\r\u001b[2C\u001b[1B \u001b[5Gbroker stayed near its target and no need's pressure\u001b[58Grose. So the test create\u001b[83G them:\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mShortage:\u001b[22m a\u001b[19Gs\u001b[21Gcond player, Bo, buys out Brin\u001b[52G'\u001b[54G furs. Ada's\u001b[67Gfirs\u001b[72G job ch\u001b[80Gnges from\u001b[90Gcopper\u001b[97G(estimated\u001b[108Gprofit\u001b[115G9,542)\r\u001b[4C\u001b[1B \u001b[7Gto carrying\u001b[19GOre's furs to Brine (26,615).\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGlut:\u001b[22m Br\u001b[17Ge's broker is given five times its\u001b[52Gcopper\u001b[59Gtarget.\u001b[67GAda\u001b[71Gthen\u001b[76Gbuys\u001b[81Gcopper\u001b[88Gat\u001b[91GBrine\u001b[97Gand\u001b[101Gcarries\u001b[109Git\u001b[112Gto\u001b[115GOre.\r\u001b[6C\u001b[1BBoth runs, fast-forwarded, match a\u001b[42Gstep-by-\u001b[51Gtep run\u001b[59Gbyte for byte, and no\u001b[81Gpinn\u001b[86Gd\u001b[88Ghash moved.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision\u001b[12Gfor\u001b[16Gyou:\u001b[21Gto\u001b[24Gset\u001b[28Gup\u001b[31Gthese\u001b[37Gshocks,\u001b[45Gthe\u001b[49Gtest\u001b[54Gwrites\u001b[61Gto\u001b[64Gthe\u001b[68Gworld\u001b[74Gdirectly.\u001b[84GIt\u001b[87Ggives\u001b[93GBo's\u001b[98Gcompany\u001b[106G1,000,000\r\u001b[2C\u001b[1Bcredits and adds copper to Brine's bro\u001b[42Ger. Tha\u001b[50G breaks the fixture's \"only \u001b[79Gommands\u001b[87Gaft\u001b[91Gr\u001b[93Gb\u001b[95Gotstra\u001b[102G\" style, as the\r\u001b[2C\u001b[1Bexisting \u001b[38;2;177;185;249mprofile.reset()\u001b[39m already does. If you'd\u001b[51Grather\u001b[61Gse sho\u001b[68Gtages come \u001b[80Gut of a long\u001b[93Gnatural run, it would n\u001b[117Ged\r\u001b[2C\u001b[1Bcontent changes or many simul\u001b[33Gted days\u001b[42Gper test.\u001b[K\r\u001b[2C\u001b[1B       \u001b[11G       \u001b[19G  \u001b[22G    \u001b[27G         \u001b[37G    \u001b[42G   \u001b[46G \u001b[27;1H\u001b[24;3H\u001b[?25h"]
