u001b[77Gregional\u001b[86Gtreasury.\r\u001b[6C\u001b[1BE\u001b[9Gch employer \u001b[22Gf\u001b[24Ge\u001b[26Gs everything it has made\u001b[51Gto its venue's broke\u001b[73Gat th\u001b[79G broker's bid.\u001b[K\r\u001b[6C\u001b[1BHouseholds buy whole\u001b[28Gtotes through\u001b[42Gthe\u001b[46Gbook, cheapest grain first. Their\u001b[80Go\u001b[82Gders never rest\u001b[98Gon\u001b[101Gthe\u001b[105Gbook.\u001b[111GThey\u001b[116Gthen\r\u001b[4C\u001b[1B \u001b[7Gc\u001b[9Gn\u001b[11Gume exactly that\u001b[28Gminute's need\u001b[42Gfrom a pantry tha\u001b[61Gkeeps\u001b[67Gwhat's\u001b[74Gleft of opened totes.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GOptional goods are bought only once every\u001b[49Gessential is m\u001b[64Gt.\u001b[67GS\u001b[69Gortages are recorded, and health\u001b[102Gand\u001b[106Ghappiness\u001b[116Gmove\r\u001b[4C\u001b[1B \u001b[7Gwi\u001b[10Gh them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBrokers\u001b[22m still\u001b[19Gbid\u001b[23Gonly\u001b[28Gwhat\u001b[33Gtheir\u001b[39Gfunds\u001b[45Gcover.\u001b[52GNothing\u001b[60Grefills\u001b[68Gany\u001b[72Gaccount,\u001b[81Gand\u001b[85Gnothing\u001b[93Gmoves\u001b[99Ggoods\u001b[105Gbetween\u001b[113Gvenues.\r\u001b[2C\u001b[1B \u001b[5G       \u001b[13G     \u001b[19G   \u001b[23G    \u001b[28G    \u001b[33G     \u001b[39G     \u001b[45G  \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
