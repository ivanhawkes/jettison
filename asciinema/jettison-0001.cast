;242m() == \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m10\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m);                                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 68 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m9\u001b[13G\u001b[22m\u001b[38;2;117;113;94m// Ore's broker holds the venue's stock, 21 totes of furs, with the authored treasury.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m70\u001b[13G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[39m entt::entity broker = hosted.identities.\u001b[38;2;166;226;46mFind\u001b[39m(Kind::Broker, \u001b[38;2;230;219;116m\"VenueOreHighport\"\u001b[39m);\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/world/tests/WorldTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[2m 71 \u001b[22m \u001b[12G \u001b[38;2;166;226;46mREQUIRE\u001b[39m(br\u001b[24Gk\u001b[26Gr\u001b[28G!= e\u001b[33Gtt::null);\r\u001b[7C\u001b[1B\u001b[2m2\u001b[13G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(registry.\u001b[38;2;166;226;46mget\u001b[39m<Broker>(broker).operatorId\u001b[59G==\u001b[62G\u001b[38;2;230;219;116m\"OrganisationAnvilPortAuthority\"\u001b[39m);\r\u001b[7C\u001b[1B\u001b[2m3\u001b[13G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[39m Stock &stock = registry.\u001b[38;2;166;226;46mget\u001b[39m<Stock>(b\u001b[56Goker);\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 74 -\u001b[38;2;248;248;242m  CHECK(stock.holdings.size() == \u001b[48;2;92;2;0m8\u001b[48;2;61;1;0m);                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 74 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(stock.holdings.\u001b[38;2;166;226;46msize\u001b[38;2;248;248;242m() == \u001b[38;2;190;132;255m\u001b[48;2;4;7