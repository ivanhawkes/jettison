5Grun\u001b[109Gthrough\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gfixed-step scheduler and its existing edges.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRunning only on due turns\u001b[22m i\u001b[34Galready handled\u001b[50Ginside\u001b[57GManifest's\u001b[68Gown\u001b[72Gsystems.\u001b[81G\u001b[38;2;177;185;249mmanifest.brokers\u001b[98G\u001b[39mdoes\u001b[103Git\u001b[106Gtoday,\u001b[113Gso\u001b[116GW04\r\u001b[2C\u001b[1B \u001b[5Gdoesn't need a cadence feature in the e\u001b[45Ggine\u001b[50Gsche\u001b[55Guler.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSaves\u001b[22m reus\u001b[16G the world serialisation Manifest'\u001b[51G components\u001b[63Galready\u001b[71Guse.\r\u001b[4C\u001b[1B\u001b[1mThe one open design question\u001b[22m is \"a broker'\u001b[48G demand beyond\u001b[63Gits funds\", which\u001b[81GW03\u001b[85Gleft\u001b[90Gto\u001b[93GW04.\u001b[98GThat\u001b[103Gis\u001b[106Gbroker\u001b[113Gpolicy,\r\u001b[2C\u001b[1B \u001b[5Gso it belongs to Manifest.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gthe\u001b[10Gwork\u001b[15Gturns\u001b[21Gup\u001b[24Ga\u001b[26Greusable\u001b[35Ggap,\u001b[40GI'd\u001b[44Gpro\u001b[76Gd\u001b[78GW17.\u001b[83GOtherwise\u001b[93Gthis\u001b[98Grepo\u001b[103Gonly\u001b[108Ggets\u001b[113Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
