[0.017, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ every new region will need those trade goods added to it as a very minium\u001b[39m                                             \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m2\u001b[14G\u001b[38;2;248;248;242m    \u001b[38;2;230;219;116m\"'VenueOreHighport' market 'ItemCopper' region 'RegionBrineCoast' is not one it serves\"\u001b[38;2;248;248;242m);\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[14G\u001b[38;2;117;113;94m// Every region trades the essentials, at the least (W04).\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[14G\u001b[38;2;166;226;46mCheckRefused\u001b[38;2;248;248;242m(                                                                                     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[18G\u001b[38;2;248;248;242mtrading, \u001b[38;2;166;226;46more\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"[{i\u001b[36GemId: ItemCopper,\u001b[54GregionI\u001b[62G: RegionOreH\u001b[75Gghlands, production: 2, stock: 1}]\"\u001b[38;2;248;248;242m),\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242m    \u001b[38;2;230;219;116m\"'VenueOreHighport' serves a region but trades no 'ItemRice', which 'NeedStapleFood' needs\"\u001b[38;2;248;248;242m);\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 727 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCheckRefused\u001b[38;2;248;248;242m(                                                                                       \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m8\u001b[14G\u001b[22m    trading, \u001b[38;2;166;226;46mregion\u001b[39m(\u001b[38;2;230;219;116m\"health: 101\"\u001b[39m),\u001b[50G\u001b[38;2;230;219;116m\"'RegionBrineCoast' health and happiness must be in [0, 100]\"\u001b[39m);\r\u001b[7C\u001b[1B\u001b[2m29\u001b[14G\u001b[22m\u001b[38;2;166;226;46mCheckRefused\u001b[39m(\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 730 \u001b[18G\u001b[22mtrading,\u001b[27G\u001b[38;2;