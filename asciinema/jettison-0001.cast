[2.074, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mHow the economy works now.\u001b[30G\u001b[22mIt\u001b[33Gis\u001b[36Ga\u001b[38Gnew\u001b[42Gsystem,\u001b[50G\u001b[38;2;177;185;249mmanifest.economy\u001b[39m,\u001b[68Gthat\u001b[73Gruns\u001b[78Gafter\u001b[84Gexpired\u001b[92Gorders\u001b[99Gare\u001b[103Gcleared\u001b[111Gand\u001b[115Gbefore\r\u001b[2C\u001b[1Bthe brokers requote:\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEvery step\u001b[22m, each region's\u001b[31Gemployer\u001b[40Gworks\u001b[46Gits\u001b[50Gbatches.\u001b[59GA\u001b[61Gbatch\u001b[67Gis\u001b[70Gwhole\u001b[76Gtotes,\u001b[83Gabout\u001b[89Ga\u001b[91Gday's\u001b[97Goutput,\u001b[105Gand\u001b[109Gits\u001b[113Gwage\r\u001b[2C\u001b[1B \u001b[5Gbill (30% of the\u001b[22Goutput\u001b[31Gbase value) i\u001b[46Gset\u001b[50Gaside when\u001b[61Git starts. Work sp\u001b[80Geds up or slows with the\u001b[105Gregion's health\r\u001b[4C\u001b[1Band happiness.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAt the end of each 60-second turn\u001b[22m:\r\u001b[2C\u001b[1B \u001b[5G- Wages earned so far are paid, rounded\u001b[45Gdown,\u001b[51Gwith\u001b[56G10%\u001b[60Gwithheld\u001b[69Gfor\u001b[73Gthe\u001b[77Gregional\u001b[86Gtreasury.\r\u001b[6C\u001b[1BE\u001b[9Gch employer \u001b[22Gf\u001b[24Ge\u001b[26Gs everything it has made\u001b[51Gto its venue's broke\u001b[73Gat th\u001b[79G broker's bid.\u001b[K\r\u001b[6C\u001b[1BHouseholds buy whole\u001b[28Gtotes through\u001b[42Gthe\u001b[46Gbook, cheapest grain first. Their\u001b[80Go\u001b[82Gders never rest\u001b[98Gon\u001b[101Gthe\u001b[105Gbook.\u001b[111GThey\u001b[116Gthen\r\u001b[4C\u001b[1B \u001b[7Gc\u001b[9Gn\u001b[11Gume exactly that\u001b[28Gminute's need\u001b[42Gfrom a pantry tha\u001b[61Gkeeps\u001b[67Gwhat's\u001b[74Gleft of opened totes.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GOptional goods are bought only once every\u001b[49Gessential is m\u001b[64Gt.\u001b[67GS\u001b[69Gortages are recorded, and health\u001b[102Gand\u001b[106Ghappiness\u001b[116Gmove\r\u001b[4C\u001b[1B \u001b[7Gwi\u001b[10Gh them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBrokers\u001b[22m still\u001b[19Gbid\u001b[23Gonly\u001b[28Gwhat\u001b[33Gtheir\u001b[39Gfunds\u001b[45Gcover.\u001b[52GNothing\u001b[60Grefills\u001b[68Gany\u001b[72Gaccount,\u001b[81Gand\u001b[85Gnothing\u001b[93Gmoves\u001b[99Ggoods\u001b[105Gbetween\u001b[113Gvenues.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mYour rule that every region trades the essentials\u001b[53G\u001b[22mis\u001b[56Gnow\u001b[60Ga\u001b[62Gcontent\u001b[70Gcheck.\u001b[77GThe\u001b[81Gtrading\u001b[89Gfixture\u001b[97Ggained\u001b[104Ggrain,\u001b[111Gwater\u001b[117Gand\r\u001b[2C\u001b[1Bmedical supplies on both planets:\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mOre\u001b[22m grows r\u001b[17Gce\u001b[20Ga\u001b[22Gd \u001b[25Gats.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mB\u001b[7Gine\u001b[22m grows whe\u001b[21Gt and barley\u001b[34Gand\u001b[38Gmakes\u001b[44Gthe\u001b[48Gmedical\u001b[56Gsupplies.\r\u001b[4C\u001b[1B\u001b[1mWater:\u001b[22m each\u001b[17Gplanet draws its\u001b[34Gown.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G      \u001b[12G    \u001b[17G      \u001b[24G     \u001b[30G   \u001b[34G    \u001b[27;1H\u001b[24;3H\u001b[?25h"]
