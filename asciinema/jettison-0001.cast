[0.005, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m7\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm reading the\u001b[19GManifes\u001b[28Geconomy plan's W04 rule\u001b[53G(house\u001b[60Golds,\u001b[66Gpayroll, condit\u001b[82Gon, production)\u001b[98Gto\u001b[101Gbuild\u001b[107Gthe\u001b[111Gcapability\r\u001b[2C\u001b[1Bmap.\u001b[8GNothing\u001b[16Ghas\u001b[20Gbeen\u001b[25Gchanged\u001b[33Gyet.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m7\u001b[22m files, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gfinished\u001b[17Greading.\u001b[26GThe\u001b[30Gengine\u001b[37Gside\u001b[42Gneeds\u001b[48Gnothing.\u001b[57GManifest's\u001b[68Gplans\u001b[74Gleave\u001b[80Gseveral\u001b[88GW04\u001b[92Grules\u001b[98Gopen,\u001b[104Gthough,\u001b[112Gand\u001b[116Gthey\r\u001b[2C\u001b[1Bsay not to invent them, so I need four\u001b[42Gchoices\u001b[50Gfrom\u001b[55Gyou\u001b[59Gbefore\u001b[66GI\u001b[68Gwrite\u001b[74Gcode.\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Producer \u001b[39m\u001b[49m ☐ Wages  ☐ Households  ☐ Trading fixture  ✔ Submit  →\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mWho makes a venue's `production` rows (Ore's furs, Forge's grain), and who owns the output?\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mRegional employer (Recommended)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mOne native employer per region, with its own account and stock, producing into its holding at the venue that serves\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mthe region and selling to the broker through the book each turn. The plan's chain: producer, warehouse, broker. \r\u001b[5C\u001b[1BNeeds authored employer funds, and each production row naming its region (Forge's highport serves four).\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;153;153;153m2.\u001b[39m The broker produces\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mOutput goes straight in\u001b[32Gthe\u001b[36Gvenue broker's stock a\u001b[59Gd\u001b[61Gthe b\u001b[67Goker pays the region's payroll. Fewer pieces, but it \r\u001b[5C\u001b[1Bmerges the producer and the merchant, which the plan keeps apart.\r\u001b[1B\u001b[39m  \u001b[38;2;153;153;153m3. Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  4. Chat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select ·\u001b[19GTab/Arrow keys to navigate\u001b[46G· Esc to cancel\u001b[39m\u001b[K\u001b[27;1H\u001b[16;1H"]
[0.165, "o", "\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm reading the Manifest economy plan's\u001b[43GW04\u001b[47Grules\u001b[53G(households,\u001b[66Gpayroll,\u001b[75Gcondition,\u001b[86Gproduction)\u001b[98Gto\u001b[101Gbuild\u001b[107Gthe\u001b[111Gcapability\r\u001b[2C\u001b[1Bmap.\u001b[8GNothing\u001b[16Ghas\u001b[20Gbeen\u001b[25Gchanged\u001b[33Gyet.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m7\u001b[22m files, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've finished reading. The engine side\u001b[42Gneeds\u001b[48Gnothing.\u001b[57GManifest's\u001b[68Gplans\u001b[74Gleave\u001b[80Gseveral\u001b[88GW04\u001b[92Grules\u001b[98Gopen,\u001b[104Gthough,\u001b[112Gand\u001b[116Gthey\r\u001b[2C\u001b[1Bsay\u001b[7Gnot\u001b[11Gto\u001b[14Ginvent\u001b[21Gthem,\u001b[27Gso\u001b[30GI\u001b[32Gneed\u001b[37Gfour\u001b[42Gchoices\u001b[50Gfrom\u001b[55Gyou\u001b[59Gbefore\u001b[66GI\u001b[68Gwrite\u001b[74Gcode.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWorking…\u001b[K\u001b[27;1H\u001b[16;1H"]
