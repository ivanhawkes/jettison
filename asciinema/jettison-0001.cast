;2;248;248;242m -v \u001b[38;2;166;226;46mcommand\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m'%q '\u001b[38;2;248;248;242m claude \u001b[48;2;4;71;0m-n \u001b[38;2;230;219;116m\u001b[48;2;2;40;0m\"\u001b[38;2;248;248;242m$\u001b[48;2;4;71;0mname\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$\u001b[48;2;2;40;0m@\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m                                                         \u001b[39m\u001b[49m\u001b[K\r\u001b[1B     \u001b[2m 26 \u001b[22m \u001b[38;2;117;113;94m# asciinema refuses to overwrite a file, so two sessions started at once cannot share one.\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 25 -\u001b[38;2;248;248;242mexec asciinema rec --command \"$command\" \"$\u001b[48;2;92;2;0m(printf '%s\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0mclaude-%04d\u001b[48;2;61;1;0m.cast\u001b[48;2;92;2;0m' \u001b[48;2;61;1;0m\"\u001b[48;2;92;2;0m$directory\" \"$next\")\"\u001b[48;2;61;1;0m         \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 27 +\u001b[38;2;166;226;46mexec\u001b[38;2;248;248;242m asciinema rec --\u001b[38;2;166;226;46mcommand\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$command\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m \u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$\u001b[48;2;4;71;0mdirectory\u001b[38;2;230;219;116m\u001b[48;2;2;40;0m/\u001b[38;2;248;248;242m\u001b[48;2;4;71;0m$name\u001b[38;2;230;219;116m\u001b[48;2;2;40;0m.cast\"\u001b[38;2;248;248;242m                                        \u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Searching for \u001b[1m1\u001b[22m pattern, running \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ tmp=$(mktemp -d) && mkdir -p \"$tmp/scripts\" \"$tmp/asciinema\" && touch \"$tmp/asciinema/jettison-0001.cast\" && sed \r\u001b[1B\u00