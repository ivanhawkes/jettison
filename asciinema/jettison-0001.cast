[0.060, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 1m 59s · done 3:53 pm\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mThey need to also trade the essentials. I just wanted to confirm that this is for manifest and not the cut-down game \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mthat astralis uses. Give them all the essentials as needs and trade goods.\u001b[39m                                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Yes, this is for Manifest. The trading fixture's \u001b[38;2;177;185;249mgameMode\u001b[39m is \u001b[38;2;177;185;249mmanifest\u001b[39m, and both scenarios in \u001b[38;2;177;185;249mdata/scenarios/\u001b[39m run in\u001b[K\r\u001b[2C\u001b[1Bthe\u001b[7GManifest\u001b[16Gmode;\u001b[22GAstralis\u001b[31Ghas\u001b[35Gno\u001b[38Gscenario\u001b[47Gof\u001b[50Gits\u001b[54Gown.\u001b[59GI'll\u001b[64Ggive\u001b[69Gthe\u001b[73Gtrading\u001b[81Gfixture's\u001b[91Gtwo\u001b[95Gregions\u001b[103Gall\u001b[107Gthree\u001b[113Gneeds\r\u001b[1B \u001b[3Gand add grain, water and medical supplies \u001b[46Go both markets.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNext I'm \u001b[13Geading \u001b[21Ghe\u001b[24Gtrade and world code\u001b[45Gs\u001b[48GI can lay out\u001b[62GW04's\u001b[68Gstate.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mR\u001b[5Gading \u001b[1m3\u001b[22m files,\u001b[20Grunning \u001b[1m1\u001b[30G\u001b[22mshell comman\u001b[43G…\u001b[45G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && rg -n -A12 \"itemId: \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m(ItemRice|ItemWheat|ItemOats|ItemBarley|ItemDrinkingWater|ItemBasicMedicalSupplies|ItemFurs|ItemCopper)\\b\" \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mdata/trade-\u001b[18Gt\u001b[20Gms\u001b[23G| rg \"itemId|basePrice|unit|unitsPerCubicMetre|density\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ every new region will need those trade goods added to it as a very minium\u001b[39m                                             \r\u001b[2C\u001b[6B\u001b[49m\u001b[2mPress up to edit queued messages\u001b[36G\u001b[22m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
