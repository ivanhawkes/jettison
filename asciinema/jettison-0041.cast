[0.018, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mAbovePeak\u001b[39m and rewor\u001b[25Ged its\u001b[32Gdocs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22mone\u001b[19Gtidy\u001b[24Gfinding\u001b[32G(\u001b[38;2;177;185;249muse auto\u001b[39m)\u001b[43Gin\u001b[46GL53's\u001b[52Gclient\u001b[59Gcode,\u001b[65Gnow\u001b[69Gfixed.\r\u001b[2C\u001b[2B\u001b[1mL54, naming the starting ship\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GA\u001b[7Gnew\u001b[11Gplayer\u001b[18Gnames\u001b[24Gthemselves,\u001b[36Gtheir\u001b[42Gcompany\u001b[50Gand\u001b[54Gtheir\u001b[60Gstarting\u001b[69Gship\u001b[74Gin\u001b[77Gone\u001b[81Gstep,\u001b[87Gfrom\u001b[92Gthe\u001b[96Gstart\u001b[102Gscreen\u001b[109Gor\u001b[112Gwith\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249mfound \"<company>\" \"<ship>\"\u001b[39m in the client's console.\u001b[57GUnder\u001b[63GD-123\u001b[69Gthat\u001b[74Gfounding\u001b[83Gis\u001b[86Gthe\u001b[90Gship's\u001b[97Gone\u001b[101Gnaming;\u001b[109Grenaming\r\u001b[1B    waits on\u001b[14Gapproval, which\u001b[30Gis\u001b[33G't\u001b[36Gbuilt.\r\u001b[2C\u001b[1B-\u001b[5GThe ship saves its name, the snapshot\u001b[43Gcarries\u001b[51Git\u001b[54Gover\u001b[59Gthe\u001b[63Gnetwork,\u001b[72Gand\u001b[76Gthe\u001b[80Gcompany\u001b[88Gand\u001b[92Gflight\u001b[99Gscreens\u001b[107Gshow\u001b[112Git\r\u001b[4C\u001b[1Binstead of the ID.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GBad names are refused with the reason: empty, over a fixed length, or containing control characters. The length\r\u001b[4C\u001b[1Bcounts\u001b[12Gcharacters,\u001b[24Gso\u001b[27GJapanese\u001b[36Gnames\u001b[42Gwork.\r\u001b[2C\u001b[1B- Ships made by the administrator\u001b[37Gor\u001b[40Gfor\u001b[44GAI\u001b[47Gtraders\u001b[55Gget\u001b[59Ga\u001b[61Gpredictable\u001b[73Gdefault\u001b[81Gname,\u001b[87Gso\u001b[90Gno\u001b[93Gship\u001b[98Ggoes\u001b[103Gnameless.\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gexpect\u001b[14Git\u001b[17Gto\u001b[20Gmove\u001b[25Gworld\u001b[31Ghash\u001b[36Gpins;\u001b[42Gthe\u001b[46Gagent\u001b[52Ghas\u001b[56Gto\u001b[59Gshow\u001b[64Geach\u001b[69Gone\u001b[73Gis\u001b[76Gfile\u001b[81Glayout\u001b[88Gonly,\u001b[94Gnot\u001b[98Ga\u001b[100Gchange\u001b[107Gin\u001b[110Ggame\u001b[115Gstate.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPending\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot pushed:\u001b[17G\u001b[22mJettison\u001b[26Ghas\u001b[30Gthe\u001b[34Gmotion\u001b[41Gprofile,\u001b[50GJ26's\u001b[56Gexact\u001b[62Gdarks\u001b[68Gand\u001b[72Gthe\u001b[76G\"cruise\"\u001b[85Grename.\u001b[93GManifest\u001b[102Ghas\u001b[106GL53\u001b[110Gand\u001b[114Gits\r\u001b[1B \u001b[3G  tidy fix. Both pass their gates. Should\u001b[45GI\u001b[47Gpush\u001b[52Gboth\u001b[57Gnow,\u001b[62Gor\u001b[65Gafter\u001b[71GL54?\r\u001b[1B  - \u001b[1mAn open question from L53:\u001b[22m a mod that requires another mod has to name it \u001b[38;2;177;185;249mmod:copper\u001b[39m on the server but \u001b[38;2;177;185;249mcopper\u001b[115G\u001b[39min\u001b[118Gthe\u001b[27;1H\u001b[21;3H\u001b[?25h"]
