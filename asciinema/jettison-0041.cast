[0.359, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 18 \u001b[22m headless_use_lavapipe\u001b[K\r\u001b[6C\u001b[1B\u001b[2m19\u001b[11G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m0\u001b[11G\u001b[22mwork=\u001b[38;2;230;219;116m\"\u001b[39m$(mktemp -d)\u001b[38;2;230;219;116m\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 21 +\u001b[38;2;117;113;94m# A crash report goes under the run's own state directory, never the real home's.\u001b[38;2;248;248;242m                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 22 +\u001b[38;2;166;226;46mexport\u001b[38;2;248;248;242m XDG_STATE_HOME=\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$work\u001b[38;2;230;219;116m/state\"\u001b[38;2;248;248;242m                                                                    \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[2m 23 \u001b[22m server=\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 24 \u001b[11G\u001b[22m\u001b[38;2;166;226;46mtrap\u001b[16G\u001b[38;2;230;219;116m'if [[ -n \"$server\" ]]; then kill -KILL \"$server\" 2>/dev/null || true; fi; rm -rf \"$work\"'\u001b[107G\u001b[39mEXIT\r\u001b[1B \u001b[3G   \u001b[2m 25 \u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The server creates its crash directory at start-up, so \u001b[38;2;177;185;249mcli_serve_missing_tokens\u001b[39m also runs it under your real home.\r\u001b[2C\u001b[1BGiving that test its own state directory as well.\r\u001b[2C\u001b[7B\u001b[K\u001b[27;1H\u001b[20;3H\u001b[?25h"]
