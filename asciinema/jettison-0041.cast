nt_serve\u001b[56G\u001b[39mincluded.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Greview\u001b[15Git\u001b[18Gwhen\u001b[23Git\u001b[26Gfinishes,\u001b[36Grebase\u001b[43Git,\u001b[47Grun\u001b[51GManifest's\u001b[62Ggate\u001b[67Gand\u001b[71Gmerge.\u001b[78GThe\u001b[82Gother\u001b[88Gthree\u001b[94Glanes\u001b[100Gare\u001b[104Gfree.\r\u001b[2C\u001b[1B    \u001b[8G      \u001b[15G  \u001b[18G    \u001b[23G  \u001b[26G         \u001b[36G      \u001b[43G   \u001b[76G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
