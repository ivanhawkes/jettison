[0.269, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mAgent\u001b[9G\"J26\u001b[14Gtheme\u001b[20Gleftovers\"\u001b[31Gfinished\u001b[38;2;153;153;153m · 14m 22s\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ26's\u001b[9Gexact\u001b[15Gdarks\u001b[21Gare\u001b[25Gdone,\u001b[31Gwith\u001b[36Gthe\u001b[40Greference\u001b[50Gframes\u001b[57Gand\u001b[61Gsmoke\u001b[67Gtest\u001b[72Gunchanged.\u001b[83GOn\u001b[86Gthe\u001b[90Gswap\u001b[95Gbullet,\u001b[103Gthe\u001b[107Gagent\u001b[113Gmade\u001b[118Gthe\r\u001b[1B \u001b[3Gtheme\u001b[9Gindependent\u001b[21Gof the attachment rath\u001b[45G than det\u001b[55Gcti\u001b[59Gg\u001b[61Ga swap. That retir\u001b[80Gs the\u001b[89Gme's half; \u001b[101Ghe r\u001b[106Gnderer\u001b[113Gstill\u001b[K\r\u001b[4C\u001b[1Brows if the swapchain's format changes. Recording that as\u001b[63Ga J27\u001b[69Grow and merging.\u001b[86G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/jettison.lane-c/docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, r\u001b[22Gmoved \u001b[1m7\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 335 \u001b[12G\u001b[22m-\u001b[14GThe gam\u001b[22G UI's\u001b[28Gown stylesheet\u001b[43Gin\u001b[46Gthe\u001b[50Gsame\u001b[55Gpalette,\u001b[64Gso\u001b[67Ga\u001b[69Ggame's\u001b[76Gscreens\u001b[84Gand\u001b[88Gthe\u001b[92Gtools\u001b[98Gread\u001b[103Gas\u001b[106Gone\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m \u001b[14Gdesi\u001b[19Gn: an RmlUi styleshe\u001b[40Gt over the VFS, no engine work.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m-\u001b[14GThe palette as a\u001b[31Gplay\u001b[36Gr s\u001b[41Gting on a\u001b[51Ggame's ow\u001b[61G settings screen.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 338 -\u001b[38;2;248;248;242m- A light-attachment swap noticed mid-run. `ApplyThemeIfChanged` answers only when a setting          \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gchan\u001b[19Ges.          \u001b[33G    \u001b[38G       \u001b[46G        \u001b[55G                     \u001b[77G       \u001b[85G    \u001b[90G    \u001b[95G \u001b[97G       \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m40\u001b[12G\u001b[38;2;248;248;242m-\u001b[14GT\u001b[16Ge darkest\u001b[26Gtones\u001b[32Gexact\u001b[38Gon\u001b[41Gthe\u001b[45Gpa\u001b[76Gncoding\u001b[84Gdone\u001b[89Gin\u001b[92Gthe\u001b[96GUI's\u001b[101Gown\u001b[105Gshader\u001b[49m\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.056, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mAgent\u001b[9G\"J26\u001b[14Gtheme\u001b[20Gleftovers\"\u001b[31Gfinished\u001b[38;2;153;153;153m · 14m 22s\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ26's\u001b[9Gexact\u001b[15Gdarks\u001b[21Gare\u001b[25Gdone,\u001b[31Gwith\u001b[36Gthe\u001b[40Greference\u001b[50Gframes\u001b[57Gand\u001b[61Gsmoke\u001b[67Gtest\u001b[72Gunchanged.\u001b[83GOn\u001b[86Gthe\u001b[90Gswap\u001b[95Gbullet,\u001b[103Gthe\u001b[107Gagent\u001b[113Gmade\u001b[118Gthe\r\u001b[1B \u001b[3Gtheme\u001b[9Gindependent\u001b[21Gof the attachment rath\u001b[45G than det\u001b[55Gcti\u001b[59Gg\u001b[61Ga swap. That retir\u001b[80Gs the\u001b[89Gme's half; \u001b[101Ghe r\u001b[106Gnderer\u001b[113Gstill\u001b[K\r\u001b[4C\u001b[1Brows if the swapchain's format changes. Recording that as\u001b[63Ga J27\u001b[69Grow and merging.\u001b[86G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/jettison.lane-c/docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, r\u001b[22Gmoved \u001b[1m7\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 335 \u001b[12G\u001b[22m-\u001b[14GThe gam\u001b[22G UI's\u001b[28Gown stylesheet\u001b[43Gin\u001b[46Gthe\u001b[50Gsame\u001b[55Gpalette,\u001b[64Gso\u001b[67Ga\u001b[69Ggame's\u001b[76Gscreens\u001b[84Gand\u001b[88Gthe\u001b[92Gtools\u001b[98Gread\u001b[103Gas\u001b[106Gone\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m \u001b[14Gdesi\u001b[19Gn: an RmlUi styleshe\u001b[40Gt over the VFS, no engine work.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m-\u001b[14GThe palette as a\u001b[31Gplay\u001b[36Gr s\u001b[41Gting on a\u001b[51Ggame's ow\u001b[61G settings screen.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 338 -\u001b[38;2;248;248;242m- A light-attachment swap noticed mid-run. `ApplyThemeIfChanged` answers only when a setting          \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gchan\u001b[19Ges.          \u001b[33G    \u001b[38G       \u001b[46G        \u001b[55G                     \u001b[77G       \u001b[85G    \u001b[90G    \u001b[95G \u001b[97G       \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m40\u001b[12G\u001b[38;2;248;248;242m-\u001b[14GT\u001b[16Ge darkest\u001b[26Gtones\u001b[32Gexact\u001b[38Gon\u001b[41Gthe\u001b[45Gpalette,\u001b[54Gwhich\u001b[60Gwants\u001b[66Gthe\u001b[70GsRGB\u001b[75Gencoding\u001b[84Gdone\u001b[89Gin\u001b[92Gthe\u001b[96GUI's\u001b[101Gown\u001b[105Gshader\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m1\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gov\u001b[17Gr \u001b[20G UNORM attachmen\u001b[37G: ImGui\u001b[76Gt linear bytes,\u001b[92Gso `#1e1e2e`\u001b[105Glan\u001b[109Gs \u001b[49m\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
