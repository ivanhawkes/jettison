8C\u001b[1B\u001b[38;2;220;90;90m2\u001b[14G\u001b[38;2;248;248;242mas `#1c1c2e`. This is \u001b[37Ghe further work\u001b[53Gof \u001b[57Ghe\u001b[60Gtheme review's find\u001b[81Gg F5      \u001b[92G  \u001b[95G         \u001b[105G     \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m3\u001b[14G\u001b[38;2;248;248;242m([the re\u001b[23Gord](history/devtools-theme.md#\u001b[55G5-in-detail--th\u001b[71G-colour-contract));\u001b[91Gfinding\u001b[99GF6\u001b[102Gcarries\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m4\u001b[14G\u001b[38;2;248;248;242mnone,\u001b[20Gits corrected explanation co\u001b[49Gmitted and its stock start tested.       \u001b[91G       \u001b[99G  \u001b[102G       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 338 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m**What\u001b[19Gexists.**\u001b[29GThe\u001b[33Gdev\u001b[37Gtools\u001b[43Gare\u001b[47Gthemed\u001b[54Gon\u001b[57GCatppuccin's\u001b[70Gfour\u001b[75Gvarieties,\u001b[86Gswitched\u001b[95Glive\u001b[100Gby\u001b[103Gthe\r\u001b[7C\u001b[1B\u001b[2m40\u001b[12G\u001b[22m`dev.palette` and `dev.ui_scale` se\u001b[48Gtings\u001b[54G\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m  \u001b[12G             \u001b[26G   \u001b[30G              \u001b[45G  \u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.031, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m7\u001b[30G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 335 \u001b[22m - The gam\u001b[22G UI's own stylesheet in the same\u001b[55Gpalette,\u001b[64Gso\u001b[67Ga\u001b[69Ggame's\u001b[76Gscreens\u001b[84Gand\u001b[88Gthe\u001b[92Gtools\u001b[98Gread\u001b[103Gas\u001b[106Gone\r\u001b[1B     \u001b[2m 336 \u001b[12G\u001b[22m \u001b[14Gdesign: an RmlUi stylesheet\u001b[42Gover\u001b[47Gthe\u001b[51GVFS,\u001b[56Gno\u001b[59Gengine\u001b[66Gwork.\r\u001b[8C\u001b[1B\u001b[2m7\u001b[18G\u001b[22mp\u001b[20Gl\u001b[22Gtte as a pla\u001b[35Ger s\u001b[40Gt\u001b[42Ging\u001b[46Gon a game's own settings screen.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 338 -\u001b[38;2;248;248;242m- A light-attachment swap noticed mid-run. `ApplyThemeIfChanged` answers only when a setting          \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 339 -\u001b[38;2;248;248;242m  changes.                                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m40\u001b[14G\u001b[38;2;248;248;242mThe darkes\u001b[25G ton\u001b[30Gs exact\u001b[38Gon th\u001b[44G palette, which wants the sRGB encoding d\u001b[87Ge in the UI's own\u001b[105Gshader\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m41\u001b[14G\u001b[38;2;248;248;242mover a UNORM\u001b[27Gattachment:\u001b[39GImGui\u001b[45Gpacks\u001b[51Ga\u001b[53Gvertex\u001b[60Gcolour\u001b[67Ginto\u001b[72G8-bit\u001b[78Glinear\u001b[85Gbytes,\u001b[92Gso\u001b[95G`#1e1e2e`\u001b[105Glands\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m2\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gas `#1c1c2e`. This is \u001b[37Ghe further work of the\u001b[60Gtheme\u001b[66Greview's\u001b[75Gfinding F5   \u001b[89G  \u001b[92G   \u001b[96G    \u001b[101G   \u001b[105G      \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m3\u001b