[0.114, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 93 +\u001b[38;2;248;248;242m  a speed negative or not finite (`Backward`); a speed above its \u001b[48;2;4;71;0mpeak\u001b[48;2;2;40;0m, the most its share can          \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m94\u001b[13G\u001b[22mreach a\u001b[21Gd come\u001b[28Gback from in the t\u001b[47Gme, or with no \u001b[63Gust\u001b[67Gined\u001b[72Gacceleration\u001b[85Gthe\u001b[89Gspeed\u001b[95Gits\u001b[99Gboost\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m \u001b[13Greaches (`AbovePeak`);\u001b[36Gand\u001b[40Ga way too short to speed up\u001b[68Gor slow down from one \u001b[91Gn\u001b[93G's speed to the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 96 \u001b[22m   other's (`Unreachable`).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison's gate passed in 240 s. Now Manifest's, for L53.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mA new player joining the server, when they are granted a corporation and ship, they can name themselves and the \u001b[39m      \r\u001b[1B  \u001b[38;2;255;255;255mcorporation. They also need to be able to name the ship at the same time.\u001b[39m                                             \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm noting that the founding step should\u001b[44Galso\u001b[49Gname\u001b[54Gthe\u001b[58Gstarting\u001b[67Gship,\u001b[73Gwhich\u001b[79GD-123\u001b[85Gallows,\u001b[93Gand\u001b[97GI'll\u001b[102Gqueue\u001b[108Git\u001b[111Gin\r\u001b[2C\u001b[1BManifest\u001b[12Glane\u001b[17GC\u001b[19Gonce\u001b[24GManifest's\u001b[35Ggate\u001b[40Gfinishes.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48Gexport\u001b[55GCMAKE…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && export CMAKE_BUILD_PARALLEL_LEVEL='24' CTEST_PARALLEL_LEVEL='24' \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS='24'; ./scripts/ci.sh --werror --asan --tidy --log build/gate.log > /dev/null 2>&1 (11m 28s)\u001b[39m\u001b[K\r\u001b[68C\u001b[2B\u001b[38;2;153;153;153mthought for 5s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
