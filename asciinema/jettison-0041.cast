[0.017, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison's\u001b[14Ggate\u001b[19Gpassed\u001b[26Gin\u001b[29G240\u001b[33Gs.\u001b[36GNow\u001b[40GManifest's,\u001b[52Gfor\u001b[56GL53.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mA new player\u001b[16Gjoining the server, when they \u001b[47Gr\u001b[50Ggranted a corporation and ship, they can name themselves and the \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255mcorporation. They also need to be able to name the ship at the same time.\u001b[39m                                             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm noting that\u001b[19Gthe fou\u001b[27Gding step should also name the starting\u001b[67Gship,\u001b[73Gwhich\u001b[79GD-123\u001b[85Gallows,\u001b[93Gand\u001b[97GI'll\u001b[102Gqueue\u001b[108Git\u001b[111Gin\r\u001b[2C\u001b[1BManifest\u001b[12Glane\u001b[17GC\u001b[19Gonce\u001b[24GManifest's\u001b[35Ggate\u001b[40Gfinishes.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery\u001b[9Gbuild and test\u001b[24Gstage passed. Tidy has o\u001b[49Ge finding in\u001b[62GL53's client,\u001b[76G\u001b[38;2;177;185;249muse auto\u001b[39m.\u001b[86GFixing\u001b[93Git,\u001b[97Gthen\u001b[102Grunning\u001b[110Gtidy\u001b[115Galone,\r\u001b[2C\u001b[1Bsince\u001b[9Gthe\u001b[13Ggate\u001b[18Gskips\u001b[24Ga\u001b[26Gpassing\u001b[34Gstage\u001b[40Gonly\u001b[45Gwhen\u001b[50Gnothing\u001b[58Ghas\u001b[62Gchanged.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/manifest' && export MANIF…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/proj\u001b[28Gc\u001b[30Gs/manifest' && \u001b[46Gxport MANIFEST_TIDY_JOBS='24'; python3 scripts/tidy.py build/clang-debug\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
