[0.063, "o", "\u001b[?25l\u001b[H\u001b[5Gthat Manifest's shell matches the engine's passed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate:\u001b[22m Manifest's full gate (warnings as errors, sanitisers, tidy) passed in 946 s. The sanitised tests took 159\u001b[117Gs,\r\u001b[4C\u001b[1Bagainst 634 s before the trim. The run was slower than the last one because the new pin made every tree recompile\r\u001b[4C\u001b[1Bthe engine.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCI:\u001b[22m I haven't checked GitHub Actions on these pushes yet.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe reminder you asked for, L53, the content check:\u001b[22m the server's welcome should carry its world content, and a client\r\u001b[2C\u001b[1Bwhose content differs should be refused, naming the package. It stopped because Jettison's check only counts files\r\u001b[2C\u001b[1Bunder \u001b[38;2;177;185;249mdefs/\u001b[15G\u001b[39mand\u001b[19G\u001b[38;2;177;185;249mscripts/\u001b[28G\u001b[39mas\u001b[31Gworld\u001b[37Gcontent.\u001b[46GManifest's\u001b[57Gworld\u001b[63Gis\u001b[66Gunder\u001b[72G\u001b[38;2;177;185;249mmanifest/definitions/\u001b[94G\u001b[39mand\u001b[98G\u001b[38;2;177;185;249mmanifest/scenarios/\u001b[39m,\u001b[119Gso\r\u001b[2C\u001b[1Bthe check sees nothi\u001b[24Gg of Manif\u001b[35Gst's. The same gap makes th\u001b[63G dedi\u001b[69Gat\u001b[72Gd server's pack leave ou\u001b[97G Manifest's\u001b[109Gworld.\r\u001b[2C\u001b[1BSeparately, the server and the shell name the \u001b[50Game world mod \u001b[65Gifferently wh\u001b[79Gn they mount i\u001b[94G, so\u001b[99Ga\u001b[101Gmatching\u001b[110Gmod\u001b[114Gwould\r\u001b[2C\u001b[1Bstill\u001b[9Gbe\u001b[12Grefused.\u001b[21GThe\u001b[25Goptions:\r\u001b[2C\u001b[1B1. \u001b[1mRecommended:\u001b[22m Manifest moves its\u001b[38Gworld\u001b[44Gunder\u001b[50G\u001b[38;2;177;185;249mdefs/\u001b[39m,\u001b[57Gand\u001b[61Gthe\u001b[65Gserver\u001b[72Gmounts\u001b[79Gits\u001b[83Goverlays\u001b[92Gas\u001b[95G\u001b[38;2;177;185;249mmod:<name>\u001b[39m,\u001b[107Gas\u001b[110Gthe\u001b[114Gshell\r\u001b[5C\u001b[1Bdoes.\u001b[12GBoth\u001b[17Gchanges\u001b[25Gare\u001b[29GManifest's\u001b[40Gown.\r\u001b[1B \u001b[3G2. Jettison lets \u001b[21G package name its own world\u001b[49Gd\u001b[51Grectories\u001b[61Gin \u001b[38;2;177;185;249mmod.yaml\u001b[39m, which i\u001b[82G a new \u001b[90Gngine item.\u001b[K\r\u001b[2C\u001b[1B3. Build\u001b[12Gthe\u001b[16Gwelcome\u001b[24Gand\u001b[28Grefusal\u001b[36Gmechanics\u001b[46Gnow,\u001b[51Gand\u001b[55Gfix\u001b[59Gthe\u001b[63Glayout\u001b[70Glater.\r\u001b[2B \u001b[3GManifes\u001b[11G lane B is still parked\u001b[35Gon \u001b[38;2;177;185;249ml53-content-check\u001b[39m,\u001b[57Gwaiting\u001b[65Gon\u001b[68Gyour\u001b[73Gchoice.\u001b[81GThe\u001b[85Gother\u001b[91Gthree\u001b[97Glanes\u001b[103Gare\u001b[107Gfree.\u001b[113GThis\r\u001b[1B  batch is a good point to start a fresh session.\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mA\u001b[7Galizing…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.040, "o", "\u001b]0;✳ jettison-0041\u0007"]
