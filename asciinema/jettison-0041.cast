[0.003, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mShader reloading is built, but I've sen\u001b[43G it back for on\u001b[59G fix before\u001b[71Gmerging.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does:\u001b[17G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTrigger:\u001b[22m when\u001b[19Ga\u001b[21Gshader's\u001b[30Gcompiled\u001b[39GSPIR-V\u001b[46Gchanges\u001b[54Gon\u001b[57Gdisk,\u001b[63Gthe\u001b[67Gshell\u001b[73Grebuilds\u001b[82Gthat\u001b[87Gshader\u001b[94Gprogram's\u001b[104Gpipelines\u001b[114Gbetween\r\u001b[4C\u001b[1Bframes,\u001b[13Gand\u001b[17Gno\u001b[20Gothers.\u001b[28GIn\u001b[31Gpractice\u001b[40Gyou\u001b[44Grun\u001b[48G\u001b[38;2;177;185;249mcmake --build\u001b[62G\u001b[39mwhile\u001b[68Gthe\u001b[72Gshell\u001b[78Gis\u001b[81Grunning.\u001b[90GThere's\u001b[98Gno\u001b[101Gruntime\u001b[109GGLSL\r\u001b[2C\u001b[1B  compiler, so it reloads the compi\u001b[39Ged files.\u001b[49G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mBad files:\u001b[22m a broken\u001b[25Gfile keeps the old\u001b[44Gpipelines and logs on\u001b[67Gwarning\u001b[75Gnaming the file.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mScope:\u001b[12G\u001b[22mdevel\u001b[18Gpment bu\u001b[27Glds only, as with\u001b[45GJ14's asset reloading.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecks:\u001b[13G\u001b[22mthe\u001b[17Gsuites\u001b[24Gpass,\u001b[30Gall\u001b[34G13\u001b[37Greference\u001b[47Gviews\u001b[53Gare\u001b[57Gunchanged,\u001b[68Gand\u001b[72Gthe\u001b[76Gsmoke\u001b[82Gtest\u001b[87Gpasses.\u001b[95GIn\u001b[98Ga\u001b[100Gheadless\u001b[109Grun,\r\u001b[2C\u001b[1B  swapping in an inverted shader\u001b[36Ginverted\u001b[45Gthe\u001b[49Gframe.\u001b[56GRandom\u001b[63Gbytes\u001b[69Gafter\u001b[75Gthat\u001b[80Gwere\u001b[85Grefused,\u001b[94Gand\u001b[98Gthe\u001b[102Gframe\u001b[108Gstayed\r\u001b[2C\u001b[1B \u001b[5Ginverted.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix I aske\u001b[18G fo\u001b[22G:\u001b[22m the agent itself flagged that a file read while\u001b[72G\u001b[38;2;177;185;249mglslc\u001b[39m is\u001b[81Gstill wr\u001b[91Ging it could slip\u001b[109Gpast\u001b[114Gthe\r\u001b[2C\u001b[1Bchecks,\u001b[11Gand\u001b[15Ga\u001b[17Gcut-off\u001b[25Gshader\u001b[32Gcould\u001b[38Greach\u001b[44Gthe\u001b[48Gdriver.\u001b[56GNow\u001b[60Ga\u001b[62Gfile\u001b[67Gis\u001b[70Gread\u001b[75Gonly\u001b[80Gonce\u001b[85Gits\u001b[89Gsize\u001b[94Gand\u001b[98Gmodification\u001b[111Gtime\u001b[116Gare\r\u001b[2C\u001b[1Bthe same at two successiv\u001b[29G checks, half a second apart, and\u001b[63Ga test will\u001b[75Gcover\u001b[81Gthat.\u001b[27;1H\u001b[18;3H\u001b[?25h"]
