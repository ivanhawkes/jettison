[0.046, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mL53 is running in Manifest lane B, on a fresh branch from the pushed \u001b[38;2;177;185;249mfeature-base\u001b[39m, with your option 1. It goes in\r\u001b[2C\u001b[1Bthree steps:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMove Manifest's world under \u001b[38;2;177;185;249mdefs/\u001b[22m\u001b[39m (its definitions and scenarios), recorded as a new decision. Afterwards, the\r\u001b[5C\u001b[1Bserver pack and the client/world split will see Manifest's world.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mName mounts the same on both ends:\u001b[22m the server mounts its overlays as \u001b[38;2;177;185;249mmod:<name>\u001b[39m, as the shell does.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe content check itself:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B- The server's welcome carries its world content.\u001b[K\r\u001b[5C\u001b[1B- The graphical client and the console refuse a server whose content differs, and name the package in the status\r\u001b[7C\u001b[1Bline\u001b[13Gor\u001b[16Gthe\u001b[20Gconsole.\r\u001b[2C\u001b[1B   - A matching client\u001b[26Gplays\u001b[32Gas\u001b[35Gbefore,\u001b[43G\u001b[38;2;177;185;249mclient_serve\u001b[56G\u001b[39mincluded.\r\u001b[2B \u001b[3GI'll review it when it finishes, rebase it, run\u001b[51GManifest's\u001b[62Ggate\u001b[67Gand\u001b[71Gmerge.\u001b[78GThe\u001b[82Gother\u001b[88Gthree\u001b[94Glanes\u001b[100Gare\u001b[104Gfree.\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mZigzagging…\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.077, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mL53\u001b[7Gis\u001b[10Grunning\u001b[18Gin\u001b[21GManifest\u001b[30Glane\u001b[35GB,\u001b[38Gon\u001b[41Ga\u001b[43Gfresh\u001b[49Gbranch\u001b[56Gfrom\u001b[61Gthe\u001b[65Gpushed\u001b[72G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[86Gwith\u001b[91Gyour\u001b[96Goption\u001b[103G1.\u001b[106GIt\u001b[109Ggoes\u001b[114Gin\r\u001b[2C\u001b[1Bthree\u001b[9Gsteps:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mMove Manifest's world under \u001b[38;2;177;185;249mdefs/\u001b[40G\u001b[22m\u001b[39m(its\u001b[45Gdefinitions\u001b[57Gand\u001b[61Gscenarios),\u001b[73Grecorded\u001b[82Gas\u001b[85Ga\u001b[87Gnew\u001b[91Gdecision.\u001b[101GAfterwards,\u001b[113Gthe\r\u001b[5C\u001b[1Bserver\u001b[13Gpack\u001b[18Gand\u001b[22Gthe\u001b[26Gclient/world\u001b[39Gsplit\u001b[45Gwill\u001b[50Gsee\u001b[54GManifest's\u001b[65Gworld.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mNam\u001b[11Gmounts \u001b[19Ghe\u001b[22Gsame on both ends:\u001b[22m the\u001b[45Gs\u001b[47Grver m\u001b[54Gunts it\u001b[62G ove\u001b[67Glays as \u001b[38;2;177;185;249mmod:<name>\u001b[39m,\u001b[87Gas th\u001b[93G shell does.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe content check itself:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- The server's welcome carries its\u001b[41Gworld content.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- The graphical client and\u001b[33Gthe\u001b[37Gconsole\u001b[45Grefuse\u001b[52Ga\u001b[54Gserver\u001b[61Gwhose\u001b[67Gcontent\u001b[75Gdiffers,\u001b[84Gand\u001b[88Gname\u001b[93Gthe\u001b[97Gpackage\u001b[105Gin\u001b[108Gthe\u001b[112Gstatus\r\u001b[5C\u001b[1B \u001b[8Gline o\u001b[15G the console.\u001b[29G\u001b[K\r\u001b[7C\u001b[1BA matching c\u001b[21Gient plays as bef\u001b[39Gre, \u001b[38;2;177;185;249mclient_serve\u001b[39m included.\u001b[K\r\u001b[7C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Greview \u001b[16Gt when i\u001b[26Gfini\u001b[31Ghe\u001b