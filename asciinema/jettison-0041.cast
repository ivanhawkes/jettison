[0.183, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTheme:\u001b[22m the\u001b[16Ggame UI now changes with \u001b[38;2;177;185;249mdev.palette\u001b[39m, and \u001b[59Gatte draws a lig\u001b[76Gt panel with da\u001b[92Gk text.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mItalic:\u001b[13G\u001b[22m\u001b[38;2;177;185;249mem\u001b[39m draws\u001b[22Gin Roboto Italic. The font is the OFL-licen\u001b[66Ged copy\u001b[74Gthat\u001b[79Gships\u001b[85Gwith\u001b[90GTracy,\u001b[97Gwith\u001b[102Gits\u001b[106Glicence\u001b[114Gbeside\r\u001b[2C\u001b[1B \u001b[5Git, and\u001b[13Git's the regular weight bec\u001b[41Guse no Medium Italic exists.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecks:\u001b[17G\u001b[22mui and \u001b[25Gpp\u001b[28Gt\u001b[30Gsts\u001b[34Gpass,\u001b[40Gall\u001b[44G13\u001b[47Greference\u001b[57Gviews\u001b[63Gare\u001b[67Gunchanged,\u001b[78Gand\u001b[82Gthe\u001b[86Gsmoke\u001b[92Gtest\u001b[97Gpasses.\u001b[105GIt\u001b[108Ghasn't\u001b[115Gbeen\r\u001b[4C\u001b[1Bthrough\u001b[13Gthe\u001b[17Gbatch\u001b[23Ggate\u001b[28Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BO\u001b[5Ge\u001b[7Gpart of the brief w\u001b[29Gwrong. A missi\u001b[44Gg\u001b[46Gfont face wasn't silent: RmlUi already\u001b[85Glogs \u001b[91Gach tex\u001b[99G dra\u001b[104Gn withou\u001b[113G a\u001b[116Gface,\r\u001b[2C\u001b[1Band the\u001b[11GUI counts that as\u001b[29Ga problem. So no new warning wa\u001b[61G added. The age\u001b[77Gt\u001b[79Gasked wheth\u001b[91Gr\u001b[93Gyou\u001b[97Gstill wan\u001b[107G \u001b[109Gxactly one\r\u001b[2C\u001b[1Bwarning\u001b[11Gper\u001b[15Gmissing\u001b[23Gface.\u001b[29GI'd\u001b[33Gleave\u001b[39Git\u001b[42Gas\u001b[45GRmlUi\u001b[51Gdoes\u001b[56Git,\u001b[60Gsince\u001b[66Gthe\u001b[70Gexisting\u001b[79Gmessage\u001b[87Gnames\u001b[93Gthe\u001b[97Gface\u001b[102Gand\u001b[106Gthe\u001b[110Gelement.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gplayer\u001b[14Gsetting\u001b[22G