[0.539, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNow\u001b[7Glaunching\u001b[17Gthe\u001b[21GL53\u001b[25Gimplementer\u001b[37Gin\u001b[40Glane\u001b[45GB.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mL53\u001b[7Gis\u001b[10Grunning\u001b[18Gin\u001b[21GManifest\u001b[30Glane\u001b[35GB,\u001b[38Gon\u001b[41Ga\u001b[43Gfresh\u001b[49Gbranch\u001b[56Gfrom\u001b[61Gthe\u001b[65Gpushed\u001b[72G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[86Gwith\u001b[91Gyour\u001b[96Goption\u001b[103G1.\u001b[106GIt\u001b[109Ggoes\u001b[114Gin\r\u001b[1B \u001b[3Gthree steps:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMove Manifest's world under \u001b[38;2;177;185;249mdefs/\u001b[40G\u001b[22m\u001b[39m(its\u001b[45Gdefinitions\u001b[57Gand\u001b[61Gscenarios),\u001b[73Grecorded\u001b[82Gas\u001b[85Ga\u001b[87Gnew\u001b[91Gdecision.\u001b[101GAfterwards,\u001b[113Gthe\r\u001b[2C\u001b[1B  \u001b[6Gserver pack and the client/world split\u001b[45Gwill see Manifest's world.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mName mounts the same on both ends:\u001b[22m the\u001b[45Gserver mounts its overlays\u001b[72Gas\u001b[75G\u001b[38;2;177;185;249mmod:<name>\u001b[39m,\u001b[87Gas\u001b[90Gthe\u001b[94Gshell\u001b[100Gdoes.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mThe content\u001b[18Gc\u001b[21Gck itself:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- The server's welcome carries\u001b[37Gits\u001b[41Gworld\u001b[47Gcontent.\r\u001b[11C\u001b[1Bgraphical c\u001b[24Gient\u001b[29Gand the\u001b[37Gconsole refuse a server\u001b[61Gwhose\u001b[67Gcontent\u001b[75Gdiffers,\u001b[84Gand\u001b[88Gname\u001b[93Gthe\u001b[97Gpackage\u001b[105Gin\u001b[108Gthe\u001b[112Gstatus\r\u001b[5C\u001b[1B \u001b[8Gline or the console.\u001b[29G\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GA matching client plays\u001b[32Gas\u001b[35Gbefore,\u001b[43G\u001b[38;2;177;185;249mclient_serve\u001b[56G\u001b[39mincluded.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Greview\u001b[15Git\u001b[18Gwhen\u001b[23Git\u001b[26Gfinishes,\u001b[36Grebase\u001b[43Git,\u001b[76G.\u001b[78GThe\u001b[82Gother\u001b[88Gthree\u001b[94Glanes\u001b[100Gare\u001b[104Gfree.\u001b[27;1H\u001b[21;3H\u001b[?25h"]
