[0.249, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat it adds:\u001b[19G\u001b[22ma\u001b[21Gprofile\u001b[29Gcan\u001b[33Gnow\u001b[37Gstart\u001b[43Gand\u001b[47Gend\u001b[51Gmoving\u001b[58Galong\u001b[64Gits\u001b[68Gway.\u001b[73GThe\u001b[77Grest\u001b[82Gof\u001b[85Geach\u001b[90Gend's\u001b[96Gvelocity,\u001b[106Gthe\u001b[110Gsideways\r\u001b[2C\u001b[1B \u001b[5Gpart, is carried by a small\u001b[33Gdrift off\u001b[43Gthe\u001b[47Gway\u001b[51Gthat is zero\u001b[64Ga\u001b[66G both ends.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat stayed the same:\u001b[27G\u001b[22mtime,\u001b[34Gistance and thrus\u001b[52G \u001b[54Gre \u001b[58Gtill worked out exactly\u001b[82Grather\u001b[89Gthan\u001b[94Gstepped.\u001b[103GWith\u001b[108Gboth\u001b[113Gends\u001b[118Gat\r\u001b[2C\u001b[1B \u001b[5Grest the results are bit-identic\u001b[38Gl to before, and no hash\u001b[63Gpin, save or reference f\u001b[88Game moved.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecks:\u001b[22m seven suites\u001b[26Gpasse\u001b[32G. W\u001b[36Gth end\u001b[43Gspeeds\u001b[51Gthe\u001b[55Gresults\u001b[63Gmatch \u001b[70G stepped simulation.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIt\u001b[6Gleaves\u001b[13Gthree\u001b[19Gpoints\u001b[26Gfor\u001b[30GManifest's\u001b[41GL37\u001b[45Gto\u001b[48Gsettle:\r\u001b[2C\u001b[1B- Th\u001b[8G thrust figure Manifest prices fuel fr\u001b[47Gm doesn't\u001b[57Gcount\u001b[63Gthe\u001b[67Gdrift's\u001b[75Gown\u001b[79Gacceleration.\r\u001b[4C\u001b[1BAt low thrust shares (20 basis points), slowing from a fas\u001b[64G bo\u001b[68Gy's speed m\u001b[80Gy not fit, and\u001b[95Gthe\u001b[99Gprofile\u001b[107Gthen\u001b[112Grefuses\r\u001b[2C\u001b[1B \u001b[5Gwith \u001b[38;2;177;185;249mAboveCruise\u001b[39m. L37 will need a fallback for that.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe engine's own passages still\u001b[38Grrive \u001b[45Gt rest. End speeds\u001b[64Gare\