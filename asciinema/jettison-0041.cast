[0.276, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m19\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 20 \u001b[22m work=\u001b[38;2;230;219;116m\"\u001b[39m$(mktemp -d)\u001b[38;2;230;219;116m\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[11G\u001b[38;2;117;113;94m# A crash report goes under the run's own state directory, never the real home's.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 22 +\u001b[38;2;166;226;46mexport\u001b[38;2;248;248;242m XDG_STATE_HOME=\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$work\u001b[38;2;230;219;116m/state\"\u001b[38;2;248;248;242m                                                                    \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m3\u001b[11G\u001b[22mserver=\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m\u001b[38;2;166;226;46mtrap\u001b[16G\u001b[38;2;230;219;116m'if [[ -n \"$server\" ]]; then kill -KILL \"$server\" 2>/dev/null || true; fi; rm -rf \"$work\"'\u001b[107G\u001b[39mEXIT\r\u001b[5C\u001b[1B\u001b[2m 25 \r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe server cr\u001b[17Ga\u001b[19Ges its crash directory at \u001b[46Gtart-up,\u001b[55Gso\u001b[58G\u001b[38;2;177;185;249mcli_serve_missing_tokens\u001b[83G\u001b[39malso\u001b[88Gruns\u001b[93Git\u001b[96Gunder\u001b[102Gyour\u001b[107Greal\u001b[112Ghome.\r\u001b[2C\u001b[1BGiving\u001b[10Gthat\u001b[15Gtest\u001b[20Gits\u001b[24Gown\u001b[28Gstate\u001b[34Gdirectory\u001b[44Gas\u001b[47Gwell.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running cd '/home/ivan/projects/manifest.lane-b' && expor…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manife\u001b[39Gt.lane-b' && export CMAKE_BUILD_PARALLEL_LEVEL='24'; scripts/heavy.sh cmake \r\u001b[5C\u001b[1B--bui