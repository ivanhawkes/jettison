[0.065, "o", "\u001b[?25l\u001b[H\u001b[3GL37\u001b[7Gis\u001b[10Gstill\u001b[16Grunning\u001b[24Gin\u001b[27GManifest\u001b[36Glane\u001b[41GB.\u001b[44GManifest's\u001b[55Ggate\u001b[60Gwaits\u001b[66Gfor\u001b[70Git,\u001b[74Gbecause\u001b[82Git\u001b[85Gcovers\u001b[92GL37,\u001b[97Gthe\u001b[101Gpin\u001b[105Gmove,\u001b[111GL41\u001b[115Gand\r\u001b[2C\u001b[1Bthe line-tables change together.\u001b[36G\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m1\u001b[22m background agent to finish\u001b[44G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mpush jettison\u001b[39m                                                                                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255manything else we can get going?\u001b[39m                                                                                       \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison\u001b[12Gis\u001b[15Gpushed:\u001b[23G\u001b[38;2;177;185;249m01eeae8..5831e49\u001b[39m,\u001b[41Gand\u001b[45Gthe\u001b[49Gremote\u001b[56Gmatches.\r\u001b[1B\u001b[K\r\u001b[1B  To answer what else we can start, I'll check what's ready\u001b[61Gfor\u001b[65Gthe\u001b[69Gthree\u001b[75Gfree\u001b[80Glanes.\r\u001b[35C\u001b[2B\u001b[38;2;153;153;153mthought for 7s)\u001b[39m\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
