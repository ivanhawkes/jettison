[0.039, "o", "\u001b[?25l\u001b[H\u001b[5Gand update it\u001b[19Gonly if the\u001b[31Gchang\u001b[37G is that int\u001b[50Gnded exact colour.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll review and\u001b[19Gmerge eac\u001b[29G as it finishes.\u001b[46G\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m3\u001b[22m background agents to finish\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mAgent\u001b[22m(Transit profile with end velocities)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded\u001b[19Gagent\u001b[38;2;153;153;153m (↓ to manage · ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mAgent\u001b[22m(J26 theme\u001b[19Gleftovers)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded\u001b[19Gagent\u001b[38;2;153;153;153m (↓ to manage · ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The \u001b[8Ggents ar\u001b[17G running in the background; their finishing\u001b[61Greports\u001b[69Gwill\u001b[74Gcome\u001b[79Gthrough\u001b[87Ghere.\u001b[27;1H\u001b[19;3H\u001b[?25h"]
[0.052, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mMotion profile:\u001b[22m stays\u001b[27Ggenre-neutral, and\u001b[46Gwi\u001b[49Gh both ends\u001b[61Gat rest\u001b[69Git\u001b[72Gmust\u001b[77Ggive\u001b[82Gtoday's\u001b[90Gresults\u001b[98Gto\u001b[101Gthe\u001b[105Gbit.\u001b[110GThat\u001b[115Gkeeps\r\u001b[4C\u001b[1Bexisting\u001b[14Ghash\u001b[19Gpins,\u001b[25Gsaves\u001b[31Gand\u001b[35Greference\u001b[45Gframes\u001b[52Gwhere\u001b[58Gthey\u001b[63Gare.\r\u001b[2C\u001b[1B- \u001b[1mJ26:\u001b[22m must\u001b[15Gread a \u001b[38;2;177;185;249m#1e1e2e\u001b[30G\u001b[39mpanel\u001b[36Gback as exactly\u001b[52G\u001b[38;2;177;185;249m#1e1e2e\u001b[39m.\u001b[61GThe\u001b[65Gagent\u001b[71Ghas\u001b[75Gto\u001b[78Gexplain\u001b[86Gany\u001b[90Greference\u001b[100Gframe\u001b[106Gthat\u001b[111Gchanges,\r\u001b[4C\u001b[1Band\u001b[9Gupdate\u001b[16Git\u001b[19Gonly\u001b[24Gif\u001b[27Gthe\u001b[31Gchange\u001b[38Gis\u001b[41Gthat\u001b[46Gintended\u001b[55Gexact\u001b[61Gcolour.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Greview\u001b[15Gand\u001b[19Gmerge\u001b[25Geach\u001b[30Gas\u001b[33Git\u001b[36Gfinishes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mWaiting for \u001b[1m3\u001b[22m background\u001b[28Gagents to\u001b[38Gfinish\u001b[39m\u001b[K\r\u001b[8C\u001b[2BTransit profile with\u001b[30Gend\u001b[34Gvelocities)\r\u001b[3B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mAgent\u001b[22m(J26 theme leftovers)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded\u001b[19Gagent\u001b[38;2;153;153;153m (↓ to manage · ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The agents are running in the background; their finishing reports will come through here.\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent · ↓ to\u001b[59Gmanage\u001b[39m\u001b[K\u001b[27;1H\u001b[19;3H\u001b[?25h"]
