[0.019, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gframes, and \u001b[18Go ot\u001b[23Gers. In practice you run \u001b[38;2;177;185;249mcmake --build\u001b[39m while the sh\u001b[75Gll is running. There's no runt\u001b[106Gm\u001b[108G GLSL\u001b[114G\u001b[K\r\u001b[4C\u001b[1Bcompiler, so it reloads the compiled files.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBad files:\u001b[22m a\u001b[18Gbrok\u001b[23Gn file k\u001b[32Geps the old pipelines\u001b[54Gand\u001b[58Glogs\u001b[63Gone\u001b[67Gwarning\u001b[75Gnaming\u001b[82Gthe\u001b[86Gfile.\r\u001b[4C\u001b[1B\u001b[1mScope:\u001b[22m development bu\u001b[28Gds only, as\u001b[40Gwith J14's a\u001b[53Gset reloadi\u001b[65Gg.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mChecks:\u001b[22m th\u001b[16G suites\u001b[24Gpass, all 13\u001b[37Greference views are\u001b[57Gunch\u001b[62Gnged,\u001b[68Gand\u001b[72Gthe\u001b[76Gsmoke\u001b[82Gtest\u001b[87Gpasses.\u001b[95GIn\u001b[98Ga\u001b[100Gheadless\u001b[109Grun,\r\u001b[2C\u001b[1B \u001b[5Gswapping in\u001b[17Gan inverted shader invert\u001b[43Gd the frame. Ra\u001b[59Gdom bytes after that wer\u001b[84G refu\u001b[90Ged, and\u001b[98Gthe frame stayed\r\u001b[4C\u001b[1Binverted.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix I asked for:\u001b[24G\u001b[22mthe\u001b[28Gagent\u001b[34Gitself\u001b[41Gflagged\u001b[49Gthat\u001b[54Ga\u001b[56Gfile\u001b[61Gread\u001b[66Gwhile\u001b[72G\u001b[38;2;177;185;249mglslc\u001b[78G\u001b[39mis\u001b[81Gstill\u001b[87Gwriting\u001b[95Git\u001b[98Gcould\u001b[104Gslip\u001b[109Gpast\u001b[114Gthe\r\u001b[2C\u001b[1Bchecks, and a cut-off shader could reach th\u001b[47G driver.\u001b[56GNow a file is read only once its size and\u001b[98Gm\u001b[100Gdification time are\r\u001b[2C\u001b[1Bt\u001b[6G same at\u001b[15Gtwo succes\u001b[26Give checks,\u001b[38Ghalf a s\u001b[47Gcond apart, and a test\u001b[70Gwill\u001b[75Gcover that.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTwo points from the review:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mNo automated test\u001b[23Gof the rebuild step itself:\u001b[51G\u001b[22mthe\u001b[55Gunit\u001b[60Gsuite\u001b[66Ghas\u001b[70Gno\u001b[73GGPU.\u001b[78GRebuilding\u001b[89Gonly\u001b[94Gthe\u001b[98Gchanged\u001b[106Gprogram,\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Gkeeping the old pipelines on failure, are \u001b[75Glog.\u001b[K\u001b[27;1H\u001b[19;3H\u001b[?25h"]
