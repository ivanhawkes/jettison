[0.017, "o", "\u001b[?25l\u001b[H\u001b[3GJettison's \u001b[38;2;177;185;249mfeature-base\u001b[27G\u001b[39mis\u001b[30Gready\u001b[36Gto\u001b[39Gpush,\u001b[45Gwith\u001b[50Gthose\u001b[56Gtwo\u001b[60GJ27\u001b[64Gpieces\u001b[71Gon\u001b[74Gtop\u001b[78Gof\u001b[81Gwhat's\u001b[88Galready\u001b[96Gpushed.\u001b[104GI'll\u001b[109Gpush\u001b[114Gwhen\r\u001b[2C\u001b[1Byou\u001b[7Gsay\u001b[11Gso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BStill\u001b[9Grunning:\u001b[18GL37,\u001b[23Gthe\u001b[27Gserver\u001b[34Gpicker\u001b[41Gand\u001b[45GJ20's\u001b[51Gclamps.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m3\u001b[22m background agents to finish\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m Agent \"L37 and pin move\" finished\u001b[37G\u001b[38;2;153;153;153m· 1h 21m 37s\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Message\u001b[14Gqueued\u001b[21Gfor delivery to\u001b[37Ga5c5e4035590a0fc9 at its next\u001b[68Gool\u001b[77G. Sending this moved nothing it\u001b[109Gis\u001b[112G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mru\u001b[9Gning to the background just now, so\u001b[45Gthe mess\u001b[54Gge\u001b[57Gwaits for that round unless\u001b[85Gsomething moves sooner. If it \r\u001b[5C\u001b[1Bfinishes first, it is resumed with the message and notifies again, so wait for that notification before \r\u001b[5C\u001b[1Bresending.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Editing ~/projects/manifest.lane-b/docs/decision-ledger.md\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Up\u001b[9Gate(~/pr\u001b[18Gjects/man\u001b[28Gfest.lane-b/docs/decision-ledger.md)\u001b[39m\u001b[27;1H\u001b[20;3H\u001b[?25h"]
