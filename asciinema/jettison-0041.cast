> $<TARGET_FILE:manifest-token> \u001b[38;2;230;219;116m\"${MANIFEST_MOD_DIRECTORY}\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 75 \u001b[19G\u001b[22mWORKING_DIRECTORY\u001b[37G\u001b[38;2;230;219;116m\"${elsewhere}\"\u001b[39m)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m4\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ bash -c 'ls -d ~/.local/state/manif\u001b[44Gst/crashes 2>&1'\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[12C\u001b[2B6m 2s ·\u001b[21G↓\u001b[39m \u001b[38;2;153;153;153m6.6k \u001b[29Gokens)\u001b[39m\u001b[K\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m4\u001b[39m\u001b[27;1H\u001b[20;3H\u001b[?25h"]
