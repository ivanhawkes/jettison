[0.047, "o", "\u001b[?25l\u001b[H  │    Lane    │                                    Work                                    │\u001b[K\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Manifest B │ Moving the pin to Jettison \u001b[38;2;177;185;249m01eeae8\u001b[39m, then L37's cruising refinements        │\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Manifest C │ L41: the terminal UI resending lost requests, and the container runs in CI │\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Jettison B │ J26: the game UI following \u001b[38;2;177;185;249mdev.palette\u001b[39m, and the italic face                │\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Jettison C │ J12: a model's collision shape baked to a file that physics reads          │\r\u001b[2C\u001b[1B└────────────┴────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Gmerge\u001b[14Geach\u001b[19Glane\u001b[24Gwhen\u001b[29Git\u001b[32Gfinishes,\u001b[42Gthen\u001b[47Grun\u001b[51Gone\u001b[55Ggate\u001b[60Gper\u001b[64Grepo\u001b[69Gfor\u001b[73Gthe\u001b[77Gbatch\u001b[83Gbefore\u001b[90Gpushing.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcontainer\u001b[17Gruns\u001b[22Gin\u001b[25GCI\u001b[28Gcan\u001b[32Gonly\u001b[37Gbe\u001b[40Gseen\u001b[45Gworking\u001b[53Gafter\u001b[59Ga\u001b[61Gpush,\u001b[67Gthough\u001b[74Gthe\u001b[78GL41\u001b[82Gagent\u001b[88Gwill\u001b[93Grun\u001b[97Gthem\u001b[102Glocally\u001b[110Gwith\u001b[115GDocker\r\u001b[2C\u001b[1Bfirst.\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
