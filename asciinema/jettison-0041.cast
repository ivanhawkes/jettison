[0.253, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1m1. Choosing a server in the client\u001b[38G\u001b[22m(recommended)\r\u001b[2C\u001b[1B- It's next in the client plan's order. It a\u001b[48Gds a\u001b[53Gscreen\u001b[60Glisting\u001b[68Gthe\u001b[72Gservers,\u001b[81Gwith\u001b[86Gthe\u001b[90Gendpoint\u001b[99Gand\u001b[103Gtoken,\u001b[110Gand\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gtoken is kept privat\u001b[26G in the player's\u001b[43Gown \u001b[48Girectory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mClash:\u001b[22m it would be a new\u001b[30Gscreen file plus\u001b[47Gits s\u001b[53Grings\u001b[59Gin\u001b[62Gall\u001b[66Gfour\u001b[71Glanguages.\u001b[82GL37\u001b[86Gis\u001b[89Grestyling\u001b[99G\u001b[38;2;177;185;249mmanifest.rcss\u001b[39m,\u001b[114Gso\u001b[117Gthis\r\u001b[2C\u001b[1B \u001b[5Glane would use only th\u001b[28G sha\u001b[34Gd palette's cla\u001b[50Gses a\u001b[56Gd leave that fi\u001b[72Ge alon\u001b[79G. Anyth\u001b[87Gng it st\u001b[96Gll\u001b[99Gneeds in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmanifest.rcss\u001b[39m I'd add when m\u001b[34Grging.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. The client in the bundle\r\u001b[2C\u001b[1B\u001b[22m- It ships the graphical client\u001b[35Gbeside\u001b[42Gthe\u001b[46Gterminal\u001b[55GUI.\u001b[59GThat\u001b[64Gmeans\u001b[70Gstaging,\u001b[79Gthe\u001b[83Gdistribution\u001b[96Gcheck,\u001b[103Gand\u001b[107Ga\u001b[109Gsmoke\u001b[115Gtest\r\u001b[2C\u001b[1B \u001b[5Gof\u001b[8Gt\u001b[10Ge client in the bundl\u001b[32G, probably drawing offscreen on\u001b[64Glavapipe. It doesn't clash w\u001b[93Gth\u001b[96GL37.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe plan puts\u001b[20Gt\u001b[22Gafter the server picke\u001b[45G, but\u001b[51Gthe two don't depend on each other.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWait for L37 to merge:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA nozzle's\u001b[16Gglow:\u001b[22m it needs\u001b[31GJ27's\u001b[37Gemissive\u001b[46Gscale,\u001b[53Gwhich\u001b[59Gcomes\u001b[65Gwith\u001b[70GL37's\u001b[76Gpin\u001b[80Gmove.\r\u001b[4C\u001b[1B\u001b[1mNames, and\u001b[16Gthe galaxy panel:\u001b[22m both edit the\u001b[76GL37\u001b[80Gis changing.\u001b[27;1H\u001b[19;3H\u001b[?25h"]
[0.364, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- It's next in the client plan's order. It a\u001b[48Gds a\u001b[53Gscreen\u001b[60Glisting\u001b[68Gthe\u001b[72Gservers,\u001b[81Gwith\u001b[86Gthe\u001b[90Gendpoint\u001b[99Gand\u001b[103Gtoken,\u001b[110Gand\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gtoken is kept privat\u001b[26G in the player's\u001b[43Gown \u001b[48Girectory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mClash:\u001b[22m it would be a new\u001b[30Gscreen file plus\u001b[47Gits s\u001b[53Grings\u001b[59Gin\u001b[62Gall\u001b[66Gfour\u001b[71Glanguages.\u001b[82GL37\u001b[86Gis\u001b[89Grestyling\u001b[99G\u001b[38;2;177;185;249mmanifest.rcss\u001b[39m,\u001b[114Gso\u001b[117Gthis\r\u001b[2C\u001b[1B \u001b[5Glane would use only th\u001b[28G sha\u001b[34Gd palette's cla\u001b[50Gses a\u001b[56Gd leave that fi\u001b[72Ge alon\u001b[79G. Anyth\u001b[87Gng it st\u001b[96Gll\u001b[99Gneeds in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmanifest.rcss\u001b[39m I'd add when m\u001b[34Grging.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. The client in the bundle\r\u001b[2C\u001b[1B\u001b[22m- It ships the graphical client\u001b[35Gbeside\u001b[42Gthe\u001b[46Gterminal\u001b[55GUI.\u001b[59GThat\u001b[64Gmeans\u001b[70Gstaging,\u001b[79Gthe\u001b[83Gdistribution\u001b[96Gcheck,\u001b[103Gand\u001b[107Ga\u001b[109Gsmoke\u001b[115Gtest\r\u001b[2C\u001b[1B \u001b[5Gof\u001b[8Gt\u001b[10Ge client in the bundl\u001b[32G, probably drawing offscreen on\u001b[64Glavapipe. It doesn't clash w\u001b[93Gth\u001b[96GL37.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe plan puts\u001b[20Gt\u001b[22Gafter the server picke\u001b[45G, but\u001b[51Gthe two don't depend on each other.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWait for L37 to merge:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA nozzle's\u001b[16Gglow:\u001b[22m it needs\u001b[31GJ27's\u001b[37Gemissive\u001b[46Gscale,\u001b[53Gwhich\u001b[59Gcomes\u001b[65Gwith\u001b[70GL37's\u001b[76Gpin\u001b[80Gmove.\r\u001b[4C\u001b[1B\u001b[1mNames, and\u001b[16Gthe galaxy panel:\u001b[22m both edit the screens or\u001b[59Gtravel code that\u001b[76GL37\u001b[80Gis changing.\r\u001b[2C\u001b[1B \u001b[5G                            \u001b[34G    \u001b[39G    \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[19;3H\u001b[?25h"]
[0.121, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gtoken is kept privat\u001b[26G in the player's\u001b[43Gown \u001b[48Girectory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mClash:\u001b[22m it would be a new\u001b[30Gscreen file plus\u001b[47Gits s\u001b[53Grings\u001b[59Gin\u001b[62Gall\u001b[66Gfour\u001b[71Glanguages.\u001b[82GL37\u001b[86Gis\u001b[89Grestyling\u001b[99G\u001b[38;2;177;185;249mmanifest.rcss\u001b[39m,\u001b[114Gso\u001b[117Gthis\r\u001b[2C\u001b[1B \u001b[5Glane would use only th\u001b[28G sha\u001b[34Gd palette's cla\u001b[50Gses a\u001b[56Gd leave that fi\u001b[72Ge alon\u001b[79G. Anyth\u001b[87Gng it st\u001b[96Gll\u001b[99Gneeds in\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmanifest.rcss\u001b[39m I'd add when m\u001b[34Grging.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. The client in the bundle\r\u001b[2C\u001b[1B\u001b[22m- It ships the graphical client\u001b[35Gbeside\u001b[42Gthe\u001b[46Gterminal\u001b[55GUI.\u001b[59GThat\u001b[64Gmeans\u001b[70Gstaging,\u001b[79Gthe\u001b[83Gdistribution\u001b[96Gcheck,\u001b[103Gand\u001b[107Ga\u001b[109Gsmoke\u001b[115Gtest\r\u001b[2C\u001b[1B \u001b[5Gof\u001b[8Gt\u001b[10Ge client in the bundl\u001b[32G, probably drawing offscreen on\u001b[64Glavapipe. It doesn't clash w\u001b[93Gth\u001b[96GL37.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe plan puts\u001b[20Gt\u001b[22Gafter the server picke\u001b[45G, but\u001b[51Gthe two don't depend on each other.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWait for L37 to merge:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA nozzle's\u001b[16Gglow:\u001b[22m it needs\u001b[31GJ27's\u001b[37Gemissive\u001b[46Gscale,\u001b[53Gwhich\u001b[59Gcomes\u001b[65Gwith\u001b[70GL37's\u001b[76Gpin\u001b[80Gmove.\r\u001b[4C\u001b[1B\u001b[1mNames, and\u001b[16Gthe galaxy panel:\u001b[22m both edit the screens or\u001b[59Gtravel code that\u001b[76GL37\u001b[80Gis changing.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001