[0.020, "o", "\u001b[?25l\u001b[H\u001b[3G│\u001b[5GManifest\u001b[14GB\u001b[16G│\u001b[18GMoving\u001b[25Gthe\u001b[29Gpin\u001b[33Gto\u001b[36GJettison\u001b[45G\u001b[38;2;177;185;249m01eeae8\u001b[39m,\u001b[54Gthen\u001b[59GL37's\u001b[65Gcruising\u001b[74Grefinements\u001b[93G│\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│ Manifest C │ L41: the terminal UI rese\u001b[44Gding\u001b[49Glost \u001b[55Gequests,\u001b[64Gand\u001b[68Gthe\u001b[72Gcontainer\u001b[82Gruns\u001b[87Gin\u001b[90GCI\u001b[93G│\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Jettison\u001b[14GB │ J26: the\u001b[27Ggame UI following\u001b[45G\u001b[38;2;177;185;249mdev.palette\u001b[39m,\u001b[58Gand\u001b[62Gthe italic face   \u001b[81G      \u001b[88G     │\u001b[K\r\u001b[2C\u001b[1B├────────────┼────────────────────────────────────────────────────────────────────────────┤\r\u001b[1B \u001b[3G│ Jettison C │ J12: a model's collision shape\u001b[49Gbaked\u001b[55Gto\u001b[58Ga\u001b[60Gfile\u001b[65Gthat\u001b[70Gphysics\u001b[78Greads\u001b[93G│\r\u001b[2C\u001b[1B└────────────┴────────────────────────────────────────────────────────────────────────────┘\r\u001b[1B\u001b[K\r\u001b[1B  I'll merge each\u001b[19Glane when it finishes, then run one gate\u001b[60Gper\u001b[64Grepo\u001b[69Gfor\u001b[73Gthe\u001b[77Gbatch\u001b[83Gbefore\u001b[90Gpushing.\r\u001b[2B \u001b[3GThe container runs in CI can\u001b[32Gonly\u001b[37Gbe\u001b[40Gseen\u001b[45Gworking\u001b[53Gafter\u001b[59Ga\u001b[61Gpush,\u001b[67Gthough\u001b[74Gthe\u001b[78GL41\u001b[82Gagent\u001b[88Gwill\u001b[93Grun\u001b[97Gthem\u001b[102Glocally\u001b[110Gwith\u001b[115GDocker\r\u001b[1B  first.\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
[0.040, "o", "\u001b[?25l\u001b[H\u001b[5G   Lane \u001b[14G \u001b[18G      \u001b[25G   \u001b[29G   \u001b[33G  \u001b[36G        \u001b[45G        Work \u001b[59G     \u001b[65G        \u001b[74G           \r\u001b[13C\u001b[2BB\u001b[18GMoving the pin to\u001b[36GJetti\u001b[42Go\u001b[44G \u001b[38;2;177;185;249m01eeae8\u001b[39m,\u001b[54Gthen L37's cruising ref\u001b[80Gments \u001b[87G  \u001b[90G  \r\u001b[4C\u001b[2BManifest\u001b[14GC\u001b[18GL41\u001b[27Gterminal UI resending lost requests, and the container\u001b[82Gruns\u001b[87Gin\u001b[90GCI\r\u001b[13C\u001b[2BB\u001b[19G26\u001b[23Gthe game UI following \u001b[38;2;177;185;249mdev.palette\u001b[39m,\u001b[59Gnd the italic fa\u001b[76Ge\u001b[78G     \r\u001b[2C\u001b[1B├\u001b[16G┼\u001b[93G┤\r\u001b[2C\u001b[1B│\u001b[5GJettison\u001b[14GC\u001b[16G│\u001b[18GJ12:\u001b[23Ga\u001b[25Gmodel's\u001b[33Gcollision\u001b[43Gshape\u001b[49Gbaked\u001b[55Gto\u001b[58Ga\u001b[60Gfile\u001b[65Gthat\u001b[70Gphysics\u001b[78Greads\u001b[93G│\r\u001b[2C\u001b[1B└────────────┴────────────────────────────────────────────────────────────────────────────┘\u001b[K\r\u001b[2C\u001b[2BI'll merge \u001b[15Gach lane when it\u001b[32Gfinish\u001b[39Gs, then \u001b[48Gun one gate per repo for the batch b\u001b[85Gfore pushi\u001b[96Gg.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcontainer\u001b[17Gruns\u001b[22Gin\u001b[25GCI\u001b[28Gcan\u001b[32Gonly\u001b[37Gbe\u001b[40Gseen\u001b[45Gworking\u001b[53Gafter\u001b[59Ga\u001b[61Gpush,\u001b[67Gthough\u001b[74Gthe\u001b[78GL41\u001b[82Gagent\u001b[88Gwill\u001b[93Grun\u001b[97Gthem\u001b[102Glocally\u001b[110Gwith\u001b[115GDocker\r\u001b[1B \u001b[3Gfirst.\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent · ↓ to\u001b[59Gmanage\u001b[39m\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
