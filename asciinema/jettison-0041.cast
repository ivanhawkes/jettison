[0.033, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison's\u001b[14Ggate\u001b[19Gpassed\u001b[26Gin\u001b[29G240\u001b[33Gs.\u001b[36GNow\u001b[40GManifest's,\u001b[52Gfor\u001b[56GL53.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mA new player joining the server, when they are granted a corporation and ship, they can name themselves and the \u001b[39m      \r\u001b[1B  \u001b[38;2;255;255;255mcorporation.\u001b[16GThey also need to be able to n\u001b[47Gm\u001b[50Gthe ship at the same time.\u001b[39m                                       \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm\u001b[7Gnoting\u001b[14Gthat\u001b[19Gthe\u001b[23Gfounding\u001b[32Gstep\u001b[37Gshould\u001b[44Galso\u001b[49Gname\u001b[54Gthe\u001b[58Gstarting\u001b[67Gship,\u001b[73Gwhich\u001b[79GD-123\u001b[85Gallows,\u001b[93Gand\u001b[97GI'll\u001b[102Gqueue\u001b[108Git\u001b[111Gin\r\u001b[1B \u001b[3GManifest lane C\u001b[19Gonce Ma\u001b[27Gifest's gate finishes.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery\u001b[9Gbuild\u001b[15Gand\u001b[19Gtest\u001b[24Gstage\u001b[30Gpassed.\u001b[38GTidy\u001b[43Ghas\u001b[47Gone\u001b[51Gfinding\u001b[59Gin\u001b[62GL53's\u001b[68Gclient,\u001b[76G\u001b[38;2;177;185;249muse auto\u001b[39m.\u001b[86GFixing\u001b[93Git,\u001b[97Gthen\u001b[102Grunning\u001b[110Gtidy\u001b[115Galone,\r\u001b[1B \u001b[3Gsince\u001b[9Gthe gate skips\u001b[24Ga passing stage only whe\u001b[49G nothing has\u001b[62Gchanged.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48Gexport\u001b[55GMANIF…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && export MANIFEST_TIDY_JOBS='24'; python3 scripts/tidy.py build/clang-debug \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m(3s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
