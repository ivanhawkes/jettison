[0.764, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gmerged\u001b[12GJ26's\u001b[18Gexact\u001b[24Gdarks\u001b[30Ginto\u001b[35GJettison's\u001b[46G\u001b[38;2;177;185;249mfeature-base\u001b[59G\u001b[39m(\u001b[38;2;177;185;249m4e17f51\u001b[39m,\u001b[69Gplus\u001b[74G\u001b[38;2;177;185;249m8fcaa9a\u001b[82G\u001b[39mfor\u001b[86Gthe\u001b[90Groadmap\u001b[98Gand\u001b[102Ghistory).\u001b[112GLike\u001b[117Gthe\r\u001b[1B \u001b[3Gmotion-profile\u001b[18Gwork,\u001b[24Git i\u001b[29Gn't gat\u001b[37Gd or pu\u001b[45Ghed yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat changed:\u001b[19G\u001b[22mthe\u001b[23Gdev\u001b[27Gtools'\u001b[34Gdarkest\u001b[42Gcolours\u001b[50Gnow\u001b[54Gland\u001b[59Gexactly.\u001b[68GMocha's\u001b[76G\u001b[38;2;177;185;249m#1e1e2e\u001b[84G\u001b[39mwas\u001b[88Gdrawing\u001b[96Gas\u001b[99G\u001b[38;2;177;185;249m#1c1c2e\u001b[39m;\u001b[108Ga\u001b[110Gheadless\r\u001b[2C\u001b[1B \u001b[5Glavapipe frame now reads \u001b[38;2;177;185;249m#1e1e2e\u001b[39m, \u001b[38;2;177;185;249m#181825\u001b[39m and \u001b[38;2;177;185;249m#11111b\u001b[39m. The theme no longer depend\u001b[88Gon the UI's colour format, so a\r\u001b[4C\u001b[1Bformat change mid-run leaves it nothing to fix.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecks:\u001b[22m the ui, \u001b[22Gevtoo\u001b[28Gs, app and render suites\u001b[53Gpass,\u001b[59Gthe\u001b[63G12\u001b[66Greference\u001b[76Gviews\u001b[82Gare\u001b[86Gunchanged\u001b[96Gto\u001b[99Gthe\u001b[103Gpixel,\u001b[110Gand\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gsmoke test passes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot done:\u001b[22m the r\u001b[21Gnderer\u001b[28Gstill\u001b[34Gthrows\u001b[41Gif\u001b[44Gthe\u001b[48Gswapchain\u001b[58Gcomes\u001b[64Gback\u001b[69Gin\u001b[72Ga\u001b[74Gdifferent\u001b[84Gformat\u001b[91Gmid-run.\u001b[100GHandling\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[2C\u001b[1B \u001b[5Greal GPU to test, since lavapipe can't\u001b[44Gc\u001b[46Gange format, so I've added it as a row under\u001b[91GJ27 \u001b[96Gather than doing it now.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStill open in J26:\u001b[22m the game UI's\u001b[38Gstylesheet in the same palette, and \u001b[75Ghe p\u001b[80Glette as a\u001b[91Gplayer s\u001b[100Gtting.\u001b[107G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Glanes\u001b[13Gnow:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────┬─────────────────────────────────────┐\r\u001b[2C\u001b[1B│      Lane       │                State                │\r\u001b[2C\u001b[1B├─────────────────┼─────────────────────────\u001b[27;1H\u001b[21;3H\u001b[?25h"]
