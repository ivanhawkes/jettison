[0.090, "o", "\u001b[?25l\u001b[H\u001b[3G2. A journey's fuel is still\u001b[32Gpriced\u001b[39Gas\u001b[42Gif\u001b[45Gthe\u001b[49Gship\u001b[54Gstarts\u001b[61Gand\u001b[65Gends\u001b[70Gat\u001b[73Grest,\u001b[79Gso\u001b[82Git\u001b[85Goverstates\u001b[96Gthe\u001b[100Gburn.\u001b[106GA\u001b[108Grow\u001b[112Gfor\u001b[116Gthat\r\u001b[2C\u001b[1B  \u001b[6Gt\u001b[8Go?\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GDo you want\u001b[18Ga J27 row for\u001b[32Greloa\u001b[38Ging\u001b[42Ga shader's \u001b[38;2;177;185;249m.program.yaml\u001b[39m \u001b[68Gescription\u001b[79Gas\u001b[85Gchanges?\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll four lanes\u001b[19Gre free.\u001b[28G\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m1. yes\u001b[39m                                                                                                                \r\u001b[1B  \u001b[38;2;255;255;255m2. yes\u001b[39m                                                                                                                \r\u001b[1B  \u001b[38;2;255;255;255m3\r\u001b[2C\u001b[1B\u001b[39m      \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mfinish up everything, test, merge, then push\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Queue rows for 1 and 2 and a J27 row for 3 are next, to be added once both gates finish since Manifest refuses\u001b[K\r\u001b[2C\u001b[1Bcheckouts\u001b[13Gwith\u001b[18Guncommitted\u001b[30Gchanges.\u001b[39GThen\u001b[44GI'll\u001b[49Gcheck\u001b[55Gthe\u001b[59Glinks\u001b[65Gand\u001b[69Gpush\u001b[74Gboth\u001b[79Grepos.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJett\u001b[8Gson's gate\u001b[19Gpassed in\u001b[29G308\u001b[33Gs\u001b[35Gwith\u001b[40Gall\u001b[44Gstages\u001b[51Ggreen;\u