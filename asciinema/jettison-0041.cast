[0.008, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- It opens when no server is\u001b[32Ggiven\u001b[38Gon\u001b[41Gthe\u001b[45Gcommand\u001b[53Gline.\u001b[59GSaved\u001b[65Gservers\u001b[73Glive\u001b[78Gin\u001b[81Gthe\u001b[85Gterminal\u001b[94GUI's\u001b[99Gexisting\u001b[108Glist,\u001b[114Gwith\r\u001b[2C\u001b[1B \u001b[5Gtokens written \u001b[21Gwn\u001b[25G-only.\u001b[32G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI moved its pass\u001b[22Gord field's\u001b[34Gstyle\u001b[40Ginto\u001b[45G\u001b[38;2;177;185;249mmanifest.rcss\u001b[59G\u001b[39mbeside\u001b[66Gthe\u001b[70Gtext\u001b[75Gfields.\r\u001b[4C\u001b[1BThe whole ctest passed (69 of 69).\u001b[40G\u001b[K\r\u001b[6C\u001b[1Bree \u001b[12Gf its commit messages still\u001b[40Gsay\u001b[44GD-127,\u001b[51Gwhile\u001b[57Gthe\u001b[61Gfiles\u001b[67Gsay\u001b[71GD-128.\r\u001b[4C\u001b[1BA bare \u001b[38;2;177;185;249mmanifest_client\u001b[39m now opens the picker; use \u001b[38;2;177;185;249m--scenario trading\u001b[39m to play\u001b[81Glocally\u001b[89Gstraight\u001b[98Gaway.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ20's clamps\u001b[16G\u001b[22m(Jettison)\r\u001b[2C\u001b[1B- Clamps on a v\u001b[19Ghicle with\u001b[30Ga\u001b[32Gcollision\u001b[42Gfile\u001b[47Gnow\u001b[51Ggrip\u001b[56Gits\u001b[60Gshape,\u001b[67Gworked\u001b[74Gout\u001b[78Gonce\u001b[83Gper\u001b[87Gdefinition.\r\u001b[4C\u001b[1BA clamp with no side within reach stays open.\u001b[51G\u001b[K\r\u001b[4C\u001b[1BBox vehicles\u001b[18Gare unchanged,\u001b[33Gand no pin\u001b[46Gr frames\u001b[55Gmoved.\r\u001b[4C\u001b[1BI couldn't capture it: no engine scene draws docked clamps,\u001b[65Gand\u001b[69GManifest\u001b[78Ghas\u001b[82Gno\u001b[85Gclamp\u001b[91Gdressing\u001b[100Gyet\u001b[104Gto\u001b[107Guse\u001b[111Gthe\u001b[115Ggrips.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAlso fixed:\u001b[15G\u001b[22m14\u001b[18Glinks\u001b[24Gin\u001b[27GManifest's\u001b[38Gdocs\u001b[43Gstill\u001b[49Gpointed\u001b[57Gat\u001b[60GJettison\u001b[69Groadmap\u001b[77Gentries\u001b[85Gthat\u001b[90Ghave\u001b[95Gmoved\u001b[101Gto\u001b[104Gits\u001b[108Ghistory.\u001b[117GThey\r\u001b[2C\u001b[1Bpoint at the history\u001b[24Gnow.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOpen, needing your say:\r\u001b[2C\u001b[1B\u001b[22m1. Nothing checks a cruise\u001b[30Gpassing\u001b[38G\u001b[3manother\u001b[46G\u001b[23mpopulated\u001b[56Gbody\u001b[61Gwhile\u001b[67Gthe\u001b[71Gdrive\u001b[77Gis\u001b[80Gthrusting.\u001b[91GShould\u001b[98Gthat\u001b[103Gget\u001b[107Ga\u001b[109Gqueue\u001b[115Grow?\r\u001b[2C\u001b[1B2\u001b[6GA journey's fuel\u001b[23Gis still pr\u001b[35Gced as if the ship starts\u001b[61Gand \u001b[66Gnds at rest, so it overstates the burn. A row for that\r\u001b[2C\u001b[1B  \u001b[6Gtoo?       \u001b[18G    \u001b[23G  \u001b[26G     \u001b[32G      \u001b[39G  \u001b[42G  \u001b[45G  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
