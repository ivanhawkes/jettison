[0.054, "o", "\u001b[?25l\u001b[H \u001b[3G1. \u001b[1mMove Manifest's world under \u001b[38;2;177;185;249mdefs/\u001b[22m\u001b[39m (its definitions and\u001b[61Gsc\u001b[64Gnarios), recorded as a new\u001b[91Gdecision. Afterwards, the\r\u001b[2C\u001b[1B   s\u001b[8Grver pack\u001b[18Gand\u001b[22Gthe\u001b[26Gclient/world\u001b[39Gsplit\u001b[45Gwill\u001b[50Gsee\u001b[54GManifest's\u001b[65Gworld.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mName mounts the same on both ends:\u001b[41G\u001b[22mthe\u001b[45Gserver\u001b[52Gmounts\u001b[59Gits\u001b[63Goverlays\u001b[72Gas\u001b[75G\u001b[38;2;177;185;249mmod:<name>\u001b[39m,\u001b[87Gas\u001b[90Gthe\u001b[94Gshell\u001b[100Gdoes.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mThe content check itself:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B- Th\u001b[11G server's welcome carries it\u001b[40G world cont\u001b[52Gnt.\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- The graphical client and the consol\u001b[45Gr\u001b[47Gfuse\u001b[52Ga server wh\u001b[64Gs\u001b[66G content\u001b[75Gdiffers, and name the package in\u001b[108Gthe\u001b[112Gstatus\r\u001b[2C\u001b[1B  \u001b[6G  line or the console.\u001b[K\r\u001b[7C\u001b[1BA matching cli\u001b[23Gnt plays as before, \u001b[38;2;177;185;249mclient_serve\u001b[56G\u001b[39mincluded.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Greview i\u001b[17G when it finishes,\u001b[36Grebase\u001b[43Git,\u001b[47Grun\u001b[51GManifest's\u001b[62Ggate\u001b[67Gand\u001b[71Gmerge.\u001b[78GThe\u001b[82Gother\u001b[88Gthree\u001b[94Glanes\u001b[100Gare\u001b[104Gfree.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m1\u001b[22m background agent to finish\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mAgent\u001b[22m(Implement\u001b[19GL53\u001b[23Gcontent\u001b[31Gcheck)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded agent\u001b[38;2;153;153;153m (↓\u001b[28Gto manage · ctrl+o to 