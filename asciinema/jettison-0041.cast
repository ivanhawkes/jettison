[0.366, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mL37\u001b[7Gand\u001b[11GJ26\u001b[15Gare\u001b[19Grunning\u001b[27Gin\u001b[30Gtheir\u001b[36Glanes,\u001b[43Gand\u001b[47G\u001b[38;2;177;185;249m-gline-tables-only\u001b[66G\u001b[39mis\u001b[69Gmerged\u001b[76Ginto\u001b[81G\u001b[38;2;177;185;249mfeature-base\u001b[94G\u001b[39min\u001b[97Gboth\u001b[102Grepos.\u001b[109GNothing\u001b[117Gis\r\u001b[1B \u001b[3Gpushed yet,\u001b[16Gnd\u001b[19Gno\u001b[22Ge of\u001b[28Gt\u001b[30Ghas been through\u001b[47Gthe full gate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m\u001b[1m-gline-tables-only\u001b[39m:\u001b[23G\u001b[22mit\u001b[26Gdoesn't\u001b[34Gslow\u001b[39Gthe\u001b[43Gprogram,\u001b[52Gbecause\u001b[60Gthe\u001b[64Gshipped\u001b[72Gcode\u001b[77Gis\u001b[80Gunchanged.\u001b[91GI\u001b[93Gcompiled\u001b[102G8\u001b[104Gof\u001b[107Gthe\u001b[111Glargest\r\u001b[2C\u001b[1Btranslation units in both repos with and without\u001b[52Git, and\u001b[60Gonce stripped the\u001b[78Gr\u001b[80Gdisassembly is byte-identical,\u001b[111Gas are the\r\u001b[2C\u001b[1Bobject s\u001b[12Gzes. The\u001b[21Gcost is\u001b[29Gbuild\u001b[35Gs\u001b[37Gze\u001b[40Go\u001b[42Gly: object files are 2–3× larger, and\u001b[80Gthe debug tarball kept beside the\u001b[114Gbundle\u001b[K\r\u001b[2C\u001b[1Bgrows.\u001b[10GI added it\u001b[21Gt\u001b[23G \u001b[38;2;177;185;249mclang-release\u001b[39m in both\u001b[46Grepos (C and\u001b[59GC++), and updated the pres\u001b[86Gts table and the\u001b[103Gcrash-report\u001b[K\r\u001b[2C\u001b[1Bdeci\u001b[8Gion\u001b[12Gto match.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRunning in the lanes:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mManifest\u001b[14Glane B:\u001b[22m first\u001b[28Gthe\u001b[32Gpin\u001b[36Gmove\u001b[41Gto\u001b[44GJettison\u001b[53G\u001b[38;2;177;185;249m01eeae8\u001b[39m,\u001b[62Gwith\u001b[67Gthe\u001b[71Gthree\u001b[77Gfollow-ups\u001b[88Git\u001b[91Gowes.\u001b[97GThen\u001b[102GL37's\u001b[108Gsix\u001b[112Gcruising\r\u001b[2C\u001b[1B \u001b[5Gitems, each tested in the \u001b[38;2;177;185;249mspace\u001b[39m suite.\u001b[44GIf an item needs an engin\u001b[71Gc\u001b[73Gange, the agent will \u001b[95Gtop o\u001b[102Gthat item\u001b[112Gand\u001b[K\r\u001b[4C\u001b[1Breport\u001b[12Git ra\u001b[18Gher tha\u001b[27Gedit Jetti\u001b[38Gon.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison lane B:\u001b[22G\u001b[22mJ26's game UI following\u001b[46G\u001b[38;2;177;185;249mdev.palette\u001b[58G\u001b[39mthrough\u001b[66GRmlUi\u001b[72Gthemes,\u001b[80Ga\u001b[82Gloaded\u001b[89Gitalic\u001b[96Gface\u001b[101Gfor\u001b[105G\u001b[38;2;177;185;249mem\u001b[39m,\u001b[109Gand\u001b[113Ga\r\u001b[2C\u001b[1B \u001b[5Gwarning when a font face is\u001b[33Gmissing. J26's third item, the palette\u001b[72Gas a player setting, belongs\u001b[101Gon the g\u001b[110Gme's\r\u001b[4C\u001b[1Bsett\u001b[12Gs screen, so\u001b[25GI l\u001b[29Gft it out.  \u001b[42G     \u001b[77G\u001b[K\u001b[27;1H\u001b[20;3H\u001b[?25h"]
[0.314, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gpushed yet,\u001b[16Gnd\u001b[19Gno\u001b[22Ge of\u001b[28Gt\u001b[30Ghas been through\u001b[47Gthe full gate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m\u001b[1m-gline-tables-only\u001b[39m:\u001b[23G\u001b[22mit\u001b[26Gdoesn't\u001b[34Gslow\u001b[39Gthe\u001b[43Gprogram,\u001b[52Gbecause\u001b[60Gthe\u001b[64Gshipped\u001b[72Gcode\u001b[77Gis\u001b[80Gunchanged.\u001b[91GI\u001b[93Gcompiled\u001b[102G8\u001b[104Gof\u001b[107Gthe\u001b[111Glargest\r\u001b[2C\u001b[1Btranslation units in both repos with and without\u001b[52Git, and\u001b[60Gonce stripped the\u001b[78Gr\u001b[80Gdisassembly is byte-identical,\u001b[111Gas are the\r\u001b[2C\u001b[1Bobject s\u001b[12Gzes. The\u001b[21Gcost is\u001b[29Gbuild\u001b[35Gs\u001b[37Gze\u001b[40Go\u001b[42Gly: object files are 2–3× larger, and\u001b[80Gthe debug tarball kept beside the\u001b[114Gbundle\u001b[K\r\u001b[2C\u001b[1Bgrows.\u001b[10GI added it\u001b[21Gt\u001b[23G \u001b[38;2;177;185;249mclang-release\u001b[39m in both\u001b[46Grepos (C and\u001b[59GC++), and updated the pres\u001b[86Gts table and the\u001b[103Gcrash-report\u001b[K\r\u001b[2C\u001b[1Bdeci\u001b[8Gion\u001b[12Gto match.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRunning in the lanes:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mManifest\u001b[14Glane B:\u001b[22m first\u001b[28Gthe\u001b[32Gpin\u001b[36Gmove\u001b[41Gto\u001b[44GJettison\u001b[53G\u001b[38;2;177;185;249m01eeae8\u001b[39m,\u001b[62Gwith\u001b[67Gthe\u001b[71Gthree\u001b[77Gfollow-ups\u001b[88Git\u001b[91Gowes.\u001b[97GThen\u001b[102GL37's\u001b[108Gsix\u001b[112Gcruising\r\u001b[2C\u001b[1B \u001b[5Gitems, each tested in the \u001b[38;2;177;185;249mspace\u001b[39m suite.\u001b[44GIf an item needs an engin\u001b[71Gc\u001b[73Gange, the agent will \u001b[95Gtop o\u001b[102Gthat item\u001b[112Gand\u001b[K\r\u001b[4C\u001b[1Breport\u001b[12Git ra\u001b[18Gher tha\u001b[27Gedit 