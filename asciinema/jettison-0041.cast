[0.285, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\"A m\u001b[8Gdel\u001b[12Gfile read\u001b[22Gonce\" (J27) is merged into Jet\u001b[53Gison's\u001b[60G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[74Gand\u001b[78Gits\u001b[82Grow\u001b[86Gmoved\u001b[92Gfrom\u001b[97Gthe\u001b[101Groadmap\u001b[109Gto\u001b[112Gthe\r\u001b[2C\u001b[1Bhistory.\u001b[12GIt\u001b[15Ghasn't\u001b[22Gbeen\u001b[27Gthrough\u001b[35Gthe\u001b[39Gbatch\u001b[45Ggate\u001b[50Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat changed:\u001b[22m a\u001b[21GglTF file is now\u001b[38Gread\u001b[43Gand parsed once,\u001b[60Gand\u001b[64Gboth\u001b[69Gits\u001b[73Grig\u001b[77Gand\u001b[81Gits\u001b[85Ggeometry\u001b[94Gare\u001b[98Gmade\u001b[103Gfrom\u001b[108Gthat\u001b[113Gone\r\u001b[2C\u001b[1B \u001b[5Gparse. A change on disk rebuilds bo\u001b[41Gh from on\u001b[51G read.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhere the parse lives:\u001b[22m in the anim\u001b[40Gtion module,\u001b[53Gwhich the\u001b[63Grenderer already depends on,\u001b[92Gso no module gained\u001b[112Ga\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gdependency.\u001b[17GThe resource manager has a new kind of loader that makes\u001b[74Go\u001b[76Ge resource fro\u001b[91G ano\u001b[96Gher\u001b[100Gof the s\u001b[109Gme\u001b[112Gpat\u001b[116G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecks:\u001b[22m the\u001b[17Gfull\u001b[22Gsuite\u001b[28Gpasses\u001b[35G(35\u001b[39Gof 35),\u001b[47Gall\u001b[51G13\u001b[54Greference\u001b[64Gviews\u001b[70Gare\u001b[74Gunchanged,\u001b[85Gthe\u001b[89Gsmoke\u001b[95Gtest\u001b[100Gpasses,\u001b[108Gand\u001b[112Gno\u001b[115Ghash\r\u001b[4C\u001b[1Bpin\u001b[9Gmoved.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTrade-off:\u001b[14G\u001b[22mwhile a \u001b[23Gcene lo\u001b[31Gds, \u001b[36G mod\u001b[41Gl\u001b[43Gnow\u001b[47Ga\u001b[49Grive\u001b[54G one update\u001b[67Gfter its rig. The\u001b[85Gfade\u001b[90Gthat\u001b[95Gholds\u001b[101Gthe\u001b[105Gscene\u001b[111Guntil\u001b[117Gits\r\u001b[2C\u001b[1Bmodels\u001b[10Gare\u001b[14Gin\u001b[17Gcovers\u001b[24Gthis,\u001b[30Gand\u001b[34Gcaptures\u001b[43Gand\u001b[47Gframe-stepped\u001b[61Gruns\u001b[66Gare\u001b[70Gunaffected.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mName left stale:\u001b[20G\u001b[22m\u001b[38;2;177;185;249mRegisterRigLoader\u001b[38G\u001b[39mnow\u001b[42Galso\u001b[47Gregisters\u001b[57Gthe\u001b[61Gmodel-file\u001b[72Gparse,\u001b[79Gbut\u001b[83Gthe\u001b[87Gagent\u001b[93Gkept\u001b[98Gthe\u001b[102Gname.\r\u001b[2C\u001b[1B                         \u001b[29G        \u001b[38G    \u001b[43G    \u001b[77G\u001b[K\u001b[27;1H\u001b[19;3H\u001b[?25h"]
