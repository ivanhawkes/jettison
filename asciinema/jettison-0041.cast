001b[108Gboth\u001b[113Gends\u001b[118Gat\r\u001b[2C\u001b[1B \u001b[5Grest the results are bit-identic\u001b[38Gl to before, and no hash\u001b[63Gpin, save or reference f\u001b[88Game moved.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChecks:\u001b[22m seven suites\u001b[26Gpasse\u001b[32G. W\u001b[36Gth end\u001b[43Gspeeds\u001b[51Gthe\u001b[55Gresults\u001b[63Gmatch \u001b[70G stepped simulation.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIt\u001b[6Gleaves\u001b[13Gthree\u001b[19Gpoints\u001b[26Gfor\u001b[30GManifest's\u001b[41GL37\u001b[45Gto\u001b[48Gsettle:\r\u001b[2C\u001b[1B- Th\u001b[8G thrust figure Manifest prices fuel fr\u001b[47Gm doesn't\u001b[57Gcount\u001b[63Gthe\u001b[67Gdrift's\u001b[75Gown\u001b[79Gacceleration.\r\u001b[4C\u001b[1BAt low thrust shares (20 basis points), sl\u001b[75Ged m\u001b[80Gy not fit, and\u001b[95Gthe\u001b[99Gprofile\u001b[107Gthen\u001b[112Grefuses\u001b[27;1H\u001b[21;3H\u001b[?25h"]
