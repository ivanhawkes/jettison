[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mJettison lane C: J12, a glTF model's collision shape\u001b[22m (recomm\u001b[64Gnded)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA small tool bakes a mod\u001b[30Gl's collision shap\u001b[49G into a file beside the model. It uses\u001b[88Gthe\u001b[92Gmodel's \u001b[101Gwn \u001b[38;2;177;185;249mcollision-\u001b[39m nodes,\r\u001b[4C\u001b[1Bor convex hulls simplified from\u001b[37Gthe drawn mesh.\u001b[53GPhysics\u001b[61Greads\u001b[67Gthat\u001b[72Gfile,\u001b[78Gso\u001b[81Gclient\u001b[88Gand\u001b[92Gserver\u001b[99Gcollide\u001b[107Gwith\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gbytes. The\u001b[16Gapproach was decid\u001b[35Gd on 2026-11-27.\u001b[K\r\u001b[7C\u001b[1Bmatters to Manifest bec\u001b[32Guse a hull drawn\u001b[49Gfrom a\u001b[56Gmodel currently collides as it\u001b[88Gbox.\u001b[93G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt works in physics, dock\u001b[31Gand\u001b[35Gtools;\u001b[42GJ26\u001b[46Gis\u001b[49Gin\u001b[52Gthe\u001b[56GUI,\u001b[60Gso\u001b[63Gthey\u001b[68Gdon't\u001b[74Gmeet.\u001b[80GIt\u001b[83Gdoes\u001b[88Gneed\u001b[93Ga\u001b[95Gnew\u001b[99Gfile\u001b[104Gformat,\u001b[112Gwhich\u001b[118GI'd\r\u001b[4C\u001b[1Brecord\u001b[12Gin\u001b[15G\u001b[38;2;177;185;249mdecisions.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmaller Jettison alternative: J29, the ground sample's rover.\u001b[22m The rov\u001b[73Gr slides like\u001b[87Ga\u001b[89Gbox,\u001b[94Gso\u001b[97Git\u001b[100Gwould\u001b[106Gbe\u001b[109Ggiven\u001b[115Ggrip.\r\u001b[2C\u001b[1BIt\u001b[6Gonly\u001b[11Gtouches\u001b[19Gthe\u001b[23Gsample,\u001b[31Gso\u001b[34Git's\u001b[39Gthe\u001b[43Gsafest,\u001b[51Gbut\u001b[55Git's\u001b[60Gof\u001b[63Glittle\u001b[70Guse\u001b[74Gto\u001b[77GManifest.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot now:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B64 (vertex pulling): large, and\u001b[38Gevery refere\u001b[51Gce\u001b[54Gframe is at risk.\r\u001b[4C\u001b[1BJ16: its own\u001b[18Gr\u001b[20Gadm\u001b[24Gp row\u001b[30Gsays to take it up only wh\u001b[57Gn needed.\r\u001b[2C\u001b[1B-\u001b[5GL08\u001b[9Gand\u001b[13GL38:\u001b[18Gboth\u001b[23Gare\u001b[27Gin\u001b[30Gthe\u001b[34Gspace\u001b[40Gmodule,\u001b[48Galongside\u001b[58GL37.\r\u001b[2C\u001b[1B     \u001b[9G \u001b[11G     \u001b[17G   \u001b[21G   \u001b[25G    \u001b[27;1H\u001b[20;3H\u001b[?25h"]
