[0.131, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mUpdate\u001b[22m(~/projects/manifest.lane-b/docs/space.md)\r\u001b[5C\u001b[1BAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 501 \u001b[22m [\u001b[38;2;230;219;116mdecisions\u001b[39m](decision-ledger.md#space-star-systems-lanes-gates-and-cruising).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 502 \u001b[22m The key ones: a scenario's systems and drives as records ([\u001b[38;2;230;219;116mD-088\u001b[39m](decision-ledger.md#d-088)), the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 503 \u001b[22m cruise\u001b[19Glimited\u001b[27Gby\u001b[30Gacceleration\u001b[43Gin\u001b[46Gthe\u001b[50GManifest\u001b[59Gmode\u001b[64G([\u001b[38;2;230;219;116mD-090\u001b[39m](decision-ledger.md#d-090)),\u001b[101Gits\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 504 -\u001b[38;2;248;248;242mrefinements ([D-\u001b[48;2;92;2;0m125\u001b[48;2;61;1;0m](decision-ledger.md#d-\u001b[48;2;92;2;0m125\u001b[48;2;61;1;0m)), and, open, stargates                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 504 +\u001b[38;2;248;248;242mrefinements ([\u001b[38;2;230;219;116mD-\u001b[48;2;4;71;0m127\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m](decision-ledger.md#d-\u001b[48;2;4;71;0m127\u001b[48;2;2;40;0m)), and, open, stargates                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 505 \u001b[12G\u001b[22m([\u001b[38;2;230;219;116mD-017\u001b[39m](decision-ledger.md#d-017))\u001b[48Gand\u001b[52Gmoongates\u001b[62G([\u001b[38;2;230;219;116mD-091\u001b[39m](decision-ledger.md#d-091)).\r\u001b[1B \u001b[3G   \u001b[2m 506 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 507 \u001b[22m ## Source\u001b[K\r\u001b[10C\u001b[2B\u001b[1m3\u001b[22m shell comm\u001b[25Gds…\u001b[K\r\u001b[24C\u001b[3B\u001b[K\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m2m 41s ·\u001b[24G↓\u001b[39m \u001b[38;2;153;153;153m1.9k toke\u001b[36Gs)\u001b[39m\u001b[K\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m2\r\u001b[98C\u001b[3B\u001b[38;2;153;153;153m2\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
