12Gin\u001b[15G\u001b[38;2;177;185;249mdecisions.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmaller Jettison alternative: J29, the ground sample's rover.\u001b[22m The rov\u001b[73Gr slides like\u001b[87Ga\u001b[89Gbox,\u001b[94Gso\u001b[97Git\u001b[100Gwould\u001b[106Gbe\u001b[109Ggiven\u001b[115Ggrip.\r\u001b[2C\u001b[1BIt\u001b[6Gonly\u001b[11Gtouches\u001b[19Gthe\u001b[23Gsample,\u001b[31Gso\u001b[34Git's\u001b[39Gthe\u001b[43Gsafest,\u001b[51Gbut\u001b[55Git's\u001b[60Gof\u001b[63Glittle\u001b[70Guse\u001b[74Gto\u001b[77GManifest.\r\u001b[2C\u001b[1B        \u001b[27;1H\u001b[20;3H\u001b[?25h"]
