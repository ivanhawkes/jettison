[0.103, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5GThis lives in the console tool, which L37 doesn't\u001b[55Gtouch.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe container runs automated.\u001b[35G\u001b[22mCI's \u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m step runs on\u001b[68Gy \u001b[38;2;177;185;249mhost\u001b[39m today. I'd add the Ubuntu 24.04 and Debian 13\r\u001b[4C\u001b[1Brun\u001b[9G to\u001b[13GGitHub Actio\u001b[26Gs, who\u001b[33Ge runners\u001b[43Ghave\u001b[48GDocker;\u001b[56GDocker\u001b[63Gis\u001b[66Galso\u001b[71Ghere\u001b[76Glocally\u001b[84Gto\u001b[87Gtry\u001b[91Gthem\u001b[96Gfirst.\u001b[103GWe'd\u001b[108Gonly\u001b[113Gsee\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5GCI side work \u001b[19Gn the next\u001b[30Gpush.\r\u001b[2C\u001b[1B-\u001b[5GThat\u001b[10Gwould\u001b[16Gclose\u001b[22GL41.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison lane C: J12, a glTF model's collision shape\u001b[22m (recomm\u001b[64Gnded)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA small tool bakes a mod\u001b[30Gl's collision shap\u001b[49G into a file beside the model. It uses\u001b[88Gthe\u001b[92Gmodel's \u001b[101Gwn \u001b[38;2;177;185;249mcollision-\u001b[39m nodes,\r\u001b[4C\u001b[1Bor convex hulls simplified from\u001b[37Gthe drawn mesh.\u001b[53GPhysics\u001b[61Greads\u001b[67Gthat\u001b[72Gfile,\u001b[78Gso\u001b[81Gclient\u001b[88Gand\u001b[92Gserver\u001b[99Gcollide\u001b[107Gwith\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gbytes. The\u001b[16Gapproach was decid\u001b[35Gd on 2026-11-27.\u001b[K\r\u001b[7C\u001b[1Bmatters to Manifest bec\u001b[32Guse a hull drawn\u001b[49Gfrom a\u001b[56Gmodel currently collides as it\u001b[88Gbox.\u001b[93G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt works in physics, dock\u001b[31Gand\u001b[35Gtools;\u001b[42GJ26\u001b[46Gis\u001b[49Gin\u001b[52Gthe\u001b[56GUI,\u001b[60Gso\u001b[63Gthey\u001b[68Gdon't\u001b[74Gmeet.\u001b[80GIt\u001b[83Gdoes\u001b[88Gneed\u001b[93Ga\u001b[95Gnew\u001b[99Gfile\u001b[104Gformat,\u001b[112Gwhich\u001b[118GI'd\r\u001b[4C\u001b[1Brecord\u001b[12Gin\u001b[15G\u001b[38;2;177;185;249mdecisions.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmaller Jettison alternative: J29, the ground sample's rover.\u001b[22m The rov\u001b[73Gr slides like\u001b[87Ga\u001b[89Gbox,\u001b[94Gso\u001b[97Git\u001b[100Gwould\u001b[106Gbe\u001b[109Ggiven\u001b[115Ggrip.\r\u001b[2C\u001b[1BIt\u001b[6Gonly\u001b[11Gtouches\u001b[19Gthe\u001b[23Gsample,\u001b[31Gso\u001b[34Git's\u001b[39Gthe\u001b[43Gsafe\u001b[77GManifest.\u001b[27;1H\u001b[20;3H\u001b[?25h"]
[0.043, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe terminal UI resends a lost request.\u001b[22m It would keep each\u001b[64Grequest\u001b[72Git\u001b[75Gsent\u001b[80Guntil\u001b[86Git\u001b[89Ghears\u001b[95Gthat\u001b[100Grequest\u001b[108Gcomplete.\r\u001b[2C\u001b[1B \u001b[5GThis lives in the console tool, which L37 doesn't\u001b[55Gtouch.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe container runs automated.\u001b[35G\u001b[22mCI's \u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m step runs on\u001b[68Gy \u001b[38;2;177;185;249mhost\u001b[39m today. I'd add the Ubuntu 24.04 and Debian 13\r\u001b[4C\u001b[1Brun\u001b[9G to\u001b[13GGitHub Actio\u001b[26Gs, who\u001b[33Ge runners\u001b[43Ghave\u001b[48GDocker;\u001b[56GDocker\u001b[63Gis\u001b[66Galso\u001b[71Ghere\u001b[76Glocally\u001b[84Gto\u001b[87Gtry\u001b[91Gthem\u001b[96Gfirst.\u001b[103GWe'd\u001b[108Gonly\u001b[113Gsee\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5GCI side work \u001b[19Gn the next\u001b[30Gpush.\r\u001b[2C\u001b[1B-\u001b[5GThat\u001b[10Gwould\u001b[16Gclose\u001b[22GL41.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison lane C: J12, a glTF model's collision shape\u001b[22m (recomm\u001b[64Gnded)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA small tool bakes a mod\u001b[30Gl's collision shap\u001b[49G into a file beside the model. It uses\u001b[88Gthe\u001b[92Gmodel's \u001b[101Gwn \u001b[38;2;177;185;249mcollision-\u001b[39m nodes,\r\u001b[4C\u001b[1Bor convex hulls simplified from\u001b[37Gthe drawn mesh.\u001b[53GPhysics\u001b[61Greads\u001b[67Gthat\u001b[72Gfile,\u001b[78Gso\u001b[81Gclient\u001b[88Gand\u001b[92Gserver\u001b[99Gcollide\u001b[107Gwith\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gbytes. The\u001b[16Gapproach was decid\u001b[35Gd on 2026-11-27.\u001b[K\r\u001b[7C\u001b[1Bmatters to Manifest bec\u001b[32Guse a hull drawn\u001b[49Gfrom a\u001b[56Gmodel currently collides as it\u001b[88Gbox.\u001b[93G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt works in physics, dock\u001b[31Gand\u001b[35Gtools;\u001b[42GJ26\u001b[46Gis\u001b[49Gin\u001b[52Gthe\u001b[56GUI,\u001b[60Gso\u001b[63Gthey\u001b[68Gdon't\u001b[74Gmeet.\u001b[80GIt\u001b[83Gdoes\u001b[88Gneed\u001b[93Ga\u001b[95Gnew\u001b[99Gfile\u001b[104Gformat,\u001b[112Gwhich\u001b[118GI'd\r\u001b[4C\u001b[1Brecord\u001b[12Gin\u001b[15G\u001b[38;2;177;185;249mdecisions.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmaller Jettison alternative: J29, the groun\u001b[76G\u001b[22mlides like\u001b[87Ga\u001b[89Gbox,\u001b[94Gso\u001b[97Git\u001b[100Gwould\u001b[106Gbe\u001b[109Ggiven\u001b[115Ggrip.\u001b[27;1H\u001b[20;3H\u001b[?25h"]
