[0.033, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded\u001b[19Gagent\u001b[38;2;153;153;153m (↓ to manage · ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAll thre\u001b[12G agents are running in the background,\u001b[51Gbeside\u001b[58GL37:\u001b[63Gthe\u001b[67Gclient\u001b[74Greconnecting,\u001b[88Gshader\u001b[95Greloading,\u001b[106Gand\u001b[110Gmodel\u001b[116Gfiles\r\u001b[2C\u001b[1Bread\u001b[8Gonce.\u001b[14GI'll\u001b[19Greport\u001b[26Gas\u001b[29Geach\u001b[34Gone\u001b[38Gfinishes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m4\u001b[22m background agents to finish\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mAgent\u001b[9G\"Client\u001b[17Greconnecting\"\u001b[31Gfinished\u001b[38;2;153;153;153m · 13m 53s\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running git -C '/home/ivan/projects/manifest.lane-c' swit…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ g\u001b[10Gt\u001b[12G-C '/home/ivan/projects/manifest.lane-c' switch -q --detach feature-base && git -C \r\u001b[5C\u001b[1B'/home/ivan/projects/manifest\u001b[36Glane-c' branch -d client-reconnect client-reconnect-tidy\u001b[39m\u001b[27;1H\u001b[19;3H\u001b[?25h"]
