[0.009, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mThe server picker\u001b[21G\u001b[22m(Manifest)\r\u001b[2C\u001b[1B-\u001b[5GIt \u001b[9Gpen\u001b[14Gwhen no s\u001b[25Gver is g\u001b[34Gven on the command line.\u001b[59GSaved\u001b[65Gservers\u001b[73Glive\u001b[78Gin\u001b[81Gthe\u001b[85Gterminal\u001b[94GUI's\u001b[99Gexisting\u001b[108Glist,\u001b[114Gwith\r\u001b[4C\u001b[1Btokens writ\u001b[17Gen owner-only.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gmoved its passwor\u001b[25G field's\u001b[34Gstyl\u001b[39G into \u001b[38;2;177;185;249mmanifest.rcss\u001b[39m beside \u001b[68Ge t\u001b[72Gx\u001b[74G fi\u001b[78Gld\u001b[81G.\u001b[83G\u001b[K\r\u001b[4C\u001b[1BThe whole ctest passed (69\u001b[32Gof 69).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThree of its commit messages still say D-127, while the\u001b[61Gfiles\u001b[67Gsay\u001b[71GD-128.\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gbare \u001b[38;2;177;185;249mmanifest_client\u001b[39m now opens the picker; use \u001b[38;2;177;185;249m--scenario trading\u001b[73G\u001b[39mto\u001b[76Gplay\u001b[81Glocally\u001b[89Gstraight\u001b[98Gaway.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ20's clamps\u001b[22m (Jettison)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GClamps\u001b[12Gon\u001b[15Ga\u001b[17Gvehicle\u001b[25Gwith\u001b[30Ga\u001b[32Gcollision\u001b[42Gfile\u001b[47Gnow\u001b[51Ggrip\u001b[56Gits\u001b[60Gshape,\u001b[67Gworked\u001b[74Gout\u001b[78Gonce\u001b[83Gper\u001b[87Gdefinition.\r\u001b[2C\u001b[1B- A clamp with no\u001b[21Gside within\u001b[33Greach\u001b[39Gstays\u001b[45Gopen.\r\u001b[4C\u001b[1BBox v\u001b[11Ghicles are\u001b[22Gunchanged, and n\u001b[39G pins\u001b[45Gor frames moved.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI couldn't capture it: no engine\u001b[38Gscene\u001b[44Gdraws\u001b[50Gdocked\u001b[57Gclamps,\u001b[65Gand\u001b[69GManifest\u001b[78Ghas\u001b[82Gno\u001b[85Gclamp\u001b[91Gdressing\u001b[100Gyet\u001b[104Gto\u001b[107Guse\u001b[111Gthe\u001b[115Ggrips.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAlso fixed:\u001b[15G\u001b[22m14 links in Manifest's docs\u001b[43Gstill\u001b[49Gpointed\u001b[57Gat\u001b[60GJettison\u001b[69Groadmap\u001b[77Gentries\u001b[85Gthat\u001b[90Ghave\u001b[95Gmoved\u001b[101Gto\u001b[104Gits\u001b[108Ghistory.\u001b[117GThey\r\u001b[2C\u001b[1Bpoint at the history now.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOpen, needing your say:\r\u001b[2C\u001b[1B\u001b[22m1. Nothing checks a cruise\u001b[30Gpassing\u001b[38G\u001b[3manother\u001b[46G\u001b[23mpopulated\u001b[56Gbody\u001b[61Gwhile\u001b[67Gthe\u001b[71Gdrive\u001b[77Gis\u001b[80Gthrusting.\u001b[91GShould\u001b[98Gthat\u001b[103Gget\u001b[107Ga\u001b[109Gqueue\u001b[115Grow?\r\u001b[2C\u001b[1B2. A journey's fuel is s\u001b[28Gill\u001b[32Gpriced as\u001b[42Gif th\u001b[77G, so it overstates the\u001b[100Gburn.\u001b[106GA\u001b[108Grow\u001b[112Gfor\u001b[116Gthat\u001b[27;1H\u001b[24;3H\u001b[?25h"]
