[0.034, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  (another command ran in this repository at the same time; a change made by either may show under either \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mresult)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m10\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison's\u001b[14Gba\u001b[17Gch\u001b[20Ggate pa\u001b[28Gsed in 401 s, with\u001b[47Gevery stage green, including ti\u001b[79Gy,\u001b[82Gthe\u001b[86Grelease\u001b[94Gbuild,\u001b[101Gthe\u001b[105Greference\u001b[115Gframes\r\u001b[2C\u001b[1Band the sanitised\u001b[21Gruns.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe release\u001b[15Gbuild\u001b[21Gnow\u001b[25Gcarries\u001b[33Gline\u001b[38Gtables.\u001b[46G\u001b[38;2;177;185;249maddr2line\u001b[56G\u001b[39mon\u001b[59Gthe\u001b[63Grelease\u001b[71G\u001b[38;2;177;185;249mrender_test\u001b[83G\u001b[39mnames\u001b[89G\u001b[38;2;177;185;249mmain\u001b[94G\u001b[39mat\u001b[97G\u001b[38;2;177;185;249msource/test/main.cpp:7\u001b[39m,\r\u001b[1B  so release crash reports will give file and line.\u001b[K\r\u001b[2B \u001b[3GJett\u001b[8Gson's \u001b[38;2;177;185;249mfeature-base\u001b[39m is\u001b[30Gready\u001b[36Gto\u001b[39Gpush,\u001b[45Gwith\u001b[50Gthe\u001b[54Gline\u001b[59Gtables,\u001b[67GJ26\u001b[71Gand\u001b[75GJ12.\u001b[80GI'll\u001b[85Gpush\u001b[90Gwhen\u001b[95Gyou\u001b[99Gsay\u001b[103Gso.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BL37 is still running in Manifest lane B. Manifest's gate waits for it, because it covers L37, the\u001b[101Gpin\u001b[105Gmove,\u001b[111GL41\u001b[115Gand\r\u001b[2C\u001b[1Bthe line-tables change together.\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mPollinating…\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
