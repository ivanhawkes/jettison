[0.042, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/build-and-gates.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 172 \u001b[22m ### Ga\u001b[19Ging beside the work\u001b[K\r\u001b[1B     \u001b[2m 173 \u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22mOn Lyth\u001b[20Gr a commit can also\u001b[40Gbe\u001b[43Ggated\u001b[49Gin\u001b[52Ga\u001b[54Gsecond\u001b[61Gcheckout\u001b[70Gof\u001b[73Gits\u001b[77Gown\u001b[81Glane,\u001b[87Gso\u001b[90Gthe\u001b[94Gnext\u001b[99Gchange\u001b[106Gcan\u001b[110Gbe\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 175 -\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,\u001b[48;2;92;2;0m made o\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m     -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mnce with\u001b[48;2;61;1;0m                                                                                              \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m6\u001b[12G\u001b[38;2;248;248;242m`g\u001b[16G worktre\u001b[26Gadd\u001b[30G--d\u001b[34Gtach build/gate-\u001b[51Gree <commit>`. For \u001b[71Gach commit\u001b[82Gga\u001b[85Ged, run  \u001b[95G     \u001b[101G             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 175 +\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 176 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mmade once with \u001b[48;2;2;40;0m`git worktree add --detach build/gate-tree <commit>`. For each commit gated, run       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 177 \u001b[22m `git -C build/gate-tree checkout --detach <commit>`, then `build/gate-tree/scripts/ci.sh` with the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 178 \u001b[22m gate's options. While it runs nothing else builds, runs tests or runs clang-tidy (the user's rule,\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m2026-11-21), so \u001b[29Ghe work b\u001b[39Gside it is editing alone.\u001b[65GA failure is fixed by a later \u001b[96Gommit, before\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands, recalled \u001b[1m2\u001b[22m memories, wrote \u001b[1m2\u001b[22m memories \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate passes\u001b[19Gwith the lock in place. C\u001b[45Gmmitting \u001b[55Ghe lane changes\u001b[71Gin\u001b[74Gboth\u001b[79Grepositories\u001b[92Gand\u001b[96Gfast-forwarding\u001b[112Geach\r\u001b[1B  \u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153mthought for 4s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
