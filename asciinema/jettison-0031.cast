[0.194, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 65 -\u001b[38;2;248;248;242m    return fixed;                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 64 \u001b[13G\u001b[22mKey\u001b[17Gmixed{};\r\u001b[1B     \u001b[2m 65 \u001b[22m   \u001b[38;2;166;226;46mcrypto_generichash\u001b[39m(\u001b[K\r\u001b[1B     \u001b[2m 66 \u001b[22m       \u001b[38;2;166;226;46mBytes\u001b[39m(mixed), mixed.\u001b[38;2;166;226;46msize\u001b[39m(), \u001b[38;2;166;226;46mBytes\u001b[39m(fixed), fixed.\u001b[38;2;166;226;46msize\u001b[39m(), \u001b[38;2;166;226;46mBytes\u001b[39m(ephemeral), ephemeral.\u001b[38;2;166;226;46msize\u001b[39m());\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEach new test fails when its fix is broken.\u001b[47GNext: \u001b[54Ghe handshake\u001b[67Gdocs,\u001b[73Gthen\u001b[78Gtidy,\u001b[84Gformat,\u001b[92Gthe\u001b[96Gconsumer\u001b[105Gcheck\u001b[111Gand\u001b[115Ga\r\u001b[2C\u001b[1Bfresh\u001b[9Ggate\u001b[14Gbefore\u001b[21Ground\u001b[27G3.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI prefer for all the work to be based on the \u001b[38;2;177;185;249mfeature-base\u001b[38;2;255;255;255m branch rather than main. When work is merged successfully \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mand tested on \u001b[38;2;177;185;249mfeature-base\u001b[38;2;255;255;255m then it is a candiate for merging into main. Everything else is approved. Build it when \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255myou're ready.\u001b[39m                                                                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mGot it: lanes branch from \u001b[38;2;177;185;249mfeature-base\u001b[39m, work merges back into \u001b[38;2;177;185;249mfeature-base\u001b[39m, and only work tested there is a candidate\r\u001b[2C\u001b[1Bfor \u001b[38;2;177;185;249mmain\u001b[39m. I'll set up the lanes once J01 is committed.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m                                \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
