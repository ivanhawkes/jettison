[0.942, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m### Gating be\u001b[26Gide the work\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 173 \r\u001b[2C\u001b[1B\u001b[22m   \u001b[2m 174 \u001b[22m On Lythir a commit can also be gated in a second checkout\u001b[70Gof\u001b[73Gits\u001b[77Gown\u001b[81Glane,\u001b[87Gso\u001b[90Gthe\u001b[94Gnext\u001b[99Gchange\u001b[106Gcan\u001b[110Gbe\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 175 -\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,\u001b[48;2;92;2;0m made o\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m     -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mnce with\u001b[48;2;61;1;0m                                                                                              \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 176 -\u001b[38;2;248;248;242m`git worktree add --detach build/gate-tree <commit>`. For each commit gated, run                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 175 +\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,       \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 176 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mmade once with \u001b[48;2;2;40;0m`git worktree add --detach build/gate-tree <commit>`. For each commit gated, run       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 177 \u001b[12G\u001b[22m`git\u001b[17G-C\u001b[20Gbuild/gate-tree\u001b[36Gcheckout\u001b[45G--detach\u001b[54G<commit>`,\u001b[65Gthen\u001b[70G`build/gate-tree/scripts/ci.sh`\u001b[102Gwith\u001b[107Gthe\r\u001b[1B \u001b[3G   \u001b[2m 178 \u001b[12G\u001b[22mgate's opti\u001b[25Gs.\u001b[28GWhile it ru\u001b[40Gs nothing\u001b[50Gelse\u001b[55Gbuilds,\u001b[63Gruns\u001b[68Gtests\u001b[74Gor\u001b[77Gruns\u001b[82Gclang-tidy\u001b[93G(the\u001b[98Guser's\u001b[105Grule,\r\u001b[1B     \u001b[2m 179 \u001b[22m 2026-11-21), so the\u001b[32Gwork\u001b[37Gbeside\u001b[44Git\u001b[47Gis\u001b[50Gediting\u001b[58Galone.\u001b[65GA\u001b[67Gfailure\u001b[75Gis\u001b[78Gfixed\u001b[84Gby\u001b[87Ga\u001b[89Glater\u001b[95Gcommit,\u001b[103Gbefore\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands, recalled \u001b[1m2\u001b[22m memories, wrote \u001b[1m2\u001b[22m memories \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The gate passes with the lock in place. Committing\u001b[54Gthe\u001b[58Glane\u001b[63Gchanges\u001b[71Gin\u001b[74Gboth\u001b[79Grepositories\u001b[92Gand\u001b[96Gfast-forwarding\u001b[112Geach\r\u001b[1B  \u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+19\u001b[38;2;153;153;153m, committed \u001b[1m4b2707d\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(git\u001b[12Gmerge\u001b[18G--ff-only\u001b[28Gworktree-lanes)\u001b[27;1H\u001b[24;3H\u001b[?25h"]
