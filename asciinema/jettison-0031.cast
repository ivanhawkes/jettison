[0.318, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 71 -\u001b[38;2;248;248;242m  git rev-parse --verify \"${base:-\u001b[48;2;92;2;0mmain\u001b[48;2;61;1;0m}^{commit}\" >\"$dir/base\"                                         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 72 +\u001b[38;2;248;248;242m  git rev-parse --verify \u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m${base:-\u001b[48;2;4;71;0mfeature-base\u001b[48;2;2;40;0m}\u001b[38;2;230;219;116m^{commit}\"\u001b[38;2;248;248;242m >\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$dir\u001b[38;2;230;219;116m/base\"\u001b[38;2;248;248;242m                                 \r\u001b[1B\u001b[39m\u001b[49m     \u001b[2m 73 \u001b[22m \u001b[38;2;249;38;114melse\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m74\u001b[11G\u001b[22m \u001b[13G[\u001b[15G-n\u001b[18G\u001b[38;2;230;219;116m\"\u001b[39m$reply\u001b[38;2;230;219;116m\"\u001b[27G\u001b[39m]\u001b[29G||\u001b[32G{\u001b[34G\u001b[38;2;166;226;46mecho\u001b[39G\u001b[38;2;230;219;116m\"cross-review: round \u001b[39m$round\u001b[38;2;230;219;116m needs --reply FILE to round \u001b[39m$last\u001b[38;2;230;219;116m\"\u001b[102G\u001b[39m>&2;\u001b[107G\u001b[38;2;166;226;46mexit\u001b[112G\u001b[39m2;\r\u001b[7C\u001b[1B\u001b[2m \u001b[11G\u001b[22m }\u001b[K\r\u001b[6C\u001b[1B\u001b[2m75\u001b[11G\u001b[22m \u001b[13G\u001b[38;2;249;38;114mif\u001b[16G\u001b[39m[\u001b[18G\u001b[38;2;230;219;116m\"\u001b[39m$round\u001b[38;2;230;219;116m\"\u001b[27G\u001b[39m-gt\u001b[31G\u001b[38;2;230;219;116m\"\u001b[39m$max_rounds\u001b[38;2;230;219;116m\"\u001b[45G\u001b[39m];\u001b[48G\u001b[38;2;249;38;114mthen\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m5\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe lock works: the second command waited about 2.6 s for the first, and a nested call doesn't deadlock. Now the\u001b[116Gdocs.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(scripts/heavy.sh)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m#\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  8 \u001b[22m \u001b[38;2;117;113;94m# Usage: scripts/heavy.sh <command> [arguments...]\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  9 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m#\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 10 -\u001b[38;2;248;248;242m# The command inherits the lock's descriptor, so a process it leaves running \u001b[48;2;92;2;0mholds\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mlock\u001b[48;2;61;1;0m \u001b[48;2;92;2;0muntil\u001b[48;2;61;1;0m      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 11 -\u001b[38;2;248;248;242m# that process ends: `fuser -v <lock>` names the holder.                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 10 +\u001b[38;2;117;113;94m# The command inherits the lock's descriptor, so a process it leaves running \u001b[48;2;4;71;0m(an\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mXvfb\u001b[48;2;2;40;0m \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mkilled run\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 11 +\u001b[38;2;117;113;94m# left) holds the lock until that pr\u001b[76G\u001b[38;2;248;248;242m                                      \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
