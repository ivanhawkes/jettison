[0.077, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[14G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(pImpostor != \u001b[38;2;190;132;255mnullptr\u001b[38;2;248;248;242m);                                                                      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m ServerKey pinned = \u001b[38;2;166;226;46mGenerateServerKey\u001b[38;2;248;248;242m();                                                       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::optional<Seal::Key> pinnedKey = Seal::\u001b[38;2;166;226;46mParseKey\u001b[38;2;248;248;242m(pinned.publicKey);                        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(pinnedKey);      \u001b[40G         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m Seal::KeyPair own;      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mClientConfig config;                  \u001b[53G     \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mconfig.\u001b[22Gort = pImpo\u001b[35Gor->address.port;   \u001b[56G       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mconfig.protocol = {\u001b[38;2;230;219;116m\"test\"\u001b[38;2;248;248;242m, \u001b[38;2;190;132;255m3\u001b[38;2;248;248;242m};                        \u001b[69G \u001b[71G   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mconfig.serverKey = pinned.publicKey;                                                                \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242mconfig.credential\u001b[32G=\u001b[34G\u001b[38;2;166;226;46mBytes\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"good\"\u001b[38;2;248;248;