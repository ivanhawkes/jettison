[0.021, "o", "\u001b[?25l\u001b[H\u001b[3G1.\u001b[6G\u001b[1mKeep the server's secret key safe.\u001b[41G\u001b[22mIt's\u001b[46Gone\u001b[50Gfile,\u001b[56Greadable\u001b[65Gonly\u001b[70Gby\u001b[73Gthe\u001b[77Gserver's\u001b[86Guser\u001b[91G(mode 0600),\u001b[104Gand\u001b[108Gbacked\u001b[115Gup.\u001b[119GIf\r\u001b[2C\u001b[1B   you lose it, every client has to be given the\u001b[52Gnew\u001b[56Gkey.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mD\u001b[8Gcide how players get \u001b[30Ghe public key.\u001b[22m Either ship it in the client's config or\u001b[86Gbuild, \u001b[94Gr publish\u001b[104Git somewhere they\r\u001b[5C\u001b[1Btr\u001b[9Gst. If \u001b[17Ghat somewhere is your\u001b[39Gw\u001b[41Gbs\u001b[44Gt\u001b[46G,\u001b[52Gsite needs\u001b[63GHTTPS.\u001b[70GA\u001b[72Gfree\u001b[77GLet's\u001b[83GEncrypt\u001b[91Gcertificate\u001b[103Gcovers\u001b[110Gthat,\u001b[116Gand\r\u001b[2C\u001b[1B  \u001b[6Git's separate from J01.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BPinned keys com\u001b[20Gwith\u001b[25Gone trade-off:\u001b[40Gchanging\u001b[49Gthe\u001b[53Gserver's\u001b[62Gkey\u001b[66Gmeans\u001b[72Gupdating\u001b[81Gevery\u001b[87Gclient.\u001b[95GAvoiding\u001b[104Gthat\u001b[109Gwould\u001b[115Gneed\u001b[120Ga\r\u001b[2C\u001b[1Bsigning\u001b[11Gkey\u001b[15Gthat\u001b[20Gvouches\u001b[28Gfor\u001b[32Grotating\u001b[41Gserver\u001b[48Gkeys.\u001b[54GThat\u001b[59Gisn't\u001b[65Gin\u001b[68Gthe\u001b[72Gplan\u001b[77Gand\u001b[81Gisn't\u001b[87Gneeded\u001b[94Gnow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI checked Manifest's D-081 (libsod\u001b[38Gum, no TLS over\u001b[54GUDP). The exac\u001b[69G handshake,\u001b[81Gand whether the pinned\u001b[104Gkey\u001b[108Gships\u001b[114Gin\u001b[117Gthe\r\u001b[2C\u001b[1Bbuild\u001b[9Gor\u001b[12Gin\u001b[15Gconfig,\u001b[23Garen't\u001b[30Gdesigned\u001b[39Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 21s · done 8:26 am\u001b[39m\u001b[K\r\u0