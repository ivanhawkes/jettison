[0.040, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bone). Two settings also work against reuse:\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m~/.config/worktrunk/config.toml\u001b[39m puts new worktrees\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249m~/worktrees/jettison/<branch>\u001b[39m.\u001b[90Gccache\u001b[97Gonly\u001b[102Gshares\u001b[109Gcompiled\r\u001b[2C\u001b[1B \u001b[5Gobjects between trees under \u001b[38;2;177;185;249m~/projects\u001b[39m (\u001b[38;2;177;185;249mCCACHE_BASEDIR\u001b[39m), so a worktree made there would s\u001b[95Gare nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWorktrunk mak\u001b[19Gs\u001b[21Ga n\u001b[25Gw\u001b[27Gworktree for each branch and remove\u001b[63G it\u001b[67Gon me\u001b[73Gg\u001b[75G. Ev\u001b[80Gry b\u001b[85Ganch would start w\u001b[104Gth empty\u001b[113Gbuild\r\u001b[2C\u001b[1B \u001b[5Gtrees: about five\u001b[23Gcold builds per gate,\u001b[45Gand Debug builds never share objects between\u001b[90Gtrees\u001b[96Ganyway.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposal: three permanent lanes, reused from task to task.\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mLanes\u001b[12G\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this checkout) plus \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B  \u001b[6Gonce with \u001b[38;2;177;185;249mgit worktree add\u001b[33G\u001b[39mand never removed. A\u001b[54Gnew task does \u001b[38;2;177;185;249mg\u001b[70Gt switch -c <task> main\u001b[39m inside a free lane, so that\r\u001b[5C\u001b[1Blan\u001b[10G's \u001b[38;2;177;185;249mbuild/\u001b[39m trees, Debug\u001b[33Go\u001b[35Ges includ\u001b[45Gd, stay warm. Each lane costs about 14 GB of disk, an\u001b[99G 281 GB is free. They\u001b[K\r\u001b[5C\u001b[1Bsit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[64G\u001b[39mworks a\u001b[72G intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory note says \u001b[52Gothing runs\u001b[64Gbeside cla\u001b[75Gg. RAM is\u001b[85Gthe\u001b[89Greason:\u001b[97Gwith\u001b[102Gyour\u001b[107Glocal\u001b[113GAI\r\u001b[2C\u001b[1B  \u001b[6Gloaded (\u001b[38;2;177;185;249mstrata-host\u001b[39m), two full-width builds would thrash.\u001b[64GSo \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and\u001b[85Ga small \u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[5C\u001b[1B\u001b[39mwr\u001b[9Gpper share one machine-wide lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lo\u001b[76Gk\u001b[39m). A second gate or build queues behind\u001b[117Gthe\r\u001b[5C\u001b[1Bfirst in\u001b[15Gtead\u001b[21Gf competing with it.\u001b[42GReviews, editing, reading and docs need\u001b[82Gno lock. That's where the overlap pays\r\u001b[5C\u001b[1Boff: the 10-minute review rounds and the gate's wait no longer leave me idle.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA lane state file:\u001b[25G\u001b[22m\u001b[38;2;177;185;249mbuild/lane.md\u001b[39G\u001b[39mi\u001b[41G each\u001b[47Gl\u001b[49Gn\u001b[51G, ignored by git,\u001b[69Gsays what th\u001b[82G lane\u001b[88Gholds\u001b[94Gand\u001b[98Gwhat\u001b[103Git's\u001b[108Gwaiting\u001b[116Gon,\r\u001b[2C\u001b[1B  \u001b[6Gso I always know which lane is free.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mManifest\u001b[22m gets the same\u001b[29Gthr\u001b[33Ge lanes, \u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[69G\u001b[39mand\u001b[73G\u001b[38;2;177;185;249m-c\u001b[39m,\u001b[77Geach\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gthe\u001b[103Gengine\u001b[110Glane\u001b[115Gof\u001b[118Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame name.   \u001b[20G   \u001b[24G    \u001b[29G     \u001b[35G      \u001b[42G     \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.349, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m~/.config/worktrunk/config.toml\u001b[39m puts new worktrees\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249m~/worktrees/jettison/<branch>\u001b[39m.\u001b[90Gccache\u001b[97Gonly\u001b[102Gshares\u001b[109Gcompiled\r\u001b[2C\u001b[1B \u001b[5Gobjects between trees under \u001b[38;2;177;185;249m~/projects\u001b[39m (\u001b[38;2;177;185;249mCCACHE_BASEDIR\u001b[39m), so a worktree made there would s\u001b[95Gare nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWorktrunk mak\u001b[19Gs\u001b[21Ga n\u001b[25Gw\u001b[27Gworktree for each branch and remove\u001b[63G it\u001b[67Gon me\u001b[73Gg\u001b[75G. Ev\u001b[80Gry b\u001b[85Ganch would start w\u001b[104Gth empty\u001b[113Gbuild\r\u001b[2C\u001b[1B \u001b[5Gtrees: about five\u001b[23Gcold builds per gate,\u001b[45Gand Debug builds never share objects between\u001b[90Gtrees\u001b[96Ganyway.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposal: three permanent lanes, reused from task to task.\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mLanes\u001b[12G\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this checkout) plus \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B  \u001b[6Gonce with \u001b[38;2;177;185;249mgit worktree add\u001b[33G\u001b[39mand never removed. A\u001b[54Gnew task does \u001b[38;2;177;185;249mg\u001b[70Gt switch -c <task> main\u001b[39m inside a free lane, so that\r\u001b[5C\u001b[1Blan\u001b[10G's \u001b[38;2;177;185;249mbuild/\u001b[39m trees, Debug\u001b[33Go\u001b[35Ges includ\u001b[45Gd, stay warm. Each lane costs about 14 GB of disk, an\u001b[99G 281 GB is free. They\u001b[K\r\u001b[5C\u001b[1Bsit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[64G\u001b[39mworks a\u001b[72G intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory note says \u001b[52Gothing runs\u001b[64Gbeside cla\u001b[75Gg. RAM is\u001b[85Gthe\u001b[89Greason:\u001b[97Gwith\u001b[102Gyour\u001b[107Glocal\u001b[113GAI\r\u001b[2C\u001b[1B  \u001b[6Gloaded (\u001b[38;2;177;185;249mstrata-host\u001b[39m), two full-width builds would thrash.\u001b[64GSo \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and\u001b[85Ga small \u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[5C\u001b[1B\u001b[39mwr\u001b[9Gpper share one machine-wide lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lo\u001b[76Gk\u001b[39m). A second gate or build queues behind\u001b[117Gthe\r\u001b[5C\u001b[1Bfirst in\u001b[15Gtead\u001b[21Gf competing with it.\u001b[42GReviews, editing, reading and docs need\u001b[82Gno lock. That's where the overlap pays\r\u001b[5C\u001b[1Boff: the 10-minute review rounds and the gate's wait no longer leave me idle.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA lane state file:\u001b[25G\u001b[22m\u001b[38;2;177;185;249mbuild/lane.md\u001b[39G\u001b[39mi\u001b[41G each\u001b[47Gl\u001b[49Gn\u001b[51G, ignored by git,\u001b[69Gsays what th\u001b[82G lane\u001b[88Gholds\u001b[94Gand\u001b[98Gwhat\u001b[103Git's\u001b[108Gwaiting\u001b[116Gon,\r\u001b[2C\u001b[1B  \u001b[6Gso I always know which lane is free.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mManifest\u001b[22m gets the same\u001b[29Gthr\u001b[33Ge lanes, \u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[69G\u001b[39mand\u001b[73G\u001b[38;2;177;185;249m-c\u001b[39m,\u001b[77Geach\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gthe\u001b[103Gengine\u001b[110Glane\u001b[115Gof\u001b[118Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame name.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mDocs:\u001b[22m \u001b[13G \"Lanes\"\u001b[22Gsection\u001b[30Gin\u001b[33G\u001b[38;2;177;185;249mbuild-and-gate\u001b[75G\u001b[39m,\u001b[77Gand\u001b[81Gthe\u001b[85Gworktrunk\u001b[95G\u001b[38;2;177;185;249mworktree-path\u001b[109G\u001b[39mchanged\u001b[117Gto\u001b[27;1H\u001b[24;3H\u001b[?25h"]
