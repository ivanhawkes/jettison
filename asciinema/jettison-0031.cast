[0.466, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 175 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mwritten while the gate \u001b[48;2;2;40;0mruns. `build/gate-tree` is a detached worktree with its own build trees, made o\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242mnce with                                                                                              \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m6\u001b[12G\u001b[22m`git worktree add --det\u001b[36Gch build/gate-tree <\u001b[58Gmmit>`. For\u001b[70Geach commit gated, run\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 177 \u001b[22m `git -C build/gate-tree checkout --detach <commit>`, then `build/gate-tree/scripts/ci.sh` with the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 178 \u001b[22m gate's options. While it runs nothing else builds, runs tests or runs clang-tidy (the user's rule,\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifes\u001b[29G/docs/build-and-gat\u001b[49Gs.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m \u001b[32Gines\u001b[37G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m### Gating be\u001b[26Gide the work\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 173 \r\u001b[2C\u001b[1B\u001b[22m   \u001b[2m 174 \u001b[22m On Lythir a commit can also be gated in a second checkout\u001b[70Gof\u001b[73Gits\u001b[77Gown\u001b[81Glane,\u001b[87Gso\u001b[90Gthe\u001b[94Gnext\u001b[99Gchange\u001b[106Gcan\u001b[110Gbe\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 175 -\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,\u001b[48;2;92;2;0m made o\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m     -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mnce with\u001b[48;2;61;1;0m                                                                                              \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 176 -\u001b[38;2;248;248;242m`git worktree add --detach build/gate-tree <commit>`. For each commit gated, run                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 175 +\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,       \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 176 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mmade once with \u001b[48;2;2;40;0m`git worktree add --detach build/gate-tree <commit>`. For each commit gated, run       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 177 \u001b[12G\u001b[22m`git\u001b[17G-C\u001b[20Gbuild/gate-tree\u001b[36Gcheckout\u001b[45G--detach\u001b[54G<commit>`,\u001b[65Gthen\u001b[70G`build/gate-tree/scripts/ci.sh`\u001b[102Gwith\u001b[107Gthe\r\u001b[1B \u001b[3G   \u001b[2m 178 \u001b[12G\u001b[22mgate's opti\u001b[25Gs.\u001b[28GWhile it ru\u001b[40Gs nothi\u001b[77Gruns\u001b[82Gclang-tidy\u001b[93G(the\u001b[98Guser's\u001b[105Grule,\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.452, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m67\u001b[12G\u001b[38;2;248;248;242m`-DJETTISON_SOURCE_DIR=~/projects/jettison.lane-<lett\u001b[66Gr>`. `scrip\u001b[78Gs/heavy.sh <c\u001b[92Gmmand>` holds the   \u001b[113G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m168\u001b[12G\u001b[38;2;248;248;242mlock every\u001b[23Glane\u001b[28Gof\u001b[31Gboth\u001b[36Grepositories\u001b[49Gshares,\u001b[57Gand\u001b[61G`ci.sh`\u001b[69Gtakes\u001b[75Git\u001b[78Gitself,\u001b[86Gso\u001b[89Gbuilds,\u001b[97Gsuites\u001b[104Gand\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 169 +\u001b[38;2;248;248;242mgates take turns. How the lanes are kept is in Jettison's                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 170 +\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mlanes\u001b[38;2;248;248;242m](../../jettison/docs/build-and-gates.md#lanes).                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 171 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 172 \u001b[12G\u001b[22m###\u001b[16GGating\u001b[23Gbeside\u001b[30Gthe\u001b[34Gwork\r\u001b[2C\u001b[1B   \u001b[2m 173 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 163 -\u001b[38;2;248;248;242mOn Lythir a commit \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m gated in a second checkout, so the next change can be\u001b[48;2;92;2;0m written while the gate\u001b[48;2;61;1;0m    \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 164 -\u001b[38;2;248;248;242mruns. `build/gate-tree` is a detached worktree with its own build trees, made once with               \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 174 +\u001b[38;2;248;248;242mOn Lythir a commit \u001b[48;2;4;71;0mcan\u001b[48;2;2;40;0m \u001b[48;2;4;71;0malso be \u001b[48;2;2;40;0mgated in a second checkout\u001b[48;2;4;71;0m of its own lane\u001b[48;2;2;40;0m, so the next change can be  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 175 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mwritten while the gate \u001b[48;2;2;40;0mruns. `build/gate-tree` is a detached worktree with its own build trees, made o\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242mnce with                                                                                              \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m6\u001b[12G\u001b[22m`git worktree add --det\u001b[36Gch build/gate-tree <\u001b[58Gmmit>`. For\u001b[70Geach commit gated, run\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 177 \u001b[22m `git -C build/gate-tree checkout --detach <commit>`, then `build/gate-tree/scripts/ci.sh` with the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 178 \u001b[22m gate's options. While it runs nothing else builds, runs tests or runs clang-tidy (the user's rule,\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifes\u001b[29G/docs/build-and-gat\u001b[49Gs.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m \u001b[32Gines\u001b[37G    \u001b[42G     \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
