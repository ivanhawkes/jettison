[0.124, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mLanes\u001b[9G\u001b[22m(committed\u001b[20Gin\u001b[23Gboth\u001b[28Grepositories,\u001b[42G\u001b[38;2;177;185;249m4b2707d\u001b[50G\u001b[39mand\u001b[54GManifest's\u001b[65G\u001b[38;2;177;185;249m723e8d5\u001b[39m):\r\u001b[2C\u001b[1B- \u001b[1mWorktrees:\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[39m and \u001b[38;2;177;185;249m.lane-c\u001b[39m, plus \u001b[38;2;177;185;249mmanifest.lane-b\u001b[77G\u001b[39mand\u001b[81G\u001b[38;2;177;185;249m.lane-c\u001b[39m,\u001b[90Gkept\u001b[95Gbetween\u001b[103Gtasks.\u001b[110GA\u001b[112Gtask\r\u001b[2C\u001b[1B \u001b[5Gstarts with \u001b[38;2;177;185;249mgit swi\u001b[25Gch -c <task> f\u001b[40Gature-base\u001b[39m and merges back into \u001b[38;2;177;185;249mf\u001b[74Gature-base\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mShared lock:\u001b[22m \u001b[38;2;177;185;249mscripts/\u001b[27Geavy.sh\u001b[39m holds one lock for both repositories, and \u001b[38;2;177;185;249mci.sh\u001b[39m takes\u001b[89Git\u001b[92Gitself,\u001b[100Gso\u001b[103Gbuilds\u001b[110Gand\u001b[114Ggates\r\u001b[2C\u001b[1B \u001b[5Gtake turns. A second command did wait behind\u001b[50Gthe\u001b[54Gfirst, and a nested one didn'\u001b[84G d\u001b[87Gadlock. The reviewer is told \u001b[117Go\u001b[K\r\u001b[4C\u001b[1Bbuild through\u001b[19Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReview base:\u001b[22m \u001b[38;2;177;185;249mcross-review.sh\u001b[34G\u001b[39mnow\u001b[38Gcompares\u001b[47Gagainst\u001b[55G\u001b[38;2;177;185;249mfeature-base\u001b[68G\u001b[39mby\u001b[71Gdefault.\r\u001b[4C\u001b[1B\u001b[1mWorktrunk path:\u001b[22m I changed it\u001b[34Gin your dotfiles (\u001b[38;2;177;185;249m~/.dotfil\u001b[62Gs/.config/worktrunk/config.toml\u001b[39m)\u001b[95Gto\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/projects/<repo>.<branch>\u001b[39m, so any work\u001b[45Gree it makes shares ccache.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWarm builds:\u001b[22m engine lanes B\u001b[33Gand C each ran a full cold gate\u001b[65Gand both\u001b[74Gpassed,\u001b[82Gin\u001b[85Gabout\u001b[91G18\u001b[94Gminutes\u001b[102Geach,\u001b[108Gso\u001b[111Gtheir\r\u001b[2C\u001b[1B \u001b[5Gbuild trees are warm. Manifest's lanes\u001b[44Gare\u001b[48Gparked\u001b[55Gon \u001b[38;2;177;185;249mfeature-base\u001b[39m but not built, s\u001b[88G \u001b[90Gheir first build will b\u001b[114G cold.\r\u001b[4C\u001b[1BManifest's l\u001b[18Gn\u001b[21Gchange was only syntax-ch\u001b[47Gcked, not run through its gate.\u001b[79G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLane state:\u001b[22m each l\u001b[25Ge has a \u001b[38;2;177;185;249mbuild/lane.md\u001b[39m saying what it \u001b[63Golds.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne risk:\u001b[13G\u001b[22ma\u001b[15Gprocess\u001b[23Gleft\u001b[28Grunning\u001b[36Gby\u001b[39Ga\u001b[41Gkilled\u001b[48Ggate,\u001b[54Gsuch\u001b[59Gas\u001b[62Ga\u001b[64Gstray\u001b[70GXvfb,\u001b[76Gkeeps\u001b[82Gthe\u001b[86Glock\u001b[91Guntil\u001b[97Git\u001b[100Gexits.\u001b[107G\u001b[38;2;177;185;249mheavy.sh\u001b[39m\u001b[27;1H\u001b[24;71H\u001b[?25h"]
[0.152, "o", "\u001b[?25l\u001b[H\u001b[3G  starts with \u001b[38;2;177;185;249mgit switch -c <task> feature-base\u001b[39m and merg\u001b[61G back into \u001b[38;2;177;185;249mfeature-base\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mShared lock:\u001b[22m \u001b[38;2;177;185;249mscripts/heavy.\u001b[33Gh\u001b[39m holds one lock for both repositories, and\u001b[77G\u001b[38;2;177;185;249mci.sh\u001b[39m takes it i\u001b[94Gself, so\u001b[103Gbuilds\u001b[110Gand gates\r\u001b[4C\u001b[1Btake turns.\u001b[17GA second command did wait behind the first, and a\u001b[67Gnested one didn't deadlock.\u001b[95GThe\u001b[99Greviewer\u001b[108Gis\u001b[111Gtold\u001b[116Gto\r\u001b[2C\u001b[1B \u001b[5Gbuild through it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReview base:\u001b[22m \u001b[38;2;177;185;249mcross-review.sh\u001b[34G\u001b[39mnow\u001b[38Gcompar\u001b[45Gs against \u001b[38;2;177;185;249mfeature-base\u001b[39m by default.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWorktrunk path:\u001b[22m I\u001b[23Gchanged\u001b[31Git\u001b[34Gin\u001b[37Gyour\u001b[42Gdotfiles\u001b[51G(\u001b[38;2;177;185;249m~/.dotfiles/.config/worktrunk/config.toml\u001b[39m)\u001b[95Gto\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/projects/<rep\u001b[21G>.<branch>\u001b[39m, so any worktree it makes shares ccache.\u001b[K\r\u001b[5C\u001b[1B\u001b[1ma\u001b[8Gm b\u001b[12Gilds:\u001b[22m engine lan\u001b[29Gs\u001b[31GB and\u001b[37GC each ran a full cold gate and both passed, in about 18 minutes\u001b[102Geach,\u001b[108Gso\u001b[111Gtheir\r\u001b[4C\u001b[1Bbuild trees are warm. Manife\u001b[34Gt's lanes a\u001b[47G parked on\u001b[58G\u001b[38;2;177;185;249mfeature-base\u001b[39m but\u001b[75Gnot\u001b[79Gbuilt,\u001b[86Gso\u001b[89Gtheir\u001b[95Gfirst\u001b[101Gbuild\u001b[107Gwill\u001b[112Gbe\u001b[115Gcold.\r\u001b[2C\u001b[1B \u001b[5GManifest's lane change was only\u001b[37Gsyntax-checked, not run through\u001b[69Gits gate.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLane state:\u001b[17G\u001b[22meach lane\u001b[27Gh\u001b[29Gs a \u001b[38;2;177;185;249mbuild/lane.md\u001b[39m saying what it holds.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne risk:\u001b[22m a process left running by a killed gate,\u001b[54Gsuch\u001b[59Gas\u001b[62Ga stray\u001b[70GXvfb,\u001b[76Gkeeps\u001b[82Gthe\u001b[86Glock\u001b[91Guntil\u001b[97Git\u001b[100Gexits.\u001b[107G\u001b[38;2;177;185;249mheavy.sh\r\u001b[2C\u001b[1B\u001b[39mprints\u001b[10Gthat\u001b[15Git's\u001b[20Gwaiting,\u001b[29Gso\u001b[32Ga\u001b[34Gstuck\u001b[40Gqueue\u001b[46Gshows\u001b[52Gup.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;71H\u001b[?25h"]
