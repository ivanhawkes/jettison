r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mStarting round\u001b[18G1 of the Codex revi\u001b[38Gw (up to 4\u001b[49Grounds).\u001b[58GI wo\u001b[63G't edit anythi\u001b[80Gwhile it r\u001b[91Gns.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gpgrep\u001b[17G-f\u001b[20G\"codex\u001b[27Gexec\"\u001b[33G||\u001b[36Gtrue\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ pgrep -f \"codex exec\" || true\u001b[39m\u001b[K\r\u001b[5C\u001b[1B    \u001b[27;1H\u001b[24;3H\u001b[?25h"]
