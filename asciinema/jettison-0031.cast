[0.300, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe\u001b[14G\u001b[38;2;177;185;249mnet\u001b[18G\u001b[39msuite\u001b[24G(11\u001b[28Gcases)\u001b[35Gand\u001b[39Gthe\u001b[43Gconsumer\u001b[52Gcheck\u001b[58Gpass.\u001b[64GThe\u001b[68Gnew\u001b[72Gcases\u001b[78Gcover\u001b[84Ga\u001b[86Gclient\u001b[93Gwith\u001b[98Gthe\u001b[102Gwrong\u001b[108Gkey,\u001b[113Gand\r\u001b[2C\u001b[1Breplayed, altered, misrouted and late pa\u001b[44Gkets.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDocs:\u001b[9G\u001b[22mnetworking,\u001b[21Gdecisions\u001b[31Gand\u001b[35Gscope\u001b[41Gare\u001b[45Gupdated,\u001b[54Gand\u001b[58GJ01\u001b[62Gis\u001b[65Grecorded\u001b[74Gin\u001b[77Ghistory\u001b[85Gand\u001b[89Gremoved\u001b[97Gfrom\u001b[102Gthe\u001b[106Groadmap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimits:\r\u001b[2C\u001b[1B\u001b[22m- ENet's\u001b[12Gown\u001b[16Gpacket\u001b[23Gheaders\u001b[31Garen't\u001b[38Gencrypted.\u001b[49GSomeone\u001b[57Gon\u001b[60Gthe\u001b[64Gnetwork\u001b[72Gpath\u001b[77Gcan\u001b[81Gcut\u001b[85Ga\u001b[87Gconnection\u001b[98Gor\u001b[101Gfake\u001b[106Gthe\u001b[110Greason\u001b[117Git\r\u001b[2C\u001b[1B \u001b[5Gclosed, but can'\u001b[23Gr\u001b[27G or\u001b[31Gforge a messag\u001b[46G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GChanging the serve\u001b[24G's key\u001b[31Gmeans\u001b[37Gupdatin\u001b[45G every\u001b[52Gclient's\u001b[61Gconfig.\r\u001b[4C\u001b[1BT\u001b[7Ge check a client makes agai\u001b[36Gt a fake s\u001b[47Grver\u001b[52Gthat an\u001b[60Gwers but\u001b[69Gdoesn't\u001b[77Ghold\u001b[82Gthe\u001b[86Gkey\u001b[90Ghas\u001b[94Gno\u001b[97Gtest;\u001b[103Gthat\u001b[108Gwould\u001b[114Gneed\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5Ghand-written fake serv\u001b[28Gr.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GM\u001b[8Gifest's docs still link\u001b[32Gto\u001b[35Gthe\u001b[39Groadmap's\u001b[49GJ01\u001b[53Gsection,\u001b[62Gwhich\u001b[68Gis\u001b[71Gnow\u001b[75Ggone.\u001b[81GI'll\u001b[86Gfix\u001b[90Gthose\u001b[96Glinks\u001b[102Gwhen\u001b[107GManifest\r\u001b[2C\u001b[1B \u001b[5Gadopts it.\u001b[16G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest's side, not started.\u001b[33G\u001b[22mWith\u001b[38Gthe\u001b[42Gengine\u001b[49Gchange\u001b[56Galone,\u001b[63GManifest's\u001b[74Gserver\u001b[81Gwould\u001b[87Grefuse\u001b[94Gto\u001b[97Gstart\u001b[103Gbecause\u001b[111Git\u001b[114Ghas\u001b[118Gno\r\u001b[2C\u001b[1Bkey. My proposal:\u001b[K\r\u001b[2C\u001b[1B- A \u001b[38;2;177;185;249mmanifest-token key\u001b[26G\u001b[39mcommand\u001b[34Gwrites\u001b[41Gthe\u001b[45Gserver's\u001b[54Gsecret\u001b[61Gkey\u001b[65Gto\u001b[68Ga\u001b[70Gprivate\u001b[78Gfile\u001b[83Gnext\u001b[88Gto\u001b[91Gthe\u001b[95Gtokens\u001b[102Gfile\u001b[107Gand\u001b[111Gprints\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gpublic key.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m--serve\u001b[39m reads\u001b[19Gthat\u001b[24Gfile,\u001b[30Gwith\u001b[35Ga\u001b[37G\u001b[38;2;177;185;249m--key <file>\u001b[50G\u001b[39moption\u001b[57Gto\u001b[60Gpoint\u001b[66Gelsewhere.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
