[0.879, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[23B\u001b[2mgo ahead and start J01\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[4.274, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\u001b[1mNone.\u001b[22m J01 uses no certificates and no TLS, so not\u001b[53Ging has to be i\u001b[69Gsued or bought for your domain.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTLS\u001b[7Gdoesn't\u001b[15Grun\u001b[19Gover\u001b[24GUDP,\u001b[29Gso\u001b[32GJ01\u001b[36Guses\u001b[41Glibsodium\u001b[51Gdirectly,\u001b[61Gmuch\u001b[66Glike\u001b[71GSSH\u001b[75Gor\u001b[78GWireGuard:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mServer k\u001b[14Gy:\u001b[22m the server generates its own\u001b[46Gkey\u001b[50Gpair\u001b[56Ga Curve25519 ke\u001b[73Gin a fil\u001b[82G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPinning:\u001b[22m the cli\u001b[22Gnt\u001b[25Gknows t\u001b[33Ge server's public key in advance\u001b[66Gand\u001b[70Gchecks\u001b[77Git\u001b[80Gduring\u001b[87Gthe\u001b[91Ghello.\u001b[98GA\u001b[100Gserver\u001b[107Gholding\u001b[115Gthe\r\u001b[2C\u001b[1B  wrong key is refused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSealing:\u001b[22m af\u001b[17Ger the handshake, every pack\u001b[46Gt\u001b[48Gis seal\u001b[56Gd with\u001b[63Gsession keys from that exchange.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gself-signed\u001b[17GTLS\u001b[21Gcertificate\u001b[33Gis\u001b[36Gweak\u001b[41Gbecause\u001b[49Gnobody\u001b[56Gvouches\u001b[64Gfor\u001b[68Git.\u001b[72GA\u001b[74Gpinned\u001b[81Gkey\u001b[85Gdoesn't\u001b[93Gneed\u001b[98Ganyone\u001b[105Gto\u001b[108Gvouch\u001b[114Gfor\u001b[118Git:\r\u001b[2C\u001b[1Bthe client already has the exact key\u001b[40Gto expect. That make\u001b[62Git as strong \u001b[76Gs a CA-issued certificate, with no domain or\u001b[K\r\u001b[2C\u001b[1BCA involv\u001b[13Gd.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat you'll need to sort out, once it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mKeep the server's secret key safe.\u001b[22m It's\u001b[46Gone\u001b[50Gfile,\u001b[56Greadable\u001b[65Gonly\u001b[70Gby\u001b[73Gthe\u001b[77Gserver's\u001b[86Guser\u001b[91G(mode 0600),\u001b[104Gand\u001b[108Gbacked\u001b[115Gup.\u001b[119GIf\r\u001b[5C\u001b[1Byou\u001b[10Glose\u001b[15Git,\u001b[19Gevery\u001b[25Gclient\u001b[32Ghas\u001b[36Gto\u001b[39Gbe\u001b[42Ggiven\u001b[48Gthe\u001b[52Gnew\u001b[56Gkey.\r\u001b[1B \u001b[3G2. \u001b[1mDecide how players get the public key.\u001b[45G\u001b[22mEither\u001b[52Gship\u001b[57Git\u001b[60Gin\u001b[63Gthe\u001b[67Gclient's\u001b[76Gconfig\u001b[83Gor\u001b[86Gbuild,\u001b[93Gor\u001b[96Gpublish\u001b[104Git\u001b[107Gsomewhere\u001b[117Gthey\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ I don't have any encryption SSL certs ready for my domain yet. What outside work is neede to get this step to comple…\u001b[39m \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[43.979, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.003, "o", "\u001b[?25l\u001b[H    wrong key is refused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSealing:\u001b[14G\u001b[22mafter\u001b[20Gthe\u001b[24Ghandshake,\u001b[35Gevery\u001b[41Gpacket\u001b[48Gis\u001b[51Gsealed\u001b[58Gwith\u001b[63Gsession\u001b[71Gkeys\u001b[76Gfrom\u001b[81Gthat\u001b[86Gexchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gself-signed\u001b[17GTLS\u001b[21Gcertificate\u001b[33Gis\u001b[36Gweak\u001b[41Gbecause\u001b[49Gnobody\u001b[56Gvouches\u001b[64Gfor\u001b[68Git.\u001b[72GA\u001b[74Gpinned\u001b[81Gkey\u001b[85Gdoesn't\u001b[93Gneed\u001b[98Ganyone\u001b[105Gto\u001b[108Gvouch\u001b[114Gfor\u001b[118Git:\r\u001b[1B \u001b[3Gthe client already has the exact key to expect. T\u001b[53Gat makes it as \u001b[69Gtrong as a CA-issued certificate,\u001b[103Gwith\u001b[108Gno\u001b[111Gdomain\u001b[118Gor\r\u001b[2C\u001b[1BCA\u001b[6Ginvolved.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'll need to sort out, once it's built:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mKeep th\u001b[14G server's secret key safe.\u001b[22m It's\u001b[46Gone\u001b[50Gfile\u001b[56Greadable only b\u001b[73Gthe serv\u001b[82Gr's\u001b[86Guser\u001b[91G(mode 0600),\u001b[104Gand\u001b[108Gbacked\u001b[115Gup.\u001b[119GIf\r\u001b[2C\u001b[1B \u001b[5G you lose it, ev\u001b[22Gry\u001b[25Gclient \u001b[33Gas to be given the new key.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mDecide how players get the public key.\u001b[45G\u001b[22mEither\u001b[52Gship\u001b[57Git\u001b[60Gin\u001b[63Gthe\u001b[67Gclient's\u001b[76Gconfig\u001b[83Gor\u001b[86Gbuild,\u001b[93Gor\u001b[96Gpublish\u001b[104Git\u001b[107Gsomewhere\u001b[117Gthey\r\u001b[2C\u001b[1B \u001b[5G trust. If \u001b[17Ghat somewhere is your websit\u001b[46G,\u001b[48Gthe sit\u001b[56G needs\u001b[63GHTTPS. A free Let's Encrypt certificate\u001b[103Gcovers\u001b[110Gthat,\u001b[116Gand\r\u001b[5C\u001b[1Bit's\u001b[11Gseparate\u001b[20Gfrom\u001b[25GJ01.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BPinned keys come with one trade-off:\u001b[40Gchanging the server'\u001b[62Gkey means upd\u001b[76Gting every client. Avoiding that would need a\r\u001b[2C\u001b[1Bsigning k\u001b[13Gy that\u001b[20Gvouches\u001b[28Gfor\u001b[32Grotating\u001b[41Gserver\u001b[48Gkeys.\u001b[54GThat\u001b[59Gisn't\u001b[65Gin\u001b[68Gthe\u001b[72Gplan\u001b[77Gand\u001b[81Gisn't\u001b[87Gneeded\u001b[94Gnow.\r\u001b[2C\u001b[2BI checked Manifest's D-081 (libsodium, no TLS over\u001b[54GUDP).\u001b[60GThe\u001b[64Gexact\u001b[70Ghandshake,\u001b[81Gand\u001b[85Gwhether\u001b[93Gthe\u001b[97Gpinned\u001b[104Gkey\u001b[108Gships\u001b[114Gin\u001b[117Gthe\r\u001b[2C\u001b[1Bbuild or in config, aren't designed yet.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 21s · done 8:26 am\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
