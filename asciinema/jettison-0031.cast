[0.333, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 251 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[12G\u001b[38;2;117;113;94m// A server that does not hold the pinned key, answering a real client: one offers the pinned public\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;117;113;94m// key as its own fresh one, which would leave the hello sealed by the server's secret alone, and one\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;117;113;94m// offers a fresh key with a proof sealed by a key pair of its own. Neither is sent a hello.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;166;226;46mTEST_CASE\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"a client sends no hello to a server whose offer does not prove the pinned key\"\u001b[38;2;248;248;242m)\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m{\u001b[14G            \u001b[27G       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(\u001b[38;2;166;226;46menet_initialize\u001b[38;2;248;248;242m() == \u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m);                                                                    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;248;248;242mENetAddress listen\u001b[33G};                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(\u001b[38;2;166;226;46menet_address_set_host_ip\u001b[38;2;248;248;242m(&listen, \u001b[38;2;230;219;116m\"127.0.0.1\"\u001b[38;2;248;248;242m) == \u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m);                                       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mENetHost *pImpostor\u001b[34G= \u001b[38;2;166;226;46menet_host_create\u001b[38;2;248;248;242m(&listen,\u001b[62G\u