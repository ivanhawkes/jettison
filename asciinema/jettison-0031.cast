[0.143, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 311 +\u001b[38;2;248;248;242m  signs the server's working keys is not provisioned.                                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[2m 312 \u001b[22m - Who a script's commands are sent as,\u001b[51Gwhen\u001b[56Gseveral\u001b[64Gplayers\u001b[72Gshare\u001b[78Ga\u001b[80Gserver\u001b[87G([\u001b[38;2;230;219;116mJ02\u001b[39m](roadmap.md#j02)).\r\u001b[1B     \u001b[2m 313 \u001b[22m - No IPv6: ENet 1.3 does not have it.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 314 \u001b[12G\u001b[22m-\u001b[14GNo\u001b[17Gdeltas\u001b[24Gagainst\u001b[32Gan\u001b[35Gacknowledged\u001b[48Gsnapshot,\u001b[58Gso\u001b[61Gan\u001b[64Gunreliable\u001b[75Gview\u001b[80Gmust\u001b[85Gfit\u001b[89Gin\u001b[92G256\u001b[96GKiB\u001b[100G(above).\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/networking.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[2m 329 \u001b[22m   - `include/jettison/net/Server.h`: `Server`, `ServerConfig`,\u001b[75G`ServerEvent`,\u001b[90G`Verifier`,\r\u001b[5C\u001b[1B\u001b[2m 330 \u001b[16G\u001b[22m`SnapshotView`.\r\u001b[1B \u001b[3G   \u001b[2m 331 \u001b[22m   -\u001b[16G`in\u001b[20Glude/j\u001b[27Gtti\u001b[31Gon/net/Client.h`: `Client`, `ClientConfig`, `Cli\u001b[81GtEvent`.\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 332 +\u001b[38;2;248;248;242m  - `include/jettison/net/Key.h`: `ServerKey`, `GenerateServerKey`, `PublicKeyOf`.                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 333 \u001b[14G\u001b[22m-\u001b[16G`include/jettison/net/Token.h`:\u001b[48G`GenerateToken`,\u001b[65G`DigestToken`,\u001b[80G`TokenMatches`.\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0