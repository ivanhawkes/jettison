[0.292, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 239 \u001b[12G\u001b[22mThe\u001b[16G[\u001b[38;2;230;219;116mgate\u001b[39m](glossary.md#gate-ci)\u001b[44Gis\u001b[47G`scripts/ci.sh`:\u001b[64Gevery\u001b[70Gcheck\u001b[76Ga\u001b[78Gcommit\u001b[85Gmust\u001b[90Gpass,\u001b[96Gin\u001b[99Gone\u001b[103Glocal\r\u001b[1B \u001b[3G   \u001b[2m 240 \u001b[22m c\u001b[14Gmmand. The last \u001b[31Gommit of each chunk\u001b[51Gof\u001b[54Gwork\u001b[59Gpasses\u001b[66Git\u001b[69Gwith\u001b[74G`--werror\u001b[84G--asan`\u001b[92Gbefore\u001b[99Ga\u001b[101Gpush\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 241 -\u001b[38;2;248;248;242m([coding standards](coding-standards.md#commits)). \u001b[48;2;92;2;0mHooks\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mrun\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mparts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mof\u001b[48;2;61;1;0m it\u001b[48;2;92;2;0m:\u001b[48;2;61;1;0m                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 241 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mcoding standards\u001b[38;2;248;248;242m](coding-standards.md#commits)). \u001b[48;2;4;71;0mIt\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mholds\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0m[\u001b[38;2;230;219;116mlanes\u001b[38;2;248;248;242m](#lanes)'\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mlock while \u001b[48;2;2;40;0mit        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 242 +\u001b[38;2;248;248;242mruns, so a gate or build started in another worktree waits for it. Hooks run parts of it:             \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m243 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G4 \u001b[22m | Where | What runs |\u001b[K\r\u001b[6C\u001b[1B\u001b[2m245 \u001b[22m |---|---|\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/scripts/heavy.sh)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m27\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1m~/projects/manifest/scripts/heavy.sh\r\u001b[5C\u001b[1B\u001b[22m\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env bash\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m#\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  3 \u001b[22m\u001b[38;2;117;113;94m# Runs a command holding the machine's lock for heavy work, so the builds, suites and gates of\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# different worktrees (the lanes: Jettison's docs/build-and-gates.md, \"Lanes\") take turns rather than\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# share the cores and the memory: two full-width builds side by side thrash when the local AI is\r\u001b[1B\u001b[39m     \u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m# resident. One lock serves every lane of Jettison and of Manifest, so this is Jettison's script, the\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 7 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m same lock; scripts/ci.sh takes it i\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.331, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 104 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m105\u001b[12G\u001b[22mRun the gat\u001b[25Gas a\u001b[30Gbackground task and wait for\u001b[59Git to f\u001b[67Gnish rather than\u001b[84Gpolli\u001b[90Gg\u001b[92Gwith `sleep`.\r\u001b[5C\u001b[1B\u001b[2m 106 \u001b[22m With `--log` it prints the stages and a summary, and for a failed stage its errors; the full output\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 107 \u001b[22m is in the log. Warm, it takes 3 to 4 minutes (223 s on 2026-11-14), two thirds of it the\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/build-and-gates.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[2m 238 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 239 \u001b[12G\u001b[22mThe\u001b[16G[\u001b[38;2;230;219;116mgate\u001b[39m](glossary.md#gate-ci)\u001b[44Gis\u001b[47G`scripts/ci.sh`:\u001b[64Gevery\u001b[70Gcheck\u001b[76Ga\u001b[78Gcommit\u001b[85Gmust\u001b[90Gpass,\u001b[96Gin\u001b[99Gone\u001b[103Glocal\r\u001b[1B \u001b[3G   \u001b[2m 240 \u001b[22m c\u001b[14Gmmand. The last \u001b[31Gommit of each chunk\u001b[51Gof\u001b[54Gwork\u001b[59Gpasses\u001b[66Git\u001b[69Gwith\u001b[74G`--werror\u001b[84G--asan`\u001b[92Gbefore\u001b[99Ga\u001b[101Gpush\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 241 -\u001b[38;2;248;248;242m([coding standards](coding-standards.md#commits)). \u001b[48;2;92;2;0mHooks\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mrun\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mparts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mof\u001b[48;2;61;1;0m it\u001b[48;2;92;2;0m:\u001b[48;2;61;1;0m                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 241 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mcoding standards\u001b[38;2;248;248;242m](coding-standards.md#commits)). \u001b[48;2;4;71;0mIt\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mholds\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0m[\u001b[38;2;230;219;116mlanes\u001b[38;2;248;248;242m](#lanes)'\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mlock while \u001b[48;2;2;40;0mit        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 242 +\u001b[38;2;248;248;242mruns, so a gate or build started in another worktree waits for it. Hooks run parts of it:             \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m243 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G4 \u001b[22m | Where | What runs |\u001b[K\r\u001b[6C\u001b[1B\u001b[2m245 \u001b[22m |---|---|\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m \u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
