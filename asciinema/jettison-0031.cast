[0.001, "o", "\u001b[?25l\u001b[H\u001b[3G1.\u001b[6G\u001b[1mLanes:\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this checkout)\u001b[49Gplus\u001b[54G\u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B  \u001b[6Gonce with \u001b[38;2;177;185;249mgit worktree add\u001b[39m and \u001b[39Gver removed. A new task does \u001b[38;2;177;185;249mgit switch -c <task> main\u001b[39m \u001b[97Gide a\u001b[103Gfree lane, s\u001b[116G that\r\u001b[5C\u001b[1Bl\u001b[8Gn\u001b[10G's \u001b[38;2;177;185;249mbuild/\u001b[20G\u001b[39mtrees,\u001b[27GDebug\u001b[33Gones\u001b[38Gincluded,\u001b[48Gstay\u001b[53Gwarm.\u001b[59GEach\u001b[64Glane\u001b[69Gcosts\u001b[75Gabout\u001b[81G14\u001b[84GGB\u001b[87Gof\u001b[90Gdisk,\u001b[96Gand\u001b[100G281\u001b[104GGB\u001b[107Gis\u001b[110Gfree.\u001b[116GThey\r\u001b[2C\u001b[1B  \u001b[6Gsit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m works as intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory\u001b[41Gn\u001b[43Gte says \u001b[52Gothing runs beside clang.\u001b[78GRAM\u001b[82Gis\u001b[85Gthe\u001b[89Greason:\u001b[97Gwith\u001b[102Gyour\u001b[107Glocal\u001b[113GAI\r\u001b[5C\u001b[1Bloaded\u001b[13G(\u001b[38;2;177;185;249mstrata-host\u001b[39m),\u001b[28Gtwo\u001b[32Gfull-width\u001b[43Gbuilds\u001b[50Gwould\u001b[56Gthrash.\u001b[64GSo\u001b[67G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[81G\u001b[39mand\u001b[85Ga\u001b[87Gsmall\u001b[93G\u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[2C\u001b[1B\u001b[39m   wrapper\u001b[14Gshare\u001b[20Gone\u001b[24Gmachine-wide\u001b[37Glock\u001b[42G(\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lock\u001b[39m).\u001b[80GA\u001b[82Gsecond\u001b[89Ggate\u001b[94Gor\u001b[97Gbuild\u001b[103Gqueues\u001b[110Gbehind\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5G f\u001b[8Grst inste\u001b[18Gd of competing\u001b[33Gwith\u001b[38Git. Revie\u001b[48Gs, \u001b[52Gditing,\u001b[60Gre\u001b[63Gding and docs need n\u001b[84G lock. That's where\u001b[104Gthe overlap pays\r\u001b[4C\u001b[1B off: the\u001b[15G10-minu\u001b[23Ge review\u001b[32Grounds\u001b[39Gand\u001b[43Gthe\u001b[47Ggate's\u001b[54Gwait\u001b[59Gno\u001b[62Glonger\u001b[69Gleave\u001b[75Gme\u001b[78Gidle.\r\u001b[2C\u001b[1B3. \u001b[1mA lane state file:\u001b[22m \u001b[38;2;177;185;249mbuild/lane.md\u001b[39m in each lane, ignored by gi\u001b[67G, says what the lane holds \u001b[95Gnd wha\u001b[102G i\u001b[105G's\u001b[108Gwaiting on,\u001b[K\r\u001b[2C\u001b[1B \u001b[5G so I always know which lane\u001b[34Gis fre\u001b[41G.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mManifest\u001b[15G\u001b[22mgets\u001b[20Gthe\u001b[24Gsame\u001b[29Gthree\u001b[35Glanes,\u001b[42G\u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[69G\u001b[39mand\u001b[73G\u001b[38;2;177;185;249m-c\u001b[39m,\u001b[77Geach\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gthe\u001b[103Gengine\u001b[110Glane\u001b[115Gof\u001b[118Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame name.\u001b[K\r\u001b[2C\u001b[1B5. \u001b[1mDocs:\u001b[12G\u001b[22ma\u001b[14G\"Lanes\"\u001b[22Gsection\u001b[30Gin\u001b[33G\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[39m,\u001b[53Ga\u001b[55Gpointer\u001b[63Gin\u001b[66G\u001b[38;2;177;185;249mAGENTS.md\u001b[39m,\u001b[77Gand\u001b[81Gthe\u001b[85Gworktrunk\u001b[95G\u001b[38;2;177;185;249mworktree-path\u001b[109G\u001b[39mchanged\u001b[117Gto\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249m~/projects/{{ repo }}.{{ branch }}\u001b[41G\u001b[39mfor\u001b[45Ganything\u001b[54Gstill\u001b[60Gmade\u001b[65Gwith\u001b[70G\u001b[38;2;177;185;249mwt\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaveats:\r\u001b[1B\u001b[22m \u001b[3G- Switching branches i\u001b[27Gide \u001b[32G lane rebuilds\u001b[47Gwhatever\u001b[56Gthe\u001b[60Gbranch\u001b[67Gchanged.\u001b[76GThat's\u001b[83Gordinary\u001b[92Gincremental\u001b[104Gwork,\u001b[110Gand\u001b[114Gmuch\r\u001b[1B    less than a cold tree.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gfirst\u001b[15Ggate\u001b[20Gin\u001b[23Geach\u001b[28Gnew\u001b[32Glane\u001b[37Gis\u001b[40Gcold\u001b[45Gonce:\u001b[51Gabout\u001b[57G5–10\u001b[62Gminutes,\u001b[71Gwith\u001b[76GRelease\u001b[84Gsharing\u001b[92Gccache\u001b[99Gwith\u001b[104Gthe\u001b[108Gother\u001b[114Gtrees.\r\u001b[1B \u001b[3G- A review still needs its own lane left untouched while it runs. That's\u001b[76Gexactly\u001b[84Gwhat\u001b[89Gthe\u001b[93Gextra\u001b[99Glanes\u001b[105Ggive.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.016, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Propose a solution to the problem of waiting idle on the gate while each piece of work completes. I thought we set u…\u001b[39m \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.408, "o", "\u001b]0;◑ jettison-0031\u0007"]
[0.201, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's one at a time now.\u001b[22m Worktrunk is set\u001b[48Gup, but there's\u001b[64Gonly\u001b[69Gone checkout (\u001b[38;2;177;185;249mgit worktree list\u001b[39m shows\u001b[107Gjust this\u001b[K\r\u001b[2C\u001b[1Bone). Two settings also work against reuse:\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m~/.config/worktrunk/config.toml\u001b[39m puts new\u001b[46Gworktrees in\u001b[59G\u001b[38;2;177;185;249m~/worktrees/jettison/<branch>\u001b[39m. ccache\u001b[97Gonly\u001b[102Gsha\u001b[106Ges \u001b[110Gompiled\r\u001b[4C\u001b[1Bobjects\u001b[13Gbetween trees under \u001b[38;2;177;185;249m~/projects\u001b[39m (\u001b[38;2;177;185;249mCCACHE_BASEDIR\u001b[39m), so a\u001b[67Gworktree made\u001b[81Gthere\u001b[87Gwou\u001b[91Gd\u001b[93Gshare nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWo\u001b[8Gktrunk m\u001b[17Gk\u001b[19Gs a new worktree for each branch and removes it on merge. Every bra\u001b[87Gch would start with \u001b[108Gmpty build\u001b[K\r\u001b[4C\u001b[1Btree\u001b[10G:\u001b[12Gabout five\u001b[25Gld builds per gate, and Debug builds never\u001b[68Gshare objects\u001b[82Gbetween trees anyway.\u001b[104G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPropos\u001b[10Gl:\u001b[13Gthre\u001b[19Gpermanent lanes, reused from task to task.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mLanes:\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this checkout)\u001b[49Gplus\u001b[54G\u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B  \u001b[6Gonce with \u001b[38;2;177;185;249mgit worktree add\u001b[39m and \u001b[39Gver removed. A new task does \u001b[38;2;177;185;249mgit switch -c <task> main\u001b[39m \u001b[97Gide a\u001b[103Gfree lane, s\u001b[116G that\r\u001b[5C\u001b[1Bl\u001b[8Gn\u001b[10G's \u001b[38;2;177;185;249mbuild/\u001b[20G\u001b[39mtrees,\u001b[27GDebug\u001b[33Gones\u001b[38Gincluded,\u001b[48Gstay\u001b[53Gwarm.\u001b[59GEach\u001b[64Glane\u001b[69Gcosts\u001b[75Gabout\u001b[81G14\u001b[84GGB\u001b[87Gof\u001b[90Gdisk,\u001b[96Gand\u001b[100G281\u001b[104GGB\u001b[107Gis\u001b[110Gfree.\u001b[116GThey\r\u001b[2C\u001b[1B  \u001b[6Gsit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m works as intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory\u001b[41Gn\u001b[43Gte says \u001b[52Gothing runs beside clang.\u001b[78GRAM\u001b[82Gis\u001b[85Gthe\u001b[89Greason:\u001b[97Gwith\u001b[102Gyour\u001b[107Glocal\u001b[113GAI\r\u001b[5C\u001b[1Bloaded\u001b[13G(\u001b[38;2;177;185;249mstrata-host\u001b[39m),\u001b[28Gtwo\u001b[32Gfull-width\u001b[43Gbuilds\u001b[50Gwould\u001b[56Gthrash.\u001b[64GSo\u001b[67G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[81G\u001b[39mand\u001b[85Ga\u001b[87Gsmall\u001b[93G\u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[2C\u001b[1B\u001b[39m   wrapper\u001b[14Gshare\u001b[20Gone\u001b[24Gmachine-wide\u001b[37Glock\u001b[42G(\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lock\u001b[39m).\u001b[80GA\u001b[82Gsecond\u001b[89Ggate\u001b[94Gor\u001b[97Gbuild\u001b[103Gqueues\u001b[110Gbehind\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5G f\u001b[8Grst inste\u001b[18Gd of competing\u001b[33Gwith\u001b[38Git. Revie\u001b[48Gs, \u001b[52Gditing,\u001b[60Gre\u001b[63Gding and docs need n\u001b[84G lock. That's where\u001b[104Gthe overlap pays\r\u001b[4C\u001b[1B off: the\u001b[15G10-minu\u001b[23Ge review\u001b[32Grounds\u001b[39Gand\u001b[43Gthe\u001b[47Ggate's\u001b[54Gwait\u001b[59Gno\u001b[62Glonger\u001b[69Gleave\u001b[75Gme\u001b[78Gidle.\r\u001b[2C\u001b[1B3. \u001b[1mA lane state file:\u001b[22m \u001b[38;2;177;185;249mbuild/lane.md\u001b[39m in each lane, ignored by gi\u001b[67G, says what the lane holds \u001b[95Gnd wha\u001b[102G i\u001b[105G's\u001b[108Gwaiting on,\u001b[K\r\u001b[2C\u001b[1B \u001b[5G so I always know which lane\u001b[34Gis fre\u001b[41G. \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
