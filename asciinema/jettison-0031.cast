GA\u001b[115Gclient\r\u001b[5C\u001b[1Bpinned\u001b[13Gto\u001b[16Gthe\u001b[20Gwrong\u001b[26Gkey\u001b[30Gis\u001b[33Grefused\u001b[41Gwith\u001b[46Ga\u001b[48Gnew\u001b[52G\u001b[38;2;177;185;249mKeyMismatch\u001b[64G\u001b[39mreason\u001b[71Gbefore\u001b[78Gits\u001b[82Gtoken\u001b[88Gis\u001b[91Gever\u001b[96Gchecked.\r\u001b[2C\u001b[1B3. The\u001b[10Ghello, including the token, is sent e\u001b[76G A recorded h\u001b[90Gllo replay\u001b[101Gd on a\u001b[108Gn\u001b[110Gw\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.406, "o", "\u001b[?25l\u001b[H\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m I've built J01 in the\u001b[25Gengine\u001b[32Gand\u001b[36Gthe\u001b[40Gfull\u001b[45Ggate\u001b[50Gpasses\u001b[57G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[75G236\u001b[79Gs).\u001b[83GNothing\u001b[91Gis\u001b[94Gcommitted\u001b[104Gyet.\u001b[109GManifest\r\u001b[2C\u001b[1Bstill has \u001b[14Go adopt it before encryption\u001b[43Greaches\u001b[51Gthe\u001b[55Ggame.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow the connection works now\r\u001b[2C\u001b[1B\u001b[22m1. When the client connects,\u001b[32Geach\u001b[37Gside\u001b[42Gsends\u001b[48Ga\u001b[50Gfresh\u001b[56Gone-time\u001b[65Gkey.\r\u001b[2C\u001b[1B2.\u001b[6GThe\u001b[10Gconnection's\u001b[23Gkeys\u001b[28Gcome\u001b[33Gfrom\u001b[38Gmixing\u001b[45Gthose\u001b[51Gwith\u001b[56Gthe\u001b[60Gserver's\u001b[69Glong-term\u001b[79Gkey,\u001b[84Gwhich\u001b[90Gthe\u001b[94Gclient\u001b[101Ghas\u001b[105Gpinned.\u001b[113GA\u001b[115Gclient\r\u001b[1B \u001b[3G   pin\u001b[10Ged to\u001b[16Gthe wrong\u001b[26Gkey is refused with a\u001b[48Gnew \u001b[38;2;177;185;249mKeyMismatch\u001b[39m r\u001b[66Gason\u001b[71Gbefore\u001b[78Gits\u001b[82Gtoken\u001b[88Gis\u001b[91Gever\u001b[96Gchecked.\r\u001b[2C\u001b[1B3.\u001b[6GThe\u001b[10Ghello,\u001b[17Gincluding\u001b[27Gthe\u001b[31Gtoken,\u001b[38Gis\u001b[41Gsent\u001b[46Gencrypted\u001b[56Gafter\u001b[62Gthat\u001b[67Gexchange.\u001b[77GA\u001b[79Grecorded\u001b[88Ghello\u001b[94Greplayed\u001b[103Gon\u001b[106Ga\u001b[108Gnew\r\u001b[2C\u001b[1B   connection can't be\u001b[26Gdecrypted.\r\u001b[2C\u001b[1B4.\u001b[6GIf\u001b[9Gthe\u001b[13Gserver's\u001b[22Gsecret\u001b[29Gkey\u001b[33Gis\u001b[36Gstolen\u001b[43Glater,\u001b[50Gconnections\u001b[62Grecorded\u001b[71Gbefore\u001b[78Gthat\u001b[83Gstill\u001b[89Gcan't\u001b[95Gbe\u001b[98Gread.