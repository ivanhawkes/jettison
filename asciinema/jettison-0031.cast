\u001b[1B\u001b[1mOne risk:\u001b[13G\u001b[22ma\u001b[15Gprocess\u001b[23Gleft\u001b[28Grunning\u001b[36Gby\u001b[39Ga\u001b[41Gkilled\u001b[48Ggate,\u001b[54Gsuch\u001b[59Gas\u001b[62Ga\u001b[64Gstray\u001b[70GXvfb,\u001b[76Gkeeps\u001b[82Gthe\u001b[86Glock\u001b[91Guntil\u001b[97Git\u001b[100Gexits.\u001b[107G\u001b[38;2;177;185;249mheavy.sh\r\u001b[2C\u001b[1B\u001b[39mprints that\u001b[15Git's waiting, so a stuck queue shows up.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22mManifest's\u001b[20Gadoption\u001b[29Gof\u001b[32GJ01\u001b[36G(the\u001b[41Gserver\u001b[48Gkey\u001b[52Gfile,\u001b[58G\u001b[38;2;177;185;249m--key\u001b[39m,\u001b[65Gand\u001b[69Gthe\u001b[73Gpublic\u001b[80Gkey\u001b[84Gin\u001b[87Gthe\u001b[91Gtest\u001b[96Gbuilds'\u001b[104Gclient\u001b[111Gconfig),\u001b[27;1H\u001b[24;72H\u001b[?25h"]
