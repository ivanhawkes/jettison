[0.072, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(build/reviews/j01-reply-2.md)\u001b[K\r\u001b[2C\u001b[1B⎿\u001b[5G Wrote\u001b[12G\u001b[1m44\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mbuild/reviews/j01-reply-2.md\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  1 \u001b[22m# Reply to round 2\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m  2 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22mThe gate passed again\u001b[32Gwith\u001b[37Gthese\u001b[43Gfixes\u001b[49G(--werror\u001b[59G--asan,\u001b[67G146\u001b[71Gs,\u001b[74Gbuild/gate.log).\u001b[91Gnet\u001b[95Gsuite:\u001b[102G14\u001b[105Gcases,\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m519\u001b[14Gassertions.\u001b[26GEach\u001b[31Gnew\u001b[35Gtest\u001b[40Gwas\u001b[44Gchecked\u001b[52Gagainst\u001b[60Ga\u001b[62Gmutation\u001b[71Gundoing\u001b[79Gits\u001b[83Gfix.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m## F5: unauthenticated off\u001b[37Gr — fixed by a\u001b[52Gproof in the server's \u001b[75Gffer\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mThe\u001b[14Gserver's\u001b[23Goffer\u001b[29Gis\u001b[32Gnow\u001b[36Gits\u001b[40Gfresh\u001b[46Gkey\u001b[50Gfollowed\u001b[59Gby\u001b[62Ga\u001b[64G*proof*:\u001b[73Ga\u001b[75Gmessage\u001b[83Gof\u001b[86Gthe\u001b[90Goffer's\u001b[98Gkind\u001b[103Gwith\u001b[108Gno\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mbody, sealed (reli\u001b[29Gble\u001b[33Gchannel, counter\u001b[50G0) with\u001b[58Gthe conn\u001b[67Gction's keys\u001b[80G(`Wire::MakeOffer(key,\u001b[103Gkeys)`).\r\u001b[7C\u001b[1B\u001b[2m9\u001b[14G\u001b[22mclient deriv\u001b[27Gs\u001b[29Gthe keys, open\u001b[44G th\u001b[48G pr\u001b[52Gof, and sends its hello only if it opens and is of\u001b[103Gthe\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22moffer'\u001b[17G kin\u001b[23Gwith \u001b[29Gn \u001b[32Gmpty body; \u001b[44Gtherwise\u001b[53Git clos\u001b[61Gs as KeyMismatch and sends nothing mor\u001b[100G\u001b[K\r\u001b[5C\u001b[1B… +34 lines\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[4G\u001b[39mou\u001b[7Gd 3\u001b[11Gis running. Meanwhile\u001b[33GI'll\u001b[38Gmake\u001b[43Gthe\u001b[47Glane\u001b[52Gworktrees.\u001b[63GDoing\u001b[69Gthat\u001b[74Gonly\u001b[79Gtouches\u001b[87Ggit's\u001b[93Gmetadata,\u001b[103Gnot\u001b[107Gthis\u001b[112Gtree,\u001b[118Gso\r\u001b[1B  it can't disturb the review. First a look at how Manifest finds the engine.\u001b[K\r\u001b[39C\u001b[2B\u001b[38;2;153;153;153mthought for 11s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
