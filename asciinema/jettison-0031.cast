[0.285, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/scripts/heavy.sh)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m27\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1m~/projects/manifest/scripts/heavy.sh\r\u001b[5C\u001b[1B\u001b[22m\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env bash\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m#\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  3 \u001b[22m\u001b[38;2;117;113;94m# Runs a command holding the machine's lock for heavy work, so the builds, suites and gates of\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# different worktrees (the lanes: Jettison's docs/build-and-gates.md, \"Lanes\") take turns rather than\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# share the cores and the memory: two full-width builds side by side thrash when the local AI is\r\u001b[1B\u001b[39m     \u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m# resident. One lock serves every lane of Jettison and of Manifest, so this is Jettison's script, the\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 7 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m same lock; scripts/ci.sh takes it itself.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 8 \u001b[22m\u001b[38;2;117;113;94m#\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 9 \u001b[22m\u001b[38;2;117;113;94m# Usage: scripts/heavy.sh <command> [arguments...]\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 10 \u001b[22m\u001b[38;2;117;113;94m#\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +17 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/scripts/ci.sh)\r\u001