[0.612, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gwrong key is \u001b[19Gefused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSealing:\u001b[14G\u001b[22mafter\u001b[20Gthe\u001b[24Ghandshake,\u001b[35Gevery\u001b[41Gpacket\u001b[48Gis\u001b[51Gsealed\u001b[58Gwith\u001b[63Gsession\u001b[71Gkeys\u001b[76Gfrom\u001b[81Gthat\u001b[86Gexchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA self-signed TLS certificate is\u001b[36Gw\u001b[38Gak because nobody\u001b[56Gvouches for\u001b[68Gi\u001b[70G. A pinned key do\u001b[88Gsn't need \u001b[99Gnyone \u001b[106Go\u001b[108Gv\u001b[110Guch for\u001b[118Git:\r\u001b[2C\u001b[1Bthe client already\u001b[22Ghas\u001b[26Gthe\u001b[30Gexact\u001b[36Gkey\u001b[40Gto\u001b[43Gexpect.\u001b[51GThat\u001b[56Gmakes\u001b[62Git\u001b[65Gas\u001b[68Gstrong\u001b[75Gas\u001b[78Ga\u001b[80GCA-issued\u001b[90Gcertificate,\u001b[103Gwith\u001b[108Gno\u001b[111Gdomain\u001b[118Gor\r\u001b[2C\u001b[1BCA\u001b[6Ginvolved.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat you'll\u001b[15Gn\u001b[17Ged to sort out, once it's built:\u001b[50G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mKeep the server's secret key safe.\u001b[22m It's one fil\u001b[54G,\u001b[56Gr\u001b[58Gadable\u001b[65Gonly\u001b[70Gby\u001b[73Gthe\u001b[77Gserver's\u001b[86Guser\u001b[91G(mode 0600),\u001b[104Gand\u001b[108Gbacked\u001b[115Gup.\u001b[119GIf\r\u001b[2C\u001b[1B  \u001b[6Gyou lose it, every client has to be given the\u001b[52Gnew key.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDecide how players get the public key.\u001b[22m Either\u001b[53Ghip\u001b[57Git in\u001b[63Gthe client's config\u001b[83Gor build, or publish it somewhere they\r\u001b[5C\u001b[1Btru\u001b[10Gt. If that s\u001b[24Gewhere\u001b[31Gis\u001b[34Gyour\u001b[39Gwebsite,\u001b[48Gthe\u001b[52Gsite\u001b[57Gneeds\u001b[63GHTTPS.\u001b[70GA\u001b[72Gfree\u001b[77GLet's\u001b[83GEncrypt\u001b[91Gcertificate\u001b[103Gcovers\u001b[110Gthat,\u001b[116Gand\r\u001b