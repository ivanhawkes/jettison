[0.469, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[2m 1 \u001b[22m# Lane\u001b[16GA\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 2 \u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m 3 \u001b[22mOn feature-base\u001b[25G(4b2707d). Next: Manifest's adoption\u001b[62Gof J01 (server\u001b[77Gkey\u001b[81Gfile,\u001b[87Gclient\u001b[94Gconfig\u001b[101Gwith\u001b[106Gthe\u001b[110Gpubl\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m   \u001b[22mic key).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ01 is committ\u001b[18Gd \u001b[21Gn \u001b[38;2;177;185;249mfeature-base\u001b[39m (\u001b[38;2;177;185;249meae405b\u001b[39m) aft\u001b[50Gr four\u001b[57Greview\u001b[64Grounds,\u001b[72Gand\u001b[76Gthe\u001b[80Gthree-lane\u001b[91Gsetup\u001b[97Gis\u001b[100Gbuilt\u001b[106Gand\u001b[110Gworking.\r\u001b[2C\u001b[1BNothing\u001b[11Ghas\u001b[15Gbeen\u001b[20Gpushed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJ01 review (4 rounds).\u001b[22m Codex found\u001b[38Gnine problems and all \u001b[61Gr\u001b[64Gfixed.\u001b[71GThe serious\u001b[83Gone\u001b[87Gwas\u001b[91Gin\u001b[94Ground\u001b[100G2:\u001b[103Gthe\u001b[107Gclient\u001b[114Gsent\r\u001b[2C\u001b[1Bits\u001b[7Gtoken\u001b[13Gbefore\u001b[20Gthe\u001b[24Gserver\u001b[31Ghad\u001b[35Gproved\u001b[42Git\u001b[45Gheld\u001b[50Gthe\u001b[54Gpinned\u001b[61Gkey.\u001b[66GAn\u001b[69Gimpostor\u001b[78Gcould\u001b[84Ghave\u001b[89Grecorded\u001b[98Gthat\u001b[103Gtoken\u001b[109Gand\r\u001b[2C\u001b[1Bdecrypted it later if\u001b[25Gthe server's s\u001b[40Gcret ever leak\u001b[55Gd. The server's \u001b[72Gffer now carries a short proof that only the real\r\u001b[2C\u001b[1Bk\u001b[5Gy holder can make, and the c\u001b[34Gient \u001b[41Gnds nothing more until it ch\u001b[70Gcks out. Th\u001b[83Gother fixes:\u001b[K\r\u001b[2C\u001b[1B- the\u001b[9Gmessage counter ca\u001b[28G no long\u001b[38G wrap\u001b[44Garound\u001b[51Gand\u001b[55Grepeat\u001b[62Ga\u001b[64Gnonce;\r\u001b[2C\u001b[1B-\u001b[5Gtwo\u001b[9Gtests\u001b[15Gwere\u001b[20Gfixed\u001b[26Gand\u001b[30Gthree\u001b[36Gadded,\u001b[43Geach\u001b[48Gconfirmed\u001b[58Gto\u001b[61Gfail\u001b[66Gwhen\u001b[71Gits\u001b[75Gfix\u001b[79Gis\u001b[82Gundone;\r\u001b[2C\u001b[1B- secrets the \u001b[18Gng\u001b[22Ge holds are wiped once used\u001b[50G(the docs \u001b[61Gay which temporary\u001b[80Gcopies\u001b[87Gcan't\u001b[93Gbe\u001b[96Gwiped);\r\u001b[4C\u001b[1Bthe docs were corrected where they lagge\u001b[47Gthe code.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BRound 4 still said \"changes\" for two small items, a lite\u001b[60Gal channel cou\u001b[75Gt\u001b[77Gand a\u001b[83Gcomment's wording. I f\u001b[106Gxed\u001b[110Gboth \u001b[116Gfter\r\u001b[2C\u001b[1Bthe round, \u001b[15Go\u001b[17Gno reviewer h\u001b[31Gs seen\u001b[38Gthose two fixes. The gate p\u001b[66Gss\u001b[70G after them.\u001b[K\r\u001b[4C\u001b[1B     \u001b[11G       \u001b[19G   \u001b[27;1H\u001b[24;3H\u001b[?25h"]
