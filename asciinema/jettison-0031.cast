[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  closed, but can't read\u001b[28Gor forg\u001b[37Ga message.\u001b[K\r\u001b[2C\u001b[1B- Changing the server's key means updating every\u001b[52Gclien\u001b[58G's\u001b[61Gconfig.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcheck\u001b[15Ga\u001b[17Gclient\u001b[24Gmakes\u001b[30Gagainst\u001b[38Ga\u001b[40Gfake\u001b[45Gserver\u001b[52Gthat\u001b[57Ganswers\u001b[65Gbut\u001b[69Gdoesn't\u001b[77Ghold\u001b[82Gthe\u001b[86Gkey\u001b[90Ghas\u001b[94Gno\u001b[97Gtest;\u001b[103Gthat\u001b[108Gwould\u001b[114Gneed\u001b[119Ga\r\u001b[2C\u001b[1B  hand-written\u001b[18Gfake server.\u001b[K\r\u001b[2C\u001b[1B- Manifest's docs st\u001b[24Gll link\u001b[32Gto the roadmap'\u001b[48G J01\u001b[53Gsection,\u001b[62Gwhich\u001b[68Gis\u001b[71Gnow\u001b[75Ggone.\u001b[81GI'll\u001b[86Gfix\u001b[90Gthose\u001b[96Glinks\u001b[102Gwhen\u001b[107GManifest\r\u001b[4C\u001b[1Badopts\u001b[12Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest's side, not started.\u001b[33G\u001b[22mWith\u001b[38Gthe\u001b[42Gengine\u001b[49Gchange\u001b[56Galone,\u001b[63GManifest's\u001b[74Gserver\u001b[81Gwould\u001b[87Grefuse\u001b[94Gto\u001b[97Gstart\u001b[103Gbecause\u001b[111Git\u001b[114Ghas\u001b[118Gno\r\u001b[2C\u001b[1Bkey. My\u001b[11Gproposal:\r\u001b[4C\u001b[1BA \u001b[38;2;177;185;249mmanifest-token key\u001b[39m command writ\u001b[39Gs the server's s\u001b[56Gcret k\u001b[63Gy to a private file next to the tokens file and prints \u001b[119Ghe\r\u001b[4C\u001b[1Bpublic key.\u001b[17G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m--serve\u001b[39m reads that file, with a\u001b[37G\u001b[38;2;177;185;249m--key <file>\u001b[39m option \u001b[58Go poi\u001b[64Gt elsewhere.\r\u001b[5C\u001b[1Best builds\u001b[17Gsh\u001b[20Gp a\u001b[24Gcli\u001b[28Gnt config\u001b[38Gfile holding the public key, which \u001b[38;2;177;185;249mconnect\u001b[39m reads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThen move Manifest's engine\u001b[33Gpin\u001b[37Gand\u001b[41Gupdate\u001b[48GD-081\u001b[54Gand\u001b[58G\u001b[38;2;177;185;249mserver.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you:\u001b[21G\u001b[22mshould\u001b[28GI\u001b[30Gcommit\u001b[37Gthis\u001b[42Gnow,\u001b[47Gand\u001b[51Gdo\u001b[54Gyou\u001b[58Gwant\u001b[63Ga\u001b[65GCodex\u001b[71Gcross-review\u001b[84Gbefore\u001b[91GManifest\u001b[100Gadopts\u001b[107Git?\u001b[111GI'd\r\u001b[2C\u001b[1Bsuggest\u001b[11Ga\u001b[13Greview,\u001b[21Gsince\u001b[27Gthis\u001b[32Gis\u001b[35Gsecurity\u001b[44Gcode\u001b[49G(about\u001b[56G10\u001b[59Gminutes\u001b[67Ga\u001b[69Ground).\u001b[77GAfter\u001b[83Gthat\u001b[88GI'd\u001b[92Gstart\u001b[98GManifest's\u001b[109Gside\u001b[114Gas\r\u001b[2C\u001b[1Bproposed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 16m 37s · done 8:44 am\u001b[39m \u001b[41G   \u001b[45G  \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
