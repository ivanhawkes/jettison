[0.379, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, read \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mHere's\u001b[10Gthe\u001b[14Gworktree\u001b[23Gproposal.\u001b[33GI'll\u001b[38Gkeep\u001b[43Gworking\u001b[51Gon\u001b[54GJ01\u001b[58Gwhile\u001b[64Gyou\u001b[68Gread\u001b[73Git.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's one at a time now.\u001b[31G\u001b[22mWorktrunk\u001b[41Gis\u001b[44Gset\u001b[48Gup,\u001b[52Gbut\u001b[56Gthere's\u001b[64Gonly\u001b[69Gone\u001b[73Gcheckout\u001b[82G(\u001b[38;2;177;185;249mgit worktree list\u001b[101G\u001b[39mshows\u001b[107Gjust\u001b[112Gthis\r\u001b[2C\u001b[1Bone). Two settings also work against reuse:\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m~/.config/worktrunk/config.toml\u001b[39m puts new worktrees\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249m~/worktrees/jettison/<branch>\u001b[39m.\u001b[90Gccache\u001b[97Gonly\u001b[102Gshares\u001b[109Gcompiled\r\u001b[2C\u001b[1B \u001b[5Gobjects between trees under \u001b[38;2;177;185;249m~/projects\u001b[39m (\u001b[38;2;177;185;249mCCACHE_BASEDIR\u001b[39m), so a worktree made there would s\u001b[95Gare nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWorktrunk mak\u001b[19Gs\u001b[21Ga n\u001b[25Gw\u001b[27Gworktree for each branch and remove\u001b[63G it\u001b[67Gon me\u001b[73Gg\u001b[75G. Ev\u001b[80Gry b\u001b[85Ganch would start w\u001b[104Gth empty\u001b[113Gbuild\r\u001b[2C\u001b[1B \u001b[5Gtrees: about five\u001b[23Gcold builds per gate,\u001b[45Gand Debug builds never share objects between\u001b[90Gtrees\u001b[96Ganyway.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposal: three permanent lanes, reused from task to task.\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mLanes\u001b[12G\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this checkout) plus \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B  \u001b[6Gonce with \u001b[38;2;177;185;249mgit worktree add\u001b[33G\u001b[39mand never removed. A\u001b[54Gnew task does \u001b[38;2;177;185;249mg\u001b[70Gt switch -c <task> main\u001b[39m inside a free lane, so that\r\u001b[5C\u001b[1Blan\u001b[10G's \u001b[38;2;177;185;249mbuild/\u001b[39m trees, Debug\u001b[33Go\u001b[35Ges includ\u001b[45Gd, stay warm. Each lane costs about 14 GB of disk, an\u001b[99G 281 GB is free. They\u001b[K\r\u001b[5C\u001b[1Bsit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[64G\u001b[39mworks a\u001b[72G intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory note says \u001b[52Gothing runs\u001b[64Gbeside cla\u001b[75Gg. RAM is\u001b[85Gthe\u001b[89Greason:\u001b[97Gwith\u001b[102Gyour\u001b[107Glocal\u001b[113GAI\r\u001b[2C\u001b[1B  \u001b[6Gloaded (\u001b[38;2;177;185;249mstrata-host\u001b[39m), two full-width builds would thrash.\u001b[64GSo \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and\u001b[85Ga small \u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[5C\u001b[1B\u001b[39mwr\u001b[9Gpper share one machine-wide lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lo\u001b[76Gk\u001b[39m). A second gate or build queues behind\u001b[117Gthe\r\u001b[5C\u001b[1Bfirst in\u001b[15Gtead\u001b[21Gf competing with it.\u001b[42GRevie\u001b[76G need\u001b[82Gno lock. That's where the overlap pays\u001b[27;1H\u001b[24;3H\u001b[?25h"]
