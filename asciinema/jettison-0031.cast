\u001b[29G2\u001b[31Gfixes\u001b[37Gnow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mIn-place\u001b[12Gencryption\u001b[23Gis\u001b[26Gsafe\u001b[31Gin\u001b[34Gthe\u001b[38Gpinned\u001b[45Glibsodium:\u001b[56Gthe\u001b[60Gstream\u001b[67GXOR\u001b[71Gruns\u001b[76Gfirst\u001b[82Gand\u001b[86Gthe\u001b[90Gtag\u001b[94Gis\u001b[97Gcomputed\u001b[106Gover\u001b[111Gthe\r\u001b[1B \u001b[3Gciphert\u001b[11Gxt. Wri\u001b[20Gng\u001b[23Gthe round 2 fixes \u001b[42Gow.\u001b[K\r\u001b[2C\u001b[1B           \u001b[15G       \u001b[23G   \u001b[27G     \u001b[33G \u001b[35G     \u001b[41G    \u001b[27;1H\u001b[24;89H\u001b[?25h"]
