[0.026, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# different worktrees (the lanes: docs/build-and-gates.md, \"Lanes\") take turns rather than share the\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# cores and the memory: two full-width builds side by side thrash when the local AI is resident. One\r\u001b[1B\u001b[39m     \u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m# lock serves every lane of Jettison and of Manifest; scripts/ci.sh takes it itself.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;117;113;94m#\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;117;113;94m# Usage: scripts/heavy.sh <command> [arguments...]\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;117;113;94m#\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 10 \u001b[22m\u001b[38;2;117;113;94m# The command inherits the lock's descriptor, so a process it leaves running holds the lock until\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +16 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(scripts/ci.sh)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[2m 27 \u001b[22m \u001b[38;2;166;226;46mset\u001b[39m -euo\u001b[20Gpipefail\r\u001b[5C\u001b[1B\u001b[2m 28 \u001b[11G\u001b[22m\u001b[38;2;166;226;46mcd\u001b[14G\u001b[38;2;230;219;116m\"\u001b[39m$(dirname\u001b[25G\u001b[38;2;230;219;116m\"\u001b[39m${BASH_SOURCE[0]}\u001b[38;2;230;219;116m\"\u001b[39m)\u001b[38;2;230;219;116m/..\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 29 \u001b[22m\u001b[K\r\u001b[1B     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 30 +\u001b[38;2;117;113;94m# One gate or build at a time across every worktree (scripts/heavy.sh).\u001b[38;2;248;248;242m                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 31 +\u001b[38;2;248;248;242m[ -n \u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m${JETTISON_HEAVY_HELD:-}\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m ] || \u001b[38;2;166;226;46mexec\u001b[38;2;248;248;242m scripts/heavy.sh scripts/ci.sh \u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m$@\u001b[38;2;230;219;116m\"\u001b[38;2;248;248;242m                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 32 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m33\u001b[13G\u001b[22m\u001b[38;2;117;113;94mThe\u001b[17Gsuites\u001b[24Gare\u001b[28Gseparate processes,\u001b[76Gmporary directory named for its\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.320, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mfile, in                                                                                               \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m38\u001b[10G\u001b[22m   the scratch directory named below, and say in the finding where it is.\u001b[K\r\u001b[6C\u001b[1B\u001b[2m39\u001b[10G\u001b[22m - Do not edit, create or delete tracked files, and do not commit. The author fixes;\u001b[95Gyou\u001b[99Greport.\r\u001b[6C\u001b[1B\u001b[2m40\u001b[10G\u001b[22m \u001b[13GThe\u001b[17Gscript\u001b[24Gchecks\u001b[31Gthe\u001b[35Gtree\u001b[40Gafterwards\u001b[51Gand\u001b[55Gdiscards\u001b[64Ga\u001b[66Greview\u001b[73Gthat\u001b[78Gchanged\u001b[86Git.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scripts/heavy.sh)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m26\u001b[22m lines to \u001b[1mscripts/heavy.sh\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env bash\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m#\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  3 \u001b[22m\u001b[38;2;117;113;94m# Runs a command holding the machine's lock for heavy work, so the builds, suites and gates of\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# different worktrees (the lanes: docs/build-and-gates.md, \"Lanes\") take turns rather than share the\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# cores and the memory: two full-width builds side by side thrash when the local AI is resident. One\r\u001b[1B\u001b[39m     \u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m# lock serves every lane of Jettison and of Manifest; scripts/ci.sh takes it itself.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;117;113;94m#\u001b[39m\u001b[K\r\u00