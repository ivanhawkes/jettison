[0.032, "o", "\u001b[?25l\u001b[H\u001b[5GENet's own packet headers aren't \u001b[39Gncrypted. Someon\u001b[56G on th\u001b[63G network path can cut a connection or fake the reason i\u001b[119G\u001b[K\r\u001b[4C\u001b[1Bclosed, but\u001b[17Gcan't\u001b[23Gread\u001b[28Gor\u001b[31Gforge\u001b[37Ga\u001b[39Gmessage.\r\u001b[4C\u001b[1BChanging the server's key means\u001b[37Gupdating every clien\u001b[58G's co\u001b[64Gfig.\u001b[K\r\u001b[5C\u001b[1Bhe check a\u001b[17Gcl\u001b[20Gent\u001b[24Gmak\u001b[28Gs against\u001b[38Ga fake server that answers but doesn't hold the key\u001b[90Ghas\u001b[94Gno\u001b[97Gtest;\u001b[103Gthat\u001b[108Gwould\u001b[114Gneed\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5Ghand-written fake server.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest's\u001b[16Gdocs\u001b[21Gstill\u001b[27Glink\u001b[32Gto\u001b[35Gthe\u001b[39Groadmap's\u001b[49GJ01\u001b[53Gsection,\u001b[62Gwhich\u001b[68Gis\u001b[71Gnow\u001b[75Ggone.\u001b[81GI'll\u001b[86Gfix\u001b[90Gthose\u001b[96Glinks\u001b[102Gwhen\u001b[107GManifest\r\u001b[2C\u001b[1B  adopts it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest's side, not started.\u001b[33G\u001b[22mWith\u001b[38Gthe\u001b[42Gengine\u001b[49Gchange\u001b[56Galone,\u001b[63GManifest's\u001b[74Gserver\u001b[81Gwould\u001b[87Grefuse\u001b[94Gto\u001b[97Gstart\u001b[103Gbecause\u001b[111Git\u001b[114Ghas\u001b[118Gno\r\u001b[2C\u001b[1Bkey.\u001b[8GMy\u001b[11Gproposal:\r\u001b[1B \u001b[3G- A \u001b[38;2;177;185;249mmanifest-token key\u001b[39m command writes\u001b[41Gthe\u001b[45Gserver's\u001b[54Gsecret\u001b[61Gkey\u001b[65Gto\u001b[68Ga\u001b[70Gprivate\u001b[78Gfile\u001b[83Gnext\u001b[88Gto\u001b[91Gthe\u001b[95Gtokens\u001b[102Gfile\u001b[107Gand\u001b[111Gprints\u001b[118Gthe\r\u001b[4C\u001b[1Bpublic\u001b[12Gkey.\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249m--serve\u001b[39m reads that file, with a \u001b[38;2;177;185;249m--key <file>\u001b[39m option to point elsewhere.\u001b[K\r\u001b[2C\u001b[1B- Test builds ship a client config file holding the public key, which \u001b[38;2;177;185;249mconnect\u001b[39m reads.\u001b[K\r\u001b[2C\u001b[1B- Then move Manifest's engine pin\u001b[37Gand\u001b[41Gupdate\u001b[48GD-081\u001b[54Gand\u001b[58G\u001b[38;2;177;185;249mserver.md\u001b[39m.\r\u001b[2B  \u001b[1mDecision for you:\u001b[22m should I commit this now, and do you want a Codex cross-review before Manifest adopts it? I'd\u001b[K\r\u001b[2C\u001b[1Bsuggest\u001b[11Ga\u001b[13Greview,\u001b[21Gsince\u001b[27Gthis\u001b[32Gis\u001b[35Gsecurity\u001b[44Gcode\u001b[49G(about\u001b[56G10\u001b[59Gminutes\u001b[67Ga\u001b[69Ground).\u001b[77GAfter\u001b[83Gthat\u001b[88GI'd\u001b[92Gstart\u001b[98GManifest's\u001b[109Gside\u001b[114Gas\r\u001b[1B \u001b[3Gproposed.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitat\u001b[11Gd for 16m 37s · done 8:44 am\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.014, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ go ahead and start J01. I have a website with SSL already taken care of. I think we should at least initially ship t…\u001b[39m \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.478, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mClientConfig::serverKey\u001b[39m.\u001b[28GKeys ar\u001b[37G64 hex characters,\u001b[56Glike\u001b[61Gtokens.\u001b[69GMost\u001b[74Gof\u001b[77Gthe\u001b[81Gcode\u001b[86Gis\u001b[89Gin\u001b[92Gthe\u001b[96Ginternal\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mnet/src/Seal.h/.cpp\u001b[39m, and \u001b[38;2;177;185;249mWire\u001b[39m, \u001b[38;2;177;185;249mServer\u001b[39m and \u001b[38;2;177;185;249mClient\u001b[52G\u001b[39muse i\u001b[58G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[22m the \u001b[38;2;177;185;249mnet\u001b[18G\u001b[39msuite (11 cases)\u001b[35Gand\u001b[39Gthe\u001b[43Gconsumer\u001b[52Gcheck\u001b[58Gpass.\u001b[64GThe\u001b[68Gnew\u001b[72Gcases\u001b[78Gcover\u001b[84Ga\u001b[86Gclient\u001b[93Gwith\u001b[98Gthe\u001b[102Gwrong\u001b[108Gkey,\u001b[113Gand\r\u001b[2C\u001b[1Breplayed, altered, m\u001b[24Gsrouted\u001b[32Gand late packet\u001b[48G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDocs:\u001b[9G\u001b[22mnetworking,\u001b[21Gdecisions\u001b[31Gand\u001b[35Gscope\u001b[41Gare\u001b[45Gupdated,\u001b[54Gand\u001b[58GJ01\u001b[62Gis\u001b[65Grecorded\u001b[74Gin\u001b[77Ghistory\u001b[85Gand\u001b[89Gremoved\u001b[97Gfrom\u001b[102Gthe\u001b[106Groadmap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimits:\u001b[11G\u001b[22m\u001b[K\r\u001b[4C\u001b[1BENet's own packet headers aren't \u001b[39Gncrypted. Someon\u001b[56G on th\u001b[63G network path can cut a connection or fake the reason i\u001b[119G\u001b[K\r\u001b[4C\u001b[1Bclosed, but\u001b[17Gcan't\u001b[23Gread\u001b[28Gor\u001b[31Gforge\u001b[37Ga\u001b[39Gmessage.\r\u001b[4C\u001b[1BChanging the server's key means\u001b[37Gupdating every clien\u001b[58G's co\u001b[64Gfig.\u001b[K\r\u001b[5C\u001b[1Bhe check a\u001b[17Gcl\u001b[20Gent\u001b[24Gmak\u001b[28Gs against\u001b[38Ga fake server that answers but doesn't hold the key\u001b[90Ghas\u001b[94Gno\u001b[97Gtest;\u001b[103Gthat\u001b[108Gwould\u001b[114Gneed\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5Ghand-written fake server.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest's\u001b[16Gdocs\u001b[21Gstill\u001b[27Glink\u001b[32Gto\u001b[35Gthe\u001b[39Groadmap's\u001b[49GJ01\u001b[53Gsection,\u001b[62Gwhich\u001b[68Gis\u001b[71Gnow\u001b[75Ggone.\u001b[81GI'll\u001b[86Gfix\u001b[90Gthose\u001b[96Glinks\u001b[102Gwhen\u001b[107GManifest\r\u001b[2C\u001b[1B  adopts it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest's side, not started.\u001b[33G\u001b[22mWith\u001b[38Gthe\u001b[42Gengine\u001b[49Gchange\u001b[56Galone,\u001b[63GManifest's\u001b[74Gserver\u001b[81Gwould\u001b[87Grefuse\u001b[94Gto\u001b[97Gstart\u001b[103Gbecause\u001b[111Git\u001b[114Ghas\u001b[118Gno\r\u001b[2C\u001b[1Bkey.\u001b[8GMy\u001b[11Gproposal:\r\u001b[1B \u001b[3G- A \u001b[38;2;177;185;249mmanifest-token key\u001b[39m command writes\u001b[41Gthe\u001b[45Gse\u001b[76Ge\u001b[78Gfile\u001b[83Gnext\u001b[88Gto\u001b[91Gthe\u001b[95Gtokens\u001b[102Gfile\u001b[107Gand\u001b[111Gprints\u001b[118Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
