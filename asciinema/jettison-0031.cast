[0.802, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242mle channel, sealed by keys from another pinned key, and keys from a point of small order; it seals and\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242m opens the last counter once and then refuses to seal; a raw ENet client is refused a hello recorded o\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242mn another connection; two raw impostor servers, one offering the pinned public key as its fresh one an\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242md one proving a key of its own, are sent no hello and the client closes as `KeyMismatch`; every earlie\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242mr case passes sealed. Each new case fails when its fix is undo\u001b[75G\u001b[49m\u001b[39m…\u001b[77G[+88\u001b[82Gchars]\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m                          \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m215 \r\u001b[6C\u001b[1B216 \u001b[22m Manif\u001b[18Gst'\u001b[22G W18, W11\u001b[32Gand W19 n\u001b[42Geded no engine edit, \u001b[65Gd\u001b[67Glater W12, W13 and W14 (2026-11-23), comp\u001b[109Gtitiv\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G \u001b[22m e\u001b[14G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m217 \u001b[12G\u001b[22mprocurement,\u001b[25Gregional\u001b[34Ggovernance\u001b[45Gand\u001b[49Gthe\u001b[53Gclose\u001b[59Gof\u001b[62Gits\u001b[66GStage\u001b[72G4,\u001b[75Gon\u001b[78Gthe\u001b[82Gpin\u001b[86G`14fc23a`.\u001b[97GIts\u001b[101GR01\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command, recalled \u001b[1m1\u001b[22m memory, wrote \u001b[1m2\u001b[22m memories \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u