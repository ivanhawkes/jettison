[0.757, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B1. When the client connects, e\u001b[34Gch\u001b[37Gside sends \u001b[49G fre\u001b[54Gh\u001b[56Gone-time key.\u001b[K\r\u001b[2C\u001b[1B2. The connection's keys\u001b[28Gcome from mixi\u001b[43Gg\u001b[45Gthose with\u001b[56Gthe\u001b[60Gserver's\u001b[69Glong-term\u001b[79Gkey,\u001b[84Gwhich\u001b[90Gthe\u001b[94Gclient\u001b[101Ghas\u001b[105Gpinned.\u001b[113GA\u001b[115Gclient\r\u001b[5C\u001b[1Bpinned\u001b[13Gto\u001b[16Gthe\u001b[20Gwrong\u001b[26Gkey\u001b[30Gis\u001b[33Grefused\u001b[41Gwith\u001b[46Ga\u001b[48Gnew\u001b[52G\u001b[38;2;177;185;249mKeyMismatch\u001b[64G\u001b[39mreason\u001b[71Gbefore\u001b[78Gits\u001b[82Gtoken\u001b[88Gis\u001b[91Gever\u001b[96Gchecked.\r\u001b[2C\u001b[1B3. The\u001b[10Ghello, including the token, is sent encrypted after that exchange. A recorded h\u001b[90Gllo replay\u001b[101Gd on a\u001b[108Gn\u001b[110Gw\u001b[K\r\u001b[2C\u001b[1B   connection can't be decrypte\u001b[35G.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GIf\u001b[9Gthe\u001b[13Gserver's\u001b[22Gsecret\u001b[29Gkey\u001b[33Gis\u001b[36Gstolen\u001b[43Glater,\u001b[50Gconnections\u001b[62Grecorded\u001b[71Gbefore\u001b[78Gthat\u001b[83Gstill\u001b[89Gcan't\u001b[95Gbe\u001b[98Gread.\r\u001b[2C\u001b[1B5. Every message after that\u001b[31Gis en\u001b[37Grypted and \u001b[49Guthenticated\u001b[62G(libsodium's XC\u001b[78GaCha20-Poly1305). A packet that is\u001b[K\r\u001b[5C\u001b[1Breplayed,\u001b[16Gmoved\u001b[22Gto\u001b[25Gthe\u001b[29Gother\u001b[35Gchannel,\u001b[44Galtered\u001b[52Gor\u001b[55Gforged\u001b[62Gis\u001b[65Grejected.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's new in the API:\u001b[22m \u001b[38;2;177;185;249mNet::GenerateServerKey()\u001b[39m and \u001b[38;2;177;185;249mNet::PublicKeyOf()\u001b[39m in\u001b[77G\u001b[38;2;177;185;249mnet/Key.h\u001b[39m, \u001b[38;2;177;185;249mServerConfig::secretKey\u001b[39m, and\u001b[117G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mClientConfig::serverKey\u001b[39m.\u001b[28GKeys ar\u001b[37G64 hex characters,\u001b[56Glike\u001b[61Gtokens.\u001b[69GMost\u001b[74Gof\u001b[77Gthe\u001b[81Gcode\u001b[86Gis\u001b[89Gin\u001b[92Gthe\u001b[96Ginternal\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mnet/src/Seal.h/.cpp\u001b[39m, and \u001b[38;2;177;185;249mWire\u001b[39m, \u001b[38;2;177;185;249mServer\u001b[39m and \u001b[38;2;177;185;249mClient\u001b[52G\u001b[39muse i\u001b[58G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[22m the \u001b[38;2;177;185;249mnet\u001b[18G\u001b[39msuite (11 cases)\u001b[35Gand\u001b[39Gthe\u001b[43Gconsumer\u001b[52Gcheck\u001b[58Gpass.\u001b[64GThe\u001b[68Gnew\u001b[72Gcases\u001b[78Gcover\u001b[84Ga\u001b[86Gclient\u001b[93Gwith\u001b[98Gthe\u001b[102Gwrong\u001b[108Gkey,\u001b[113Gand\r\u001b[2C\u001b[1Breplayed, altered, m\u001b[24Gsrouted\u001b[32Gand late packet\u001b[48G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDocs:\u001b[9G\u001b[22mnetworking,\u001b[21Gdecisions\u001b[31Gand\u001b[35Gscope\u001b[41Gare\u001b[45Gupdated,\u001b[54Gand\u001b[58GJ01\u001b[62Gis\u001b[65Grecorded\u001b[74Gin\u001b[77Ghistory\u001b[85Gand\u001b[89Gremoved\u001b[97Gfrom\u001b[102Gthe\u001b[106Groadmap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimits:\u001b[11G\u001b[22m\u001b[K\r\u001b[4C\u001b[1BENet's own packet headers aren't \u001b[39Gncrypted\u001b[76G can cut a connection or fake the reason i\u001b[119G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
