[0.073, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(AGENTS.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m5\u001b[22m li\u001b[17Ges\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 97 \u001b[12G\u001b[22mprints at most\u001b[27G20 distinct\u001b[39Gdiagnostics and names `build/clang-debug/tidy-diagnostics.log`,\u001b[103Gwhich\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 98 \u001b[12G\u001b[22mholds the whole text; `--full`\u001b[43Gprints\u001b[50Geverything,\u001b[62G`--summary`\u001b[74Gthe\u001b[78Gtally.\r\u001b[5C\u001b[1B\u001b[2m  99 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m100 +\u001b[38;2;248;248;242mWork\u001b[17Ghappens in three kept worktrees a repository, the lanes (`~/projects/jettison`,                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 101 +\u001b[38;2;248;248;242m`jettison.lane-b`, `jettison.lane-c`, and Manifest's likewise): a task is cut from `feature-base` in  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 102 +\u001b[38;2;248;248;242ma free lane and merged back into it, and builds and gates take turns through `scripts/heavy.sh`'s     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 103 +\u001b[38;2;248;248;242mlock, which `scripts/ci.sh` takes itself ([\u001b[38;2;230;219;116mlanes\u001b[38;2;248;248;242m](docs/build-and-gates.md#lanes)).                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 104 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 105 \u001b[12G\u001b[22mRun\u001b[16Gthe\u001b[20Ggate\u001b[25Gas\u001b[28Ga\u001b[30Gbackground\u001b[41Gtask\u001b[46Gand\u001b[50Gwait\u001b[55Gfor\u001b[59Git\u001b[62Gto\u001b[65Gfinish\u001b[72Grather\u001b[79Gthan\u001b[84Gpolling\u001b[92Gwith\u001b[97G`sleep`.\r\u001b[2C\u001b[1B   \u001b[2m 106 \u001b[22m With `--log` it prints the stages and a summary,\u001b[61Gand\u001b[65Gfor\u001b[69Ga\u001b[71Gfailed\u001b[78Gstage\u001b[84Gits\u001b[88Gerrors;\u001b[96Gthe\u001b[100Gfull\u001b[105Goutput\r\u001b[5C\u001b[1B\u001b[2m 107 \u001b[12G\u001b[22mis\u001b[15Gin\u001b[18Gthe\u001b[22Glog.\u001b[27GWarm,\u001b[33Git\u001b[36Gtakes\u001b[42G3\u001b[44Gto\u001b[47G4\u001b[49Gminutes\u001b[57G(223\u001b[62Gs\u001b[64Gon\u001b[67G2026-11-14),\u001b[80Gtwo\u001b[84Gthirds\u001b[91Gof\u001b[94Git\u001b[97Gthe\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ sed -n 237,262p docs/build-and-gates.md\r\u001b[2C\u001b[2B\u001b[38;2;230;149;117mBrewing…\u001b[13G\u001b[38;2;153;153;153m42m 20s ·\u001b[23G↓\u001b[39m \u001b[38;2;153;153;153m72.0k toke\u001b[36Gs)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
