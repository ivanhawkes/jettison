[0.003, "o", "\u001b[?25l\u001b[H\u001b[3G  wrong key is refused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSealing:\u001b[22m after the h\u001b[26Gndshake, every\u001b[41Gpacket is sealed with session\u001b[71Gkeys from that exc\u001b[91Gnge.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gself-signed\u001b[17GTLS\u001b[21Gcertificate\u001b[33Gis\u001b[36Gweak\u001b[41Gbecause\u001b[49Gnobody\u001b[56Gvouches\u001b[64Gfor\u001b[68Git.\u001b[72GA\u001b[74Gpinned\u001b[81Gkey\u001b[85Gdoesn't\u001b[93Gneed\u001b[98Ganyone\u001b[105Gto\u001b[108Gvouch\u001b[114Gfor\u001b[118Git:\r\u001b[2C\u001b[1Bthe client already has th\u001b[29G \u001b[31Gxac\u001b[35G k\u001b[38Gy\u001b[40Gto expect. That makes it as strong as a CA-issued certifica\u001b[100Ge,\u001b[103Gwith no domain\u001b[118Gor\r\u001b[2C\u001b[1BCA involved.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat you'll need to sort out, once it's built:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mKeep the server's secret key safe.\u001b[41G\u001b[22mIt's\u001b[46Gone\u001b[50Gfile,\u001b[56Greadable\u001b[65Gonly\u001b[70Gby\u001b[73Gthe\u001b[77Gserver's\u001b[86Guser\u001b[91G(mode 0600),\u001b[104Gand\u001b[108Gbacked\u001b[115Gup.\u001b[119GIf\r\u001b[2C\u001b[1B \u001b[5G you lose it,\u001b[19Gev\u001b[22Gry client has to be given the\u001b[52Gnew k\u001b[58Gy.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mDecide how players get the public key.\u001b[45G\u001b[22mEither\u001b[52Gship\u001b[57Git\u001b[60Gin\u001b[63Gthe\u001b[67Gclient's\u001b[76Gconfig\u001b[83Gor\u001b[86Gbuild,\u001b[93Gor\u001b[96Gpublish\u001b[104Git\u001b[107Gsomewhere\u001b[117Gthey\r\u001b[5C\u001b[1Btrust.\u001b[13GIf\u001b[16Gthat\u001b[21Gsomewhere\u001b[31Gis\u001b[34Gyour\u001b[39Gwebsite,\u001b[48Gthe\u001b[52Gsite\u001b[57Gneeds\u001b[63GHTTPS.\u001b[70GA\u001b[72Gfree\u001b[77GLet's\u001b[83GEncrypt\u001b[91Gcertificate\u001b[103Gcovers\u001b[110Gthat,\u001b[116Gand\r\u001b[1B \u001b[3G   it's separate from J01.\u001b[K\r\u001b[2B  Pinned keys come with one trade-off: changing the server's key means updating every client. Avoiding that would need a\r\u001b[1B  signing key that vouches for rotating server keys. That isn't in the plan and isn't needed now.\u001b[K\r\u001b[2B \u001b[3GI checked\u001b[13GManifest's D-081\u001b[30G(libsodium,\u001b[42Gno\u001b[45GTLS\u001b[49Gover\u001b[54GUDP).\u001b[60GThe\u001b[64Gexact\u001b[70Ghandshake,\u001b[81Gand\u001b[85Gwhether\u001b[93Gthe\u001b[97Gpinned\u001b[104Gkey\u001b[108Gships\u001b[114Gin\u001b[117Gthe\r\u001b[2C\u001b[1Bbuild\u001b[9Gor\u001b[12Gin\u001b[15Gconfig,\u001b[23Garen't\u001b[30Gdesigned\u001b[39Gyet.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mBrewed for 21s · done 8:26 am\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
