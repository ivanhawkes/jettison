[0.279, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(scripts/cross-review-prompt.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m \u001b[13Gits callers and i\u001b[31Gs\u001b[33Gtests. A finding about code you\u001b[65Ghave not opened\u001b[81Gis a guess.\u001b[K\r\u001b[6C\u001b[1B\u001b[2m34\u001b[11G\u001b[22m-\u001b[13GVerify what you doubt. You\u001b[40Gmay buil\u001b[49G (`scripts/heavy.sh cmake --build --preset\u001b[92Gclang-debug`)\u001b[106Gand\r\u001b[5C\u001b[1B\u001b[2m 35 \u001b[13G\u001b[22mrun\u001b[17Gsuites\u001b[24G(`scripts/heavy.sh\u001b[43Gctest\u001b[49G--test-dir\u001b[60Gbuild/clang-debug\u001b[78G-R\u001b[81G'^<module>$'\r\u001b[1B \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 36 -\u001b[38;2;248;248;242m  --output-on-failure`)\u001b[48;2;92;2;0m:\u001b[48;2;61;1;0m `heavy.sh` waits its turn behind a gate or build in another worktree.\u001b[48;2;92;2;0m A reprod\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0muction\u001b[48;2;61;1;0m                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 37 -\u001b[38;2;248;248;242m  that proves a finding is worth more than an argument: write it, and any other scratch file, in       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 36 +\u001b[38;2;248;248;242m  --output-on-failure`)\u001b[48;2;4;71;0m;\u001b[48;2;2;40;0m `heavy.sh` waits its turn behind a gate or \u001b[48;2;4;71;0ma \u001b[48;2;2;40;0mbuild in another worktree.       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 37 +\u001b[38;2;248;248;242m  \u001b[48;2;4;71;0mA reproduction \u001b[48;2;2;40;0mthat proves a finding is worth more than an argument: write it, and 