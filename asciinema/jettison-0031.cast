[0.091, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m7\u001b[10G\u001b[22mThe server's offer is n\u001b[34Gw its fresh ke\u001b[50Gfoll\u001b[55Gwed by a *proof*: a message\u001b[83Gof\u001b[86Gthe\u001b[90Goffer's\u001b[98Gkind\u001b[103Gwith\u001b[108Gno\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mbody, sealed\u001b[23G(reliable channel, count\u001b[48Gr\u001b[50G0) with the\u001b[62Gconnection's\u001b[75Gk\u001b[77Gy\u001b[79G (`Wire::MakeOffer(\u001b[99Gey,\u001b[103Gkeys)`).\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mThe cli\u001b[18Gnt \u001b[22Gerives th\u001b[33Gkeys, opens th\u001b[48G proof, and sends its hello only if it opens and is of\u001b[103Gthe\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22moffer's kin\u001b[22G w\u001b[25Gth an \u001b[32Gmpt\u001b[36G body; otherwise it\u001b[56Gcloses a\u001b[66GKeyMismatch and sends nothing more\u001b[K\r\u001b[5C\u001b[1B… +34 line\u001b[18G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound\u001b[9G3\u001b[11Gis\u001b[14Grunning.\u001b[23GMeanwhile\u001b[33GI'll\u001b[38Gmake\u001b[43Gthe\u001b[47Glane\u001b[52Gworktrees.\u001b[63GDoing\u001b[69Gthat\u001b[74Gonly\u001b[79Gtouches\u001b[87Ggit's\u001b[93Gmetadata,\u001b[103Gnot\u001b[107Gthis\u001b[112Gtree,\u001b[118Gso\r\u001b[1B \u001b[3Git can't disturb the review. First\u001b[38Ga look at how\u001b[52GManifest finds the engi\u001b[76Ge.\u001b[79G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, read \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest\u001b[12Gcan\u001b[16Galready\u001b[24Guse\u001b[28Ga\u001b[30Glocal\u001b[36Gengine\u001b[43Gvia\u