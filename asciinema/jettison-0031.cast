[0.156, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G5\u001b[12G\u001b[22ma\u001b[14Gnew pair,\u001b[24Gand \u001b[29Gvery clie\u001b[39Gt\u001b[41Ggiven the new publ\u001b[60Gc half,\u001b[68Gsince\u001b[74Ga\u001b[76Gclient\u001b[83Gconnects\u001b[92Gonly\u001b[97Gto\u001b[100Gthe\u001b[104Gkey\u001b[108Git\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/networking.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdde\u001b[11G \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 323 \u001b[12G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m324 \u001b[22m - ENet's headers\u001b[29Gare\u001b[33Gnot\u001b[37Gsealed,\u001b[45Gso\u001b[48Gsomeone\u001b[56Gon\u001b[59Gthe\u001b[63Gpath\u001b[68Gcan\u001b[72Gclose\u001b[78Ga\u001b[80Gconnection,\u001b[92Gwith\u001b[97Gany\u001b[101Greason\r\u001b[6C\u001b[1B\u001b[2m325 \u001b[14G\u001b[22m(above).\u001b[23G\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 326 +\u001b[38;2;248;248;242m- Secrets are wiped where the engine keeps them, not in the serialiser's or the allocator's spent     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 327 +\u001b[38;2;248;248;242m  buffers (above).                                                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 328 \u001b[22m - One key a server, pinned: changing it means giving every client the new one. A long-lived key that\u001b[K\r\u001b[6C\u001b[1B\u001b[2m329 \u001b[14G\u001b[22msigns the serv\u001b[29Gr'\u001b[32G working keys is\u001b[49Gn\u001b[51Gt pr\u001b[56Gvisio\u001b[62Ged.\u001b[K\r\u001b[6C\u001b[1B\u001b[2m330 \u001b[12G\u001b[22m-\u001b[14GWho a script's commands ar\u001b[41G sent as, when several players\u001b[72Gshare\u001b[78Ga\u001b[80Gserver\u001b[87G([\u001b[38;2;230;219;116mJ02\u001b[39m](roadmap.md#j02)).\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/networking.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdde\u001b[11G \u001b[1m1\u001b[22m line, remove\u001b[27G \u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[2m 87 \u001b[22m stateDiagram-v2\u001b[K\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G \u001b[22m \u001b[14G [*] --> Pendi\u001b[29Gg: ENet conn\u001b[42Gcts\u001b[K\r\u001b[6C\u001b[1B\u001b[2m89 \u001b[22m \u001b[14G Pe\u001b[18Gding -->\u001b[27GR\u001b[29Gfused:\u001b[36Ganything but\u001b[49Gan offer (BadMessage)\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 90 -\u001b[38;2;248;248;242m    Pending --> Offered: offer, answered with the server's                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 90 +\u001b[38;2;248;248;242m    Pending --> Offered: offer, answ\u001b[76G\u001b[48;2;4;71;0ms proof\u001b[48;2;2;40;0m                               \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.383, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 215 +\u001b[38;2;248;248;242mThe engine wipes the secrets it keeps once they are spent: the server's text of its secret key once   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 216 +\u001b[38;2;248;248;242mread, each fresh key once the connection's keys are made, the credential once the hello is sealed,    \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 217 +\u001b[38;2;248;248;242monce it is judged and when a client is destroyed, and a connection's keys when it closes. A message   \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 218 +\u001b[38;2;248;248;242mis written into its packet and sealed there, so its plain text is not copied. That narrows what a     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 219 +\u001b[38;2;248;248;242mlater look at the process's memory could find; it does not close it. The hello is encoded by the      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 220 +\u001b[38;2;248;248;242mbinary archive, whose working buffers, and any buffer a growing vector leaves behind, go back to      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 221 +\u001b[38;2;248;248;242mthe allocator unwiped, and the engine does not lock its memory against swap. The caller's own         \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m2\u001b[9G2\u001b[12G\u001b[38;2;248;248;242mcopies of\u001b[22Gits\u001b[26Gkeys and credentials are it\u001b[55Gown. Where  \u001b[68G   \u001b[72G            \u001b[85G  \u001b[88G   \u001b[92G           \u001b[104G     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 223 \u001b[22m the keys are kept and how a client is given its server's is the game's: a file the operator keeps\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G4\u001b[12G\u001b[22mprivate, and the publ\u001b[34Gc half in the client's conf\u001b[62Gguration\u001b[71Gor its\u001b[78Gbuild. A s\u001b[89Gcret lost or leaked is\u001b[K\r\u0