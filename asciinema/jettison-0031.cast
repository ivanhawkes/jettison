[0.300, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[20B\u001b[1mDocs:\u001b[12G\u001b[22ma\u001b[14G\"Lanes\"\u001b[22Gsection\u001b[30Gin\u001b[33G\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[39m,\u001b[53Ga\u001b[55Gpointer\u001b[63Gin\u001b[66G\u001b[38;2;177;185;249mAGENTS.md\u001b[39m,\u001b[77Gand\u001b[81Gthe\u001b[85Gworktrunk\u001b[95G\u001b[38;2;177;185;249mworktree-path\u001b[109G\u001b[39mchanged\u001b[117Gto\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.302, "o", "\u001b[?25l\u001b[H\u001b[3G  trees: abou\u001b[17G five cold builds per gate, and\u001b[49GDebug\u001b[55Gbuilds\u001b[62Gnever\u001b[68Gshare\u001b[74Gobjects\u001b[82Gbetween\u001b[90Gtrees\u001b[96Ganyway.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposal: three permanent lanes, reused from task to task.\u001b[62G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mLanes:\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this che\u001b[43Gkout) plus \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[39m and \u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\u001b[K\r\u001b[4C\u001b[1B once with \u001b[38;2;177;185;249mgit worktree add\u001b[39m and never removed. A new ta\u001b[61Gk do\u001b[66Gs\u001b[68G\u001b[38;2;177;185;249mgit switch -c <task> main\u001b[39m inside a free\u001b[108Glane,\u001b[114Gso\u001b[117Gthat\r\u001b[5C\u001b[1Blane's\u001b[13G\u001b[38;2;177;185;249mbuild/\u001b[20G\u001b[39mtrees,\u001b[27GDebug\u001b[33Gones\u001b[38Gincluded,\u001b[48Gstay\u001b[53Gwarm.\u001b[59GEach\u001b[64Glane\u001b[69Gcosts\u001b[75Gabout\u001b[81G14\u001b[84GGB\u001b[87Gof\u001b[90Gdisk,\u001b[96Gand\u001b[100G281\u001b[104GGB\u001b[107Gis\u001b[110Gfree.\u001b[116GThey\r\u001b[2C\u001b[1B   sit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in \u001b[38;2;177;185;249mdevenv.nix\u001b[64G\u001b[39mworks\u001b[70Gas\u001b[73Gintended.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory note says nothing runs beside clang. RAM is\u001b[85Gthe reason: with your local\u001b[113GAI\u001b[K\r\u001b[5C\u001b[1Bloaded (\u001b[38;2;177;185;249mstra\u001b[19Ga-hos\u001b[25G\u001b[39m), two full-width\u001b[43Gbuilds would thr\u001b[61Gh. So \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and a small \u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\u001b[39m\u001b[K\r\u001b[5C\u001b[1Bwrapper share\u001b[20Gon\u001b[23G machine-wid\u001b[36G lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lock\u001b[39m). A second gate or build queue\u001b[110Gbehind the\r\u001b[5C\u001b[1Bf\u001b[8Grst instead of competing with it.\u001b[42GReviews, editing, reading and docs \u001b[78Ge\u001b[81G no\u001b[85Glock.\u001b[91GThat's\u001b[98Gwhere\u001b[104Gthe\u001b[108Goverlap\u001b[116Gpays\r\u001b[2C\u001b[1B  \u001b[6Goff: the 10-minute review rounds and \u001b[44Ghe gate's wait\u001b[59Gno longer leave me\u001b[78Gidle.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA lane state file:\u001b[22m \u001b[38;2;177;185;249mbuild/lane.md\u001b[39m in each lane, ignored by\u001b[64Ggit, says what the lane ho\u001b[91Gds and what it's waiting\u001b[116Gon,\r\u001b[5C\u001b[1Bso I always kn\u001b[21Gw whi\u001b[28G lane is\u001b[37Gfree.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mManifest\u001b[22m g\u001b[17Gts\u001b[20Gthe sam\u001b[28G three lanes,\u001b[42G\u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[39m and \u001b[38;2;177;185;249m-c\u001b[39m,\u001b[77Geach\u001b[82Gbui\u001b[86Gding\u001b[91Gag\u001b[94Gin\u001b[97Gt the engine lane of the\r\u001b[5C\u001b[1Bsame\u001b[11Gname.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mDocs:\u001b[22m a \"Lanes\" section in \u001b[38;2;177;185;249mbuil\u001b[38G-and-gates.md\u001b[53G\u001b[39ma p\u001b[57Ginter in \u001b[38;2;177;185;249mAGENTS.md\u001b[39m, and the worktrunk \u001b[38;2;177;185;249mworktree-path\u001b[39m changed to\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249m~/projects/{{ repo }}.{{ branch }}\u001b[39m for\u001b[45Ganything\u001b[54Gstill\u001b[60Gmade\u001b[65Gwith\u001b[70G\u001b[38;2;177;185;249mwt\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaveats:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
