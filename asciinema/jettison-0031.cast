01b[5C\u001b[1B\u001b[38;2;80;200;80m 763 +\u001b[38;2;248;248;242m- **Merging.** In the primary checkout, `git merge --ff-only <task>`, then the branch is deleted and  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gits lane parked with\u001b[36Ggit switch --detach featur\u001b[63G-base`.\u001b[71GA task cut before another\u001b[97Gmerged is  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mrebased onto `feature-base` in\u001b[45Gits\u001b[49Glan\u001b[53G and gated\u001b[64Gag\u001b[67Gin there\u001b[76Gbefore it\u001b[86Gmerges, so what lands\u001b[108Gon  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242m`f\u001b[17Gatur\u001b[22G-b\u001b[25Gse\u001b[28G is what was gated. Only work merged and \u001b[70Ge\u001b[72Gted on `feature-base` is \u001b[98G candidate\u001b[109Gfor\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m \u001b[14G`main`, which th\u001b[32Gus\u001b[35Gr decides.     \u001b[51G   \u001b[55G      \u001b[62G    \u001b[67G     \u001b[73G   \u001b[77G     \u001b[83G   \u001b[87G       \u001b[95G  \u001b[98G    \u001b[103G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m-\u001b[14G**Kept, not mad\u001b[30G per branch.** A lane is never \u001b[62Gemoved, so\u001b[73Gits build\u001b[83Gtre\u001b[87Gs stay wa\u001b[97Gm, Debug ones\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[14G\u001b[38;2;248;248;242mincluded, which ccache sh\u001b[40Gr\u001b[42Gs within a\u001b[53Gtre\u001b[58Gonly ([\u001b[38;2;230;219;116mcompiler cache\u001b[38;2;248;248;242m](#compiler-cache)). A switch      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242mrebuilds what the branches\u001b[41Gchange.    \u001b[53G   \u001b[57G    \u001b[62G       \u001b[70G    \u001b[75G   \u001b[79G  \u001b[82G     \u001b[88G  \u001b[91G        \u001b[100G      \u001b[107G    \r\u001b[5C\u001b[1B\u001b[49m\u001b