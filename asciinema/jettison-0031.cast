size\u001b[39m(), \u001b[38;2;166;226;46mBytes\u001b[39m(ephemeral), ephemeral.\u001b[38;2;166;226;46msize\u001b[39m());\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEach new test fails when its fix is broken.\u001b[47GNext: \u001b[54Ghe handshake\u001b[67Gdocs,\u001b[73Gthen\u001b[78Gtidy,\u001b[84Gformat,\u001b[92Gthe\u001b[96Gconsumer\u001b[105Gcheck\u001b[111Gand\u001b[115Ga\r\u001b[2C\u001b[1Bfresh\u001b[9Ggate\u001b[14Gbefore\u001b[21Ground\u001b[27G3.\r\u001b[2C\u001b[1B            \u001b[27;1H\u001b[24;3H\u001b[?25h"]
