[0.032, "o", "\u001b[?25l\u001b[H\u001b[3Gone).\u001b[9GTwo\u001b[13Gsettings\u001b[22Galso\u001b[27Gwork\u001b[32Gagainst\u001b[40Greuse:\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m~/.config/worktrunk/config.toml\u001b[37G\u001b[39mputs\u001b[42Gnew\u001b[46Gworktrees\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249m~/worktrees/jettison/<branch>\u001b[39m.\u001b[90Gccache\u001b[97Gonly\u001b[102Gshares\u001b[109Gcompiled\r\u001b[4C\u001b[1Bobjects\u001b[13Gbetween\u001b[21Gtrees\u001b[27Gunder\u001b[33G\u001b[38;2;177;185;249m~/projects\u001b[44G\u001b[39m(\u001b[38;2;177;185;249mCCACHE_BASEDIR\u001b[39m),\u001b[62Gso\u001b[65Ga\u001b[67Gworktree\u001b[76Gmade\u001b[81Gthere\u001b[87Gwould\u001b[93Gshare\u001b[99Gnothing.\r\u001b[1B \u001b[3G- Worktrunk makes a new\u001b[27Gworktre\u001b[35G for\u001b[40Geach branch an\u001b[56Gremov\u001b[62Gs it \u001b[68Gn merge.\u001b[77GEvery\u001b[83Gbranch\u001b[90Gwould\u001b[96Gstart\u001b[102Gwith\u001b[107Gempty\u001b[113Gbuild\r\u001b[4C\u001b[1Btrees:\u001b[12Gabout\u001b[18Gfive\u001b[23Gcold\u001b[28Gbuilds\u001b[35Gper\u001b[39Ggate,\u001b[45Gand\u001b[49GDebug\u001b[55Gbuilds\u001b[62Gnever\u001b[68Gshare\u001b[74Gobjects\u001b[82Gbetween\u001b[90Gtrees\u001b[96Ganyway.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposal: three permanent lanes, reused from task to task.\r\u001b[1B\u001b[22m \u001b[3G1. \u001b[1mLanes:\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[33G\u001b[39m(this checkout)\u001b[49Gplus \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[39m and \u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m, made\u001b[K\r\u001b[2C\u001b[1B   once with\u001b[16G\u001b[38;2;177;185;249mgit worktree add\u001b[39m an\u001b[37Gnever removed. A new task does \u001b[38;2;177;185;249mgit switch -c <task> main\u001b[39m inside a fre\u001b[107G lane, so that\r\u001b[2C\u001b[1B   lane's \u001b[38;2;177;185;249mbuild/\u001b[39m trees, Debug ones included,\u001b[48Gstay\u001b[53Gwarm.\u001b[59GEach\u001b[64Glane\u001b[69Gcosts\u001b[75Gabout\u001b[81G14\u001b[84GGB\u001b[87Gof\u001b[90Gdisk,\u001b[96Gand\u001b[100G281\u001b[104GGB\u001b[107Gis\u001b[110Gfree.\u001b[116GThey\r\u001b[5C\u001b[1Bsit\u001b[10Gunder\u001b[16G\u001b[38;2;177;185;249m~/projects\u001b[39m,\u001b[28Gso\u001b[31Gthe\u001b[35Gccache\u001b[42Gsharing\u001b[50Gin\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[64G\u001b[39mworks\u001b[70Gas\u001b[73Gintended.\r\u001b[1B  2. \u001b[1mHeavy work takes turns.\u001b[22m The memory note says nothing runs beside clang. RAM is the reason: with your local AI\u001b[K\r\u001b[1B     loaded (\u001b[38;2;177;185;249mstrata-host\u001b[39m), two full-width builds would thrash. So \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and a small \u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\u001b[39m\u001b[K\r\u001b[1B     wrapper share one machine-wide lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lock\u001b[39m). A second gate or build queues behind the\u001b[K\r\u001b[1B     first instead of competing with it. Reviews, editing, reading and docs need no lock. That's where the overlap pays\u001b[K\r\u001b[1B     off: the 10-minute review rounds and the gate's wait no longer leave me idle.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA lane state file:\u001b[25G\u001b[22m\u001b[38;2;177;185;249mbuild/lane.md\u001b[39G\u001b[39min\u001b[42Geach\u001b[47Glane,\u001b[53Gignored\u001b[61Gby\u001b[64Ggit,\u001b[69Gsays\u001b[74Gwhat\u001b[79Gthe\u001b[83Glane\u001b[88Gholds\u001b[94Gand\u001b[98Gwhat\u001b[103Git's\u001b[108Gwaiting\u001b[116Gon,\r\u001b[1B \u001b[3G   so I always know which\u001b[29Glane is\u001b[37Gfree.\u001b[K\r\u001b[1B  4. \u001b[1mManifest\u001b[22m gets the same three\u001b[35Glanes,\u001b[42G\u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[69G\u001b[39mand\u001b[73G\u001b[38;2;177;185;249m-c\u001b[39m,\u001b[77Geach\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gthe\u001b[103Gengine\u001b[110Glane\u001b[115Gof\u001b[118Gthe\r\u001b[5C\u001b[1Bsame\u001b[11Gname.\r\u001b[1B \u001b[3G5.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
