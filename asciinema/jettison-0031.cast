[0.101, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEach\u001b[8Gnew\u001b[12Gtest\u001b[17Gfails\u001b[23Gwhen\u001b[28Gits\u001b[32Gfix\u001b[36Gis\u001b[39Gbroken.\u001b[47GNext:\u001b[53Gthe\u001b[57Ghandshake\u001b[67Gdocs,\u001b[73Gthen\u001b[78Gtidy,\u001b[84Gformat,\u001b[92Gthe\u001b[96Gconsumer\u001b[105Gcheck\u001b[111Gand\u001b[115Ga\r\u001b[1B \u001b[3Gfresh gate before round 3.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI prefer for all the work to be based on the \u001b[38;2;177;185;249mfeature-base\u001b[38;2;255;255;255m branch rather than main. When work is merged successfully \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mand tested on \u001b[38;2;177;185;249mfeature-base\u001b[38;2;255;255;255m then\u001b[35Git is\u001b[41Ga candiate for merging into main.\u001b[75GEveryth\u001b[84Gg\u001b[86Gelse\u001b[91Gis approv\u001b[101Gd. Build it when \u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255myou'r\u001b[9G r\u001b[12Gady.\u001b[39m                                                                                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mGot\u001b[7Git:\u001b[11Glanes\u001b[17Gbranch\u001b[24Gfrom\u001b[29G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[43Gwork\u001b[48Gmerges\u001b[55Gback\u001b[60Ginto\u001b[65G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[79Gand\u001b[83Gonly\u001b[88Gwork\u001b[93Gtested\u001b[100Gthere\u001b[106Gis\u001b[109Ga\u001b[111Gcandidate\r\u001b[1B \u001b[3Gf\u001b[5Gr\u001b[7G\u001b[38;2;177;185;249mmain\u001b[39m. I'll set up the\u001b[29Glanes once J01 is committed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcmake\u001b[17G--build\u001b[25Gbuild/consumer\u001b[40G2>&1\u001b[45G|\u001b[47Grg\u001b[50G-n\u001b[53G\"error|…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cmake --build build/consumer 2>&1 | rg -n \"error|FAILED\" | head; ctest --test-dir build/consumer 2>&1 | tail -3 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m(3s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
