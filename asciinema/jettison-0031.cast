[0.414, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B1. When the client connects,\u001b[32Geach\u001b[37Gside\u001b[42Gsends\u001b[48Ga\u001b[50Gfresh\u001b[56Gone-time\u001b[65Gkey.\r\u001b[2C\u001b[1B2.\u001b[6GThe\u001b[10Gconnection's\u001b[23Gkeys\u001b[28Gcome\u001b[33Gfrom\u001b[38Gmixing\u001b[45Gthose\u001b[51Gwith\u001b[56Gthe\u001b[60Gserver's\u001b[69Glong-term\u001b[79Gkey,\u001b[84Gwhich\u001b[90Gthe\u001b[94Gclient\u001b[101Ghas\u001b[105Gpinned.\u001b[113GA\u001b[115Gclient\r\u001b[1B \u001b[3G   pin\u001b[10Ged to\u001b[16Gthe wrong\u001b[26Gkey is refused with a\u001b[48Gnew \u001b[38;2;177;185;249mKeyMismatch\u001b[39m r\u001b[66Gason\u001b[71Gbefore\u001b[78Gits\u001b[82Gtoken\u001b[88Gis\u001b[91Gever\u001b[96Gchecked.\r\u001b[2C\u001b[1B3.\u001b[6GThe\u001b[10Ghello,\u001b[17Gincluding\u001b[27Gthe\u001b[31Gtoken,\u001b[38Gis\u001b[41Gsent\u001b[46Gencrypted\u001b[56Gafter\u001b[62Gthat\u001b[67Gexchange.\u001b[77GA\u001b[79Grecorded\u001b[88Ghello\u001b[94Greplayed\u001b[103Gon\u001b[106Ga\u001b[108Gnew\r\u001b[2C\u001b[1B   connection can't be\u001b[26Gdecrypted.\r\u001b[2C\u001b[1B4.\u001b[6GIf\u001b[9Gthe\u001b[13Gserver's\u001b[22Gsecret\u001b[29Gkey\u001b[33Gis\u001b[36Gstolen\u001b[43Glater,\u001b[50Gconnections\u001b[62Grecorded\u001b[71Gbefore\u001b[78Gthat\u001b[83Gstill\u001b[89Gcan't\u001b[95Gbe\u001b[98Gread.\r\u001b[1B \u001b[3G5. Every message aft\u001b[24Gr that is encrypted and authenticated (libsodium's\u001b[75GXChaCha20-Poly1305). A packet that is\u001b[K\r\u001b[2C\u001b[1B   repl\u001b[11Gyed,\u001b[16Gmoved\u001b[22Gto\u001b[25Gthe oth\u001b[33Gr channel, altered or\u001b[55Gforged\u001b[62Gis\u001b[65Grejected.\r\u001b[2C\u001b[2B\u001b[1mWhat's new in \u001b[18Ghe API:\u001b[22m \u001b[38;2;177;185;249mNet::GenerateServerKey()\u001b[51G\u001b[39mand\u001b[55G\u001b[38;2;177;185;249mNet::PublicKeyOf()\u001b[74G\u001b[39min\u001b[77G\u001b[38;2;177;185;249mnet/Key.h\u001b[39m,\u001b[88G\u001b[38;2;177;185;249mServerConfig::secretKey\u001b[39m,\u001b[113Gand\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mClientConfig::serverKey\u001b[39m. Keys \u001b[34Gre\u001b[37G64 hex char\u001b[49Gcter\u001b[54G,\u001b[56Glike tokens. Most\u001b[74Gof\u001b[77Gthe\u001b[81Gcode\u001b[86Gis\u001b[89Gin\u001b[92Gthe\u001b[96Ginternal\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mnet/src/Seal.h/.cpp\u001b[39m, and\u001b[28G\u001b[38;2;177;185;249mWire\u001b[39m, \u001b[38;2;177;185;249mServer\u001b[39m a\u001b[43Gd\u001b[45G\u001b[38;2;177;185;249mClient\u001b[39m use\u001b[56Git.\u001b[60G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe \u001b[38;2;177;185;249mnet\u001b[39m suite (11 cases) and the consumer check pass. The new cases cover a cli\u001b[90Gnt with th\u001b[101G wrong\u001b[108Gk\u001b[110Gy,\u001b[113Gand\r\u001b[2C\u001b[1Breplayed, altered, misrouted an\u001b[35G late\u001b[41Gpackets.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDocs:\u001b[22m networking, decisions\u001b[31Gand s\u001b[37Gope are upd\u001b[49Gted, and J01\u001b[62Gis recorded in \u001b[78Gistory and removed from the roadmap.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimits:\r\u001b[2C\u001b[1B\u001b[22m- ENet's own packet headers aren't encrypted\u001b[75Gh\u001b[77Gcan cut a connection or fake the reason\u001b[117Git\u001b[27;1H\u001b[24;3H\u001b[?25h"]
