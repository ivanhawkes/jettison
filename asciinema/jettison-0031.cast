[0.170, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m5\u001b[11G\u001b[22m  \u001b[38;2;166;226;46mcrypto_generichash\u001b[39m(\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22m   \u001b[15G  \u001b[38;2;166;226;46mBytes\u001b[39m(mixed), mixed.\u001b[38;2;166;226;46msize\u001b[39m(), \u001b[38;2;166;226;46mBytes\u001b[39m(fixed),\u001b[59Gfixed.\u001b[38;2;166;226;46msize\u001b[39m(),\u001b[73G\u001b[38;2;166;226;46mBytes\u001b[39m(ephemeral),\u001b[91Gephemeral.\u001b[38;2;166;226;46msize\u001b[39m());\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEach new\u001b[12Gtest\u001b[17Gfails when\u001b[28Gits\u001b[32Gfix\u001b[36Gis\u001b[39Gbroken.\u001b[47GNext:\u001b[53Gthe\u001b[57Ghandshake\u001b[67Gdocs,\u001b[73Gthen\u001b[78Gtidy,\u001b[84Gformat,\u001b[92Gthe\u001b[96Gconsumer\u001b[105Gcheck\u001b[111Gand\u001b[115Ga\r\u001b[2C\u001b[1Bfresh gate before round 3.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI prefer for all the work to be based on the \u001b[38;2;177;185;249mfeature-base\u001b[38;2;255;255;255m branch rather than main. When work is merged successfully \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mand tested on \u001b[38;2;177;185;249mfeature-base\u001b[38;2;255;255;255m then it is a candiate for merging into main. Everything else is approved. Build it when \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255myou're ready.\u001b[39m                                                                                                         \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mGot it: lanes\u001b[17Gbranch\u001b[24Gfrom\u001b[29G\u001b[38;2