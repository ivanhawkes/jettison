[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mClientConfig::serverKey\u001b[39m. Keys \u001b[34Gre\u001b[37G64 hex char\u001b[49Gcter\u001b[54G,\u001b[56Glike tokens. Most\u001b[74Gof\u001b[77Gthe\u001b[81Gcode\u001b[86Gis\u001b[89Gin\u001b[92Gthe\u001b[96Ginternal\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mnet/src/Seal.h/.cpp\u001b[39m, and\u001b[28G\u001b[38;2;177;185;249mWire\u001b[39m, \u001b[38;2;177;185;249mServer\u001b[39m a\u001b[43Gd\u001b[45G\u001b[38;2;177;185;249mClient\u001b[39m use\u001b[56Git.\u001b[60G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe \u001b[38;2;177;185;249mnet\u001b[39m suite (11 cases) and the consumer check pass. The new cases cover a cli\u001b[90Gnt with th\u001b[101G wrong\u001b[108Gk\u001b[110Gy,\u001b[113Gand\r\u001b[2C\u001b[1Breplayed, altered, misrouted an\u001b[35G late\u001b[41Gpackets.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDocs:\u001b[22m networking, decisions\u001b[31Gand s\u001b[37Gope are upd\u001b[49Gted, and J01\u001b[62Gis recorded in \u001b[78Gistory and removed from the roadmap.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimits:\r\u001b[2C\u001b[1B\u001b[22m- ENet's own packet headers aren't encrypted. Someone on the network path\u001b[77Gcan cut a connection or fake the reason\u001b[117Git\r\u001b[2C\u001b[1B  closed, but can't read\u001b[28Gor forg\u001b[37Ga message.\u001b[K\r\u001b[2C\u001b[1B- Changing the server's key means updating every\u001b[52Gclien\u001b[58G's\u001b[61Gconfig.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcheck\u001b[15Ga\u001b[17Gclient\u001b[24Gmakes\u001b[30Gagainst\u001b[38Ga\u001b[40Gfake\u001b[45Gserver\u001b[52Gthat\u001b[57Ganswers\u001b[65Gbut\u001b[69Gdoesn't\u001b[77Ghold\u001b[82Gthe\u001b[86Gkey\u001b[90Ghas\u001b[94Gno\u001b[97Gtest;\u001b[103Gthat\u001b[108Gwould\u001b[114Gneed\u001b[119Ga\r\u001b[2C\u001b[1B  hand-written\u001b[18Gfake server.\u001b[K\r\u001b[2C\u001b[1B- Manifest's docs st\u001b[24Gll link\u001b[32Gto the roadmap'\u001b[48G J01\u001b[53Gsection,\u001b[62Gwhich\u001b[68Gis\u001b[71Gnow\u001b[75Ggone.\u001b[81GI'll\u001b[86Gfix\u001b[90Gthose\u001b[96Glinks\u001b[102Gwhen\u001b[107GManifest\r\u001b[4C\u001b[1Badopts\u001b[12Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest's side, not started.\u001b[33G\u001b[22mWith\u001b[38Gthe\u001b[42Gengine\u001b[49Gchange\u001b[56Galone,\u001b[63GManifest's\u001b[74Gserver\u001b[81Gwould\u001b[87Grefuse\u001b[94Gto\u001b[97Gstart\u001b[103Gbecause\u001b[111Git\u001b[114Ghas\u001b[118Gno\r\u001b[2C\u001b[1Bkey. My\u001b[11Gproposal:\r\u001b[4C\u001b[1BA \u001b[38;2;177;185;249mmanifest-token key\u001b[39m command writ\u001b[39Gs the se\u001b[75Gte file next to the tokens file and prints \u001b[119Ghe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
