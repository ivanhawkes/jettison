mputed\u001b[106Gover\u001b[111Gthe\r\u001b[1B \u001b[3Gciphert\u001b[11Gxt. Wri\u001b[20Gng\u001b[23Gthe round 2 fixes \u001b[42Gow.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m            \u001b[27;1H\u001b[24;89H\u001b[?25h"]
