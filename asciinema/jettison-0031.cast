[0.128, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242me client also closes so when \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mserver's proof, or its \u001b[48;2;2;40;0mwelcome\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m does not open\u001b[48;2;4;71;0m:\u001b[48;2;2;40;0m a server that does not \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242mhold the key it pinned. |                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 45 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 46 \u001b[22m ## How it works\u001b[K\r\u001b[6C\u001b[1B\u001b[2m47\u001b[13G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/net/include/jettison/net/Client.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 19 \u001b[22m   \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46muint16_t\u001b[39m port{};\u001b[K\r\u001b[1B     \u001b[2m 20 \u001b[22m \u001b[12G Protocol protocol;\u001b[K\r\u001b[6C\u001b[1B\u001b[2m21 \u001b[11G\u001b[22m  \u001b[38;2;117;113;94m// The server's public key (Key.h), pinned: a server that cannot open the hello sealed to it\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 22 -\u001b[38;2;248;248;242m  // refuses as KeyMismatch, and a welcome not sealed by its holder closes the client so\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 22 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// refuses as KeyMismatch, and \u001b[48;2;4;71;0man offer or \u001b[48;2;2;40;0ma welcome not sealed by its holder closes the client so\u001b[48;2;4;71;0m,\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 23 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// before the credential is sent.\u001b[38;2;248;248;242m                                                                    \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m24 \u001b[22m \u001b[12G \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46mstring\u001b[39m serverKey;\u001b[K\r\u001b[6C\u001b[1B\u001b[2m25 \u001b[22m   \u001b[38;2;117;113;94m// Opaque to the engine: what the server's verifier is given, sealed.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m26 \u001b[11G\u001b[22m  \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46mvector\u001b[39m<\u001b[38;2;166;226;46mstd\u001b[39m::byte> c\u001b[38Gedential;\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(bui\u001b[13Gd/reviews/j01-reply-3.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m12\u001b[22m lines\u001b[21Gto\u001b[24G\u001b[1mbuild/reviews/j01-reply\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.304, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/networking.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22m| `InboundOverflow`\u001b[31G|\u001b[33GA\u001b[35Gmessage\u001b[43Garrived\u001b[51Gwhile\u001b[57G`maxInbound`\u001b[70Gwere\u001b[75Galready\u001b[83Gwaiting\u001b[91Gfor\u001b[95Gthe\u001b[99Ggame.\u001b[105G|\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m|\u001b[13G`Revoked`\u001b[23G|\u001b[25GThe\u001b[29Ggame\u001b[34Gclosed\u001b[41Gthe\u001b[45Gsession\u001b[53Gbecause\u001b[61Gits\u001b[65Gcredential\u001b[76Gwas\u001b[80Gwithdrawn.\u001b[91G|\r\u001b[5C\u001b[1B\u001b[2m 43 \u001b[11G\u001b[22m|\u001b[13G`Shutdown`\u001b[24G|\u001b[26GThe\u001b[30Ggame\u001b[35Gclosed\u001b[42Gthe\u001b[46Gsession,\u001b[55Gor\u001b[58Gdestroyed\u001b[68Gthe\u001b[72Gserver,\u001b[80Gbecause\u001b[88Gthe\u001b[92Gserver\u001b[99Gis\u001b[102Gstopping.\u001b[112G|\r\u001b[1B \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 44 -\u001b[38;2;248;248;242m| `KeyMismatch` | The client's hello was not sealed to the server's key: it pinned another server's. Th\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242me client also closes so when \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m welcome does not open\u001b[48;2;92;2;0m,\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfrom \u001b[48;2;61;1;0ma server that does not hold the key it pinne\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m    -\u001b[38;2;248;248;242md. |                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 44 +\u001b[38;2;248;248;242m| `KeyMismatch` | The client's hello was not sealed to the server's key: it pinned another server's. Th\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242me client also closes so when \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mserver's proof, or its \u001b[48;2;2;40;0mwelcome\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m does not open\u001b[48;2;4;71;0m:\u001b[48;2;2;40;0m a server that does not \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242mhold the key it pinned. |                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 45 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 46 \u001b[22m ## How it works\u001b[K\r\u001b[6C\u001b[1B\u001b[2m47\u001b[13G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/net/include/jettison/net/Client.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 19 \u001b[22m   \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46muint16_t\u001b[39m port{};\u001b[K\r\u001b[1B     \u001b[2m 20 \u001b[22m \u001b[12G Protocol protocol;                \u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.339, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 141 +\u001b[38;2;248;248;242moffer. Each end counts what it sends over both channels, and accepts on each channel only a counter   \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 142 +\u001b[38;2;248;248;242mabove the last it opened there, so a packet replayed, moved to the other channel, damaged or forged   \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 143 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mis not opened. One that does not open closes an \u001b[48;2;2;40;0madmitted session on the server (`BadMessage`) and is  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 144 +\u001b[38;2;248;248;242mdropped by a client. The largest counter is sealed once and then nothing more is, so neither count    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 145 +\u001b[38;2;248;248;242mwraps round to a nonce already used.                                                                  \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m146 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 147 \u001b[22m ENet's own headers, its sequence numbers, acknowledgements and closings, are not sealed. Someone\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 148 \u001b[22m on the path can therefore close a connection, and the reason a closing gives is not proved to be\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/networking.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22m| `InboundOverflow`\u001b[31G|\u001b[33GA\u001b[35Gmessage\u001b[43Garrived\u001b[51Gwhile\u001b[57G`maxInbound`\u001b[70Gwere\u001b[75Galready\u001b[83Gwaiting\u001b[91Gfor\u001b[95Gthe\u001b[99Ggame.\u001b[105G|\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m|\u001b[13G`Revoked`\u001b[23G|\u001b[25GThe\u001b[29Ggame\u001b[34Gclosed\u001b[41Gthe\u001b[45Gsession\u001b[53Gbecause\u001b[61Gits\u001b[65Gcredential\u001b[76Gwas\u001b[80Gwithdrawn.\u001b[91G|\r\u001b[5C\u001b[1B\u001b[2m 43 \u001b[11G\u001b[22m|\u001b[13G`Shutdown`\u001b[24G|\u001b[26GThe\u001b[30Ggame\u001b[35Gclosed\u001b[42Gthe\u001b[46Gsession,\u001b[55Gor\u001b[58Gdestroyed\u001b[68Gthe\u001b[72Gserver,\u001b[80Gbecause\u001b[88Gthe\u001b[92Gserver\u001b[99Gis\u001b[102Gstopping.\u001b[112G|\r\u001b[1B \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 44 -\u001b[38;2;248;248;242m| `KeyMismatch` | The client's hello was not sealed to the server's key: it pinned another server's. Th\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242me client also closes so when \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m welcome does not open\u001b[48;2;92;2;0m,\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfrom \u001b[48;2;61;1;0ma server that does not hold the key it pinne\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m    -\u001b[38;2;248;248;242md. |                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 44 +\u001b[38;2;248;248;242m| `KeyMismatch` | The client's hello\u001b[76G's key: it pinned another server's. Th\u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.189, "o", "\u001b]0;◐ jettison-0031\u0007"]
[0.118, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 137 \u001b[22m eight bytes little-endian, then the message under XChaCha20-Poly1305 with the counter as its nonce\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 138 \u001b[22m and the channel as additional data, 24 bytes more than the message. Only the two offers go\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 139 -\u001b[38;2;248;248;242munsealed, each a kind and a 32-byte key. Each end counts what it sends over both channels, and        \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 140 -\u001b[38;2;248;248;242maccepts on each channel only a counter above the last it opened there, so a packet replayed,          \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 141 -\u001b[38;2;248;248;242mmoved to the other channel, damaged or forged is not opened. The largest counter is never used,       \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 142 -\u001b[38;2;248;248;242mso neither count can wrap round: an end that has sealed every other one sends nothing more. One that d\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m     -\u001b[38;2;248;248;242moes not open closes an                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 143 -\u001b[38;2;248;248;242madmitted session on the server (`BadMessage`) and is\u001b[48;2;92;2;0m dropped by a client.\u001b[48;2;61;1;0m                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 139 +\u001b[38;2;248;248;242munsealed, each a kind and a 32-byte key. The server's is followed by its proof, a sealed message of   \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 140 +\u001b[38;2;248;248;242mthe offer's kind with no body, on the reliable channel at counter 0: 26 bytes, 60 for the whole       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 141 +\u001b[38;2;248;248;242moffer. Each end counts what it sends over both channels, and accepts on each channel only a counter   \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 142 +\u001b[38;2;248;248;242mabove the last it opened there, so a packet replayed, moved to the other channel, damaged or forged   \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 143 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mis not opened. One that does not open closes an \u001b[48;2;2;40;0madmitted session on the server (`BadMessage`) and is  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 144 +\u001b[38;2;248;248;242mdropped by a client. The largest counter is sealed once and then nothing more is, so neither count    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 145 +\u001b[38;2;248;248;242mwraps round to a nonce already used.                                                                  \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m146 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 147 \u001b[22m ENet's own headers, its sequence numbers, acknowledgements and closings, are not sealed. Someone\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 148 \u001b[22m on the path can therefore close a connection, and the reason a closing gives is not proved to be\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m                     \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.390, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;107;128m●\u001b[3G\u001b[39mBackground command \"Run cross-review round 3\" failed\u001b[56Gwith exit code 1\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound 3 has a single finding, F7: the wire section of the networking doc still describes the old offers and the\u001b[115Gold\r\u001b[2C\u001b[1Blast-counter rule. Every earlier finding is marked resolved. Fixing F7.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/networking.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m7\u001b[22m lines, removed \u001b[1m5\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 136 \u001b[22m step it was taken at, eight bytes little-endian. Every message is sealed: the packet is a counter,\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 137 \u001b[22m eight bytes little-endian, then the message under XChaCha20-Poly1305 with the counter as its nonce\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 138 \u001b[22m and the channel as additional data, 24 bytes more than the message. Only the two offers go\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 139 -\u001b[38;2;248;248;242munsealed, each a kind and a 32-byte key. Each end counts what it sends over both channels, and        \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 140 -\u001b[38;2;248;248;242maccepts on each channel only a counter above the last it opened there, so a packet replayed,          \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 141 -\u001b[38;2;248;248;242mmoved to the other channel, damaged or forged is not opened. The largest counter is never used,       \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 142 -\u001b[38;2;248;248;242mso neither count can wrap round: an end that has sealed every other one sends nothing more. One that d\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m     -\u001b[38;2;248;248;242moes not open closes an                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 143 -\u001b[38;2;248;248;242madmitted session on the server (`BadMessage`) and is\u001b[48;2;92;2;0m dropped by a client.\u001b[48;2;61;1;0m                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 139 +\u001b[38;2;248;248;242munsealed, each a kind and a 32-byte key. The server's is followed by its proof, a sealed message of   \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 140 +\u001b[38;2;248;248;242mthe offer's kind with no body, on t\u001b[76Gr 0: 26 bytes, 60 for the whole       \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
