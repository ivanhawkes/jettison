[0.452, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m     \u001b[22m lock noise |\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 740 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m4\u001b[12G\u001b[38;2;248;248;242m##\u001b[15GLanes\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m \u001b[14G       \u001b[22G   \u001b[26G    \u001b[31G   \u001b[35G         \u001b[45G \u001b[47G    \u001b[52G  \u001b[55G     \u001b[61G        \u001b[70G \u001b[72G    \u001b[77G      \u001b[84G  \u001b[87G \u001b[89G    \u001b[94G    \u001b[99G    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mThree work\u001b[23Grees of each\u001b[36Gr\u001b[38Gpository, kept from\u001b[58Gt\u001b[60Gsk to task, so tha\u001b[79G one can\u001b[88Gwait on the gate or a\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mcross-review while work goes\u001b[41Gon in another, and a third is there for a spare hour:                    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[14G\u001b[38;2;248;248;242m   \u001b[18G        \u001b[27G       \u001b[35G \u001b[37G    \u001b[42G    \u001b[47G  \u001b[50G      \u001b[57G    \u001b[62G    \u001b[67G      \u001b[74G        \u001b[83G              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m|\u001b[14GLane | J\u001b[23Gttison | Manifest |  \u001b[45G              \u001b[60G   \u001b[64G      \u001b[71G    \u001b[76G    \u001b[81G   \u001b[85G    \u001b[90G    \u001b[95G   \u001b[99G    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m|\u001b[14G--- | --- | --- |\u001b[32G     \u001b[38G  \u001b[41G \u001b[43G         \u001b[53G   \u001b[57G       \u001b[65G \u001b[67G      \u001b[74G   \u001b[78G  \u001b[81G       \u001b[89G   \u001b[93G  \u001b[96G   \u001b[100G    \u001b[105G  \u001b[108G \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m|\u001b[14GA | `~/proj\u001b[26Gc\u001b[28Gs/jettison` | `~/projects/manifest` |  \u001b[68G     \u001b[74G    \u001b[79G   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m|\u001b[14GB | `~/projects/jettison.lane-b` | `~/projec\u001b[59Gs/manifest.lane-b` | \u001b[81G  \u001b[84G \u001b[86G    \u001b[91G      \u001b[98G   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m|\u001b[14GC | `~/project\u001b[29G/jettison.lane-c` | `~/projects/manifes\u001b[69G.lane-c` |                       \u001b[103G     \u001b[109G   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;248;248;242m        \u001b[23G  \u001b[26G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[16G\u001b[38;2;248;248;242mK\u001b[18Gpt,\u001b[22Gn\u001b[24Gt made per branch.** A lane is never re\u001b[64Gove\u001b[68G: a ta\u001b[75Gk starts in a free\u001b[94Glane with   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;248;248;242m`git switch -c <\u001b[31Gask> fea\u001b[40Gu\u001b[42Ge-base`, so the lane's build trees stay\u001b[82Gwarm, Debug ones included, \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;248;248;242mwhich cca\u001b[24Ghe shares within a tree \u001b[49Gnly ([\u001b[38;2;230;219;116mcompiler cache\u001b[38;2;248;248;242m](#compiler-cache)). A switch rebuilds what  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;248;248;242mt\u001b[16Ge branc\u001b[25Gs change. A free lane\u001b[47Gis parked with `git switch --detach feature-base`.                 \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m-\u001b[14G**Branches.**\u001b[28GWork\u001b[33Gis\u001b[36Gcut from `f\u001b[48Gatur\u001b[53G-base` and mer\u001b[68Ged back into it;\u001b[85Gonly\u001b[90Gwhat\u001b[95Ghas\u001b[99Gbeen\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gmerged\u001b[22Gnd t\u001b[27Gsted there is a candidate\u001b[53Gfor `main`. A\u001b[67Gbranch c\u001b[76Gn\u001b[78Gbe checked out in\u001b[96Gone lane at a\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[14G\u001b[38;2;248;248;242mtime, so\u001b[23G`feature-base`\u001b[38Gitself\u001b[45Gis\u001b[76Gto\u001b[79Git.\u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
