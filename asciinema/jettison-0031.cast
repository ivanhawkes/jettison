[0.129, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mReview prompt:\u001b[18G\u001b[22mit\u001b[21Gnow\u001b[25Gsays\u001b[30Gthe\u001b[34Gengine\u001b[41Gis\u001b[44Ga\u001b[46Gsolo\u001b[51Gdeveloper's\u001b[63Gsimulation\u001b[74Ggame\u001b[79Gand\u001b[83Gasks\u001b[88Gfor\u001b[92Gthoroughness\u001b[105Gevery\u001b[111Ground.\u001b[118GIt\r\u001b[2C\u001b[1Breads all touched\u001b[21Gfile\u001b[26G in\u001b[30Gfull, chases repeated mistak\u001b[59Gs, re-reviews the whole\u001b[83Gchange eac\u001b[94G \u001b[98Gnd and\u001b[105Gholds\u001b[111Gn\u001b[113Gthing\u001b[K\r\u001b[2C\u001b[1Bback.\u001b[9GThe\u001b[13GJ01-only wording\u001b[30Gis reverted.\u001b[43G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLanes\u001b[9G\u001b[22m(committed\u001b[20Gin\u001b[23Gboth\u001b[28Grepositories,\u001b[42G\u001b[38;2;177;185;249m4b2707d\u001b[50G\u001b[39mand\u001b[54GManifest's\u001b[65G\u001b[38;2;177;185;249m723e8d5\u001b[39m):\r\u001b[2C\u001b[1B- \u001b[1mWorktrees:\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[39m and \u001b[38;2;177;185;249m.lane-c\u001b[39m, plus \u001b[38;2;177;185;249mmanifest.lane-b\u001b[77G\u001b[39mand\u001b[81G\u001b[38;2;177;185;249m.lane-c\u001b[39m,\u001b[90Gkept\u001b[95Gbetween\u001b[103Gtasks.\u001b[110GA\u001b[112Gtask\r\u001b[2C\u001b[1B \u001b[5Gstarts with \u001b[38;2;177;185;249mgit swi\u001b[25Gch -c <task> f\u001b[40Gature-base\u001b[39m and merges back into \u001b[38;2;177;185;249mf\u001b[74Gature-base\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mShared lock:\u001b[22m \u001b[38;2;177;185;249mscripts/\u001b[27Geavy.sh\u001b[39m holds one lock for both repositories, and \u001b[38;2;177;185;249mci.sh\u001b[39m takes\u001b[89Git\u001b[92Gitself,\u001b[100Gso\u001b[103Gbuilds\u001b[110Gand\u001b[114Ggates\r\u001b[2C\u001b[1B \u001b[5Gtake turns. A second command did wait behind\u001b[50Gthe\u001b[54Gfirst, and a nested one didn'\u001b[84G d\u001b[87Gadlock. The reviewer is told \u001b[117Go\u001b[K\r\u001b[4C\u001b[1Bbuild through\u001b[19Git.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReview base:\u001b[22m \u001b[38;2;177;185;249mcross-review.sh\u001b[34G\u001b[39mnow\u001b[38Gcompares\u001b[47Gagainst\u001b[55G\u001b[38;2;177;185;249mfeature-base\u001b[68G\u001b[39mby\u001b[71Gdefault.\r\u001b[4C\u001b[1B\u001b[1mWorktrunk path:\u001b[22m I changed it\u001b[34Gin your dotfiles (\u001b[38;2;177;185;249m~/.dotfil\u001b[62Gs/.config/worktrunk/config.toml\u001b[39m)\u001b[95Gto\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/projects/<repo>.<branch>\u001b[39m, so any work\u001b[45Gree it makes shares ccache.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWarm builds:\u001b[22m engine lanes B\u001b[33Gand C each ran a full cold gate\u001b[65Gand both\u001b[74Gpassed,\u001b[82Gin\u001b[85Gabout\u001b[91G18\u001b[94Gminutes\u001b[102Geach,\u001b[108Gso\u001b[111Gtheir\r\u001b[2C\u001b[1B \u001b[5Gbuild trees are warm. Manifest's lanes\u001b[44Gare\u001b[48Gparked\u001b[55Gon \u001b[38;2;177;185;249mfeature-base\u001b[39m but not built, s\u001b[88G \u001b[90Gheir first build will b\u001b[114G cold.\u001b[27;1H\u001b[24;64H\u001b[?25h"]
