[0.151, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mProposal: three permanent lanes, reused from task to task.\u001b[62G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mLanes:\u001b[13G\u001b[22m\u001b[38;2;177;185;249m~/projects/jettison\u001b[33G\u001b[39m(this\u001b[39Gcheckout)\u001b[49Gplus\u001b[54G\u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B   once with \u001b[38;2;177;185;249mgit worktree add\u001b[39m and never removed. A new task\u001b[63Gdoes\u001b[68G\u001b[38;2;177;185;249mgit switch -c <task> main\u001b[94G\u001b[39minside\u001b[101Ga\u001b[103Gfree\u001b[108Glane,\u001b[114Gso\u001b[117Gthat\r\u001b[2C\u001b[1B  \u001b[6Glane's\u001b[13G\u001b[38;2;177;185;249mbuild/\u001b[39m trees, Debug\u001b[33Gones included, stay warm. Each lane costs about\u001b[81G14 GB of disk, and 281 GB is free. They\r\u001b[5C\u001b[1Bsit under\u001b[16G\u001b[38;2;177;185;249m~/projec\u001b[25Gs\u001b[39m, so the ccach\u001b[41G sharing in \u001b[38;2;177;185;249mdevenv.nix\u001b[39m works as intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The m\u001b[36Gmory not\u001b[45G says nothing\u001b[59Gruns\u001b[64Gbeside clang. RAM is the rea\u001b[93Gon: with your\u001b[107Glocal AI\u001b[116G\u001b[K\r\u001b[5C\u001b[1Bloaded (\u001b[38;2;177;185;249mstrata-hos\u001b[25G\u001b[39m)\u001b[28Gtwo full-width builds\u001b[50Gwould thrash.\u001b[64GS\u001b[66G \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and\u001b[85Ga\u001b[87Gsmall\u001b[93G\u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gwrapper share one machine-wid\u001b[36G lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lock\u001b[39m). A\u001b[82Gsecond\u001b[89Ggate or\u001b[97Gbuild q\u001b[105Geues behind\u001b[117Gthe\r\u001b[5C\u001b[1Bfirst instead of compe\u001b[29Ging with \u001b[39Gt. Rev\u001b[46Gew\u001b[49G, editing, reading and docs need \u001b[83Go\u001b[85Glock. That's where the overlap\u001b[116Gpays\r\u001b[5C\u001b[1Boff: the 10-minute rev\u001b[29Gew rounds and the gate's wait no longer leave me idle.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA lane state file:\u001b[22m \u001b[38;2;177;185;249mbuild/lane.md\u001b[39m in\u001b[42Geach lane, \u001b[54Ggnored by git, says what the lane holds and\u001b[100Gat i\u001b[105G's\u001b[108Gwaiting\u001b[116Gon,\u001b[K\r\u001b[5C\u001b[1Bso I\u001b[11Galways know which lane is free.\u001b[43G\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mManif\u001b[12Gst\u001b[22m gets the same three lanes,\u001b[42G\u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[69G\u001b[39mand \u001b[38;2;177;185;249m-c\u001b[39m, eac\u001b[81G building agai\u001b[96Gst the\u001b[103Gengine lane of the\r\u001b[6C\u001b[1Bame\u001b[11Gname.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mDocs:\u001b[22m a \"Lanes\" section in \u001b[38;2;177;185;249mbuild-and-gates.md\u001b[39m, a pointer in \u001b[38;2;177;185;249mAGENTS.md\u001b[77G\u001b[39mand the worktrunk \u001b[38;2;177;185;249mworktree-path\u001b[39m ch\u001b[113Gged to\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249m~/projects/{{ repo }}.{{ branch }}\u001b[41G\u001b[39mfor\u001b[45Ganything\u001b[54Gstill\u001b[60Gmade\u001b[65Gwith\u001b[70G\u001b[38;2;177;185;249mwt\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaveats:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSwitching\u001b[15Gbranches\u001b[24Ginside\u001b[31Ga\u001b[33Glane\u001b[38Grebuilds\u001b[47Gwhatever\u001b[56Gthe\u001b[60Gbranch\u001b[67Gchanged.\u001b[76GThat's\u001b[83Gordinary\u001b[92Gincremental\u001b[104Gwork,\u001b[110Gand\u001b[114Gmuch\r\u001b[2C\u001b[1B  less than\u001b[15Ga\u001b[17Gcold\u001b[22Gtree.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.250, "o", "\u001b[?25l\u001b[H\u001b[3G1. \u001b[1mLanes\u001b[12G\u001b[22m \u001b[38;2;177;185;249m~/projects/jettison\u001b[39m (this checkout) plus \u001b[38;2;177;185;249m~/projects/jettison.lane-b\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249m~/projects/jettison.lane-c\u001b[39m,\u001b[113Gmade\r\u001b[2C\u001b[1B  \u001b[6Gonce with \u001b[38;2;177;185;249mgit worktree add\u001b[33G\u001b[39mand never removed. A\u001b[54Gnew task does \u001b[38;2;177;185;249mg\u001b[70Gt switch -c <task> main\u001b[39m inside a free lane, so that\r\u001b[5C\u001b[1Blan\u001b[10G's \u001b[38;2;177;185;249mbuild/\u001b[39m trees, Debug\u001b[33Go\u001b[35Ges includ\u001b[45Gd, stay warm. Each lane costs about 14 GB of disk, an\u001b[99G 281 GB is free. They\u001b[K\r\u001b[5C\u001b[1Bsit under \u001b[38;2;177;185;249m~/projects\u001b[39m, so the ccache sharing in\u001b[53G\u001b[38;2;177;185;249mdevenv.nix\u001b[64G\u001b[39mworks a\u001b[72G intended.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mHeavy work takes turns.\u001b[22m The memory note says \u001b[52Gothing runs\u001b[64Gbeside cla\u001b[75Gg. RAM is\u001b[85Gthe\u001b[89Greason:\u001b[97Gwith\u001b[102Gyour\u001b[107Glocal\u001b[113GAI\r\u001b[2C\u001b[1B  \u001b[6Gloaded (\u001b[38;2;177;185;249mstrata-host\u001b[39m), two full-width builds would thrash.\u001b[64GSo \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m and\u001b[85Ga small \u001b[38;2;177;185;249mscripts/heavy.sh <cmd>\r\u001b[5C\u001b[1B\u001b[39mwr\u001b[9Gpper share one machine-wide lock (\u001b[38;2;177;185;249mflock ~/.cache/jettison/heavy.lo\u001b[76Gk\u001b[39m). A second gate or build queues behind\u001b[117Gthe\r\u001b[5C\u001b[1Bfirst in\u001b[15Gtead\u001b[21Gf competing with it.\u001b[42GReviews, editing, reading and docs need\u001b[82Gno lock. That's where the overlap pays\r\u001b[5C\u001b[1Boff: the 10-minute review rounds and the gate's wait no longer leave me idle.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA lane state file:\u001b[25G\u001b[22m\u001b[38;2;177;185;249mbuild/lane.md\u001b[39G\u001b[39mi\u001b[41G each\u001b[47Gl\u001b[49Gn\u001b[51G, ignored by git,\u001b[69Gsays what th\u001b[82G lane\u001b[88Gholds\u001b[94Gand\u001b[98Gwhat\u001b[103Git's\u001b[108Gwaiting\u001b[116Gon,\r\u001b[2C\u001b[1B  \u001b[6Gso I always know which lane is free.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mManifest\u001b[22m gets the same\u001b[29Gthr\u001b[33Ge lanes, \u001b[38;2;177;185;249m~/projects/manifest.lane-b\u001b[69G\u001b[39mand\u001b[73G\u001b[38;2;177;185;249m-c\u001b[39m,\u001b[77Geach\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gthe\u001b[103Gengine\u001b[110Glane\u001b[115Gof\u001b[118Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsame name.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mDocs:\u001b[22m \u001b[13G \"Lanes\"\u001b[22Gsection\u001b[30Gin\u001b[33G\u001b[38;2;177;185;249mbuild-and-gates.md\u001b[39m,\u001b[53Ga\u001b[55Gpointer\u001b[63Gin\u001b[66G\u001b[38;2;177;185;249mAGENTS.md\u001b[39m,\u001b[77Gand\u001b[81Gthe\u001b[85Gworktrunk\u001b[95G\u001b[38;2;177;185;249mworktree-path\u001b[109G\u001b[39mchanged\u001b[117Gto\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249m~/projects/{{ repo }}.{{ branch }}\u001b[39m for anything still made with \u001b[38;2;177;185;249mwt\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaveats:\r\u001b[2C\u001b[1B\u001b[22m- Switching\u001b[15Gbranches\u001b[24Ginside\u001b[31Ga\u001b[33Glane\u001b[38Grebuilds\u001b[47Gwhatever\u001b[56Gthe\u001b[60Gbranch\u001b[67Gchanged.\u001b[76GThat's\u001b[83Gordinary\u001b[92Gincremental\u001b[104Gwork,\u001b[110Gand\u001b[114Gmuch\r\u001b[2C\u001b[1B \u001b[5Gless than\u001b[15Ga cold tree.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe first\u001b[15Ggate in each\u001b[28Gnew\u001b[32Glane\u001b[37Gis\u001b[40Gcold\u001b[45Gonce:\u001b[51Gabout\u001b[57G5–10\u001b[62Gminutes,\u001b[71Gwith\u001b[76GRelease\u001b[84Gsharing\u001b[92Gccache\u001b[99Gwith\u001b[104Gthe\u001b[108Gother\u001b[114Gtrees.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
