[0.111, "o", "\u001b[?25l\u001b[H     \u001b[2m 172 \u001b[12G\u001b[22m### Gating besi\u001b[28Ge the work\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22mOn\u001b[15GLythir\u001b[22Ga\u001b[24Gcommit\u001b[31Gcan\u001b[35Galso\u001b[40Gbe\u001b[43Ggated\u001b[49Gin\u001b[52Ga\u001b[54Gsecond\u001b[61Gcheckout\u001b[70Gof\u001b[73Gits\u001b[77Gown\u001b[81Glane,\u001b[87Gso\u001b[90Gthe\u001b[94Gnext\u001b[99Gchange\u001b[106Gcan\u001b[110Gbe\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 175 -\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,\u001b[48;2;92;2;0m made o\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m   \u001b[12G\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mnce with\u001b[48;2;61;1;0m     \u001b[26G   \u001b[30G    \u001b[35G     \u001b[41G                 \u001b[59G  \u001b[62G \u001b[64G        \u001b[73G        \u001b[82G    \u001b[87G   \u001b[91G   \u001b[95G     \u001b[101G             \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m176\u001b[12G\u001b[38;2;248;248;242m`git worktree\u001b[26Gadd\u001b[30G--detach\u001b[39Gbuild/gate-tree\u001b[55G<commit>`.\u001b[66GFor\u001b[70Geach\u001b[75Gcommit\u001b[82Ggated,\u001b[89Grun\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 175 +\u001b[38;2;248;248;242mwritten while the gate runs. `build/gate-tree` is a detached worktree with its own build trees,       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mmade once with \u001b[48;2;2;40;0m`git worktree\u001b[41Gadd --detach build/gate-tree <commit>`. For each c\u001b[92Gmmit gated, run\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 177 \u001b[22m `git -C build/gate-tree checkout --detach <commit>`, then `build/gate-tree/scripts/ci.sh` with the\u001b[K\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22mgate's opt\u001b[23Gons. While it runs nothing else builds, runs tests or runs clang-tidy (the user's rule,\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m2026-11-21), \u001b[26Go\u001b[28Gt\u001b[30Ge work\u001b[37Gbeside it is\u001b[51Gditing alone. A failure is fixed by a later commit, befor\u001b[109G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands, recalled \u001b[1m2\u001b[22m memories, wrote \u001b[1m2\u001b[22m memories \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gpasses\u001b[19Gwith\u001b[24Gthe\u001b[28Glock\u001b[33Gin\u001b[36Gplace.\u001b[43GCommitting\u001b[54Gthe\u001b[58Glane\u001b[63Gchanges\u001b[71Gin\u001b[74Gboth\u001b[79Grepositories\u001b[92Gand\u001b[96Gfast-forwarding\u001b[112Geach\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Ggit\u001b[15Gswitch\u001b[22Gfeature-base\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ git switch feature-base\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
