h it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReview base:\u001b[22m \u001b[38;2;177;185;249mcross-review.sh\u001b[34G\u001b[39mnow\u001b[38Gcompar\u001b[45Gs against \u001b[38;2;177;185;249mfeature-base\u001b[39m by default.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWorktrunk path:\u001b[22m I\u001b[23Gchanged\u001b[31Git\u001b[34Gin\u001b[37Gyour\u001b[42Gdotfiles\u001b[51G(\u001b[38;2;177;185;249m~/.dotfiles/.config/worktrunk/config.toml\u001b[39m)\u001b[95Gto\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m~/projects/<rep\u001b[21G>.<branch>\u001b[39m, so any worktree it makes shares ccache.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;61H\u001b[?25h"]
