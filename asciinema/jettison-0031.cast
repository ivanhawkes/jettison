85;249m~/projects/{{ repo }}.{{ branch }}\u001b[39m for anything still made with \u001b[38;2;177;185;249mwt\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaveats:\r\u001b[2C\u001b[1B\u001b[22m- Switching\u001b[15Gbranches\u001b[24Ginside\u001b[31Ga\u001b[33Glane\u001b[38Grebuilds\u001b[47Gwhatever\u001b[56Gthe\u001b[60Gbranch\u001b[67Gchanged.\u001b[76GThat's\u001b[83Gordinary\u001b[92Gincremental\u001b[104Gwork,\u001b[110Gand\u001b[114Gmuch\r\u001b[2C\u001b[1B \u001b[5Gless than\u001b[15Ga cold tree.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe first\u001b[15Ggate in each\u001b[28Gnew\u001b[32Glane\u001b[37Gis\u001b[40Gcold\u001b[45Gonce:\u001b[51Gabout\u001b[57G5–10\u001b[62Gminutes,\u001b[71Gwith\u001b[76GRelease\u001b[84Gsharing\u001b[92Gccache\u001b[99Gwith\u001b[104Gthe\u001b[108Gother\u001b[114Gtrees.\r\u001b[4C\u001b[1BA rev\u001b[11Gew still\u001b[20Gneeds its own lane left untouched while it runs. That's\u001b[76Gexactly\u001b[84Gw\u001b[87Gt the extra\u001b[99Glanes give.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gapprove,\u001b[19GI'll\u001b[24Gset\u001b[28Git\u001b[31Gup\u001b[34Gafter\u001b[40GJ01\u001b[44Gis\u001b[47Gcommitted.\u001b[58GThat's\u001b[65Gabout\u001b[71G30\u001b[74Gminutes\u001b[82Gof\u001b[85Gwork\u001b[90Gplus\u001b[95Gone\u001b[99Gcold\u001b[104Ggate\u001b[109Gper\u001b[113Gnew\r\u001b[2C\u001b[1Blane. \u001b[10G        \u001b[19G    \u001b[24G   \u001b[28G  \u001b[31G  \u001b[34G     \u001b[40G   \u001b[44G  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;89H\u001b[?25h"]
