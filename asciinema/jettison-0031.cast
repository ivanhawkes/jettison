[0.377, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(scripts/heavy.sh)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m#\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  8 \u001b[22m \u001b[38;2;117;113;94m# Usage: scripts/heavy.sh <command> [arguments...]\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m  9 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m#\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 10 -\u001b[38;2;248;248;242m# The command inherits the lock's descriptor, so a process it leaves running \u001b[48;2;92;2;0mholds\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mlock\u001b[48;2;61;1;0m \u001b[48;2;92;2;0muntil\u001b[48;2;61;1;0m      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 11 -\u001b[38;2;248;248;242m# that process ends: `fuser -v <lock>` names the holder.                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 10 +\u001b[38;2;117;113;94m# The command inherits the lock's descriptor, so a process it leaves running \u001b[48;2;4;71;0m(an\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mXvfb\u001b[48;2;2;40;0m \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mkilled run\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 11 +\u001b[38;2;117;113;94m# left) holds the lock until that process ends.\u001b[38;2;248;248;242m                                                        \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m12\u001b[10G\u001b[22m \u001b[38;2;166;226;46mset\u001b[39m -eu\u001b[19G pipefail\r\u001b[6C\u001b[1B\u001b[2m13 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 14 \u001b[22m [ \u001b[38;2;230;219;116m\"\u001b[39m$#\u001b