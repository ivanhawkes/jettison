[0.338, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m1\u001b[11G\u001b[22m\u001b[38;2;117;113;94m// ephemeral one's, so it needs both secrets.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22mKey\u001b[15G\u001b[38;2;166;226;46mMix\u001b[38;2;253;151;31m(\u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m Key &ephemeral, \u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m Key &fixed)\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 63 \u001b[22m {\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m4\u001b[13G\u001b[38;2;248;248;242mif (!ephemeral.empty())\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 65 -\u001b[38;2;248;248;242m    return fixed;                                                                                      \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m4\u001b[13G\u001b[22mKey mixed{};\u001b[K\r\u001b[7C\u001b[1B\u001b[2m5\u001b[13G\u001b[22m\u001b[38;2;166;226;46mcrypto_generichash\u001b[39m(\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 66 \u001b[17G\u001b[22m\u001b[38;2;166;226;46mBytes\u001b[39m(mixed),\u001b[31Gmixed.\u001b[38;2;166;226;46msize\u001b[39m(),\u001b[45G\u001b[38;2;166;226;46mBytes\u001b[39m(fixed),\u001b[59Gfixed.\u001b[38;2;166;226;46msize\u001b[39m(),\u001b[73G\u001b[38;2;166;226;46mBytes\u001b[39m(ephemeral),\u001b[91Gephemeral.\u001b[38;2;166;226;46msize\u001b[39m());\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEach new test fails when its\u001b[32Gfix\u001b[36Gis\u001b[39Gbroken.\u001b[47GNext:\u001b[53Gthe\u001b[57Ghandshake\u001b[67Gdocs,\u001b[73Gthen\u001b[78Gtidy,\u001b[84Gformat,\u001b[92Gthe\u001b[96Gconsumer\u001b[105Gcheck\u001b[111Gand\u001b[115Ga\r\u001b[2C\u001b[1Bfresh\u001b[9Ggate\u001b[14Gbefore\u001b[21Ground\u001b[27G3.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRead\u001b[8G\u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2C\u001b[9B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
