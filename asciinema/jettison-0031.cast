[0.765, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mStarti\u001b[10Gg the\u001b[16Gfull gate\u001b[26G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m). It\u001b[48Gtakes a few minut\u001b[66Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've built J01 in th\u001b[24G engine and the full gate passes (\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[75G236 s). Nothing is committed yet. Manifest\r\u001b[2C\u001b[1Bstill h\u001b[11Gs to\u001b[16Gadopt\u001b[22Git\u001b[25Gbefore \u001b[33Gncryption reaches the\u001b[55Ggame.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mHow the connec\u001b[18Gion works now\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. When the client connects, e\u001b[34Gch\u001b[37Gside sends \u001b[49G fre\u001b[54Gh\u001b[56Gone-time key.\u001b[K\r\u001b[2C\u001b[1B2. The connection's keys\u001b[28Gcome from mixi\u001b[43Gg\u001b[45Gthose with\u001b[56Gthe\u001b[60Gserver's\u001b[69Glong-term\u001b[79Gkey,\u001b[84Gwhich\u001b[90Gthe\u001b[94Gclient\u001b[101Ghas\u001b[105Gpinned.\u001b[113GA\u001b[115Gclient\r\u001b[5C\u001b[1Bpinned\u001b[13Gto\u001b[16Gthe\u001b[20Gwrong\u001b[26Gkey\u001b[30Gis\u001b[33Grefused\u001b[41Gwith\u001b[46Ga\u001b[48Gnew\u001b[52G\u001b[38;2;177;185;249mKeyMismatch\u001b[64G\u001b[39mreason\u001b[71Gbefore\u001b[78Gits\u001b[82Gtoken\u001b[88Gis\u001b[91Gever\u001b[96Gchecked.\r\u001b[2C\u001b[1B3. The\u001b[10Ghello, including the token, is sent encrypted after that exchange. A recorded h\u001b[90Gllo replay\u001b[101Gd on a\u001b[108Gn\u001b[110Gw\u001b[K\r\u001b[2C\u001b[1B   connection can't be decrypte\u001b[35G.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GIf\u001b[9Gthe\u001b[13Gserver's\u001b[22Gsecret\u001b[29Gkey\u001b[33Gis\u001b[36Gstolen\u001b[43Glater,\u001b[50Gconnections\u001b[62Grecorded\u001b[71Gbefore\u001b[78Gthat\u001b[83Gstill\u001b[89Gcan't\u001b[95Gbe\u001b[98Gread.\r\u001b[2C\u001b[1B5. Every message after that\u001b[31Gis en\u001b[37Grypted and \u001b[49Guthenticated\u001b[62G(libsodium's XC\u001b[78GaCha20-Poly1305). A packet that is\u001b[K\r\u001b[5C\u001b[1Breplayed,\u001b[16Gmoved\u001b[22Gto\u001b[25Gthe\u001b[29Gother\u001b[35Gchannel,\u001b[44Galtered\u001b[52Gor\u001b[55Gforged\u001b[62Gis\u001b[65Grejected.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's new in the API:\u001b[22m \u001b[38;2;177;185;249mNet::GenerateServerKe\u001b[77Gnet/Key.h\u001b[39m, \u001b[38;2;177;185;249mServerConfig::secretKey\u001b[39m, and\u001b[117G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
