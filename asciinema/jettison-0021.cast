[0.071, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m2\u001b[11G\u001b[38;2;248;248;242msecond checkout, `build/gate-tree`,\u001b[47Gwith `--tidy`,\u001b[62Gedit\u001b[68Gg alone beside it\u001b[86G \u001b[88G      \u001b[95G  \u001b[98G     \u001b[104G  \u001b[107G   \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m3\u001b[11G\u001b[38;2;248;248;242m([gating beside the work](build-and-ga\u001b[50Ges.md#gating-bes\u001b[67Gde-the-work)). A ship\u001b[89Gsteered\u001b[97Gin\u001b[100Ga\u001b[102Gstation's\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m4\u001b[11G\u001b[38;2;248;248;242mframe still runs every step, which is mo\u001b[52Gt of the zero-client run's steps, more so since\u001b[100Gper hour the\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m5\u001b[11G\u001b[38;2;248;248;242mpolicies hop betw\u001b[29Gen the stations of Ore's\u001b[55Gne orbit.        \u001b[73G     \u001b[79G      \u001b[86G    \u001b[91G  \u001b[94G     \u001b[100G   \u001b[104G    \u001b[109G   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  5 +\u001b[38;2;248;248;242mW14 is done: **Stage 4 is closed** ([\u001b[38;2;230;219;116mdelivered\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-w14-2026-11-23)),    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242mwith no e\u001b[21Ggine edit,\u001b[32Gand [\u001b[38;2;230;219;116mStage 5's handoff\u001b[38;2;248;248;242m](stage-4-trading-plan.md#han\u001b[84Goff-to-stage\u001b[97G5) names     \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242mhere each contrac\u001b[30G is. Next is the stage's cross-review, Codex over its commits, then R01, Stage 5's  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[11G\u001b[38;2;248;248;242msave and compa\u001b[26Gibility inventory. W22, the drive\u001b[60G past the torch, waits for the first larger hull.   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[11G\u001b[38;2;248;248;242mJettison's st\u001b[27Gon traffic lanes were measured and parked (`fixture_traf\u001b[84Gic`, 2026-11-22), to be  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m10\u001b[11G\u001b[38;2;248;248;242mtaken up when it fails. The SDK is pinn\u001b[51Gd to `14fc23\u001b[64G`. A\u001b[69Gcommi\u001b[75G is gated in the second checkout,\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[11G\u001b[38;2;248;248;242m`build/gate-tree`, with\u001b[35G`--tidy`, ed\u001b[48Gting\u001b[53Galone beside it\u001b[69G      \u001b[76G  \u001b[79G     \u001b[85G  \u001b[88G   \u001b[92G      \u001b[99G         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mgating beside the work\u001b[38;2;248;248;242m](build-and-gates.md#gating-beside-the-work)). The development fixture takes   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242mabout 50 s in Debug and six minutes under ASan, most of the gate's sanitised stage.                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 14 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22mWhat\u001b[16Geach\u001b[21Gtask\u001b[26Gfound\u001b[32Gand\u001b[36Gleft,\u001b[42Gand\u001b[46Ghow\u001b[50Geach\u001b[55Gwas\u001b[59Gclosed,\u001b[67Gis\u001b[70Gin\u001b[73G[\u001b[38;2;230;219;116mhistory\u001b[39m](history.md),\u001b[96Gnewest\u001b[103Gfirst.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest/build/gate-tree'…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/manifest/build/gate-tree' && export CMAKE_BUILD_PARALLEL_LEVEL='24' \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mCTEST_PARALLEL_LEVEL='24' MANIFEST_TIDY_JOBS='24'; ./sc\u001b[62Gipts/ci.sh --werror --asan --tidy --log build/gate-w14.log\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
