[0.446, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mThe standing policy:\u001b[22m \u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[39m lets the AI issuer tender\u001b[88Gt\u001b[91G head\u001b[97Gp\u001b[100Gject's\u001b[107Ginputs\u001b[114Gfor\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Gplayer's region, within a spending limit and from the treasury alone. When i\u001b[82G holds back, it \u001b[99Gecords why (over the\r\u001b[4C\u001b[1Blimit, or no funds).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe region view:\u001b[22m every\u001b[28Gplayer\u001b[35Gsees\u001b[40Gevery\u001b[46Gregion\u001b[53Gand\u001b[57Gits\u001b[61Ggovernor.\u001b[71GThe\u001b[75Gtreasury,\u001b[85Gqueue\u001b[91Gand\u001b[95Gpolicy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5Gits governor and\u001b[22Gth\u001b[25G host. The view also\u001b[46Ggoes to \u001b[55Getwork clie\u001b[67Gts,\u001b[71Gso a \u001b[78Gconnecting client gets it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_development\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Ada founds Forge North. With no client connected,\u001b[57Gher\u001b[61Gship's\u001b[68Gjob\u001b[72Gsupplies\u001b[81Gthe\u001b[85Gguild\u001b[91Gand\u001b[95GBronze,\u001b[103Gand\u001b[107Gboth\u001b[112Gfinish\r\u001b[4C\u001b[1B \u001b[7Gwithin about fifteen simulated days.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GHer job also\u001b[20Gsupplied Forge East's Bronze,\u001b[50Gwhich\u001b[56Gits\u001b[60GAI\u001b[63Gworked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[6C\u001b[1BB\u001b[9Ga\u001b[13Gins late and founds Forge South; Cara is refu\u001b[59Ged in ev\u001b[68Gry region.\u001b[K\r\u001b[6C\u001b[1BLo\u001b[10Gding a\u001b[17Gmid-ru\u001b[24G save and replaying from the start both r\u001b[66Gach th\u001b[73G same\u001b[79Gpinned\u001b[86Gworld.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery\u001b[62Gother\u001b[68Gcheck\u001b[74Gin\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B- The queue's new saved field moved 2 pins.\u001b[K\r\u001b[8C\u001b[1Bpolicy's compon\u001b[25Gnt storage moved 4, because\u001b[53Ga\u001b[55Gsave\u001b[60Glists\u001b[66Git\u001b[69Geven\u001b[74Gwhen\u001b[79Gempty.\r\u001b[4C\u001b[1BForge North's new workshop moved 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do, recorded in the plan:\r\u001b[2C\u001b[1B\u001b[22m- Console and TUI commands for founding,\u001b[44Gthe\u001b[48Gqueue\u001b[54Gand\u001b[58Gthe\u001b[62Gpolicy.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mFound\u001b[39m doesn't check the regional plan's station,\u001b[54Gdelivery and life-support\u001b[80Gconditions\u001b[91Gfor\u001b[95Ga\u001b[97Ghomeworld.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.477, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[1mregion view:\u001b[22m every player sees every region and its governor.\u001b[71GThe treasury, queue and policy are shown only to\r\u001b[4C\u001b[1Bits governor a\u001b[20Gd\u001b[22Gthe host. The view also\u001b[46Ggoes t\u001b[53G network clients, so a r\u001b[78Gconnecting\u001b[89Gclient gets it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_development\u001b[39m:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- Ada founds Forg\u001b[23G North. With no cli\u001b[43Gnt\u001b[46Gconnected,\u001b[57Gher\u001b[61Gship's job supplie\u001b[80G the\u001b[85Gg\u001b[87Gild\u001b[95GBronze, and b\u001b[109Gth\u001b[112Gfinish\u001b[K\r\u001b[4C\u001b[1B  within about fift\u001b[25Gen \u001b[29Gimulated days.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Her job also supplied Forge East's Bronze,\u001b[50Gwhich\u001b[56Gits\u001b[60GAI\u001b[63Gworked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[6C\u001b[1BBe\u001b[11Gj\u001b[13Gi\u001b[15Gs late and founds Forge\u001b[39GSouth;\u001b[46GCara is refused in every region.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GLoad\u001b[13Gg a mid-run save and r\u001b[36Gplaying\u001b[44Gfrom\u001b[49Gthe\u001b[53Gstart\u001b[59Gboth\u001b[64Greach\u001b[70Gthe\u001b[74Gsame\u001b[79Gpinned\u001b[86Gworld.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[22m every\u001b[62Goth\u001b[66Gr check \u001b[75Gn those\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B-\u001b[5GThe queue's\u001b[17Gnew saved field moved 2 pins.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gpolicy's\u001b[18Gcomponent\u001b[28Gstorage\u001b[36Gmoved\u001b[42G4,\u001b[45Gbecause\u001b[53Ga\u001b[55Gsave\u001b[60Glists\u001b[66Git\u001b[69Geven\u001b[74Gwhen\u001b[79Gempty.\r\u001b[2C\u001b[1B- Forge North's new workshop moved 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do, recorded in the plan:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BC\u001b[7Gnsole and TUI commands for founding,\u001b[44Gthe\u001b[48Gqueue\u001b[54Gand\u001b[58Gthe\u001b[62Gpolicy.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mFound\u001b[11G\u001b[39mdoesn't\u001b[19Gcheck\u001b[25Gthe\u001b[29Gregional\u001b[38Gplan's\u001b[45Gstation,\u001b[54Gdelivery\u001b[63Gand\u001b[67Glife-support\u001b[80Gconditions\u001b[91Gfor\u001b[95Ga\u001b[97Ghomeworld.\r\u001b[2C\u001b[1B- Reordering a queue (for now, cancel\u001b[41Gand\u001b[45Gqueue\u001b[51Gagain).\r\u001b[4C\u001b[1BRelief te\u001b[16Gers under a player's policy.\u001b[K\r\u001b[4C\u001b[1BAI acquisition (L03) and region supply (D-076).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.079, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- Ada founds Forg\u001b[23G North. With no cli\u001b[43Gnt\u001b[46Gconnected,\u001b[57Gher\u001b[61Gship's job supplie\u001b[80G the\u001b[85Gg\u001b[87Gild\u001b[95GBronze, and b\u001b[109Gth\u001b[112Gfinish\u001b[K\r\u001b[4C\u001b[1B  within about fift\u001b[25Gen \u001b[29Gimulated days.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Her job also supplied Forge East's Bronze,\u001b[50Gwhich\u001b[56Gits\u001b[60GAI\u001b[63Gworked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[6C\u001b[1BBe\u001b[11Gj\u001b[13Gi\u001b[15Gs late and founds Forge\u001b[39GSouth;\u001b[46GCara is refused in every region.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GLoad\u001b[13Gg a mid-run save and r\u001b[36Gplaying\u001b[44Gfrom\u001b[49Gthe\u001b[53Gstart\u001b[59Gboth\u001b[64Greach\u001b[70Gthe\u001b[74Gsame\u001b[79Gpinned\u001b[86Gworld.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[22m every\u001b[62Goth\u001b[66Gr check \u001b[75Gn those\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B-\u001b[5GThe queue's\u001b[17Gnew saved field moved 2 pins.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gpolicy's\u001b[18Gcomponent\u001b[28Gstorage\u001b[36Gmoved\u001b[42G4,\u001b[45Gbecause\u001b[53Ga\u001b[55Gsave\u001b[60Glists\u001b[66Git\u001b[69Geven\u001b[74Gwhen\u001b[79Gempty.\r\u001b[2C\u001b[1B- Forge North's new workshop moved 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do, recorded in the plan:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BC\u001b[7Gnsole and TUI commands for founding,\u001b[44Gthe\u001b[48Gqueue\u001b[54Gand\u001b[58Gthe\u001b[62Gpolicy.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mFound\u001b[11G\u001b[39mdoesn't\u001b[19Gcheck\u001b[25Gthe\u001b[29Gregional\u001b[38Gplan's\u001b[45Gstation,\u001b[54Gdelivery\u001b[63Gand\u001b[67Glife-support\u001b[80Gconditions\u001b[91Gfor\u001b[95Ga\u001b[97Ghomeworld.\r\u001b[2C\u001b[1B- Reordering a queue (for now, cancel\u001b[41Gand\u001b[45Gqueue\u001b[51Gagain).\r\u001b[4C\u001b[1BRelief te\u001b[16Gers under a player's policy.\u001b[K\r\u001b[4C\u001b[1BAI acquisition (L03) and region supply (D-076).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe home-r\u001b[14Ggion allocation in \u001b[38;2;177;185;249mscope.md\u001b[39m, the\u001b[47GManifest\u001b[56Groadmap,\u001b[65GD-076\u001b[71Gand\u001b[75Gthe\u001b[79Gregional\u001b[88Gplan\u001b[93Gnow\u001b[97Greads\u001b[103Gas\u001b[106Gfounding.\r\u001b[2C\u001b[1BJettison's roadmap and\u001b[26Ghistory are \u001b[40Gdated (\u001b[38;2;177;185;249m69e0963\u001b[39m).\u001b[57GNo\u001b[60Gcross-review\u001b[73Gyet:\u001b[78Gthat\u001b[83Gcomes\u001b[89Gwhen\u001b[94GW14\u001b[98Gcloses\u001b[105Gthe\u001b[109Gstage.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.284, "o", "\u001b[?25l\u001b[H\u001b[7GLo\u001b[10Gding a mid-run save and replaying from the start bot\u001b[63G reach the same pinn\u001b[84Gd world.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery other check in\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B-\u001b[5GThe queue'\u001b[17Gnew s\u001b[23Gved field\u001b[33Gm\u001b[35Gved\u001b[39G2 pins.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe policy's compo\u001b[24Gent storage moved 4, becaus\u001b[53Ga save lists it even\u001b[74Gwhen\u001b[79Gempty.\u001b[86G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GForge\u001b[11GNorth's\u001b[19Gnew\u001b[23Gworkshop\u001b[32Gmoved 2.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do, recorded in the plan:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BConsole and TUI c\u001b[23Gmmand\u001b[29G for founding, th\u001b[47G q\u001b[50Geue and the policy.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mFound\u001b[11G\u001b[39md\u001b[13Gesn\u001b[17Gt\u001b[19Gcheck the regi\u001b[34Gnal plan's\u001b[45Gstation,\u001b[54Gdelivery\u001b[63Gand\u001b[67Glife-support\u001b[80Gconditions\u001b[91Gfor\u001b[95Ga\u001b[97Ghomeworld.\r\u001b[2C\u001b[1B-\u001b[5GReordering\u001b[16Ga\u001b[18Gqueue\u001b[24G(for\u001b[29Gnow,\u001b[34Gcancel\u001b[41Gand\u001b[45Gqueue\u001b[51Gagain).\r\u001b[2C\u001b[1B- Relief tenders under a player's policy.\r\u001b[4C\u001b[1BAI acquisition (L03) and\u001b[30Gregion supply\u001b[44G(D-076).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe hom\u001b[11G-re\u001b[15Gion allocation in \u001b[38;2;177;185;249mscope.md\u001b[39m, the Manifest roadmap,\u001b[65GD-076\u001b[71Gand\u001b[75Gthe\u001b[79Gregional\u001b[88Gplan\u001b[93Gnow\u001b[97Greads\u001b[103Gas\u001b[106Gfounding.\r\u001b[2C\u001b[1BJettison's roadmap and\u001b[26Ghistory are updated\u001b[46G(\u001b[38;2;177;185;249m69e0963\u001b[39m).\u001b[57GNo\u001b[60Gcross-review\u001b[73Gyet:\u001b[78Gthat\u001b[83Gcomes\u001b[89Gwhen\u001b[94GW14\u001b[98Gcloses\u001b[105Gthe\u001b[109Gstage.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BUnder\u001b[9GASan\u001b[14Gthe\u001b[18Gnew\u001b[22Gfixture\u001b[30Gtakes\u001b[36G352\u001b[40Gs,\u001b[43Gwhich\u001b[49Glengthens\u001b[59Gthe\u001b[63Ggate.\u001b[69GThis\u001b[74Gis\u001b[77Ga\u001b[79Gnatural\u001b[87Gpoint\u001b[93Gto\u001b[96G\u001b[38;2;177;185;249m/compact\u001b[105G\u001b[39mor\u001b[108Gstart\u001b[114Ga\u001b[116Gnew\r\u001b[2C\u001b[1Bsessi\u001b[9Gn before W14.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m·\u001b[3GImprovising\u001b[38;2;235;159;127m…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(1h 26m 1s · ↓\u001b[31G121.1k tokens)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
