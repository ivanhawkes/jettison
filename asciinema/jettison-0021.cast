[1.551, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe review's five new blockers.\u001b[35G\u001b[22mEach\u001b[40Gcomes\u001b[46Gwith\u001b[51Ga\u001b[53Greproduction\u001b[66Gunder\u001b[72G\u001b[38;2;177;185;249mbuild/reviews/stage-4/scratch\u001b[39m:\r\u001b[2C\u001b[1B1. \u001b[1mRefuelling:\u001b[22m it buys whole totes, but the trip estimate assumes the tanks fill completely. A heavy\u001b[104Gship\u001b[109Gkeeps\r\u001b[2C\u001b[1B  \u001b[6Gchoosing a burn it can't fly and\u001b[39Gstays blocked, \u001b[55Ghough\u001b[62G \u001b[64Glower burn would work.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mFee schedule:\u001b[22m a\u001b[22Gsave wi\u001b[30Gh an\u001b[35Gempty fee\u001b[45Gschedule\u001b[54Gloads,\u001b[61Gthen crashes the first time\u001b[89Ga\u001b[91Gship\u001b[96Gtravels.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mTax\u001b[10Gcarry:\u001b[22m a s\u001b[21Gved wage-tax carry o\u001b[42G any size loads, and the next payroll throws.\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mOpened totes:\u001b[22m \u001b[21G saved opened tote\u001b[40Gcan hold any amount, suc\u001b[65G as a milli\u001b[77Gn kilograms\u001b[89Gof\u001b[92Goxygen\u001b[99Gin\u001b[102Gone\u001b[106Gtote.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mFixture ledger:\u001b[22G\u001b[22mthe go\u001b[29Gds check ac\u001b[41Gepts any loss \u001b[56Gf any item in a step where househ\u001b[90Glds or projects\u001b[106Gc\u001b[108Gnsume.\u001b[115GW14's\r\u001b[2C\u001b[1B  \u001b[6Gclaim that goods l\u001b[25Gave only through named sink\u001b[53G therefore isn't\u001b[70Gprov\u001b[75Gn.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BItems\u001b[9G2\u001b[11Gto\u001b[14G4\u001b[16Gare\u001b[20Gload\u001b[25Gchecks;\u001b[33Gitem\u001b[38G5\u001b[40Gmeans\u001b[46Gthe\u001b[50Gfixtures'\u001b[60Ggoods\u001b[66Gcheck\u001b[72Gmust\u001b[77Gtrack\u001b[83Gwhat\u001b[88Gwas\u001b[92Gconsumed,\u001b[102Gper\u001b[106Gitem;\u001b[112Gitem\u001b[117G1\u001b[119Gis\r\u001b[2C\u001b[1Ba behaviour fix in the policy's \u001b[36Gstimate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you:\u001b[21G\u001b[22mwhether\u001b[29GI\u001b[31Gfix\u001b[35Gall\u001b[39Gfive\u001b[44Gand\u001b[48Grun\u001b[52Ground\u001b[58G2,\u001b[61Gthe\u001b[65Glast\u001b[70Gbefore\u001b[77Gyou\u001b[81Gsettle\u001b[88Gwhat\u001b[93Gstays\u001b[99Gopen.\u001b[105GI'd\u001b[109Gdo\u001b[112Gthat,\r\u001b[2C\u001b[1Bsince they are clear fixes.\u001b[31G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Gchecked:\u001b[16Gthe\u001b[20Gold\u001b[24G\u001b[38;2;177;185;249mMarketplace\u001b[36G\u001b[39mservice,\u001b[45Gwhich\u001b[51Gno\u001b[54Ggame\u001b[59Gcommand\u001b[67Gcalls,\u001b[74Gand\u001b[78Gtwo\u001b[82Gload-side\u001b[92Ggaps:\u001b[98Garrears\u001b[106Gwhose\u001b[112Gstart\u001b[118Gis\r\u001b[2C\u001b[1Baf\u001b[6Ger the current step, and arrears whose\u001b[45Gamount has no\u001b[59Gb\u001b[61Gund.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 50m 32s · done 10:43 pm\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
