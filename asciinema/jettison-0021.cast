[0.017, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255msafe to clear?\u001b[39m                                                                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYes,\u001b[8Git's\u001b[13Gsafe\u001b[18Gto\u001b[21Gclear.\u001b[28GBoth\u001b[33Gtrees\u001b[39Gare\u001b[43Gclean\u001b[49Gwith\u001b[54Geverything\u001b[65Gcommitted.\u001b[76GEach\u001b[81Grepo\u001b[86Gis\u001b[89Gone\u001b[93Gcommit\u001b[100Gahead\u001b[106Gof\u001b[109G\u001b[38;2;177;185;249morigin\u001b[116G\u001b[39mand\r\u001b[1B \u001b[3Gnot pushed: Manifest \u001b[38;2;177;185;249me1def0f\u001b[39m (\u001b[34Gh\u001b[36G round\u001b[43G3 fixes) and Jet\u001b[60Gison\u001b[65G\u001b[38;2;177;185;249m71e9a31\u001b[39m (the roadmap\u001b[86Gentry for splitting\u001b[106Gmessages). Push\r\u001b[2C\u001b[1Bfirst if you want them on GitHub.\u001b[37G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gnext\u001b[12Gsession\u001b[20Gstarts\u001b[27Gfrom\u001b[32GManifest's\u001b[43G\u001b[38;2;177;185;249msession-handoff.md\u001b[39m,\u001b[63Gwhich\u001b[69Gsays\u001b[74GR01\u001b[78Gis\u001b[81Gnext.\u001b[87GThe\u001b[91Goversized-snapshot\u001b[110Gfix\u001b[114Gis\u001b[117Gon\r\u001b[2C\u001b[1BJettison'\u001b[13G roadmap, so nothing from \u001b[40Ghis session would be lost.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 13s · done 1:07 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mpush\u001b[39m                                                                                                                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u0