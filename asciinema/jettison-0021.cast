\r\u001b[2C\u001b[1BIf you want, a cheap first step\u001b[35Gbefore splitting\u001b[52Gmessages\u001b[61Gor\u001b[64Gadding\u001b[71Gdeltas\u001b[78Gis\u001b[81Gto\u001b[84Gset\u001b[88G\u001b[38;2;177;185;249msnapshotInterval\u001b[105G\u001b[39mto\u001b[108G1\u001b[110Gs,\u001b[113Gor\u001b[116Gsend\r\u001b[2C\u001b[1Bonly when the client's vi\u001b[29Gw has changed.\u001b[44GEither would cut the lo\u001b[68Gd abou\u001b[75G tenfold,\u001b[85Gthough neither fixes the\u001b[110G64 KiB\r\u001b[2C\u001b[1Blimit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 31s · done 1:10 am\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mset snapshotInterval to 1 second\u001b[39m                                                                                      \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✶\u001b[3GImagini\u001b[38;2;235;159;127mng…\u001b[38;2;215;119;87m \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
