[0.350, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gpays \u001b[38;2;177;185;249mcompany.foundingPrice\u001b[39m (200,000, my test\u001b[50Gvalue)\u001b[57Ginto\u001b[62Gthe\u001b[66Gregion's\u001b[75Gtreasury,\u001b[85Gand\u001b[89Ga\u001b[91Gnew\u001b[95Gpolity\u001b[102Gthe\u001b[106Gplayer\u001b[113Gdirects\r\u001b[4C\u001b[1Bbecomes its governor. No command takes a\u001b[46Gg\u001b[48Gverned region away fr\u001b[70Gm\u001b[72Gits player.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe queue:\u001b[22m a reg\u001b[22Gon's projects run one\u001b[44Gat\u001b[47Ga\u001b[49Gtime\u001b[54Gin\u001b[57Gqueue\u001b[63Gorder\u001b[69G(\u001b[38;2;177;185;249mManifest.Procurement.Queue\u001b[39m,\u001b[98G\u001b[38;2;177;185;249mCancelProject\u001b[39m).\u001b[114GA\r\u001b[4C\u001b[1Bproject cancelled wh\u001b[26Gle\u001b[29Gstill\u001b[35Gtendering ke\u001b[48Gps what\u001b[56Gwa\u001b[60Gdeliver\u001b[70Gfor a later\u001b[82Grequeue.\u001b[91GI\u001b[93Gadded\u001b[99Ga\u001b[101Gsecond\u001b[108Gproject,\u001b[117Gthe\r\u001b[4C\u001b[1Bsmelters' guild,\u001b[22Gwhich teaches smelting so a region lacking\u001b[65Gth\u001b[68G skill can\u001b[79Gqueue\u001b[85Git\u001b[88Gahead\u001b[94Gof\u001b[97GBronze.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe standing policy:\u001b[22m \u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[39m lets t\u001b[69Ge AI\u001b[74Gissuer ten\u001b[85Ger the head\u001b[97Gproject's\u001b[107Ginputs\u001b[114Gfor\u001b[118Ga\r\u001b[4C\u001b[1Bplayer's\u001b[14Gregion,\u001b[22Gwithin\u001b[29Ga\u001b[31Gspending\u001b[40Glimit\u001b[46Gand\u001b[50Gfrom\u001b[55Gthe\u001b[59Gtreasury\u001b[68Galone.\u001b[75GWhen\u001b[80Git\u001b[83Gholds\u001b[89Gback,\u001b[95Git\u001b[98Grecords\u001b[106Gwhy\u001b[110G(over\u001b[116Gthe\r\u001b[2C\u001b[1B  limit, or no funds).\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe region view:\u001b[22m e\u001b[25Gry player s\u001b[37Ges every region\u001b[53Gand\u001b[57Gits\u001b[61Ggovernor.\u001b[71GThe\u001b[75Gtreasury,\u001b[85Gqueue\u001b[91Gand\u001b[95Gpolicy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5Gits\u001b[9Gg\u001b[11Gvernor\u001b[18Gand th\u001b[25G ho\u001b[30G. Th\u001b[36Gview also goes to network clien\u001b[68Gs, so\u001b[74Ga reconnecting\u001b[89Gclient\u001b[96Ggets\u001b[101Git.\r\u001b[4C\u001b[1B\u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_development\u001b[39m:\r\u001b[4C\u001b[1B\u001b[22m-\u001b[7GAda\u001b[11Gfounds\u001b[18GForge\u001b[24GNorth.\u001b[31GWith\u001b[36Gno\u001b[39Gclient\u001b[46Gconnected,\u001b[57Gher\u001b[61Gship's\u001b[68Gjob\u001b[72Gsupplies\u001b[81Gthe\u001b[85Gguild\u001b[91Gand\u001b[95GBronze,\u001b[103Gand\u001b[107Gboth\u001b[112Gfinish\r\u001b[2C\u001b[1B    within about fifteen simulated\u001b[38Gdays.\r\u001b[2C\u001b[1B \u001b[5G- Her job also supplie\u001b[28G Forge East's Bronze, which its AI worked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[2C\u001b[1B \u001b[5G- Bea\u001b[11Gj\u001b[13Gins late and founds Forge South; C\u001b[48Gra is\u001b[54Gr\u001b[56Gfus\u001b[60Gd in every region.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Loading a mid-run save and\u001b[34Greplaying from the start\u001b[59Gboth\u001b[64Greach\u001b[70Gthe\u001b[74Gsame\u001b[79Gpinned\u001b[86Gworld.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery\u001b[62Gother\u001b[68Gcheck\u001b[74Gin\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gqueue's\u001b[17Gnew\u001b[21Gsaved\u001b[27Gfield\u001b[33Gmoved\u001b[39G2\u001b[41Gpins.\r\u001b[2C\u001b[1B- The policy's comp\u001b[23Gnent storage moved 4, be\u001b[76Gen\u001b[79Gempty.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.396, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BCTEST_PARALLEL_LEVEL='24' MANIFEST_TIDY_JOBS='24'; ./scripts/ci.sh --werror --asan --tidy --l\u001b[97Gg build/gate-w13b.log\"\u001b[K\r\u001b[2C\u001b[1Bcomplet\u001b[11Gd\u001b[13G(exit code 0)\u001b[27G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mW13 is done in Manifest, with no engine change needed. The\u001b[62Gfull\u001b[67GManifest gate\u001b[81G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m) passed on both\r\u001b[2C\u001b[1Bchunks of work, the last at\u001b[31G\u001b[38;2;177;185;249md1493d4\u001b[39m.\u001b[40GNothing is pushed.\u001b[59G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BYou chose all four\u001b[22Grecommended rul\u001b[39G, r\u001b[43Gcord\u001b[48Gd as\u001b[53GD-110:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFounding:\u001b[22m a company founds\u001b[32Gits\u001b[36Gprincipal's one hom\u001b[56Gworld\u001b[62Gin a region\u001b[74Gno one gover\u001b[87Gs\u001b[89G(\u001b[38;2;177;185;249mManifest.Company.Found\u001b[39m).\u001b[115GIt\r\u001b[2C\u001b[1B \u001b[5Gpays \u001b[38;2;177;185;249mcompany.foundingPrice\u001b[39m (200,000, my test\u001b[50Gvalue)\u001b[57Ginto\u001b[62Gthe\u001b[66Gregion's\u001b[75Gtreasury,\u001b[85Gand\u001b[89Ga\u001b[91Gnew\u001b[95Gpolity\u001b[102Gthe\u001b[106Gplayer\u001b[113Gdirects\r\u001b[4C\u001b[1Bbecomes its governor. No command takes a\u001b[46Gg\u001b[48Gverned region away fr\u001b[70Gm\u001b[72Gits player.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe queue:\u001b[22m a reg\u001b[22Gon's projects run one\u001b[44Gat\u001b[47Ga\u001b[49Gtime\u001b[54Gin\u001b[57Gqueue\u001b[63Gorder\u001b[69G(\u001b[38;2;177;185;249mManifest.Procurement.Queue\u001b[39m,\u001b[98G\u001b[38;2;177;185;249mCancelProject\u001b[39m).\u001b[114GA\r\u001b[4C\u001b[1Bproject cancelled wh\u001b[26Gle\u001b[29Gstill\u001b[35Gtendering ke\u001b[48Gps what\u001b[56Gwa\u001b[60Gdeliver\u001b[70Gfor a later\u001b[82Grequeue.\u001b[91GI\u001b[93Gadded\u001b[99Ga\u001b[101Gsecond\u001b[108Gproject,\u001b[117Gthe\r\u001b[4C\u001b[1Bsmelters' guild,\u001b[22Gwhich teaches smelting so a region lacking\u001b[65Gth\u001b[68G skill can\u001b[79Gqueue\u001b[85Git\u001b[88Gahead\u001b[94Gof\u001b[97GBronze.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe standing policy:\u001b[22m \u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[39m lets t\u001b[69Ge AI\u001b[74Gissuer ten\u001b[85Ger the head\u001b[97Gproject's\u001b[107Ginputs\u001b[114Gfor\u001b[118Ga\r\u001b[4C\u001b[1Bplayer's\u001b[14Gregion,\u001b[22Gwithin\u001b[29Ga\u001b[31Gspending\u001b[40Glimit\u001b[46Gand\u001b[50Gfrom\u001b[55Gthe\u001b[59Gtreasury\u001b[68Galone.\u001b[75GWhen\u001b[80Git\u001b[83Gholds\u001b[89Gback,\u001b[95Git\u001b[98Grecords\u001b[106Gwhy\u001b[110G(over\u001b[116Gthe\r\u001b[2C\u001b[1B  limit, or no funds).\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe region view:\u001b[22m e\u001b[25Gry player s\u001b[37Ges every region\u001b[53Gand\u001b[57Gits\u001b[61Ggovernor.\u001b[71GThe\u001b[75Gtreasury,\u001b[85Gqueue\u001b[91Gand\u001b[95Gpolicy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5Gits\u001b[9Gg\u001b[11Gvernor\u001b[18Gand th\u001b[25G ho\u001b[30G. Th\u001b[36Gview also g\u001b[76Greconnecting\u001b[89Gclient\u001b[96Ggets\u001b[101Git.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[3.157, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bcompleted (exit code 0)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mW13\u001b[7Gis\u001b[10Gdone\u001b[15Gin\u001b[18GManifest,\u001b[28Gwith\u001b[33Gno\u001b[36Gengine\u001b[43Gchange\u001b[50Gneeded.\u001b[58GThe\u001b[62Gfull\u001b[67GManifest\u001b[76Ggate\u001b[81G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m)\u001b[106Gpassed\u001b[113Gon\u001b[116Gboth\r\u001b[1B \u001b[3Gchunk\u001b[10Gof work, the last\u001b[28Gat \u001b[38;2;177;185;249md1493d4\u001b[39m. Nothing is pushed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BYou\u001b[7Gchose\u001b[13Gall\u001b[17Gfour\u001b[22Grecommended\u001b[34Grules,\u001b[41Grecorded\u001b[50Gas\u001b[53GD-110:\r\u001b[2C\u001b[1B- \u001b[1mFounding:\u001b[22m a\u001b[17Gc\u001b[19Gmpany founds its principal's one homeworld\u001b[62Gin\u001b[65Ga\u001b[67Gregion\u001b[74Gno\u001b[77Gone\u001b[81Ggoverns\u001b[89G(\u001b[38;2;177;185;249mManifest.Company.Found\u001b[39m).\u001b[115GIt\r\u001b[2C\u001b[1B \u001b[5Gpays \u001b[38;2;177;185;249mcompany.foundingPrice\u001b[32G\u001b[39m(200,000, my test value) into\u001b[62Gthe region's treasury, a\u001b[87Gd\u001b[89Ga new polity the player directs\r\u001b[4C\u001b[1Bbecomes its governor. No command takes a governed region\u001b[62Gaway from its pl\u001b[79Gye\u001b[82G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe queue:\u001b[22m a region's\u001b[27Gprojects run one\u001b[45Gt a tim\u001b[53G in queue order (\u001b[38;2;177;185;249mManifest.Procurement.Queue\u001b[39m,\u001b[98G\u001b[38;2;177;185;249mCancelProject\u001b[39m).\u001b[114GA\r\u001b[2C\u001b[1B \u001b[5Gproject cancelled while still tendering keeps what was d\u001b[62Glivered for a later requeue. I added a second project,\u001b[117Gthe\r\u001b[4C\u001b[1Bsmelters' gui\u001b[19Gd, which teaches smelt\u001b[45Gso a region lacking th\u001b[68G skill can queu\u001b[84G it ahead of Bronz\u001b[103G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe standing policy:\u001b[22m \u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[39m lets the AI issuer tender\u001b[88Gt\u001b[91G head\u001b[97Gp\u001b[100Gject's\u001b[107Ginputs\u001b[114Gfor\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Gplayer's region, within a spending limit and from the treasury alone. When i\u001b[82G holds back, it \u001b[99Gecords why (over the\r\u001b[4C\u001b[1Blimit, or no funds).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe region view:\u001b[22m every\u001b[28Gplayer\u001b[35Gsees\u001b[40Gevery\u001b[46Gregion\u001b[53Gand\u001b[57Gits\u001b[61Ggovernor.\u001b[71GThe\u001b[75Gtreasury,\u001b[85Gqueue\u001b[91Gand\u001b[95Gpolicy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5Gits governor and\u001b[22Gth\u001b[25G host. The view also\u001b[46Ggoes to \u001b[55Getwork clie\u001b[67Gts,\u001b[71Gso a \u001b[78Gconnecting client gets it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_developmen\u001b[76G\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
