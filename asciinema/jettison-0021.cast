[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bsmelters'\u001b[15Gguild,\u001b[22Gwhich\u001b[28Gteaches\u001b[36Gsmelting\u001b[45Gso\u001b[48Ga\u001b[50Gregion\u001b[57Glacking\u001b[65Gthe\u001b[69Gskill\u001b[75Gcan\u001b[79Gqueue\u001b[85Git\u001b[88Gahead\u001b[94Gof\u001b[97GBronze.\r\u001b[1B \u001b[3G- \u001b[1mThe standing policy:\u001b[22m \u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[62G\u001b[39mlets\u001b[67Gthe AI issuer\u001b[81Gtender the head project's inputs for a\u001b[K\r\u001b[2C\u001b[1B  player's region, within a\u001b[31Gspending\u001b[40Glimit and from the\u001b[59Gtreasury\u001b[68Galone.\u001b[75GWhen\u001b[80Git\u001b[83Gholds\u001b[89Gback,\u001b[95Git\u001b[98Grecords\u001b[106Gwhy\u001b[110G(over\u001b[116Gthe\r\u001b[4C\u001b[1Blimit,\u001b[12Gor\u001b[15Gno\u001b[18Gfunds).\r\u001b[2C\u001b[1B- \u001b[1mThe region view:\u001b[22G\u001b[22mevery player se\u001b[39G ev\u001b[43Gry r\u001b[48Ggion\u001b[53Gand its\u001b[61Ggovernor.\u001b[71GThe\u001b[75Gtreasury,\u001b[85Gqueue\u001b[91Gand\u001b[95Gpolicy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5Gits governor and the host.\u001b[32GThe\u001b[36Gview also goes to n\u001b[56Gtwork\u001b[62Gclients, so\u001b[74Ga reconnecti\u001b[87Gg\u001b[89Gclient gets it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_development\u001b[39m:\u001b[50G\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- Ada founds Forge North. With no client\u001b[46Gc\u001b[48Gnnected, her ship's j\u001b[70Gb\u001b[72Gsupplies the\u001b[85Gguild\u001b[91Gand\u001b[95GBronze,\u001b[103Gand\u001b[107Gboth\u001b[112Gfinish\r\u001b[2C\u001b[1B \u001b[5G  within about f\u001b[22Gfteen simulated days.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B- Her job also suppl\u001b[26Ged\u001b[29GForge\u001b[35GEast's Bronz\u001b[48G, which\u001b[56Git\u001b[60GAI work\u001b[70Gon its own.\u001b[82G\u001b[K\r\u001b[4C\u001b[1B- Bea joins late\u001b[22Gand founds Forge South; Cara is refused in\u001b[65Gev\u001b[68Gry region.\u001b[79G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Loading a mid-run save and replaying from the start both reac\u001b[69G the\u001b[74Gsame pinne\u001b[85G world.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery\u001b[62Gother\u001b[68Gcheck\u001b[74Gin\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[4C\u001b[1BThe queue's new sa\u001b[25Gd field mov\u001b[37Gd 2 pins.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gp\u001b[11Glicy's\u001b[18Gcompon\u001b[25Gnt \u001b[30Gorag\u001b[36Gmoved 4, because a save lists i\u001b[68G even\u001b[74Gwhen empty.\u001b[K\r\u001b[4C\u001b[1BForge North's new workshop moved 2.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill to do, recorded in the plan:\u001b[38G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GConsole and TUI comman\u001b[28Gs for founding, the\u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
