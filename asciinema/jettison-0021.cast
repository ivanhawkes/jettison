;166;226;46mEnded\u001b[38;2;248;248;242m();\u001b[99G++calls)\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m3\u001b[15G\u001b[38;2;248;248;242m  hosted.world.\u001b[38;2;166;226;46mFastForward\u001b[38;2;248;248;242m(hosted.world.\u001b[38;2;166;226;46mClock\u001b[38;2;248;248;242m().\u001b[38;2;166;226;46mStep\u001b[38;2;248;248;242m() + \u001b[38;2;190;132;255m3'600\u001b[38;2;248;248;242m);       \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m4\u001b[15G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(registry.\u001b[38;2;166;226;46mget\u001b[38;2;248;248;242m<World::Journey>(ship).leg == World::Leg::Arrived);            \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m5\u001b[15G\u001b[38;2;117;113;94m// Once it tried to unload the two totes it no longer held, refused at every retry.\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m6\u001b[15G\u001b[38;2;166;226;46mREQUIRE\u001b[38;2;248;248;242m(hosted.\u001b[38;2;166;226;46mSetPolicy\u001b[38;2;248;248;242m(kAda,\u001b[46G{\u001b[38;2;230;219;116m\"Ship1\"\u001b[38;2;248;248;242m,\u001b[56G\u001b[38;2;190;132;255mtrue\u001b[38;2;248;248;242m,\u001b[62G\u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m,\u001b[65G\u001b[38;2;190;132;255m100'000\u001b[38;2;248;248;242m})\u001b[75G==\u001b[78GResult::Succeeded);\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m7\u001b[15G\u001b[38;2;166;226;46mCHECK_FALSE\u001b[38;2;248;248;242m(          \u001b[38G  \u001b[41G                     \u001b[63G  \u001b[66G                     \u001b[88G  \u001b[91G                       \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m1208\u001b[13G\u001b[38;2;248;248;242m   \u001b[19Ghosted.\u001b[38;2;166;226;46mJob\u001b[38;2;248;248;242m().phase == World::Phase::Blocked && hosted.\u001b[38;2;166;226;46mJob\u001b[38;2;248;248;242m().blockage == World::Blockage::Refuse\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m    \u001b[13G\u001b[38;2;248;248;242md);\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1209 +\u001b[38;2;248;248;242m}                                           