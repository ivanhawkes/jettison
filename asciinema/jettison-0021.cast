1b[17GEast's\u001b[24GBronze\u001b[31Gand\u001b[35Gseveral\u001b[43Grelief\u001b[50Gtenders.\u001b[59GI'm\u001b[63Gchecking\u001b[72Gthe\u001b[76Grest\u001b[81Gof\u001b[84Gthe\u001b[88Grun\u001b[92Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe full run now works, and\u001b[31Gthe\u001b[35Gonly\u001b[40Gfailure\u001b[48Gis\u001b[51Ga\u001b[53G50,000-credit\u001b[67Ggap\u001b[71Gin\u001b[74Gthe\u001b[78Gfixture's\u001b[88Gledger,\u001b[96Gsince\u001b[102Gprovisioning\u001b[115GBea\r\u001b[1B  and Cara doesn't mint their starting credits the way the bootstrap does for Ada. I'm fixing that, then removing the\r\u001b[2C\u001b[1Bdebug lines and pinning the hash.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GImprovising… \u001b[47G\u001b[38;2;153;153;153mthought for 16s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
