[0.016, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 1654 \u001b[22m {\u001b[K\r\u001b[9C\u001b[1B\u001b[2m5\u001b[13G\u001b[22m \u001b[15G\u001b[38;2;166;226;46mconst\u001b[21Gdouble\u001b[28G\u001b[39mfixedStep\u001b[38G=\u001b[40Ghosted.world.\u001b[38;2;166;226;46mFixedStep\u001b[39m();\r\u001b[9C\u001b[1B\u001b[2m6\u001b[21G\u001b[22mstd::\u001b[38;2;166;226;46muint64_t\u001b[39m \u001b[36Gnd = hosted.world.\u001b[38;2;166;226;46mClock\u001b[39m().\u001b[38;2;166;226;46mStep\u001b[39m()\u001b[69G+\u001b[71GManifest::Procurement::\u001b[38;2;166;226;46mSteps\u001b[39m(days,\u001b[106GfixedSte\r\u001b[6C\u001b[1B\u001b[2m    \u001b[13G\u001b[22mp);\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAda's\u001b[9Gjob\u001b[13Gwon\u001b[17Gthe\u001b[21Gguild's\u001b[29Gthird\u001b[35Gcopper\u001b[42Gtender\u001b[49Gand\u001b[53Gsmelting\u001b[62Gunlocked\u001b[71Gabout\u001b[77Gsix\u001b[81Gsimulated\u001b[91Gdays\u001b[96Gin,\u001b[100Gwith\u001b[105Gher\u001b[109Gship\u001b[114Galso\r\u001b[1B \u001b[3Gfilling Forge\u001b[17GEast's Bronze an\u001b[35Gseveral relief tenders. I'm che\u001b[68Ging the rest\u001b[81Gof the run next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gfull\u001b[12Grun\u001b[16Gnow\u001b[20Gworks,\u001b[27Gand\u001b[31Gthe\u001b[35Gonly\u001b[40Gfailure\u001b[48Gis\u001b[51Ga\u001b[53G50,000-credit\u001b[67Ggap\u001b[71Gin\u001b[74Gthe\u001b[78Gfixture's\u001b[88Gledger,\u001b[96Gsince\u001b[102Gprovisioning\u001b[115GBea\r\u001b[1B \u001b[3Gand\u001b[7GCara\u001b[12Gdoes\u001b[17G't\u001b[20Gmint their\u001b[31Gstarting\u001b[40Gcredits\u001b[48Gthe way the boots\u001b[66Grap does for Ada. I\u001b[86Gm\u001b[88Gfixing that, then rem\u001b[110Gv\u001b[115Gthe\r\u001b[2C\u001b[1Bdebug lines a\u001b[17Gd pin\u001b[23Ging the\u001b[31Ghash.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'../manifest'\u001b[28G&&\u001b[31Gctest\u001b[37G--preset\u001b[46Gclang-debug\u001b[58G-R…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && ctest --preset clang-debug -R \"^fixture_development$\" --output-on-failure 2>&1 | grep -vE \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m\"\\\\[info\\\\]\" | grep -E \"MESSAGE|ERROR|valu\u001b[49Gs|Test #|passed\"\u001b[66G| head -30\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
