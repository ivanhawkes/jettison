[0.109, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G- \u001b[1mWhere the limit comes from:\u001b[22m Manif\u001b[39Gs\u001b[41G's\u001b[44Gserver builds\u001b[58Ga\u001b[60Gsnapshot\u001b[69Gafter\u001b[75Gevery\u001b[81Gbatch\u001b[87Gof\u001b[90Gsteps\u001b[96G(\u001b[38;2;177;185;249mmain.cpp:116\u001b[39m,\u001b[111Gthen\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mServer::Publish\u001b[39m).\u001b[23GJettison's\u001b[34Gnetwork\u001b[42Gserver\u001b[49Gthen\u001b[54Gskips\u001b[60Gany\u001b[64Gclient\u001b[71Gwhose\u001b[77Glast\u001b[82Gsnapshot\u001b[91Gis\u001b[94Gless\u001b[99Gthan\u001b[104G\u001b[38;2;177;185;249msnapshotInterval\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gold. That defaults to 100 ms (\u001b[38;2;177;185;249mjettison/net/Server.h:39\u001b[39m), \u001b[63Gnd Mani\u001b[71Gest\u001b[75Gdo\u001b[78Gsn't override it.\u001b[96G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat each one costs:\u001b[22m every \u001b[33Gnapsh\u001b[39Gt i\u001b[43G that\u001b[49Gplayer's full fi\u001b[66Gt\u001b[68Gred view, wi\u001b[81Gh \u001b[84Go del\u001b[90Gas.\u001b[94GIn the trading scenario\u001b[K\r\u001b[4C\u001b[1Bthat\u001b[10Gis about 63.5\u001b[24GKB, so\u001b[31Groughly 635 KB/s, or about 5 Mbit/s, per client. I\u001b[83Ggo\u001b[86Gs on the unreliable\u001b[106Gchannel,\u001b[115Gwhere\r\u001b[2C\u001b[1B \u001b[5Ga newer snapshot replac\u001b[29Gs one still\u001b[42Gn\u001b[44Gflight.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mServer-side work:\u001b[22m the server also\u001b[39Gruns \u001b[38;2;177;185;249mQuery::Observe\u001b[39m and serialises the result for every\u001b[95Gcli\u001b[99Gnt at that rate.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat is a lot for a\u001b[23Ggame where\u001b[34Gthe simulation's economy\u001b[59Gturn\u001b[64G once a \u001b[73Gimulat\u001b[80Gd hour and t\u001b[93Gave\u001b[97G takes minu\u001b[109Ges \u001b[113Go days.\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gwant,\u001b[16Ga\u001b[18Gcheap\u001b[24Gfirst\u001b[30Gstep\u001b[35Gbefore\u001b[42Gsplitting\u001b[52Gmessages\u001b[61Gor\u001b[64Gadding\u001b[71Gdeltas\u001b[78Gis\u001b[81Gto\u001b[84Gset\u001b[88G\u001b[38;2;177;185;249msnapshotInterval\u001b[105G\u001b[39mto\u001b[108G1\u001b[110Gs,\u001b[113Gor\u001b[116Gsend\r\u001b[2C\u001b[1Bonly\u001b[8Gwhen\u001b[13Gthe\u001b[17Gclient's view has changed. E\u001b[46Gther\u001b[51Gwould cu\u001b[60G the\u001b[65Gload\u001b[71Gbout tenfold, though neither fixes the 64 KiB\u001b[K\r\u001b[2C\u001b[1Blimit.\u001b[10G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 31s · done 1:10 am\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mset snapshotInterval to 1 second\u001b[39m                                                                                      \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[39m Searching for \u001b[1m2\u001b[22m patterns…\u001b[K\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m9s ·\u001b[20G↓\u001b[39m \u001b[38;2;153;153;153m382\u001b[27Goke\u001b[31Gs · thought for 2s)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
