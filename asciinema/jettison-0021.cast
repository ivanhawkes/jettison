[0.032, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- Her job also supplie\u001b[28G Forge East's Bronze, which its AI worked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[2C\u001b[1B \u001b[5G- Bea\u001b[11Gj\u001b[13Gins late and founds Forge South; C\u001b[48Gra is\u001b[54Gr\u001b[56Gfus\u001b[60Gd in every region.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Loading a mid-run save and\u001b[34Greplaying from the start\u001b[59Gboth\u001b[64Greach\u001b[70Gthe\u001b[74Gsame\u001b[79Gpinned\u001b[86Gworld.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery\u001b[62Gother\u001b[68Gcheck\u001b[74Gin\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gqueue's\u001b[17Gnew\u001b[21Gsaved\u001b[27Gfield\u001b[33Gmoved\u001b[39G2\u001b[41Gpins.\r\u001b[2C\u001b[1B- The policy's comp\u001b[23Gnent storage moved 4, bec\u001b[49Guse a save lists it eve\u001b[73G when\u001b[79Gempty.\u001b[K\r\u001b[2C\u001b[1B- Forge North's new workshop moved 2.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mStill to do, recorded in the plan:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- Console and TUI commands\u001b[30Gfor\u001b[34Gfounding,\u001b[44Gthe\u001b[48Gqueue\u001b[54Gand\u001b[58Gthe\u001b[62Gpolicy.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mFound\u001b[11G\u001b[39mdoesn't\u001b[19Gcheck\u001b[25Gthe\u001b[29Gregional\u001b[38Gplan's\u001b[45Gstation,\u001b[54Gdelivery\u001b[63Gand\u001b[67Glife-support\u001b[80Gconditions\u001b[91Gfor\u001b[95Ga\u001b[97Ghomeworld.\r\u001b[1B \u001b[3G- Reordering a queue (for now, cancel\u001b[41Gand\u001b[45Gqueue\u001b[51Gagain).\r\u001b[2C\u001b[1B-\u001b[5GRelief\u001b[12Gtenders\u001b[20Gunder\u001b[26Ga\u001b[28Gplayer's\u001b[37Gpolicy.\r\u001b[1B \u001b[3G- AI acquisition (L03) and region supply (D-076).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe home-region allocation in \u001b[38;2;177;185;249mscope.md\u001b[39m, the Manifest roadmap,\u001b[65GD-076\u001b[71Gand\u001b[75Gthe\u001b[79Gregional\u001b[88Gplan\u001b[93Gnow\u001b[97Greads\u001b[103Gas\u001b[106Gfounding.\r\u001b[2C\u001b[1BJettison's\u001b[14Groadmap\u001b[22Gand\u001b[26Ghistory\u001b[34Gare\u001b[38Gupdated\u001b[46G(\u001b[38;2;177;185;249m69e0963\u001b[39m).\u001b[57GNo\u001b[60Gcross-review\u001b[73Gyet:\u001b[78Gthat\u001b[83Gcomes\u001b[89Gwhen\u001b[94GW14\u001b[98Gcloses\u001b[105Gthe\u001b[109Gstage.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BUnder\u001b[9GASan\u001b[14Gthe\u001b[18Gnew\u001b[22Gfixture\u001b[30Gtakes\u001b[36G352\u001b[40Gs,\u001b[43Gwhich\u001b[49Glengthens\u001b[59Gthe\u001b[63Ggate.\u001b[69GThis\u001b[74Gis\u001b[77Ga\u001b[79Gnatural\u001b[87Gpoint\u001b[93Gto\u001b[96G\u001b[38;2;177;185;249m/compact\u001b[105G\u001b[39mor\u001b[108Gstart\u001b[114Ga\u001b[116Gnew\r\u001b[1B \u001b[3Gsession before W14.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
