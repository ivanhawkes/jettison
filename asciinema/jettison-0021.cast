[0.007, "o", "\u001b[?25l\u001b[H\u001b[3G1.\u001b[6G\u001b[1mNetwork snapshots are now complete\u001b[22m (\u001b[38;2;177;185;249mProtocol.cpp\u001b[39m). A remote client's\u001b[75Gsnapshot\u001b[84Gnow\u001b[88Gincludes\u001b[97Gits\u001b[101Gships'\u001b[108Gpolicies\u001b[117Gand\r\u001b[5C\u001b[1Bjobs, its company's sealed bids and the posted tenders. A new remote test sends a snapshot holding all of them\u001b[117Gover\r\u001b[5C\u001b[1Bthe network format and gets it back unchanged.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRefuelling from a pellet cargo updates the job.\u001b[22m If the magazine is refilled from totes the job is carrying to\u001b[116Gsell,\r\u001b[5C\u001b[1Bthose totes leave the job's lot along with their share of its cost, spare pellets first. To share the rule with\r\u001b[5C\u001b[1Bthe seizure, I moved it from the policy code into World as \u001b[38;2;177;185;249mWorld::LeaveLot\u001b[39m. In the new policy test, Codex's\u001b[K\r\u001b[5C\u001b[1Btwo-tote\u001b[15Gjob\u001b[19Gleaves\u001b[26Gcarrying\u001b[35Gone\u001b[39Gtote\u001b[44Gat\u001b[47Ghalf\u001b[52Gits\u001b[56Gcost\u001b[61Gand\u001b[65Gno\u001b[68Glonger\u001b[75Gblocks\u001b[82Gon\u001b[85Garrival.\r\u001b[2C\u001b[1B3. \u001b[1mBidders check the delivery window.\u001b[22m A job now\u001b[51Gbids\u001b[56Gonly\u001b[61Gwhen\u001b[66Gits\u001b[70Gestimated\u001b[80Groute\u001b[86Gfits\u001b[91Gthe\u001b[95Gtender's\u001b[104Gdelivery\u001b[113Gwindow.\r\u001b[5C\u001b[1BIn\u001b[9GCodex's\u001b[17Gcase,\u001b[23Ga\u001b[25Gone-day\u001b[33Gwindow\u001b[40Gagainst\u001b[48Ga\u001b[50G7.6-day\u001b[58Groute,\u001b[65Git\u001b[68Gno\u001b[71Glonger\u001b[78Gbids.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinding 2, oversized snapshots, is scheduled:\r\u001b[2C\u001b[1B\u001b[22m- Jettison's roadmap now lists splitting a message across packets\u001b[69Gfor\u001b[73Gthe\u001b[77Gnext\u001b[82Gengine\u001b[89Gchange,\u001b[97Gwith\u001b[102Gdelta\u001b[108Gsnapshots\u001b[118Gin\r\u001b[4C\u001b[1BManifest\u001b[14Gonly\u001b[19Gif\u001b[22Gthat\u001b[27Gisn't\u001b[33Genough\u001b[40G(Jettison\u001b[50G\u001b[38;2;177;185;249m71e9a31\u001b[39m).\r\u001b[1B \u001b[3G- Until then, a remote\u001b[26Gclient's view fr\u001b[43Gezes when\u001b[53Gver its sn\u001b[64Gpshot passes 64 KiB, which the trading scenario reaches\r\u001b[2C\u001b[1B  with about ten resting orders.\u001b[K\r\u001b[2C\u001b[1B- Manifest's Stage 4 plan, history and handoff record\u001b[57Gthe\u001b[61Gsame.\r\u001b[2B \u001b[3GThe two new policy \u001b[24Gsts\u001b[28Gpass \u001b[34Gow,\u001b[38Gbut I\u001b[44Gdidn't\u001b[51Grerun\u001b[57Gthem\u001b[62Gon\u001b[65Gthe\u001b[69Gold\u001b[73Gcode\u001b[78Gto\u001b[81Gsee\u001b[85Gthem\u001b[90Gfail.\u001b[96GThey\u001b[101Gfollow\u001b[108GCodex's\r\u001b[1B  reproductions, which showed the old behaviour.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 36m 9s ·\u001b[24Gdone 1:02\u001b[34Gam\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.347, "o", "\u001b[?25l\u001b[H\r\u001b[47C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m6\u001b[50G1\u001b[54G603\u001b[22m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[185.360, "o", "\u001b[?25l\u001b[H\u001b[3G2\u001b[6G\u001b[1mR\u001b[8Gfuelling from a\u001b[24Gpellet cargo updates the job.\u001b[22m If\u001b[57Gthe \u001b[62Gagazine is refilled from totes the\u001b[97Gjob\u001b[101Gis carrying to sell,\r\u001b[5C\u001b[1Btho\u001b[10Ge\u001b[12Gtotes le\u001b[21Gve the job's lot\u001b[39Glong with \u001b[50Gheir sha\u001b[59Ge of\u001b[64Gits\u001b[68Gcost, spare\u001b[80Gp\u001b[82Gllets\u001b[88Gfirst. To share the rule with\u001b[K\r\u001b[9C\u001b[1Bs\u001b[12Gizu\u001b[16Ge, I \u001b[22Goved it from \u001b[36Ghe policy cod\u001b[50G into\u001b[56GWorld\u001b[62Gas\u001b[65G\u001b[38;2;177;185;249mWorld::LeaveLot\u001b[39m.\u001b[82GIn\u001b[85Gthe\u001b[89Gnew\u001b[93Gpolicy\u001b[100Gtest,\u001b[106GCodex's\r\u001b[2C\u001b[1B  \u001b[6Gtwo-tote job leaves carrying one tote at half its cost\u001b[61Gand no longe\u001b[74G blocks\u001b[82Gon arrival.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mBidders check the delivery window.\u001b[22m A job now b\u001b[53Gds only\u001b[61Gwhen its estimated\u001b[80Grout\u001b[85G fits the\u001b[95Gtender's\u001b[104Gdelivery\u001b[115Gndow.\r\u001b[5C\u001b[1BIn Codex's case, a one-day window against a 7.6-day \u001b[59Goute,\u001b[65Git no longer bids.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFind\u001b[8Gng 2,\u001b[14Gov\u001b[17Grsized\u001b[24Gsnapshots, is scheduled:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison's ro\u001b[19Gdmap n\u001b[26Gw lists splitting a message across packe\u001b[67Gs for th\u001b[76G next engine\u001b[89Gchange,\u001b[97Gwith\u001b[102Gdelta\u001b[108Gsnapshots\u001b[118Gin\r\u001b[4C\u001b[1BManifest\u001b[14Gonly\u001b[19Gif\u001b[22Gthat\u001b[27Gisn't\u001b[33Genough\u001b[40G(Jettison\u001b[50G\u001b[38;2;177;185;249m71e9a31\u001b[39m).\r\u001b[2C\u001b[1B- Until then, a remote client's view freezes whenever\u001b[57Gits\u001b[61Gsnapshot\u001b[70Gpasses\u001b[77G64\u001b[80GKiB,\u001b[85Gwhich\u001b[91Gthe\u00