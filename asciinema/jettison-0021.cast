[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  - The loaded\u001b[18Gworld\u001b[24Greaches\u001b[32Gthe\u001b[36Gsame\u001b[41Gpinned\u001b[48Ghash\u001b[53Gand\u001b[57Gthe\u001b[61Gsame\u001b[66Gviews\u001b[72Gfor\u001b[76GAda,\u001b[81GBea\u001b[85Gand\u001b[89Gthe\u001b[93Ghost.\u001b[99GBea's\u001b[105Gbid\u001b[109Gexpires\u001b[117Gand\r\u001b[6C\u001b[1Bher\u001b[11Gmoney\u001b[17Gcomes\u001b[23Gback.\r\u001b[2C\u001b[1B- \u001b[1mPin:\u001b[22m the hash\u001b[19Gmoved\u001b[25Gto\u001b[28G\u001b[38;2;177;185;249m0xa78c569537d6dabaULL\u001b[50G\u001b[39mbecause\u001b[58GBea's\u001b[64Gorders\u001b[71Gare\u001b[75Gnew\u001b[79Gstate;\u001b[86Gevery\u001b[92Gother\u001b[98Gcheck\u001b[104Gpasses.\r\u001b[4C\u001b[1B\u001b[1mDocs:\u001b[22m the plan's step tabl\u001b[32G was miss\u001b[42Gng \u001b[38;2;177;185;249mmanifest.policy\u001b[39m, al\u001b[65Ghough\u001b[71Gthe \u001b[38;2;177;185;249mtravel\u001b[82G\u001b[39msuite already pins\u001b[101Git. The new\r\u001b[4C\u001b[1Bclose-out m\u001b[17Gps\u001b[20Geach p\u001b[27Grt of the Stage\u001b[43G4\u001b[45Gexit\u001b[50Gcriterion\u001b[60Gto\u001b[63Gthe\u001b[67Gtest\u001b[72Gthat\u001b[77Gcovers\u001b[84Git.\u001b[88GThe\u001b[92GStage\u001b[98G5\u001b[100Ghandoff\u001b[108Gpoints\u001b[115Gto\r\u001b[4C\u001b[1Bwhere each\u001b[16Gc\u001b[18Gntract is\u001b[28Gdefined.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate:\u001b[11G\u001b[22m\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m \u001b[35Gassed in\u001b[45Gll\u001b[48Gfour presets, tidy clean. Jettison's\u001b[85Groadmap and history are updated\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249m8f6e3dc\u001b[39m).\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe cross-review\u001b[20G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gcopied Co\u001b[17Gex's test \u001b[28Gases to\u001b[36G\u001b[38;2;177;185;249mbuild/reviews/stage-4/round-1-salvage\u001b[39m and checked their log\u001b[96G and the\u001b[105Gco\u001