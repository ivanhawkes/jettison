[0.007, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow many snapshots are we sending per second?\u001b[39m                                                                         \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m6\u001b[22m patterns,\u001b[28Gran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m At most 10 per second for each connected client.\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mWhere the limit comes from:\u001b[33G\u001b[22mManifest's\u001b[44Gserver\u001b[51Gbuilds\u001b[58Ga\u001b[60Gsnapshot\u001b[69Gafter\u001b[75Gevery\u001b[81Gbatch\u001b[87Gof\u001b[90Gsteps\u001b[96G(\u001b[38;2;177;185;249mmain.cpp:116\u001b[39m,\u001b[111Gthen\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mServer::Publish\u001b[39m).\u001b[23GJettison's\u001b[34Gnetwork\u001b[42Gserver\u001b[49Gthen\u001b[54Gskips\u001b[60Gany\u001b[64Gclient\u001b[71Gwhose\u001b[77Glast\u001b[82Gsnapshot\u001b[91Gis\u001b[94Gless\u001b[99Gthan\u001b[104G\u001b[38;2;177;185;249msnapshotInterval\r\u001b[1B\u001b[39m \u001b[3G \u001b[5Gold. That defaults to 100 ms (\u001b[38;2;177;185;249mjettison/net/Server.h:39\u001b[39m),\u001b[62Gand Manifest doesn\u001b[81Gt\u001b[83Goverride it.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWha\u001b[9G each one costs:\u001b[22m every snapshot\u001b[41Gis\u001b[44Gthat\u001b[49Gplayer's\u001b[58Gfull\u001b[63Gfiltered\u001b[72Gview,\u001b[78Gwith\u001b[83Gno\u001b[86Gdeltas.\u001b[94GIn\u001b[97Gthe\u001b[101Gtrading\u001b[109Gscenario\r\u001b[2C\u001b[1B \u001b[5Gthat is about 63.5 KB, so roughly\u001b[39G635\u001b[43GKB/s,\u001b[49Gor\u001b[52Gabout\u001b[58G5\u001b[60GMbit/s,\u001b[68Gper\u001b[72Gclient.\u001b[80GIt\u001b[83Ggoes\u001b[88Gon\u001b[91Gthe\u001b[95Gunreliable\u001b[106Gchannel,\u001b[115Gwhere\r\u001b[4C\u001b[1Ba\u001b[7Gnewer\u001b[13Gsnapshot\u001b[22Greplaces\u001b[31Gone\u001b[35Gstill\u001b[41Gin\u001b[44Gflight.\r\u001b[1B \u001b[3G- \u001b[1mServer-side work:\u001b[22m the server\u001b[34Galso\u001b[39Gruns\u001b[44G\u001b[38;2;177;185;249mQuery::Observe\u001b[59G\u001b[39mand\u001b[63Gserialises\u001b[74Gthe\u001b[78Gresult\u001b[85Gfor\u001b[89Gevery\u001b[95Gclient\u001b[102Gat\u001b[105Gthat\u001b[110Grate.\r\u001b[2B  That is a lot for a game where the simulation's economy turns once a simulated hour and travel takes minutes to days.\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gwant,\u001b[16Ga\u001b[18Gcheap\u001b[24Gfirst\u001b[30Gstep\u001b[35Gbefore\u001b[42Gsplitting\u001b[52Gmessages\u001b[61Gor\u001b[64Gadding\u001b[71Gdeltas\u001b[78Gis\u001b[81Gto\u001b[84Gset\u001b[88G\u001b[38;2;177;185;249msnapshotInterval\u001b[105G\u001b[39mto\u001b[108G1\u001b[110Gs,\u001b[113Gor\u001b[116Gsend\r\u001b[1B \u001b[3Gonly when\u001b[13Gthe\u001b[17Gclien\u001b[23G's view has changed. Either would\u001b[57Gcut\u001b[61Gthe\u001b[65Gload\u001b[70Gabout\u001b[76Gtenfold,\u001b[85Gthough\u001b[92Gneither\u001b[100Gfixes\u001b[106Gthe\u001b[110G64\u001b[113GKiB\r\u001b[1B  limit.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for \u001b[20Gdone 1:10 am\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
