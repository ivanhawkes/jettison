[0.067, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m5\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 117 \u001b[22m (2026-11-23): [\u001b[38;2;230;219;116mregional governance\u001b[39m](stage-4-trading-plan.md#regional-governance-w13-2026-11-23) on\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 118 \u001b[22m [\u001b[38;2;230;219;116mD-110\u001b[39m](decision-ledger.md#d-110), a homeworld founded in a region no one governs, its projects queued\r\u001b[5C\u001b[1B\u001b[2m 119 \u001b[22m and tendered under its governor's standing policy with no client beside the AI neighbours', a late\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 120 -\u001b[38;2;248;248;242mjoiner founding the last free region (`fixture_development`), with no engine edit. \u001b[48;2;92;2;0mNext: \u001b[48;2;61;1;0mW14\u001b[48;2;92;2;0m,\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mclosing\u001b[48;2;61;1;0m \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 121 -\u001b[38;2;248;248;242mStage 4; W22 waits for the first larger hull.                                                         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m20 +\u001b[38;2;248;248;242mjoiner founding the last free region\u001b[49G(`fixture_development`), with no engine edit. W14 \u001b[48;2;4;71;0mis done\u001b[48;2;2;40;0m        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m21 +\u001b[38;2;248;248;242m(2026-11-23): **Stage 4\u001b[36Gis closed**,\u001b[49Gits\u001b[53Gchecks\u001b[60Geach\u001b[65Gheld\u001b[70Gby\u001b[73Ga\u001b[75Ggated\u001b[81Gtest,\u001b[87Gthe\u001b[91Gfour\u001b[96Gstrands\u001b[104Gproved\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m22 +\u001b[38;2;248;248;242mtogether\u001b[21Gin the dev\u001b[32Glopment\u001b[40Gfixtur\u001b[47G, \u001b[50Gaved with a journey and an order open and continued from the  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[10G +\u001b[38;2;248;248;242mpack ([\u001b[38;2;230;219;116mdelivered\u001b[38;2;248;248;242m](stage-4-trading-plan.md#delivered-w14-2026-11-23)), with no engine edit. Next: the  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m24 +\u001b[38;2;248;248;242mstage's cross-review, then R01; W22 waits for the first larger hull.                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 125 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 126 \u001b[22m ## Priority 0: maintenance before Stage 1\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 127 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m1\u001b[19G\u001b[22mpattern,\u001b[28Greading\u001b[36G\u001b[1m1\u001b[38G\u001b[22mfile…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ awk '/^## W13: regional governance/{p=1;print;next} p&&/^## /{exit} p' \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m'\u001b[8Ghome/ivan/proj\u001b[23Gc\u001b[25Gs/manif\u001b[33Gst'/docs/history.md\r\u001b[14C\u001b[2B9m 8s · ↓\u001b[39m \u001b[38;2;153;153;153m26.3k tok\u001b[35Gns)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
