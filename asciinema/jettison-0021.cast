[0.081, "o", "\u001b[?25l\u001b[H\u001b[5Gpays\u001b[10G\u001b[38;2;177;185;249mcompany.foundingPrice\u001b[32G\u001b[39m(200,000,\u001b[42Gmy\u001b[45Gtest\u001b[50Gvalue)\u001b[57Ginto\u001b[62Gthe\u001b[66Gregion's\u001b[75Gtreasury,\u001b[85Gand\u001b[89Ga\u001b[91Gnew\u001b[95Gpolity\u001b[102Gthe\u001b[106Gplayer\u001b[113Gdirects\r\u001b[4C\u001b[1Bbecomes\u001b[13Gits\u001b[17Ggovernor.\u001b[27GNo\u001b[30Gcommand\u001b[38Gtakes\u001b[44Ga\u001b[46Ggoverned\u001b[55Gregion\u001b[62Gaway\u001b[67Gfrom\u001b[72Gits\u001b[76Gplayer.\r\u001b[2C\u001b[1B- \u001b[1mThe queue:\u001b[22m a region's\u001b[27Gprojects\u001b[36Grun\u001b[40Gone\u001b[44Gat\u001b[47Ga\u001b[49Gtime\u001b[54Gin\u001b[57Gqueue\u001b[63Gorder\u001b[69G(\u001b[38;2;177;185;249mManifest.Procurement.Queue\u001b[39m,\u001b[98G\u001b[38;2;177;185;249mCancelProject\u001b[39m).\u001b[114GA\r\u001b[4C\u001b[1Bproject\u001b[13Gcancelled\u001b[23Gwhile\u001b[29Gstill\u001b[35Gtendering\u001b[45Gkeeps\u001b[51Gwhat\u001b[56Gwas\u001b[60Gdelivered\u001b[70Gfor\u001b[74Ga\u001b[76Glater\u001b[82Grequeue.\u001b[91GI\u001b[93Gadded\u001b[99Ga\u001b[101Gsecond\u001b[108Gproject,\u001b[117Gthe\r\u001b[1B \u001b[3G  s\u001b[7Gel\u001b[10Gers' guild,\u001b[22Gwhich teaches smelting so \u001b[49G region lacking\u001b[68G skill can queue it ahead of\u001b[97GBronze.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe standing policy:\u001b[26G\u001b[22m\u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[62G\u001b[39mlets\u001b[67Gthe\u001b[71GAI\u001b[74Gissuer\u001b[81Gtender\u001b[88Gthe\u001b[92Ghead\u001b[97Gproject's\u001b[107Ginputs\u001b[114Gfor\u001b[118Ga\r\u001b[2C\u001b[1B  player's region, within\u001b[29Ga\u001b[31Gspending\u001b[40Glimit\u001b[46Gand\u001b[50Gfrom\u001b[55Gthe\u001b[59Gtreasury\u001b[68Galone.\u001b[75GWhen\u001b[80Git\u001b[83Gholds\u001b[89Gback,\u001b[95Git\u001b[98Grecords\u001b[106Gwhy\u001b[110G(over\u001b[116Gthe\r\u001b[4C\u001b[1Blimit,\u001b[12Gor\u001b[15Gno\u001b[18Gfunds).\r\u001b[1B \u001b[3G- \u001b[1mThe region view:\u001b[22m every player\u001b[35Gsees every re\u001b[49Gion and it\u001b[60G governor. The treasury, queue an\u001b[94G policy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[4C\u001b[1Bits\u001b[9Ggovernor\u001b[18Gand\u001b[22Gthe\u001b[26Ghost.\u001b[32GThe\u001b[36Gview\u001b[41Galso\u001b[46Ggoes\u001b[51Gto\u001b[54Gnetwork\u001b[62Gclients,\u001b[71Gso\u001b[74Ga\u001b[76Greconnecting\u001b[89Gclient\u001b[96Ggets\u001b[101Git.\r\u001b[2C\u001b[1B- \u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_development\u001b[39m:\r\u001b[4C\u001b[1B\u001b[22m-\u001b[7GAda\u001b[11Gfounds\u001b[18GForge\u001b[24GNorth.\u001b[31GWith\u001b[36Gno\u001b[39Gclient\u001b[46Gconnected,\u001b[57Gher\u001b[61Gship's\u001b[68Gjob\u001b[72Gsupplies\u001b[81Gthe\u001b[85Gguild\u001b[91Gand\u001b[95GBronze,\u001b[103Gand\u001b[107Gboth\u001b[112Gfinish\r\u001b[1B \u001b[3G   \u001b[7Gwi\u001b[10Gh\u001b[12Gn about fifteen simulated days.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GHer\u001b[11Gjob\u001b[15Galso\u001b[20Gsupplied\u001b[29GForge\u001b[35GEast's\u001b[42GBronze,\u001b[50Gwhich\u001b[56Gits\u001b[60GAI\u001b[63Gworked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[1B \u001b[3G  - Bea joins l\u001b[19Gte\u001b[22Gan\u001b[26Gfounds Forge South; Cara is refus\u001b[60Gd in every region.\u001b[K\r\u001b[2C\u001b[1B  - Loading a mid-run save and replaying from the start bo\u001b[62Gh reac\u001b[70Gthe same\u001b[79Gpinned\u001b[86Gworl\u001b[91G.\u001b[93G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery\u001b[62Gother\u001b[68Gcheck\u001b[74Gin\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[1B \u001b[3G- The queue's\u001b[17Gnew saved field\u001b[33Gmoved\u001b[39G2\u001b[41Gpins.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gpolicy's\u001b[18Gcomponent\u001b[28Gstorage\u001b[36Gmoved\u001b[42G4,\u001b[45Gbecause\u001b[53Ga\u001b[55Gsave\u001b[60Glists\u001b[66Git\u001b[69Geven\u001b[74Gwhen\u001b[79Gempty.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.140, "o", "\u001b[?25l\u001b[H\u001b[5Gbecomes its governor. No command takes a governed region\u001b[62Gaway from its pl\u001b[79Gye\u001b[82G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe queue:\u001b[22m a region's\u001b[27Gprojects run one\u001b[45Gt a tim\u001b[53G in queue order (\u001b[38;2;177;185;249mManifest.Procurement.Queue\u001b[39m,\u001b[98G\u001b[38;2;177;185;249mCancelProject\u001b[39m).\u001b[114GA\r\u001b[2C\u001b[1B \u001b[5Gproject cancelled while still tendering keeps what was d\u001b[62Glivered for a later requeue. I added a second project,\u001b[117Gthe\r\u001b[4C\u001b[1Bsmelters' gui\u001b[19Gd, which teaches smelt\u001b[45Gso a region lacking th\u001b[68G skill can queu\u001b[84G it ahead of Bronz\u001b[103G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe standing policy:\u001b[22m \u001b[38;2;177;185;249mManifest.Procurement.SetDevelopment\u001b[39m lets the AI issuer tender\u001b[88Gt\u001b[91G head\u001b[97Gp\u001b[100Gject's\u001b[107Ginputs\u001b[114Gfor\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Gplayer's region, within a spending limit and from the treasury alone. When i\u001b[82G holds back, it \u001b[99Gecords why (over the\r\u001b[4C\u001b[1Blimit, or no funds).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe region view:\u001b[22m every\u001b[28Gplayer\u001b[35Gsees\u001b[40Gevery\u001b[46Gregion\u001b[53Gand\u001b[57Gits\u001b[61Ggovernor.\u001b[71GThe\u001b[75Gtreasury,\u001b[85Gqueue\u001b[91Gand\u001b[95Gpolicy\u001b[102Gare\u001b[106Gshown\u001b[112Gonly\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5Gits governor and\u001b[22Gth\u001b[25G host. The view also\u001b[46Ggoes to \u001b[55Getwork clie\u001b[67Gts,\u001b[71Gso a \u001b[78Gconnecting client gets it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe acceptance fixture, \u001b[38;2;177;185;249mfixture_development\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Ada founds Forge North. With no client connected,\u001b[57Gher\u001b[61Gship's\u001b[68Gjob\u001b[72Gsupplies\u001b[81Gthe\u001b[85Gguild\u001b[91Gand\u001b[95GBronze,\u001b[103Gand\u001b[107Gboth\u001b[112Gfinish\r\u001b[4C\u001b[1B \u001b[7Gwithin about fifteen simulated days.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GHer job also\u001b[20Gsupplied Forge East's Bronze,\u001b[50Gwhich\u001b[56Gits\u001b[60GAI\u001b[63Gworked\u001b[70Gon\u001b[73Gits\u001b[77Gown.\r\u001b[6C\u001b[1BB\u001b[9Ga\u001b[13Gins late and founds Forge South; Cara is refu\u001b[59Ged in ev\u001b[68Gry region.\u001b[K\r\u001b[6C\u001b[1BLo\u001b[10Gding a\u001b[17Gmid-ru\u001b[24G save and replaying from the start both r\u001b[66Gach th\u001b[73G same\u001b[79Gpinned\u001b[86Gworld.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPinned hashes moved, by save layout or content only:\u001b[56G\u001b[22mevery\u001b[62Gother\u001b[68Gcheck\u001b[74Gin\u001b[77Gthose\u001b[83Gtests\u001b[89Gstill\u001b[95Gpasses.\r\u001b[2C\u001b[1B- The queue's new saved field moved 2 pins.\u001b[K\r\u001b[8C\u001b[1Bpolicy's compon\u001b[25Gnt storage moved 4, because\u001b[53Ga\u001b[55Gsave\u001b[60Glists\u001b[66Git\u001b[69Geven\u001b[74Gwhen\u001b[79Gempty.\r\u001b[4C\u001b[1BForge North's new workshop moved 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
