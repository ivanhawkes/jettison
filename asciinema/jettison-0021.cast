 reading now.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[41C\u001b[2B\u001b[38;2;153;153;153mthought for 4s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
