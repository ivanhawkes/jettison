[0.110, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe cross-review\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gcopied Cod\u001b[18Gx's\u001b[22Gtest\u001b[27Gcases\u001b[33Gto\u001b[36G\u001b[38;2;177;185;249mbuild/reviews/stage-4/round-1-salvage\u001b[74G\u001b[39mand\u001b[78Gchecked\u001b[86Gtheir\u001b[92Glogs\u001b[97Gand\u001b[101Gthe\u001b[105Gcode.\u001b[111GThree\u001b[117Gbugs\r\u001b[2C\u001b[1B \u001b[5Greproduce:\u001b[K\r\u001b[5C\u001b[1B. \u001b[1mA huge but valid buy price aborts the server.\u001b[22m At prices near th\u001b[72G integer limit,\u001b[88Gthe money\u001b[98Gheld back\u001b[108Gper\u001b[112Gtote\r\u001b[7C\u001b[1Bfalls\u001b[14G322\u001b[18Gcredits\u001b[26Gshort\u001b[32Gof\u001b[35Gwhat\u001b[40Gthe\u001b[44Gtrade\u001b[50Gcosts,\u001b[57Gso\u001b[60Ga\u001b[62Gsafety\u001b[69Gassert\u001b[76Gin\u001b[79G\u001b[38;2;177;185;249mTrade.cpp:652\u001b[93G\u001b[39mstops\u001b[99Gthe\u001b[103Gprocess.\u001b[112GA\u001b[114Gsaved\r\u001b[2C\u001b[1B     buy with too\u001b[21Glittle\u001b[28Gheld back r\u001b[40Gaches the same assert.\u001b[63GThe\u001b[67Gfix\u001b[71Gis\u001b[74Gto\u001b[77Grefuse\u001b[84Gsuch\u001b[89Ga\u001b[91Gtrade\u001b[97Gwith\u001b[102G\u001b[38;2;177;185;249mInvalidPrice\r\u001b[2C\u001b[1B\u001b[39m \u001b[5G   instead,\u001b[17Gwhich writes nothing because\u001b[48Ge ledger is staged.\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gb. \u001b[1mA tender delivery's payment can overflow.\u001b[50G\u001b[22m\u001b[38;2;177;185;249mProcurement.cpp:621-623\u001b[74G\u001b[39madds\u001b[79Gto\u001b[82Gthe\u001b[86Gsupplier's\u001b[97Gbalance\u001b[105Gwithout\u001b[113Gthe\r\u001b[7C\u001b[1Boverflow\u001b[17Gcheck\u001b[23Gtrading\u001b[31Guses,\u001b[37Gso\u001b[40Ga\u001b[42Gbalance\u001b[50Gnear\u001b[55Gthe\u001b[59Glimit\u001b[65Gwraps\u001b[71Gto\u001b[74Gnegative.\u001b[84G\u001b[38;2;177;185;249mWorld::Owed\u001b[96G\u001b[39mcan\u001b[100Galso\u001b[105Goverflow\u001b[114Gwhe