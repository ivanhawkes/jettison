[0.638, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEach\u001b[8Gfix\u001b[12Ghas\u001b[16Ga\u001b[18Gtest\u001b[23Gwhere\u001b[29Git\u001b[32Gmatters.\u001b[41GThe\u001b[45Ggate\u001b[50G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m)\u001b[75Gpassed\u001b[82Gin\u001b[85Gall\u001b[89Gfour\u001b[94Gpresets\u001b[102Gon\u001b[105G\u001b[38;2;177;185;249mcfaef5a\u001b[39m,\u001b[114Gand\u001b[118Gno\r\u001b[2C\u001b[1Bpinned hash moved.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gnew\u001b[11Gpolicy\u001b[18Gtest\u001b[23Gcan't\u001b[29Gshow\u001b[34Gthe\u001b[38Goverflow\u001b[47Gin\u001b[50GDebug:\u001b[57Gthere\u001b[63Gthe\u001b[67Gwrapped\u001b[75Gvalue\u001b[81Ghappened\u001b[90Gto\u001b[93Gwork,\u001b[99Gso\u001b[102Gthe\u001b[106Glot\u001b[110Gsold\u001b[115Gon\u001b[118Gthe\r\u001b[2C\u001b[1Bold\u001b[7Gcode too. Only the sanitised build would hav\u001b[52G stopped on it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe review's five new blockers.\u001b[35G\u001b[22mEach\u001b[40Gcomes\u001b[46Gwith\u001b[51Ga\u001b[53Greproduction\u001b[66Gunder\u001b[72G\u001b[38;2;177;185;249mbuild/reviews/stage-4/scratch\u001b[39m:\r\u001b[2C\u001b[1B1. \u001b[1mRefuelling:\u001b[22m it buys whole totes, but the trip estimate assumes the tanks fill completely. A heavy\u001b[104Gship\u001b[109Gkeeps\r\u001b[2C\u001b[1B  \u001b[6Gchoosing a burn it can't fly and\u001b[39Gstays blocked, \u001b[55Ghough\u001b[62G \u001b[64Glower burn would work.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mFee schedule:\u001b[22m a\u001b[22Gsave wi\u001b[30Gh an\u001b[35Gempty fee\u001b[45Gschedule\u001b[54Gloads,\u001b[61Gthen crashes the first time\u001b[89Ga\u001b[91Gship\u001b[96Gtravels.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mTax\u001b[10Gcarry:\u001b[22m a s\u001b[21Gved wage-tax carry o\u001b[42G any size loads, and the next payroll throws.\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mOpened totes:\u00