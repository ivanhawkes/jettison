[0.027, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mWhere the limit comes from:\u001b[22m Manifest'\u001b[43G server builds a\u001b[60Gs\u001b[62Gapshot after \u001b[76Gvery batch of steps (\u001b[38;2;177;185;249mmain.cpp:116\u001b[39m, then\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mServer::Publish\u001b[39m). Jettison'\u001b[34Gnetwork server then skips any clie\u001b[69Gt whose last snapshot is less\u001b[99Gthan\u001b[104G\u001b[38;2;177;185;249msnapshotInterval\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gold. That defaults to 100 m\u001b[33G (\u001b[38;2;177;185;249mjettison/net/Server.h:39\u001b[39m), and Manifest doesn't\u001b[83Goverride it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat each one costs:\u001b[22m every snapshot is that\u001b[49Gplayer's\u001b[58Gfull filter\u001b[70Gd\u001b[72Gview, with\u001b[83Gn\u001b[85G deltas. In the trading sc\u001b[112Gnario\u001b[K\r\u001b[4C\u001b[1Bthat is\u001b[13Gabout 63.5 KB, so\u001b[31Groughly 635 KB/s, or\u001b[52Gabout\u001b[58G5\u001b[60GMbit/s,\u001b[68Gper\u001b[72Gclient.\u001b[80GIt\u001b[83Ggoes\u001b[88Gon\u001b[91Gthe\u001b[95Gunreliable\u001b[106Gchannel,\u001b[115Gwhere\r\u001b[2C\u001b[1B \u001b[5Ga newer snapshot replac\u001b[29Gs one still in\u001b[44Gflight.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mServer-side work:\u001b[23G\u001b[22mthe\u001b[27Gserver\u001b[34Galso\u001b[39Gruns\u001b[44G\u001b[38;2;177;185;249mQuery::Observe\u001b[59G\u001b[39mand\u001b[63Gserialises\u001b[74Gthe\u001b[78Gresult\u001b[85Gfor\u001b[89Gevery\u001b[95Gclient\u001b[102Gat\u001b[105Gthat\u001b[110Grate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat is \u001b[12G lot for \u001b[22G game wher\u001b[33G th\u001b[37G simulat\u001b[46Gon's economy turns once a simulated hour and travel takes minute\u001b[111G t\u001b[114G days.\r\u001b[2C\u001b[1BIf \u001b[7Gou wan\u001b[14G, a ch\u001b[21Gap first step\u001b[35Gbefor\u001b[41G spl\u001b[47Gting messages\u001b[61Gor adding del\u001b[75Gas is to set \u001b[38;2;177;185;249msnapshotInterval\u001b[39m to 1\u001b[110Gs,\u001b[113Gor send\r\u001b[2C\u001b[1Bonly when\u001b[13Gthe\u001b[17Gclient's\u001b[26Gview\u001b[31Ghas\u001b[35Gchanged.\u001b[44GEither\u001b[51Gwould\u001b[57Gcut\u001b[61Gthe\u001b[65Gload\u001b[70Gabout\u001b[76Gtenfold,\u001b[85Gthough\u001b[92Gneither\u001b[100Gfixes\u001b[106Gthe\u001b[110G64\u001b[113GKiB\r\u001b[2C\u001b[1Blimit.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 31s · done 1:10 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mset snapshotInterval to 1 second\u001b[39m                                                                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/manifest' && cmake --buil…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && cmake --build --preset clang-debug 2>&1 | rg -n ' error: |warning: ' | head\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.016, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249mServer::Publish\u001b[39m). Jettison's network \u001b[43Gerver then skips\u001b[60Ga\u001b[62Gy client whos\u001b[76G last snapshot is less than \u001b[38;2;177;185;249msnapshotInterval\r\u001b[4C\u001b[1B\u001b[39mold. That defaults to 100 m\u001b[34G(\u001b[38;2;177;185;249mjettison/net/Server.h:39\u001b[39m), and Ma\u001b[69Gifest doesn't override it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat each one costs:\u001b[22m every \u001b[33Gnapshot is that player's full filtered view, with\u001b[83Gno deltas. In\u001b[97Gthe\u001b[101Gtrading\u001b[109Gscenario\r\u001b[2C\u001b[1B \u001b[5Gthat is about 63.5 KB, so roughly 635 KB/s,\u001b[49Gor about\u001b[58G5 Mbit/s, p\u001b[70Gr\u001b[72Gclient. It\u001b[83Gg\u001b[85Ges on the unreliable chann\u001b[112Gl, where\r\u001b[4C\u001b[1Ba newer\u001b[13Gsnapshot replaces\u001b[31Gone still in flight.\u001b[52G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mServer-side work:\u001b[22m the s\u001b[29Grver also runs\u001b[44G\u001b[38;2;177;185;249mQuery::Observe\u001b[59G\u001b[39mand\u001b[63Gserialises\u001b[74Gthe\u001b[78Gresult\u001b[85Gfor\u001b[89Gevery\u001b[95Gclient\u001b[102Gat\u001b[105Gthat\u001b[110Grate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat\u001b[8Gis\u001b[11Ga\u001b[13Glot\u001b[17Gfor\u001b[21Ga\u001b[23Ggame\u001b[28Gwhere\u001b[34Gthe\u001b[38Gsimulation's\u001b[51Geconomy\u001b[59Gturns\u001b[65Gonce\u001b[70Ga\u001b[72Gsimulated\u001b[82Ghour\u001b[87Gand\u001b[91Gtravel\u001b[98Gtakes\u001b[104Gminutes\u001b[112Gto\u001b[115Gdays.\r\u001b[2C\u001b[1BIf you w\u001b[12Gnt, a che\u001b[22Gp first st\u001b[33Gp b\u001b[37Gfore spl\u001b[46Gtting messages or adding deltas is to set \u001b[38;2;177;185;249msnapshotInterval\u001b[39m to 1 \u001b[111G, \u001b[114Gr send\r\u001b[2C\u001b[1Bonl\u001b[7G when \u001b[14Ghe cli\u001b[21Gnt's view has\u001b[35Gchang\u001b[41Gd. E\u001b[47Gher would cut\u001b[61Gthe load abou\u001b[75G tenfold, though neither fixes the\u001b[110G64\u001b[113GKiB\u001b[K\r\u001b[2C\u001b[1Blimit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 31s · done 1:10 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mset snapshotInterval to 1 second\u001b[39m                                                                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48Gctest\u001b[54G--test…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && ctest --test-dir build/clang-debug -R '^(remote|console|cli_serve)$' \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m--output-on-failure 2>&1 | rg -\u001b[38G ERROR\u001b[45G-e 'values:' -e 't\u001b[65Gts\u001b[68Gpassed' -e 'Failed' -e 'sec'\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
