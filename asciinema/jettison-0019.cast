[0.005, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ go\u001b[39m                                                                                                                    \r\u001b[2C\u001b[1B\u001b[49mrun take\u001b[12G 3.46 to 3.48 s, the same as\u001b[41Gbefore\u001b[48GW12\u001b[52G(3.46\u001b[58Gto\u001b[61G3.47\u001b[66Gs).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisions for you:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPush:\u001b[22m the slices are gat\u001b[30Gd but not pushed. Sh\u001b[51Gll I push \u001b[38;2;177;185;249mfeature-base\u001b[39m?\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStep budget:\u001b[22m even before W12 this\u001b[39Gcheck\u001b[45Gsits\u001b[50Gat\u001b[53G3.46\u001b[58Gs\u001b[60Gagainst\u001b[68Gits\u001b[72G3.56\u001b[77Gs\u001b[79Glimit.\u001b[86GThe\u001b[90G2.37\u001b[95Gs\u001b[97Gbaseline\u001b[106Git\u001b[109Gcompares\u001b[118Gto\r\u001b[4C\u001b[1Bis\u001b[8Gout\u001b[12Gof\u001b[15Gdate,\u001b[21Gand\u001b[25Glittle\u001b[32Gadded\u001b[38Gcost\u001b[43Gwould\u001b[49Gfail\u001b[54Git.\u001b[58GDo\u001b[61Gyou\u001b[65Gwant\u001b[70Gthe\u001b[74Gbudget\u001b[81Gre-measured,\u001b[94Gor\u001b[97Gleft\u001b[102Guntil\u001b[108Git\u001b[111Gtrips?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther changes:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHash pins:\u001b[16G\u001b[22mthe\u001b[20Gsame\u001b[25Gthree\u001b[31Gpins\u001b[36Gmoved\u001b[42Gin\u001b[45Geach\u001b[50Gslice.\u001b[57GThe\u001b[61Ggovernance\u001b[72Gone\u001b[76Gmoved\u001b[82Gbecause\u001b[90Gtender\u001b[97Gmoney\u001b[103Gis\u001b[106Greally\u001b[113Greserved\r\u001b[2C\u001b[1B \u001b[5Gfrom the firs\u001b[19G st\u001b[23Gp. The two tr\u001b[37Gding-fixture\u001b[50Gpins\u001b[55Gmoved o\u001b[63Gly\u001b[66Gbecause\u001b[74Gthe save layout grew;\u001b[96Gthat\u001b[101Gscenario\u001b[110Gholds\u001b[116Gno\r\u001b[4C\u001b[1Btenders,\u001b[14Gwhich\u001b[20GI\u001b[22Gchecked\u001b[30Gdirectly.\r\u001b[2C\u001b[1B- \u001b[1mCommand module:\u001b[22m \u001b[38;2;177;185;249mCommand::Requests\u001b[39m gained \u001b[38;2;177;185;249mRunningOrder()\u001b[39m. The award breaks \u001b[80Gies by the\u001b[91Go\u001b[93Gder bids\u001b[102Gwere\u001b[107Gacc\u001b[111Gp\u001b[113Ged in,\u001b[K\r\u001b[2C\u001b[1B  which handlers couldn't se\u001b[33Gb\u001b[35Gfore.\u001b[41GBids\u001b[46Gplaced\u001b[53Gby\u001b[56Gagents\u001b[63Grank\u001b[68Gafter\u001b[74Gthat\u001b[79Gstep's\u001b[86Gplayer\u001b[93Grequests.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommands and results:\u001b[27G\u001b[22mthere\u001b[33Gare\u001b[37Gfour\u001b[42Gnew\u001b[46Gcommands\u001b[55G(\u001b[38;2;177;185;249mPublish\u001b[39m,\u001b[65G\u001b[38;2;177;185;249mCancel\u001b[39m,\u001b[73G\u001b[38;2;177;185;249mBid\u001b[39m,\u001b[78G\u001b[38;2;177;185;249mWithdraw\u001b[39m)\u001b[88Gand\u001b[92Gthree\u001b[98Gnew\u001b[102Gresults\u001b[110G(\u001b[38;2;177;185;249mClosed\u001b[39m,\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249mLimitReached\u001b[39m, \u001b[38;2;177;185;249mStaleRevision\u001b[39m).\u001b[K\r\u001b[2B  \u001b[1mLeft out on purpose:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlayer relief tenders:\u001b[28G\u001b[22m\u001b[38;2;177;185;249mPublish\u001b[36G\u001b[39monly\u001b[41Gtakes\u001b[47Gproject\u001b[55Ginputs,\u001b[63Gso\u001b[66Ga\u001b[68Gplayer\u001b[75Ggoverning\u001b[85Ga\u001b[87Gregion\u001b[94Gcan't\u001b[100Gcall\u001b[105Ga\u001b[107Grelief\u001b[114Gtender\r\u001b[1B \u001b[3G  yet.\u001b[K\r\u001b[1B  - \u001b[1mLosing bids:\u001b[22m these are dropped at the awar\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49mice\u001b[80Gare\u001b[84Gposted.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
