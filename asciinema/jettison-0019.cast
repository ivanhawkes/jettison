[0.052, "o", "\u001b[?25l\u001b[H\u001b[5Gand\u001b[9G1\u001b[11Gtin\u001b[15Ginto\u001b[20G10\u001b[23Gbronze.\u001b[31GAll\u001b[35Gcounts\u001b[42Gare\u001b[46Gwhole\u001b[52Gtotes.\r\u001b[2C\u001b[1B- \u001b[1mSaved world:\u001b[22m each region\u001b[30Gnow\u001b[34Gsaves\u001b[40Gits\u001b[44Gskills,\u001b[52Gits\u001b[56Gfacilities\u001b[67Gand\u001b[71Gthe\u001b[75Grecipes\u001b[83Git\u001b[86Ghas\u001b[90Gunlocked.\u001b[100GA\u001b[102Gregion's\u001b[111Gproject\u001b[119Gis\r\u001b[4C\u001b[1Ba\u001b[7Gsaved\u001b[13Gentity\u001b[20Gwith\u001b[25Gits\u001b[29Gown\u001b[33Gstock,\u001b[40Gits\u001b[44Gphase\u001b[50Gand\u001b[54Gthe\u001b[58Gsteps\u001b[64Gworked\u001b[71Gso\u001b[74Gfar.\r\u001b[1B \u001b[3G- \u001b[1mNew \u001b[38;2;177;185;249mprocurement\u001b[39m module, with a \u001b[38;2;177;185;249mmanifest.projects\u001b[39m system:\r\u001b[1B\u001b[22m    - A project consumes its inputs once, in the step it holds all\u001b[68Gof\u001b[71Gthem\u001b[76Gand\u001b[80Ghas\u001b[84Ga\u001b[86Gworking\u001b[94Gworkshop.\r\u001b[4C\u001b[1B- It then works st\u001b[24Gp by \u001b[30Gtep, and\u001b[39Gp\u001b[41Gus\u001b[44Gs while the\u001b[56Gworkshop is out without\u001b[80Gconsuming\u001b[90Gthe\u001b[94Ginputs\u001b[101Gagain.\r\u001b[4C\u001b[1B- Its\u001b[11Glast\u001b[16Gstep\u001b[21Gunlocks\u001b[29Gthe\u001b[33Grecipe\u001b[40Gin\u001b[43Gits\u001b[47Gown\u001b[51Gregion\u001b[58Gonly,\u001b[64Gand\u001b[68Gthe\u001b[72Gunlock\u001b[79Gstays\u001b[85Geven\u001b[90Gif\u001b[93Gthe\u001b[97Gworkshop\u001b[106Gis\u001b[109Glater\u001b[115Glost.\r\u001b[4C\u001b[1B- Fast-forwarding gives\u001b[29Gthe\u001b[33Gsame saved\u001b[44Gsta\u001b[48Ge as\u001b[53Gstepping\u001b[62Gone \u001b[67Gtep at a \u001b[77Gime.\u001b[K\r\u001b[4C\u001b[1B- Loading\u001b[15Grefuses a save whose p\u001b[38Goject h\u001b[46Glds the wrong go\u001b[63Gds\u001b[66Gor too many, or\u001b[82Ghas\u001b[86Gworked\u001b[93Gan\u001b[96Gimpossible\u001b[107Gnumber\u001b[114Gof\r\