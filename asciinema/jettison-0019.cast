8;242mh, wai\u001b[18Gs\u001b[20Gfor\u001b[24Gthe first   \u001b[37G       \u001b[45G  \u001b[48G    \u001b[53G             \u001b[67G  \u001b[70G     \u001b[76G  \u001b[79G       \u001b[87G   \u001b[91G     \u001b[97G        \u001b[106G    \u001b[111G   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 12 \u001b[22m larger hull. A commit is gated in the second checkout, `build/gate-tree`, with `--tidy`, editing\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 13 \u001b[22m alone beside it ([\u001b[38;2;230;219;116mgating beside the work\u001b[39m](build-and-gates.md#gating-beside-the-work)). A ship steered\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22min a station's\u001b[26Gfra\u001b[30Ge still runs every\u001b[50Gtep, which is most of the zero-client run's steps, more so\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRebuilding after the\u001b[24Gtidy\u001b[29Gfix,\u001b[34Grerunning\u001b[44Gthe\u001b[48Gprocurement\u001b[60Gsuite,\u001b[67Gthen\u001b[72Gcommitting\u001b[83Gslice\u001b[89G1\u001b[91Gwith\u001b[96Gfiles\u001b[102Gstaged\u001b[109Gby\u001b[112Gname.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[4G\u001b[39munn\u001b[8Gng cd\u001b[14G'../manifest' && cmak\u001b[36G --build --preset cla\u001b[58Gg-…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest' && cmake --build --preset clang-debug 2>&1 | grep -E 'error|warning:' | head; ctest --test-dir \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mbuild/clang-debug -R '^(procurement|content|data|world|travel)$' 2>&1 | tail -4\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
