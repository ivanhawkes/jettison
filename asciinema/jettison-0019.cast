[0.090, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe test had its two tenders the wrong way round: the one published first closes first. Swapping them:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manif\u001b[27Gst/\u001b[31Gource/game/procurement/tests/ProcurementTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[7C\u001b[1B\u001b[2m61\u001b[14G\u001b[22mhosted.\u001b[38;2;166;226;46mDirect\u001b[39m();\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 562 \u001b[14G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(hosted.\u001b[38;2;166;226;46mPublishes\u001b[39m(\u001b[38;2;230;219;116m\"ItemCopper\"\u001b[39m,\u001b[51G\u001b[38;2;190;132;255m1\u001b[39m,\u001b[54G\u001b[38;2;190;132;255m1'000\u001b[39m,\u001b[61G\u001b[38;2;190;132;255m1\u001b[39m)\u001b[64G==\u001b[67GResult::Succeeded);\r\u001b[2C\u001b[1B   \u001b[2m 563 \u001b[22m   \u001b[38;2;166;226;46mCHECK\u001b[39m(hosted.\u001b[38;2;166;226;46mPublishes\u001b[39m(\u001b[38;2;230;219;116m\"ItemCopper\"\u001b[39m,\u001b[51G\u001b[38;2;190;132;255m1\u001b[39m,\u001b[54G\u001b[38;2;190;132;255m1'000\u001b[39m,\u001b[61G\u001b[38;2;190;132;255m1\u001b[39m)\u001b[64G==\u001b[67GResult::Succeeded);\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 564 -\u001b[38;2;248;248;242m  const std::string \u001b[48;2;92;2;0mlate\u001b[48;2;61;1;0m = TenderId(kEast, kBronze, \"ItemCopper\", 1);                                 \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 565 -\u001b[38;2;248;248;242m  const std::string \u001b[48;2;92;2;0mearly\u001b[48;2;61;1;0m = TenderId(kEast, kBronze, \"ItemCopper\", 2);                                \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 564 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::string \u001b[48;2;4;71;0mearly\u001b[48;2;2;40;0m = \u001b[38;2;166;226;46mTenderId\u001b[38;2;248;248;242m(kEast, kBronze, \u001b[38;2;230;219;116m\"ItemCopper\"\u001b[38;2;248;248;242m, \u001b[38;2;190;132;255m1\u001b[38;2;248;248;242m);                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 565 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::string \u001b[48;2;4;71;0mlate\u001b[48;2;2;40;0m = \u001b[38;2;166;226;46mTenderId\u001b[38;2;248;248;242m(kEast, kBronze, \u001b[38;2;230;219;116m\"ItemCopper\"\u001b[38;2;248;248;242m, \u001b[38;2;190;132;255m2\u001b[38;2;248;248;242m);                                 \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[2m 566 \u001b[22m   hosted.\u001b[38;2;166;226;46mFastForwardTo\u001b[39m(hosted.\u001b[38;2;166;226;46mTenders\u001b[39m().\u001b[38;2;166;226;46mat\u001b[39m(early).bidClose\u001b[71G-\u001b[73G\u001b[38;2;190;132;255m1\u001b[39m);\r\u001b[5C\u001b[1B\u001b[2m 567 \u001b[14G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(hosted.\u001b[38;2;166;226;46mRun\u001b[39m(kAda,\u001b[37GkCancel,\u001b[46GCancel{early})\u001b[61G==\u001b[64GResult::Succeeded);\r\u001b[1B \u001b[3G   \u001b[2m 568 \u001b[12G\u001b[22m  \u001b[38;2;166;226;46mREQUIRE\u001b[39m(hoste\u001b[28G.world.\u001b[38;2;166;226;46mClock\u001b[39m().\u001b[38;2;166;226;46mStep\u001b[39m() <=\u001b[53Ghosted.\u001b[38;2;166;226;46mTenders\u001b[39m().\u001b[38;2;166;226;46mat\u001b[39m(la\u001b[76Ge).bidClose);\u001b[K\r\u001b[10C\u001b[2B\u001b[1m1\u001b[22m shell command…\u001b[28G\u001b[K\r\u001b[43C\u001b[2B\u001b[K\r\u001b[18C\u001b[2B\u001b[38;2;153;153;153m11m\u001b[23G7s ·\u001b[28G↓\u001b[39m \u001b[38;2;153;153;153m49.1k toke\u001b[41Gs)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
