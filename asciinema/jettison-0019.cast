[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[1mStep budget:\u001b[22m even b\u001b[25Gfore W12 \u001b[35Ghis check sits \u001b[51Gt 3.46 \u001b[59G against its 3.56\u001b[77Gs\u001b[79Glimit.\u001b[86GThe\u001b[90G2.37\u001b[95Gs\u001b[97Gbaseline\u001b[106Git\u001b[109Gcompares\u001b[118Gto\r\u001b[2C\u001b[1B \u001b[5Gis out of dat\u001b[19G, and little added cost would f\u001b[51Gil it.\u001b[58GDo you want the budget re-measured, or\u001b[97Gleft u\u001b[104Gtil it trips?\u001b[118G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther changes:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mHash pi\u001b[13Gs:\u001b[22m the\u001b[20Gsame\u001b[25Gthree\u001b[31Gpins\u001b[36Gmoved\u001b[42Gin\u001b[45Geach\u001b[50Gslice.\u001b[57GThe\u001b[61Ggovernance\u001b[72Gone\u001b[76Gmoved\u001b[82Gbecause\u001b[90Gtender\u001b[97Gmoney\u001b[103Gis\u001b[106Greally\u001b[113Greserved\r\u001b[2C\u001b[1B \u001b[5Gfrom the first\u001b[21Gtep. Th\u001b[29G two trading-fixture\u001b[50Gpins moved\u001b[61Gonly because the save layout\u001b[90Ggrew; that scena\u001b[107Gio holds no\u001b[K\r\u001b[4C\u001b[1Btenders,\u001b[14Gwhich\u001b[20GI checked\u001b[30Gdirectly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommand module:\u001b[22m \u001b[38;2;177;185;249mCommand::Requests\u001b[39m gained\u001b[46G\u001b[38;2;177;185;249mRunningOrder()\u001b[39m.\u001b[62GThe\u001b[66Gaward\u001b[72Gbreaks\u001b[79Gties\u001b[84Gby\u001b[87Gthe\u001b[91Gorder\u001b[97Gbids\u001b[102Gwere\u001b[107Gaccepted\u001b[116Gin,\r\u001b[2C\u001b[1B \u001b[5Gwhich handlers couldn't see before. Bids\u001b[46Gplaced by agents rank \u001b[69Gfter that\u001b[79Gst\u001b[82Gp's player r\u001b[95Gquest\u001b[101G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommands and results:\u001b[22m \u001b[28Gher\u001b[33Gare four new\u001b[46Gcommands (\u001b[38;2;177;185;249mPublish\u001b[39m, \u001b[38;2;177;185;249mCancel\u001b[39m, \u001b[38;2;177;185;249mBid\u001b[39m, \u001b[