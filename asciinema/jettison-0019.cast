7Gnow\u001b[71Gincludes\u001b[80Gthe\u001b[84Gregions'\u001b[93Gnew\u001b[97Gdata.\u001b[103GEvery\u001b[109Gother\u001b[115Gcheck\r\u001b[2C\u001b[1B \u001b[5Gin those tests still holds. The test\u001b[42Gthat fixes the system order also gains \u001b[38;2;177;185;249mmanifest.projects\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot run yet:\u001b[22m the fu\u001b[25Gl gate (\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m). The plan runs it\u001b[75Gafter\u001b[81Gslice 3, so this commit\u001b[105Gis\u001b[108Gunpushed.\r\u001b[2C\u001b[1B \u001b[5Gclang-tidy is clean on th\u001b[32Gchanged files after one fix.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRepeat bronze production is out of scope.\u001b[22m Th\u001b[50G W11 contract\u001b[64Gonly\u001b[69Gsays\u001b[74Gcompletion\u001b[85Gunlocks\u001b[93Gthe\u001b[97Grecipe.\u001b[105GD-029\u001b[111Gsays\u001b[116Gwho\r\u001b[2C\u001b[1B \u001b[5Gowns the inputs and outputs, facility access and batch timing mu\u001b[70Gt be specif\u001b[82Ged\u001b[85Gbef\u001b[89Gre i\u001b[94G's\u001b[97Gbuilt, so I've recorded\r\u001b[4C\u001b[1Bit as l\u001b[13Gft for l\u001b[22Gter.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWorkshops:\u001b[16G\u001b[22mn\u001b[18Gthing in\u001b[27Gthe\u001b[31Ggame\u001b[36Gcan\u001b[40Gput\u001b[44Ga\u001b[46Gw\u001b[77Gthe\u001b[81Gtests\u001b[87Gswitch\u001b[94Git\u001b[97Goff\u001b[101Gby\u001b[104Ghand.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
