[0.049, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m5\u001b[10G\u001b[22m0,\u001b[13Greplac\u001b[20Gd\u001b[25Git\u001b[28G curren\u001b[36G revision\u001b[46G(StaleRevi\u001b[57Gion\u001b[61Go\u001b[63Gher\u001b[67Gise) or withdrawn\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22mbef\u001b[14Gr\u001b[17Gthe bid close (Clos\u001b[37Gd a\u001b[41G or past it), its total from 1 to \u001b[76Ghe budget,\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m32 a \u001b[17Gnder at most (LimitReached). A compa\u001b[54Gy se\u001b[59Gs\u001b[61Gits\u001b[65Gown bids i\u001b[76G its view,\r\u001b[6C\u001b[1B\u001b[2m 8\u001b[10G\u001b[22mno one ano\u001b[21Gher's.\u001b[28GA bid\u001b[34Gkeep\u001b[39G the st\u001b[47Gp and global request order it was\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22maccepted\u001b[19Gat,\u001b[23Gwhich\u001b[29GCommand::Requests::RunningOrder\u001b[61Gnow\u001b[65Ggives\u001b[71Ga\u001b[73Ghandler;\u001b[82Gan\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22magent's\u001b[18GAct\u001b[22Granks\u001b[28Gafter\u001b[34Gits\u001b[38Gstep's\u001b[45Grequests,\u001b[55Gas\u001b[58Git\u001b[61Gruns\u001b[66Gafter\u001b[72Gthem.\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m… +17 lines \u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mCommitted \u001b[1mf31d941\u001b[22m, ran \u001b[1m3\u001b[22m shell commands \u001b[44G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSlice\u001b[9G3\u001b[11Gis\u001b[14Gcommitted\u001b[24Gas\u001b[27G\u001b[38;2;177;185;249mf31d941\u001b[39m.\u001b[36GNow\u001b[40Gthe\u001b[44Ggate\u001b[49Gat\u001b[52Gfull\u001b[57Gwidth,\u001b[64Gwith\u001b[69G56\u001b[72GGiB\u001b[76Gfree,\u001b[82Gin\u001b[85Gthe\u001b[89Gsecond\u001b[96Gcheckout.\u001b[106GI'm\u001b[110Gmoving\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mbuild/gate-tree\u001b[39m to the new commit first:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m4\u001