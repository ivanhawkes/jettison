[0.161, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExpected gain:\u001b[22m going by the last gate's timings,\u001b[52Gt\u001b[54Ge sanitised\u001b[66Gstage\u001b[72Gdrops\u001b[78Gfrom\u001b[83Gabout\u001b[89G634\u001b[93Gs\u001b[95Gto\u001b[98Gabout\u001b[104G175\u001b[108Gs,\u001b[111Gnow\u001b[115Gset\u001b[119Gby\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpolicy\u001b[39m. Manifest's gate should go from about 17\u001b[51Gminutes to\u001b[62G9–10.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTrade-off:\u001b[14G\u001b[22msanitiser\u001b[24Gbugs\u001b[29Gthat\u001b[34Gonly\u001b[39Gshow\u001b[44Gafter\u001b[50Ga\u001b[52Gfixture's\u001b[62Glong\u001b[67Grun\u001b[71Gof\u001b[74Gsimulated\u001b[84Gdays\u001b[89Gwould\u001b[95Gnow\u001b[99Gsurface\u001b[107Gonly\u001b[112Gas\u001b[115GDebug\r\u001b[2C\u001b[1Bor Release failures.\u001b[24G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor the batch merge:\u001b[24G\u001b[22mthe\u001b[28Gtwo\u001b[32GManifest\u001b[41Glanes\u001b[47Gwere\u001b[52Gcut\u001b[56Gbefore\u001b[63Gthis\u001b[68Gcommit,\u001b[76Gso\u001b[79GI'll\u001b[84Grebase\u001b[91Gthem\u001b[96Gonto\u001b[101Git\u001b[104Gbefore\r\u001b[2C\u001b[1Bfast-forwardi\u001b[17Gg. Nothin\u001b[27G in them touc\u001b[41Ges\u001b[44Gthese\u001b[50Gfiles.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m4\u001b[22m background agents to finish\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mrun the Manifest gate to check the new timing\u001b[39m                                                                         \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✶\u001b[3GAccomplish\u001b[38;2;235;159;127ming\u001b[38;2;215;119;87m… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent 