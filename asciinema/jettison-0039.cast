[0.338, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m,\u001b[37Guncommitted.\r\u001b[2C\u001b[1B- \u001b[1mKept:\u001b[22m \u001b[38;2;177;185;249m40d0bdd\u001b[39m (\u001b[38;2;177;185;249mclient_serve --no-sound\u001b[39m),\u001b[46Gas\u001b[49Gyou\u001b[53Gdecided.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter you restart the shell, I'll:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. Check that \u001b[38;2;177;185;249mLD_LIBRARY_PATH\u001b[39m now\u001b[37Glists \u001b[38;2;177;185;249mlibpulseaudio\u001b[57G\u001b[39mand\u001b[61G\u001b[38;2;177;185;249malsa-lib\u001b[39m.\r\u001b[2C\u001b[1B2. In lane C, finish the Debug suites on the new pin and run\u001b[64G\u001b[38;2;177;185;249mscripts/check-env-parity.sh\u001b[39m.\r\u001b[2C\u001b[1B3.\u001b[6GCommit\u001b[13Gthe\u001b[17Gpin\u001b[21Gmove,\u001b[27Gupdating\u001b[36Gthe\u001b[40Gpin\u001b[44Gline\u001b[49Gin\u001b[52G\u001b[38;2;177;185;249msession-handoff.md\u001b[71G\u001b[39mand\u001b[75Gadding\u001b[82Ga\u001b[84Ghistory\u001b[92Grow,\u001b[97Gthen\u001b[102Gmerge\u001b[108Git\u001b[111Ginto\r\u001b[2C\u001b[1B   \u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B4\u001b[6GRun Manifest's gate, then push\u001b[37GManifest.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6GRemind you\u001b[17Gabout L53.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 3m 13s · done 11:29 am\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNothing else is running, so it's safe\u001b[41Gto\u001b[44Grestart\u001b[52Gnow.\r\u001b[2B \u001b[3GWhe\u001b[7G you're back, I'll check\u001b[32Gthe\u001b[36Gnew\u001b[40Glibrary\u001b[48Gpath,\u001b[54Gfinish\u001b[61GManifest's\u001b[72Gtests\u001b[78Gon\u001b[81Gthe\u001b[85Gnew\u001b[89Gpin\u001b[93Gin\u001b[96Glane\u001b[101GC,\u001b[104Gcommit\u001b[111Gand\u001b[115Gmerge\r\u001b[1B  the pin move, run Manifest's gate and push it. Then I'll remind you about L53.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
