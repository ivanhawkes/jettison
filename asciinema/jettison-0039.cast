pin\u001b[93Gin\u001b[96Glane\u001b[101GC\u001b[103Gand\u001b[107Grunning\u001b[115Gevery\r\u001b[2C\u001b[1BDebug\u001b[9Gsuite,\u001b[16Gplus\u001b[21Gthe\u001b[25Gparity\u001b[32Gcheck.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd '/home/ivan/p\u001b[28Gojects/manifest.lane-c'\u001b[52G&&\u001b[55Gscrip…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest.lane-c' && scripts/heavy.sh ctest --test-dir build/clang-debug -j24 \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m--output-on-failure (19s · 113 lines)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ stop it and let me restart the client, then you can do the build and push\u001b[39m                                             \r\u001b[2C\u001b[5B\u001b[49m\u001b[2mPress up to edit queued messages\u001b[22m\u001b[K\r\u001b[37C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
