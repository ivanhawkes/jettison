[0.023, "o", "\u001b[?25l\u001b[H  - On NixOS, a library loaded at run time is found only through \u001b[38;2;177;185;249mdevenv.nix\u001b[39m's path, and a missing one falls back\u001b[K\r\u001b[4C\u001b[1Bsilently.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 1m 25s · done 11:25 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m2\u001b[6GK\u001b[8Gep it.\u001b[39m                                               \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255m3\u001b[6GRemind me what this is about after i restart the shell.\r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255m4. push both\u001b[39m                                                                                                          \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDecisions\u001b[13Gnoted:\u001b[20Gkeep\u001b[25G\u001b[38;2;177;185;249m40d0bdd\u001b[39m,\u001b[34Gremind\u001b[41Gyou\u001b[45Gabout\u001b[51GL53\u001b[55Gafter\u001b[61Gthe\u001b[65Grestart,\u001b[74Gand\u001b[78Gpush\u001b[83Gboth.\u001b[89GOne\u001b[93Gsnag\u001b[98Gon\u001b[101Gthe\u001b[105GManifest\u001b[114Gpush:\r\u001b[1B \u001b[3Gits CI parity check fails unless the pin moves to Jettison \u001b[38;2;177;185;249m66a9ce5\u001b[39m. So\u001b[74Gthe\u001b[78Gorder is push Jettis\u001b[100G, move Manifest'\u001b[117G\u001b[K\r\u001b[2C\u001b[1Bpin, re-gate Manifest, then pu\u001b[34Gh\u001b[36Git.\u001b[40GChecking my note on how git push must\u001b[78Gbe run here.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, recalled \u001b[1m2\u001b[22m memories \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPushing\u001b[11GJettison\u001b[20Gwith\u001b[25Ga\u001b[27Gbare\u001b[32G\u001b[38;2;177;185;249mgit push\u001b[41G\u001b[39mfrom\u001b[46Gits\u001b[50Gown\u001b[54Gdirectory,\u001b[65Gwhich\u001b[71Gkeeps\u001b[77Git\u001b[80Goutside\u001b[88Gthe\u001b[92Gsandbox.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mPushing\u001b[11GJettison\u001b[20Gfeature-base\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ git push origin feature-base (9s)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;233;154;122mReticulating…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Push Jettison's feature-base · 17s · ↓\u001b[39m \u001b[38;2;153;153;153m1.2k tokens)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
