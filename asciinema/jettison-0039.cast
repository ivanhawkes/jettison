[0.083, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mDone when:\u001b[16G\u001b[22ma\u001b[18Gnew\u001b[22G\u001b[38;2;177;185;249mclient_serve\u001b[35G\u001b[39mtest\u001b[40Gstarts\u001b[47G\u001b[38;2;177;185;249mmanifest --serve\u001b[39m,\u001b[65Gand\u001b[69Gthe\u001b[73Gclient,\u001b[81Goffscreen,\u001b[92Gprovisions\u001b[103Gthe\u001b[107Gplayer,\u001b[115Gbuys\u001b[120Ga\r\u001b[1B \u001b[3G  to\u001b[8Ge and shows it held, all\u001b[33Gthrough\u001b[41Gthe\u001b[45Gscreens.\u001b[54GAfter\u001b[60Gthe\u001b[64Gserver\u001b[71Gstops\u001b[77Gand\u001b[81Grestarts,\u001b[91Ga\u001b[93Gsecond\u001b[100Gconnection\u001b[111Gstill\r\u001b[4C\u001b[1Bshows\u001b[11Gthe\u001b[15Gtote.\u001b[21G\u001b[38;2;177;185;249mclient_model\u001b[34G\u001b[39malso\u001b[39Gplays\u001b[45Gthe\u001b[49Gsame\u001b[54Gslice\u001b[60Gagainst\u001b[68Ga\u001b[70Gserver\u001b[77Grunning\u001b[85Gin\u001b[88Gthe\u001b[92Gtest\u001b[97Gprocess.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mThe plan\u001b[12G\u001b[22mis\u001b[15Gin a new\u001b[24G\u001b[38;2;177;185;249mdocs/client-plan.md\u001b[39m. It finds no engine gap: everything\u001b[80Gthe\u001b[84Gclient\u001b[91Gneeds\u001b[97Gis\u001b[100Galready\u001b[108Gbuilt,\r\u001b[2C\u001b[1Bincluding running the shell with no\u001b[39Ggame world,\u001b[51Gwhich\u001b[57Gthe\u001b[61Gfirst\u001b[67Gstep\u001b[72Gconfirms.\u001b[82GThe\u001b[86Gwork\u001b[91Gis\u001b[94Gfour\u001b[99Gsteps:\r\u001b[2C\u001b[1B1.\u001b[6GLet the\u001b[14Gclient\u001b[21Gmodel\u001b[27Greach\u001b[33Gthe\u001b[37Gworld\u001b[43Geither\u001b[50Glocally\u001b[58Gor\u001b[61Gover\u001b[66Ga\u001b[68Gconnection.\r\u001b[2C\u001b[1B2.\u001b[6GAdd t\u001b[14G\u001b[38;2;177;185;249m--connect\u001b[39m and \u001b[38;2;177;185;249m--token-file\u001b[39m options, r\u001b[52Gfuse saves while connected, and hide the fast-f\u001b[100Grward\u001b[106Gtoggle.\r\u001b[2C\u001b[1B3.\u001b[6GWrite the \u001b[38;2;177;185;249mclient_serve\u001b[39m script.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GUpdate the documents.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOnce the\u001b[12Gserver-loaded\u001b[26Gcontent\u001b[34Gcheck\u001b[40G(Jettison's\u001b[52GJ63),\u001b[58Greconnecting,\u001b[72Ga\u001b[74Gserver\u001b[81Gpicker\u001b[88Gscreen\u001b[95Gand\u001b[99Gthe\u001b[103Gbundle\u001b[110Gare\u001b[114Gleft\r\u001b[2C\u001b[1Bout, I'd guess\u001b[18Git's one batch of 3–4 commits.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Galso linked\u001b[17GL52 from the docs index, th\u001b[45G roadmap, \u001b[38;2;177;185;249mclient.md\u001b[39m and D-012.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne decision blocks it:\u001b[27G\u001b[22mon\u001b[30Ga\u001b[32Gserver,\u001b[40Gtoday\u001b[46Gonly\u001b[51Gan\u001b[54Gadministrator\u001b[68Gmay\u001b[72Gprovision\u001b[82Ga\u001b[84Gcompany,\u001b[93Gso\u001b[96Ga\u001b[98Gplayer's\u001b[107Gclient\u001b[114Gcan't\r\u001b[1B \u001b[3Gg\u001b[5Gt started.\u001b[K\r\u001b[1B  - \u001b[1mRecommended:\u001b[22m a player may provision their own\u001b[51Gcompany,\u001b[60Gonce.\u001b[66GThe\u001b[70Gstart\u001b[76Gscreen\u001b[83Gthen\u001b[88Gworks\u001b[94Gon\u001b[97Ga\u001b[99Gserver\u001b[106Gas\u001b[109Git\u001b[112Gdoes\r\u001b[4C\u001b[1Blocally,\u001b[14Gand\u001b[18Gthe\u001b[22Gtest\u001b[27Gneeds\u001b[33Gno\u001b[36Gadministrator\u001b[50Gstep.\u001b[56GIt\u001b[59Gwould\u001b[65Gbe\u001b[68Ga\u001b[70Gnew\u001b[74Gdecision\u001b[83Gnext\u001b[88Gto\u001b[91GD-080.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.136, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mAlternative:\u001b[18G\u001b[22mkeep\u001b[23Git\u001b[26Gadministrator-only.\u001b[46GThe\u001b[50Gtest\u001b[55Gprovisions\u001b[66Gthe\u001b[70Gplayer\u001b[77Gfirst,\u001b[84Gand\u001b[88Gthe\u001b[92Gstart\u001b[98Gscreen\u001b[105Gtells\u001b[111Gplayers\u001b[119Gto\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.110, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gshows the tote. \u001b[38;2;177;185;249mclient_model\u001b[39m also plays the same slice against a s\u001b[72Grver running in the\u001b[92Gtest pr\u001b[100Gcess.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe plan\u001b[22m is\u001b[15Gin a new \u001b[38;2;177;185;249mdocs/client-plan.md\u001b[39m.\u001b[45GIt finds\u001b[54Gno engine gap: ev\u001b[73Gything the client ne\u001b[94Gds\u001b[97Gis already\u001b[108Gbuilt,\r\u001b[2C\u001b[1Bincluding\u001b[13Grunning\u001b[21Gthe\u001b[25Gshell\u001b[31Gwith\u001b[36Gno\u001b[39Ggame\u001b[44Gworld,\u001b[51Gwhich\u001b[57Gthe\u001b[61Gfirst\u001b[67Gstep\u001b[72Gconfirms.\u001b[82GThe\u001b[86Gwork\u001b[91Gis\u001b[94Gfour\u001b[99Gsteps:\r\u001b[2C\u001b[1B1. Let the client model reach the world either locally or over a connec\u001b[75Gio\u001b[78G.\u001b[80G\u001b[K\r\u001b[2C\u001b[1B2. Ad\u001b[9G the \u001b[38;2;177;185;249m--connect\u001b[39m and \u001b[38;2;177;185;249m--token-file\u001b[39m opti\u001b[46Gns, refuse\u001b[57Gsaves while connected, and hide the fast-forward\u001b[106Gtoggle.\r\u001b[2C\u001b[1B3\u001b[6GWrite the \u001b[38;2;177;185;249mclient_serve\u001b[39m s\u001b[31Gript.\u001b[37G\u001b[K\r\u001b[2C\u001b[1B4\u001b[6GUp\u001b[9Ga\u001b[11Ge the documents.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOnce the server-loaded content\u001b[34Gcheck\u001b[40G(Jettison's\u001b[52GJ63),\u001b[58Greconnecting,\u001b[72Ga\u001b[74Gserver\u001b[81Gpicker\u001b[88Gscreen\u001b[95Gand\u001b[99Gthe\u001b[103Gbundle\u001b[110Gare\u001b[114Gleft\r\u001b[2C\u001b[1Bout,\u001b[8GI'd\u001b[12Gguess\u001b[18Git's\u001b[23Gone\u001b[27Gbatch\u001b[33Gof\u001b[36G3–4\u001b[40Gcommits.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI also link\u001b[15Gd L52 fr\u001b[24Gm the docs index, the roadmap,\u001b[55G\u001b[38;2;177;185;249mclient.md\u001b[65G\u001b[39mand\u001b[69GD-012.\r\u001b[2C\u001b[2B\u001b[1mOne deci