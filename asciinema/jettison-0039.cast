[0.308, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCause:\u001b[22m the dev shell c\u001b[28Gn't\u001b[32Gload \u001b[38;2;177;185;249mlibpulse\u001b[39m or \u001b[38;2;177;185;249mlibasound\u001b[39m. On NixOS a\u001b[71Glibrary\u001b[79Gloaded\u001b[86Gat\u001b[89Grun\u001b[93Gtime\u001b[98Gis\u001b[101Gfound\u001b[107Gonly\u001b[112Gthrough\r\u001b[2C\u001b[1B \u001b[5Gthe shell's library searc\u001b[31G pat\u001b[36G, which names just PipeWire's JACK shim\u001b[76G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEffect:\u001b[23G\u001b[22mfall\u001b[30Ghrough to JACK\u001b[45Gon every run, an\u001b[62G PipeWi\u001b[71G 1.6.11's JACK library\u001b[94Gleaks 34 all\u001b[107Gcations\u001b[115Gper\r\u001b[2C\u001b[1B \u001b[5Gclient. miniaudio opens two clients, so the client leaked 68. I reproduced the\u001b[84G34 wit\u001b[92Ga 15-line C program.\u001b[113G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mProof:\u001b[12G\u001b[22mwith\u001b[17G\u001b[38;2;177;185;249mlibpulseaudio\u001b[31G\u001b[39mand\u001b[35G\u001b[38;2;177;185;249malsa-lib\u001b[44G\u001b[39mon\u001b[47Gthe\u001b[51Gpath,\u001b[57Gthe\u001b[61Gsanitised\u001b[71Gclient\u001b[78Gplays\u001b[84Gthrough\u001b[92GPulseAudio\u001b[103Gand\u001b[107Gexits\u001b[113Gwith\u001b[118Gno\r\u001b[4C\u001b[1Bleak.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor you to\u001b[14Gdec\u001b[18Gde:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mThe fix is in \u001b[38;2;177;185;249mdevenv.nix\u001b[39m, yours to change in both repos:\u001b[22m add \u001b[38;2;177;185;249mpkgs.libpulseaudio\u001b[39m and \u001b[38;2;177;185;249mpkgs.alsa-lib\u001b[39m to the\u001b[111Gshe\u001b[115Gl's\r\u001b[5C\u001b[1Br\u001b[8Gntime\u001b[14Glibrary\u001b[22Gpath\u001b[27G(\u001b[38;2;177;185;249mLD_LIBRARY_PATH\u001b[39m).\u001b[46GOnce\u001b[51Git's\u001b[56Gin,\u001b[60GI'll\u001b[65Gre-run\u001b[72G\u001b[38;2;177;185;249mclient_serve\u001b[85G\u001b[39munder\u001b[91Gthe\u001b[95Gsanitisers\u001b[106Gwith\u001b[111Greal\r\u001b[2C\u001b[1B  \u001b[6Gaudio.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRevert \u001b[38;2;177;185;249m40d0bdd\u001b[39m, or keep it?\u001b[34G\u001b[22mReverting \u001b[45Ga\u001b[48Gs \u001b[38;2;177;185;249mclient_serve\u001b[39m play through the desktop's sound\u001b[96Gserver\u001b[103Glike\u001b[108Ga\u001b[110Gplayer's\r\u001b[2C\u001b[1B  \u001b[6Grun. Keeping it matches the engine's smoke\u001b[49Gt\u001b[51Gst, which never touch\u001b[73Gs the sound\u001b[85Gsystem.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mL53, the content check, is still parked.\u001b[22m I recommend \u001b[60Gpt\u001b[63Gon 1: move Manifest's w\u001b[87Grld\u001b[91Gunder\u001b[97G\u001b[38;2;177;185;249mdefs/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mPush?\u001b[12G\u001b[22mBoth\u001b[17Gbatches\u001b[25Gare\u001b[29Gmerged\u001b[36Gon\u001b[39G\u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[53GJettison\u001b[62Gis\u001b[65Gready\u001b[71Gnow;\u001b[76GManifest,\u001b[86Gonce\u001b[91G1\u001b[93Gand\u001b[97G2\u001b[99Gare\u001b[103Gsettled.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat's\u001b[10Ga\u001b[12Glarge\u001b[18Gblock\u001b[24Gof\u001b[27Gwork\u001b[32Gdone,\u001b[38Gso\u001b[41Gthis\u001b[46Gis\u001b[49Ga\u001b[51Ggood\u001b[56Gpoint\u001b[62Gto\u001b[65G\u001b[38;2;177;185;249m/compact\u001b[39m,\u001b[75Gor\u001b[78Gto\u001b[81Gstart\u001b[87Ga\u001b[89Gfresh\u001b[95Gsession\u001b[103Gafter\u001b[109Gthe\u001b[113Gpush.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 1h 41m 14s · done 11:24 am\r\u001b[1B\u001b[39m                                              \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
