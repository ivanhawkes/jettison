[0.035, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Stopping the gate now.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands, no result recorded for \u001b[1m1\u001b[22m other call \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && export CMAKE_BUILD_PARALLEL_LEVEL='24' CTEST_PARALLEL_LEVEL='24'; \r\u001b[5C\u001b[1B./scripts/ci.sh --werror --asan --tidy --log build/gate.log\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m I stopped the gate after about 4 minutes. It was still in the Debug\u001b[71Gtree's\u001b[78Gtests,\u001b[85Gso\u001b[88GI\u001b[90Ghave\u001b[95Gno\u001b[98Gnew\u001b[102Gtiming.\u001b[110GNo\u001b[113Ggate\r\u001b[2C\u001b[1Bprocesses\u001b[13Gare\u001b[17Gleft,\u001b[23Gand\u001b[27Gthe\u001b[31Glock\u001b[36Gwent\u001b[41Gwith\u001b[46Gthem,\u001b[52Gso\u001b[55Gthe\u001b[59Glane\u001b[64Gagents'\u001b[72Gbuilds\u001b[79Gcan\u001b[83Grun\u001b[87Gagain.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSince\u001b[9G\u001b[38;2;177;185;249m73a8289\u001b[17G\u001b[39mthe\u001b[21Gsanitised\u001b[31Gstage\u001b[37Gruns\u001b[42G60\u001b[45Gsuites,\u001b[53Gwithout\u001b[61Gthe\u001b[65Geight\u001b[71Glong\u001b[76Gfixture\u001b[84Gloops;\u001b[91Gthat's\u001b[98Gstill\u001b[104Gunmeasured\u001b[115Gin\u001b[118Ga\r\u001b[1B \u001b[3Ggate. The\u001b[13Gbatch's Manifest g\u001b[32Gte, after the la\u001b[49Ges merge, will \u001b[65Geasure\u001b[72Git.\u001b[76GThat\u001b[81Gleaves\u001b[88Gone\u001b[92Ggate\u001b[97Gper\u001b[101Grepository,\u001b[113Gas\r\u001b[1B  planned.\u001b[K\r\u001b[43C\u001b[2B\u001b[38;2;153;153;153mthought for 3s)\u001b[39m\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
