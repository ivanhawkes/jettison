[0.135, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gtoken may provision a company for that player only, and only once;\u001b[72Gthe player is tak\u001b[90Gn\u001b[92Gfrom the\u001b[101Gtok\u001b[105Gn, never from\u001b[K\r\u001b[5C\u001b[1Bhe request. An administrator\u001b[35Gcan\u001b[39Gstill provision anyone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL52, the first task in the queue:\u001b[39G\u001b[22ma p\u001b[43Gaye\u001b[47G can name their\u001b[63Gcompany\u001b[71Gfrom\u001b[76Gthe\u001b[80Gclient's\u001b[89Gconsole\u001b[97Gwhen\u001b[102Gthe\u001b[106Ggame\u001b[111Gstarts,\r\u001b[2C\u001b[1B \u001b[5Gwith \u001b[38;2;177;185;249mfound \"Ada Freight\"\u001b[39m, as well\u001b[40Gs on the start scre\u001b[60Gn.\u001b[63GThe e\u001b[69Gd-to-end test uses the c\u001b[94Gnsole command, so it never\r\u001b[4C\u001b[1Bhas to type into a field.\u001b[31G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe plan's five steps:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5Ga. The server accepts a\u001b[29Gplayer's\u001b[38Gown\u001b[42G\u001b[38;2;177;185;249mprovision\u001b[39m,\u001b[53Gwith\u001b[58G\u001b[38;2;177;185;249mcompany\u001b[66G\u001b[39mtest\u001b[71Gcases.\r\u001b[4C\u001b[1Bb\u001b[12Gclient\u001b[19Gmod\u001b[23Gl can\u001b[29Gwork over a network connec\u001b[56Gion, with\u001b[66Ga \u001b[38;2;177;185;249mclient_model\u001b[81G\u001b[39mcase\u001b[86Gagainst\u001b[94Ga\u001b[96Gserver\u001b[103Grunning\u001b[111Gin\u001b[114Gthe\r\u001b[4C\u001b[1B  \u001b[8Gtest process.\u001b[K\r\u001b[4C\u001b[1Bc.\u001b[8GThe client gets\u001b[24G\u001b[38;2;177;185;249m--connect\u001b[39m,\u001b[35G\u001b[38;2;177;185;249m--token-file\u001b[48G\u001b[39mand\u001b[52Gthe\u001b[56G\u001b[38;2;177;185;249mfound\u001b[62G\u001b[39mcommand,\u001b[71Ghas\u001b[75Gno\u001b[78Glocal\u001b[84Gworld,\u001b[91Gand\u001b[95Grefuses\u001b[103Gsaves\u001b[109Gwhile\r\u001b[4C\u001b[1B  \u001b[8Gconnect\u001b[16Gd.\u001b[19G\u001b[K\r\u001b[4C\u001b[1Bd.\u001b[8GA \u001b[11Gew \u001b[38;2;177;185;249mclient_serve\u001b[27G\u001b[39mscript\u001b[34Gruns\u001b[39Gthe\u001b[43Gwhole\u001b[49Gslice\u001b[55Gagainst\u001b[63Ga\u001b[65Greal\u001b[70G\u001b[38;2;177;185;249mmanifest --serve\u001b[39m,\u001b[88Gincluding\u001b[98Ga\u001b[100Gserver\u001b[107Grestart.\r\u001b[4C\u001b[1Be\u001b[8GThe documents are updated.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gare\u001b[13Gdocumentation\u001b[27Gchanges\u001b[35Gonly,\u001b[41Gso\u001b[44GI\u001b[46Gdidn't\u001b[53Grun\u001b[57Gthe\u001b[61Ggate.\u001b[67GNothing\u001b[75Gwas\u001b[79Gbuilt\u001b[85Gor\u001b[88Gtested.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor\u001b[7Gthe\u001b[11Gimplementation,\u001b[27GI'd\u001b[31Guse\u001b[35GOpus\u001b[40Gat\u001b[43Ghigh\u001b[48Geffort\u001b[55Gfor\u001b[59Gsteps\u001b[65G1–3\u001b[69Gand\u001b[73GSonnet\u001b[80Gfor\u001b[84Gthe\u001b[88Gscript\u001b[95Gand\u001b[99Gthe\u001b[103Gdocuments.\u001b[114GA\u001b[116Gfresh\r\u001b[2C\u001b[1Bsession\u001b[12Gs b\u001b[16Gst for it:\u001b[27Gthe\u001b[31Gplan doc\u001b[41Gnd the\u001b[48Grow hold everything it needs, starting from \u001b[38;2;177;185;249mfeature-base\u001b[39m at \u001b[38;2;177;185;249me8715cb\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 44s · done 9:39 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0039 ─\r\u001b[1B\u001b[39m❯ The UI will will, in time, allow the player to name their ships (once), or rename them if approved by an admin or\u001b[K\r\u001b[1B  som\u001b[7G\u001b[K\u001b[27;1H\u001b[24;6H\u001b[?25h"]
