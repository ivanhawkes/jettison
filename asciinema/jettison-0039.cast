[0.124, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mHow long \u001b[38;2;177;185;249mheavy.sh\u001b[39m takes:\u001b[28G\u001b[22mit\u001b[31Gadds\u001b[36Gno\u001b[39Gtime\u001b[44Gof\u001b[47Gits\u001b[51Gown.\u001b[56GIt\u001b[59Gholds\u001b[65Gthe\u001b[69Gshared\u001b[76Glock\u001b[81Gand\u001b[85Gruns\u001b[90Gthe\u001b[94Gcommand\u001b[102Gyou\u001b[106Ggive\u001b[111Git,\u001b[115Gso\u001b[118Ga\r\u001b[2C\u001b[1Brun\u001b[7Gtakes\u001b[13Gas\u001b[16Glong\u001b[21Gas\u001b[24Gthat\u001b[29Gcommand\u001b[37Gplus\u001b[42Gany\u001b[46Gwait\u001b[51Gfor\u001b[55Ganother\u001b[63Glane\u001b[68Gholding\u001b[76Gthe\u001b[80Glock.\u001b[86GThe\u001b[90Glatest\u001b[97Glogs\u001b[102Ggive:\r\u001b[1B\u001b[K\r\u001b[1B  - \u001b[1mJettison's full gate\u001b[22m took 274 s (about 4½ minutes) on\u001b[59G2026-11-27.\u001b[71GThe\u001b[75Glongest\u001b[83Gstages\u001b[90Gwere\u001b[95Gthe\u001b[99Gsanitised\u001b[109Gsmoke\u001b[115Gtest\r\u001b[4C\u001b[1Bat\u001b[8G77\u001b[11Gs,\u001b[14Gthe\u001b[18Goffscreen\u001b[28Gsmoke\u001b[34Gtest\u001b[39Gat\u001b[42G38\u001b[45Gs\u001b[47Gand\u001b[51Gthe\u001b[55Greference\u001b[65Gframes\u001b[72Gat\u001b[75G32\u001b[78Gs.\u001b[81GThe\u001b[85Gbuilds\u001b[92Gtook\u001b[97G20–30\u001b[103Gs\u001b[105Geach,\u001b[111Gwarm.\r\u001b[1B \u001b[3G- \u001b[1mManifest's full gate\u001b[22m took about 17 minutes\u001b[48Gon 2026-11-27, from \u001b[69Gough\u001b[74Gy 22:05 to 22:22. That's much long\u001b[109Gr, an\u001b[115G\u001b[K\r\u001b[2C\u001b[1B  a\u001b[7Gmost all of\u001b[19Git is the sanitised\u001b[39Gsuites:\u001b[47Gtheir\u001b[53G\u001b[38;2;177;185;249mctest\u001b[59G\u001b[39mtook\u001b[64G634\u001b[68Gs\u001b[70Gon\u001b[73Gtheir\u001b[79Gown.\u001b[84GThe\u001b[88GDebug,\u001b[95GRelease\u001b[103Gand\u001b[107Gno-TUI\u001b[114Gsuites\r\u001b[4C\u001b[1Btook\u001b[10Gabout\u001b[16G90–100\u001b[23Gs\u001b[25Geach.\r\u001b[1B \u001b[3G- \u001b[1mA lane's incremental build plus a few suites\u001b[50G\u001b[22mshould be a m\u001b[64Gnute or two. With four agents taking turns on the lock,\u001b[K\r\u001b[2C\u001b[1B  each\u001b[10Gw\u001b[12Gll someti\u001b[22Ges wait several\u001b[38Gminutes.\u001b[47GA\u001b[49GManifest\u001b[58Ggate\u001b[63Gholding\u001b[71Gthe\u001b[75Glock\u001b[80Gblocks\u001b[87Gthe\u001b[91Glanes\u001b[97Gfor\u001b[101Gabout\u001b[107G17\u001b[110Gminutes.\r\u001b[2B \u001b[4Go the batch's gates, one\u001b[29Gp\u001b[31Gr repository\u001b[45Gcome to\u001b[53Grough\u001b[59Gy\u001b[61G20–25 minutes\u001b[75Gwith\u001b[80Gnothing\u001b[88Gelse\u001b[93Gbuilding.\u001b[103GManifest's\r\u001b[1B  sanitised suites are the thing worth trimming if that's too slow.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m4\u001b[22m background agen\u001b[33Gs to finish\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent · ↓ to\u001b[59Gmanage\u001b[39m\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
