[0.046, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m4\u001b[12G\u001b[22m2\u001b[22Gdeb\u001b[26Gg\u001b[30Gconfigure,\u001b[41Gbuild,\u001b[48GCTest.\r\u001b[8C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m3\u001b[22Gnotui`: the same.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 116 \u001b[22m 4. `clang-release`: the same, unless `--skip-release`.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 117 -\u001b[38;2;248;248;242m5. `clang-asan`: the same, with `--asan`.                                                             \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[12G\u001b[38;2;248;248;242m5.\u001b[16Gclang-asan`:\u001b[33Gsame, with `--asan`, less the long fixtur\u001b[75G loops. I\u001b[85Gs test preset\u001b[99Gleaves \u001b[107Gut   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[15G\u001b[38;2;248;248;242m`fixture` and the `fixtur\u001b[41G_*` suites but\u001b[56G`fix\u001b[61Gure_governance`:\u001b[78Gun\u001b[82Gr the sanitisers \u001b[100Gach took\u001b[109G230\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m19\u001b[15G\u001b[38;2;248;248;242mto 630 s (2026-11-27), the stage'\u001b[49G whole length, repea\u001b[70Ging the cod\u001b[82G the shorter\u001b[95Gsuites\u001b[102Gand\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 120 +\u001b[38;2;248;248;242m   `fixture_governance` already run sanitised. The other trees run them all.                          \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m1\u001b[12G\u001b[22m6.\u001b[15Gclang-tidy\u001b[26Gover\u001b[31GManifest's\u001b[42Gown\u001b[46Gunits\u001b[52Gin\u001b[55G`clang-debug`\u001b[69G(`scripts/tidy.py`),\u001b[90Gwith\u001b[95G`--tidy`.\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 123 \u001b[12G\u001b[22mTidy\u001b[17Gruns\u001b[22Glast,\u001b[28Gso\u001b[31Ga\u001b[33Gfinding\u001b[41Gfails\u001b[47Gthe\u001b[51Ggate\u001b[56Gwithout\u001b[64Ghiding\u001b[71Gthe\u001b[75Gresults\u001b[83Gof\u001b[86Gthe\u001b[90Gstages\u001b[97Gbefore\u001b[104Git\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m4\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ git -C '/home/ivan/projects/manifest.asan-trim' diff\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
