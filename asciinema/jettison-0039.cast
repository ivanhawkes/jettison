[0.061, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mbash:\u001b[12Gs\u001b[14Gftware dr\u001b[24Gver\u001b[28G/nix/store/jg8f97fhfmkpccrm3lsx\u001b[60Gavkivpjbs72-mesa-26.2.5/s\u001b[87Gre/vulkan/icd.d/\u001b[104Gvp_icd.x86_6\r\u001b[2C\u001b[1B   4.json\u001b[K\r\u001b[5C\u001b[1Bexit=1\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  (another command ran in this repository at the same time; a change made by either may show under either \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mresult)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Still JACK, with \u001b[38;2;177;185;249mlibpulse\u001b[39m and ALSA loadable. So it isn't only the loader path. Checking miniaudio's own default\r\u001b[2C\u001b[1Bbackend order.\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153mS\u001b[6Grched for \u001b[1m4\u001b[22m patterns \r\u001b[2C\u001b[2B\u001b[39mPulseAudio fa\u001b[17Gled to connect even th\u001b[40Gugh \u001b[45Gibpulse loaded, and\u001b[65GALSA is next in miniaudio's order. I'm building a\u001b[115Gsmall\r\u001b[2C\u001b[1Bdebug pr\u001b[12Ggram to\u001b[20Gsee\u001b[24Geach\u001b[29Gbackend's\u001b[39Gfailure\u001b[47Greason.\u001b[38;2;153;153;153m · summary\r\u001b[83C\u001b[6Bthought for 7s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
