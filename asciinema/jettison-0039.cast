[0.209, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && export CMAKE_BUILD_PARALLEL_LEVEL='24' CTEST_PARALLEL_LEVEL='24'; \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m./scripts/ci.sh --werror --asan --tidy --log build/gate.log\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI stopped the gate after about 4 minutes. It was still in the Debug tree's tests, so I have no new\u001b[102Gtiming.\u001b[110GNo\u001b[113Ggate\r\u001b[1B  processes are left, and the lock went with them, so the lane agents' builds can run again.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSince\u001b[9G\u001b[38;2;177;185;249m73a8289\u001b[17G\u001b[39mthe\u001b[21Gsanitised\u001b[31Gstage\u001b[37Gruns\u001b[42G60\u001b[45Gsuites,\u001b[53Gwithout\u001b[61Gthe\u001b[65Geight\u001b[71Glong\u001b[76Gfixture\u001b[84Gloops;\u001b[91Gthat's\u001b[98Gstill\u001b[104Gunmeasured\u001b[115Gin\u001b[118Ga\r\u001b[1B \u001b[3Ggate. The\u001b[13Gbatch's M\u001b[23Gnifest ga\u001b[33Ge,\u001b[36Gafter the lane\u001b[52Gmerge, will meas\u001b[69Gre it. That leaves\u001b[88Gone gate per repository,\u001b[113Gas\u001b[K\r\u001b[3C\u001b[1Blanned.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWaiting for \u001b[1m4\u001b[22m background agents to finish\u001b[45G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mhow are the lanes getting on? we can get gate timings from the next required run of it\u001b[39m                                \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✽\u001b[3GPhilosoph\u001b[38;2;235;159;127mizi\u001b[38;2;215;119;87mng… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[18;3H\u001b[?25h"]
