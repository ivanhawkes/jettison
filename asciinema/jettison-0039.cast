[0.033, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've recorded ship naming\u001b[29Gas\u001b[32Gdecision\u001b[41G\u001b[1mD-123\u001b[22m,\u001b[48Gbut\u001b[52Git's\u001b[57Gin\u001b[60G\u001b[38;2;177;185;249mmanifest.lane-c\u001b[76G\u001b[39mand\u001b[80Gnot\u001b[84Gcommitted\u001b[94Gyet.\r\u001b[2B \u001b[3G- \u001b[1mThe decision:\u001b[22m a pl\u001b[24Gyer n\u001b[30Gmes each of their\u001b[48Gships once,\u001b[60Gin the graphical clien\u001b[83G. Renaming\u001b[94Ga named\u001b[102Gship\u001b[107Gneeds\u001b[113Gapproval\r\u001b[4C\u001b[1Bfrom\u001b[10Gan\u001b[13Gadministrator\u001b[27Gor\u001b[30Gan\u001b[33Goutside\u001b[41Gprocess,\u001b[50Gwhich\u001b[56Gisn't\u001b[62Gdefined\u001b[70Gyet.\u001b[75GThe\u001b[79Gscreens\u001b[87Gshow\u001b[92Ga\u001b[94Gship's\u001b[101Gname\u001b[106Ginstead\u001b[114Gof\u001b[117Gits\r\u001b[2C\u001b[1B \u001b[5GID.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStatus:\u001b[13G\u001b[22mit's marked selected but \u001b[40Gfe\u001b[43Gred, wit\u001b[52G no\u001b[56Gtask in the queue\u001b[75GIt will be picked up with\u001b[101Gthe roadmap's\u001b[K\r\u001b[4C\u001b[1Bexisting\u001b[14G\"Names\"\u001b[22Gitem,\u001b[28Gthe\u001b[32Gwork\u001b[37Gto\u001b[40Gshow\u001b[45Ggoods,\u001b[52Gships\u001b[58Gand\u001b[62Gvenues\u001b[69Gby\u001b[72Gname\u001b[77Gin\u001b[80Geach\u001b[85Glanguage,\u001b[95Gand\u001b[99GI\u001b[101Gadded\u001b[107Gthe\u001b[111Gnaming\r\u001b[2C\u001b[1B \u001b[5Grule to\u001b[13Gthat\u001b[18Gitem.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL52 is unchanged:\u001b[22m \u001b[24Ghe tracer names\u001b[40Gt\u001b[42Ge company\u001b[52Gonly.\u001b[58GThe\u001b[62Gstarter ship keeps its\u001b[85GID.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould I commit and\u001b[23Gmerge it into Manif\u001b[43Gst's \u001b[38;2;177;185;249mfeature-base\u001b[39m a\u001b[63G I did\u001b[70Gwith\u001b[75Gth\u001b[78G plan?\u001b[85G\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 18s · done 9:40 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mcommit and merge it\u001b[39m                                                                                                   \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[39m Working…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.017, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Grecorded\u001b[17Gship\u001b[22Gnaming\u001b[29Gas\u001b[32Gdecision\u001b[41G\u001b[1mD-123\u001b[22m,\u001b[48Gbut\u001b[52Git's\u001b[57Gin\u001b[60G\u001b[38;2;177;185;249mmanifest.lane-c\u001b[76G\u001b[39mand\u001b[80Gnot\u001b[84Gcommitted\u001b[94Gyet.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe decision:\u001b[19G\u001b[22ma\u001b[21Gplayer\u001b[28Gnames\u001b[34Geach\u001b[39Gof\u001b[42Gtheir\u001b[48Gships\u001b[54Gonce,\u001b[60Gin\u001b[63Gthe\u001b[67Ggraphical\u001b[77Gclient.\u001b[85GRenaming\u001b[94Ga\u001b[96Gnamed\u001b[102Gship\u001b[107Gneeds\u001b[113Gapproval\r\u001b[2C\u001b[1B \u001b[5Gfrom an administrator or an outside process, which isn't defined yet. The screens show a\u001b[94Gship's name i\u001b[108Gstead of its\u001b[K\r\u001b[4C\u001b[1BID.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStatus:\u001b[13G\u001b[22mit's\u001b[18Gmarked\u001b[25Gselected\u001b[34Gbut\u001b[38Gdeferred,\u001b[48Gwith\u001b[53Gno\u001b[56Gtask\u001b[61Gin\u001b[64Gthe\u001b[68Gqueue.\u001b[75GIt\u001b[78Gwill\u001b[83Gbe\u001b[86Gpicked\u001b[93Gup\u001b[96Gwith\u001b[101Gthe\u001b[105Groadmap's\r\u001b[2C\u001b[1B \u001b[5Gexisting \"Names\" item, the work to show goods, ships and venu\u001b[67Gs by name in each language, and I\u001b[101Gadded the naming\r\u001b[4C\u001b[1Brule to that item.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL52 is unchanged:\u001b[22m the\u001b[27Gtracer\u001b[34Gnames\u001b[40Gthe\u001b[44Gcompany\u001b[52Gonly.\u001b[58GThe\u001b[62Gstarter\u001b[70Gship\u001b[75Gkeeps\u001b[81Gits\u001b[85GID.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gcommit\u001b[19Gand\u001b[23Gmerge\u001b[29Git\u001b[32Ginto\u001b[37GManifest's\u001b[48G\u001b[38;2;177;185;249mfeature-base\u001b[61G\u001b[39mas\u001b[64GI\u001b[66Gdid\u001b[70Gwith\u001b[75Gthe\u001b[79Gplan?\r\u001b[2C\u001b[1B\u001b[