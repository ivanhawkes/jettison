[0.257, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat's left out:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mfixture\u001b[30G\u001b[39mand\u001b[34Gseven\u001b[40G\u001b[38;2;177;185;249mfixture_*\u001b[50G\u001b[39msuites\u001b[57G(alone,\u001b[65Gburn,\u001b[71Gcarrier,\u001b[80Gcruise,\u001b[88Gdevelopment,\u001b[101Gprices\u001b[108Gand\u001b[112Gtraffic).\r\u001b[2C\u001b[1B \u001b[5GUnder the sanitisers they took 230–634 s each, and \u001b[38;2;177;185;249mfixture_cruise\u001b[71G\u001b[39malone was the whol\u001b[90G 634 s s\u001b[99Gage.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat still runs:\u001b[22m the\u001b[26Gother 60 suites, \u001b[38;2;177;185;249mfixture_governance\u001b[39m among them, run sanitised. The Debug, no-TUI\u001b[107Gand\u001b[111GRelease\r\u001b[2C\u001b[1B \u001b[5Gtrees still run all 68 suites.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhere:\u001b[22m \u001b[13Ghe exclusion is in \u001b[38;2;177;185;249mCMakePresets.json\u001b[39m's\u001b[52G\u001b[38;2;177;185;249mclang-asan\u001b[63G\u001b[39mtest\u001b[68Gpreset,\u001b[76Gso\u001b[79Ga\u001b[81Gmanual\u001b[88G\u001b[38;2;177;185;249mctest --preset clang-asan\u001b[114G\u001b[39mbehaves\r\u001b[2C\u001b[1B \u001b[5Glike the gate. \u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[39m record\u001b[52Gwhy.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCheck:\u001b[22m \u001b[38;2;177;185;249mctest --pre\u001b[24Get c\u001b[29Gang-asan -N\u001b[39m now lists 60 suites,\u001b[62G\u001b[38;2;177;185;249mfixture_governance\u001b[81G\u001b[39mthe\u001b[85Gonly\u001b[90Gfixture\u001b[98Gloop.\u001b[104GI\u001b[106Ghaven't\u001b[114Grun\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Ggate with the change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExpected gain:\u001b[18G\u001b[22mgoing\u001b[24Gby\u001b[27Gthe\u001b[31Glast\u001b[36Ggate's\u001b[43Gtimings,\u001b[52Gthe\u001b[56Gsanitised\u001b[66Gstage\u001b[72Gdrops\u001b[78Gfrom\u001b[83Gabout\u001b[89G634\u001b[93Gs\u001b[95Gto\u001b[98Gabout\u001b[104G175\u001b[108Gs,\u001b[111Gnow\u001b[115Gset\u001b[119Gby\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpolicy\u001b[39m. Manifest's \u001b[23Gate\u001b[27Gs\u001b[29Gou\u001b[32Gd go from about 17 minutes to 9–10.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTrade-off:\u001b[14G\u001b[22msanitiser\u001b[24Gbugs\u001b[29Gthat\u001b[34Gonly\u001b[39Gshow\u001b[44Gaft\u001b[76Gmulated\u001b[84Gdays\u001b[89Gwould\u001b[95Gnow\u001b[99Gsurface\u001b[107Gonly\u001b[112Gas\u001b[115GDebug\u001b[27;1H\u001b[18;3H\u001b[?25h"]
[0.082, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat's left out:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mfixture\u001b[30G\u001b[39mand\u001b[34Gseven\u001b[40G\u001b[38;2;177;185;249mfixture_*\u001b[50G\u001b[39msuites\u001b[57G(alone,\u001b[65Gburn,\u001b[71Gcarrier,\u001b[80Gcruise,\u001b[88Gdevelopment,\u001b[101Gprices\u001b[108Gand\u001b[112Gtraffic).\r\u001b[2C\u001b[1B \u001b[5GUnder the sanitisers they took 230–634 s each, and \u001b[38;2;177;185;249mfixture_cruise\u001b[71G\u001b[39malone was the whol\u001b[90G 634 s s\u001b[99Gage.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat still runs:\u001b[22m the\u001b[26Gother 60 suites, \u001b[38;2;177;185;249mfixture_governance\u001b[39m among them, run sanitised. The Debug, no-TUI\u001b[107Gand\u001b[111GRelease\r\u001b[2C\u001b[1B \u001b[5Gtrees still run all 68 suites.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhere:\u001b[22m \u001b[13Ghe exclusion is in \u001b[38;2;177;185;249mCMakePresets.json\u001b[39m's\u001b[52G\u001b[38;2;177;185;249mclang-asan\u001b[63G\u001b[39mtest\u001b[68Gpreset,\u001b[76Gso\u001b[79Ga\u001b[81Gmanual\u001b[88G\u001b[38;2;177;185;249mctest --preset clang-asan\u001b[114G\u001b[39mbehaves\r\u001b[2C\u001b[1B \u001b[5Glike the gate. \u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[39m record\u001b[52Gwhy.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCheck:\u001b[22m \u001b[38;2;177;185;249mctest --pre\u001b[24Get c\u001b[29Gang-asan -N\u001b[39m now lists 60 suites,\u001b[62G\u001b[38;2;177;185;249mfixture_governance\u001b[81G\u001b[39mthe\u001b[85Gonly\u001b[90Gfixture\u001b[98Gloop.\u001b[104GI\u001b[106Ghaven't\u001b[114Grun\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Ggate with the change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExpected gain:\u001b[18G\u001b[22mgoing\u001b[24Gby\u001b[27Gthe\u001b[31Glast\u001b[36Ggate's\u001b[43Gtimings,\u001b[52Gthe\u001b[56Gsanitised\u001b[66Gstage\u001b[72Gdrops\u001b[78Gfrom\u001b[83Gabout\u001b[89G634\u001b[93Gs\u001b[95Gto\u001b[98Gabout\u001b[104G175\u001b[108Gs,\u001b[111Gnow\u001b[115Gset\u001b[119Gby\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mpolicy\u001b[39m. Manifest's \u001b[23Gate\u001b[27Gs\u001b[29Gou\u001b[32Gd go from about 17 minutes to 9–10.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTrade-off:\u001b[14G\u001b[22msanitiser\u001b[24Gbugs\u001b[29Gthat\u001b[34Gonly\u001b[39Gshow\u001b[44Gafter\u001b[50Ga\u001b[52Gfixture's\u001b[62Glong\u001b[67Grun\u001b[71Gof\u001b[74Gsimulated\u001b[84Gdays\u001b[89Gwould\u001b[95Gnow\u001b[99Gsurface\u001b[107Gonly\u001b[112Gas\u001b[115GDebug\r\u001b[2C\u001b[1Bor Release\u001b[14Gf\u001b[16Gilures.\u001b[24G    \u001b[29G    \u001b[34G    \u001b[39G    \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[18;3H\u001b[?25h"]
