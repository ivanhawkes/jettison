[0.071, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mPolish tha\u001b[17Gd\u001b[19Gesn't block trading:\u001b[40G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Goods, ships and venues show as IDs,\u001b[44Gnot\u001b[48Gnames.\r\u001b[6C\u001b[1BThe galaxy panel, shipyard and fleet\u001b[44Gscreens are\u001b[56Gopen.\r\u001b[6C\u001b[1BL47, which\u001b[19Guts a\u001b[25Gvenue's fees\u001b[38Gin the snapshot so you see\u001b[65Gthem\u001b[70Gbefore\u001b[77Gpaying,\u001b[85Gis\u001b[88Gopen.\r\u001b[7C\u001b[1B15b, the owners'\u001b[25Gscre\u001b[30Gn\u001b[34Gor fees, taxes and stati\u001b[59Gn\u001b[61Gpolicy, waits on L04, L05 and L29.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTo\u001b[6Gtrade\u001b[12Gwith\u001b[17Gother\u001b[23Gplayers\u001b[31Gthrough\u001b[39Gthe\u001b[43GGUI,\u001b[48Gthe\u001b[52Gonly\u001b[57Gblocker\u001b[65Gis\u001b[68Gserver\u001b[75Gplay.\u001b[81GIf\u001b[84Gyou\u001b[88Gwant,\u001b[94GI\u001b[96Gcan\u001b[100Gadd\u001b[104Git\u001b[107Gas\u001b[110Ga\u001b[112Grow\u001b[116Gin\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m and plan i\u001b[32G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Grun\u001b[16Gthe\u001b[20Gclient\u001b[27Gor\u001b[30Gits\u001b[34Gtests\u001b[40Gjust\u001b[45Gnow;\u001b[50Gthis\u001b[55Gcomes\u001b[61Gfrom\u001b[66Gthe\u001b[70Gdocs\u001b[75Gand\u001b[79Gthe\u001b[83Ghistory\u001b[91Grecord.\u001b[99GI\u001b[101Galso\u001b[106Gdidn't\u001b[113Glook\u001b[118Gat\r\u001b[2C\u001b[1Bthe client code to estimate \u001b[32Ghe server-play \u001b[48Gork, \u001b[54Go that\u001b[61Gsize\u001b[66Gis a guess.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 33s · done 9:30 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, add the server-play row and plan it\u001b[39m                                                                              \r\u