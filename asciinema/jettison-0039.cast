ushed firs\u001b[80G.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GT\u001b[9Ge pin\u001b[15Gmove \u001b[21Glso brings in thi\u001b[40Gbatch's Jetti\u001b[54Gon work.\u001b[63GIts agen\u001b[72Gs reported no\u001b[86Ghash,\u001b[92Gsave\u001b[97Gor\u001b[100Greference-frame\r\u001b[2C\u001b[1B \u001b[5G  change, but Manifest\u001b[28Gstill\u001b[34Gneeds\u001b[40Ga\u001b[42Gbuild,\u001b[49Gtests\u001b[55Gand\u001b[59Gits\u001b[63Ggate\u001b[68Gon\u001b[71Gthe\u001b[75Gnew\u001b[79Gpin.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOpen decisions:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GL53: option\u001b[19G1,\u001b[22G2\u001b[24Gor 3.\u001b[30GI\u001b[32Grecommend\u001b[42G1,\u001b[45Gmoving\u001b[52GManifest's\u001b[63Gworld\u001b[69Gunder\u001b[75G\u001b[38;2;177;185;249mdefs/\u001b[81G\u001b[39mand\u001b[85Ghaving\u001b[92Gthe\u001b[96Gserver\u001b[103Gmount\u001b[109Goverlays\u001b[118Gas\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249mmod:<name>\u001b[39m.\u001b[K\r\u001b[17C\u001b[1Bpush.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GWhether\u001b[15Gto\u001b[18Greport\u001b[25GPipeWire\u001b[34G1.6.11's\u001b[43GJACK\u001b[48Gleak\u001b[53Gupstream.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gsaved two memories:       \u001b[32G      \u001b[39G   \u001b[43G   \u001b[27;1H\u001b[24;3H\u001b[?25h"]
