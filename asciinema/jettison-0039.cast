[0.041, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mD-122, a player founds their own company once:\u001b[22m every player star\u001b[70Gs\u001b[72Gwith a comp\u001b[84Gny\u001b[87Gt\u001b[89Gey\u001b[92Gname. On a\u001b[103Gserver,\u001b[111Ga\u001b[113Gplayer's\r\u001b[4C\u001b[1Btoken\u001b[11Gmay prov\u001b[20Gsion a company for tha\u001b[43G player only, \u001b[58Gnd\u001b[61Gonly once; the player is taken\u001b[92Gfrom the toke\u001b[106G,\u001b[108Gnever\u001b[114Gfrom\r\u001b[4C\u001b[1Bthe request. An\u001b[21Gadministrator\u001b[35Gcan\u001b[39Gstill\u001b[45Gprovision\u001b[55Ganyone.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL52, the first task in the queue:\u001b[22m a player can name their company from the client's console when the game starts,\r\u001b[4C\u001b[1Bwith \u001b[38;2;177;185;249mfound \"Ada Freight\"\u001b[39m, as well as on the start screen. The end-to-end test uses the console command, so it\u001b[115Gnever\r\u001b[4C\u001b[1Bhas to type into a field.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe plan's five steps:\u001b[22m\u001b[K\r\u001b[4C\u001b[1Ba. The server accepts a player's own \u001b[38;2;177;185;249mprovision\u001b[39m, with \u001b[38;2;177;185;249mcompany\u001b[39m test cases.\u001b[K\r\u001b[4C\u001b[1Bb. The\u001b[12Gclient\u001b[19Gmodel\u001b[25Gcan\u001b[29Gwork\u001b[34Gover\u001b[39Ga\u001b[41Gnetwork\u001b[49Gconnection,\u001b[61Gwith\u001b[66Ga\u001b[68G\u001b[38;2;177;185;249mclient_model\u001b[81G\u001b[39mcase\u001b[86Gagainst\u001b[94Ga\u001b[96Gserver\u001b[103Grunning\u001b[111Gin\u001b[114Gthe\r\u001b[5C\u001b[1B  test proc\u001b[18Gss.\u001b[K\r\u001b[4C\u001b[1Bc. The\u001b[12Gclient\u001b[19Ggets\u001b[24G\u001b[38;2;177;185;249m--connect\u001b[39m,\u001b[35G\u001b[38;2;177;185;249m--token-file\u001b[48G\u001b[39mand\u001b[52Gthe\u001b[56G\u001b[38;2;177;185;249mfound\u001b[62G\u001b[39mcommand,\u001b[71Ghas\u001b[75Gno\u001b[78Glocal\u001b[84Gworld,\u001b[91Gand\u001b[95Grefuses\u001b[103Gsaves\u001b[109Gwhile\r\u001b[5C\u001b[1B  connected.\u001b[K\r\u001b[4C\u001b[1Bd. A new \u001b[38;2;177;185;249mclient_serve\u001b[39m script runs the whole slice against a real \u001b[38;2;177;185;249mmanifest --serve\u001b[39m, including a server restart.\r\u001b[4C\u001b[1Be. The docum\u001b[18Gnts are\u001b[26Gupd\u001b[30Gted.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese are\u001b[13Gdocumentation\u001b[27Gchanges\u001b[35Gonly,\u001b[41Gso\u001b[44GI\u001b[46Gdidn't\u001b[53Grun\u001b[57Gthe\u001b[61Ggate.\u001b[67GNothing\u001b[75Gwas\u001b[79Gbuilt\u001b[85Gor\u001b[88Gtested.\r\u001b[2B \u001b[3GFor t\u001b[9Ge implement\u001b[22Gion, I'd use Opu\u001b[39G at high effort\u001b[55Gfor\u001b[59Gsteps\u001b[65G1–3\u001b[69Gand\u001b[73GSonnet\u001b[80Gfor\u001b[84Gthe\u001b[88Gscript\u001b[95Gand\u001b[99Gthe\u001b[103Gdocuments.\u001b[114GA\u001b[116Gfresh\r\u001b[1B  session is best for it: the plan doc and the\u001b[48Grow\u001b[52Ghold\u001b[57Geverything\u001b[68Git\u001b[71Gneeds,\u001b[78Gstarting\u001b[87Gfrom\u001b[92G\u001b[38;2;177;185;249mfeature-base\u001b[105G\u001b[39mat\u001b[108G\u001b[38;2;177;185;249me8715cb\u001b[39m.\r\u001b[22C\u001b[2B\u001b[38;2;153;153;153m4\u001b[25G2\u001b[39m\u001b[27;1H\u001b[24;27H\u001b[?25h"]
