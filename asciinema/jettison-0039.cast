[0.777, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B-\u001b[7GLan\u001b[11Gs:\u001b[14GManifest\u001b[23Glane\u001b[28GB\u001b[30Gis\u001b[33Gparked\u001b[40Gon\u001b[43G\u001b[38;2;177;185;249ml53-content-check\u001b[39m,\u001b[62Gholding\u001b[70Gone\u001b[74Gcommit\u001b[81G(the\u001b[86GL53\u001b[90Gqueue\u001b[96Grow).\u001b[102GThe\u001b[106Gother\u001b[112Glanes\u001b[118Gare\r\u001b[2C\u001b[1B \u001b[5G  free.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFirst, in the new shell:\u001b[22m\u001b[K\r\u001b[4C\u001b[1Ba\u001b[8GCheck that \u001b[38;2;177;185;249mecho $LD_LIBRARY_PATH\u001b[39m lists\u001b[47G\u001b[38;2;177;185;249mlibpulseaudio\u001b[61G\u001b[39mand\u001b[65G\u001b[38;2;177;185;249malsa-lib\u001b[39m.\r\u001b[4C\u001b[1Bb\u001b[9Gevert \u001b[38;2;177;185;249m40d0bdd\u001b[39m, the \u001b[38;2;177;185;249m--no-sound\u001b[39m flag.\u001b[K\r\u001b[4C\u001b[1Bc.\u001b[8GRun\u001b[12G\u001b[38;2;177;185;249mctest --test-dir build/clang-asan -R '^client_serve$'\u001b[66G\u001b[39min\u001b[69GManifest.\u001b[79GIt\u001b[82Gshould\u001b[89Glog\u001b[93G\"Playing\u001b[102Gthrough\u001b[110GPulseAudio\"\r\u001b[2C\u001b[1B \u001b[5G   and leak nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBefore pushing Manifest:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GIts parity\u001b[18Gcheck compar\u001b[31Gs\u001b[33G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m with\u001b[57G's at the pin, so\u001b[75Git fails\u001b[84Guntil\u001b[90Gthe\u001b[94Gpin\u001b[98Gmoves\u001b[104Gto\u001b[107G\u001b[38;2;177;185;249m66a9ce5\u001b[115G\u001b[39mor\r\u001b[4C\u001b[1B \u001b[7Glater. The pin is\u001b[25Gfetched from GitHub, \u001b[47Go Je\u001b[52Gtison has to be pushed firs\u001b[80G.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GT\u001b[9Ge pin\u001b[15Gmove \u001b[21Glso brings in thi\u001b[40Gbatch's Jetti\u001b[54Gon work.\u001b[63GIts agen\u001b[72Gs reported no\u001b[86Ghash,\u001b[92Gsave\u001b[97Gor\u001b[100Greference-frame\r\u001b[2C\u001b[1B \u001b[5G  change, but Manifest\u001b[28Gstill\u001b[34Gneeds\u001b[40Ga\u001b[42Gbuild,\u001b[49Gtests\u001b[55Gand\u001b[59Gits\u001b[63Ggate\u001b[68Gon\u001b[71Gthe\u001b[75Gnew\u001b[79Gpin.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOpen decisions:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GL53: option\u001b[19G1,\u001b[22G2\u001b[24Gor 3.\u001b[30GI\u001b[32Grecommend\u001b[42G1,\u001b[45Gmoving\u001b[52GManifest's\u001b[63Gworld\u001b[69Gunder\u001b[75G\u001b[38;2;177;185;249mdefs/\u001b[81G\u001b[39mand\u001b[85Ghaving\u001b[92Gthe\u001b[96Gserver\u001b[103Gmount\u001b[109Goverlays\u001b[118Gas\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249mmod:<name>\u001b[39m.\u001b[K\r\u001b[17C\u001b[1Bpush.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GWhether\u001b[15Gto\u001b[18Greport\u001b[25GPipeWire\u001b[34G1.6.11's\u001b[43GJACK\u001b[48Gleak\u001b[53Gupstream.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gsaved two memories:\u001b[K\r\u001b[4C\u001b[1BFix the cause of a failing\u001b[32Gcheck,\u001b[39Gnot it\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
