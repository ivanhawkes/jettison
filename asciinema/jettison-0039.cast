[0.058, "o", "\u001b[?25l\u001b[H\u001b[5Gwith \u001b[38;2;177;185;249mfound \"Ada Freight\"\u001b[39m,\u001b[31Gas\u001b[34Gwell\u001b[39Gas\u001b[42Gon\u001b[45Gthe\u001b[49Gstart\u001b[55Gscreen.\u001b[63GThe\u001b[67Gend-to-end\u001b[78Gtest\u001b[83Guses\u001b[88Gthe\u001b[92Gconsole\u001b[100Gcommand,\u001b[109Gso\u001b[112Git\u001b[115Gnever\r\u001b[2C\u001b[1B \u001b[5Ghas to type into a field.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe plan's five steps:\u001b[22m\u001b[K\r\u001b[4C\u001b[1Ba\u001b[12Gserver\u001b[19Gacc\u001b[23Gpts a\u001b[29Gplayer's own \u001b[38;2;177;185;249mprovision\u001b[39m, wi\u001b[56Gh \u001b[38;2;177;185;249mcompany\u001b[66G\u001b[39mtest cases.\u001b[K\r\u001b[4C\u001b[1Bb.\u001b[8GThe client model\u001b[25Gcan\u001b[29Gwork\u001b[34Gover\u001b[39Ga\u001b[41Gnetwork\u001b[49Gconnection,\u001b[61Gwith\u001b[66Ga\u001b[68G\u001b[38;2;177;185;249mclient_model\u001b[81G\u001b[39mcase\u001b[86Gagainst\u001b[94Ga\u001b[96Gserver\u001b[103Grunning\u001b[111Gin\u001b[114Gthe\r\u001b[4C\u001b[1B  \u001b[8Gtest process.\u001b[K\r\u001b[4C\u001b[1Bc.\u001b[8GThe cli\u001b[16Gnt\u001b[19Ggets\u001b[24G\u001b[38;2;177;185;249m--connect\u001b[39m,\u001b[35G\u001b[38;2;177;185;249m--token-file\u001b[48G\u001b[39mand\u001b[52Gthe\u001b[56G\u001b[38;2;177;185;249mfound\u001b[62G\u001b[39mcommand,\u001b[71Ghas\u001b[75Gno\u001b[78Glocal\u001b[84Gworld,\u001b[91Gand\u001b[95Grefuses\u001b[103Gsaves\u001b[109Gwhile\r\u001b[4C\u001b[1B  \u001b[8Gco\u001b[11Gnected.\u001b[K\r\u001b[4C\u001b[1Bd\u001b[8GA new \u001b[38;2;177;185;249mclient_serve\u001b[39m script runs\u001b[39Gthe\u001b[43Gwhole\u001b[49Gslice\u001b[55Gagainst\u001b[63Ga\u001b[65Greal\u001b[70G\u001b[38;2;177;185;249mmanifest --serve\u001b[39m,\u001b[88Gincluding\u001b[98Ga\u001b[100Gserver\u001b[107Grestart.\r\u001b[4C\u001b[1Be.\u001b[8GThe\u001b[12Gdocuments\u001b[22Gare\u001b[26Gupdated.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gare\u001b[13Gdocumentation\u001b[27Gchanges\u001b[35Gonly,\u001b[41Gso\u001b[44GI\u001b[46Gdidn't\u001b[53Grun\u001b[57Gthe\u001b[61Ggate.\u001b[67GNothing\u001b[75Gwas\u001b[79Gbuilt\u001b[85Gor\u001b[88Gtested.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor the\u001b[12Gmpl\u001b[16Gmentation,\u001b[27GI'd\u001b[31Guse Opus\u001b[41Gt high\u001b[48Geffort for steps 1–3 and Sonnet for the script and the documents. A fresh\r\u001b[2C\u001b[1Bsession\u001b[11Gis\u001b[14Gbest\u001b[19Gfor\u001b[23Git:\u001b[27Gthe\u001b[31Gplan\u001b[36Gdoc\u001b[40Gand\u001b[44Gthe\u001b[48Grow\u001b[52Ghold\u001b[57Geverything\u001b[68Git\u001b[71Gneeds,\u001b[78Gstarting\u001b[87Gfrom\u001b[92G\u001b[38;2;177;185;249mfeature-base\u001b[105G\u001b[39mat\u001b[108G\u001b[38;2;177;185;249me8715cb\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 44s · done 9:39 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThe UI will will, in\u001b[24Gtime,\u001b[30Gallow th\u001b[39G player to \u001b[51Game their ships (once), or rename them if approved by an admin or \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255msome outside process which is not yet well defined.\u001b[39m                                                                   \r\u001b[1B\u001b[49m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
