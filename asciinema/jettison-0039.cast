[0.086, "o", "\u001b[?25l\u001b[H\u001b[11G\u001b[38;2;248;248;242m\u001b[48;2;61;1;0merlap\u001b[17G and a dynamic compound meet\u001b[46Gng a wall, refusals\u001b[67Ga\u001b[69Gd a \u001b[74Ghape file round trip. No hash pins moved\r\u001b[10C\u001b[1B.\u001b[13G[Physic\u001b[21G](physics.md) |         \u001b[46G         \u001b[56G       \u001b[64G      \u001b[71G      \u001b[78G   \u001b[82G     \u001b[88G        \u001b[97G      \u001b[104G       \u001b[112G  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  2 +\u001b[38;2;248;248;242mFree: parked on feature-base. J07 (offsets, compounds) merged 2026-11-28, awaiting the batch gate.     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ07 is merged into Jettison's \u001b[38;2;177;185;249mfeature-base\u001b[39m (\u001b[38;2;177;185;249md54c5c4\u001b[39m,\u001b[56Grebased,\u001b[65Gplus\u001b[70G\u001b[38;2;177;185;249m95b55b9\u001b[78G\u001b[39mfor\u001b[82Gthe\u001b[86Groadmap\u001b[94Gand\u001b[98Ghistory\u001b[106Gentries).\u001b[116GBoth\r\u001b[2C\u001b[1BJettison\u001b[12Glanes\u001b[18Gare\u001b[22Gnow\u001b[26Gmerged\u001b[33Gand\u001b[37Gfree.\u001b[43GWaiting\u001b[51Gfor\u001b[55Gthe\u001b[59Gtwo\u001b[63GManifest\u001b[72Glanes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mcan we load some more work into jettison?\u001b[39m                                                                             \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Both Jettison lanes are free, so I'm assigning J07 (collision filtering for a game's own layers and groups) to lane-b\u001b[K\r\u001b[2C\u001b[1Band\u001b[7GJ14\u001b[11G(reloading\u001b[22Gstylesheets\u001b[34Gand\u001b[38Gdocuments\u001b[48Gon\u001b[51Gfile\u001b[56Gchange,\u001b[64Gplus\u0