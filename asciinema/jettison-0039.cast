[0.070, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(bash -c\u001b[16G'\u001b[18Gource /home/ivan/projects/jettison/scripts/lib/head\u001b[70Gess.sh && headless_use_lavapipe && env -u DISPLAY\r\u001b[2C\u001b[1B    -u WAYLAND_DISPLAY\u001b[26GASAN_SYMBOLIZER_PATH=/nix/sto…)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mbash:\u001b[12Gsoftware\u001b[21Gdriver\u001b[28G/nix/store/jg8f97fhfmkpccrm3lsxlavkivpjbs72-mesa-26.2.5/share/vulkan/icd.d/lvp_icd.x86_6\r\u001b[2C\u001b[1B   4.json\u001b[K\r\u001b[5C\u001b[1Bexit=1\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  (another command ran in this repository at the same time; a change made by either may show under either \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mresult)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The client plays through JACK, so PulseAudio and ALSA failed first and every run opens the desktop's JACK server.\u001b[117GI'm\r\u001b[2C\u001b[1Bchecking which\u001b[18Gaudio\u001b[24Glibraries\u001b[34Gminiaudio\u001b[44Gcan\u001b[48Gload\u001b[53Ghere\u001b[58Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[3C\u001b[2B\u001b[39munn\u001b[11Gcd '/home/iva\u001b[25G/projects/manifest'\u001b[45G&&\u001b[48Gexport\u001b[55GCMAKE…\r\u001b[7C\u001b[1B\u001b[38;2;153;153;153mcd '/home/ivan/projects/manifest' && export CMAKE_BUILD_PARALLEL_L\u001b[75GVEL='24' CTEST_PARALLEL_LEVEL='24' \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS='24'; ./scripts/ci.sh --werror --asan --tidy --log build/gate.log > /dev/null 2>&1 (6m 47s)\r\u001b[83C\u001b[2Bthought for 6s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
