[0.083, "o", "\u001b[?25l\u001b[H\u001b[3G2\u001b[6G\u001b[1mRevert \u001b[38;2;177;185;249m40d0bdd\u001b[39m, or keep it?\u001b[22m Reverting makes \u001b[38;2;177;185;249mclient_serve\u001b[63G\u001b[39mplay through the desktop's\u001b[90Gsound server like a player\r\u001b[8C\u001b[1B. K\u001b[13Gep\u001b[16Gng it\u001b[22Gm\u001b[25Gches the engine's smoke tes\u001b[53G, which neve\u001b[66G to\u001b[70Gches the sound\u001b[85Gsystem.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mL53, the content check, is still parked.\u001b[47G\u001b[22mI\u001b[49Grecommend\u001b[59Goption\u001b[66G1:\u001b[69Gmove\u001b[74GManifest's\u001b[85Gworld\u001b[91Gunder\u001b[97G\u001b[38;2;177;185;249mdefs/\u001b[39m.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mPush?\u001b[22m Both batches are merged on \u001b[38;2;177;185;249mfeature-base\u001b[39m. Jettison is ready now;\u001b[76GManif\u001b[83Gt, once 1 and 2 are\u001b[103Gsettled.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat's a large block of work done, so this is\u001b[49Ga g\u001b[53God point t\u001b[64G \u001b[38;2;177;185;249m/compact\u001b[39m, or to start a fresh session after\u001b[109Gthe\u001b[113Gpush.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 1h 41m 14s · done 11:24 am\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mdo that, make the changes to devenv.nix and i will restart you when an opportunity presents itself.\u001b[39m                   \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMaking\u001b[10Gthe\u001b[14G\u001b[38;2;177;185;249mdevenv.nix\u001b[25G\u001b[39mchange.\u001b[33GFirst\u001b[39Gchecking\u001b[48Ghow\u001b[52Gthe\u001b[56Gfile\u001b[61Gsets\u001b[66Gthe\u001b[70Glibrary\u001b[78Gpath,\u001b[84Gand\u001b[88Ghow\u001b[92GManifest's\u001b[103Genvironment-parity\r\u001b[1B  check ties its copy to the engine pin.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GPipeWire\u001b[16GJACK\u001b[21Gentry\u001b[27Gis\u001b[30Gcoming\u001b[37Gfrom\u001b[42GNixOS's\u001b[50Gsystem\u001b[57GLD_LIBRARY_PATH,\u001b[74Gso\u001b[77GI'll\u001b[82Gadd\u001b[86Gthe\u001b[90Gtwo\u001b[94Gaudio\u001b[100Glibraries\u001b[110Gto\u001b[113Gthe\r\u001b[1B \u001b[3Gshell's list in\u001b[19GJe\u001b[23Gison\u001b[28Gand copy that file to Manifest,\u001b[60Gwhich also\u001b[71Gneeds\u001b[77Ga\u001b[79Gpin\u001b[83Gmove\u001b[88Gto\u001b[91Gpass\u001b[96Gits\u001b[100Gparity\u001b[107Gcheck.\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m  \u001b[38;2;153;153;153m· summ\u001b[10Gry\u001b[39m\u001b[K\r\u001b[34C\u001b[2B\u001b[38;2;153;153;153mthought for 10s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
