[0.687, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1BL\u001b[10Ges: Manifest lane B is parked on \u001b[38;2;177;185;249ml53-content-check\u001b[39m, holding one commit\u001b[81G(the L53 queue row). The\u001b[106Gother\u001b[112Glanes\u001b[118Gare\r\u001b[4C\u001b[1B \u001b[7Gfre\u001b[11G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFirst, in the new shell:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5Ga. Check that \u001b[38;2;177;185;249mecho $LD_LIBRARY_PATH\u001b[41G\u001b[39mlists\u001b[47G\u001b[38;2;177;185;249mlibpulseaudio\u001b[61G\u001b[39mand\u001b[65G\u001b[38;2;177;185;249malsa-lib\u001b[39m.\r\u001b[4C\u001b[1Bb\u001b[8GRevert \u001b[38;2;177;185;249m40d0bdd\u001b[39m, the \u001b[38;2;177;185;249m--no-sound\u001b[39m flag.\u001b[K\r\u001b[4C\u001b[1Bc\u001b[9Gun \u001b[38;2;177;185;249mctest --test-dir build/clang-asan -R '^client_serve$'\u001b[66G\u001b[39min\u001b[69GManifest.\u001b[79GIt\u001b[82Gshould\u001b[89Glog\u001b[93G\"Playing\u001b[102Gthrough\u001b[110GPulseAudio\"\r\u001b[4C\u001b[1B  \u001b[8Gand\u001b[12Gleak nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBefore pushing Manifest:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- Its parity check compares\u001b[33G\u001b[38;2;177;185;249mdevenv.nix\u001b[44G\u001b[39mwith\u001b[49GJettison's\u001b[60Gat\u001b[63Gthe\u001b[67Gpin,\u001b[72Gso\u001b[75Git\u001b[78Gfails\u001b[84Guntil\u001b[90Gthe\u001b[94Gpin\u001b[98Gmoves\u001b[104Gto\u001b[107G\u001b[38;2;177;185;249m66a9ce5\u001b[115G\u001b[39mor\r\u001b[4C\u001b[1B \u001b[7Glater. The\u001b[18Gpin is fetch\u001b[31Gd\u001b[33Gfrom GitHub, so\u001b[57G has to be pushed\u001b[75Gfirst.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe pin move also\u001b[25Gbrings in this batch'\u001b[47G Jet\u001b[52Gison work. Its agents repor\u001b[80Ged\u001b[83Gno\u001b[86Ghash,\u001b[92Gsave\u001b[97Gor\u001b[100Greference-frame\r\u001b[4C\u001b[1B \u001b[7Gc\u001b[9Gange,\u001b[15Gbut M\u001b[21Gnifest still need\u001b[40Ga build, test\u001b[54G and its\u001b[63Ggate on \u001b[72Ghe new pin.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOpen decisions:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- L53: option 1,\u001b[22G2\u001b[24Gor 3.\u001b[30GI\u001b[32Grecommend\u001b[42G1,\u001b[45Gmoving\u001b[52GManifest's\u001b[63Gworld\u001b[69Gunder\u001b[75G\u001b[38;2;177;185;249mdefs/\u001b[81G\u001b[39mand\u001b[85Ghaving\u001b[92Gthe\u001b[96Gserver\u001b[103Gmount\u001b[109Goverlays\u001b[118Gas\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249mmod:<name>\u001b[39m.\u001b[19G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GWhether to push.\r\u001b[17C\u001b[1Breport\u001b[25GPipeWire\u001b[34G1.6.11's\u001b[43GJACK\u001b[48Gleak\u001b[53Gupstream.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gsaved\u001b[11Gtwo\u001b[15Gmemories:\r\u001b[2C\u001b[1B-\u001b[5GFix the cause of a failing\u001b[32Gcheck,\u001b[39Gnot\u001b[43Gits\u001b[27;1H\u001b[24;3H\u001b[?25h"]
