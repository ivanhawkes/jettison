[0.054, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[2m21\u001b[12G\u001b[22m6\u001b[15Gclang-tidy over Manifest's\u001b[42Gown\u001b[46Gunits\u001b[52Gin\u001b[55G`clang-debug`\u001b[69G(`scripts/tidy.py`),\u001b[90Gwith\u001b[95G`--tidy`.\r\u001b[7C\u001b[1B\u001b[2m22\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 123 \u001b[22m Tidy runs last, so a finding fails the gate without hiding the results of the stages before it\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m12\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest's sanitised stage now leaves out the eight long fixture loops. It's committed as \u001b[38;2;177;185;249m73a8289\u001b[39m and fast-forwarded\r\u001b[2C\u001b[1Binto \u001b[38;2;177;185;249mfeature-base\u001b[39m, not\u001b[26Gpushed.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat's left out:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mfixture\u001b[39m and seve\u001b[39G \u001b[38;2;177;185;249mfixture_*\u001b[39m sui\u001b[55Gs (al\u001b[61Gne, bur\u001b[69G,\u001b[71Gcarri\u001b[77Gr, cruise, development, prices\u001b[108Gand\u001b[112Gtraffic).\r\u001b[4C\u001b[1BUnder\u001b[11Gthe\u001b[15Gsanitisers\u001b[26Gthey\u001b[31Gtook\u001b[36G230–634\u001b[44Gs\u001b[46Geach,\u001b[52Gand\u001b[56G\u001b[38;2;177;185;249mfixture_cruise\u001b[71G\u001b[39malone\u001b[77Gwas\u001b[81Gthe\u001b[85Gwhole\u001b[91G634\u001b[95Gs\u001b[97Gstage.\r\u001b[2C\u001b[1B- \u001b[1mWhat still runs:\u001b[22m the\u001b[26Gother\u001b[32G60\u001b[35Gsuites,\u001b[43G\u001b[38;2;177;185;249mfixture_governance\u001b[62G\u001b[39mamong\u001b[68Gthem,\u001b[74Grun\u001b[78Gsanitised.\u001b[89GThe\u001b[93GDebug,\u001b[100Gno-TUI\u001b[107Gand\u001b[111GRelease\r\u001b[4C\u001b[1Btrees\u001b[11Gstill\u001b[17Grun\u001b[21Gall\u001b[25G68\u001b[28Gsuites.\r\u001b[1B \u001b[3G- \u001b[1mWhere:\u001b[22m the exclusion is i\u001b[31G \u001b[38;2;177;185;249mCMakePresets.js\u001b[75G\u001b[39m so a manual \u001b[38;2;177;185;249mctest --preset clang-asan\u001b[39m behaves\u001b[27;1H\u001b[18;3H\u001b[?25h"]
