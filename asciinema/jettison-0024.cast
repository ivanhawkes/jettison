[1.615, "o", "\u001b[?25l\u001b[H\u001b[5Gbackends\u001b[14G(\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m);\u001b[35Gnothing\u001b[43Gelse\u001b[48Gin\u001b[51Gthe\u001b[55Gtree\u001b[60Guses\u001b[65Gthem.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m,\u001b[37G\u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m,\u001b[75Gand\u001b[79Ga\u001b[81Gnew\u001b[85G\u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest:\u001b[106Ga\u001b[108Gsmall\u001b[114Gprogram\r\u001b[4C\u001b[1Bthat\u001b[10Glinks\u001b[16G\u001b[38;2;177;185;249mDevtools\u001b[25G\u001b[39malone\u001b[31Gand\u001b[35Gdraws\u001b[41Ga\u001b[43Gconsole\u001b[51Gin\u001b[54Gone\u001b[58GImGui\u001b[64Gframe\u001b[70Gwith\u001b[75Gno\u001b[78Grenderer.\u001b[88GRunning,\u001b[97Git\u001b[100Gchecks\u001b[107Gthat\u001b[112Gno\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibglfw\u001b[39m is lo\u001b[32Gded. The \u001b[43Gst also fails if \u001b[38;2;177;185;249mreadelf\u001b[39m sh\u001b[71Gws either i\u001b[83G NEEDED, or\u001b[95Gshows no NEEDED entries\u001b[119Gat\r\u001b[2C\u001b[1B  all.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m:\u001b[22Gthe\u001b[26Gfinished\u001b[35Grow\u001b[39Gmoves\u001b[45Gout\u001b[49Gof\u001b[52Gthe\u001b[56Gtable,\u001b[63Gas\u001b[66Gearlier\u001b[74Gfinished\u001b[83Grows\u001b[88Gdid,\u001b[93Gand\u001b[97Gthe\u001b[101Gintro\u001b[107Gparagraph\u001b[117Gsays\r\u001b[2C\u001b[1B  the gap is\u001b[16Gprovisioned.\u001b[29G\u001b[38;2;177;185;249mdocs/history.md\u001b[45G\u001b[39mgets\u001b[50Gthe\u001b[54Gdelivery's\u001b[65Gtable\u001b[71Grow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mEngine:\u001b[22m before the change, the \u001b[38;2;177;185;249mdev\u001b[40Gools\u001b[39m suite's binary needed \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m. Now\u001b[87G\u001b[38;2;177;185;249mdevtools_alone\u001b[102G\u001b[39mneeds only\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibstdc++\u001b[39m, \u001b[38;2;177;185;249mlibm\u001b[39m, \u001b[38;2;177;185;249mlibgcc_s\u001b[39m and\u001b[35G\u001b[38;2;177;185;249mlibc\u001b[39m, and it\u001b[48Gpasses. \u001b[38;2;177;185;249mrender_test\u001b[39m still\u001b[74Gneeds\u001b[80G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m,\u001b[96Gas\u001b[99Git\u001b[102Gshould.\r\u001b[4C\u001b[1B\u001b[1mManifest:\u001b[22m I built \u001b[38;2;177;185;249mmanifest_tui\u001b[39m against this working tree in \u001b[38;2;177;185;249mbuild/sdk-local\u001b[39m. Its NEEDED has no\u001b[100G\u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibglfw\u001b[39m;\r\u001b[6C\u001b[1Be bu\u001b[12Gld on the current pi\u001b[33G \u001b[38;2;177;185;249mea66afe\u001b[39m has \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m. Run on a terminal for about ten minu\u001b[99Ges, it had neither\r\u001b[4C\u001b[1Bloaded.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate:\u001b[11G\u001b[22m\u001b[38;2;177;185;249m./scripts/ci.sh --werror --asan --log build/gate.log\u001b[64G\u001b[39mpassed\u001b[71Gevery\u001b[77Gstage\u001b[83Gin\u001b[86G199\u001b[90Gs,\u001b[93Grun\u001b[97Gwith\u001b[102G58\u001b[105GGiB\u001b[109Gfree.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWaiting for your go-ahead:\u001b[22m the engine commit (suggested subjec\u001b[66G: \u001b[38;2;177;185;249mExternal: ImGui's GLFW and Vulkan backends out of \r\u001b[2C\u001b[1Bimgui, for Manifest's R07\u001b[39m).\u001b[31GAfter\u001b[37Git:\u001b[41GManifest's\u001b[52G\u001b[38;2;177;185;249mMANIFEST_JETTISON_REVISION\u001b[79G\u001b[39mbump\u001b[84Gand\u001b[88Ga\u001b[90Gcheck\u001b[96Gon\u001b[99Gthe\u001b[103Gpin,\u001b[108Gits\r\u001b[2C\u001b[1Bdelivery-order\u001b[18Gand\u001b[22Ghandoff\u001b[30Gnotes,\u001b[37Gand\u001b[41Gits\u001b[45Ghistory\u001b[53Gline.\r\u