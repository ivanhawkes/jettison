b[39m and \u001b[38;2;177;185;249mlibc\u001b[39m, and\u001b[45Git pas\u001b[52Ges. \u001b[38;2;177;185;249mrender_test\u001b[39m still needs \u001b[38;2;177;185;249mlibvulkan.s\u001b[92G.1\u001b[39m, as it\u001b[102Gshould.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m I built \u001b[38;2;177;185;249mmanife\u001b[30Gt_tui\u001b[39m against this working tree in \u001b[38;2;177;185;249mbuild/sdk-local\u001b[39m. Its NEEDED has no \u001b[38;2;177;185;249mlibvulkan\u001b[110G\u001b[39mor\u001b[113G\u001b[38;2;177;185;249mlibglfw\u001b[39m;\r\u001b[2C\u001b[1B \u001b[5Gthe build\u001b[15Gon the current pin \u001b[38;2;177;185;249mea66afe\u001b[39m has \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[62GRun on a terminal for about ten minutes, it had\u001b[110Gneither\u001b[K\r\u001b[4C\u001b[1Bloaded.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate:\u001b[22m \u001b[38;2;177;185;249m./scripts/ci.sh --werror --asan --log build/gate.log\u001b[64G\u001b[39mpassed\u001b[71Gevery\u001b[77Gstage\u001b[83Gin\u001b[86G199\u001b[90Gs,\u001b[93Grun\u001b[97Gwith\u001b[102G58\u001b[105GGiB\u001b[109Gfree.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWaiting for your go-ahead:\u001b[30G\u001b[22mthe\u001b[34Gengine\u001b[41Gcommit\u001b[48G(suggested\u001b[59Gsubject:\u001b[68G\u001b[38;2;177;185;249mExternal: ImGui's GLFW and Vulkan backends out of \r\u001b[2C\u001b[1Bimgui, for Manifest's R07\u001b[39m). Aft\u001b[35Gr \u001b[38Gt:\u001b[41GManifest's \u001b[38;2;177;185;249mMANIFEST_JETTISON_REVISION\u001b[39m bump and a check on the pin, its\u001b[K\r\u001b[2C\u001b[1Bdelivery-order and handoff notes,\u001b[37Gand\u001b[41Gits hi\u001b[49Gory line.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Ghide\u001b[17Gthe\u001b[21GVulkan\u001b[28Gloader\u001b[35Gfrom\u001b[40Gthe\u001b[44Gsystem\u001b[51Gfor\u001b[55Gthe\u001b[59G\"starts\u001b[67Gwith\u001b[72Gno\u001b[75GVulkan\u001b[82Gloader\u001b[89Gpresent\"\