h\u001b[109Gtakes\u001b[115Ga\r\u001b[2C\u001b[1Bseparate\u001b[12Gsysroot\u001b[20Gor\u001b[23Gtoolchain,\u001b[34Gnot\u001b[38Gjust\u001b[43Ga\u001b[45Glink\u001b[50Gflag.\u001b[56GThat's\u001b[63Ga\u001b[65Gchange\u001b[72Gto\u001b[75GD-114,\u001b[82Gand\u001b[86GI\u001b[88Ghaven't\u001b[96Gmade\u001b[101Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMint, Pop!_OS,\u001b[18Gelementary and SteamOS aren't on Repology,\u001b[65Gthe Ubuntu 22.04–25.10, Tumbleweed and Void figures\u001b[117Gcome\r\u001b[2C\u001b[1Bf\u001b[6Gm a summary of the page rather than its raw rows.\u001b[56GMint\u001b[61Gand\u001b[65GPop!_OS\u001b[73Gfollow\u001b[80Gtheir\u001b[86GUbuntu\u001b[93GLTS\u001b[97Gbase,\u001b[103Gso\u001b[106Gthey're\r\u001b[2C\u001b[1Bprobably\u001b[12Gon\u001b[15G2.39\u001b[20Gor\u001b[23Golder\u001b[29Guntil\u001b[35Gthey\u001b[40Gmove\u001b[45Gto\u001b[27;1H\u001b[24;113H\u001b[?25h"]
