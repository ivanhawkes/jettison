[0.084, "o", "\u001b[?25l\u001b[H\u001b[5GRHEL,\u001b[11GAlma,\u001b[17GRocky\u001b[25Gnone    \u001b[34G      \u001b[66G9 (2.34); 10\u001b[79Gisn't\u001b[85Gon\u001b[88GRepology\r\u001b[4C\u001b[2BVoid \u001b[11G     \u001b[17G     \u001b[66G2.41     \u001b[76G  \u001b[79G     \u001b[85G  \u001b[88G        \r\u001b[2C\u001b[1B└\u001b[23G┴\u001b[64G┴\u001b[106G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe 2.43 floor rules out Debian stable, Ubuntu 24.04 LTS, every RHEL-family release, Leap and NixOS stable.\u001b[111GMost\r\u001b[2C\u001b[1Bservers\u001b[11Grun\u001b[15Gone\u001b[19Gof\u001b[22Gthose.\u001b[29GIf\u001b[32Gthe\u001b[36Gbundle\u001b[43Ghas\u001b[47Gto\u001b[50Greach\u001b[56Gthem,\u001b[62GR07\u001b[66Ghas\u001b[70Gto\u001b[73Gbuild\u001b[79Gagainst\u001b[87Gan\u001b[90Golder\u001b[96Gglibc,\u001b[103Gwhich\u001b[109Gtakes\u001b[115Ga\r\u001b[2C\u001b[1Bseparate\u001b[12Gsysroot or t\u001b[25Golchain, no\u001b[37G just\u001b[43Ga link\u001b[50Gflag.\u001b[56GThat's a change to D-114, and I\u001b[88Ghaven't made it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMint, Pop!_OS, elementary \u001b[30Gnd SteamOS aren't on Repology, and\u001b[65Gt\u001b[67Ge Ubuntu 22.04–25.10, Tumblewee\u001b[99G and Void\u001b[109Gfigures\u001b[117Gcome\r\u001b[2C\u001b[1Bfrom\u001b[8Ga\u001b[10Gsummary\u001b[18Gof\u001b[21Gthe\u001b[25Gpage\u001b[30Grather\u001b[37Gthan\u001b[42Gits\u001b[46Graw\u001b[50Grows.\u001b[56GMint\u001b[61Gand\u001b[65GPop!_OS\u001b[73Gfollow\u001b[80Gtheir\u001b[86GUbuntu\u001b[93GLTS\u001b[97Gbase,\u001b[103Gso\u001b[106Gthey're\r\u001b[2C\u001b[1Bprobably on 2.39 or older\u001b[29Gu\u001b[31Gtil they mov\u001b[44G to\u001b[48G26.04.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 2m 52s · done 3:04 pm\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThose are pretty modern disto releases, what compromises do we need to make to get it