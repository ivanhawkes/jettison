[0.012, "o", "\u001b[H\r\u001b[11B \u001b[6GStandalone bundle (Recommended)\r\u001b[10B\u001b[38;2;177;185;249m❯\u001b[6G\u001b[39m\u001b[2mType something.\r\u001b[47C\u001b[4B\u001b[22m\u001b[38;2;153;153;153mctrl+g\u001b[55Gto edit in nano · Esc to cancel\u001b[39m\u001b[27;1H\u001b[22;6H\u001b[?25h"]
