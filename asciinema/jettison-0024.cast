[0.039, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[11G\u001b[38;2;248;248;242m256 KiB an unreli\u001b[29Gble\u001b[33Gmessag\u001b[41Gdoe\u001b[45G not ar\u001b[53Give, and a\u001b[64Gview wants delta\u001b[82G    \u001b[87G        \u001b[96G    \u001b[101G     \u001b[107G   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m6\u001b[11G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mhistory\u001b[38;2;248;248;242m](history.md#r02-durable-io-directories-and-the-world-lock--2026-11-24)).\u001b[48;2;4;71;0m W22, the drives\u001b[48;2;2;40;0m \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;248;248;242mpast the\u001b[20Gtorch, waits \u001b[34Gor th\u001b[40G first larger hull. The\u001b[64Glater\u001b[70Gworkstreams (L01\u001b[87Gonwards)\u001b[96Gwait until th\u001b[110G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m18\u001b[11G\u001b[38;2;248;248;242muser ha\u001b[19G played the first loop for a day or two\u001b[59G(2026-11-24). Jettis\u001b[81G's station traffic\u001b[100Glanes\u001b[106Gwere\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 19 +\u001b[38;2;248;248;242mmeasured and parked (`fixture_traffic`, 2026-11-22), to be taken up when it fails. A commit is gated   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 20 +\u001b[38;2;248;248;242min the second checkout, `build/gate-tree`, with `--tidy`, editing alone beside it                      \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m1\u001b[11G\u001b[22m([\u001b[38;2;230;219;116mgating beside the work\u001b[39m](build-and-gates.md#gating-beside-the-work)).\u001b[82GThe\u001b[86Gdevelopment\u001b[98Gfixture\u001b[106Gtakes\r\u001b[5C\u001b[1B\u001b[2m 22 \u001b[11G\u001b[22mabout\u001b[17G50\u001b[20Gs\u001b[22Gin\u001b[25GDebug\u001b[31Gand\u001b[35Gsix\u001b[39Gminutes\u001b[47Gunder\u001b[53GASan,\u001b[59Gmost\u001b[64Gof\u001b[67Gthe\u001b[71Ggate's\u001b[78Gsanitised\u001b[88Gstage.\r\u001b[1B \u001b[3G   \u001b[2m 23 \u001b[22m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs written.\u001b[17GChecking\u001b[26Ghow\u001b[30GManifest\u001b[39Ggates\u001b[45Gin\u001b[48Gits\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbefore\u001b[75GI\u001b[77Grun\u001b[81Git.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mComm\u001b[8Gtting\u001b[14Gin Manifest, then gating that\u001b[44Gcommit in\u001b[54G\u001b[38;2;177;185;249mbuild/gate-tree\u001b[70G\u001b[39mwith\u001b[75G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[98G\u001b[39mat\u001b[101Gfull\u001b[106Gwidth.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mMaking \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+36\u001b[39m, committed \u001b[1m9dd0d81\u001b[22m, searching for \u001b[1m1\u001b[22m pattern,\u001b[77Greading\u001b[85G\u001b[1m1\u001b[87G\u001b[22mfile,\u001b[93Grunning\u001b[101G\u001b[1m6\u001b[103G\u001b[22mshell\u001b[109Gcommands…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  ~/.claude/projects/-home-ivan-projects-jettis\u001b[52Gn/a14bac04-cd03-4748-9eba-b921d4611f23/tool-results/byv7vjc0s.txt\r\u001b[2C\u001b[2B\u001b[38;2;235;159;127mFiddle-faddling…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
