[0.828, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate is running in the background (58 GiB free, \u001b[38;2;177;185;249mstrata-host\u001b[39m not\u001b[71Grunn\u001b[76Gng). I'll wait for it to fin\u001b[105Gsh.\u001b[109G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mBackground command \"./scripts/ci.sh --werror --asan\u001b[55G--log build/gate.lo\u001b[75G\" completed\u001b[87G(ex\u001b[91Gt\u001b[93Gcode 0)\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe engine side is finished \u001b[32Gnd the ga\u001b[43G is green, but nothing is c\u001b[71Gmmitted. Ma\u001b[83Gifest's pin\u001b[95Gbump needs the engine\u001b[K\r\u001b[2C\u001b[1Bcommit's\u001b[12Ghash,\u001b[18Gand\u001b[22Gyou\u001b[26Gasked\u001b[32Gme\u001b[35Gto\u001b[38Gcommit\u001b[45Gonly\u001b[50Gwhen\u001b[55Gyou\u001b[59Gsay\u001b[63Gso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m:\u001b[37G\u001b[38;2;177;185;249mimgui\u001b[43G\u001b[39mnow\u001b[47Gholds\u001b[53Gonly\u001b[58GImGui's\u001b[66Gcore\u001b[71Gand\u001b[75Gits\u001b[79GFreeType\u001b[88Gfont\u001b[93Gcode,\u001b[99Gand\u001b[103Glinks\u001b[109Gonly\r\u001b[2C\u001b[1B  FreeType.\u001b[15GA\u001b[17Gnew\u001b[21G\u001b[38;2;177;185;249mimgui_backends\u001b[36G\u001b[39mtarget\u001b[43Gholds\u001b[49Gthe\u001b[53GGLFW\u001b[58Gand\u001b[62GVulkan\u001b[69Gbackends\u001b[78Gand\u001b[82Glinks\u001b[88G\u001b[38;2;177;185;249mimgui\u001b[39m,\u001b[95G\u001b[38;2;177;185;249mglfw\u001b[100G\u001b[39mand\u001b[104G\u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource/engine/render/CMakeLists.tx\u001b[40G\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[39m links \u001b[38;2;177;185;249mimgui_backends\u001b[39m alongside \u001b[38;2;177;185;249mimgui\u001b[39m.\u001b[87GIt is the only\u001b[102Gcode that calls\u001b[118Gthe\r\u001b[4C\u001b[1Bbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m);\u001b[35Gnothing else\u001b[48Gin the tree uses them.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m, and a new \u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest: a small program\r\u001b[6C\u001b[1Bat l\u001b[12Gnks \u001b[38;2;177;185;249mDevtools\u001b[39m alone a\u001b[33Gd draws a console in one ImGui frame with no renderer. Running, i\u001b[99G checks that no\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[15G\u001b[39mor\u001b[18G\u001b[38;2;177;185;249mlibglfw\u001b[26G\u001b[39mis\u001b[29Gloaded.\u001b[37GThe\u001b[41Gtest\u001b[46Galso\u001b[51Gfails\u001b[57Gif\u001b[60G\u001b[38;2;177;185;249mreadelf\u001b[68G\u001b[39mshows\u001b[74Geither\u001b[81Gin\u001b[84GNEEDED,\u001b[92Gor\u001b[95Gshows\u001b[101Gno\u001b[104GNEEDED\u001b[111Gentries\u001b[119Gat\r\u001b[2C\u001b[1B \u001b[5Gall. \u001b[11G                                    \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[8.000, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gis\u001b[15Grunning\u001b[23Gin\u001b[26Gthe\u001b[30Gbackground\u001b[41G(58\u001b[45GGiB\u001b[49Gfree,\u001b[55G\u001b[38;2;177;185;249mstrata-host\u001b[67G\u001b[39mnot\u001b[71Grunning).\u001b[81GI'll\u001b[86Gwait\u001b[91Gfor\u001b[95Git\u001b[98Gto\u001b[101Gfinish.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mBackground\u001b[14Gcommand\u001b[22G\"./scripts/ci.sh\u001b[39G--werror\u001b[48G--asan\u001b[55G--log\u001b[61Gbuild/gate.log\"\u001b[77Gcompleted\u001b[87G(exit\u001b[93Gcode\u001b[98G0)\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gengine\u001b[14Gside\u001b[19Gis\u001b[22Gfinished\u001b[31Gand\u001b[35Gthe\u001b[39Ggate\u001b[44Gis\u001b[47Ggreen,\u001b[54Gbut\u001b[58Gnothing\u001b[66Gis\u001b[69Gcommitted.\u001b[80GManifest's\u001b[91Gpin\u001b[95Gbump\u001b[100Gneeds\u001b[106Gthe\u001b[110Gengine\r\u001b[1B \u001b[3Gcommit's ha\u001b[15Gh, and\u001b[22Gyou asked me\u001b[36Go commit only when you say so.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m:\u001b[37G\u001b[38;2;177;185;249mimgui\u001b[43G\u001b[39mnow\u001b[47Gholds\u001b[53Gonly\u001b[58GImGui's\u001b[66Gcore\u001b[71Gand\u001b[75Gits\u001b[79GFreeType\u001b[88Gfont\u001b[93Gcode,\u001b[99Gand\u001b[103Glinks\u001b[109Gonly\r\u001b[2C\u001b[1B \u001b[5GFreeType. A new \u001b[38;2;177;185;249mimgui_backends\u001b[39m target\u001b[43Gh\u001b[45Glds the\u001b[53GGLFW\u001b[58Gand Vulkan backends and links\u001b[88G\u001b[38;2;177;185;249mimgui\u001b[39m, \u001b[38;2;177;185;249mglfw\u001b[39m and \u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/engine/render/CM\u001b[29GkeLists.txt\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[49G\u001b[39mlinks \u001b[38;2;177;185;249mimgui_backends\u001b[39m \u001b[71Glongside \u001b[38;2;177;185;249mimgui\u001b[39m. It is the only code that calls the\r\u001b[2C\u001b[1B \u001b[5Gbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m); nothing else in the\u001b[55Gtree uses them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m,\u001b[75Gand\u001b[79Ga\u001b[81Gnew\u001b[85G\u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest:\u001b[106Ga\u001b[108Gsmall\u001b[114Gprogram\r\u001b[2C\u001b[1B \u001b[5Gthat links \u001b[38;2;177;185;249mDevto\u001b[22Gls\u001b[39m alone and draws a console in one ImGui frame with\u001b[75Gno rend\u001b[83Grer. Running, it\u001b[100Gchecks that no\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibg\u001b[23Gfw\u001b[39m is lo\u001b[32Gded. The\u001b[41Gtest also\u001b[51Gfails if \u001b[38;2;177;185;249mreadelf\u001b[39m shows either in NEEDED, or shows no NEEDED e\u001b[113Gtries\u001b[119Gat\r\u001b[4C\u001b[1Ball.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m:\u001b[22Gthe\u001b[26Gfinished\u001b[35Grow\u001b[39Gmoves\u001b[45Gou\u001b[76Gnished\u001b[83Grows\u001b[88Gdid,\u001b[93Gand\u001b[97Gthe\u001b[101Gintro\u001b[107Gparagraph\u001b[117Gsays\u001b[27;1H\u001b[24;3H\u001b[?25h"]
