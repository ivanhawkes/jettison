[0.083, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat changed\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m: \u001b[38;2;177;185;249mimgui\u001b[39m now holds only ImGui's core and its FreeType font code, and links only\u001b[K\r\u001b[4C\u001b[1BFreeType. A new \u001b[38;2;177;185;249mimgui_backends\u001b[39m target holds the GLFW and Vulkan backends and links \u001b[38;2;177;185;249mimgui\u001b[39m, \u001b[38;2;177;185;249mglfw\u001b[39m and \u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/engine/render/CMakeLists.txt\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[39m links \u001b[38;2;177;185;249mimgui_backends\u001b[39m alongside \u001b[38;2;177;185;249mimgui\u001b[39m. It is the only code that calls\u001b[118Gthe\r\u001b[4C\u001b[1Bbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m); nothing else in the tree uses them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m, and a new \u001b[38;2;177;185;249mdevtools_alone\u001b[39m test: a small program\r\u001b[4C\u001b[1Bthat links\u001b[16G\u001b[38;2;177;185;249mDevtools\u001b[25G\u001b[39malone\u001b[31Gand\u001b[35Gdraws\u001b[41Ga\u001b[43Gconsole\u001b[51Gin\u001b[54Gone\u001b[58GImGui\u001b[64Gframe\u001b[70Gwith\u001b[75Gno\u001b[78Grenderer.\u001b[88GRunning,\u001b[97Git\u001b[100Gchecks\u001b[107Gthat\u001b[112Gno\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibglfw\u001b[39m is lo\u001b[32Gded. The test also fai\u001b[55Gs if \u001b[38;2;177;185;249mreadelf\u001b[39m shows either in NEEDED, or show\u001b[101Gno NEEDED\u001b[111Gentries\u001b[119Gat\r\u001b[4C\u001b[1Ball.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m:\u001b[22Gthe\u001b[26Gfinished\u001b[35Grow\u001b[39Gmoves\u001b[45Gout\u001b[49Gof\u001b[52Gthe\u001b[56Gtable,\u001b[63Gas\u001b[66Gearlier\u001b[74Gfinished\u001b[83Grows\u001b[88Gdid,\u001b[93Gand\u001b[97Gthe\u001b[101Gintro\u001b[107Gparagraph\u001b[117Gsays\r\u001b[2C\u001b[1B  the gap is provisioned. \u001b[38;2;177;185;249mdocs/history.md\u001b[45G\u001b[39mgets\u001b[50Gthe\u001b[54Gdelivery's\u001b[65Gtable\u001b[71Grow.\r\u001b[2B \u001b[3G\u001b[1mEvidence\u001b[12G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEngine:\u001b[13G\u001b[22mbefore\u001b[20Gthe\u001b[24Gchange,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mdevtools\u001b[45G\u001b[39msuite's\u001b[53Gbinary\u001b[60Gneeded\u001b[67G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[83GNow\u001b[87G\u001b[38;2;177;185;249mdevtools_alone\u001b[102G\u001b[39mneeds\u001b[108Gonly\r\u001b[1B \u001b[3G  \u001b[38;2;177;185;249mlibstdc++\u001b[39m, \u001b[38;2;177;185;249mlibm\u001b[39m,\u001b[22G\u001b[38;2;177;185;249mlibgcc_s\u001b[39m and \u001b[38;2;177;185;249mlibc\u001b[39m, and it\u001b[48Gpas\u001b[52Ges. \u001b[38;2;177;185;249mrender_test\u001b[39m s\u001b[70Gil\u001b[73G needs \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m, as it\u001b[102Gshould.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22mI\u001b[17Gbuilt\u001b[23G\u001b[38;2;177;185;249mmanifest_tui\u001b[36G\u001b[39magainst\u001b[44Gthis\u001b[49Gworking\u001b[57Gtree\u001b[62Gin\u001b[65G\u001b[38;2;177;185;249mbuild/sdk-local\u001b[39m.\u001b[82GIts\u001b[86GNEEDED\u001b[93Ghas\u001b[97Gno\u001b[100G\u001b[38;2;177;185;249mlibvulkan\u001b[110G\u001b[39mor\u001b[113G\u001b[38;2;177;185;249mlibglfw\u001b[39m;\r\u001b[1B \u001b[3G  the build on the\u001b[22Gcurrent\u001b[30Gpin\u001b[34G\u001b[38;2;177;185;249mea66afe\u001b[42G\u001b[39mhas\u001b[46G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[62GRun\u001b[66Gon\u001b[69Ga\u001b[71Gterminal\u001b[80Gfor\u001b[84Gabout\u001b[90Gten\u001b[94Gminutes,\u001b[103Git\u001b[106Ghad\u001b[110Gneither\r\u001b[1B    loaded.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate:\u001b[22m \u001b[38;2;177;185;249m./scripts/ci.sh --werror --asan --log build/gate.log\u001b[39m passed every stage in 199 s, run with 58 GiB free.\r\u001b[2B \u001b[3G\u001b[1mWaiting for your go-ahead:\u001b[22m the engine commit (suggested\u001b[59Gsubject:\u001b[68G\u001b[38;2;177;185;249mExternal: ImGui's GLFW and Vulkan backends out of \u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.235, "o", "\u001b[?25l\u001b[H\r\u001b[47C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m1\u001b[54G8\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.017, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[38;2;177;185;249msource/engine/render/CMakeLists.txt\u001b[39m:\u001b[42G\u001b[38;2;177;185;249mrender\u001b[49G\u001b[39mlinks\u001b[55G\u001b[38;2;177;185;249mimgui_backends\u001b[70G\u001b[39malongside\u001b[80G\u001b[38;2;177;185;249mimgui\u001b[39m.\u001b[87GIt\u001b[90Gis\u001b[93Gthe\u001b[97Gonly\u001b[102Gcode\u001b[107Gthat\u001b[112Gcalls\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m); nothing\u001b[43Gelse in the tree uses them.\u001b[71G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m, and a new \u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest: a small program\r\u001b[2C\u001b[1B \u001b[5Gthat links \u001b[38;2;177;185;249mD\u001b[18Gvtools\u001b[39m alone and draws a console in one ImGui frame\u001b[70Gwith no renderer. Running,\u001b[97Git checks\u001b[112Gno\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249ml\u001b[20Gbglfw\u001b[39m is loaded. T\u001b[39Ge test also\u001b[51Gfails if\u001b[60G\u001b[38;2;177;185;249mreadelf\u001b[39m shows\u001b[74Geither\u001b[81Gin\u001b[84GNEEDED,\u001b[92Gor\u001b[95Gshows\u001b[101Gno\u001b[104GNEEDED\u001b[111Gentries\u001b[119Gat\r\u001b[2C\u001b[1B \u001b[5Gall.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m: the fi\u001b[29Gishe\u001b[35Grow moves out of the table, as earlier finishe\u001b[82G \u001b[84Gows\u001b[88Gdid, and\u001b[97Gthe intro\u001b[107Gparagraph\u001b[117Gsays\r\u001b[4C\u001b[1Bthe gap is provisioned.\u001b[29G\u001b[38;2;177;185;249mdocs/history.md\u001b[39m get\u001b[49G the del\u001b[58Gvery's table row.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEngine:\u001b[13G\u00