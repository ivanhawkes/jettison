[0.049, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G \u001b[2m 141 \u001b[22m [\u001b[38;2;230;219;116mThe runtime distribution contract\u001b[39m](stage-5-recovery-pl\u001b[68Gn.md#the-runtime-distribution-co\u001b[101Gtrac\u001b[106G-r06-202\u001b[K\r\u001b[4C\u001b[1B \u001b[2m     \u001b[22m 6-11-24),\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've committed the\u001b[22Gengine\u001b[29Gchange\u001b[36Gas\u001b[39G\u001b[38;2;177;185;249md9f565c\u001b[47G\u001b[39mon\u001b[50G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[64Gnot\u001b[68Gpushed.\u001b[76GManifest's\u001b[87Gpin\u001b[91Gbump\u001b[96Gand\u001b[100Gdoc\u001b[104Gupdates\u001b[112Gare\r\u001b[2C\u001b[1Bwritten but not committed, because checking them o\u001b[54G the pin\u001b[63Gneeds \u001b[38;2;177;185;249md9f565c\u001b[39m on\u001b[80GGitHub.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest edits, uncommitted:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m: \u001b[38;2;177;185;249mMANIFEST_JETTISON_REVISION\u001b[39m chan\u001b[69Ges fro\u001b[76G \u001b[38;2;177;185;249mea66afe\u001b[39m to \u001b[38;2;177;185;249md9f565c\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mdocs/delivery-order.md\u001b[39m: the\u001b[33GR06\u001b[37Grow an\u001b[45Gthe st\u001b[52Gtus paragraph \u001b[67Gay the gap is pr\u001b[84Gvisioned and pinned\u001b[104Gat \u001b[38;2;177;185;249md9f565c\u001b[39m,\u001b[116Gand\r\u001b[2C\u001b[1B  \u001b[6Ghat R07 is next.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/session-handoff.md\u001b[39m:\u001b[30Gthe\u001b[34G\"Next,\u001b[41Gon\u001b[44Gresuming\"\u001b[54Gheading\u001b[62Gand\u001b[66Gthe\u001b[70GR06\u001b[74Gparagraph\u001b[84Gnow\u001b[88Gsay\u001b[92Gthe\u001b[96GImGui\u001b[102Gsplit\u001b[108Gis\u001b[111Gpinned\u001b[118Gand\r\u001b[2C\u001b[1B  R07 comes next.\u001b[21G\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mdocs/history.md\u001b[39m: a new section, \"Th\u001b[41G engine's ImGui split,\u001b[64Gpin\u001b[68Gd9f565c\u001b[76G—\u001b[78G2026-11-24\",\u001b[91Gwith\u001b[96Gthe\u001b[100Gbefore\u001b[107Gand\u001b[111Gafter\r\u001b[4C\u001b[1BNEEDED\u001b[12Glists.\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249mdocs/stage-5-recovery-plan.md\u001b[39m:\u001b[36Gthe\u001b[40GR06\u001b[44Ggap\u001b[48Gnote\u001b[53Gnow\u001b[57Gnames\u001b[63G\u001b[38;2;177;185;249md9f565c\u001b[39m,\u001b[72Gand\u001b[76Gits\u001b[80G\"What\u001b[86Git\u001b[89Gleaves\u001b[96Geach\u001b[101Gtask\"\u001b[107Gentry\u001b[113Gis\r\u001b[4C\u001b[1Bmarked\u001b[12Gdone.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gonly\u001b[12Gcheck\u001b[18Gon\u001b[21Gthis\u001b[26Gso\u001b[29Gfar\u001b[33Gis\u001b[36Gthe\u001b[40Gearlier\u001b[48G\u001b[38;2;177;185;249mmanifest_tui\u001b[61G\u001b[39mbuild\u001b[67Gagainst\u001b[75Gmy\u001b[78Glocal\u001b[84GJettison\u001b[93Gtree,\u001b[99Gwhich\u001b[105Gmatches\u001b[113G\u001b[38;2;177;185;249md9f565c\u001b[39m.\r\u001b[1B \u001b[3GManifest's gate hasn't run on the fetched pin. Earlier pin\u001b[62Gbumps\u001b[68Gwere\u001b[73Gcommitted\u001b[83Gonly\u001b[88Gafter\u001b[94Gthat\u001b[99Ggate\u001b[104Gpassed,\u001b[112Gand\u001b[116Git\u001b[27;1H\u001b[24;3H\u001b[?25h"]
