[0.090, "o", "\u001b[?25l\u001b[H\u001b[5GBuilding them against it\u001b[30Gmay\u001b[34Gneed\u001b[39Gfixes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't\u001b[9GClang\u001b[15G21,\u001b[19Gand\u001b[23Glibc++\u001b[30Ginstead\u001b[38Gof\u001b[41Glibstdc++.\u001b[52GThat's\u001b[59Gtoo\u001b[63Gdifferent\u001b[73Gfrom\u001b[78Gwhat\u001b[83Gthe\u001b[87Ggate\u001b[92Gtests.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto run\u001b[30Gthe bundle\u001b[41Gin Ubuntu 24.04 and trixie co\u001b[72Gainers, because \u001b[89G symbol check\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove\u001b[9Git\u001b[12Gstarts.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you choose option\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer\u001b[13Gruns\u001b[18Gin\u001b[21GR07.\u001b[26GNothing\u001b[34Ghas\u001b[38Gchanged\u001b[46Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI me\u001b[8Gsured the\u001b[18Gdynamically linked releas\u001b[44G build.\u001b[52GI\u001b[54Ghaven't\u001b[62Gchecked\u001b[70Gwhether\u001b[78Glinking\u001b[86Glibstdc++\u001b[96Gstatically\u001b[107Gpulls\u001b[113Gin\u001b[116Gglibc\r\u001b[2C\u001b[1Bsymbols\u001b[11Gnewer\u001b[17Gthan\u001b[22G2.39,\u001b[28Gor\u001b[31Gwhether\u001b[39GDocker\u001b[46Gor\u001b[49GPodman\u001b[56Gis\u001b[59Gavailable\u001b[69Ghere\u001b[74Gfor\u001b[78Gthe\u001b[82Gcontainer\u001b[92Gru