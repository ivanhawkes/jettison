rations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B      \u001b[12G       \u001b[20G   \u001b[24G      \u001b[27;1H\u001b[24;3H\u001b[?25h"]
