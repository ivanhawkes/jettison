t add options or \u001b[44Gb\u001b[46Gtract\u001b[52Gons.\u001b[39m                                          \r\u001b[2C\u001b[1B                                                                                               \r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mAccep\u001b[9Gance:\u001b[39m                                          \r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m- Engine: an executable that links Devtools alone has no libvulkan or libglfw among its NEEDED\r\u001b[2C\u001b[1B\u001b[39m  \u001b[38;2;177;185;249m(readelf -d) and starts with no Vulkan loader present. Add it as a test or fixture in an\r\u001b[2C\u001b[1B\u001b[39m  \u001b[38;2;177;185;249mi\u001b[7Gdep\u001b[11Gnde\u001b[15Gt engine consumer, \u001b[35Got\u001b[38GManifest.\u001b[39m                                                  \r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m- Manif\u001b[11Gst: the staged manifest_tui passes th\u001b[49G sam\u001b[54G check. After the\u001b[72Gengine commit, re-pi\r\u001b[21C\u001b[5B\u001b[38;2;153;153;153m\u001b[2m-----] 7% | 5h: 22% | ↑74.2k ↓937\u001b[22m\u001b[39m                                                                  \r\u001b[1B  \u001b[38;2;255;193;7m⏵⏵ auto mode on\u001b[38;2;153;153;153m (shi\u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
