[0.026, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've moved the floor to\u001b[27Gglibc\u001b[33G2.39\u001b[38Gin\u001b[41Gthe\u001b[45Gdocs\u001b[50Gof\u001b[53Gboth\u001b[58Grepos.\u001b[65GNothing\u001b[73Gis\u001b[76Gcommitted\u001b[86Gyet.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe R06 section\u001b[21G\u001b[22m(\u001b[38;2;177;185;249m../manifest/docs/stage-5-recovery-plan.md\u001b[39m, \"What a host\u001b[78Gmust have\") now names Ubuntu 24.04 and\r\u001b[4C\u001b[1BDebian\u001b[12G13\u001b[15Gas\u001b[18Gthe\u001b[22Goldest\u001b[29Gsupported\u001b[39Greleases.\u001b[49GIt\u001b[52Glists\u001b[58Gthe\u001b[62Gthree\u001b[68Gnewer\u001b[74Gsymbols\u001b[82G(\u001b[38;2;177;185;249mremainder\u001b[39m,\u001b[94G\u001b[38;2;177;185;249msqrtf\u001b[39m,\u001b[101G\u001b[38;2;177;185;249m__inet_pton_chk\u001b[39m)\u001b[118Gand\r\u001b[4C\u001b[1Bsays R07 binds them to older versions. R07's check fails on any symbol above 2.39, so a nixpkgs update that brings\r\u001b[4C\u001b[1Bin another one gets caught. It also records your fallback: if the pins become a hassle, build the release in an\r\u001b[4C\u001b[1BUbuntu\u001b[12G24.04 container or with \u001b[38;2;177;185;249mzig cc\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mR07's task list\u001b[22m now\u001b[25Gincludes\u001b[34Gbinding\u001b[42Gthose\u001b[48Gsymbols,\u001b[57Gplus\u001b[62Ganything\u001b[71Gthat\u001b[76Glinking\u001b[84Glibstdc++\u001b[94Gstatically\u001b[105Gpulls\u001b[111Gin.\u001b[115GIt\r\u001b[4C\u001b[1Balso adds the same bundle run in Ubuntu\u001b[45G24.04 and D\u001b[57Gbian\u001b[62G13\u001b[65Gcontainers.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mD-114, the delivery order, Manifest's history and the handoff, and Jettison's roadmap and history\u001b[22m all n\u001b[109Gw \u001b[112Gay\u001b[115G2.39.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GMarkdown\u001b[16Glink\u001b[21Gcheck\u001b[27Gpasses,\u001b[35Gand\u001b[39Gthe\u001b[43Gonly\u001b[48Gremaining\u001b[58Gmentions\u001b[67Gof\u001b[70G2.43\u001b[75Gare\u001b[79Gthe\u001b[83Gmeasured\u001b[92Gsymbol\u001b[99Gversions.\u001b[109GShould\u001b[116GI\r\u001b[1B \u001b[3Gcommit and push\u001b[19Gbo\u001b[22Gh \u001b[25Gepos?\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhether Docker or Podman is available here for the\u001b[54Gcontainer\u001b[64Gruns\u001b[69Gis\u001b[72Gstill\u001b[78Gunchecked,\u001b[89Gand\u001b[93GR07\u001b[97Gwill\u001b[102Gneed\u001b[107Gone\u001b[111Gof\u001b[114Gthem.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
