[3.536, "o", "\u001b[?25l\u001b[H\u001b[3Gcommit's\u001b[12Ghash,\u001b[18Gand\u001b[22Gyou\u001b[26Gasked\u001b[32Gme\u001b[35Gto\u001b[38Gcommit\u001b[45Gonly\u001b[50Gwhen\u001b[55Gyou\u001b[59Gsay\u001b[63Gso.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m:\u001b[37G\u001b[38;2;177;185;249mimgui\u001b[43G\u001b[39mnow\u001b[47Gholds\u001b[53Gonly\u001b[58GImGui's\u001b[66Gcore\u001b[71Gand\u001b[75Gits\u001b[79GFreeType\u001b[88Gfont\u001b[93Gcode,\u001b[99Gand\u001b[103Glinks\u001b[109Gonly\r\u001b[2C\u001b[1B  FreeType.\u001b[15GA\u001b[17Gnew\u001b[21G\u001b[38;2;177;185;249mimgui_backends\u001b[36G\u001b[39mtarget\u001b[43Gholds\u001b[49Gthe\u001b[53GGLFW\u001b[58Gand\u001b[62GVulkan\u001b[69Gbackends\u001b[78Gand\u001b[82Glinks\u001b[88G\u001b[38;2;177;185;249mimgui\u001b[39m,\u001b[95G\u001b[38;2;177;185;249mglfw\u001b[100G\u001b[39mand\u001b[104G\u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource/engine/render/CMakeLists.tx\u001b[40G\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[39m links \u001b[38;2;177;185;249mimgui_backends\u001b[39m alongside \u001b[38;2;177;185;249mimgui\u001b[39m.\u001b[87GIt is the only\u001b[102Gcode that calls\u001b[118Gthe\r\u001b[4C\u001b[1Bbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m);\u001b[35Gnothing else\u001b[48Gin the tree uses them.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m, and a new \u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest: a small program\r\u001b[6C\u001b[1Bat l\u001b[12Gnks \u001b[38;2;177;185;249mDevtools\u001b[39m alone a\u001b[33Gd draws a console in one ImGui frame with no renderer. Running, i\u001b[99G checks that no\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[15G\u001b[39mor\u001b[18G\u001b[38;2;177;185;249mlibglfw\u001b[26G\u001b[39mis\u001b[29Gloaded.\u001b[37GThe\u001b[41Gtest\u001b[46Galso\u001b[51Gfails\u001b[57Gif\u001b[60G\u001b[38;2;177;185;249mreadelf\u001b[68G\u001b[39mshows\u001b[74Geither\u001b[81Gin\u001b[84GNEEDED,\u001b[92Gor\u001b[95Gshows\u001b[101Gno\u001b[104GNEEDED\u001b[111Gentries\u001b[119Gat\r\u001b[2C\u001b[1B \u001b[5Gall.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m:\u001b[22Gthe\u001b[26Gfinished\u001b[35Grow\u001b[39Gmoves\u001b[45Gout\u001b[49Gof\u001b[52Gthe\u001b[56Gtable,\u001b[63Gas\u001b[66Gearlier\u001b[74Gfinished\u001b[83Grows\u001b[88Gdid,\u001b[93Gand\u001b[97Gthe\u001b[101Gintro\u001b[107Gparagraph\u001b[117Gsays\r\u001b[2C\u001b[1B  the gap is provisioned. \u001b[38;2;177;185;249mdocs/history.md\u001b[39m gets the delivery's \u001b[66Gable row.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEngine:\u001b[13G\u001b[22mbefore\u001b[20Gthe\u001b[24Gchange,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mdevtools\u001b[45G\u001b[39msuite's\u001b[53Gbinary\u001b[60Gneeded\u001b[67G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[83GNow\u001b[87G\u001b[38;2;177;185;249mdevtools_alone\u001b[102G\u001b[39mneeds\u001b[108Gonly\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mlibstdc++\u001b[39m, \u001b[38;2;177;185;249mlibm\u001b[39m, \u001b[38;2;177;185;249mlibgcc_s\u001b[39m and\u001b[35G\u001b[38;2;177;185;249mlibc\u001b[39m, and it passes. \u001b[38;2;177;185;249mrender_test\u001b[39m s\u001b[70Gill needs \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m, as it should.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mManifest:\u001b[22m I built \u001b[38;2;177;185;249mmanifest_tui\u001b[39m against this working tree in \u001b[38;2;177;185;249mbuild/sdk-local\u001b[39m. Its\u001b[86GNEEDED has no \u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibglfw\u001b[39m;\r\u001b[2C\u001b[1B  the build on the\u001b[22Gcurrent\u001b[30Gpin\u001b[34G\u001b[38;2;177;185;249mea66afe\u001b[42G\u001b[39mhas\u001b[46G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[62GRun\u001b[66Gon\u001b[69Ga\u001b[71Gterminal\u001b[80Gfor\u001b[84Gabout\u001b[90Gten\u001b[94Gminutes,\u001b[103Git\u001b[106Ghad\u001b[110Gneither\r\u001b[4C\u001b[1Bloaded.\r\u001b[1B \u001b[3G- \u001b[1mGate:\u001b[22m \u001b[38;2;177;185;249m./scripts/ci.sh --werror --asan --log build/gate.log\u001b[64G\u001b[39mpassed\u001b[71Gevery\u001b[77Gstage\u001b[83Gin\u001b[86G199\u001b[90Gs,\u001b[93Grun\u001b[97Gwith\u001b[102G58\u001b[105GGiB\u001b[109Gfree.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
