[0.007, "o", "\u001b[H\r\u001b[4B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m←\u001b[4G☒\u001b[6GRuntime\u001b[15G☒\u001b[17GTUI\u001b[21G\u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ✔ Submit \u001b[49m\u001b[38;2;153;153;153m →\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u001b[1mReview\u001b[8Gyour answers\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[4G\u001b[22m●\u001b[6GWhich\u001b[12Gruntime\u001b[20Gdistribution\u001b[33Gshould\u001b[40GR06\u001b[44Gcommit\u001b[51GManifest\u001b[60Gto?\u001b[64GToday\u001b[70Gthe\u001b[74Grelease\u001b[82Gbinaries\u001b[91Gtake\u001b[96Gtheir\u001b[102Ginterpreter\u001b[114Gand\r\u001b[1B \u001b[2m│\u001b[22m  \u001b[6GRUNPATH from the devenv\u001b[30Gshell's\u001b[38GNix\u001b[42Gstore\u001b[48Gpaths,\u001b[55Gand\u001b[59Gthey\u001b[64Gneed\u001b[69Gglibc\u001b[75Gsymbols\u001b[83Gup\u001b[86Gto\u001b[89G2.43,\u001b[95Gbecause\u001b[103Gnixpkgs'\u001b[112Gglibc\u001b[118Gis\r\u001b[1C\u001b[1B\u001b[2m│\u001b[6G\u001b[22m2.44.\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Standalone bundle (Recommended)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[4G\u001b[22m●\u001b[6GShould the TUI client be part of the distribution?\u001b[57GRight\u001b[63Gnow\u001b[67Git\u001b[70Greads\u001b[76Gits\u001b[80Gcontent\u001b[88Gfrom\u001b[93Ga\u001b[95Gsource-tree\u001b[107Gpath\u001b[112Gcompiled\r\u001b[1C\u001b[1B\u001b[2m│\u001b[22m  \u001b[6Ginto it, writes its\u001b[26Glog\u001b[30Gto\u001b[33G./build/,\u001b[43Gand\u001b[47Glinks\u001b[53Glibvulkan.so.1\u001b[68Gthrough\u001b[76Gthe\u001b[80Gengine's\u001b[89Gimgui\u001b[95Gtarget\u001b[102Geven\u001b[107Gthough\u001b[114Git\r\u001b[1C\u001b[1B\u001b[2m│\u001b[6G\u001b[22mnever draws anything.\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Ship it (Recommended)\r\u001b[2C\