[3.032, "o", "\u001b[?25l\u001b[H\u001b[3G  answer. A restart now loads that snapshot and r\u001b[53Gplays\u001b[59Gnothi\u001b[65Gg.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mBackups:\u001b[14G\u001b[22mwith \u001b[38;2;177;185;249m--serve --backups <dir>\u001b[39m,\u001b[44Ga backup\u001b[53Gis writte\u001b[63G every time a sn\u001b[80Gpshot is\u001b[89G(hourly, and at each stop).\u001b[117GThe\r\u001b[2C\u001b[1B  \u001b[6Gi\u001b[8Gectory must be outsid\u001b[30G \u001b[32Ghe world's, and\u001b[48Gth\u001b[51G new\u001b[56Gst 24\u001b[62Gbackups\u001b[70Gare k\u001b[76Gpt. A backup\u001b[89Gi\u001b[91Gterrupted before its\u001b[112Glast\u001b[117Gfile\r\u001b[2C\u001b[1B  counts as no backup and is cleared next time.\u001b[51GA failed backup\u001b[67Gis logged and the serv\u001b[90Gr keeps running.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[58G\u001b[39monly\u001b[63Grestores\u001b[72Ginto\u001b[77Gan\u001b[80Gempty\u001b[86Gdirectory.\u001b[97GIt\u001b[100Grefuses\u001b[108Ga\u001b[110Gbackup\u001b[117Gmade\r\u001b[4C\u001b[1Bby\u001b[8Ganother\u001b[16Gbuild\u001b[22Gbefore\u001b[29Gwriting\u001b[37Ganything.\u001b[47GIt\u001b[50Gchecks\u001b[57Gevery\u001b[63Gfile\u001b[68Gand\u001b[72Gthen\u001b[77Grecovers\u001b[86Gthe\u001b[90Gworld\u001b[96Gthe\u001b[100Gway\u001b[104Ga\u001b[106Gserver\u001b[113Gstart\r\u001b[2C\u001b[1B  does. If any of that fails it removes what\u001b[48Git wrote.\u001b[58GThe backup\u001b[69Gitself i\u001b[80Gnly read.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage limit:\u001b[20G\u001b[22ma\u001b[22Gsnapshot\u001b[31Gbigger\u001b[38Gthan\u001b[43Ga\u001b[45Gstart\u001b[51Gcan\u001b[55Gread\u001b[60G(4\u001b[63GGiB)\u001b[68Gis\u001b[71Gnow\u001b[75Grefused\u001b[83Gwhen\u001b[88Gwritten,\u001b[97Gnot\u001b[101Gdiscovered\u001b[112Gat\u001b[115Gthe\r\u001b[2C\u001b[1B  next start. The server ex\u001b[31Gts with an error and the world keeps its l\u001b[74Gst good snapshot.\u001b[92G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe\u001b[14Ghost\u001b[19Gsuite\u001b[25Gcovers\u001b[32Gthe\u001b[36Gstop,\u001b[42Gbackup\u001b[49Gretention\u001b[59Gand\u001b[63Gan\u001b[66Ginterrupted\u001b[78Gbackup,\u001b[86Grestore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\r\u001b[2C\u001b[1Blimit, and a backup\u001b[23Gdirectory insi\u001b[38Ge the world. A new trading-fixture case backs\u001b[84Gup a\u001b[89Gworld mid-fligh\u001b[105G with\u001b[111Ga buy\u001b[K\r\u001b[2C\u001b[1Border ho\u001b[12Gding\u001b[17Gescrow. It restores it, checks every requ\u001b[59Gst outc\u001b[67Gme matches, and flies on to the\u001b[99Gloop's\u001b[106Gusual\u001b[112Gend\r\u001b[2C\u001b[1Bstate.\u001b[10G\u001b[38;2;177;185;249mcli_serve\u001b[20G\u001b[39mnow\u001b[24Grestores\u001b[33Gthe\u001b[37Gstop's\u001b[44Gbackup\u001b[51Gat\u001b[54Gthe\u001b[58Gstep\u001b[63Gthe\u001b[67Gserver\u001b[74Gstopped,\u001b[83Gand\u001b[87Gchecks\u001b[94Gthat\u001b[99Grestoring\u001b[109Gover\u001b[114Ga\u001b[116Glive\r\u001b[2C\u001b[1Bworld\u001b[9Gis refused.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured in Debug:\u001b[22G\u001b[22ma\u001b[24Gbackup\u001b[31Gis\u001b[34G730\u001b[38GKB\u001b[41Gtoday.\u001b[48GA\u001b[50Grestore\u001b[58Gtakes\u001b[64G0.25\u001b[69Gs,\u001b[72G0.11\u001b[77Gs\u001b[79Gof\u001b[82Gwhich\u001b[88Gis\u001b[91Gstart-up.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a backup can lose:\u001b[27G\u001b[22mit is only as f\u001b[43Gesh \u001b[48Gs its snapshot, so up to an\u001b[76Ghour behind the live world. That's\u001b[111Grecorded\r\u001b[2C\u001b[1Bin\u001b[6Gthe\u001b[10GStage\u001b[16G5\u001b[18Gplan.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
