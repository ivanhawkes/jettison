[0.030, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mAfter \u001b[12Ghe first draft:\u001b[28G\u001b[22mabout 34 lat\u001b[41Gr\u001b[43Gworkst\u001b[50Geams (L01 to L34, minus the thre\u001b[83G already done, plus the L17 stretch\r\u001b[4C\u001b[1Bgoal). They cover deployment hardening,\u001b[45Gbribery,\u001b[54Gport\u001b[59Gconstruction,\u001b[73Gstargates,\u001b[84Gthe\u001b[88Ggraphical\u001b[98Gclient\u001b[105G(L15),\u001b[112Gmarket\r\u001b[2C\u001b[1B \u001b[5Gservices, debt, the power gr\u001b[34Gd\u001b[36Gand more. Mos\u001b[50G still need d\u001b[64Gsign decisions before anyone builds\u001b[100Gthem,\u001b[106Gso\u001b[109Gthey're\u001b[117Ga\r\u001b[2C\u001b[1B \u001b[5Gbacklog rather than a schedule.\u001b[37G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gr\u001b[7Gad only\u001b[15Gthe delivery o\u001b[30Gde\u001b[33G's\u001b[36Gtask table and\u001b[51Gi\u001b[53Gs \"lat\u001b[60Gr\u001b[62Gprioriti\u001b[71Gs\" header, not\u001b[86Geach task's plan. The engine work\r\u001b[2C\u001b[1Bcolumn is\u001b[13Ga gu\u001b[18Gss.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 24s · done 2:12 pm\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mGreat, start on R05\u001b[39m                                                                                                   \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m10\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mThe backlog can wait until after we play with the first loop for a day or two.\u001b[39m                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mReading\u001b[11GManifest's\u001b[22Gjournal\u001b[30Gand\u001b[34Gserver\u001b[41Gcode\u001b[46Gto\u001b[49Gbuild\u001b[55GR05\u001b[59Gon,\u001b[63Gthen\u001b[68GI'll\u001b[73Gwrite\u001b[79Git.\u001b[83GNoted\u001b[89Gthat\u001b[94Gthe\u001b[98GL-backlog\u001b[108Gwaits\u001b[114Guntil\r\u001b[1B  you've played the first loop for a day or two.\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✽\u001b[3GFiddle-f\u001b[38;2;235;159;127madd\u001b[38;2;215;119;87mling… \u001b[46G\u001b[38;2;153;153;153mthought for 45s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
