l\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 \u001b[77G\u001b[22mapt.llvm.org.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.039, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────────────────┼─────────┼──────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;2;177;185;249m__inet_pton_chk\u001b[39m │ 2.42    │ the server and the TUI; nixpkgs' clang wrapper turns on \u001b[38;2;177;185;249m_FORTIFY_SOURCE\u001b[39m, which swaps │\r\u001b[4C\u001b[1B               \u001b[23G    \u001b[33G \u001b[38;2;177;185;249minet_pton\u001b[44G\u001b[39mfor\u001b[48Gits\u001b[52Gchecked variant    \u001b[72G       \u001b[80G     \u001b[86G  \u001b[89G                \u001b[106G     \u001b[112G     \r\u001b[2C\u001b[1B└─────────────────┴─────────┴──────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything\u001b[14Gelse\u001b[19Gasks\u001b[24Gfor\u001b[28G2.38\u001b[33Gor\u001b[36Golder.\u001b[43GSo\u001b[46Gthe\u001b[50Gfloor\u001b[56Gof\u001b[59G2.43\u001b[64Gis\u001b[67Gan\u001b[70Gaccident\u001b[79Gof\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gnixpkgs'\u001b[108Gcurrent\r\u001b[2C\u001b[1Bglibc; nothing in the code needs\u001b[36Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[39m to their older symbol versions with\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.  \u001b[77G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.039, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│                 │         │  \u001b[38;2;177;185;249minet_pton\u001b[39m for its checked variant                                                   │\r\u001b[2C\u001b[1B└─────────────────┴─────────┴──────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything else asks for 2.38 or older. So the floor of 2.43 is an accident of building against nixpkgs' current\u001b[K\r\u001b[2C\u001b[1Bglibc;\u001b[10Gnothing\u001b[18Gin\u001b[21Gthe\u001b[25Gcode\u001b[30Gneeds\u001b[36Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mMath functions:\u001b[21G\u001b[22mbind\u001b[26G\u001b[38;2;177;185;249mremainder\u001b[36G\u001b[39mand\u001b[40G\u001b[38;2;177;185;249msqrtf\u001b[46G\u001b[39mto\u001b[49Gtheir\u001b[55Golder\u001b[61Gsymbol\u001b[68Gversions\u001b[77Gwith\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B  the same IEEE operations under an older name.\u001b[K\r\u001b[4C\u001b[1B\u001b[1minet_pton:\u001b[22m build the\u001b[26Gone file that\u001b[40Gcalls\u001b[46Git\u001b[49Gwith \u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m, \u001b[74Gr bind it the same\u001b[93Gway. You give up the bounds\r\u001b[4C\u001b[1Bc\u001b[8Gck on\u001b[14Gthat\u001b[20Gn\u001b[22G call.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTh\u001b[8G check\u001b[16G\u001b[22mR07's\u001b[22Gobjdump\u001b[30Gcheck f\u001b[38Gils on anyth\u001b[51Gng\u001b[54Gnewer than 2.39. That\u001b[76Gmakes 2.39 a chosen flo\u001b[100Gr\u001b[102Grather than\u001b[114Ga\u001b[K\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\u001b[19G\u001b[K\r\u001b[9C\u001b[1B\u001b[1most:\u001b[22m every nixpkgs bump may bring in another symbol. The check catches it and you add\u001b[96Gan\u001b[99Gthe\u001b[103G pin,\u001b[109Gw\u001b[111Gich is\u001b[118Ga\r\u001b[4C\u001b[1Blittle fragile\u001b[20Gbut\u001b[24Gcheap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRobust:\u001b[13G\u001b[22mthe\u001b[17Gfloor\u001b[23Gholds\u001b[29Gby\u001b[32Gconstruction.\r\u001b[2C\u001b[1B- \u001b[1mA second toolchain:\u001b[22m it lives outside devenv, release\u001b[58Gb\u001b[60Gnaries no longer\u001b[77Gcome from the\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to\u001b[13Grun\u001b[17Gthere\u001b[23Gt\u001b[25Go. \u001b[29G  \u001b[32G             \u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.483, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B└─────────────────┴─────────┴──────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything\u001b[14Gelse\u001b[19Gasks\u001b[24Gfor\u001b[28G2.38\u001b[33Gor\u001b[36Golder.\u001b[43GSo\u001b[46Gthe\u001b[50Gfloor\u001b[56Gof\u001b[59G2.43\u001b[64Gis\u001b[67Gan\u001b[70Gaccident\u001b[79Gof\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gnixpkgs'\u001b[108Gcurrent\r\u001b[2C\u001b[1Bglibc; nothing in the code needs\u001b[36Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[39m to their older symbol versions with\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G1\u001b[76G\u001b[38;2;177;185;249mormat\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
