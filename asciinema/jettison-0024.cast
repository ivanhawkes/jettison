[0.152, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mLinking:\u001b[22m \u001b[38;2;177;185;249mlibstdc++\u001b[39m and \u001b[38;2;177;185;249mlibgcc\u001b[35G\u001b[39ml\u001b[38Gked \u001b[43Gt\u001b[45Gtically, no \u001b[38;2;177;185;249mRUNPATH\u001b[39m, and the loader at \u001b[38;2;177;185;249m/lib64/ld-linux-x86-64.so.2\u001b[39m. Today\r\u001b[4C\u001b[1Ball of them point into the devenv's\u001b[41G\u001b[38;2;177;185;249m/nix/store\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mCo\u001b[8Gte\u001b[11Gt and data:\u001b[22m co\u001b[26Gtent is fou\u001b[38Gd nex\u001b[44G \u001b[46Go the executable through \u001b[38;2;177;185;249m/proc/self/exe\u001b[39m, so the bundle can't ship its own\r\u001b[4C\u001b[1Bloader. The\u001b[17Gw\u001b[19Grld, backups\u001b[32Gand tokens go under the\u001b[56GXDG\u001b[60Gdirectories\u001b[72Gfor\u001b[76G\u001b[38;2;177;185;249mmanifest\u001b[39m,\u001b[86Gand\u001b[90Gso\u001b[93Gdoes\u001b[98Gthe\u001b[102GTUI's\u001b[108Gtranscript.\r\u001b[2C\u001b[1B \u001b[5GThe server logs to std\u001b[28Grr, and nothing is writt\u001b[53Gn beside the binaries or in the working directory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefaults I chose, which you may want to change:\u001b[22m the paths, and backups\u001b[76Gswitched on by default. \u001b[38;2;177;185;249m--scenario\u001b[39m stays\u001b[K\r\u001b[4C\u001b[1Brequired.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine gap:\u001b[19G\u001b[22mJettison's\u001b[30G\u001b[38;2;177;185;249mimgui\u001b[36G\u001b[39mtarget\u001b[43Gbuilds\u001b[50GImGui's\u001b[58GGLFW\u001b[63Gand\u001b[67GVulkan\u001b[74Gbackends\u001b[83Ginto\u001b[88Gitself.\u001b[96GSo\u001b[99Ganything\u001b[108Gthat\u001b[113Glinks\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mDevtools\u001b[39m,\u001b[13Gincluding\u001b[23GManifest's\u001b[34Gterminal\u001b[43GTUI,\u001b[48Gneeds\u001b[54G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[69G\u001b[39meven\u001b[74Gthough\u001b[81Git\u001b