[0.189, "o", "\u001b]0;✳ jettison-0024\u0007"]
[0.005, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Ghave\u001b[10Gwhat\u001b[15GR06\u001b[19Gneeds.\u001b[26GThe\u001b[30Gone\u001b[34Greal\u001b[39Gchoice\u001b[46Gis\u001b[49Gwhich\u001b[55Gruntime\u001b[63Gcontract\u001b[72Gto\u001b[75Gsupport,\u001b[84Gso\u001b[87GI'm\u001b[91Gasking\u001b[98Gyou\u001b[102Gbefore\u001b[109GI\u001b[111Gwrite\u001b[117Git\r\u001b[1B \u001b[3Gup.\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Runtime \u001b[39m\u001b[49m ☐ TUI  ✔ Submit  →\u001b[K\r\u001b[2B\u001b[2m│\u001b[22m \u001b[38;2;255;255;255m\u001b[1mWhich runtime distribution should R06 commit Manifest to? Today the release binaries take their interpreter and \u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[2m│\u001b[22m \u001b[38;2;255;255;255m\u001b[1mRUNPATH from the devenv shell's Nix store paths, and they need glibc symbols up to 2.43, because nixpkgs' glibc is \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1m2.44.\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mStandalone bundle (Recommended)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mA tarball holding bin/, share/manifest/manifest.pack and licences. libstdc++ and libgcc are linked statically, \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mthere is no RUNPATH, and the interpreter is /lib64/ld-linux-x86-64.so.2. The host must be x86-64 Linux with glibc \r\u001b[5C\u001b[1B2.43 or newer. On NixOS it runs through nix-ld, which you already use. The glibc floor goes up whenever the \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mdev\u001b[10Gnv's nix\u001b[19Gkgs does.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[6G\u001b[39mNix\u001b[10Gruntime\u001b[18Gclosure\r\u001b[1B \u001b[3G \u001b[5G \u001b[38;2;153;153;153mBinaries patched to fixed store paths and shipped as a closure with nix copy. Needs Nix on every target and nothing\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153melse. It is exact, but no one without Nix can run it.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[39mBoth\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153mThe same staged\u001b[22Gbuild is t\u001b[33Gsted both ways in R07. That doubles the relocation tests.\r\u001b[2C\u001b[1B4. Type something.\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  5.\u001b[6GChat\u001b[11Gabout\u001b[17Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0024 ─\u001b[39m\u001b[27;1H\u001b[12;1H"]
[81.957, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.309, "o", "\u001b[H\r\u001b[16B\u001b[48;2;55;55;55m  \u001b[38;2;153;153;153m2.\u001b[39m Nix runtime closure                                                                                                \u001b[49m\u001b[27;1H\u001b[12;1H"]
