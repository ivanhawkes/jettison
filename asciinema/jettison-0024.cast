[0.248, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mClean stop:\u001b[22m on SIGINT or SIGTERM the\u001b[42Gserver\u001b[49Gstops\u001b[55Gtaking\u001b[62Grequests,\u001b[72Gruns\u001b[77Gthe\u001b[81Gones\u001b[86Git\u001b[89Galready\u001b[97Gaccepted\u001b[106Gin\u001b[109Gone\u001b[113Glast\r\u001b[2C\u001b[1B \u001b[5Gstep, answers them and writes a snapshot. Before,\u001b[55Ga request accepted jus\u001b[78G before\u001b[86Gthe stop got a receipt\u001b[109Ga\u001b[111Gd\u001b[113Gnever\u001b[119Gan\r\u001b[4C\u001b[1Banswer. A re\u001b[18Gtart now loads th\u001b[36Gt snapshot\u001b[47Gand \u001b[53Gpl\u001b[56Gys nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBackups:\u001b[22m with \u001b[38;2;177;185;249m--serve --backups <dir>\u001b[39m, a b\u001b[48Gckup is written every\u001b[70Gtime\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gis\u001b[89G(hourly,\u001b[98Gand\u001b[102Gat\u001b[105Geach\u001b[110Gstop).\u001b[117GThe\r\u001b[2C\u001b[1B \u001b[5Gdirectory must be outside the world's\u001b[45Gnd the newest 24 backups\u001b[70Gare kept. A backup\u001b[89Ginte\u001b[94Grupted before it\u001b[111G last\u001b[117Gfile\r\u001b[4C\u001b[1Bcounts as\u001b[15Gno backup and is cleared next time. A failed backup i\u001b[70Glogged and the server keeps running.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[39m only restores into\u001b[79G empty dir\u001b[90Gctory. It refuses\u001b[108Ga\u001b[110Gbackup\u001b[117Gmade\r\u001b[2C\u001b[1B \u001b[5Gby another build before writing anything. It checks ever\u001b[63Gfile and\u001b[72Gthen\u001b[77Grecovers\u001b[86Gthe world the\u001b[100Gway a \u001b[107Gerver start\u001b[K\r\u001b[4C\u001b[1Bdoes. If any of that fails it removes what it wrote. The backup itself is only read.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage limit:\u001b[22m a snapshot b\u001b[33Ggger than\u001b[43Ga s\u001b[47Gar\u001b[51Gcan read (4 GiB) is now refused wh\u001b[86Gn written,\u001b[97Gnot\u001b[101Gdiscovered\u001b[112Gat\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gnext start. The server exits with an error and the world keeps\u001b[69Gts last good snapshot.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe\u001b[14Ghost\u001b[19Gsuite\u001b[25Gcovers\u001b[32Gthe\u001b[36Gstop,\u001b[42Gbackup\u001b[49Gretention\u001b[59Gand\u001b[63Gan\u001b[66Ginterrupted\u001b[78Gbackup,\u001b[86Grestore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\r\u001b[2C\u001b[1Blimit,\u001b[10Gand\u001b[14Ga back\u001b[21Gp directory inside the world. A \u001b[54Gew tr\u001b[60Gding-f\u001b[67Gx\u001b[69Gu\u001b[71Ge case\u001b[82Gs up a w\u001b[92Gld mid-flight with a buy\u001b[K\r\u001b[2C\u001b[1Border hol\u001b[13Ging escrow. It restore\u001b[36G it, checks every request outcome mat\u001b[74Ghes, \u001b[80Gnd flies\u001b[89Gon to\u001b[95Gthe loop's\u001b[106Gusual end\u001b[K\r\u001b[2C\u001b[1Bstate. \u001b[38;2;177;185;249mcli_serve\u001b[39m n\u001b[23G restores the\u001b[37Gs\u001b[39Gop's backup at\u001b[54Gthe step the s\u001b[69Grver stopped,\u001b[83Gand checks that\u001b[99Grestoring over a\u001b[116Glive\r\u001b[2C\u001b[1Bworld is refused.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured in Debug:\u001b[22G\u001b[22ma\u001b[24Gbackup\u001b[31Gis\u001b[34G730\u001b[38GKB\u001b[41Gtoday.\u001b[48GA\u001b[50Grestore\u001b[58Gtakes\u001b[64G0.25\u001b[69Gs,\u001b[72G0.11\u001b[77Gs\u001b[79Gof\u001b[82Gwhich\u001b[88Gis\u001b[91Gstart-up.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a backup can lose:\u001b[27G\u001b[22mit\u001b[30Gis\u001b[33Gonly\u001b[38Gas\u001b[41Gfresh\u001b[47Gas\u001b[50Gits\u001b[54Gsnapshot,\u001b[64Gso\u001b[67Gup\u001b[70Gto\u001b[73Gan\u001b[76Ghour\u001b[81Gbehind\u001b[88Gthe\u001b[92Glive\u001b[97Gworld.\u001b[104GThat's\u001b[111Grecorded\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.103, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Ganswer. A restart now\u001b[27Gloads that\u001b[38Gsnap\u001b[43Ghot and replays \u001b[60Gothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBackups:\u001b[22m \u001b[15Gith\u001b[19G\u001b[38;2;177;185;249m--serve --backups <dir>\u001b[39m, a backup is w\u001b[58Gitt\u001b[62Gn every \u001b[71Gime a snapshot\u001b[86Gis (hourly, and at each stop). The\u001b[K\r\u001b[4C\u001b[1Bdirectory\u001b[15Gmu\u001b[19G be\u001b[23Goutside the world's, and the newest\u001b[59G24 backups\u001b[70Gare\u001b[74Gkept.\u001b[80GA\u001b[82Gbackup\u001b[89Ginterrupted\u001b[101Gbefore\u001b[108Gits\u001b[112Glast\u001b[117Gfile\r\u001b[2C\u001b[1B \u001b[5Gcounts as no backup and is cleared next time. A\u001b[53Gfailed backup is\u001b[70Glogged\u001b[77Ga\u001b[79Gd t\u001b[83Ge server keeps\u001b[98Grunning.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[39m only restores into an\u001b[80Gempty direc\u001b[92Go\u001b[94Gy. It refuses\u001b[108Ga backup\u001b[117Gmad\r\u001b[4C\u001b[1Bby another build before\u001b[29Gwriting anything. It checks \u001b[58Gvery file and th\u001b[75Gn\u001b[77Grecovers the world the way a server\u001b[113Gstart\r\u001b[2C\u001b[1B \u001b[5Gdoes. If\u001b[14Gany of that fails it removes what it wrote.\u001b[58GThe backup itself is only read.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage limit:\u001b[22m a\u001b[22Gsnapshot bigger than a start can read (4\u001b[63GG\u001b[65GB)\u001b[68Gis now refused when written, not discov\u001b[109Ged at the\r\u001b[4C\u001b[1Bnext start. The\u001b[21Gserver exits with an error\u001b[48Gand the world\u001b[62Gkeeps its last go\u001b[80Gd snapshot.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe host suite cov\u001b[29Grs the stop,\u001b[42Gbackup retention and an interrupted backup, res\u001b[90Gore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\r\u001b[2C\u001b[1Blimit,\u001b[10Gand\u001b[14Ga\u001b[16Gbackup\u001b[23Gdirectory\u001b[33Ginside\u001b[40Gthe\u001b[44Gworld.\u001b[51GA\u001b[53Gnew\u001b[57Gtrading-fixture\u001b[73Gcase\u001b[78Gbacks\u001b[84Gup\u001b[87Ga\u001b[89Gworld\u001b[95Gmid-flight\u001b[106Gwith\u001b[111Ga\u001b[113Gbuy\r\u001b[2C\u001b[1Border holding escrow.\u001b[25GIt re\u001b[31Gtor\u001b[35Gs it, che\u001b[46Gs ev\u001b[51Gry request outcome match\u001b[76Gs, \u001b[80Gnd flies on to the loop's usual\u001b[112Gend\u001b[116G\u001b[K\r\u001b[2C\u001b[1Bstate.\u001b[10G\u001b[38;2;177;185;249mcli_serve\u001b[39m now restores\u001b[33Gthe stop's\u001b[44Gbackup\u001b[51Gat the step the serv\u001b[72Gr stopped, and\u001b[87Gchecks that restoring over a live\r\u001b[2C\u001b[1Bworld\u001b[9Gis refus\u001b[18Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured in Debug:\u001b[22G\u001b[22ma\u001b[24Gbackup\u001b[31Gis\u001b[34G730\u001b[38GKB\u001b[41Gtoday.\u001b[48GA\u001b[50Grestore\u001b[58Gtakes\u001b[64G0.25\u001b[69Gs,\u001b[72G0.11\u001b[77Gs\u001b[79Gof\u001b[82Gwhich\u001b[88Gis\u001b[91Gstart-up.\r\u001b[2C\u001b[2B\u001b[1mWh\u001b[6Gt a backup can lose:\u001b[22m it is only\u001b[38Gas\u001b[41Gfresh as\u001b[50Git\u001b[53G snapshot,\u001b[64Gso up to an hour be\u001b[85Gnd\u001b[88Gthe live world.\u001b[104GThat's\u001b[111Grecorded\r\u001b[2C\u001b[1Bin\u001b[6Gthe\u001b[10GStage\u001b[16G5\u001b[18Gplan.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.249, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mBackups:\u001b[22m with \u001b[38;2;177;185;249m--serve --backups <dir>\u001b[39m, a b\u001b[48Gckup is written every\u001b[70Gtime\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gis\u001b[89G(hourly,\u001b[98Gand\u001b[102Gat\u001b[105Geach\u001b[110Gstop).\u001b[117GThe\r\u001b[2C\u001b[1B \u001b[5Gdirectory must be outside the world's\u001b[45Gnd the newest 24 backups\u001b[70Gare kept. A backup\u001b[89Ginte\u001b[94Grupted before it\u001b[111G last\u001b[117Gfile\r\u001b[4C\u001b[1Bcounts as\u001b[15Gno backup and is cleared next time. A failed backup i\u001b[70Glogged and the server keeps running.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[39m only restores into\u001b[79G empty dir\u001b[90Gctory. It refuses\u001b[108Ga\u001b[110Gbackup\u001b[117Gmade\r\u001b[2C\u001b[1B \u001b[5Gby another build before writing anything. It checks ever\u001b[63Gfile and\u001b[72Gthen\u001b[77Grecovers\u001b[86Gthe world the\u001b[100Gway a \u001b[107Gerver start\u001b[K\r\u001b[4C\u001b[1Bdoes. If any of that fails it removes what it wrote. The backup itself is only read.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage limit:\u001b[22m a snapshot b\u001b[33Ggger than\u001b[43Ga s\u001b[47Gar\u001b[51Gcan read (4 GiB) is now refused wh\u001b[86Gn written,\u001b[97Gnot\u001b[101Gdiscovered\u001b[112Gat\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gnext start. The server exits with an error and the world keeps\u001b[69Gts last good snapshot.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe\u001b[14Ghost\u001b[19Gsuite\u001b[25Gcovers\u001b[32Gthe\u001b[36Gstop,\u001b[42Gbackup\u001b[49Gretention\u001b[59Gand\u001b[63Gan\u001b[66Ginterrupted\u001b[78Gbackup,\u001b[86Grestore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\r\u001b[2C\u001b[1Blimit,\u001b[10Gand\u001b[14Ga back\u001b[21Gp directory inside the world. A \u001b[54Gew tr\u001b[60Gding-f\u001b[67Gx\u001b[69Gu\u001b[71Ge case\u001b[82Gs up a w\u001b[92Gld mid-flight with a buy\u001b[K\r\u001b[2C\u001b[1Border hol\u001b[13Ging escrow. It restore\u001b[36G it, checks every request outcome mat\u001b[74Ghes, \u001b[80Gnd flies\u001b[89Gon to\u001b[95Gthe loop's\u001b[106Gusual end\u001b[K\r\u001b[2C\u001b[1Bstate. \u001b[38;2;177;185;249mcli_serve\u001b[39m n\u001b[23G restores the\u001b[37Gs\u001b[39Gop's backup at\u001b[54Gthe step the s\u001b[69Grver stopped,\u001b[83Gand checks that\u001b[99Grestoring over a\u001b[116Glive\r\u001b[2C\u001b[1Bworld is refused.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured in Debug:\u001b[22G\u001b[22ma\u001b[24Gbackup\u001b[31Gis\u001b[34G730\u001b[38GKB\u001b[41Gtoday.\u001b[48GA\u001b[50Grestore\u001b[58Gtakes\u001b[64G0.25\u001b[69Gs,\u001b[72G0.11\u001b[77Gs\u001b[79Gof\u001b[82Gwhich\u001b[88Gis\u001b[91Gstart-up.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a backup can lose:\u001b[27G\u001b[22mit\u001b[30Gis\u001b[33Gonly\u001b[38Gas\u001b[41Gfresh\u001b[47Gas\u001b[50Gits\u001b[54Gsnapshot,\u001b[64Gso\u001b[67Gup\u001b[70Gto\u001b[73Gan\u001b[76Ghour\u001b[81Gbehind\u001b[88Gthe\u001b[92Glive\u001b[97Gworld.\u001b[104GThat's\u001b[111Grecorded\r\u001b[2C\u001b[1Bin the Stage 5 plan.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison (\u001b[38;2;177;185;249mb475aac\u001b[39m):\u001b[23G\u001b[22mthe\u001b[27Groadmap\u001b[35Gand\u001b[39Ghistory\u001b[47Grecord\u001b[54GR05\u001b[58Gas\u001b[61Gdone,\u001b[67GR06\u001b[71Gas\u001b[74Gnext,\u001b[80Gand\u001b[84Gthat\u001b[89Gthe\u001b[93Glater\u001b[99Gworkstreams\u001b[111Gwait\u001b[116Guntil\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.251, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gcounts as no backup and is cleared next time. A\u001b[53Gfailed backup is\u001b[70Glogged\u001b[77Ga\u001b[79Gd t\u001b[83Ge server keeps\u001b[98Grunning.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[39m only restores into an\u001b[80Gempty direc\u001b[92Go\u001b[94Gy. It refuses\u001b[108Ga backup\u001b[117Gmad\r\u001b[4C\u001b[1Bby another build before\u001b[29Gwriting anything. It checks \u001b[58Gvery file and th\u001b[75Gn\u001b[77Grecovers the world the way a server\u001b[113Gstart\r\u001b[2C\u001b[1B \u001b[5Gdoes. If\u001b[14Gany of that fails it removes what it wrote.\u001b[58GThe backup itself is only read.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage limit:\u001b[22m a\u001b[22Gsnapshot bigger than a start can read (4\u001b[63GG\u001b[65GB)\u001b[68Gis now refused when written, not discov\u001b[109Ged at the\r\u001b[4C\u001b[1Bnext start. The\u001b[21Gserver exits with an error\u001b[48Gand the world\u001b[62Gkeeps its last go\u001b[80Gd snapshot.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe host suite cov\u001b[29Grs the stop,\u001b[42Gbackup retention and an interrupted backup, res\u001b[90Gore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\r\u001b[2C\u001b[1Blimit,\u001b[10Gand\u001b[14Ga\u001b[16Gbackup\u001b[23Gdirectory\u001b[33Ginside\u001b[40Gthe\u001b[44Gworld.\u001b[51GA\u001b[53Gnew\u001b[57Gtrading-fixture\u001b[73Gcase\u001b[78Gbacks\u001b[84Gup\u001b[87Ga\u001b[89Gworld\u001b[95Gmid-flight\u001b[106Gwith\u001b[111Ga\u001b[113Gbuy\r\u001b[2C\u001b[1Border holding escrow.\u001b[25GIt re\u001b[31Gtor\u001b[35Gs it, che\u001b[46Gs ev\u001b[51Gry request outcome match\u001b[76Gs, \u001b[80Gnd flies on to the loop's usual\u001b[112Gend\u001b[116G\u001b[K\r\u001b[2C\u001b[1Bstate.\u001b[10G\u001b[38;2;177;185;249mcli_serve\u001b[39m now restores\u001b[33Gthe stop's\u001b[44Gbackup\u001b[51Gat the step the serv\u001b[72Gr stopped, and\u001b[87Gchecks that restoring over a live\r\u001b[2C\u001b[1Bworld\u001b[9Gis refus\u001b[18Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured in Debug:\u001b[22G\u001b[22ma\u001b[24Gbackup\u001b[31Gis\u001b[34G730\u001b[38GKB\u001b[41Gtoday.\u001b[48GA\u001b[50Grestore\u001b[58Gtakes\u001b[64G0.25\u001b[69Gs,\u001b[72G0.11\u001b[77Gs\u001b[79Gof\u001b[82Gwhich\u001b[88Gis\u001b[91Gstart-up.\r\u001b[2C\u001b[2B\u001b[1mWh\u001b[6Gt a backup can lose:\u001b[22m it is only\u001b[38Gas\u001b[41Gfresh as\u001b[50Git\u001b[53G snapshot,\u001b[64Gso up to an hour be\u001b[85Gnd\u001b[88Gthe live world.\u001b[104GThat's\u001b[111Grecorded\r\u001b[2C\u001b[1Bin\u001b[6Gthe\u001b[10GStage\u001b[16G5\u001b[18Gplan.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison (\u001b[38;2;177;185;249mb475aac\u001b[39m):\u001b[22m the\u001b[27Groadmap\u001b[35Gand\u001b[39Ghistory\u001b[47Grecord\u001b[54GR05\u001b[58Gas\u001b[61Gdone,\u001b[67GR06\u001b[71Gas\u001b[74Gnext,\u001b[80Gand\u001b[84Gthat\u001b[89Gthe\u001b[93Glater\u001b[99Gworkstreams\u001b[111Gwait\u001b[116Guntil\r\u001b[2C\u001b[1Byou've\u001b[10Gplayed\u001b[17Gthe\u001b[21Gfirst\u001b[27Gloop\u001b[32Gfor\u001b[36Ga\u001b[38Gday\u001b[42Gor\u001b[45Gtwo.\u001b[50GThat\u001b[55Gnote\u001b[60Gis\u001b[63Galso\u001b[68Gin\u001b[71GManifest's\u001b[82Gsession\u001b[90Ghandoff.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
