[0.390, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+11\u001b[38;2;153;153;153m, committed \u001b[1mb475aac\u001b[22m, ran \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mR05 is done and committed in both repos. Nothing is pushed.\u001b[63GManifest's full gate passed on its commit (\u001b[38;2;177;185;249m--werror --asan\r\u001b[2C\u001b[1B--tidy\u001b[39m, all 59 suites), and \u001b[33G \u001b[35Geeded no engine changes, so\u001b[63Gthe pi\u001b[70G s\u001b[73Gays\u001b[77G\u001b[38;2;177;185;249mea66afe\u001b[39m.\u001b[86G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWha\u001b[7G changed \u001b[17Gn Manifest (\u001b[38;2;177;185;249m9dd0d81\u001b[39m):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mClean stop:\u001b[17G\u001b[22mon SIGINT or SIGTERM the\u001b[42Gse\u001b[45Gver stops taking\u001b[62Gr\u001b[64Gquests,\u001b[72Gruns\u001b[77Gthe ones it already\u001b[97Gaccepted\u001b[106Gin\u001b[109Gone\u001b[113Glast\r\u001b[4C\u001b[1Bstep,\u001b[11Ganswers\u001b[19Gthem\u001b[24Gand\u001b[28Gwrites\u001b[35Ga\u001b[37Gsnapshot.\u001b[47GBefore,\u001b[55Ga\u001b[57Grequest\u001b[65Gaccepted\u001b[74Gjust\u001b[79Gbefore\u001b[86Gthe\u001b[90Gstop\u001b[95Ggot\u001b[99Ga\u001b[101Greceipt\u001b[109Gand\u001b[113Gnever\u001b[119Gan\r\u001b[2C\u001b[1B  answer. A restart now loads that snapshot and r\u001b[53Gplays\u001b[59Gnothi\u001b[65Gg.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mBackups:\u001b[14G\u001b[22mwith \u001b[38;2;177;185;249m--serve --backups <dir>\u001b[39m,\u001b[44Ga backup\u001b[53Gis writte\u001b[63G every time a sn\u001b[80Gpshot is\u001b[89G(hourly, and at each stop).\u001b[117GThe\r\u001b[2C\u001b[1B  \u001b[6Gi\u001b[8Gectory must be outsid\u001b[30G \u001b[32Ghe world's, and\u001b[48Gth\u001b[51G new\u001b[56Gst 24\u001b[62Gbackups\u001b[70Gare k\u001b[76Gpt. A backup\u001b[89Gi\u001b[91Gterrupted before its\u001b[112Glast\u001b[117Gfile\r\u001b[2C\u001b[1B  counts as no backup and is cleared next time.\u001b[51GA failed backup\u001b[67Gis logged and the serv\u001b[90Gr keeps running.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[58G\u001b[39monly\u001b[63Grestores\u001b[72Ginto\u001b[77Gan\u001b[80Gempty\u001b[86Gdirectory.\u001b[97GIt\u001b[100Grefuses\u001b[108Ga\u001b[110Gbackup\u001b[117Gmade\r\u001b[4C\u001b[1Bby\u001b[8Ganother\u001b[16Gbuild\u001b[22Gbefore\u001b[29Gwriting\u001b[37Ganything.\u001b[47GIt\u001b[50Gchecks\u001b[57Gevery\u001b[63Gfile\u001b[68Gand\u001b[72Gthen\u001b[77Grecovers\u001b[86Gthe\u001b[90Gworld\u001b[96Gthe\u001b[100Gway\u001b[104Ga\u001b[106Gserver\u001b[113Gstart\r\u001b[2C\u001b[1B  does. If any of that fails it removes what\u001b[48Git wrote.\u001b[58GThe backup\u001b[69Gitself i\u001b[80Gnly read.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStorage limit:\u001b[20G\u001b[22ma\u001b[22Gsnapshot\u001b[31Gbigger\u001b[38Gthan\u001b[43Ga\u001b[45Gstart\u001b[51Gcan\u001b[55Gread\u001b[60G(4\u001b[63GGiB)\u001b[68Gis\u001b[71Gnow\u001b[75Grefused\u001b[83Gwhen\u001b[88Gwritten,\u001b[97Gnot\u001b[101Gdiscovered\u001b[112Gat\u001b[115Gthe\r\u001b[2C\u001b[1B  next start. The server ex\u001b[31Gts with an error and the world keeps its l\u001b[74Gst good snapshot.\u001b[92G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[10G\u001b[22mthe\u001b[14Ghost\u001b[19Gsuite\u001b[25Gcovers\u001b[32Gthe\u001b[36Gstop,\u001b[42Gbacku\u001b[76Gd\u001b[78Gbackup,\u001b[86Grestore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\u001b[27;1H\u001b[24;3H\u001b[?25h"]
