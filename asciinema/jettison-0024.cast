[0.035, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[11G\u001b[38;2;248;248;242mpast the torch, w\u001b[29Gits\u001b[33Gfor th\u001b[41Gfir\u001b[45Gt large\u001b[53G hull. The\u001b[64Glater workstream\u001b[82G(L01\u001b[87Gonwards)\u001b[96Gwait\u001b[101Guntil\u001b[107Gthe\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[11G\u001b[38;2;248;248;242muser has played the first loop for a day or two (2026-11-24). Jettison's station traffic lanes were\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[11G\u001b[38;2;248;248;242mmeasured\u001b[20Gand parked (`\u001b[34Gixtur\u001b[40G_traffic`, 2026-11-22),\u001b[64Gto be\u001b[70Gtaken up when it\u001b[87Gfails. A\u001b[96Gcommit is gat\u001b[110Gd\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m20\u001b[11G\u001b[38;2;248;248;242min the \u001b[19Gecond checkout, `build/gate-tree`, with\u001b[59G`--tidy`, editing al\u001b[81Ge beside it       \u001b[100G     \u001b[106G    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 21 \u001b[22m ([\u001b[38;2;230;219;116mgating beside the work\u001b[39m](build-and-gates.md#gating-beside-the-work)). The development fixture takes\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 22 \u001b[22m about 50 s in Debug and six minutes under ASan, most of the gate's sanitised stage.\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDocs written.\u001b[17GChecking\u001b[26Ghow\u001b[30GManifest\u001b[39Ggates\u001b[45Gin\u001b[48Gits\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbefore\u001b[75GI\u001b[77Grun\u001b[81Git.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitting in\u001b[17GManifest,\u001b[27Gthen\u001b[32Ggating\u001b[39Gthat\u001b[44Gcommit\u001b[51Gin\u001b[54G\u001b[38;2;177;185;249mbuild/gate-tree\u001b[70G\u001b[39mwith\u001b[75G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[98G\u001b[39mat\u001b[101Gfull\u001b[106Gwidth.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunn\u001b[8Gng cd\u001b[14G'../manifest/build/gate-tree'\u001b[44G&& export\u001b[54GCMAKE_…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../manifest/build/gate-tree' && export CMAKE_BUILD_PARALLEL_LEVEL='24' CTEST_PARALLEL_LEVEL='24' \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS='24'; ./scripts/ci.sh --werror --asan --tidy --log \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153m/home/ivan/projects/manifest/build/gate-r05.log\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
