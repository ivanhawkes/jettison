[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer runs in R07. Nothing has changed yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmeasured\u001b[14Gthe\u001b[18Gdynamically\u001b[30Glinked\u001b[37Grelease\u001b[45Gbuild.\u001b[52GI\u001b[54Ghaven't\u001b[62Gchecked\u001b[70Gwhether\u001b[78Glinking\u001b[86Glibstdc++\u001b[96Gstatically\u001b[107Gpulls\u001b[113Gin\u001b[116Gglibc\r\u001b[2C\u001b[1Bsy\u001b[6Gbols newer tha\u001b[21G 2.39, or whethe\u001b[38G Dock\u001b[44Gr o\u001b[78Gthe conta\u001b[88Gner runs.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.121, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer runs in R07. Nothing has changed yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmeasured\u001b[14Gthe\u001b[18Gdynamically\u001b[30Glinked\u001b[37Grelease\u001b[45Gbuild.\u001b[52GI\u001b[54Ghaven't\u001b[62Gchecked\u001b[70Gwhether\u001b[78Glinking\u001b[86Glibstdc++\u001b[96Gstatically\u001b[107Gpulls\u001b[113Gin\u001b[116Gglibc\r\u001b[2C\u001b[1Bsy\u001b[6Gbols newer tha\u001b[21G 2.39, or whethe\u001b[38G Dock\u001b[44Gr or Podman is availabl\u001b[68G her\u001b[73G fo\u001b[78Gthe conta\u001b[88Gner runs.\u001b[K\r\u001b[2C\u001b[1B       \u001b[11G     \u001b[17G    \u001b[22G     \u001b[28G  \u001b[31G       \u001b[39G      \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
