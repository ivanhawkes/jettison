\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.\u001b[76G\u001b[22m\u001b[39ms.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\u001b[27;1H\u001b[24;3H\u001b[?25h"]
