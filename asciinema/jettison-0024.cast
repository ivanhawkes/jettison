[0.130, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[17B\u001b[38;2;177;185;249m\u001b[1mo\u001b[22mpy\u001b[33G\u001b[1mCo\u001b[22mpy\u001b[40Ge last response\u001b[56Gto clipboard (/copy 2 for the one before)\r\u001b[6C\u001b[1B\u001b[39m\u001b[1mo\u001b[22m\u001b[38;2;153;153;153mlor\u001b[33GSet the prompt bar \u001b[39m\u001b[1mco\u001b[22m\u001b[38;2;153;153;153mlor for this sessi\u001b[73Gn\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[1mo\u001b[22m\u001b[38;2;153;153;153mnfig\u001b[33GOpen setting\u001b[46G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1mco\u001b[22m\u001b[38;2;153;153;153mmpact                    F\u001b[36Ge up \u001b[39m\u001b[1mco\u001b[22m\u001b[38;2;153;153;153mntext by summarizing the conversation so far\r\u001b[6C\u001b[1B\u001b[39m\u001b[1mo\u001b[22m\u001b[38;2;153;153;153mntext\u001b[34Ghow what fills the \u001b[39m\u001b[1mco\u001b[22m\u001b[38;2;153;153;153mntext\u001b[39m\u001b[K\r\u001b[4C\u001b[2Bo\u001b[27;1H\u001b[24;6H\u001b[?25h"]
