at\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer runs in R07. Nothing has changed yet.\u001b[K\r\u001b[2C\u001b[1B         \u001b[13G    \u001b[18G  \u001b[21G    \u001b[26G       \u001b[34G   \u001b[38G       \u001b[46G \u001b[27;1H\u001b[24;3H\u001b[?25h"]
