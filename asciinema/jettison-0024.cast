[0.337, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat changed\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m:\u001b[37G\u001b[38;2;177;185;249mimgui\u001b[43G\u001b[39mnow\u001b[47Gholds\u001b[53Gonly\u001b[58GImGui's\u001b[66Gcore\u001b[71Gand\u001b[75Gits\u001b[79GFreeType\u001b[88Gfont\u001b[93Gcode,\u001b[99Gand\u001b[103Glinks\u001b[109Gonly\r\u001b[2C\u001b[1B \u001b[5GFreeType. A new \u001b[38;2;177;185;249mimgui_backends\u001b[39m target\u001b[43Gh\u001b[45Glds the\u001b[53GGLFW\u001b[58Gand Vulkan backends and links\u001b[88G\u001b[38;2;177;185;249mimgui\u001b[39m, \u001b[38;2;177;185;249mglfw\u001b[39m and \u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/engine/render/CM\u001b[29GkeLists.txt\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[49G\u001b[39mlinks \u001b[38;2;177;185;249mimgui_backends\u001b[39m \u001b[71Glongside \u001b[38;2;177;185;249mimgui\u001b[39m. It is the only code that calls the\r\u001b[2C\u001b[1B \u001b[5Gbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m); nothing else in the\u001b[55Gtree uses them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m,\u001b[75Gand\u001b[79Ga\u001b[81Gnew\u001b[85G\u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest:\u001b[106Ga\u001b[108Gsmall\u001b[114Gprogram\r\u001b[2C\u001b[1B \u001b[5Gthat links \u001b[38;2;177;185;249mDevto\u001b[22Gls\u001b[39m alone and draws a console in one ImGui frame with\u001b[75Gno rend\u001b[83Grer. Running, it\u001b[100Gchecks that no\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibg\u001b[23Gfw\u001b[39m is lo\u001b[32Gded. The\u001b[41Gtest also\u001b[51Gfails if \u001b[38;2;177;185;249mreadelf\u001b[39m shows either in NEEDED, or shows no NEEDED e\u001b[113Gtries\u001b[119Gat\r\u001b[4C\u001b[1Ball.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m:\u001b[22Gthe\u001b[26Gfinished\u001b[35Grow\u001b[39Gmoves\u001b[45Gout\u001b[49Gof\u001b[52Gthe\u001b[56Gtable,\u001b[63Gas\u001b[66Gearlier\u001b[74Gfinished\u001b[83Grows\u001b[88Gdid,\u001b[93Gand\u001b[97Gthe\u001b[101Gintro\u001b[107Gparagraph\u001b[117Gsays\r\u001b[2C\u001b[1B \u001b[5Gthe gap is provisioned. \u001b[38;2;177;185;249mdocs/history.md\u001b[45G\u001b[39mge\u001b[48Gs the delivery's table row.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngin\u001b[11G:\u001b[13G\u001b[22mbefore\u001b[20Gthe\u001b[24Gchange,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mdevtools\u001b[45G\u001b[39msuite's\u001b[53Gbinary\u001b[60Gneeded\u001b[67G\u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[83GNow\u001b[87G\u001b[38;2;177;185;249mdevtools_alone\u001b[102G\u001b[39mneeds\u001b[108Gonly\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mlibstdc++\u001b[39m, \u001b[38;2;177;185;249mlibm\u001b[39m, \u001b[38;2;177;185;249mlibgcc_s\u001b[39m and \u001b[38;2;177;185;249mlibc\u001b[39m, and\u001b[45Git pas\u001b[52Ges. \u001b[38;2;177;185;249mrender_test\u001b[39m still needs \u001b[38;2;177;185;249mlibvulkan.s\u001b[92G.1\u001b[39m, as it\u001b[102Gshould.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m I built \u001b[38;2;177;185;249mmanife\u001b[30Gt_tui\u001b[39m against this working tree in \u001b[38;2;177;185;249mbuild/sdk-local\u001b[39m. Its NEEDED has no \u001b[38;2;177;185;249mlibvulkan\u001b[110G\u001b[39mor\u001b[113G\u001b[38;2;177;185;249mlibglfw\u001b[39m;\r\u001b[2C\u001b[1B \u001b[5Gthe build\u001b[15Gon the current pin \u001b[38;2;177;185;249mea66afe\u001b[39m has \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m.\u001b[62GRun on a terminal for about ten minutes, it had\u001b[110Gneither\u001b[K\r\u001b[4C\u001b[1Bloaded.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGate:\u001b[22m \u001b[38;2;177;185;249m./scripts/ci.sh --werror --asan --log build/gate.log\u001b[64G\u001b[39mpassed\u001b[71Gevery\u001b[77Gstage\u001b[83Gin\u001b[86G199\u001b[90Gs,\u001b[93Grun\u001b[97Gwith\u001b[102G58\u001b[105GGiB\u001b[109Gfree.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWaiting for your go-ahead:\u001b[30G\u001b[22mthe\u001b[34Gengine\u001b[41Gcommit\u001b[75G\u001b[38;2;177;185;249ml: ImGui's GLFW and Vulkan backends out of \u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
