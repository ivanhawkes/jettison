[0.076, "o", "\u001b[?25l\u001b[H\u001b[3G├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ openSUSE          │ Tumbleweed (2.44) \u001b[64G│\u001b[66GLeap\u001b[71G15.6\u001b[76G(2.38)\u001b[106G│\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[1B  │ Gentoo            │ 2.44                                   │ —                                       │\u001b[K\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ NixOS             │ unstable (2.44)                        │ 26.05 (2.42)\u001b[106G│\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[1B \u001b[3G│ RHEL, Alma, Ro\u001b[20Gky │ none    \u001b[34G             \u001b[48G      \u001b[55G      \u001b[62G  │ 9 (2.34); 10 \u001b[80Gsn't on Repology\u001b[106G│\r\u001b[1B  ├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GVoid\u001b[23G│\u001b[25Gnone\u001b[64G│\u001b[66G2.41\u001b[106G│\r\u001b[1B \u001b[3G└───────────────────┴────────────────────────────────────────┴─────────────────────────────────────────┘\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7G2.43\u001b[12Gfloor\u001b[18Grules\u001b[24Gout\u001b[28GDebian\u001b[35Gstable,\u001b[43GUbuntu\u001b[50G24.04\u001b[56GLTS,\u001b[61Gevery\u001b[67GRHEL-family\u001b[79Grelease,\u001b[88GLeap\u001b[93Gand\u001b[97GNixOS\u001b[103Gstable.\u001b[111GMost\r\u001b[2C\u001b[1Bservers run one of those.\u001b[29GIf\u001b[32Gthe\u001b[36Gbundle\u001b[43Ghas\u001b[47Gto\u001b[50Greach\u001b[56Gthem,\u001b[62GR07\u001b[66Ghas\u001b[70Gto\u001b[73Gbuild\u001b[79Gagainst\u001b[87Gan\u001b[90Golder\u001b[96Gglibc,\u001b[103Gwhich\u001b[109Gtakes\u001b[115Ga\r\u001b[2C\u001b[1Bseparate\u001b[12Gsysroot\u001b[20Gor\u001b[23Gtoolchain,\u001b[34Gnot\u001b[38Gjust\u001b[43Ga\u001b[45Glink\u001b[50Gflag.\u001b[56GThat's\u001b[63Ga\u001b[65Gchange\u001b[72Gto\u001b[75GD-114,\u001b[82Gand\u001b[86GI\u001b[88Ghaven't\u001b[96Gmade\u001b[101Git.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMint,\u001b[9GPop!_OS,\u001b[18Gelementary\u001b[29Gand\u001b[33GSteamOS\u001b[41Garen't\u001b[48Gon\u001b[51GRepology,\u001b[61Gand\u001b[65Gthe\u001b[69GUbuntu\u001b[76G22.04–25.10,\u001b[89GTumbleweed\u001b[100Gand\u001b[104GVoid\u001b[109Gfigures\u001b[117Gcome\r\u001b[1B \u001b[3Gfrom a summary of the page rath\u001b[35Gr than its \u001b[47Gaw rows.\u001b[56GMint\u001b[61Gand\u001b[65GPop!_OS\u001b[73Gfollow\u001b[80Gtheir\u001b[86GUbuntu\u001b[93GLTS\u001b[97Gbase,\u001b[103Gso\u001b[106Gthey're\r\u001b[1B  probably on\u001b[15G2.39 or older\u001b[29Guntil\u001b[35Gthey\u001b[40Gmove\u001b[45Gto\u001b[48G26.04.\r\u001b[26C\u001b[2B\u001b[38;2;153;153;153m3\u001b[29G4\u001b[39m\u001b[27;1H\u001b[24;103H\u001b[?25h"]
