[0.016, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gglibc 2.44). I\u001b[20G holds\u001b[27G\u001b[38;2;177;185;249mbin/\u001b[39m with the four binar\u001b[52Ges\u001b[55G(serve\u001b[62G, validator, token\u001b[81Gtool and\u001b[90GTUI),\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m, a\u001b[37G\u001b[38;2;177;185;249mBUILD\u001b[39m file (the build's identity and cont\u001b[80Gt fingerprint\u001b[94G and\u001b[99Gthe\u001b[103Glicences.\u001b[113GIt\u001b[116Gis\r\u001b[4C\u001b[1Bstaged from a clean commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGlibc floor:\u001b[22m 2.43 is what the\u001b[35Gbinaries\u001b[44Gask\u001b[48Gfor\u001b[52Gtoday\u001b[58G(\u001b[38;2;177;185;249mremainder@GLIBC_2.43\u001b[39m),\u001b[82Gnot\u001b[86Gsomething\u001b[96Gwe\u001b[99Gchose.\u001b[106GIt\u001b[109Grises\r\u001b[2C\u001b[1B \u001b[5Gwhenever the\u001b[18Gdevenv's nixpkgs\u001b[35Gdoes, so\u001b[44GR07\u001b[49Gails when a binary asks for more.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLinking:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mlibstdc++\u001b[39m and \u001b[38;2;177;185;249mlibgcc\u001b[35G\u001b[39mlinked statically,\u001b[54Gno \u001b[38;2;177;185;249mRUNPATH\u001b[39m, and the loade\u001b[80G at\u001b[84G\u001b[38;2;177;185;249m/lib64/ld-linux-x86-64.so.2\u001b[39m.\u001b[113GToday\r\u001b[2C\u001b[1B \u001b[5Gall of them point into\u001b[28Gthe devenv's \u001b[38;2;177;185;249m/nix/store\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent and data:\u001b[23G\u001b[22mcontent is found next to the executable\u001b[63Gthrough\u001b[71G\u001b[38;2;177;185;249m/proc/self/exe\u001b[39m,\u001b[87Gso\u001b[90Gthe\u001b[94Gbundle\u001b[101Gcan't\u001b[107Gship\u001b[112Gits\u001b[116Gown\r\u001b[2C\u001b[1B \u001b[5Gloader. The world, backups and toke\u001b[41Gs go under\u001b[52Gth\u001b[55G XDG direct\u001b[67Gries for \u001b[38;2;177;185;249mmani\u001b[81Gest\u001b[39m, and\u001b[90Gso does the TUI's transcript.\r\u001b[4C\u001b[1BThe server logs to\u001b[24Gstderr,\u001b[36Gn\u001b[38Gthing is written beside the binaries or in the working\u001b[94Girec\u001b[99Gory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefaults I chose, which you may want to change:\u001b[22m the paths, and b\u001b[70Gckups sw\u001b[79Gtched\u001b[85Gon by default. \u001b[38;2;177;185;249m--scenario\u001b[111G\u001b[39mstays\r\u001b[2C\u001b[1B \u001b[5Grequired.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine gap:\u001b[19G\u001b[22mJettison's\u001b[30G\u001b[38;2;177;185;249mimgui\u001b[36G\u001b[39mtarget\u001b[43Gbuilds\u001b[50GImGui's\u001b[58GGLFW\u001b[63Gand\u001b[67GVulkan\u001b[74Gbackends\u001b[83Ginto\u001b[88Gitself.\u001b[96GSo\u001b[99Ganything\u001b[108Gthat\u001b[113Glinks\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mDevtools\u001b[39m, including Manifest's terminal\u001b[43GTUI, needs \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m eve\u001b[74Gthough it \u001b[85Gever draws. I\u001b[100Gdded a row for this\r\u001b[2C\u001b[1Bto the roadmap's delivery table, to be done before\u001b[54GR07. Manifest has its \u001b[77Gwn f\u001b[82Gxes fo\u001b[90GR07 too:\u001b[99Gthe TUI\u001b[108Geads a\u001b[115G\u001b[K\r\u001b[2C\u001b[1Bc\u001b[5Gn\u001b[7Gent p\u001b[13Gth compiled into it and writes its log to \u001b[38;2;177;185;249m./build/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles changed:\r\u001b[2C\u001b[1B\u001b[22m- Manifest: \u001b[38;2;177;185;249mstage-5-recovery-plan.md\u001b[39m,\u001b[41G\u001b[38;2;177;185;249mdecision-ledger.md\u001b[39m,\u001b[61G\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m,\u001b[80G\u001b[38;2;177;185;249mhistory.md\u001b[39m,\u001b[92G\u001b[38;2;177;185;249msession-handoff.md\u001b[39m.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
