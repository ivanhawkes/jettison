[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBackups:\u001b[14G\u001b[22mwith\u001b[19G\u001b[38;2;177;185;249m--serve --backups <dir>\u001b[39m,\u001b[44Ga\u001b[46Gbackup\u001b[53Gis\u001b[56Gwritten\u001b[64Gevery\u001b[70Gtime\u001b[75Ga\u001b[77Gsnapshot\u001b[86Gis\u001b[89G(hourly,\u001b[98Gand\u001b[102Gat\u001b[105Geach\u001b[110Gstop).\u001b[117GThe\r\u001b[2C\u001b[1B  directory must be outside the world's, and the newest 24 backups are\u001b[74Gkept.\u001b[80GA\u001b[82Gbackup\u001b[89Ginterrupted\u001b[101Gbefore\u001b[108Gits\u001b[112Glast\u001b[117Gfile\r\u001b[4C\u001b[1Bcounts\u001b[12Gas\u001b[15Gno\u001b[18Gbackup\u001b[25Gand\u001b[29Gis\u001b[32Gcleared\u001b[40Gnext\u001b[45Gtime.\u001b[51GA\u001b[53Gfailed\u001b[60Gbackup\u001b[67Gis\u001b[70Glogged\u001b[77Gand\u001b[81Gthe\u001b[85Gserver\u001b[92Gkeeps\u001b[98Grunning.\r\u001b[1B \u001b[3G- \u001b[1mRestore:\u001b[22m \u001b[38;2;177;185;249mmanifest … --restore <backup> --world <dir>\u001b[39m only\u001b[63Grestores into an empty directory. It refuses a backup made\r\u001b[2C\u001b[1B  by another build before wr\u001b[33Gi\u001b[35Gg anything. It checks every\u001b[63Gfile a\u001b[70Gd \u001b[73Ghen\u001b[77Grecovers\u001b[86Gthe\u001b[90Gworld\u001b[96Gthe\u001b[100Gway\u001b[104Ga\u001b[106Gserver\u001b[113Gstart\r\u001b[4C\u001b[1Bdoes.\u001b[11GIf\u001b[14Gany\u001b[18Gof\u001b[21Gthat\u001b[26Gfails\u001b[32Git\u001b[35Gremoves\u001b[43Gwhat\u001b[48Git\u001b[51Gwrote.\u001b[58GThe\u001b[62Gbackup\u001b[69Gitself\u001b[76Gis\u001b[79Gonly\u001b[84Gread.\r\u001b[2C\u001b[1B- \u001b[1mS\u001b[7Gorage lim\u001b[17Gt:\u001b[22m a snapshot bigger than\u001b[43Ga\u001b[45Gstart\u001b[51Gcan\u001b[55Gread\u001b[60G(4\u001b[63GGiB)\u001b[68Gis\u001b[71Gnow\u001b[75Grefused\u001b[83Gwhen\u001b[88Gwritten,\u001b[97Gnot\u001b[101Gdiscovered\u001b[112Gat\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gnext start.\u001b[17GThe server exits with an\u001b[42Ger\u001b[45Gor and the world\u001b[62Gk\u001b[64Geps its\u001b[72Glast\u001b[77Ggood snapshot.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[22m the host suite covers the stop, backup ret\u001b[53Gntion\u001b[59Gand a\u001b[65G interrupted\u001b[78Gbackup,\u001b[86Grestore\u001b[94Gand\u001b[98Gits\u001b[102Grefusals,\u001b[112Gthe\u001b[116Gsize\r\u001b[2C\u001b[1Blimit, and\u001b[14Ga backup directory inside the\u001b[44Gworld. A\u001b[53Gnew tradi\u001b[63Gg-fixture case b\u001b[80Gcks up a\u001b[89Gworld mid-flight with a buy\u001b[117G\u001b[K\r\u001b[2C\u001b[1Bor\u001b[6Ge\u001b[8G holding escrow. It r\u001b[30Gs\u001b[32Gores it, checks\u001b[48Gev\u001b[51Gry r\u001b[56Gquest\u001b[62Goutcome\u001b[70Gmatch\u001b[76Gs, and flies\u001b[89Go\u001b[91G to the loop's usual\u001b[112Gend\u001b[K\r\u001b[2C\u001b[1Bstate. \u001b[38;2;177;185;249mcli_serve\u001b[39m now restores the stop's backup\u001b[51Gat the step the\u001b[67Gserver stopped, and ch\u001b[90Gcks that restoring\u001b[109Gover\u001b[114Ga\u001b[116Glive\r\u001b[2C\u001b[1Bworld is refused.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured in Debug:\u001b[22m a backup is 730 KB today.\u001b[48GA restore\u001b[58Gtakes 0.25\u001b[69Gs, 0.11 \u001b[80Gf which is\u001b[91Gstart-up.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a backup can lose:\u001b[22m it \u001b[31Gs only as fresh as its snapshot, so up to \u001b[74Gn hour behind the\u001b[92Glive\u001b[97Gworld.\u001b[104GThat's\u001b[111Grecorded\r\u001b[2C\u001b[1Bin\u001b[6Gthe\u001b[10GStage\u001b[16G5\u001b[18Gplan.\r\u001b[2C\u001b[1B      \u001b[10G   \u001b[14G    \u001b[19G     \u001b[25G      \u001b[32G   \u001b[36G     \u001b[42G     \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
