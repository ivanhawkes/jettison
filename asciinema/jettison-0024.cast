[6.312, "o", "\u001b[?25l\u001b[H\u001b[3G│ Arch, Manjaro     │ rolling, 2.44                          │ —                                       │\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ openSUSE          │ Tumbleweed (2.44)                      │ Leap 15.6 (2.38)                        │\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Gentoo            │ 2.44                                   │ —                                       │\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ NixOS             │ unstable (2.44)                        │ 26.05 (2.42)                            │\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ RHEL, Alma, Rocky │ none                                   │ 9 (2.34); 10 isn't on Repology          │\r\u001b[2C\u001b[1B├───────────────────┼────────────────────────────────────────┼─────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ Void              │ none                                   │ 2.41                                    │\r\u001b[2C\u001b[1B└───────────────────┴────────────────────────────────────────┴─────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe 2.43 flo\u001b[16Gr rules \u001b[25Gut Debian stable,\u001b[43GUbun\u001b[48Gu\u001b[50G24.04\u001b[56GLTS, every RHEL-fam\u001b[77Gy\u001b[79Grelea\u001b[85Ge, Leap and N\u001b[99GxOS\u001b[103Gstable. Mo\u001b[114Gt\u001b[K\r\u001b[4C\u001b[1Brvers run one of th\u001b[25Gse. If the bundle\u001b[43Ghas to\u001b[50Gre\u001b[53Gch\u001b[56Gt\u001b[58Gem, R07 \u001b[68Gs to build agai\u001b[84Gst an older\u001b[96Gglibc, which\u001b[109Gtakes\u001b[115Ga\r\u001b[2C\u001b[1Bseparate\u001b[12Gsysroot\u001b[20Gor\u001b[23Gtoolchain,\u001b[34Gnot\u001b[38Gjust\u001b[43Ga\u001b[45Glink\u001b[50Gflag.\u001b[56GThat's\u001b[63Ga\u001b[65Gchange\u001b[72Gto\u001b[75GD-114,\u001b[82Gand\u001b[86GI\u001b[88Ghaven't\u001b[96Gmade\u001b[101Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMint, Pop!_OS,\u001b[18Gelementary and SteamOS aren't on Repology,\u001b[65Gthe Ubuntu 22.04–25.10, Tumbleweed and Void figures\u001b[117Gcome\r\u001b[2C\u001b[1Bf\u001b[6Gm a summary of the page rather than its raw rows.\u001b[56GMint\u001b[61Gand\u001b[65GPop!_OS\u001b[73Gfollow\u001b[80Gtheir\u001b[86GUbuntu\u001b[93GLTS\u001b[97Gbase,\u001b[103Gso\u001b[106Gthey're\r\u001b[2C\u001b[1Bprobably\u001b[12Gon\u001b[15G2.39\u001b[20Gor\u001b[23Golder\u001b[29Guntil\u001b[35Gthey\u001b[40Gmove\u001b[45Gto\u001b[48G26.04.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;113H\u001b[?25h"]
[0.021, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Check the distos and release versions that support glibc 2.43 or newer.\u001b[39m                                               \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;113H\u001b[?25h"]
