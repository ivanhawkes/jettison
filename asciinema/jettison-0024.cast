[0.057, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────────────────┼─────────┼──────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;2;177;185;249mremainder\u001b[39m       │ 2.43    │ the math library; all four binaries use it                                           │\r\u001b[2C\u001b[1B├─────────────────┼─────────┼──────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;2;177;185;249msqrtf\u001b[39m           │ 2.43    │ the math library; only the TUI uses it                                               │\r\u001b[2C\u001b[1B├─────────────────┼─────────┼──────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;2;177;185;249m__inet_pton_chk\u001b[39m │ 2.42    │ the server and the TUI; nixpkgs' clang wrapper turns on \u001b[38;2;177;185;249m_FORTIFY_SOURCE\u001b[39m, which swaps │\r\u001b[4C\u001b[1B               \u001b[23G    \u001b[33G \u001b[38;2;177;185;249minet_pton\u001b[44G\u001b[39mfor\u001b[48Gits\u001b[52Gchecked variant    \u001b[72G       \u001b[80G     \u001b[86G  \u001b[89G                \u001b[106G     \u001b[112G     \r\u001b[2C\u001b[1B└─────────────────┴─────────┴──────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything\u001b[14Gelse\u001b[19Gasks\u001b[24Gfor\u001b[28G2.38\u001b[33Gor\u001b[36Golder.\u001b[43GSo\u001b[46Gthe\u001b[50Gfloor\u001b[56Gof\u001b[59G2.43\u001b[64Gis\u001b[67Gan\u001b[70Gaccident\u001b[79Gof\u001b[82Gbuilding\u001b[91Gagainst\u001b[99Gnixpkgs'\u001b[108Gcurrent\r\u001b[2C\u001b[1Bglibc; nothing in the code needs\u001b[36Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[