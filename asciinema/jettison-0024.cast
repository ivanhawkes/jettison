[0.097, "o", "\u001b[?25l\u001b[H\u001b[3GEv\u001b[6Grything else ask\u001b[24Gfor\u001b[28G2.38 or older.\u001b[43GSo the\u001b[50Gfloor\u001b[56Gof 2.43 is\u001b[67Gan accident\u001b[79Gof building ag\u001b[94Ginst nixpkgs' curren\r\u001b[2C\u001b[1Bglibc; nothing in the code needs\u001b[36Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath functions:\u001b[22m bi\u001b[24Gd \u001b[38;2;177;185;249mremainder\u001b[39m \u001b[37Gnd \u001b[38;2;177;185;249msqrtf\u001b[39m \u001b[47Go their older\u001b[61Gsymbol versions with \u001b[38;2;177;185;249m.symver\u001b[39m in one small header. They're\u001b[K\r\u001b[2C\u001b[1B  the same IEEE operations\u001b[30Gunder an older name.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1minet_pton:\u001b[22m build the one file\u001b[37Gat\u001b[40Gcalls it with \u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[4C\u001b[1Bcheck\u001b[11Gon\u001b[14Gthat\u001b[19Gone\u001b[23Gcall.\r\u001b[1B \u001b[3G- \u001b[1mThe check:\u001b[22m R07's objdump check fails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\r\u001b[1B  - \u001b[1mThe cost:\u001b[22m every nixpkgs bump may bring in another symbol. The check catches it and you add another pin, which is a\u001b[K\r\u001b[1B    little fragile but cheap.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m, with Cl\u001b[66Gng 21 from apt.llvm.org.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRobust:\u001b[13G\u001b[22mthe\u001b[17Gfloor\u001b[23Gholds\u001b[29Gby\u001b[32Gconstruction.\r\u001b[1B \u001b[3G- \u001b[1mA second toolchain:\u001b[22m it lives\u001b[34Goutside\u001b[42Gdevenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[1B    have to run there too.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu 24.04 has GCC 13's, and the code uses \u001b[38;2;177;185;249mstd::format\u001b[39m and other newer C++ in about 30 files.\r\u001b[4C\u001b[1BBuilding them against it may need fixes.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[22m It's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.141, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mMath functions:\u001b[21G\u001b[22mbind\u001b[26G\u001b[38;2;177;185;249mremainder\u001b[36G\u001b[39mand\u001b[40G\u001b[38;2;177;185;249msqrtf\u001b[46G\u001b[39mto\u001b[49Gtheir\u001b[55Golder\u001b[61Gsymbol\u001b[68Gversions\u001b[77Gwith\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B  the same IEEE operations under an older name.\u001b[K\r\u001b[4C\u001b[1B\u001b[1minet_pton:\u001b[22m build the\u001b[26Gone file that\u001b[40Gcalls\u001b[46Git\u001b[49Gwith \u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m, \u001b[74Gr bind it the same\u001b[93Gway. You give up the bounds\r\u001b[4C\u001b[1Bc\u001b[8Gck on\u001b[14Gthat\u001b[20Gn\u001b[22G call.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTh\u001b[8G check\u001b[16G\u001b[22mR07's\u001b[22Gobjdump\u001b[30Gcheck f\u001b[38Gils on anyth\u001b[51Gng\u001b[54Gnewer than 2.39. That\u001b[76Gmakes 2.39 a chosen flo\u001b[100Gr\u001b[102Grather than\u001b[114Ga\u001b[K\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\u001b[19G\u001b[K\r\u001b[9C\u001b[1B\u001b[1most:\u001b[22m every nixpkgs bump may bring in another symbol. The check catches it and you add\u001b[96Gan\u001b[99Gthe\u001b[103G pin,\u001b[109Gw\u001b[111Gich is\u001b[118Ga\r\u001b[4C\u001b[1Blittle fragile\u001b[20Gbut\u001b[24Gcheap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRobust:\u001b[13G\u001b[22mthe\u001b[17Gfloor\u001b[23Gholds\u001b[29Gby\u001b[32Gconstruction.\r\u001b[2C\u001b[1B- \u001b[1mA second toolchain:\u001b[22m it lives outside devenv, release\u001b[58Gb\u001b[60Gnaries no longer\u001b[77Gcome from the\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to\u001b[13Grun\u001b[17Gthere\u001b[23Gt\u001b[25Go.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mn older\u001b[14Glibstdc++\u001b[25G\u001b[22mUbuntu 24.04 has\u001b[42GGCC 13's, and the code uses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand o\u001b[90Gr newer C++ in about 30 fil\u001b[119G.\u001b[K\r\u001b[4C\u001b[1BBuilding them against it\u001b[30Gmay\u001b[34Gneed\u001b[39Gfixes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't\u001b[9GClang\u001b[15G21,\u001b[19Gand\u001b[23Glibc++\u001b[30Ginstead\u001b[38Gof\u001b[41Glibstdc++.\u001b[52GThat's\u001b[59Gtoo\u001b[63Gdifferent\u001b[73Gfrom\u001b[78Gwhat\u001b[83Gthe\u001b[87Ggate\u001b[92Gtests.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.095, "o", "\u001b[?25l\u001b[H\r\u001b[44C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m60\u001b[48G1\u001b[52G8\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.278, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.176, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[39m to their older symbol versions with\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.151, "o", "\u001b[?25l\u001b[H\u001b[3G  the same IEEE operations under an older name.\u001b[K\r\u001b[4C\u001b[1B\u001b[1minet_pton:\u001b[22m build the\u001b[26Gone file that\u001b[40Gcalls\u001b[46Git\u001b[49Gwith \u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m, \u001b[74Gr bind it the same\u001b[93Gway. You give up the bounds\r\u001b[4C\u001b[1Bc\u001b[8Gck on\u001b[14Gthat\u001b[20Gn\u001b[22G call.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTh\u001b[8G check\u001b[16G\u001b[22mR07's\u001b[22Gobjdump\u001b[30Gcheck f\u001b[38Gils on anyth\u001b[51Gng\u001b[54Gnewer than 2.39. That\u001b[76Gmakes 2.39 a chosen flo\u001b[100Gr\u001b[102Grather than\u001b[114Ga\u001b[K\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\u001b[19G\u001b[K\r\u001b[9C\u001b[1B\u001b[1most:\u001b[22m every nixpkgs bump may bring in another symbol. The check catches it and you add\u001b[96Gan\u001b[99Gthe\u001b[103G pin,\u001b[109Gw\u001b[111Gich is\u001b[118Ga\r\u001b[4C\u001b[1Blittle fragile\u001b[20Gbut\u001b[24Gcheap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRobust:\u001b[13G\u001b[22mthe\u001b[17Gfloor\u001b[23Gholds\u001b[29Gby\u001b[32Gconstruction.\r\u001b[2C\u001b[1B- \u001b[1mA second toolchain:\u001b[22m it lives outside devenv, release\u001b[58Gb\u001b[60Gnaries no longer\u001b[77Gcome from the\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to\u001b[13Grun\u001b[17Gthere\u001b[23Gt\u001b[25Go.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mn older\u001b[14Glibstdc++\u001b[25G\u001b[22mUbuntu 24.04 has\u001b[42GGCC 13's, and the code uses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand o\u001b[90Gr newer C++ in about 30 fil\u001b[119G.\u001b[K\r\u001b[4C\u001b[1BBuilding them against it\u001b[30Gmay\u001b[34Gneed\u001b[39Gfixes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't\u001b[9GClang\u001b[15G21,\u001b[19Gand\u001b[23Glibc++\u001b[30Ginstead\u001b[38Gof\u001b[41Glibstdc++.\u001b[52GThat's\u001b[59Gtoo\u001b[63Gdifferent\u001b[73Gfrom\u001b[78Gwhat\u001b[83Gthe\u001b[87Ggate\u001b[92Gtests.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto run\u001b[30Gthe bundle\u001b[41Gin Ubuntu 24.04 and trixie co\u001b[72Gainers, because \u001b[89G symbol check\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove\u001b[9Git\u001b[12Gstarts.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.448, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.103, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mTh\u001b[8G check\u001b[16G\u001b[22mR07's\u001b[22Gobjdump\u001b[30Gcheck f\u001b[38Gils on anyth\u001b[51Gng\u001b[54Gnewer than 2.39. That\u001b[76Gmakes 2.39 a chosen flo\u001b[100Gr\u001b[102Grather than\u001b[114Ga\u001b[K\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\u001b[19G\u001b[K\r\u001b[9C\u001b[1B\u001b[1most:\u001b[22m every nixpkgs bump may bring in another symbol. The check catches it and you add\u001b[96Gan\u001b[99Gthe\u001b[103G pin,\u001b[109Gw\u001b[111Gich is\u001b[118Ga\r\u001b[4C\u001b[1Blittle fragile\u001b[20Gbut\u001b[24Gcheap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRobust:\u001b[13G\u001b[22mthe\u001b[17Gfloor\u001b[23Gholds\u001b[29Gby\u001b[32Gconstruction.\r\u001b[2C\u001b[1B- \u001b[1mA second toolchain:\u001b[22m it lives outside devenv, release\u001b[58Gb\u001b[60Gnaries no longer\u001b[77Gcome from the\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to\u001b[13Grun\u001b[17Gthere\u001b[23Gt\u001b[25Go.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mn older\u001b[14Glibstdc++\u001b[25G\u001b[22mUbuntu 24.04 has\u001b[42GGCC 13's, and the code uses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand o\u001b[90Gr newer C++ in about 30 fil\u001b[119G.\u001b[K\r\u001b[4C\u001b[1BBuilding them against it\u001b[30Gmay\u001b[34Gneed\u001b[39Gfixes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't\u001b[9GClang\u001b[15G21,\u001b[19Gand\u001b[23Glibc++\u001b[30Ginstead\u001b[38Gof\u001b[41Glibstdc++.\u001b[52GThat's\u001b[59Gtoo\u001b[63Gdifferent\u001b[73Gfrom\u001b[78Gwhat\u001b[83Gthe\u001b[87Ggate\u001b[92Gtests.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto run\u001b[30Gthe bundle\u001b[41Gin Ubuntu 24.04 and trixie co\u001b[72Gainers, because \u001b[89G symbol check\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove\u001b[9Git\u001b[12Gstarts.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you choose option\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer\u001b[13Gruns\u001b[18Gin\u001b[21GR07.\u001b[26GNothing\u001b[34Ghas\u001b[38Gchanged\u001b[46Gyet.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.297, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer runs in R07. Nothing has changed yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmeasured\u001b[14Gthe\u001b[18Gdynamically\u001b[30Glinked\u001b[37Grelease\u001b[45Gbuild.\u001b[52GI\u001b[54Ghaven't\u001b[62Gchecked\u001b[70Gwhether\u001b[78Glinking\u001b[86Glibstdc++\u001b[96Gstatically\u001b[107Gpulls\u001b[113Gin\u001b[116Gglibc\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.175, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m, with\u001b[63GClang 21 from apt.llvm.org.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRobust:\u001b[22m the floor holds by\u001b[32Gconstruction.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA second toolchain:\u001b[25G\u001b[22mit\u001b[28Glives\u001b[34Goutside\u001b[42Gdevenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B  have to run there too.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04 has GCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may\u001b[34Gneed fixes.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[22m It's\u001b[56Gmade for\u001b[65Gexactly this. The cost is zig's bundled\u001b[105GLLVM,\u001b[111Gwhich\u001b[K\r\u001b[2C\u001b[1Bisn't Clang 21,\u001b[20Gnd libc++\u001b[30Ginstead o\u001b[40G libstdc++.\u001b[52GThat's\u001b[59Gtoo\u001b[63Gdifferent\u001b[73Gfrom\u001b[78Gwhat\u001b[83Gthe\u001b[87Ggate\u001b[92Gtests.\r\u001b[2C\u001b[2B\u001b[1mEi\u001b[6Gher\u001b[10Gway:\u001b[22m R07 has to run the bundle in Ubuntu\u001b[51G24.04 \u001b[58Gnd\u001b[61Gtrixie \u001b[69Gontainers, b\u001b[82Gcau\u001b[86Ge\u001b[88Ga symbol\u001b[97Gcheck alone doesn't\r\u001b[2C\u001b[1Bprove\u001b[9Git starts.\u001b[K\r\u001b[2C\u001b[2BIf you choose option 1, I'll change D-114 and the R\u001b[55G6\u001b[57Gsection to\u001b[68Gset the floor at 2.39\u001b[90Gand put the pins an\u001b[110G the\u001b[K\r\u001b[2C\u001b[1Bcontainer runs in\u001b[21GR07.\u001b[26GNothing\u001b[34Ghas\u001b[38Gchanged\u001b[46Gyet.\r\u001b[3C\u001b[2B measured the dynamically \u001b[31Ginked release\u001b[45Gbuild. I haven'\u001b[61G checked whether linking libstdc++ statically\u001b[107Gpulls in\u001b[116Gglibc\r\u001b[2C\u001b[1Bsymbols newer than 2.39, or whether Dock\u001b[44Gr\u001b[46Gor Podman\u001b[56Gis\u001b[59Gavailable\u001b[69Ghere\u001b[74Gfor\u001b[78Gthe\u001b[82Gcontainer\u001b[92Gruns.\r\u001b[2B\u001b[38;2;215;119;87m✽\u001b[3GCrunching… \u001b[38;2;153;153;153m(57s · ↓\u001b[39m \u001b[38;2;153;153;153m4.1k tokens)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
