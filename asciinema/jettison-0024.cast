[0.098, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mThe bundle:\u001b[22m a tarball for x86-64 Linux with glibc 2.43 or newer, which runs on NixOS through nix-ld (Lythir has\r\u001b[4C\u001b[1Bglibc 2.44). It holds \u001b[38;2;177;185;249mbin/\u001b[39m with the four binaries (server, validator, token tool and TUI),\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m, a \u001b[38;2;177;185;249mBUILD\u001b[39m file (the build's identity and content fingerprint) and the licences. It\u001b[116Gis\r\u001b[4C\u001b[1Bstaged from a clean commit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGlibc floor:\u001b[22m 2.43 is what the\u001b[36Ginaries a\u001b[46Gk fo\u001b[51G today (\u001b[38;2;177;185;249mremainder@GLIBC_2.43\u001b[39m),\u001b[82Gnot\u001b[86Gsomething\u001b[96Gwe\u001b[99Gchose.\u001b[106GIt\u001b[109Grises\r\u001b[4C\u001b[1Bwhenever\u001b[14Gthe\u001b[18Gdevenv's\u001b[27Gnixpkgs\u001b[35Gdoes,\u001b[41Gso\u001b[44GR07\u001b[48Gfails\u001b[54Gwhen\u001b[59Ga\u001b[61Gbinary\u001b[68Gasks\u001b[73Gfor\u001b[77Gmore.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLinking:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mlibstdc++\u001b[39m and \u001b[38;2;177;185;249mlibgcc\u001b[39m linked statically,\u001b[54Gno \u001b[38;2;177;185;249mRUNPATH\u001b[39m,\u001b[66Gand\u001b[70Gthe\u001b[74Gloader\u001b[81Gat\u001b[84G\u001b[38;2;177;185;249m/lib64/ld-linux-x86-64.so.2\u001b[39m.\u001b[113GToday\r\u001b[4C\u001b[1Ball\u001b[9Gof\u001b[12Gthem\u001b[17Gpoint\u001b[23Ginto\u001b[28Gthe\u001b[32Gdevenv's\u001b[41G\u001b[38;2;177;185;249m/nix/store\u001b[39m.\r\u001b[2C\u001b[1B- \u001b[1mContent and data:\u001b[22m content is found\u001b[40Gnext\u001b[45Gto\u001b[48Gthe\u001b[52Gexecutable\u001b[63Gthrough\u001b[71G\u001b[38;2;177;185;249m/proc/self/exe\u001b[39m,\u001b[87Gso\u001b[90Gthe\u001b[94Gbundle\u001b[101Gcan't\u001b[107Gship\u001b[112Gits\u001b[116Gown\r\u001b[4C\u001b[1Bloader.\u001b[13GThe\u001b[17Gworld,\u001b[24Gbackups\u001b[32Gand\u001b[36Gtokens\u001b[43Ggo\u001b[46Gunder\u001b[52Gthe\u001b[56GXDG\u001b[60Gdirectories\u001b[72Gfor\u001b[76G\u001b[38;2;177;185;249mmanifest\u001b[39m,\u001b[86Gand\u001b[90Gso\u001b[93Gdoes\u001b[98Gthe\u001b[102GTUI's\u001b[108Gtranscript.\r\u001b[1B \u001b[3G  The server logs to stderr, an\u001b[35G nothi\u001b[42Gg is w\u001b[49Gitten\u001b[55Gbeside\u001b[62Gthe\u001b[66Gbinaries\u001b[75Gor\u001b[78Gin\u001b[81Gthe\u001b[85Gworking\u001b[93Gdirectory.\r\u001b[1B  - \u001b[1mDefaults I chose, which you may want to change:\u001b[53G\u001b[22mthe\u001b[57Gpaths,\u001b[64Gand\u001b[68Gbackups\u001b[76Gswitched\u001b[85Gon\u001b[88Gby\u001b[91Gdefault.\u001b[100G\u001b[38;2;177;185;249m--scenario\u001b[111G\u001b[39mstays\r\u001b[4C\u001b[1Brequired.\u001b[15G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine gap:\u001b[22m Jettison's \u001b[38;2;177;185;249mimgui\u001b[39m target builds ImGui's GLFW and Vulkan backends\u001b[83Ginto\u001b[88Gitself.\u001b[96GSo\u001b[99Ganything\u001b[108Gthat\u001b[113Glinks\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mDevtools\u001b[39m, including Manifest's terminal TUI, needs \u001b[38;2;177;185;249mlibvulkan.so.1\u001b[39m even though it never draws. I added a row for\u001b[115Gthis\r\u001b[2C\u001b[1Bto\u001b[6Gthe\u001b[10Groadmap's\u001b[20Gdelivery\u001b[29Gtable,\u001b[36Gto\u001b[39Gbe\u001b[42Gdone\u001b[47Gbefore\u001b[54GR07.\u001b[59GManifest\u001b[68Ghas\u001b[72Gits\u001b[76Gown\u001b[80Gfixes\u001b[86Gfor\u001b[90GR07\u001b[94Gtoo:\u001b[99Gthe\u001b[103GTUI\u001b[107Greads\u001b[113Ga\r\u001b[1B \u001b[3Gco\u001b[6Gte\u001b[9Gt\u001b[11Gpat\u001b[15G compiled into\u001b[30Git\u001b[33Gand\u001b[37Gwrites\u001b[44Gits\u001b[48Glog\u001b[52Gto\u001b[55G\u001b[38;2;177;185;249m./build/\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles changed:\r\u001b[1B\u001b[22m \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
