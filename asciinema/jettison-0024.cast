[1.186, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────────────────┼─────────┼──────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G\u001b[38;2;177;185;249msqrtf\u001b[39m          \u001b[21G│ 2.43    │ the math library; only th\u001b[59G TUI uses it     \u001b[77G    \u001b[82G       \u001b[90G  \u001b[93G   \u001b[97G     \u001b[103G       \u001b[111G       │\r\u001b[2C\u001b[1B├─────────────────┼─────────┼──────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G\u001b[38;2;177;185;249m__inet_pton_chk\u001b[39m │ 2.42  \u001b[30G │ the server and the TUI; nixpkgs' clang wrapper turns on \u001b[38;2;177;185;249m_FORTIFY_SOURCE\u001b[39m, which swaps │\u001b[K\r\u001b[2C\u001b[1B│\u001b[5G     \u001b[11G  \u001b[14G    \u001b[19G  │\u001b[23G     \u001b[31G│\u001b[34G\u001b[38;2;177;185;249minet_pton\u001b[44G\u001b[39mfor\u001b[48Gits\u001b[52Gchecked\u001b[60Gvariant\u001b[118G│\r\u001b[2C\u001b[1B└─────────────────┴─────────┴──────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything els\u001b[18G asks for 2.38 or older. So the floor of 2.43 is\u001b[67Gan accident of buil\u001b[87Ging against nixpkgs' current\u001b[K\r\u001b[2C\u001b[1Bglibc; nothing in the code needs\u001b[36Git.\r\u001b[9C\u001b[2B\u001b[1m1 (recommend\u001b[23Gd): keep building\u001b[41Gin devenv \u001b[52Gnd pin those three symbols.\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMath functions:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[46G\u001b[39mto\u001b[49Gtheir\u001b[55Golder\u001b[61Gsymbol\u001b[68Gversions\u001b[77Gwith\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operat\u001b[26Gons under an older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the one\u001b[30Gfile\u001b[35Gthat\u001b[40Gcalls\u001b[46Git\u001b[49Gwith\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck fails on anything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\r\u001b[2C\u001b[1B- \u001b[1mThe cost:\u001b[22m every nixpkgs bump may bring in another symbol. Th\u001b[66G check\u001b[73Gcatches it and\u001b[88Gyou add another pin, which is\u001b[118Ga\r\u001b[2C\u001b[1B  li\u001b[8Gtle fragile but cheap.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
