[1.032, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[39m to their older symbol versions with\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstd\u001b[76Gm what\u001b[83Gthe gate tests.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.083, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mOption 1 (recommended): keep building in devenv and pin those three symbols.\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[39m to their older symbol versions with\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B     \u001b[9G     \u001b[15G   \u001b[19G   \u001b[23G      \u001b[30G       \u001b[38G  \u001b[41G      \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.268, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mMath\u001b[10Gfuncti\u001b[17Gns:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[39m to their older symbol versions with\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbu\u001b[76Grs,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.063, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operations under\u001b[38G older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.   \u001b[23G  \u001b[26G   \u001b[30G   \u001b[34G      \u001b[41G  \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.042, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the \u001b[28Ge\u001b[30Gfil\u001b[34G that calls it with\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B     \u001b[9G  \u001b[12G       \u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.042, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gan\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.044, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck\u001b[36Gfails\u001b[42Gon\u001b[45Ganything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gmeasured one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe cost:\u001b[22m every\u001b[21Gnixpkgs\u001b[29Gbump\u001b[34Gmay\u001b[38Gbring\u001b[44Gin\u001b[47Ganother\u001b[55Gsymbol.\u001b[63GThe\u001b[67Gcheck\u001b[73Gcatches\u001b[81Git\u001b[84Gand\u001b[88Gyou\u001b[92Gadd\u001b[96Ganother\u001b[104Gpin,\u001b[109Gwhich\u001b[115Gis\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Glittle fragile but cheap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 2: build releases in an Ubuntu 24.04 container\u001b[22m,\u001b[58Gwith\u001b[63GClang\u001b[69G21\u001b[72Gfrom\u001b[77Gapt.llvm.org.\r\u001b[2C\u001b[1B- \u001b[1mRobust\u001b[12G\u001b[22m the floor holds by construction.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mA second toolchain:\u001b[22m it lives ou\u001b[37Gside devenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B \u001b[5Ghave to run there too.\u001b[28G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn older libstdc++:\u001b[22m Ubuntu\u001b[32G24.04\u001b[38Ghas\u001b[42GGCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may need fixes.\u001b[46G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead of libstdc++. That's too different\u001b[73Gfrom what\u001b[83Gthe gate tests.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer runs in R07. Nothing has changed y\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
