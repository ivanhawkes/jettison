[3.738, "o", "\u001b[?25l\u001b[H\r\u001b[9C\u001b[1B\u001b[1m1 (recommend\u001b[23Gd): keep building\u001b[41Gin devenv \u001b[52Gnd pin those three symbols.\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMath functions:\u001b[22m bind \u001b[38;2;177;185;249mremainder\u001b[39m and \u001b[38;2;177;185;249msqrtf\u001b[46G\u001b[39mto\u001b[49Gtheir\u001b[55Golder\u001b[61Gsymbol\u001b[68Gversions\u001b[77Gwith\u001b[82G\u001b[38;2;177;185;249m.symver\u001b[90G\u001b[39min\u001b[93Gone\u001b[97Gsmall\u001b[103Gheader.\u001b[111GThey're\r\u001b[2C\u001b[1B \u001b[5Gthe same IEEE operat\u001b[26Gons under an older name.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1minet_pton:\u001b[22m build the one\u001b[30Gfile\u001b[35Gthat\u001b[40Gcalls\u001b[46Git\u001b[49Gwith\u001b[54G\u001b[38;2;177;185;249m-U_FORTIFY_SOURCE\u001b[39m,\u001b[73Gor\u001b[76Gbind\u001b[81Git\u001b[84Gthe\u001b[88Gsame\u001b[93Gway.\u001b[98GYou\u001b[102Ggive\u001b[107Gup\u001b[110Gthe\u001b[114Gbounds\r\u001b[2C\u001b[1B \u001b[5Gcheck on that one call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe check:\u001b[22m R07's objdump\u001b[30Gcheck fails on anything\u001b[54Gnewer\u001b[60Gthan\u001b[65G2.39.\u001b[71GThat\u001b[76Gmakes\u001b[82G2.39\u001b[87Ga\u001b[89Gchosen\u001b[96Gfloor\u001b[102Grather\u001b[109Gthan\u001b[114Ga\r\u001b[4C\u001b[1Bmeasured\u001b[14Gone.\r\u001b[2C\u001b[1B- \u001b[1mThe cost:\u001b[22m every nixpkgs bump may bring in another symbol. Th\u001b[66G check\u001b[73Gcatches it and\u001b[88Gyou add another pin, which is\u001b[118Ga\r\u001b[2C\u001b[1B  li\u001b[8Gtle fragile but cheap.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mOp\u001b[6Gion\u001b[10G2: build releases in an Ubuntu 24.04 container\u001b[22m, with Clang 21 from apt.llvm.org.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mRobust:\u001b[22m \u001b[14Ghe floor\u001b[23Gholds\u001b[29Gby\u001b[32Gconstruction.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA second toolchain:\u001b[25G\u001b[22mit\u001b[28Glives\u001b[34Goutside\u001b[42Gdevenv,\u001b[50Grelease\u001b[58Gbinaries\u001b[67Gno\u001b[70Glonger\u001b[77Gcome\u001b[82Gfrom\u001b[87Gthe\u001b[91Ggated\u001b[97Gtoolchain,\u001b[108Gand\u001b[112Gthe\u001b[116Gtests\r\u001b[2C\u001b[1B  have\u001b[10Gto run\u001b[17Gthere too.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mAn older libstdc++:\u001b[22m Ubuntu 24.04\u001b[38Ghas GCC\u001b[46G13's,\u001b[52Gand\u001b[56Gthe\u001b[60Gcode\u001b[65Guses\u001b[70G\u001b[38;2;177;185;249mstd::format\u001b[82G\u001b[39mand\u001b[86Gother\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[4C\u001b[1BBuilding\u001b[14Gthem\u001b[19Gagainst\u001b[27Git\u001b[30Gmay\u001b[34Gneed\u001b[39Gfixes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[22m It's\u001b[56Gmade for exactly this. The cost is zig'\u001b[96G bundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't\u001b[9GClang\u001b[15G21,\u001b[19Gand\u001b[23Glibc++\u001b[30Ginstead\u001b[38Gof\u001b[41Glibstdc++.\u001b[52GThat's\u001b[59Gtoo\u001b[63Gdifferent\u001b[73Gfrom\u001b[78Gwhat\u001b[83Gthe\u001b[87Ggate\u001b[92Gtests.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
