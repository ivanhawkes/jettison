[0.003, "o", "\u001b[?25l\u001b[H\u001b[5Ghave\u001b[10Gto\u001b[13Grun\u001b[17Gthere\u001b[23Gtoo.\r\u001b[2C\u001b[1B- \u001b[1mAn older l\u001b[16Gbstdc++:\u001b[22m Ubuntu 24.04 has GCC 13's, and the code uses \u001b[38;2;177;185;249mstd::format\u001b[39m and \u001b[87Gther\u001b[92Gnewer\u001b[98GC++\u001b[102Gin\u001b[105Gabout\u001b[111G30\u001b[114Gfiles.\r\u001b[2C\u001b[1B \u001b[5GBuilding them against it may \u001b[35Geed fixes\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOption 3: \u001b[38;2;177;185;249mzig cc -target x86_64-linux-gnu.2.39\u001b[39m.\u001b[51G\u001b[22mIt's\u001b[56Gmade\u001b[61Gfor\u001b[65Gexactly\u001b[73Gthis.\u001b[79GThe\u001b[83Gcost\u001b[88Gis\u001b[91Gzig's\u001b[97Gbundled\u001b[105GLLVM,\u001b[111Gwhich\r\u001b[2C\u001b[1Bisn't Clang 21, and libc++ instead\u001b[38Gof libstdc++.\u001b[52GThat's to\u001b[62G diff\u001b[68Grent from what the gate\u001b[92Gt\u001b[94Gsts.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEither way:\u001b[15G\u001b[22mR07\u001b[19Ghas\u001b[23Gto\u001b[26Grun\u001b[30Gthe\u001b[34Gbundle\u001b[41Gin\u001b[44GUbuntu\u001b[51G24.04\u001b[57Gand\u001b[61Gtrixie\u001b[68Gcontainers,\u001b[80Gbecause\u001b[88Ga\u001b[90Gsymbol\u001b[97Gcheck\u001b[103Galone\u001b[109Gdoesn't\r\u001b[2C\u001b[1Bprove it starts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchoose\u001b[17Goption\u001b[24G1,\u001b[27GI'll\u001b[32Gchange\u001b[39GD-114\u001b[45Gand\u001b[49Gthe\u001b[53GR06\u001b[57Gsection\u001b[65Gto\u001b[68Gset\u001b[72Gthe\u001b[76Gfloor\u001b[82Gat\u001b[85G2.39\u001b[90Gand\u001b[94Gput\u001b[98Gthe\u001b[102Gpins\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1Bcontainer runs in R07.\u001b[26GNothing\u001b[34Ghas changed ye\u001b[49G.\u001b[51G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmeasured\u001b[14Gthe\u001b[18Gdynamically\u001b[30Glinked\u001b[37Grelease\u001b[45Gbuild.\u001b[52GI\u001b[54Ghaven't\u001b[62G