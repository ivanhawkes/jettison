[0.302, "o", "\u001b[?25l\u001b[H\u001b[3Gto the roadmap's del\u001b[24Gvery table,\u001b[37Go b\u001b[41G done before R07. Manifest has its own fixes for R07 too:\u001b[99Gthe TUI reads\u001b[113Ga\u001b[K\r\u001b[2C\u001b[1Bcontent path compiled into it and writes its\u001b[48Glog to \u001b[38;2;177;185;249m./b\u001b[59Gild/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFiles changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest:\u001b[15G\u001b[38;2;177;185;249mstage-5-recovery-plan.md\u001b[39m,\u001b[41G\u001b[38;2;177;185;249mdecision-ledger.md\u001b[39m,\u001b[61G\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m,\u001b[80G\u001b[38;2;177;185;249mhistory.md\u001b[39m,\u001b[92G\u001b[38;2;177;185;249msession-handoff.md\u001b[39m.\r\u001b[2C\u001b[1B- Jettison: \u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m,\u001b[32G\u001b[38;2;177;185;249mdocs/history.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[22m the ImGui split in Jettison. It's CMake\u001b[49Gtarget\u001b[56Gsurgery\u001b[64Gacross\u001b[71G\u001b[38;2;177;185;249mrender\u001b[39m,\u001b[79G\u001b[38;2;177;185;249mapp\u001b[83G\u001b[39mand\u001b[87G\u001b[38;2;177;185;249mdevtools\u001b[39m;\u001b[97GOpus\u001b[102Gat\u001b[105Gmedium\u001b[112Geffort\u001b[119Gis\r\u001b[2C\u001b[1Bsafe,\u001b[9Gand\u001b[13GSonnet\u001b[20Gcould\u001b[26Gdo\u001b[29Git\u001b[32Gbut\u001b[36Gis\u001b[39Gmore\u001b[44Glikely\u001b[51Gto\u001b[54Gmiss\u001b[59Ga\u001b[61Gtarget\u001b[68Gthat\u001b[73Glinks\u001b[79Gthe\u001b[83Gbackends.\u001b[93GThis\u001b[98Gis\u001b[101Ga\u001b[103Ggood\u001b[108Gpoint\u001b[114Gto\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m/compact\u001b[39m first.\u001b[19GShould I\u001b[28Gcomm\u001b[33Gt both repos' docs now?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI haven't checked which distros\u001b[35Gac\u001b[38Gually \u001b[45Ghip glibc 2.43\u001b[60Gor\u001b[63Gnewer,\u001b[70Gand\u001b[74GI\u00