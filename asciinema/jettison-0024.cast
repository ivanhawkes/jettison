9m\u001b[49m \u001b[3G  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 182 +\u001b[38;2;117;113;94m// directory when it holds anything; anything written is then removed again, the catalogue first.\u001b[38;2;248;248;242m     \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 183 +\u001b[38;2;248;248;242mJournal \u001b[38;2;166;226;46mRestore\u001b[38;2;253;151;31m(\u001b[38;2;248;248;242m                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 184 +\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::filesystem::path &backup, \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m WorldDirectory &directory, Identity running,           \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 185 +\u001b[38;2;248;248;242m    Jettison::Sim::SimWorld &world);                                                                  \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 186 \u001b[22m } \u001b[38;2;117;113;94m// namespace Manifest::Host\u001b[39m\u001b[K\r\u001b[20C\u001b[2B\u001b[38;2;153;153;153m4m 13s\u001b[28G· ↓\u001b[39m \u001b[38;2;153;153;153m20.5k\u001b[38Gtoken\u001b[44G)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
