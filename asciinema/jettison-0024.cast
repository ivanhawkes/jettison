[0.286, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gengine\u001b[14Gside\u001b[19Gis\u001b[22Gfinished\u001b[31Gand\u001b[35Gthe\u001b[39Ggate\u001b[44Gis\u001b[47Ggreen,\u001b[54Gbut\u001b[58Gnothing\u001b[66Gis\u001b[69Gcommitted.\u001b[80GManifest's\u001b[91Gpin\u001b[95Gbump\u001b[100Gneeds\u001b[106Gthe\u001b[110Gengine\r\u001b[1B \u001b[3Gcommit's ha\u001b[15Gh, and\u001b[22Gyou asked me\u001b[36Go commit only when you say so.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m:\u001b[37G\u001b[38;2;177;185;249mimgui\u001b[43G\u001b[39mnow\u001b[47Gholds\u001b[53Gonly\u001b[58GImGui's\u001b[66Gcore\u001b[71Gand\u001b[75Gits\u001b[79GFreeType\u001b[88Gfont\u001b[93Gcode,\u001b[99Gand\u001b[103Glinks\u001b[109Gonly\r\u001b[2C\u001b[1B \u001b[5GFreeType. A new \u001b[38;2;177;185;249mimgui_backends\u001b[39m target\u001b[43Gh\u001b[45Glds the\u001b[53GGLFW\u001b[58Gand Vulkan backends and links\u001b[88G\u001b[38;2;177;185;249mimgui\u001b[39m, \u001b[38;2;177;185;249mglfw\u001b[39m and \u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/engine/render/CM\u001b[29GkeLists.txt\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[49G\u001b[39mlinks \u001b[38;2;177;185;249mimgui_backends\u001b[39m \u001b[71Glongside \u001b[38;2;177;185;249mimgui\u001b[39m. It is the only code that calls the\r\u001b[2C\u001b[1B \u001b[5Gbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m); nothing else in the\u001b[55Gtree uses them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m,\u001b[75Gand\u001b[79Ga\u001b[81Gnew\u001b[85G\u001b[38;2;177;185;249mdevtools_alone\u001b[100G\u001b[39mtest:\u001b[106Ga\u001b[108Gsmall\u001b[114Gprogram\r\u001b[2C\u001b[1B \u001b[5Gthat links \u001b[38;2;177;185;249mDevto\u001b[22Gls\u001b[39m alone and draws a console in one ImGui frame with\u001b[75Gno rend\u001b[83Grer. Running, it\u001b[100Gchecks that no\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibvulkan\u001b[39m or \u001b[38;2;177;185;249mlibg\u001b[23Gfw\u001b[39m is lo\u001b[32Gded. The\u001b[41Gtest also\u001b[51Gfails if \u001b[38;2;177;185;249mreadelf\u001b[39m shows either in NEEDED, or shows no NEEDED e\u001b[113Gtries\u001b[119Gat\r\u001b[4C\u001b[1Ball.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mdocs/roadmap.md\u001b[39m:\u001b[22Gthe\u001b[26Gfinished\u001b[35Grow\u001b[39Gmoves\u001b[45Gout\u001b[49Gof\u001b[52Gthe\u001b[56Gtable,\u001b[63Gas\u001b[66Gearlier\u001b[74Gfinished\u001b[83Grows\u001b[88Gdid,\u001b[93Gand\u001b[97Gthe\u001b[101Gintro\u001b[107Gparagraph\u001b[117Gsays\r\u001b[2C\u001b[1B \u001b[5Gthe gap is provisioned. \u001b[38;2;177;185;249mdocs/history.md\u001b[45G\u001b[39mge\u001b[48Gs the delivery's table row.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEngin\u001b[11G:\u001b[13G\u001b[22mbefore\u001b[20Gthe\u001b[24Gchange,\u001b[32Gthe\u001b[36G\u001b[38;2;177;185;249mdevtools\u001b[45G\u001b[39msu\u001b[75G\u001b[38;2;177;185;249mn.so.1\u001b[39m.\u001b[83GNow\u001b[87G\u001b[38;2;177;185;249mdevtools_alone\u001b[102G\u001b[39mneeds\u001b[108Gonly\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.266, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gengine\u001b[14Gside\u001b[19Gis\u001b[22Gfinished\u001b[31Gand\u001b[35Gthe\u001b[39Ggate\u001b[44Gis\u001b[47Ggreen,\u001b[54Gbut\u001b[58Gnothing\u001b[66Gis\u001b[69Gcommitted.\u001b[80GManifest's\u001b[91Gpin\u001b[95Gbump\u001b[100Gneeds\u001b[106Gthe\u001b[110Gengine\r\u001b[1B \u001b[3Gcommit's ha\u001b[15Gh, and\u001b[22Gyou asked me\u001b[36Go commit only when you say so.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249msource/external/CMakeLists.txt\u001b[39m:\u001b[37G\u001b[38;2;177;185;249mimgui\u001b[43G\u001b[39mnow\u001b[47Gholds\u001b[53Gonly\u001b[58GImGui's\u001b[66Gcore\u001b[71Gand\u001b[75Gits\u001b[79GFreeType\u001b[88Gfont\u001b[93Gcode,\u001b[99Gand\u001b[103Glinks\u001b[109Gonly\r\u001b[2C\u001b[1B \u001b[5GFreeType. A new \u001b[38;2;177;185;249mimgui_backends\u001b[39m target\u001b[43Gh\u001b[45Glds the\u001b[53GGLFW\u001b[58Gand Vulkan backends and links\u001b[88G\u001b[38;2;177;185;249mimgui\u001b[39m, \u001b[38;2;177;185;249mglfw\u001b[39m and \u001b[38;2;177;185;249mVulkan::Vulkan\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/engine/render/CM\u001b[29GkeLists.txt\u001b[39m: \u001b[38;2;177;185;249mrender\u001b[49G\u001b[39mlinks \u001b[38;2;177;185;249mimgui_backends\u001b[39m \u001b[71Glongside \u001b[38;2;177;185;249mimgui\u001b[39m. It is the only code that calls the\r\u001b[2C\u001b[1B \u001b[5Gbackends (\u001b[38;2;177;185;249mImGuiRenderer.cpp\u001b[39m); nothing else in the\u001b[55Gtree uses them.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249msource/test/devtools_alone.cpp\u001b[39m, \u001b[38;2;177;185;249msource/test/CheckDevtoolsAlone.cmake\u001b[39m,\u001b[75Gand\u001b[79Ga\u001b[81Gnew\u001b