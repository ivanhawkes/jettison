[0.216, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[38;2;249;38;114mauto\u001b[38;2;248;248;242m partialOf = [&](::\u001b[38;2;166;226;46mpid_t\u001b[38;2;248;248;242m writer)                                                          \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242m{                   \u001b[35G  \u001b[38G                                                                            \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[16G\u001b[38;2;248;248;242mstd::filesystem::path\u001b[38Gpartial\u001b[46G=\u001b[48Gpath;\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242m  partial += std::format(\u001b[38;2;230;219;116m\"{}.{}.0\"\u001b[38;2;248;248;242m, kPartialSuffix,\u001b[66Gwriter);\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242m  std::ofstream{partial} << \u001b[38;2;230;219;116m\"left\"\u001b[38;2;248;248;242m;\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242m  \u001b[38;2;249;38;114mreturn\u001b[38;2;248;248;242m partial;                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;248;248;242m};                                                                                                  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[37Gpath abandoned =\u001b[54G\u001b[38;2;166;226;46mpartialOf\u001b[38;2;248;248;242m(gone);\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::filesystem::path running = \u001b[38;2;166;226;46mpartialOf\u001b[38;2;248;248;242m(::\u001b[38;2;166;226;46mgetpid\u001b[38;2;248;248;242m());\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gstd::filesystem::path\u001b[36Gother\u001b[42G=\u001b[44Gdirecto