[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe world belongs to the game, the screen to the shell.\r\u001b[2C\u001b[1B\u001b[22m- The shell stops adding pieces of its own to the world.\u001b[60GIt\u001b[63Gonly\u001b[68Greads\u001b[74Gthe\u001b[78Gworld's\u001b[86Gsnapshots\u001b[96Gand\u001b[100Gsends\u001b[106Gcommands,\u001b[116Gas\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5Gremote p\u001b[14Gayer woul\u001b[24G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSo th\u001b[12Gworld inside the\u001b[29Gclient\u001b[36Gis\u001b[39Gthe\u001b[43Gserver's\u001b[52Gworld,\u001b[59Gdown\u001b[64Gto\u001b[67Gthe\u001b[71Gbyte.\u001b[77GA\u001b[79Gsave\u001b[84Gmade\u001b[89Gin\u001b[92Gone\u001b[96Gloads\u001b[102Gin\u001b[105Gthe\u001b[109Gother,\u001b[116Gand\r\u001b[2C\u001b[1B \u001b[5Gthe s\u001b[11Grve\u001b[15G's\u001b[18Gdeterminism tests\u001b[36Gcover what the client plays.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GW\u001b[7Gat \u001b[11Gxists only for the\u001b[30Gscreen stays wi\u001b[46Gh the sh\u001b[55Gll: sounds\u001b[66Gfor\u001b[70Gevents,\u001b[78Gthe\u001b[82Gmods'\u001b[88Gscripts,\u001b[97Ginput\u001b[103Gand\u001b[107GUI.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for a game author:\r\u001b[2C\u001b[1B\u001b[22m- A game is two classes with separate\u001b[41Gjobs:\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[38;2;177;185;249mHost::Game\u001b[39m ho\u001b[21Gd\u001b[23G the rule\u001b[33G and \u001b[39Ghe world:\u001b[49Gits\u001b[53Gtypes,\u001b[60Gits\u001b[64Gcontent,\u001b[73Gits\u001b[77Gworld\u001b[83Gand\u001b[87Gits\u001b[91Gstarting\u001b[100Gstate.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mApp:\u001b[12GGame\u001b[39m holds the look and feel:\u001b[42Ginput,\u001b[49Gscenes, UI, sounds, pick\u001b[74Gng\u001b[77Gand saves.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe shell's\u001b[17Gown copi\u001b[26Gs \u001b[29Gf world start-u\u001b[45G (\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m, \u001b[38;2;177;185;249mDefine\u001b[39m, the world handle\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249mRegister\u001b[39m)\u001b[102Gare\u001b[106Gremoved.\r\u001b[4C\u001b[1BIf a game wants\u001b[21Gb\u001b[23Gd\u001b[28Gdra\u001b[32Gn and picked,\u001b[46Gi\u001b[76Gttaches physics\u001b[92Gitself. Manifest already\u001b[27;1H\u001b[21;105H\u001b[?25h"]
