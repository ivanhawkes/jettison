1B\u001b[1mIt doesn't solv\u001b[21G version\u001b[30Gskew.\u001b[22m The\u001b[40Gclient and server still\u001b[64Ghave\u001b[69Gto\u001b[72Gagree\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[2C\u001b[1B \u001b[5Gcheck at connection time whichever\u001b[40Gway the files are\u001b[58Gla\u001b[61Gd out.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22G\u001b[22mkeep\u001b[27Gone\u001b[31Gpackage\u001b[39Gper\u001b[43Gmod,\u001b[48Gand\u001b[52Gsplit\u001b[58Gby\u001b[61Gdirectory\u001b[71Ginside\u001b[78Git,\u001b[82Gwhich\u001b[88Gmostly\u001b[95Gexists\u001b[102Galready:\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mdefs/\u001b[39m and \u001b[38;2;177;185;249mscripts/\u001b[39m are the world's.  \u001b[43G    \u001b[75G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
