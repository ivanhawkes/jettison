[0.191, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;117;113;94mfile it\u001b[38;2;248;248;242m                                                                                                \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 32 \u001b[22m \u001b[38;2;117;113;94m// replaces takes them. Creates the file's directory if it is missing, as CreateDirectoriesDurably\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 33 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// does. Throws std::runtime_error naming the path and what failed, with the partial file removed and\r\u001b[1B\u001b[39m     \u001b[2m 34 \u001b[22m \u001b[38;2;117;113;94m// any old file as it was.\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lan\u001b[34G-b/source/engine/core/include/jet\u001b[68Gison/core/Fi\u001b[81Ge.h)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lin\u001b[18Gs, removed \u001b[1m4\u001b[22m lines\r\u001b[5C\u001b[1B\u001b[2m 54 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// that of two writers making the same file one leaves it whole and the other is refused, with no\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 55 \u001b[22m \u001b[38;2;117;113;94m// check between the two for a writer to come into. Throws FileExistsError naming the path when a file\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 56 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// is there, and any other failure as WriteFileDurably does; either way the partial file is removed and\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 57 -\u001b[38;2;248;248;242m// a file already there is as it was. The partial file is named for its writer                         \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 58 -\u001b[38;2;248;248;242m// (`<name>:partial.<process ID>.<count>`), since writers of the same file at once would otherwise     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 59 -\u001b[38;2;248;248;242m// write into one; a crash leaves it behind, to be removed by hand. Needs a file system that           \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 60 -\u001b[38;2;248;248;242m// supports the flag (ext4, xfs, btrfs and tmpfs do), or it throws for the file system.                \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 57 +\u001b[38;2;117;113;94m// a file already there is as it was. Needs a file system that supports the flag (ext4, xfs, btrfs and\u001b[38;2;248;248;242m \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 58 +\u001b[38;2;117;113;94m// tmpfs do), or it throws for the file system.\u001b[38;2;248;248;242m                                                        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 59 \u001b[11G\u001b[22m\u001b[38;2;166;226;46mvoid\u001b[16GWriteNewFileDurably\u001b[38;2;253;151;31m(\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 60 \u001b[11G\u001b[22m    \u001b[38;2;166;226;46mconst\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::filesyst\u001b[35Gm::path &path, \u001b[38;2;166;226;46mstd\u001b[39m::span<\u001b[38;2;166;226;46mconst\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::byte>\u001b[77Gbytes,\r\u001b[1B     \u001b[2m 61 \u001b[22m     \u001b[38;2;166;226;46mstd\u001b[39m::filesystem::perms permissions = kFilePermissions);\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;220;129;97mShenaniganing…\u001b[19G\u001b[38;2;153;153;153m1m 10s · ↓\u001b[39m \u001b[38;2;153;153;153m4.4k tok\u001b[39Gns)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle)\u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
