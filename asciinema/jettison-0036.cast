[0.354, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1BThen\u001b[8Gadd\u001b[12Gthree\u001b[18Gsmall\u001b[24Gthings:\r\u001b[2C\u001b[1B1. \u001b[1mA server pack.\u001b[22m The packer\u001b[32Gleaves\u001b[39Gout\u001b[43Gthe\u001b[47Gpresentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b[108Gso\u001b[111Gthe\u001b[115Gserver\r\u001b[2C\u001b[1B  \u001b[6Ggets the size ben\u001b[24Gfit without a second tree.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA \u001b[38;2;177;185;249mside: client\u001b[39m flag in \u001b[38;2;177;185;249mmod.yaml\u001b[38G\u001b[22m\u001b[39mfor purely cosmetic\u001b[58Gmods.\u001b[64GServers\u001b[72Gignore\u001b[79Gthose\u001b[85Gmods,\u001b[91Gand\u001b[95Gclients\u001b[103Gneedn't\u001b[111Gmatch\u001b[117Gon\r\u001b[2C\u001b[1B  \u001b[6Gthem.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA content handshake.\u001b[27G\u001b[22mOn\u001b[30Gconnect,\u001b[39Gthe\u001b[43Gserver\u001b[50Gsends\u001b[56Gits\u001b[60Gpackage\u001b[68Glist\u001b[73Gand\u001b[77Ga\u001b[79Ghash\u001b[84Gof\u001b[87Gits\u001b[91Gworld\u001b[97Gcontent.\u001b[106GThe\u001b[110Gclient\r\u001b[2C\u001b[1B  \u001b[6Gconfirms it has the same definitions\u001b[43Gto draw with, or\u001b[60Gs\u001b[62Gys which mod \u001b[76Giffer\u001b[82G.\u001b[84G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat\u001b[8Gfits\u001b[13Ghow\u001b[17Ga\u001b[19Gsession\u001b[27Galready\u001b[35Greads\u001b[41Gthe\u001b[45Gworld:\u001b[52Gdefinitions\u001b[64Gthrough\u001b[72G\u001b[38;2;177;185;249mDefinitionRegistry\u001b[39m,\u001b[92Gart\u001b[96Gthrough\u001b[104Gthe\u001b[108Gshell's\u001b[116Gown\r\u001b[2C\u001b[1Bfile\u001b[8Gsystem. None of it\u001b[27Gneeds doing before L15. Th\u001b[54G handshake belongs with L15's remote play.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne consequence for J30:\u001b[28G\u001b[22mmods'\u001b[34Gscripts\u001b[42Gsend\u001b[47Gcommands\u001b[56G(traders'\u001b[66GAI\u001b[69Ginputs),\u001b[78Gso\u001b[81Gby\u001b[84Gyour\u001b[89Grule\u001b[94Gthey\u001b[99Gbelong\u001b[106Gon\u001b[109Gthe\u001b[113Gserver,\r\u001b[2C\u001b[1Bnot the client. J30 leaves them in the\u001b[43Ghell, where they w\u001b[63Ge,\u001b[66Gand the docs record it\u001b[89Gas a\u001b[94Glimit. I'd add\u001b[109Gmoving\u001b[K\r\u001b[2C\u001b[1Bscripts\u001b[11Ginto \u001b[17Ghe session as a backlog item rather than wid\u001b[62Gn J30. Tell\u001b[74Gme if you'\u001b[86Grather it went\u001b[101Ginto J30.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCarrying\u001b[12Gon:\u001b[16Groadmap\u001b[24Gand\u001b[28Ghistory,\u001b[37Gformatting,\u001b[49Gtidy,\u001b[55Gthen\u001b[60Gthe\u001b[64Ggate.\r\u001b[2C\u001b[1B        \u001b[12G   \u001b[16G       \u001b[24G   \u001b[28G        \u001b[37G          \u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.121, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B1. \u001b[1mA server pack.\u001b[22m The packer\u001b[32Gleaves\u001b[39Gout\u001b[43Gthe\u001b[47Gpresentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b[108Gso\u001b[111Gthe\u001b[115Gserver\r\u001b[2C\u001b[1B  \u001b[6Ggets the size ben\u001b[24Gfit without a second tree.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA \u001b[38;2;177;185;249mside: client\u001b[39m flag in \u001b[38;2;177;185;249mmod.yaml\u001b[38G\u001b[22m\u001b[39mfor purely cosmetic\u001b[58Gmods.\u001b[64GServers\u001b[72Gignore\u001b[79Gthose\u001b[85Gmods,\u001b[91Gand\u001b[95Gclients\u001b[103Gneedn't\u001b[111Gmatch\u001b[117Gon\r\u001b[2C\u001b[1B  \u001b[6Gthem.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA content handshake.\u001b[27G\u001b[22mOn\u001b[30Gconnect,\u001b[39Gthe\u001b[43Gserver\u001b[50Gsends\u001b[56Gits\u001b[60Gpackage\u001b[68Glist\u001b[73Gand\u001b[77Ga\u001b[79Ghash\u001b[84Gof\u001b[87Gits\u001b[91Gworld\u001b[97Gcontent.\u001b[106GThe\u001b[110Gclient\r\u001b[2C\u001b[1B  \u001b[6Gconfirms it has the same definitions\u001b[43Gto draw with, or\u001b[60Gs\u001b[62Gys which mod \u001b[76Giffer\u001b[82G.\u001b[84G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat\u001b[8Gfits\u001b[13Ghow\u001b[17Ga\u001b[19Gsession\u001b[27Galready\u001b[35Greads\u001b[41Gthe\u001b[45Gworld:\u001b[52Gdefinitions\u001b[64Gthrough\u001b[72G\u001b[38;2;177;185;249mDefinitionRegistry\u001b[39m,\u001b[92Gart\u001b[96Gthrough\u001b[104Gthe\u001b[108Gshell's\u001b[116Gown\r\u001b[2C\u001b[1Bfile\u001b[8Gsystem. None of it\u001b[27Gneeds doing before L15. Th\u001b[54G handshake belongs with L15's remote play.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne consequence for J30:\u001b[28G\u001b[22mmods'\u001b[34Gscripts\u001b[42Gsend\u001b[47Gcommands\u001b[56G(traders'\u001b[66GAI\u001b[69Ginputs),\u001b[78Gso\u001b[81Gby\u001b