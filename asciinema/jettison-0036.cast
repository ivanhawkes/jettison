[0.018, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdefs/\u001b[39m and \u001b[38;2;177;185;249mscripts/\u001b[39m are the world's.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mscene/\u001b[39m,\u001b[13Gmodels,\u001b[21G\u001b[38;2;177;185;249mui/\u001b[39m,\u001b[26Gsounds\u001b[33Gand\u001b[37G\u001b[38;2;177;185;249mstrings/\u001b[46G\u001b[39mare\u001b[50Gpresentation's.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThen add three small things:\u001b[32G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA server pack.\u001b[22m Th\u001b[24G packer leaves out the presentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b[108Gso\u001b[111Gthe\u001b[115Gserver\r\u001b[2C\u001b[1B  \u001b[6Ggets the size benefit without a\u001b[38Gsecond tree.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA \u001b[38;2;177;185;249mside: client\u001b[39m flag in \u001b[38;2;177;185;249mmod.yaml\u001b[38G\u001b[22m\u001b[39mfor\u001b[42Gpurely\u001b[49Gcosmetic\u001b[58Gmods.\u001b[64GServers\u001b[72Gignore\u001b[79Gthose\u001b[85Gmods,\u001b[91Gand\u001b[95Gclients\u001b[103Gneedn't\u001b[111Gmatch\u001b[117Gon\r\u001b[2C\u001b[1B  \u001b[6Gthem.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA content handshake.\u001b[22m On connect, the\u001b[43Gserver sends its\u001b[60Gp\u001b[62Gckage list an\u001b[76G a ha\u001b[82Gh\u001b[84Gof\u001b[87Gits\u001b[91Gworld\u001b[97Gcontent.\u001b[106GThe\u001b[110Gclient\r\u001b[5C\u001b[1Bconfirms\u001b[15Git\u001b[18Ghas\u001b[22Gthe\u001b[26Gsame\u001b[31Gdefinitions\u001b[43Gto\u001b[46Gdraw\u001b[51Gwith,\u001b[57Gor\u001b[60Gsays\u001b[65Gwhich\u001b[71Gmod\u001b[75Gdiffers.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat\u001b[8Gfits how a session\u001b[27Galready reads the world: d\u001b[54Gfinitions through \u001b[38;2;177;185;249mDefinitionRegistry\u001b[39m, art through\u001b[104Gthe\u001b[108Gshell's\u001b[116Gown\r\