[0.123, "o", "\u001b[?25l\u001b[H\r\u001b[1B  \u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/p\u001b[14Gojects/manifest/docs/session-h\u001b[45Gndoff.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m3\u001b[22m line\u001b[36G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 20 \u001b[22m The user plays the first loop in the graphical client ([\u001b[38;2;230;219;116mL15\u001b[39m](delivery-order.md#l15)), not the\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 21 \u001b[22m terminal UI, which is mainly for administration (the user's, 2026-11-27). L15 stands on Jettison's\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 22 \u001b[22m [\u001b[38;2;230;219;116mJ30\u001b[39m](../../jettison/docs/roadmap.md#j30), started 2026-11-27, and on [\u001b[38;2;230;219;116mL04\u001b[39m](delivery-order.md#l04),\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m3\u001b[11G\u001b[38;2;248;248;242m[L05](delivery-order.md#l05) and [L29\u001b[52Gl\u001b[54Gvery\u001b[59Gor\u001b[62Ger.md#l29). The\u001b[78Gqueue's\u001b[86Gfirst\u001b[92Grow,\u001b[97Gthe\u001b[101Gdrives\u001b[108Gpast\u001b[48;2;92;2;0m t\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m    -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mhe torch ([W22](delivery-order.md#w22)), waits\u001b[48;2;61;1;0m                                                         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 24 -\u001b[38;2;248;248;242mfor the first larger hull. Saves still run on the\u001b[48;2;92;2;0m step's thread\u001b[48;2;61;1;0m                                        \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 25 -\u001b[38;2;248;248;242m([L40](delivery-order.md#l40), [D-115](decision-ledger.md#d-115)).                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 23 +\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mL05\u001b[38;2;248;248;242m](delivery-order.md#l05) and [\u001b[38;2;230;219;116mL29\u001b[38;2;248;248;242m](delivery-order.md#l29). The queue's first row, the drives past  \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 24 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mthe torch ([\u001b[38;2;230;219;116mW22\u001b[38;2;248;248;242m](delivery-order.md#w22)), waits \u001b[48;2;2;40;0mfor the first larger hull. Saves still run on the      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 25 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mstep's thread \u001b[48;2;2;40;0m([\u001b[38;2;230;219;116mL40\u001b[38;2;248;248;242m](delivery-order.md#l40), [\u001b[38;2;230;219;116mD-115\u001b[38;2;248;248;242m](decision-ledger.md#d-115)).                       \u001b[39m\u001b[49m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning ./scripts/lanes.sh\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ./scripts/la\u001b[21Ges.sh\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
