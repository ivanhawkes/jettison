[0.017, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/j\u001b[23Gttison.lane-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[22m lin\u001b[18Gs, \u001b[23Gmoved\u001b[29G\u001b[1m2\u001b[22m line\u001b[36G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m4.\u001b[15GThe\u001b[19Gdirectory\u001b[29Gis\u001b[32Gflushed,\u001b[41Gsince\u001b[47Gthe\u001b[51Grename\u001b[58Gis\u001b[61Gan\u001b[64Gentry\u001b[70Gin\u001b[73Gthe\u001b[77Gdirectory.\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 188 \u001b[22m A process's first write into a directory removes the partial files there that writers which no\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m89\u001b[12G\u001b[38;2;248;248;242mlong\u001b[17Gr run left, as a crash leaves them, and the\u001b[61Golder shared `<name>:partia\u001b[89G`; one named for a   \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 190 -\u001b[38;2;248;248;242mprocess that runs is another writer's, and kept. A crash's partial is an earlier process's, so one    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m89\u001b[12G\u001b[38;2;248;248;242mlonger run left, as a crash leaves them: files \u001b[60Gamed \u001b[66Gxactly so, n\u001b[79Gver another f\u001b[93Gle, and never\u001b[107Gthe\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m0\u001b[12G\u001b[38;2;248;248;242mfile the write is writing, whatever its n\u001b[54Gme. One named for a pr\u001b[77Gcess\u001b[82Gthat\u001b[87Gruns\u001b[92Gis\u001b[95Ganother\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 191 +\u001b[38;2;248;248;242mwriter's, and kept. A crash's partial is an earlier process's, so one                                 \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m2\u001b[12G\u001b[22mlook at a direct\u001b[29Gry a process is enough,\u001b[53Gand a\u001b[59Gwrite after i\u001b[74Gdoes not\u001b[83Glist\u001b[88Gthe\u001b[92Gdirectory\u001b[102Gagain.\u001b[109GA\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22mfailed\u001b[19Gwrite\u001b[25Gremoves\u001b[33Gits\u001b[37Gown\u001b[41Gpartial\u001b[49Gand\u001b[53Gnever\u001b[59Gone\u001b[63Git\u001b[66Gdid\u001b[70Gnot\u001b[74Gmake.\r\u001b[5C\u001b[1B\u001b[2m 194 \r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/jettison.lane-b' && clang…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '\u001b[13Ghome/ivan/projects/jetti\u001b[38Gon\u001b[41Glane-b' && clang-tidy -p build/clang-debug source/engine/core/src/File.cpp \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153msource/eng\u001b[19G/core/tests/FileTests.cpp source/engine/app/tests/GameTests.cpp source/engine/app/src/Application.cpp\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
