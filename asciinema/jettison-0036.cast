[0.149, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mAI should be handled by the server as only the server has the authority to make a lot of the decisions and changes an\r\u001b[2C\u001b[1BAI will run. It's possible we\u001b[34Glso need to ru\u001b[49G some on the client which can make \"request\u001b[93G\" against\u001b[107Gserver.\u001b[39m     \r\u001b[2C\u001b[1B                                                                                                \r\u001b[1B  \u001b[38;2;255;255;255mYou suggestions for the split are approved. One clarification, the server is handling physics, will the bake / cook \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mprocess bake out the collision meshes for models when those are available and the code is ready?\u001b[39m                      \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns \u001b[28G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCollision shap\u001b[18Gs\u001b[20Gwi\u001b[23Gl be baked by the cook into a\u001b[53Gworld-content file that\u001b[77Gboth\u001b[82Gclient\u001b[89Gand\u001b[93Gserver\u001b[100Gread,\u001b[106Gand\u001b[110GJ12\u001b[114Gwill\r\u001b[2C\u001b[1Bbake\u001b[8Gthe\u001b[12Gsame\u001b[17Gfile\u001b[22Gthrough\u001b[30Ga\u001b[32Gsmall\u001b[38Gtool\u001b[43Guntil\u001b[49Gthe\u001b[53Gcook\u001b[58Gexists.\u001b[66GI'm\u001b[70Gholding\u001b[78Goff\u001b[82Gon\u001b[85Gediting\u001b[93Glane\u001b[98GC\u001b[100Gwhile\u001b[106Gits\u001b[110Ggate\u001b[115Gruns,\r\u001b[1B \u001b[3Gand the\u001b[11Gapproved split goes onto the r\u001b[42Gadm\u001b[46Gp once\u001b[53Git\u001b[56Gpa\u001b[59Gses.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhat was something quick and unrelated we can do in a spare lane?\u001b[39m                        