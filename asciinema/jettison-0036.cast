[0.082, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m3.\u001b[15GIt\u001b[18Gis\u001b[21Grenamed\u001b[29Gover\u001b[34Gthe\u001b[38Gtarget.\r\u001b[5C\u001b[1B\u001b[2m 183 \u001b[22m 4. The directory is flushed, since the rename is an entry in the directory.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 184 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 185 -\u001b[38;2;248;248;242mThe partial file is made anew with the permissions the caller gives, 0644 unless told otherwise       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[12G\u001b[38;2;248;248;242mB\u001b[14Gfore\u001b[19Git writes, it r\u001b[35Gmoves the partial fil\u001b[57Gs of the same target that a writer which no longer       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 186 +\u001b[38;2;248;248;242mruns left, as a crash leaves them (one named for a process that runs is another writer's, and         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 187 +\u001b[38;2;248;248;242mkept). The partial file is made anew with the permissions the caller gives, 0644 unless told otherwise\r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m88\u001b[12G\u001b[22m(`Core::kFilePermi\u001b[31Gsions`), \u001b[41Go a file a\u001b[52Gg\u001b[54Gme k\u001b[59Geps\u001b[63Gprivate,\u001b[72Gsuch\u001b[77Gas\u001b[80Ga\u001b[82Gserver's\u001b[91Gsecret\u001b[98Gkey\u001b[102Gat\u001b[105G0600,\r\u001b[5C\u001b[1B\u001b[2m 189 \u001b[12G\u001b[22mis\u001b[15Gnever\u001b[21Gopen\u001b[26Gto\u001b[29Gothers\u001b[36Gon\u001b[39Gits\u001b[43Gway.\u001b[48GWhy\u001b[52Gboth\u001b[57Gflushes\u001b[65Gare\u001b[69Gneeded\u001b[76Gis\r\u001b[1B \u001b[3G   \u001b[2m 190 \u001b[22m [\u001b[38;2;230;219;116mdecided\u001b[39m](dec\u001b[27Gions.md#persi\u001b[41Gtence). O\u001b[51G failure\u001b[60Git\u001b[63Gthrows\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/docs/persistence.md)\u001b[58G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, rem\u001b[24Gv\u001b[26Gd \u001b[1m4\u001b[22m lines\u001b[36G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[13G\u001b[22mRENAME_NOR\u001b[24GPLACE` (Linux;\u001b[39Gthe one call is in \u001b[59Gcore/src/File.cpp`), so \u001b[84Ghere is no ch\u001b[98Gck f\u001b[103Gr another\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 197 \u001b[22m writer to come between: of two writers making the same file one leaves it whole and the other gets\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 198 \u001b[22m `Core::FileExistsError`, a `std::runtime_error` naming the path, with its partial file removed. A file\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m199\u001b[12G\u001b[38;2;248;248;242malready ther\u001b[26Gis as it was, a\u001b[42Gdirectory in\u001b[59Gway included. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mf\u001b[87Gle \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnamed\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfor\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mwriter\u001b[48;2;61;1;0m,\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m0\u001b[12G\u001b[38;2;248;248;242m`<name>:partial.<process\u001b[37GID>.<count>`, \u001b[52Gince\u001b[57Gtwo\u001b[61Gwriters of one file at once would\u001b[95Gotherwise wri\u001b[109Ge  \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 201 -\u001b[38;2;248;248;242minto the same partial and one could rename the other's half-written bytes into place. A crash leaves  \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 202 -\u001b[38;2;248;248;242mthat partial behind, and nothing re\u001b[76Gt support the flag (ext4, xfs, btrfs  \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
[0.031, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[22m lines,\u001b[23Gmov\u001b[29G\u001b[1m1\u001b[22m line\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m3\u001b[15GIt is \u001b[23Gnamed\u001b[29Gover the target.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22m4.\u001b[15GThe\u001b[19Gdirectory\u001b[29Gis\u001b[32Gflushed,\u001b[41Gsince\u001b[47Gthe\u001b[51Grename\u001b[58Gis\u001b[61Gan\u001b[64Gentry\u001b[70Gin\u001b[73Gthe\u001b[77Gdirectory.\r\u001b[5C\u001b[1B\u001b[2m 184 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 185 -\u001b[38;2;248;248;242mThe partial file is made anew with the permissions the caller gives, 0644 unless told otherwise       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[12G\u001b[38;2;248;248;242mBefore i\u001b[21G writes, it remo\u001b[44G partial files of the same\u001b[72Garget that a writ\u001b[93Gh\u001b[95Gch no lo\u001b[104Gger\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242mruns left,\u001b[23Gas a crash leaves them (one named for a proce\u001b[69Gs that runs\u001b[81Gis another writ\u001b[97Gr's, and         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 187 +\u001b[38;2;248;248;242mkept). The partial file is made anew with the permissions the caller gives, 0644 unless told otherwise\r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m8\u001b[12G\u001b[22m(`Core::kFilePermissions`), so\u001b[43Ga file a\u001b[52Ggame\u001b[57Gkeeps private, such as\u001b[80Ga\u001b[82Gserver's\u001b[91Gsecret\u001b[98Gkey\u001b[102Gat\u001b[105G0600,\r\u001b[7C\u001b[1B\u001b[2m89\u001b[12G\u001b[22mis never op\u001b[24Gn to others on \u001b[40Gts way. Why\u001b[52Gboth flushes are needed\u001b[76Gis\r\u001b[5C\u001b[1B\u001b[2m 190 \u001b[12G\u001b[22m[\u001b[38;2;230;219;116mdecided\u001b[39m](decisions.md#persistence).\u001b[49GOn\u001b[52Gfailure\u001b[60Git\u001b[63Gthrows\r\u00