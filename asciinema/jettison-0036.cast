[0.295, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mAgainst it:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe cl\u001b[12Gent needs much of the server's data too.\u001b[53G\u001b[22mIt\u001b[56Gneeds\u001b[62Gdefinitions\u001b[74Gto\u001b[77Gdisplay\u001b[85Gthings\u001b[92G(goods,\u001b[100Ghulls,\u001b[107Gvenues,\r\u001b[2C\u001b[1B \u001b[5Greasons put into words) and to run its quick pre-check. A stric\u001b[69G spli\u001b[75G forces ei\u001b[87Ger copies or\u001b[100Ga third \"shared\"\r\u001b[4C\u001b[1Bfolder,\u001b[13Gso three\u001b[22Gtree\u001b[27G instead\u001b[36Gof two.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne mod usually spans both sides.\u001b[39G\u001b[22mA new\u001b[45Gship\u001b[50Gis\u001b[53Ga\u001b[55Gdefinition\u001b[66G(server)\u001b[75Gplus\u001b[80Ga\u001b[82Gmodel\u001b[88Gand\u001b[92Gsounds\u001b[99G(client).\u001b[109GSplitting\u001b[119Gby\r\u001b[2C\u001b[1B \u001b[5Gfolder makes every mod author maintain two halves\u001b[55Gthat must agr\u001b[69Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlaying alone needs both halves\u001b[22m \u001b[39G one\u001b[44Gpr\u001b[47Gcess anyway.\u001b[60G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt doesn't solv\u001b[21G version\u001b[30Gskew.\u001b[22m The\u001b[40Gclient and server still\u001b[64Ghave\u001b[69Gto\u001b[72Gagree\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[2C\u001b[1B \u001b[5Gcheck at connection time whichever\u001b[40Gway the files are\u001b[58Gla\u001b[61Gd out.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22G\u001b[22mkeep\u001b[27Gone\u001b[31Gpackage\u001b[39Gper\u001b[43Gmod,\u001b[48Gand\u001b[52Gsplit\u001b[58Gby\u001b[61Gdirectory\u001b[71Ginside\u001b[78Git,\u001b[82Gwhich\u001b[88Gmostly\u001b[95Gexists\u001b[102Galready:\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mdefs/\u001b[39m and \u001b[38;2;177;185;249mscripts/\u001b[39m are the world's.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mscene/\u001b[39m, models, \u001b[38;2;177;185;249mui/\u001b[39m, sounds and \u001b[38;2;177;185;249mstrings/\u001b[46G\u001b[39mare\u001b[50Gpresentation's.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThen\u001b[8Gadd\u001b[12Gthree\u001b[18Gsmall\u001b[24Gthings:\r\u001b[2C\u001b[1B1. \u001b[1mA server pack.\u001b[22m The packer\u001b[32Gleaves\u001b[39Gout\u001b[43Gthe\u001b[47Gpresentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b[108Gso\u001b[111Gthe\u001b[115Gserver\r\u001b[2C\u001b[1B  \u001b[6Ggets the size ben\u001b[24Gfit without a second tr\u001b[75G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
