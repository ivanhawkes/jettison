anges,\u001b[37GI'll\u001b[42Gfix\u001b[46Gthem\u001b[51Gand\u001b[55Ggate\u001b[60Gagain.\u001b[67GWith\u001b[72Gno\u001b[75Grounds\u001b[82Gleft\u001b[87Gafter\u001b[93Git,\u001b[97Ganything\u001b[106Gstill\u001b[112Gopen\u001b[117Gis\r\u001b[2C\u001b[1Byou\u001b[7Gs to\u001b[12Gsettle.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 11m 55s · done 12:39 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mpush both\u001b[39m                                                                                                             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth\u001b[8Gare\u001b[12Gpushed:\u001b[20GJettison\u001b[29G\u001b[38;2;177;185;249m21c70c6..80aa60d\u001b[46G\u001b[39mand\u001b[50GManifest\u001b[59G\u001b[38;2;177;185;249mcbd2d99..15e18bc\u001b[39m.\u001b[77GRound\u001b[83G3\u001b[85Gof\u001b[88Gthe\u001b[92Gcross-review\u001b[105Gis\u001b[108Gstill\u001b[114Grunning\r\u001b[1B \u001b[3Gin lane B. Any fix\u001b[22Gs \u001b[25Gt asks for will go up \u001b[76Gown gate.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
