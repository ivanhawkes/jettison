[0.085, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m9\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 411 \u001b[22m     \u001b[38;2;166;226;46mCHECK_FALSE\u001b[39m(Reflect::\u001b[38;2;166;226;46mResolve\u001b[39m(name));\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 412 \u001b[22m   }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 413 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 414 -\u001b[38;2;248;248;242m  // The shell's own world is registered all the same.                                                \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m415\u001b[14G\u001b[38;2;248;248;242mCHECK\u001b[20GReflect::Re\u001b[32Golve(\"S\u001b[40Gm.Transform\"\u001b[53G);\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 414 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// The world is what the shell draws and picks with, physics alone: no component of the sample's,\u001b[38;2;248;248;242m   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 415 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// and no service but physics.\u001b[38;2;248;248;242m                                                                      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m416\u001b[14G\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::vector<std::string> components = world.\u001b[38;2;166;226;46mComponentNames\u001b[38;2;248;248;242m();                                 \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m417\u001b[14G\u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(std::ranges::\u001b[38;2;166;226;46mfind\u001b[38;2;248;248;242m(components, \u001b[38;2;230;219;116m\"Sim.Transform\"\u001b[38;2;248;248;242m) != components.\u001b[38;2;166;226;46mend\u001b[38;2;248;248;242m());                          \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m418\u001b[14G\u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m (\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::str\u001b[36G_view name : kSample)\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m419\u001b[14G\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(std::ranges::\u001b[38;2;166;226;46mfind\u001b[38;2;248;248;242m(components, name) == components.\u001b[38;2;166;226;46mend\u001b[38;2;248;248;242m());\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 420 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(world.\u001b[38;2;166;226;46mServiceNames\u001b[38;2;248;248;242m() == std::vector<std::string>{\u001b[38;2;230;219;116m\"physics\"\u001b[38;2;248;248;242m});                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 421 +\u001b[38;2;248;248;242m  App::ApplicationProbe::\u001b[38;2;166;226;46mShutdown\u001b[38;2;248;248;242m(shell);                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 422 +\u001b[38;2;248;248;242m  std::filesystem::\u001b[38;2;166;226;46mremove_all\u001b[38;2;248;248;242m(user, error);                                                           \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 423 \u001b[12G\u001b[22m}\r\u001b[1B \u001b[3G   \u001b[2m 424 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 425 \u001b[22m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m·\u001b[3G\u001b[38;2;223;134;102mCogitating…\u001b[16G\u001b[38;2;153;153;153m3m 12s ·\u001b[25G↓\u001b[39m \u001b[38;2;153;153;153m17.9k\u001b[33Gt\u001b[35Gkens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
