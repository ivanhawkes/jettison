[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[1msmaller\u001b[15Gserver.\u001b[22m A dedicated server ships without models, textures, sou\u001b[78Gds, UI\u001b[85Gor fonts, so\u001b[98Git starts faster and\u001b[K\r\u001b[4C\u001b[1Buses less memory.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mvisible trust boundary.\u001b[22m What the server reads d\u001b[55Gcides the\u001b[65Ggame.\u001b[71GA client-side mod c\u001b[91Gn only chang\u001b[104G looks. With an\r\u001b[4C\u001b[1Bauthoritati\u001b[18G server, nothing the client holds can change\u001b[63Gthe\u001b[67Grules\u001b[73Ganyway.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA clear rule for which mods must match.\u001b[45G\u001b[22mOnly\u001b[50Gserver\u001b[57Gcontent\u001b[65Gneeds\u001b[71Gto\u001b[74Gmatch\u001b[80Gbetween\u001b[88Gplayers;\u001b[97Ga\u001b[99Gcosmetic\u001b[108Gclient\u001b[115Gmod\r\u001b[2C\u001b[1B  needn't. Saves\u001b[20Gwould\u001b[26Grecord\u001b[33Gonly\u001b[38Gthe\u001b[42Gserver's\u001b[51Gmods.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAgainst it:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe client needs much of the server's data too.\u001b[53G\u001b[22mIt\u001b[56Gneeds\u001b[62Gdefinitions\u001b[74Gto\u001b[77Gdisplay\u001b[85Gthings\u001b[92G(goods,\u001b[100Ghulls,\u001b[107Gvenues,\r\u001b[2C\u001b[1B \u001b[5Greasons put into words) and to run its quick\u001b[50Gpre-ch\u001b[57Gck. A strict split forces either copies or a third \"shared\"\u001b[K\r\u001b[10C\u001b[1B, so thre\u001b[21G trees\u001b[28Ginstead of \u001b[40Gwo.\u001b[44G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mOne mod\u001b[13Gusually spans bot\u001b[31G sides.\u001b[22m A \u001b[43Gw ship is a definition\u001b[66G(server)\u001b[75Gplus\u001b[80Ga\u001b[82Gmodel\u001b[88Gand\u001b[92Gsounds\u001b[99G(client).\u001b[109GSplitting\u001b[119Gby\r\u001b[2C\u001b[1B \u001b[5Gfolder makes every mod author maintain two halv\u001b[53Gs that must \u001b[66Ggree.\u001b[72G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlaying alone needs both halves\u001b[22m in\u001b[40Gone\u001b[44Gprocess anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt doesn't solve version skew.\u001b[36G\u001b[22mThe\u001b[40Gclient\u001b[47Gand\u001b[51Gserver\u001b[58Gstill\u001b[64Ghave\u001b[69Gto\u001b[72Gagree\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[2C\u001b[1B  check at connection time whi\u001b[34Ghev\u001b[38Gr way the\u001b[48Gfile\u001b[53G are\u001b[58Glai\u001b[62G out.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G     \u001b[11G   \u001b[15G        \u001b[24G   \u001b[28G   \u001b[32G        \u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.061, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mFor\u001b[7Git:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA smaller server.\u001b[23G\u001b[22mA\u001b[25Gdedicated\u001b[35Gserver\u001b[42Gships\u001b[48Gwithout\u001b[56Gmodels,\u001b[64Gtextures,\u001b[74Gsounds,\u001b[82GUI\u001b[85Gor\u001b[88Gfonts,\u001b[95Gso\u001b[98Git\u001b[101Gstarts\u001b[108Gfaster\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Guses less memory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA visible trust boundary.\u001b[22m What the server reads decides the game. A\u001b[73Gclient-side\u001b[85Gmod\u001b[89Gcan\u001b[93Gonly\u001b[98Gchange\u001b[105Glooks.\u001b[112GWith\u001b[117Gan\r\u001b[2C\u001b[1B \u001b[5Gauthoritative server, nothing the client hold\u001b[51G can cha\u001b[60Gg\u001b[62G \u001b[64Ghe rules anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA clear rule for which mods must match.\u001b[22m Only server\u001b[57Gcontent\u001b[65Gneeds\u001b[71Gto\u001b[74Gmatch\u001b[80Gbetween\u001b[88Gplayers;\u001b[97Ga\u001b[99Gcosmetic\u001b[108Gclient\u001b[115Gmod\r\u001b[4C\u001b[1Bneedn't.\u001b[14GSaves\u001b[20Gwould\u001b[26Grecord\u001b[33Gonly\u001b[38Gthe\u001b[42Gserver's\u001b[51Gmods.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAgainst \u001b[12Gt:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe client needs much of the server's data too.\u001b[22m It needs defini\u001b[69Gions \u001b[75Go display \u001b[87Gings (goods,\u001b[100Ghulls, venues,\u001b[K\r\u001b[4C\u001b[1Breasons\u001b[13Gput into\u001b[22Gword\u001b[27G) and to\u001b[36Grun its\u001b[44Gquick\u001b[50Gpre-check.\u001b[61GA\u001b[63Gstrict\u001b[70Gsplit\u001b[76Gforces\u001b[83Geither\u001b[90Gcopies\u001b[97Gor\u001b[100Ga\u001b[102Gthird\u001b[108G\"shared\"\r\u001b[2C\u001b[1B \u001b[5Gfolder, so three trees instead of\u001b[39Gtwo.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne mod usually spans both sides.\u001b[22m A new ship is a\u001b[55Gdefinition (s\u001b[69Grver)\u001b[75Gplus\u001b[80Ga\u001b[82Gmodel\u001b[88Gand\u001b[92Gsounds\u001b[99G(client).\u001b[109GSplitting\u001b[119Gby\r\u001b[2C\u001b[1B \u001b[5Gfolder makes every mod author ma\u001b[39Gtain\u001b[44Gtw\u001b[47G halves that\u001b[60Gmust\u001b[65Gagree.\r\u001b[4C\u001b[1B\u001b[1mPlaying alone n\u001b[21Geds both\u001b[30Ghalves\u001b[22m in\u001b[40Gone process anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt doesn't solve version skew.\u001b[22m The\u001b[40Gclient and server\u001b[58Gst\u001b[61Gll have\u001b[69Gto\u001b[72Gagree\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[4C\u001b[1Bcheck\u001b[11Gat\u001b[14Gconnection\u001b[25Gtime\u001b[30Gwhichever\u001b[40Gway\u001b[44Gthe\u001b[27;1H\u001b[21;3H\u001b[?25h"]
