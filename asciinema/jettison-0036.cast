[0.012, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor it:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA\u001b[7Gsmaller server.\u001b[23G\u001b[22mA\u001b[25Gdedicated\u001b[35Gserver\u001b[42Gships\u001b[48Gwithout\u001b[56Gmodels,\u001b[64Gtextures,\u001b[74Gsounds,\u001b[82GUI\u001b[85Gor\u001b[88Gfonts,\u001b[95Gso\u001b[98Git\u001b[101Gstarts\u001b[108Gfaster\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Guses less memory.\u001b[23G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA visible trust boundary.\u001b[31G\u001b[22mWhat\u001b[36Gthe\u001b[40Gserver\u001b[47Greads\u001b[53Gdecides\u001b[61Gthe\u001b[65Ggame.\u001b[71GA\u001b[73Gclient-side\u001b[85Gmod\u001b[89Gcan\u001b[93Gonly\u001b[98Gchange\u001b[105Glooks.\u001b[112GWith\u001b[117Gan\r\u001b[2C\u001b[1B \u001b[5Gauthoritative server, nothing the client holds can change the rules\u001b[73Ganyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA clear rule for which mods must match.\u001b[22m Only \u001b[51Gerver co\u001b[60Gt\u001b[62Gn\u001b[64G needs to match between\u001b[88Gplayers;\u001b[97Ga\u001b[99Gcosmetic\u001b[108Gclient\u001b[115Gmod\r\u001b[2C\u001b[1B \u001b[5Gneedn't. Saves would record only the server's mods.\u001b[57G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAgainst it:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe cl\u001b[12Gent needs much of the server's data too.\u001b[53G\u001b[22mIt\u001b[56Gneeds\u001b[62Gdefinitions\u001b[74Gto\u001b[77Gdisplay\u001b[85Gthings\u001b[92G(goods,\u001b[100Ghulls,\u001b[107Gvenues,\r\u001b[2C\u001b[1B \u001b[5Greasons put into words) and to run its quick pre-check. A stric\u001b[69G spli\u001b[75G forces ei\u001b[87Ger copies or\u001b[100Ga third \"shared\"\r\u001b[4C\u001b[1Bfolder,\u001b[13Gso three\u001b[22Gtree\u001b[27G instead\u001b[36Gof two.\u001b[44G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne mod usually spans both sides.\u001b[39G\u001b[22mA new\u001b[45Gship\u001b[50Gis\u001b[53Ga\u001b[55Gdefinition\u001b[66G(server)\u001b[75Gplus\u001b[80Ga\u001b[82Gmodel\u001b[88Gand\u001b[92Gsounds\u001b[99G(client).\u001b[109GSplitting\u001b[119Gby\r\u001b[2C\u001b[1B \u001b[5Gfolder makes every mod author maintain two halves\u001b[55Gthat must agr\u001b[69Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlaying alone needs both halves\u001b[22m \u001b[39G one\u001b[44Gpr\u001b[47Gcess anyway.\u001b[60G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt doesn't solv\u001b[21G version\u001b[30Gskew.\u001b[22m The\u001b[40Gclient \u001b[75Gee\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\u001b[27;1H\u001b[21;3H\u001b[?25h"]
