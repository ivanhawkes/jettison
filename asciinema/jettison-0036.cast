[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m- Its graphical client (L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[4C\u001b[1BA client th\u001b[17Gt\u001b[19Gfa\u001b[22Gls to start say\u001b[39Gw\u001b[42Gre, as the server do\u001b[63Gs\u001b[65Gnow, for example\u001b[82G\"Start-up failed\u001b[99Gin\u001b[102Gth\u001b[105G co\u001b[109Gtent phase,\r\u001b[2C\u001b[1B \u001b[5Gat …/manifes\u001b[18G: …\".\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\r\u001b[2C\u001b[1B\u001b[22m- Files in the user's own directory\u001b[39Gno\u001b[42Glonger\u001b[49Goverride\u001b[58Gthe\u001b[62Ggame's\u001b[69Gdefinitions,\u001b[82Gonly\u001b[87Gits\u001b[91Gart\u001b[95Gand\u001b[99Gsound.\u001b[106GSaves\u001b[112Gare\r\u001b[2C\u001b[1B \u001b[5Gunaffected.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA mod built\u001b[17Gfor\u001b[21Ga\u001b[23Gnewer\u001b[29Gengine,\u001b[37Gor\u001b[40Gmissing\u001b[48Ga\u001b[50Gpackage\u001b[58Git\u001b[61Gneeds,\u001b[68Gmay\u001b[72Gnow\u001b[76Gstop\u001b[81Gthe\u001b[85Ggame\u001b[90Gfrom\u001b[95Gstarting\u001b[104Gwith\u001b[109Ga\u001b[111Gclear\r\u001b[2C\u001b[1B \u001b[5Gmessage \u001b[14Gnstead\u001b[21Gof loading a\u001b[34Gyway.\u001b[40GI'm checking whether\u001b[61Gth\u001b[64G \u001b[66Ghell already filt\u001b[84Grs such mod\u001b[96G; if it\u001b[104Gdoesn't, I'll\r\u001b[5C\u001b[1Bake the shell skip them with a warning rather than r\u001b[59Gfuse to start.\u001b[K\r\u001b[4C\u001b[1B    \u001b[10G   \u001b[14G     \u001b[20G    \u001b[25G    \u001b[30G    \u001b[35G \u001b[37G       \u001b[45G  \u001b[27;1H\u001b[21;3H\u001b[?25h"]
