[0.151, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GFiles\u001b[11Gin\u001b[14Gthe\u001b[18Guser's\u001b[25Gown\u001b[29Gdirectory\u001b[39Gno\u001b[42Glonger\u001b[49Goverride\u001b[58Gthe\u001b[62Ggame's\u001b[69Gdefinitions,\u001b[82Gonly\u001b[87Gits\u001b[91Gart\u001b[95Gand\u001b[99Gsound.\u001b[106GSaves\u001b[112Gare\r\u001b[2C\u001b[1B  unaffected.\u001b[K\r\u001b[4C\u001b[1BA mod\u001b[11Gbuilt for a newer\u001b[29Gengine, or missing a packag\u001b[58Git needs, may now stop the game from\u001b[95Gstarting with a clear\r\u001b[4C\u001b[1Bmessage instead\u001b[21Gof\u001b[24Gloading\u001b[32Ganyway.\u001b[40GI'm\u001b[44Gchecking\u001b[53Gwhether\u001b[61Gthe\u001b[65Gshell\u001b[71Galready\u001b[79Gfilters\u001b[87Gsuch\u001b[92Gmods;\u001b[98Gif\u001b[101Git\u001b[104Gdoesn't,\u001b[113GI'll\r\u001b[2C\u001b[1B \u001b[5Gmake the shell skip them with a\u001b[37Gwarn\u001b[42Gng rather th\u001b[55Gn refus\u001b[63G to st\u001b[70Grt.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\u001b[30G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gground\u001b[16Gsample's\u001b[25Grover\u001b[31Gbecomes\u001b[39Gpart\u001b[44Gof\u001b[47Gthe\u001b[51Gworld's\u001b[59Gstarting\u001b[68Gstate\u001b[74Ginstead\u001b[82Gof\u001b[85Gbeing\u001b[91Gmade\u001b[96Gwhen\u001b[101Gthe\u001b[105Gfirst\u001b[111Gscene\r\u001b[2C\u001b[1B  loads.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mrender_test\u001b[39m gets a small built-in\u001b[39Gwo\u001b[42Gld.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNeither\u001b[13Gshould\u001b[20Gchange\u001b[27Gany\u001b[31Greference\u001b[41Gframe\u001b[47Gor\u001b[50Gstate\u001b[56Ghash.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCosts and limits:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcontent\u001b[17Gis\u001b[20Gmounted\u001b[28Gtwice:\u001b[35Ga\u001b[37Gread-only\u001b[47Gcopy\u001b[52Gfor\u001b[56Gthe\u001b[60Gworld,\u001b[67Gand\u001b[71Gthe\u001b[75Gshell's\u001b[83Gcopy\u001b[88Gwith\u001b[93Gthe\u001b[97Gwritable\u001b[106Guser\u001b[111Gdirectory\r\u001b[2C\u001b[1B  on top for saves.\u001b[23GThat\u001b[28Gis\u001b[31Ga\u001b[33Gsmall\u001b[39Gstart-up\u001b[48Gcost.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
