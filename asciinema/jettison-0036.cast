[0.104, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, r\u001b[23Gmoved \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 186 \u001b[12G\u001b[22m4. Th\u001b[18G di\u001b[23Gctory\u001b[29Gis flu\u001b[36Ghed,\u001b[41Gsince\u001b[47Gthe\u001b[51Grename\u001b[58Gis\u001b[61Gan\u001b[64Gentry\u001b[70Gin\u001b[73Gthe\u001b[77Gdirectory.\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22mA\u001b[14Gprocess's\u001b[24Gfirst\u001b[30Gwrite\u001b[36Ginto\u001b[41Ga\u001b[43Gdirectory\u001b[53Gremoves\u001b[61Gthe\u001b[65Gpartial\u001b[73Gfiles\u001b[79Gthere\u001b[85Gthat\u001b[90Gwriters\u001b[98Gwhich\u001b[104Gno\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 189 -\u001b[38;2;248;248;242mlonger run left, as a crash leaves them, and the older shared `<name>:partial`; one named for a       \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m90\u001b[12G\u001b[38;2;248;248;242mproc\u001b[17Gss that runs is another writer's, and kept.\u001b[61GA crash's partial is an ear\u001b[89Gier process's, so one\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 189 +\u001b[38;2;248;248;242mlonger run left, as a crash leaves them: files named exactly so, never another file, and never the    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m90\u001b[12G\u001b[38;2;248;248;242mfile the write is writing, whatever its name. O\u001b[60Ge nam\u001b[66Gd for a proc\u001b[79Gss that runs \u001b[93Gs another    \u001b[107G   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;248;248;242mwriter's, and kept. A crash's partial is \u001b[54Gn earlier process's, s\u001b[77G one\u001b[82G    \u001b[87G    \u001b[92G  \u001b[95G       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 192 \u001b[22m look at a directory a process is enough, and a write after it does not list the directory again. A\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22mfailed write rem\u001b[29Gves its own partial and\u001b[53Gnever\u001b[59Gone it did no\u001b[74Gmake.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/jettison.lane-b'\u001b[52G&&\u001b[55G./scr…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/jettison.lane-b' && ./scripts/ci.sh --werror --asan --log build/gate.log (1m 0s · 10 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mlines)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
