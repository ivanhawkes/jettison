[0.003, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GNeither repo i\u001b[20G push\u001b[26Gd this time; s\u001b[41Gy if you\u001b[50Gwant both pushed now.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gtwo art-standards branches\u001b[36Gwere\u001b[41Galready\u001b[49Gcommitted\u001b[59Gwhen\u001b[64GI\u001b[66Glooked,\u001b[74Gso\u001b[77Gthere\u001b[83Gwas\u001b[87Gnothing\u001b[95Gin\u001b[98Geither\u001b[105Glane\u001b[110GB\u001b[112Gto\r\u001b[2C\u001b[1B \u001b[5Gcommit.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRound 2\u001b[22m confirmed\u001b[21Gall seven round-1\u001b[39Gfixes and fou\u001b[53Gd\u001b[55Gf\u001b[57Gur\u001b[60Gnew problems,\u001b[74Gall\u001b[78Gfixed\u001b[84Gin\u001b[87G\u001b[38;2;177;185;249m80aa60d\u001b[39m:\r\u001b[4C\u001b[1B\u001b[1mF8 (blocker):\u001b[22m the crash cleanup could d\u001b[45Glete unrelated files\u001b[66Gending in \u001b[38;2;177;185;249m:partial\u001b[39m, a\u001b[88Gd even\u001b[95Ga\u001b[99Gxisting targe\u001b[113G.\u001b[115GIt\u001b[118Gnow\r\u001b[4C\u001b[1Bdeletes\u001b[13Gonly\u001b[18Gnames\u001b[24Gin\u001b[27Gexactly\u001b[35Gits\u001b[39Gown\u001b[43Gform,\u001b[49Gfrom\u001b[54Gprocesses\u001b[64Gthat\u001b[69Ghave\u001b[74Gended,\u001b[81Gand\u001b[85Gnever\u001b[91Gthe\u001b[95Gfile\u001b[100Gbeing\u001b[106Gwritten.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9 (blocker):\u001b[19G\u001b[22mthe\u001b[23Glonger\u001b[30Gpartial\u001b[38Gname\u001b[43Gbroke\u001b[49Gfilenames\u001b[59Gnear\u001b[64Gthe\u001b[68G255-byte\u001b[77Glimit.\u001b[84GA\u001b[86Gpartial\u001b[94Gnow\u001b[98Ghas\u001b[102Ga\u001b[104Gshort\u001b[110Gname\u001b[115Gof\u001b[118Gits\r\u001b[2C\u001b[1B  own in the same\u001b[21Gdirectory, and a test writes a 255-byte name with both write functions.\u001b[K\r\u001b[5C\u001b[1B\u001b[1m10 (blocker):\u001b[22m a settings file with \u001b[38;2;177;185;249mui:\u001b[39m s\u001b[48G to a plain\u001b[60Gva\u001b[63Gue\u001b[66Gma\u001b[69Ge start-up fail when\u0