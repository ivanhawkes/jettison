[0.017, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gdo\u001b[8Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIts\u001b[9Ggraphical\u001b[19Gclient\u001b[26G(L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[2C\u001b[1B- A client that fails to start\u001b[34Gsays\u001b[39Gwhere,\u001b[46Gas\u001b[49Gthe\u001b[53Gserver\u001b[60Gdoes\u001b[65Gnow,\u001b[70Gfor\u001b[74Gexample\u001b[82G\"Start-up\u001b[92Gfailed\u001b[99Gin\u001b[102Gthe\u001b[106Gcontent\u001b[114Gphase,\r\u001b[2C\u001b[1B \u001b[5Ga\u001b[7G …/m\u001b[12Gnifest: …\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GFiles\u001b[11Gin\u001b[14Gthe\u001b[18Guser's\u001b[25Gown\u001b[29Gdirectory\u001b[39Gno\u001b[42Glonger\u001b[49Goverride\u001b[58Gthe\u001b[62Ggame's\u001b[69Gdefinitions,\u001b[82Gonly\u001b[87Gits\u001b[91Gart\u001b[95Gand\u001b[99Gsound.\u001b[106GSaves\u001b[112Gare\r\u001b[2C\u001b[1B  unaffected.\u001b[K\r\u001b[4C\u001b[1BA mod\u001b[11Gbuilt for a newer\u001b[29Gengine, or missing a packag\u001b[58Git needs, may now stop the game from\u001b[95Gstarting with a clear\r\u001b[4C\u001b[1Bmessage instead\u001b[21Gof\u001b[24Gloading\u001b[32Ganyway.\u001b[40GI'm\u001b[44Gchecking\u001b[53Gwhether\u001b[61Gthe\u001b[65Gshell\u001b[71Galready\u001b[79Gfilters\u001b[87Gsuch\u001b[92Gmods;\u001b[98Gif\u001b[101Git\u001b[104Gdoesn't,\u001b[113GI'll\r\u001b[2C\u001b[1B \u001b[5Gmake the shell skip them with a\u001b[37Gwarn\u001b[42Gng rather th\u001b[55Gn refus\u001b[63G to st\u001b[70Grt.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\u001b[30G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gground\u001b[16Gsample's\u001b[25Grover\u001b[31Gbecomes\u001b[39Gpart\u001b[44Gof\u001b[47Gthe\u001b[51Gworld's\u001b[59Gstarting\u001b[68Gstate\u001b[74Ginstead\u001b[82Gof\u001b[85Gbeing\u001b[91Gmade\u001b[96Gwhen\u001b[101Gthe\u001b[105Gfirst\u001b[111Gscene\r\u001b[2C\u001b[1B  loads.\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.129, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m- Its graphical client (L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[4C\u001b[1BA client th\u001b[17Gt\u001b[19Gfa\u001b[22Gls to start say\u001b[39Gw\u001b[42Gre, as the server do\u001b[63Gs\u001b[65Gnow, for example\u001b[82G\"Start-up failed\u001b[99Gin\u001b[102Gth\u001b[105G co\u001b[109Gtent phase,\r\u001b[2C\u001b[1B \u001b[5Gat …/manifes\u001b[18G: …\".\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\r\u001b[2C\u001b[1B\u001b[22m- Files in the user's own directory\u001b[39Gno\u001b[42Glonger\u001b[49Goverride\u001b[58Gthe\u001b[62Ggame's\u001b[69Gdefinitions,\u001b[82Gonly\u001b[87Gits\u001b[91Gart\u001b[95Gand\u001b[99Gsound.\u001b[106GSaves\u001b[112Gare\r\u001b[2C\u001b[1B \u001b[5Gunaffected.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA mod built\u001b[17Gfor\u001b[21Ga\u001b[23Gnewer\u001b[29Gengine,\u001b[37Gor\u001b[40Gmissing\u001b[48Ga\u001b[50Gpackage\u001b[58Git\u001b[61Gneeds,\u001b[68Gmay\u001b[72Gnow\u001b[76Gstop\u001b[81Gthe\u001b[85Ggame\u001b[90Gfrom\u001b[95Gstarting\u001b[104Gwith\u001b[109Ga\u001b[111Gclear\r\u001b[2C\u001b[1B \u001b[5Gmessage \u001b[14Gnstead\u001b[21Gof loading a\u001b[34Gyway.\u001b[40GI'm checking whether\u001b[61Gth\u001b[64G \u001b[66Ghell already filt\u001b[84Grs such mod\u001b[96G; if it\u001b[104Gdoesn't, I'll\r\u001b[5C\u001b[1Bake the shell skip them with a warning rather than r\u001b[59Gfuse to start.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\r\u001b[2C\u001b[1B\u001b[22m- The ground sample's rover\u001b[31Gbecomes\u001b[39Gpart\u001b[44Gof\u001b[47Gthe\u001b[51Gworld's\u