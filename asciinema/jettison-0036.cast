[0.016, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m4\u001b[30G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 196 \u001b[22m `RENAME_NOREPLACE` (Linux; the one call is in\u001b[58G`core/src/File.cpp`),\u001b[80Gso\u001b[83Gthere\u001b[89Gis\u001b[92Gno\u001b[95Gcheck\u001b[101Gfor\u001b[105Ganother\r\u001b[1B     \u001b[2m 197 \u001b[12G\u001b[22mwriter to c\u001b[24Gm\u001b[26G between:\u001b[36Gof\u001b[39Gtwo\u001b[43Gwriters\u001b[51Gmaking\u001b[58Gthe\u001b[62Gsame\u001b[67Gfile\u001b[72Gone\u001b[76Gleaves\u001b[83Git\u001b[86Gwhole\u001b[92Gand\u001b[96Gthe\u001b[100Gother\u001b[106Ggets\r\u001b[8C\u001b[1B\u001b[2m8\u001b[13G\u001b[22mCore::File\u001b[24GxistsError`, a\u001b[39G`std::runtime_error\u001b[59G naming the path, with i\u001b[84Gs partial fil\u001b[98G rem\u001b[103Gved. A file\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 199 -\u001b[38;2;248;248;242malready there is as it was, a directory in the way included. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mfile \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnamed\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfor\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mwriter\u001b[48;2;61;1;0m,\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 200 -\u001b[38;2;248;248;242m`<name>:partial.<process ID>.<count>`, since two writers of one file at once would otherwise write    \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m201\u001b[12G\u001b[38;2;248;248;242minto the sam\u001b[26Gpartial and one\u001b[42Gcould rename\u001b[59Gother's half-written bytes \u001b[87Gnto place. A crash leaves  \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m2\u001b[12G\u001b[38;2;248;248;242mthat partial behind, and\u001b[37Gnothing remove\u001b[52G it.\u001b[57GThe\u001b[61Gfile system must support the flag\u001b[95G(ext4, xfs, b\u001b[109Grfs\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 199 +\u001b[38;2;248;248;242malready there is as it was, a directory in the way included. \u001b[48;2;4;71;0mThe\u001b[48;2;2;40;0m file \u001b[48;2;4;71;0msystem\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mmust\u001b[48;2;2;40;0m \u001b[48;2;4;71;0msupport\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mflag (ex\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mt4\u001b[48;2;2;40;0m,\u001b[48;2;4;71;0m xfs, btrfs\u001b[48;2;2;40;0m                                                                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 200 \u001b[22m and tmpfs do); on one that does not, the write throws naming the path and the reason.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 201 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22mA missing\u001b[23Girectory is m\u001b[37Gde by `C\u001b[46Gre::CreateDirect\u001b[63GriesDurably`,\u001b[77Gou\u001b[80Germost first, each\u001b[99Gone's\u001b[105Gparent\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe \u001b[38;2;177;185;249mcore\u001b[39m suite passes.\u001b[26GTidy,\u001b[32Gcommit,\u001b[40Gthen\u001b[45Gthe\u001b[49Ggate.\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWorking…\u001b[12G\u001b[K\u001b[27;1H\u001b[24;24H\u001b[?25h"]
