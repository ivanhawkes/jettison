[0.054, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bserver's\u001b[12Gsnapshots.\u001b[23GThat's\u001b[30GManifest's\u001b[41GL15\u001b[45Gwork,\u001b[51Gbuilt\u001b[57Gon\u001b[60Gthe\u001b[64Gsame\u001b[69Gseam.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSplitting assets and mods into client and server folders\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor\u001b[7Git:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA smaller server.\u001b[23G\u001b[22mA\u001b[25Gdedicated\u001b[35Gserver\u001b[42Gships\u001b[48Gwithout\u001b[56Gmodels,\u001b[64Gtextures,\u001b[74Gsounds,\u001b[82GUI\u001b[85Gor\u001b[88Gfonts,\u001b[95Gso\u001b[98Git\u001b[101Gstarts\u001b[108Gfaster\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Guses less memory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA visible trust boundary.\u001b[22m What the server reads decides the game. A\u001b[73Gclient-side\u001b[85Gmod\u001b[89Gcan\u001b[93Gonly\u001b[98Gchange\u001b[105Glooks.\u001b[112GWith\u001b[117Gan\r\u001b[2C\u001b[1B \u001b[5Gauthoritative server, nothing the client hold\u001b[51G can cha\u001b[60Gg\u001b[62G \u001b[64Ghe rules anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA clear rule for which mods must match.\u001b[22m Only server\u001b[57Gcontent\u001b[65Gneeds\u001b[71Gto\u001b[74Gmatch\u001b[80Gbetween\u001b[88Gplayers;\u001b[97Ga\u001b[99Gcosmetic\u001b[108Gclient\u001b[115Gmod\r\u001b[4C\u001b[1Bneedn't.\u001b[14GSaves\u001b[20Gwould\u001b[26Grecord\u001b[33Gonly\u001b[38Gthe\u001b[42Gserver's\u001b[51Gmods.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAgainst \u001b[12Gt:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe client needs much of the server's data too.\u001b[22m It needs defini\u001b[69Gions \u001b[75Go display \u001b[87Gings (goods,\u001b[100Ghulls, venues,\u001b[K\r\u001b[4C\u001b[1Breasons\u001b[13Gput into\u001b[22Gword\u001b[27G) and to\u001b[36Grun its\u001b[44Gquick\u001b[50Gpre-check.\u001b[61GA\u001b[63Gstrict\u001b[70Gsplit\u001b[76Gforces\u001b[83Geither\u001b[90Gcopies\u001b[97Gor\u001b[100Ga\u001b[102Gthird\u001b[108G\"shared\"\r\u001b[2C\u001b[1B \u001b[5Gfolder, so three trees instead of\u001b[39Gtwo.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne mod usually spans both sides.\u001b[22m A new sh\u001b[75Gplus\u001b[80Ga\u001b[82Gmodel\u001b[88Gand\u001b[92Gsounds\u001b[99G(client).\u001b[109GSplitting\u001b[119Gby\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.018, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bhosting your own world. A client connected to a\u001b[51Gremo\u001b[56Ge serv\u001b[63Gr shouldn't\u001b[75Grun\u001b[79Ga\u001b[81Gsession\u001b[89Gat\u001b[92Gall;\u001b[97Git\u001b[100Gshould\u001b[107Gmirror\u001b[114Gthe\r\u001b[2C\u001b[1Bserver's\u001b[12Gsnapshots.\u001b[23GThat's\u001b[30GManifest's\u001b[41GL15\u001b[45Gwork,\u001b[51Gbuilt\u001b[57Gon\u001b[60Gthe\u001b[64Gsame\u001b[69Gseam.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSplitting assets and mods into client and server folders\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor\u001b[7Git:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA smaller server.\u001b[23G\u001b[22mA\u001b[25Gdedicated\u001b[35Gserver\u001b[42Gships\u001b[48Gwithout\u001b[56Gmodels,\u001b[64Gtextures,\u001b[74Gsounds,\u001b[82GUI\u001b[85Gor\u001b[88Gfonts,\u001b[95Gso\u001b[98Git\u001b[101Gstarts\u001b[108Gfaster\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Guses less memory.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA visible trust boundary.\u001b[22m What the server reads decides the game. A\u001b[73Gclient-side\u001b[85Gmod\u001b[89Gcan\u001b[93Gonly\u001b[98Gchange\u001b[105Glooks.\u001b[112GWith\u001b[117Gan\r\u001b[2C\u001b[1B \u001b[5Gauthoritative server, nothing the client hold\u001b[51G can cha\u001b[60Gg\u001b[62G \u001b[64Ghe rules anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA clear rule for which mods must match.\u001b[22m Only server\u001b[57Gcontent\u001b[65Gneeds\u001b[71Gto\u001b[74Gmatch\u001b[80Gbetween\u001b[88Gplayers;\u001b[97Ga\u001b[99Gcosmetic\u001b[108Gclient\u001b[115Gmod\r\u001b[4C\u001b[1Bneedn't.\u001b[14GSaves\u001b[20Gwould\u001b[26Grecord\u001b[33Gonly\u001b[38Gthe\u001b[42Gserver's\u001b[51Gmods.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAgainst \u001b[12Gt:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe client needs much of the server's data too.\u001b[22m It needs defini\u001b[69Gions \u001b[75Go display \u001b[87Gings (goods,\u001b[100Ghulls, venues,\u001b[K\r\u001b[4C\u001b[1Breasons\u001b[13Gput into\u001b[22Gword\u001b[27G) and to\u001b[36Grun its\u001b[44Gquick\u001b[50Gpre-check.\u001b[61GA\u001b[63Gstrict\u001b[70Gsplit\u001b[76Gforces\u001b[83Geither\u001b[90Gcopies\u001b[97Gor\u001b[100Ga\u001b[102Gthird\u001b[108G\"shared\"\r\u001b[2C\u001b[1B \u001b[5Gfolder, so three trees instead of\u001b[39Gtwo. \u001b[45G  \u001b[75G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
