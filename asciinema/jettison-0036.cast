[0.033, "o", "\u001b[?25l\u001b[H\u001b[3G- The shell's own copies of world\u001b[37Gstart-up\u001b[46G(\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m,\u001b[64G\u001b[38;2;177;185;249mDefine\u001b[39m,\u001b[72Gthe\u001b[76Gworld\u001b[82Ghandle\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249mRegister\u001b[39m)\u001b[102Gare\u001b[106Gremoved.\r\u001b[4C\u001b[1BIf \u001b[9G game\u001b[15Gwants bodies drawn and picked, its\u001b[50Gworld\u001b[56Gregisters\u001b[66Gthem\u001b[71Gand\u001b[75Gattaches\u001b[84Gphysics\u001b[92Gitself.\u001b[100GManifest\u001b[109Galready\r\u001b[4C\u001b[1Bdoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\u001b[31G\u001b[22m\u001b[K\r\u001b[5C\u001b[1Bts gr\u001b[12Gphic\u001b[17Gl client (L15) reuses the \u001b[38;2;177;185;249mHost::Game\u001b[39m its serv\u001b[64G alr\u001b[69Gady uses, so there \u001b[89Gs no\u001b[94Ghing to keep in st\u001b[113Gp.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA client\u001b[14Gthat\u001b[19Gfails\u001b[25Gto\u001b[28Gstart\u001b[34Gsays\u001b[39Gwhere,\u001b[46Gas\u001b[49Gthe\u001b[53Gserver\u001b[60Gdoes\u001b[65Gnow,\u001b[70Gfor\u001b[74Gexample\u001b[82G\"Start-up\u001b[92Gfailed\u001b[99Gin\u001b[102Gthe\u001b[106Gcontent\u001b[114Gphase,\r\u001b[4C\u001b[1Bat\u001b[8G…/manifest:\u001b[20G…\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BFiles in\u001b[16Ge user'\u001b[25Gown di\u001b[32Gectory\u001b[39Gno longer\u001b[49Gov\u001b[52Grride the game's definitions,\u001b[82Gonly its art an\u001b[99Gsound.\u001b[106GSaves are\u001b[K\r\u001b[4C\u001b[1Bunaffected.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gmod\u001b[11Gbuilt\u001b[17Gfor\u001b[21Ga\u001b[23Gnewer\u001b[29Gengine,\u001b[37Gor\u001b[40Gmissing\u001b[48Ga\u001b[50Gpackage\u001b[58Git\u001b[61Gneeds,\u001b[68Gmay\u001b[72Gnow\u001b[76Gstop\u001b[81Gthe\u001b[85Ggame\u001b[90Gfrom\u001b[95Gstarting\u001b[104Gwith\u001b[109Ga\u001b[111Gclear\r\u001b[2C\u001b[1B  message instead of loading\u001b[32Ganyway.\u001b[40GI'm\u001b[44Gchecking\u001b[53Gwhether\u001b[61Gthe\u001b[65Gshell\u001b[71Galready\u001b[79Gfilters\u001b[87Gsuch\u001b[92Gmods;\u001b[98Gif\u001b[101Git\u001b[104Gdoesn't,\u001b[113GI'll\r\u001b[2C\u001b[1B \u001b[5Gmak\u001b[9G the\u001b[14Gs\u001b[17Gll skip\u001b[25Gthem with a warning rather than refuse to \u001b[68Gtart.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
