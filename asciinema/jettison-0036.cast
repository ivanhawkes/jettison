[0.062, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/core/include/jettison/core/File.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, r\u001b[23Gmoved \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 54 \u001b[22m \u001b[38;2;117;113;94m// that of two writers making the same file one leaves it whole and the other is refused, with no\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[14G\u001b[22m\u001b[38;2;117;113;94mc\u001b[16Geck be\u001b[24Geen th\u001b[31G two for a writer to come into. Throws Fi\u001b[74GExistsErr\u001b[84Gr nam\u001b[90Gng the path when a file\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m6\u001b[14G\u001b[22m\u001b[38;2;117;113;94mis ther\u001b[22G, and\u001b[28Gany\u001b[32Gother failu\u001b[44Ge as\u001b[49GWriteFileDurably does; either way the partial file is r\u001b[105Gmoved and\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 57 -\u001b[38;2;248;248;242m// a file already there is as it was. The partial file is named for its writer                         \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m8\u001b[14G\u001b[38;2;248;248;242m(`<name>:partial.<process ID>.<count>`), since\u001b[61Gwriter\u001b[69Gof the same file at once\u001b[94Gwould\u001b[100Gotherwise\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m9\u001b[14G\u001b[38;2;248;248;242mwrite into one; a c\u001b[34Gash leaves it behind, to be \u001b[63Gemoved by \u001b[74Gand. Needs a file system that      \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m60\u001b[14G\u001b[38;2;248;248;242msupports the flag\u001b[32G(ext4, xfs, btrfs and tmpfs do), \u001b[66Gr it throws for the file system.\u001b[99G    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 57 +\u001b[38;2;117;113;94m// a file already there is as it was. Needs a file system that supports the flag (ext4, xfs, btrfs and\u001b[38;2;248;248;242m \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;117;113;94mtmpfs do), or i\u001b[30G throw\u001b[38Gfor \u001b[43Ghe file sy\u001b[54Gtem.\u001b[38;2;248;248;242m                                                       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 59 \u001b[22m \u001b[38;2;166;226;46mvoid\u001b[39m \u001b[38;2;166;226;46mWriteNewFileDurably\u001b[38;2;253;151;31m(\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m60\u001b[11G\u001b[22m    \u001b[38;2;166;226;46mcons\u001b[20G\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::filesystem::path\u001b[43G&path,\u001b[50G\u001b[38;2;166;226;46mstd\u001b[39m::span<\u001b[38;2;166;226;46mconst\u001b[66Gstd\u001b[39m::byte>\u001b[77Gbytes,\r\u001b[7C\u001b[1B\u001b[2m1\u001b[15G\u001b[22m\u001b[38;2;166;226;46mstd\u001b[39m::filesystem::per\u001b[36Gs \u001b[39Germissions\u001b[50G= kFilePermissions);\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mEditing\u001b[11G~/projects/jettison.lane-b/docs/persistence.md\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~/projects/jettison.lane-b/docs/persistence.md)\u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
