han wid\u001b[62Gn J30. Tell\u001b[74Gme if you'\u001b[86Grather it went\u001b[101Ginto J30.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCarrying\u001b[12Gon:\u001b[16Groadmap\u001b[24Gand\u001b[28Ghistory,\u001b[37Gformatting,\u001b[49Gtidy,\u001b[55Gthen\u001b[60Gthe\u001b[64Ggate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/histo\u001b[27;1H\u001b[21;3H\u001b[?25h"]
