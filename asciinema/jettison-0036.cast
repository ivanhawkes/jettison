r\u001b[116Gthat\r\u001b[4C\u001b[1Bfile:\u001b[11Gany\u001b[15Gwhose\u001b[21Gprocess\u001b[29Ghas\u001b[33Gended,\u001b[40Gplus\u001b[45Gthe\u001b[49Gold\u001b[53Gshared\u001b[60G\u001b[38;2;177;185;249m<name>:partial\u001b[39m.\u001b[76GOne\u001b[80Gbelonging\u001b[90Gto\u001b[93Ga\u001b[95Gprocess\u001b[103Gthat's\u001b[110Gstill\r\u001b[1B \u001b[3G  running is left alone. The \u001b[38;2;177;185;249mcore\u001b[39m suite\u001b[43Ghas\u001b[47Ga\u001b[49Gnew\u001b[53Gtest\u001b[58Gfor\u001b[62Gthis.\u001b[68GThe\u001b[72Gtest\u001b[77Gthat\u001b[82Gmade\u001b[87Ga\u001b[89Gwrite\u001b[95Gfail\u001b[100Gnow\u001b[104Gdoes\u001b[109Git\u001b[112Gwith\u001b[117Gan\r\u001b[4C\u001b[1Bunwritable\u001b[16Gdirectory,\u001b[27Gbecause\u001b[35Gthe\u001b[39Gpartial's\u001b[49Gname\u001b[54Gcan\u001b[58Gno\u001b[61Glonger\u001b[68Gbe\u001b[71Gpredicted.\r\u001b[1B \u001b[3G- \u001b[1mThe gate\u001b[22m passed in 228 s, and \u001b[38;2;177;185;249mfeature-base\u001b[39m is pushed to \u001b[38;2;177;185;249m21c70c6\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mThe cross-review\u001b[22m covers \u001b[38;2;177;185;249mmain..feature-base\u001b[39m (the whole stack since J02–J09) and runs in \u001b[38;2;177;185;249mjettison.lane-b\u001b[39m on branch\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mstage-j30\u001b[39m.\u001b[16GIt\u001b[19Gtakes\u001b[25Gabout\u001b[31Gten\u001b[35Gminutes,\u001b[44Gwith\u001b[49Gno\u001b[52Gedits\u001b[58Gin\u001b[61Gthat\u001b[66Glane\u001b[71Gwhile\u001b[77Git\u001b[80Gruns.\u001b[86GThe\u001b[90Gbrief\u001b[96Gsets\u001b[101Gout\u001b[105G12\u001b[108Gclaims\u001b[115Gfor\r\u001b[4C\u001b[1BCodex\u001b[11Gto\u001b[14Gattack:\u001b[22GJ30's\u001b[28Gsingle\u001b[35Gsource\u001b[42Gof\u001b[45Gtr\u001b[76Gmes\u001b[80Gand\u001b[84Gmounts,\u001b[92Gthe\u001b[96Glocale\u001b[103Grule\u001b[108Gfor\u001b[112Gtest\u001b[27;1H\u001b[24;3H\u001b[?25h"]
