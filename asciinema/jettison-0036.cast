[0.361, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe idea: one world, started one way.\u001b[41G\u001b[22mToday\u001b[47Ga\u001b[49Ggame\u001b[54Gdescribes\u001b[64Gits\u001b[68Gworld\u001b[74Gtwice.\u001b[81GOnce\u001b[86Gis\u001b[89Gfor\u001b[93Gthe\u001b[97Gsession,\u001b[106Gwhich\u001b[112Gthe\r\u001b[2C\u001b[1Bserver, the tests and the TUI start thr\u001b[43Gugh. The oth\u001b[56Gr is for \u001b[66Ghe ren\u001b[73Gered shell, which builds it\u001b[101G \u001b[103Gwn\u001b[107Gorld. The\u001b[117Gtwo\r\u001b[2C\u001b[1Bcopi\u001b[8Gs can drif\u001b[19G apart. After\u001b[33GJ30 \u001b[38Ghe grap\u001b[46Gical client\u001b[61Ga serv\u001b[68Gr with a window:\u001b[85Git starts the game's\u001b[111G exactly\u001b[K\r\u001b[2C\u001b[1Bas the\u001b[10Gserve\u001b[16G does, then draws it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe world belongs to the game, the screen to the shell.\r\u001b[2C\u001b[1B\u001b[22m- The shell stops adding pieces of its own to the world.\u001b[60GIt\u001b[63Gonly\u001b[68Greads\u001b[74Gthe\u001b[78Gworld's\u001b[86Gsnapshots\u001b[96Gand\u001b[100Gsends\u001b[106Gcommands,\u001b[116Gas\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5Gremote p\u001b[14Gayer woul\u001b[24G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSo th\u001b[12Gworld inside the\u001b[29Gclient\u001b[36Gis\u001b[39Gthe\u001b[43Gserver's\u001b[52Gworld,\u001b[59Gdown\u001b[64Gto\u001b[67Gthe\u001b[71Gbyte.\u001b[77GA\u001b[79Gsave\u001b[84Gmade\u001b[89Gin\u001b[92Gone\u001b[96Gloads\u001b[102Gin\u001b[105Gthe\u001b[109Gother,\u001b[116Gand\r\u001b[2C\u001b[1B \u001b[5Gthe s\u001b[11Grve\u001b[15G's\u001b[18Gdeterminism tests\u001b[36Gcover what the client plays.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GW\u001b[7Gat \u001b[11Gxists only for the\u001b[30Gscreen stays wi\u001b[46Gh the sh\u001b[55Gll: sounds\u001b[66Gfor\u001b[70Gevents,\u001b[78Gthe\u001b[82Gmods'\u001b[88Gscripts,\u001b[97Ginput\u001b[103Gand\u001b[107GUI.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for a game author:\r\u001b[2C\u001b[1B\u001b[22m- A game is two classes with separate\u001b[41Gjobs:\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[38;2;177;185;249mHost::Game\u001b[39m ho\u001b[21Gd\u001b[23G the rule\u001b[33G and \u001b[39Ghe world:\u001b[49Gits\u001b[53Gtypes,\u001b[60Gits\u001b[64Gcontent,\u001b[73Gits\u001b[77Gworld\u001b[83Gand\u001b[87Gits\u001b[91Gstarting\u001b[100Gstate.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mApp:\u001b[12GGame\u001b[39m holds the look and feel:\u001b[42Ginput\u001b[75Gg\u001b[77Gand saves.\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
