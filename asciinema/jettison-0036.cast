[0.151, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GA\u001b[7Gclient\u001b[14Gthat\u001b[19Gfails\u001b[25Gto\u001b[28Gstart\u001b[34Gsays\u001b[39Gwhere,\u001b[46Gas\u001b[49Gthe\u001b[53Gserver\u001b[60Gdoes\u001b[65Gnow,\u001b[70Gfor\u001b[74Gexample\u001b[82G\"Start-up\u001b[92Gfailed\u001b[99Gin\u001b[102Gthe\u001b[106Gcontent\u001b[114Gphase,\r\u001b[2C\u001b[1B  at …/manifest: …\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFiles i\u001b[13G the user's\u001b[25Gown\u001b[29Gdirectory\u001b[39Gno\u001b[42Glonger\u001b[49Goverride\u001b[58Gthe\u001b[62Ggame's\u001b[69Gdefinitions,\u001b[82Gonly\u001b[87Gits\u001b[91Gart\u001b[95Gand\u001b[99Gsound.\u001b[106GSaves\u001b[112Gare\r\u001b[4C\u001b[1Bunaffected.\r\u001b[2C\u001b[1B- A mod built for a newer engine,\u001b[37Gor\u001b[40Gmissing\u001b[48Ga\u001b[50Gpackage\u001b[58Git\u001b[61Gneeds,\u001b[68Gmay\u001b[72Gnow\u001b[76Gstop\u001b[81Gthe\u001b[85Ggame\u001b[90Gfrom\u001b[95Gstarting\u001b[104Gwith\u001b[109Ga\u001b[111Gclear\r\u001b[2C\u001b[1B \u001b[5Gmessage instead of l\u001b[26Gading anywa\u001b[38G. I'm ch\u001b[47Gcking whether the shell already filters\u001b[87Gsuch mods; if it doesn't, I'll\r\u001b[4C\u001b[1Bmake the shell\u001b[20Gskip\u001b[25Gthem\u001b[30Gwith\u001b[35Ga\u001b[37Gwarning\u001b[45Grather\u001b[52Gthan\u001b[57Grefuse\u001b[64Gto\u001b[67Gstart.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe ground sample's\u001b[25Grover becomes part of \u001b[50G world's starting sta\u001b[72Ge\u001b[74Ginstead\u001b[82Gof\u001b[85Gbeing\u001b[91Gmade\u001b[96Gwhen\u001b[101Gthe\u001b[105Gfirst\u001b[111Gscene\r\u001b[4C\u001b[1Bloads.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mrender_test\u001b[39m gets a small\u001b[30Gbuilt-in\u001b[39Gworld.\r\u001b[4C\u001b[1BNeither should change any\u001b[31Gr\u001b[33Gfer\u001b[37Gnce frame\u001b[47Gor state hash.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCosts and limits:\u001b[22m\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
