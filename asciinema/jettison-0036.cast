0aa60d\u001b[39m:\r\u001b[2C\u001b[1B- \u001b[1mF8 (blocker):\u001b[22m the crash cleanup could delete unrelated\u001b[60Gfiles ending in \u001b[38;2;177;185;249m:partial\u001b[39m, and even an\u001b[98Gexisting\u001b[107Gtarget.\u001b[115GIt\u001b[118Gnow\r\u001b[2C\u001b[1B \u001b[5Gdeletes only nam\u001b[22Gs in exactly its own\u001b[43Gform, from processes that have ended, and never the\u001b[95Gfil\u001b[99G being writt\u001b[112Gn\u001b[115G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9 (blocker):\u001b[22m th\u001b[22G lo\u001b[26Gg\u001b[28Gr partial name\u001b[43Gbroke\u001b[50Gilenames near\u001b[66Ge 255-byte limit. A partial now has a sho\u001b[108Gt name\u001b[115Gof\u001b[118Gits\r\u001b[2C\u001b[1B \u001b[5Gown in the same directo\u001b[29Gy, and a\u001b[38Gtest\u001b[43Gw\u001b[45Git\u001b[48Gs a 255-byte name with both wr\u001b[79Gte functions.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF10 (blocker):\u001b[22m a settings file\u001b[36Gwi\u001b[39Gh \u001b[38;2;177;185;249mui:\u001b[39m set to\u001b[52Ga plain valu\u001b[66Gmade\u001b[71Gstart-up fail when the\u001b[94Glanguage\u001b[103Gwas\u001b[107Gsaved.\u001b[114GIt\u001b[117Gnow\r\u001b[2C\u001b[1B \u001b[5Gjust logs that\u001b[20Gthe language couldn't be\u001b[45Gk\u001b[47Gpt, and c\u001b[57Grries on\u001b[66Gin the chosen\u001b[80Gl\u001b[82Gnguag\u001b[88G.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF11 (minor):\u001b[22m \u001b[19Ghre\u001b[24Gstale code examples or comme\u001b[53Gts \u001b[57Gfter J30\u001b[66Gare correct\u001b[78Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Ground\u001b[12G3\u001b[14Gasks\u001b[19Gfor\u001b[23Gmore\u001b[28Gchanges,\u001b[37GI'll\u001b[42Gfix\u001b[46Gt\u001b[76Gounds\u001b[82Gleft\u001b[87Gafter\u001b[93Git,\u001b[97Ganything\u001b[106Gstill\u001b[112Gopen\u001b[117Gis\u001b[27;1H\u001b[24;3H\u001b[?25h"]
