[0.033, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GA start-up failure then reaches the run's report as a \u001b[38;2;177;185;249mHost::StartupError\u001b[39m naming its phase.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe world is the game's alone (choice 1):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe shell stops registering anything in the world itself. So a world the client starts is the same, component\u001b[115Gorder\r\u001b[4C\u001b[1Band hash included, as the one Manifest's server starts. Manifest's \u001b[38;2;177;185;249mTravel::Register\u001b[39m already attaches physics itself.\r\u001b[2C\u001b[1B-\u001b[5GThe shell wraps the game's \u001b[38;2;177;185;249mHost::Game\u001b[39m in a private one that adds only the shell's own content in the content phase:\r\u001b[4C\u001b[1Bthe\u001b[9Gscripts'\u001b[18Gdefinitions\u001b[30Gand\u001b[34Gthe\u001b[38Gevent\u001b[44Gsounds.\r\u001b[2C\u001b[1B- After the game's \u001b[38;2;177;185;249mRegisterWorld\u001b[39m, the wrapper finds the physics the game attached and shows\u001b[95G\u001b[38;2;177;185;249mBody\u001b[39m,\u001b[101G\u001b[38;2;177;185;249mOnRails\u001b[109G\u001b[39mand\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mLocalFrame\u001b[16G\u001b[39min\u001b[19Gthe\u001b[23Gsnapshots\u001b[33Gif\u001b[36Gthe\u001b[40Ggame\u001b[45Ghasn't\u001b[52Galready.\r\u001b[1B \u001b[3G- This needs a\u001b[18Gsmall add\u001b[28Gtion, \u001b[38;2;177;185;249mSimWorld::FindService(nam\u001b[60G)\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLifetimes:\u001b[14G\u001b[22mthe\u001b[18Gshell's\u001b[26Gown\u001b[30G\u001b[38;2;177;185;249mm_sim\u001b[36G\u001b[39mgoes.\u001b[42GThe\u001b[46Gstepper,\u001b[55Gpicker\u001b[62Gand\u001b[66Gscripts\u001b[74Gare\u001b[78Gbuilt\u001b[84Gafter\u001b[90Gthe\u001b[94Gsession\u001b[102Gstarts\u001b[109Gand\u001b[113Greleased\r\u001b[2C\u001b[1Bbefore it shuts down.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;177;185;249m\u001b[1mApp::Game\u001b[39m shrinks (choice 2):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m,\u001b[22G\u001b[38;2;177;185;249mDefine\u001b[29G\u001b[39mand\u001b[33G\u001b[38;2;177;185;249mShellWorld\u001b[44G\u001b[39mgo.\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249mRegister(Shell&)\u001b[39m k\u001b[24Geps\u001b[28Gonly the input a\u001b[45Gtions.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGround sample:\r\u001b[1B\u001b[22m \u001b[3G- \u001b[38;2;177;185;249mDefineGround\u001b[39m moves to its \u001b[38;2;177;185;249mHost::Game\u001b[39m's \u001b[38;2;177;185;249mRegisterWorld\u001b[39m,\u001b[59Gand\u001b[63G\u001b[38;2;177;185;249mMakeGround\u001b[74G\u001b[39mto\u001b[77G\u001b[38;2;177;185;249mCreateInitialState\u001b[39m.\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.140, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20BIt\u001b[8Gregisters\u001b[18Gin\u001b[21Gthe\u001b[25Gorder\u001b[31Gthe\u001b[35Gshell\u001b[41Gdoes\u001b[46Gnow,\u001b[51Gso\u001b[54Gno\u001b[57Gstate-hash\u001b[68Gpin\u001b[72Gshould\u001b[79Gmove.\u001b[85GIf\u001b[88Gone\u001b[92Gdoes,\u001b[98GI'll\u001b[103Gprove\u001b[109Gthe\u001b[113Gchange\u001b[27;1H\u001b[24;3H\u001b[?25h"]
