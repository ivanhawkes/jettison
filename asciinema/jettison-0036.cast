[0.391, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for a game author:\r\u001b[2C\u001b[1B\u001b[22m- A game is two classes with separate\u001b[41Gjobs:\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[38;2;177;185;249mHost::Game\u001b[39m ho\u001b[21Gd\u001b[23G the rule\u001b[33G and \u001b[39Ghe world:\u001b[49Gits\u001b[53Gtypes,\u001b[60Gits\u001b[64Gcontent,\u001b[73Gits\u001b[77Gworld\u001b[83Gand\u001b[87Gits\u001b[91Gstarting\u001b[100Gstate.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mApp:\u001b[12GGame\u001b[39m holds the look and feel:\u001b[42Ginput,\u001b[49Gscenes, UI, sounds, pick\u001b[74Gng\u001b[77Gand saves.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe shell's\u001b[17Gown copi\u001b[26Gs \u001b[29Gf world start-u\u001b[45G (\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m, \u001b[38;2;177;185;249mDefine\u001b[39m, the world handle\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249mRegister\u001b[39m)\u001b[102Gare\u001b[106Gremoved.\r\u001b[4C\u001b[1BIf a game wants\u001b[21Gb\u001b[23Gd\u001b[28Gdra\u001b[32Gn and picked,\u001b[46Gits world registers them and attaches physics\u001b[92Gitself. Manifest already\r\u001b[2C\u001b[1B \u001b[5Gdoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m- Its graphical client (L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[4C\u001b[1BA client th\u001b[17Gt\u001b[19Gfa\u001b[22Gls to start say\u001b[39Gw\u001b[42Gre, as the server do\u001b[63Gs\u001b[65Gnow, for example\u001b[82G\"Start-up failed\u001b[99Gin\u001b[102Gth\u001b[105G co\u001b[109Gtent phase,\r\u001b[2C\u001b[1B \u001b[5Gat …/manifes\u001b[18G: …\". \u001b[25G  \u001b[28G     \u001b[34G    \u001b[39G      \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.248, "o", "\u001b]0;◐ jettison-0036\u0007"]
[0.107, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat it means for a game author:\r\u001b[2C\u001b[1B\u001b[22m- A game is two classes with separate\u001b[41Gjobs:\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[38;2;177;185;249mHost::Game\u001b[39m ho\u001b[21Gd\u001b[23G the rule\u001b[33G and \u001b[39Ghe world:\u001b[49Gits\u001b[53Gtypes,\u001b[60Gits\u001b[64Gcontent,\u001b[73Gits\u001b[77Gworld\u001b[83Gand\u001b[87Gits\u001b[91Gstarting\u001b[100Gstate.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mApp:\u001b[12GGame\u001b[39m holds the look and feel:\u001b[42Ginput,\u001b[49Gscenes, UI, sounds, pick\u001b[74Gng\u001b[77Gand saves.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe shell's\u001b[17Gown copi\u001b[26Gs \u001b[29Gf world start-u\u001b[45G (\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m, \u001b[38;2;177;185;249mDefine\u001b[39m, the world handle\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249mRegister\u001b[39m)\u001b[102Gare\u001b[106Gremoved.\r\u001b[4C\u001b[1BIf a game wants\u001b[21Gb\u001b[23Gd\u001b[28Gdra\u001b[32Gn and picked,\u001b[46Gits world registers them and attaches physics\u001b[92Gitself. Manifest already\r\u001b[2C\u001b[1B \u001b[5Gdoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m- Its graphical client (L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[4C\u001b[1BA client th\u001b[17Gt\u001b[19Gfa\u001b[22Gls to start say\u001b[39Gw\u001b[42Gre, as the server do\u001b[63Gs\u001b[65Gnow, for example\u001b[82G\"Start-up failed\u001b[99Gin\u001b[102Gth\u001b[105G co\u001b[109Gtent phase,\r\u001b[2C\u001b[1B \u001b[5Gat …/manifes\u001b[18G: …\".\u001b[K\r\u001b[4C\u001b[1B  \u001b[8G           \u001b[20G   \u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.066, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- A game is two classes with separate\u001b[41Gjobs:\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[38;2;177;185;249mHost::Game\u001b[39m ho\u001b[21Gd\u001b[23G the rule\u001b[33G and \u001b[39Ghe world:\u001b[49Gits\u001b[53Gtypes,\u001b[60Gits\u001b[64Gcontent,\u001b[73Gits\u001b[77Gworld\u001b[83Gand\u001b[87Gits\u001b[91Gstarting\u001b[100Gstate.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mApp:\u001b[12GGame\u001b[39m holds the look and feel:\u001b[42Ginput,\u001b[49Gscenes, UI, sounds, pick\u001b[74Gng\u001b[77Gand saves.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe shell's\u001b[17Gown copi\u001b[26Gs \u001b[29Gf world start-u\u001b[45G (\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m, \u001b[38;2;177;185;249mDefine\u001b[39m, the world handle\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249mRegister\u001b[39m)\u001b[102Gare\u001b[106Gremoved.\r\u001b[4C\u001b[1BIf a game wants\u001b[21Gb\u001b[23Gd\u001b[28Gdra\u001b[32Gn and picked,\u001b[46Gits world registers them and attaches physics\u001b[92Gitself. Manifest already\r\u001b[2C\u001b[1B \u001b[5Gdoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m- Its graphical client (L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[4C\u001b[1BA client th\u001b[17Gt\u001b[19Gfa\u001b[22Gls to start say\u001b[39Gw\u001b[42Gre, as the server do\u001b[63Gs\u001b[65Gnow, for example\u001b[82G\"Start-up failed\u001b[99Gin\u001b[102Gth\u001b[105G co\u001b[109Gtent phase,\r\u001b[2C\u001b[1B \u001b[5Gat …/manifes\u001b[18G: …\".\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\u001b[22m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
