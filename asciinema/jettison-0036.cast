[0.218, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[2m 186 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 187 \u001b[14G\u001b[22m{\r\u001b[1B \u001b[3G   \u001b[2m 188 \u001b[22m     \u001b[38;2;117;113;94m// One a crash left is removed, not reused, since an open of a file there keeps its mode.\r\u001b[1B\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 189 -\u001b[38;2;248;248;242m    std::error_code stale;                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 190 -\u001b[38;2;248;248;242m    std::filesystem::remove(partial, stale);                                                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 189 +\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mRemoveAbandoned\u001b[38;2;248;248;242m(path, directory);                                                                 \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m90 \u001b[22m     Descriptor file{::\u001b[38;2;166;226;46mopen\u001b[39m(\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 191 \u001b[22m         partial.\u001b[38;2;166;226;46mc_str\u001b[39m(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC,\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 192 \u001b[22m         \u001b[38;2;166;226;46mstatic_cast\u001b[39m<\u001b[38;2;166;226;46mmode_t\u001b[39m>(permissions))};\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/sourc\u001b[43G/engine/core/include/jettison/core/File.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m4\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[6C\u001b[1B\u001b[2m 9\u001b[11G\u001b[22mnamespace Jettison::Core\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[11G\u001b[22m{\r\u001b[1B \u001b[3G  