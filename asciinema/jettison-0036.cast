[0.027, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gcommit.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRound 2\u001b[22m confirmed\u001b[21Gall\u001b[25Gseven\u001b[31Ground-1\u001b[39Gfixes\u001b[45Gand\u001b[49Gfound\u001b[55Gfour\u001b[60Gnew\u001b[64Gproblems,\u001b[74Gall\u001b[78Gfixed\u001b[84Gin\u001b[87G\u001b[38;2;177;185;249m80aa60d\u001b[39m:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF8 (blocker):\u001b[19G\u001b[22mthe\u001b[23Gcrash\u001b[29Gcleanup\u001b[37Gcould\u001b[43Gdelete\u001b[50Gunrelated\u001b[60Gfiles\u001b[66Gending\u001b[73Gin\u001b[76G\u001b[38;2;177;185;249m:partial\u001b[39m,\u001b[86Gand\u001b[90Geven\u001b[95Gan\u001b[98Gexisting\u001b[107Gtarget.\u001b[115GIt\u001b[118Gnow\r\u001b[2C\u001b[1B  deletes only names in exactly its\u001b[39Gown form,\u001b[50Grom pr\u001b[57Gcess\u001b[62Gs\u001b[64Gthat have\u001b[74Gended, and \u001b[86Gever the file\u001b[100Gbeing\u001b[106Gwritten.\r\u001b[5C\u001b[1B\u001b[1m9\u001b[23G\u001b[22mlonger partial name\u001b[43Gbroke filenames near th\u001b[67G 255-byte limit. A\u001b[86Gpartial now\u001b[98Ghas a short name\u001b[115Gof\u001b[118Gits\r\u001b[4C\u001b[1Bown in the same directory, and a test\u001b[43Gwrites a 255-byte name wit\u001b[70G both write functions.\u001b[K\r\u001b[5C\u001b[1B\u001b[1m10 (blocker):\u001b[22m a settings file with \u001b[38;2;177;185;249mui:\u001b[39m set\u001b[49Gto a plain v\u001b[62Glue made start-up fail when the\u001b[94Glangu\u001b[100Gge was saved. It now\u001b[K\r\u001b[4C\u001b[1Bjust logs th\u001b[18Gt the language couldn't be kept, and carries on\u001b[66Gin the c\u001b[75Gosen language.\u001b[K\r\u001b[6C\u001b[1B\u001b[1m1\u001b[10Gminor):\u001b[22m three s\u001b[26Gale code examples or comments \u001b[57Gfter J30\u001b[66Gare corrected.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf round 3 asks for more chang\u001b[34Gs, I'l\u001b[41G fix the\u001b[50G a\u001b[53Gd g\u001b[57Gte again. With no rounds\u001b[82Gleft\u001b[87Gafter\u001b[93Git,\u001b[97Ganything\u001b[106Gstill\u001b[112Gopen\u001b[117Gis\r\u001b[2C\u001b[1Byours\u001b[9Gto\u001b[12Gsettle.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 11m 55s · done 12:39 pm\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mpush both\u001b[39m                                                                                                             \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[39m Working…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRound 2\u001b[11G\u001b[22mconfirmed\u001b[21Gall\u001b[25Gseven\u001b[31Ground-1\u001b[39Gfixes\u001b[45Gand\u001b[49Gfound\u001b[55Gfour\u001b[60Gnew\u001b[64Gproblems,\u001b[74Gall\u001b[78Gfixed\u001b[84Gin\u001b[87G\u001b[38;2;177;185;249m80aa60d\u001b[39m:\r\u001b[2C\u001b[1B- \u001b[1mF8 (blocker):\u001b[22m the crash cleanup could delete unrelated\u001b[60Gfiles ending in \u001b[38;2;177;185;249m:partial\u001b[39m, and even an\u001b[98Gexisting\u001b[107Gtarget.\u001b[115GIt\u001b[118Gnow\r\u001b[2C\u001b[1B \u001b[5Gdeletes only nam\u001b[22Gs in exactly its own\u001b[43Gform, from processes that have ended, and never the\u001b[95Gfil\u001b[99G being writt\u001b[112Gn\u001b[115G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9 (blocker):\u001b[22m th\u001b[22G lo\u001b[26Gg\u001b[28Gr partial name\u001b[43Gbroke\u001b[50Gilenames near\u001b[66Ge 255-byte limit. A partial now has a sho\u001b[108Gt name\u001b[115Gof\u001b[118Gits\r\u001b[2C\u001b[1B \u001b[5Gown in the same directo\u001b[29Gy, and a\u001b[38Gtest\u001b[43Gw\u001b[45Git\u001b[48Gs a 255-byte name with both wr\u001b[79Gte functions.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF10 (blocker):\u001b[22m a settings file\u001b[36Gwi\u001b[39Gh \u001b[38;2;177;185;249mui:\u001b[39m set to\u001b[52Ga plain valu\u001b[66Gmade\u001b[71Gstart-up fail when the\u001b[94Glanguage\u001b[103Gwas\u001b[107Gsaved.\u001b[114GIt\u001b[117Gnow\r\u001b[2C\u001b[1B \u001b[5Gjust logs that\u001b[20Gthe language couldn't be\u001b[45Gk\u001b[47Gpt, and c\u001b[57Grries on\u001b[66Gin the chosen\u001b[80Gl\u001b[82Gnguag\u001b[88G.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF11 (minor):\u001b[22m \u001b[19Ghre\u001b[24Gstale code examples or comme\u001b[53Gts \u001b[57Gfter J30\u001b[66Gare correct\u001b[78Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Ground\u001b[12G3\u001b[14Gasks\u001b[19Gfor\u001b[23G