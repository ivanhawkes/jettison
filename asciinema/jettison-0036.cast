[0.879, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCross-review\u001b[16Ground\u001b[22G1\u001b[24Gasked\u001b[30Gfor\u001b[34Gchanges.\u001b[43GAll\u001b[47Gseven\u001b[53Gfindings\u001b[62Gare\u001b[66Gfixed\u001b[72Gin\u001b[75G\u001b[38;2;177;185;249m84cd814\u001b[39m,\u001b[84Gthe\u001b[88Ggate\u001b[93Gpassed\u001b[100Gon\u001b[103Git,\u001b[107Gand\u001b[111Ground\u001b[117G2\u001b[119Gis\r\u001b[1B \u001b[3Gnow running in lane B. It takes about ten minut\u001b[51Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat round 1 found and what changed:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mMod names\u001b[16G(blocker).\u001b[22m A mod called\u001b[40G\u001b[38;2;177;185;249mengine\u001b[47G\u001b[39mor\u001b[50G\u001b[38;2;177;185;249mbase\u001b[55G\u001b[39mwould\u001b[61Ghave\u001b[66Gclashed\u001b[74Gwith\u001b[79Gthe\u001b[83Gshell's\u001b[91Gown\u001b[95Gmount\u001b[101Gnames\u001b[107Ginside\u001b[114Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsession and stopped the game starting. Such\u001b[50Ga mod (or one cal\u001b[68Ged \u001b[38;2;177;185;249muser\u001b[39m) is now l\u001b[86Gft out with an\u001b[101Gerror, a\u001b[110G any mod\r\u001b[5C\u001b[1Bthat can't mount is.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPartial file names (blocker).\u001b[36G\u001b[22mAfter\u001b[42Ga\u001b[44Gcrash,\u001b[51Gthe\u001b[55Goperating\u001b[65Gsystem\u001b[72Gcan\u001b[76Ghand\u001b[81Gthe\u001b[85Gdead\u001b[90Gprocess's\u001b[100GID\u001b[103Gto\u001b[106Ga\u001b[108Gnew\u001b[112Gone,\r\u001b[2C\u001b[1B  \u001b[6Gwhose partial names would then match the leftov\u001b[54Grs. E\u001b[60Gch process now adds a ran\u001b[86Gom ma\u001b[92Gk to its names,\u001b[108Gdrawn once,\r\u001b[5C\u001b[1Bso names can't repeat across processes. A failed write now never\u001b[71Gdeletes a file it\u001b[89Gdidn'\u001b[95G create.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mCost of the crash cleanup (major).\u001b[22m Every write listed its whol\u001b[69G direc\u001b[76Gory,\u001b[81Gabout \u001b[88Ghree times slower\u001b[106Gwith\u001b[111G10,000\r\u001b[2C\u001b[1B  \u001b[6Gfiles there. The cleanup now looks\u001b[41Gonce pe\u001b[49G directory\u001b[60Gper\u001b[64Gpr\u001b[67Gc\u001b[69Gss, which is enough b\u001b[91Gcause crash leftovers always\r\u001b[5C\u001b[1Bcom\u001b[10G from an\u001b[19Gearlier process.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mThe neutrality test (blocker).\u001b[37G\u001b[22mIt\u001b[40Gnever\u001b[46Gactually\u001b[55Gstarted\u001b[63Gthe\u001b[67Gworld.\u001b[74GIt\u001b[77Gnow\u001b[81Gdoes,\u001b[87Gand\u001b[91Ga\u001b[93Gnew\u001b[97Gcheck\u001b[103Gcompares\u001b[112Gthe\r\u001b[2C\u001b[1B  \u001b[6Gshell's world byte for byte with o\u001b[42G a server star\u001b[57Gs alone, before and\u001b[77Gafter five steps.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mThe first-start language (major).\u001b[22m It\u001b[43Ghad no end-to-end test. It now has on\u001b[81G through the UI\u001b[97Gstage,\u001b[104Gcovering:\r\u001b[2C\u001b[1B  \u001b[6G- which locale variable wins;\u001b[K\r\u001b[7C\u001b[1Bt\u001b[10Gat the choice \u001b[25Gs k\u001b[29Gpt;\u001b[K\r\u001b[12C\u001b[1Ba \u001b[38;2;177;185;249m--frame-step\u001b[39m run never\u001b[38Greads\u001b[44Gthe\u001b[48Glocale;\r\u001b[13C\u001b[1Bn unwritable setti\u001b[33Ggs fil\u001b[40G \u001b[42Goesn'\u001b[27;1H\u001b[24;3H\u001b[?25h"]
