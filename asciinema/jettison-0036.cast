[0.051, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gmessage \u001b[14Gnstead\u001b[21Gof loading a\u001b[34Gyway.\u001b[40GI'm checking whether\u001b[61Gth\u001b[64G \u001b[66Ghell already filt\u001b[84Grs such mod\u001b[96G; if it\u001b[104Gdoesn't, I'll\r\u001b[5C\u001b[1Bake the shell skip them with a warning rather than r\u001b[59Gfuse to start.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\r\u001b[2C\u001b[1B\u001b[22m- The ground sample's rover\u001b[31Gbecomes\u001b[39Gpart\u001b[44Gof\u001b[47Gthe\u001b[51Gworld's\u001b[59Gstarting\u001b[68Gstate\u001b[74Ginstead\u001b[82Gof\u001b[85Gbeing\u001b[91Gmade\u001b[96Gwhen\u001b[101Gthe\u001b[105Gfirst\u001b[111Gscene\r\u001b[2C\u001b[1B \u001b[5Gloads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mrender_test\u001b[17G\u001b[39mgets\u001b[22Ga\u001b[24Gsmall\u001b[30Gbuilt-in\u001b[39Gworld.\r\u001b[4C\u001b[1BNeither should ch\u001b[23Gnge any refere\u001b[38Gce frame\u001b[47Gor\u001b[50Gstate\u001b[56Ghash.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCosts and limits:\r\u001b[2C\u001b[1B\u001b[22m- The content is mounted\u001b[28Gtwice:\u001b[35Ga\u001b[37Gread-only\u001b[47Gcopy\u001b[52Gfor\u001b[56Gthe\u001b[60Gworld,\u001b[67Gand\u001b[71Gthe\u001b[75Gshell's\u001b[83Gcopy\u001b[88Gwith\u001b[93Gthe\u001b[97Gwritable\u001b[106Guser\u001b[111Gdirectory\r\u001b[2C\u001b[1B \u001b[5Gon top for saves. That\u001b[28Gis a sm\u001b[36Gll start-up cost.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMods' scripts still run only in the client\u001b[77Gdoesn't\u001b[85Grun\u001b[89Gthem.\u001b[95GThat's\u001b[102Ga\u001b[104Ggap\u001b[108GJ30\u001b[112Gleaves\u001b[119Gas\u001b[27;1H\u001b[21;110H\u001b[?25h"]
[0.143, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1Bake the shell skip them with a warning rather than r\u001b[59Gfuse to start.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\r\u001b[2C\u001b[1B\u001b[22m- The ground sample's rover\u001b[31Gbecomes\u001b[39Gpart\u001b[44Gof\u001b[47Gthe\u001b[51Gworld's\u001b[59Gstarting\u001b[68Gstate\u001b[74Ginstead\u001b[82Gof\u001b[85Gbeing\u001b[91Gmade\u001b[96Gwhen\u001b[101Gthe\u001b[105Gfirst\u001b[111Gscene\r\u001b[2C\u001b[1B \u001b[5Gloads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mrender_test\u001b[17G\u001b[39mgets\u001b[22Ga\u001b[24Gsmall\u001b[30Gbuilt-in\u001b[39Gworld.\r\u001b[4C\u001b[1BNeither should ch\u001b[23Gnge any refere\u001b[38Gce frame\u001b[47Gor\u001b[50Gstate\u001b[56Ghash.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCosts and limits:\r\u001b[2C\u001b[1B\u001b[22m- The content is mounted\u001b[28Gtwice:\u001b[35Ga\u001b[37Gread-only\u001b[47Gcopy\u001b[52Gfor\u001b[56Gthe\u001b[60Gworld,\u001b[67Gand\u001b[71Gthe\u001b[75Gshell's\u001b[83Gcopy\u001b[88Gwith\u001b[93Gthe\u001b[97Gwritable\u001b[106Guser\u001b[111Gdirectory\r\u001b[2C\u001b[1B \u001b[5Gon top for saves. That\u001b[28Gis a sm\u001b[36Gll start-up cost.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMods' scripts still run only in the client, so a\u001b[54Gdedicated\u001b[64Gserver\u001b[71Gstill\u001b[77Gdoesn't\u001b[85Grun\u001b[89Gthem.\u001b[95GThat's\u001b[102Ga\u001b[104Ggap\u001b[108GJ30\u001b[112Gleaves\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Git is, and I'll note it\u001b[29Gi\u001b[31G the docs.      \u001b[77G\u001b[K\u001b[27;1H\u001b[21;110H\u001b[?25h"]
