[0.016, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 3 -\u001b[38;2;248;248;242mJ17 (j17-names, done), then J34 and J32 on core-lock-and-noreplace, stacked on it (2026-11-27).         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 3 +\u001b[38;2;248;248;242mThe stack J30, J63/J12 docs, J15/J29 bullets, J17, J34, J32 on core-lock-and-noreplace: one gate, then f\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m \u001b[10G\u001b[38;2;248;248;242mast-forward feature-base (2026-11-\u001b[45G7).       \u001b[56G    \u001b[61G    \u001b[66G   \u001b[70G  \u001b[73G                        \u001b[98G   \u001b[102G     \u001b[108G    \u001b[113G \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gpassed\u001b[19Gin\u001b[22G289\u001b[26Gs:\u001b[29Gevery\u001b[35Gstage\u001b[41Gis\u001b[44Ggreen,\u001b[51Gincluding\u001b[61Gthe\u001b[65Gsmoke\u001b[71Gtests,\u001b[78Greference\u001b[88Gframes\u001b[95Gand\u001b[99Gthe\u001b[103Gsanitised\u001b[113Grun.\r\u001b[1B \u001b[3GMerging into \u001b[38;2;177;185;249mfeature-base\u001b[29G\u001b[39mand parking\u001b[41Gthe lanes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Ggit\u001b[15Glog\u001b[19G--oneline\u001b[29G-1\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ git log --oneline -1\u001b[39m\u001b[27;1H\u001b[24;71H\u001b[?25h"]
