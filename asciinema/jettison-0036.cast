[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gfolder makes every mod author ma\u001b[39Gtain\u001b[44Gtw\u001b[47G halves that\u001b[60Gmust\u001b[65Gagree.\r\u001b[4C\u001b[1B\u001b[1mPlaying alone n\u001b[21Geds both\u001b[30Ghalves\u001b[22m in\u001b[40Gone process anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt doesn't solve version skew.\u001b[22m The\u001b[40Gclient and server\u001b[58Gst\u001b[61Gll have\u001b[69Gto\u001b[72Gagree\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[4C\u001b[1Bcheck\u001b[11Gat\u001b[14Gconnection\u001b[25Gtime\u001b[30Gwhichever\u001b[40Gway\u001b[44Gthe\u001b[48Gfiles\u001b[54Gare\u001b[58Glaid\u001b[63Gout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22m keep one package per\u001b[43Gmod,\u001b[48Gand\u001b[52Gsplit\u001b[58Gby\u001b[61Gdirectory\u001b[71Ginside\u001b[78Git,\u001b[82Gwhich\u001b[88Gmostly\u001b[95Gexists\u001b[102Galready:\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdefs/\u001b[39m and \u001b[38;2;177;185;249mscripts/\u001b[39m are the world's.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mscene/\u001b[39m,\u001b[13Gmodels,\u001b[21G\u001b[38;2;177;185;249mui/\u001b[39m,\u001b[26Gsounds\u001b[33Gand\u001b[37G\u001b[38;2;177;185;249mstrings/\u001b[46G\u001b[39mare\u001b[50Gpresentation's.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThen add three small things:\u001b[32G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA server pack.\u001b[22m Th\u001b[24G packer leaves out the presentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b[108Gso\u001b[111Gthe\u001b[115Gserver\r\u001b[2C\u001b[1B  \u001b[6Ggets the size benefit without a\u001b[38Gsecond tree.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA \u001b[38;2;177;185;249mside: client\u001b[39m flag in \u001b[38;2;177;185;249mmod.yaml\u001b[38G\u001b[22m\u001b[39mfor\u001b[42Gpurely\u001b[49Gcosmetic\u001b[58Gmods.\u001b[64GServers\u001b[72Gignore\u001b[79Gthose\u001b[85Gmods,\u001b[91Gand\u001b[95Gclients\u001b[103Gneedn't\u001b[111Gmatch\u001b[117Gon\r\u001b[2C\u001b[1B  \u001b[6Gthem.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mA content handshake.\u001b[22m On connect, the\u001b[43Gserver sends its\u001b[60Gp\u001b[62Gckage list an\u001b[76G a ha\u001b[82Gh\u001b[84Gof\u001b[87Gits\u001b[91Gworld\u001b[97Gcontent.\u001b[106GThe\u001b[110Gclient\r\u001b[5C\u001b[1Bconfirms\u001b[15Git\u001b[18Ghas\u001b[22Gthe\u001b[26Gsame\u001b[31Gdefinitions\u001b[43Gto\u001b[46Gdraw\u001b[51Gwith,\u001b[57Gor\u001b[60Gsays\u001b[65Gwhich\u001b[71Gmod\u001b[75Gdiffers.\r\u001b[2C\u001b[1B    \u001b[8G    \u001b[13G   \u001b[17G \u001b[19G       \u001b[27G       \u001b[35G     \u001b[41G   \u001b[45G  \u001b[75G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.021, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOne mod usually spans both sides.\u001b[22m A new ship is a\u001b[55Gdefinition (s\u001b[69Grver)\u001b[75Gplus\u001b[80Ga\u001b[82Gmodel\u001b[88Gand\u001b[92Gsounds\u001b[99G(client).\u001b[109GSplitting\u001b[119Gby\r\u001b[2C\u001b[1B \u001b[5Gfolder makes every mod author ma\u001b[39Gtain\u001b[44Gtw\u001b[47G halves that\u001b[60Gmust\u001b[65Gagree.\r\u001b[4C\u001b[1B\u001b[1mPlaying alone n\u001b[21Geds both\u001b[30Ghalves\u001b[22m in\u001b[40Gone process anyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt doesn't solve version skew.\u001b[22m The\u001b[40Gclient and server\u001b[58Gst\u001b[61Gll have\u001b[69Gto\u001b[72Gagree\u001b[78Gon\u001b[81Gthe\u001b[85Gshared\u001b[92Gdefinitions,\u001b[105Gand\u001b[109Gthat\u001b[114Gneeds\u001b[120Ga\r\u001b[4C\u001b[1Bcheck\u001b[11Gat\u001b[14Gconnection\u001b[25Gtime\u001b[30Gwhichever\u001b[40Gway\u001b[44Gthe\u001b[48Gfiles\u001b[54Gare\u001b[58Glaid\u001b[63Gout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22m keep one package per\u001b[43Gmod,\u001b[48Gand\u001b[52Gsplit\u001b[58Gby\u001b[61Gdirectory\u001b[71Ginside\u001b[78Git,\u001b[82Gwhich\u001b[88Gmostly\u001b[95Gexists\u001b[102Galready:\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mdefs/\u001b[39m and \u001b[38;2;177;185;249mscripts/\u001b[39m are the world's.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mscene/\u001b[39m,\u001b[13Gmodels,\u001b[21G\u001b[38;2;177;185;249mui/\u001b[39m,\u001b[26Gsounds\u001b[33Gand\u001b[37G\u001b[38;2;177;185;249mstrings/\u001b[46G\u001b[39mare\u001b[50Gpresentation's.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThen add three small things:\u001b[32G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA server pack.\u001b[22m Th\u001b[24G packer leaves out the presentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b