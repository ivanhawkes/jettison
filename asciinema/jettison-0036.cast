[0.531, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat players might notice:\r\u001b[2C\u001b[1B\u001b[22m- Files in the user's own directory\u001b[39Gno\u001b[42Glonger\u001b[49Goverride\u001b[58Gthe\u001b[62Ggame's\u001b[69Gdefinitions,\u001b[82Gonly\u001b[87Gits\u001b[91Gart\u001b[95Gand\u001b[99Gsound.\u001b[106GSaves\u001b[112Gare\r\u001b[2C\u001b[1B \u001b[5Gunaffected.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA mod built\u001b[17Gfor\u001b[21Ga\u001b[23Gnewer\u001b[29Gengine,\u001b[37Gor\u001b[40Gmissing\u001b[48Ga\u001b[50Gpackage\u001b[58Git\u001b[61Gneeds,\u001b[68Gmay\u001b[72Gnow\u001b[76Gstop\u001b[81Gthe\u001b[85Ggame\u001b[90Gfrom\u001b[95Gstarting\u001b[104Gwith\u001b[109Ga\u001b[111Gclear\r\u001b[2C\u001b[1B \u001b[5Gmessage \u001b[14Gnstead\u001b[21Gof loading a\u001b[34Gyway.\u001b[40GI'm checking whether\u001b[61Gth\u001b[64G \u001b[66Ghell already filt\u001b[84Grs such mod\u001b[96G; if it\u001b[104Gdoesn't, I'll\r\u001b[5C\u001b[1Bake the shell skip them with a warning rather than r\u001b[59Gfuse to start.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe engine's own programs:\r\u001b[2C\u001b[1B\u001b[22m- The ground sample's rover\u001b[31Gbecomes\u001b[39Gpart\u001b[44Gof\u001b[47Gthe\u001b[51Gworld's\u001b[59Gstarting\u001b[68Gstate\u001b[74Ginstead\u001b[82Gof\u001b[85Gbeing\u001b[91Gmade\u001b[96Gwhen\u001b[101Gthe\u001b[105Gfirst\u001b[111Gscene\r\u001b[2C\u001b[1B \u001b[5Gloads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mrender_test\u001b[17G\u001b[39mgets\u001b[22Ga\u001b[24Gsmall\u001b[30Gbuilt-in\u001b[39Gworld.\r\u001b[4C\u001b[1BNeither should ch\u001b[23Gnge any refere\u001b[38Gce frame\u001b[47Gor\u001b[50Gstate\u001b[56Ghash.\r\u001b[2C\u001b[1B \u001b[5G       \u001b[13G      \u001b[20G      \u001b[27G   \u001b[31G         \u001b[41G     \u001b[27;1H\u001b[21;3H\u001b[?25h"]
