[5.229, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- The ground sample names its\u001b[35Gground.\u001b[K\r\u001b[5C\u001b[1B\u001b[1m17\u001b[10Gcomment\u001b[19Gbett\u001b[26Gas names\u001b[22m (\u001b[38;2;177;185;249me4c517c\u001b[39m).\u001b[K\r\u001b[6C\u001b[1B\u001b[1m4\u001b[12Glock's holder\u001b[26Gnamed\u001b[22m (\u001b[38;2;177;185;249mfaf1e22\u001b[39m, with a comment-placement fix\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249m4012867\u001b[39m).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJ32, a durable write that refuses to replace a file\u001b[57G\u001b[22m(\u001b[38;2;177;185;249m7de9729\u001b[39m).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMerged into Manifest:\u001b[25G\u001b[22mL44's\u001b[31Gconsole\u001b[39Gcommands\u001b[48G(\u001b[38;2;177;185;249m08de87c\u001b[39m,\u001b[58G\u001b[38;2;177;185;249mb503fb9\u001b[39m),\u001b[68Gand\u001b[72Gits\u001b[76Gdocs\u001b[81Gnow\u001b[85Grecord\u001b[92GJ30\u001b[96Gas\u001b[99Gdone\u001b[104G(\u001b[38;2;177;185;249mcbd2d99\u001b[39m,\u001b[114Gdocs\r\u001b[2C\u001b[1Bonly,\u001b[9Gso\u001b[12Gno\u001b[15Ggate).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisions for you:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJ32's partial file names.\u001b[22m A new-\u001b[41G write names its partial\u001b[66Gfile per writer, \u001b[38;2;177;185;249m<name>:partial.<pid>.<n>\u001b[39m,\u001b[109Gso two\u001b[K\r\u001b[4C\u001b[1Bwriters can't tear each other's fil\u001b[41G.\u001b[43GA crash\u001b[51Gc\u001b[53Gn leave such a file b\u001b[75Ghind,\u001b[81Gand n\u001b[87Gthing \u001b[94Gemoves it. The ordinary\u001b[K\r\u001b[4C\u001b[1Breplacing write still uses the\u001b[36Gshared\u001b[43Gpartial nam\u001b[55G, \u001b[58Ghich\u001b[63Gha\u001b[66G the same race if\u001b[84Gtwo\u001b[88Gwriters\u001b[96Greplace\u001b[104Gone\u001b[108Gfile\u001b[113Gat\u001b[116Gonce.\r\u001b[2C\u001b[1B \u001b[5GThe world's lock prevents that today. Unifying\u001b[52Gt\u001b[54Ge two is possible if you want it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL44's argument layouts.\u001b[22m The s\u001b[35Gbagent chose the shapes of \u001b[38;2;177;185;249mfees\u001b[39m,\u001b[68G\u001b[38;2;177;185;249mpolicy\u001b[39m's optional thrust and contracts, and\u001b[112G\u001b[38;2;177;185;249mtender \r\u001b[4C\u001b[1Bbid\u001b[39m's\u001b[11Grevision.\u001b[21GChange\u001b[28Gany\u001b[32Gyou\u001b[36Gdislike.\u001b[45GOne\u001b[49Gsmall\u001b[55Gstyle\u001b[61Gnit\u001b[65Gis\u001b[68Gleft:\u001b[74Gone-letter\u001b[85Gnames\u001b[91Gin\u001b[94G\u001b[38;2;177;185;249mCommandTender\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll \u001b[8Gh\u001b[10Gee Jettison lanes and\u001b[32GManifest's\u001b[43Glane\u001b[48GB\u001b[50Gare\u001b[54Gparked\u001b[61Gon\u001b[64G\u001b[38;2;177;185;249mfeature-base\u001b[77G\u001b[39mand\u001b[81Gfree.\u001b[87GThis\u001b[92Gis\u001b[95Ga\u001b[97Ggood\u001b[102Gpoint\u001b[108Gto\u001b[111G\u001b[38;2;177;185;249m/compact\r\u001b[2C\u001b[1B\u001b[39mor\u001b[6Gstart\u001b[12Ga\u001b[14Gfresh\u001b[20Gsession.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Gchecked:\u001b[16Gno\u001b[19Gcross-review\u001b[32Ghas\u001b[36Grun\u001b[40Gon\u001b[43Gthis\u001b[48Gbatch,\u001b[55Gand\u001b[59Gnobody\u001b[66Ghas\u001b[70Grun\u001b[74G\u001b[38;2;177;185;249mmanifest_tui\u001b[87G\u001b[39mitself\u001b[94Gwith\u001b[99Gthe\u001b[103Gnew\u001b[107Gcommands.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
