[0.050, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCosts and limits:\r\u001b[2C\u001b[1B\u001b[22m- The content is mounted\u001b[28Gtwice:\u001b[35Ga\u001b[37Gread-only\u001b[47Gcopy\u001b[52Gfor\u001b[56Gthe\u001b[60Gworld,\u001b[67Gand\u001b[71Gthe\u001b[75Gshell's\u001b[83Gcopy\u001b[88Gwith\u001b[93Gthe\u001b[97Gwritable\u001b[106Guser\u001b[111Gdirectory\r\u001b[2C\u001b[1B \u001b[5Gon top for saves. That\u001b[28Gis a sm\u001b[36Gll start-up cost.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMods' scripts still run only in the client, so a\u001b[54Gdedicated\u001b[64Gserver\u001b[71Gstill\u001b[77Gdoesn't\u001b[85Grun\u001b[89Gthem.\u001b[95GThat's\u001b[102Ga\u001b[104Ggap\u001b[108GJ30\u001b[112Gleaves\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Git is, and I'll note it\u001b[29Gi\u001b[31G the docs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GConnecti\u001b[14Gg\u001b[16Gthe graphical client to a\u001b[42Gremote\u001b[49Gserver\u001b[56Gstays\u001b[62GManifest's\u001b[73GL15\u001b[77Gwork.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat doesn't change:\u001b[24G\u001b[22mthe\u001b[28Gframe\u001b[34Gloop,\u001b[40Gthe\u001b[44Gsave\u001b[49Gformat,\u001b[57Gthe\u001b[61Gconsole,\u001b[70Gand\u001b[74Gthe\u001b[78Gstep\u001b[83Grate\u001b[88Gand\u001b[92Gseed\u001b[97G(1/60\u001b[103Gs,\u001b[106Gseed\u001b[111G0).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNow\u001b[7Gstarting\u001b[16Gthe\u001b[20Gimplementation\u001b[35Gin\u001b[38G\u001b[38;2;177;185;249mjettison.lane-c\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mAgent\u001b[22m(Implement\u001b[19GManifest\u001b[28GL44\u001b[32Gconsole\u001b[40Gcommand\u001b[27;1H\u001b[21;110H\u001b[?25h"]
[0.273, "o", "\u001b]0;◐ jettison-0036\u0007"]
[0.136, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mCosts and limits:\r\u001b[2C\u001b[1B\u001b[22m- The content is mounted\u001b[28Gtwice:\u001b[35Ga\u001b[37Gread-only\u001b[47Gcopy\u001b[52Gfor\u001b[56Gthe\u001b[60Gworld,\u001b[67Gand\u001b[71Gthe\u001b[75Gshell's\u001b[83Gcopy\u001b[88Gwith\u001b[93Gthe\u001b[97Gwritable\u001b[106Guser\u001b[111Gdirectory\r\u001b[2C\u001b[1B \u001b[5Gon top for saves. That\u001b[28Gis a sm\u001b[36Gll start-up cost.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMods' scripts still run only in the client, so a\u001b[54Gdedicated\u001b[64Gserver\u001b[71Gstill\u001b[77Gdoesn't\u001b[85Grun\u001b[89Gthem.\u001b[95GThat's\u001b[102Ga\u001b[104Ggap\u001b[108GJ30\u001b[112Gleaves\u001b[119Gas\r\u001b[2C\u001b[1B \u001b[5Git is, and I'll note it\u001b[29Gi\u001b[31G the docs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GConnecti\u001b[14Gg\u001b[16Gthe graphical client to a\u001b[42Gremote\u001b[49Gserver\u001b[56Gstays\u001b[62GManifest's\u001b[73GL15\u001b[77Gwork.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat doesn't change:\u001b[24G\u001b[22mthe\u001b[28Gframe\u001b[34Gloop,\u001b[40Gthe\u001b[44Gsave\u001b[49Gformat,\u001b[57Gthe\u001b[61Gconsole,\u001b[70Gand\u001b[74Gthe\u001b[78Gstep\u001b[83Grate\u001b[88Gand\u001b[92Gseed\u001b[97G(1/60\u001b[103Gs,\u001b[106Gseed\u001b[111G0).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNow\u001b[7Gstarting\u001b[16Gthe\u001b[20Gimplementation\u001b[35Gin\u001b[38G\u001b[38;2;177;185;249mjettison.lane-c\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mAgent\u001b[22m(Implement\u001b[19GManifest\u001b[28GL44\u001b[32Gconsole\u001b[40Gcommands)\u001b[50G\u001b[38;2;153;153;153mSonnet 5.5\r\u001b[1B  ⎿  \u001b[39mBackgrounded\u001b[19Gagent\u001b[38;2;153;153;153m (↓ to manage · ctrl+o \u001b[39m\u001b[27;1H\u001b[21;110H\u001b[?25h"]
