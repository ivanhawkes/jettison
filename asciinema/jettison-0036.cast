[0.039, "o", "\u001b[?25l\u001b[H\u001b[3G  remote player would.\u001b[K\r\u001b[4C\u001b[1BSo the world insi\u001b[23Ge the cli\u001b[33Gnt is \u001b[40Ghe server's world, down to th\u001b[70G byte. A save made in \u001b[93Gne\u001b[96Gload\u001b[101G in the other\u001b[117Gnd\u001b[K\r\u001b[4C\u001b[1Bthe s\u001b[11Grver's determinism\u001b[30Gtests\u001b[36Gcover\u001b[42Gwhat\u001b[47Gthe\u001b[51Gclient\u001b[58Gplays.\r\u001b[4C\u001b[1BWha\u001b[9G \u001b[11Gxists only for the screen \u001b[38Gtays\u001b[43Gwith the\u001b[52Gshe\u001b[56Gl:\u001b[59Gs\u001b[61Gu\u001b[63Gds for events, the mods' scripts, input and UI.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for a game author:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Ggame\u001b[12Gis\u001b[15Gtwo\u001b[19Gclasses\u001b[27Gwith\u001b[32Gseparate\u001b[41Gjobs:\r\u001b[2C\u001b[1B  - \u001b[38;2;177;185;249mHost::Game\u001b[39m holds the rules and\u001b[38Gthe\u001b[42Gworld:\u001b[49Gits\u001b[53Gtypes,\u001b[60Gits\u001b[64Gcontent,\u001b[73Gits\u001b[77Gworld\u001b[83Gand\u001b[87Gits\u001b[91Gstarting\u001b[100Gstate.\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[38;2;177;185;249mApp::Game\u001b[39m holds the\u001b[27Glook\u001b[32Gand feel: input,\u001b[49Gscenes,\u001b[57GUI,\u001b[61Gsounds,\u001b[69Gpicking\u001b[77Gand\u001b[81Gsaves.\r\u001b[2C\u001b[1B-\u001b[5GThe shell's own copies\u001b[28Gof world s\u001b[39Gart-up (\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m,\u001b[64G\u001b[38;2;177;185;249mDefine\u001b[39m, the world h\u001b[86Gle in \u001b[38;2;177;185;249mRegister\u001b[39m) \u001b[103Gr\u001b[105G removed.\r\u001b[2C\u001b[1B-\u001b[5GIf a game wants bodi\u001b[26Gs drawn and picked, its world registers them and attaches physics\u001b[92Gitself.\u001b[100GManifest\u001b[109Galready\r\u001b[2C\u001b[1B \u001b[5Gdo\u001b[8Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for Manifest:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GIts\u001b[9Ggraphical\u001b[19Gclient\u001b[26G(L15)\u001b[32Greuses\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mHost::Game\u001b[54G\u001b[39mits\u001b[58Gserver\u001b[65Galready\u001b[73Guses,\u001b[79Gso\u001b[82Gthere\u001b[88Gis\u001b[91Gnothing\u001b[99Gto\u001b[102Gkeep\u001b[107Gin\u001b[110Gstep.\r\u001b[2C\u001b[1B- A client that fails to start\u001b[34Gsays\u001b[39Gwhere,\u001b[46Gas\u001b[49Gthe\u001b[53Gserver\u001b[60Gdoes\u001b[65Gnow,\u001b[70Gfor\u001b[74Gexample\u001b[82G\"Start-up\u001b[92Gfailed\u001b[99Gin\u001b[102Gthe\u001b[106Gcontent\u001b[114Gphase,\r\u001b[2C\u001b[1B \u001b[5Ga\u001b[7G …/m\u001b[12Gnifest: …\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
