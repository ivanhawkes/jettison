[0.167, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 33 \u001b[22m \u001b[38;2;117;113;94m// does. Throws std::runtime_error naming the path and what failed, with the partial file removed and\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[14G\u001b[22m\u001b[38;2;117;113;94many old file as it was.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/core/include/jettison/core/File.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m4\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 54 \u001b[22m \u001b[38;2;117;113;94m// that of two writers making the same file one leaves it whole and the other is refused, with no\r\u001b[1B\u001b[39m     \u001b[2m 55 \u001b[22m \u001b[38;2;117;113;94m// check between the two for a writer to come into. Throws FileExistsError naming the path when a file\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m6\u001b[14G\u001b[22m\u001b[38;2;117;113;94mis \u001b[18Ghere, and any other failure \u001b[47Gs Wr\u001b[52Gt\u001b[54GFil\u001b[58GDur\u001b[62Gbly\u001b[66Gdoes; either\u001b[79Gway\u001b[83Gthe partial file is removed and\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 57 -\u001b[38;2;248;248;242m// a file already there is as it was. The partial file is named for its writer                         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 58 -\u001b[38;2;248;248;242m// (`<name>:partial.<process ID>.<count>`), since writers of the same file at once would otherwise     \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m9\u001b[14G\u001b[38;2;248;248;242mwrite into one; a crash\u001b[38Gleaves it be\u001b[51Gind, \u001b[57Go be removed by hand.\u001b[79GNeeds a file\u001b[92Gsystem\u001b[99Gthat\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m60\u001b[14G\u001b[38;2;248;248;242msupports the flag (ext4, xfs, btrfs and tmpfs do), o\u001b[67G it throw\u001b[77G for th\u001b[86Gfile system. \u001b[100G         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 57 +\u001b[38;2;117;113;94m// a file already there is as it was. Needs a file system that supports the flag (ext4, xfs, btrfs and\u001b[38;2;248;248;242m \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 58 +\u001b[38;2;117;113;94m// tmpfs do), or it throws for the file system.\u001b[38;2;248;248;242m                                                        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 59 \u001b[22m \u001b[38;2;166;226;46mvoid\u001b[39m \u001b[38;2;166;226;46mWriteNewFileDurably\u001b[38;2;253;151;31m(\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 60 \u001b[22m     \u001b[38;2;166;226;46mconst\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::filesystem::path &path, \u001b[38;2;166;226;46mstd\u001b[39m::span<\u001b[38;2;166;226;46mconst\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::byte> bytes,\u001b[K\r\u001b[6C\u001b[1B\u001b[2m61\u001b[11G\u001b[22m    \u001b[38;2;166;226;46mstd\u001b[39m::filesystem::perms\u001b[38Gpermissions\u001b[50G=\u001b[52GkFilePermissions);\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWorking…\u001b[15G\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m*\u001b[3G\u001b[38;2;235;159;127mShenaniganing…\u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
