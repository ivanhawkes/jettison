[0.357, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEverything\u001b[14Gis\u001b[17Gmerged\u001b[24Glocally\u001b[32Gand\u001b[36Ggated;\u001b[43Ground\u001b[49G3\u001b[51Gof\u001b[54Gthe\u001b[58Gcross-review,\u001b[72Gthe\u001b[76Glast\u001b[81Gone,\u001b[86Gis\u001b[89Grunning\u001b[97Gnow.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMerged:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mJettison\u001b[14G\u001b[22m\u001b[38;2;177;185;249mfeature-base\u001b[27G\u001b[39mis\u001b[30Gat\u001b[33G\u001b[38;2;177;185;249m80aa60d\u001b[39m.\u001b[42GThat's\u001b[49Gthe\u001b[53GJ30\u001b[57Gbatch,\u001b[64Ground\u001b[70G1's\u001b[74Gfixes,\u001b[81Gthe\u001b[85Gart-standards\u001b[99Gsupport\u001b[107Gfrom\u001b[112Glane\u001b[117GC\r\u001b[2C\u001b[1B \u001b[5G(\u001b[38;2;177;185;249made7077\u001b[39m, rebased cleanly on top), and round 2's fixes. The last\u001b[70Ggate (\u001b[38;2;177;185;249m--werror --asan\u001b[39m) r\u001b[95Gn on \u001b[38;2;177;185;249m80aa60d\u001b[39m and\u001b[112Gp\u001b[114Gssed\u001b[119Gin\r\u001b[4C\u001b[1B208 s, so\u001b[15Git covers all of it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m \u001b[38;2;177;185;249mfeature-base\u001b[39m now has the\u001b[39Gart-standards\u001b[53Gdocs\u001b[58G(\u001b[38;2;177;185;249me2fc3de\u001b[39m,\u001b[68Grebased\u001b[76Gonto\u001b[81GL44).\u001b[87GThat\u001b[92Gchange\u001b[99Gis\u001b[102Gdocs\u001b[107Gonly,\u001b[113Gso\u001b[116GI\r\u001b[2C\u001b[1B \u001b[5Gdidn't run Manifest's\u001b[27Ggate.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNeither repo is pushed this\u001b[33Gtime;\u001b[39Gsay\u001b[43Gif\u001b[46Gyou\u001b[50Gwant\u001b[55Gboth\u001b[60Gpushed\u001b[67Gnow.\r\u001b[4C\u001b[1BThe two\u001b[13Gart-standards branches were already committed when I lo\u001b[69Gked,\u001b[74Gso\u001b[77Gthere\u001b[83Gwas\u001b[87Gnothing\u001b[95Gin\u001b[98Geither\u001b[105Glane\u001b[110GB\u001b[112Gto\r\u001b[2C\u