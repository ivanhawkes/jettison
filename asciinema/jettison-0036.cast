46G\u001b[39mare\u001b[50Gpresentation's.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThen add three small things:\u001b[32G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mA server pack.\u001b[22m Th\u001b[24G packer leaves out the presentation\u001b[60Gdirectories\u001b[72Gwhen\u001b[77Git\u001b[80Gbuilds\u001b[87Gthe\u001b[91Gserver's\u001b[100Gbundle,\u001b[108Gso\u001b[111Gthe\u001b[115Gserver\r\u001b[2C\u001b[1B  \u001b[6Ggets the size benefit without a\u001b[38Gsecond tree.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mA \u001b[38;2;177;185;249mside: client\u001b[39m flag in \u001b[38;2;177;185;249mmod.yaml\u001b[38G\u001b[22m\u001b[39mfor\u001b[42Gpurely\u001b[49Gcosmetic\u001b[58Gmods.\u001b[64GServers\u001b[72Gignore\u001b[79Gthose\u001b[85Gmods,\u001b[91Gand\u001b[95Gclients\u001b[103Gneedn't\u001b[111Gmatch\u001b[117Gon\r\u001b[2C\u001b[1B  \u001b[6Gthem.               \u001b[27G  \u001b[30G        \u001b[39G   \u001b[43G    \u001b[75G\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
