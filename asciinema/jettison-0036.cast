[0.091, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Two small items can be bundled without conflicts: J29's ground naming (about five lines) and J15's first-start\u001b[K\r\u001b[1B  language detection (about 20 lines plus a test, with headless runs ignoring the environment). I'd do the first now and\r\u001b[2C\u001b[1Bthe\u001b[7Gsecond\u001b[14Gonly\u001b[19Gif\u001b[22Gyou\u001b[26Gagree\u001b[32Gto\u001b[35Gthe\u001b[39Grule\u001b[44Gthat\u001b[49Gtest\u001b[54Gruns\u001b[59Gignore\u001b[66Gthe\u001b[70Genvironment;\u001b[83Gshall\u001b[89GI\u001b[91Gproceed?\u001b[38;2;153;153;153m · summary\r\u001b[1B  ⎿  Found \u001b[1m8\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes\u001b[39m                                                                                                                   \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDoing\u001b[9Gboth\u001b[14Gin\u001b[17Glane\u001b[22GC\u001b[24Gnow.\u001b[29GFirst,\u001b[36Greading\u001b[44Ghow\u001b[48Gthe\u001b[52Gshell\u001b[58Gpicks\u001b[64Gits\u001b[68Glanguage\u001b[77Gtoday.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gdecision\u001b[16Gin\u001b[19Gthe\u001b[23Gway\u001b[27Gis\u001b[30Gthat\u001b[35Glanguage\u001b[44Gis\u001b[47Ga\u001b[49Gsetting,\u001b[58Gnot\u001b[62Ga\u001b[64Glocale,\u001b[72Gso\u001b[75GI'll\u001b[80Gchange\u001b[87Git\u001b[90Gto\u001b[93Gmatch\u001b[99Gwhat\u001b[104Gyou\u001b[108Gapproved:\u001b[118Gan\r\u001b[1B \u001b[3Ginteractive first s\u001b[23Ga\u001b[25Gt with \u001b[33Go language set t\u001b[50Gkes\u001b[54