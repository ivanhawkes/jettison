b[2m9\u001b[14G\u001b[22mJ05. Packs and mods\u001b[34G|\u001b[36GNone\u001b[41Gyet;\u001b[46GManifest's\u001b[57Gmods\u001b[62Gare\u001b[66Gthe\u001b[70Gfirst\u001b[76Gconsumer\u001b[85G|\u001b[87GA\u001b[89Gpatch\u001b[95Gcould\u001b[101Gonly\u001b[106Greplace\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22ma\u001b[14Glist, \u001b[21G pack was read\u001b[36Gas it was\u001b[46Gmount\u001b[52Gd, and only definit\u001b[72Gons\u001b[76Gand string\u001b[87Gtables layered, so\u001b[106Ga mod re\r\u001b[11C\u001b[1Bplaced a scene\u001b[27Gor a style\u001b[38Gheet whol\u001b[76Guence tag\u001b[86Ged `!remove` (scalars) \u001b[110Gr\u001b[112G`!\u001b[27;1H\u001b[21;3H\u001b[?25h"]
