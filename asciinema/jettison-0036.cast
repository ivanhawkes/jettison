[0.204, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThat\u001b[8Gfits\u001b[13Ghow\u001b[17Ga\u001b[19Gsession\u001b[27Galready\u001b[35Greads\u001b[41Gthe\u001b[45Gworld:\u001b[52Gdefinitions\u001b[64Gthrough\u001b[72G\u001b[38;2;177;185;249mDefinitionRegistry\u001b[39m,\u001b[92Gart\u001b[96Gthrough\u001b[104Gthe\u001b[108Gshell's\u001b[116Gown\r\u001b[2C\u001b[1Bfile\u001b[8Gsystem. None of it\u001b[27Gneeds doing before L15. Th\u001b[54G handshake belongs with L15's remote play.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne consequence for J30:\u001b[28G\u001b[22mmods'\u001b[34Gscripts\u001b[42Gsend\u001b[47Gcommands\u001b[56G(traders'\u001b[66GAI\u001b[69Ginputs),\u001b[78Gso\u001b[81Gby\u001b[84Gyour\u001b[89Grule\u001b[94Gthey\u001b[99Gbelong\u001b[106Gon\u001b[109Gthe\u001b[113Gserver,\r\u001b[2C\u001b[1Bnot the client. J30 leaves them in the\u001b[43Ghell, where they w\u001b[63Ge,\u001b[66Gand the docs record it\u001b[89Gas a\u001b[94Glimit. I'd add\u001b[109Gmoving\u001b[K\r\u001b[2C\u001b[1Bscripts\u001b[11Ginto \u001b[17Ghe session as a backlog item rather than wid\u001b[62Gn J30. Tell\u001b[74Gme if you'\u001b[86Grather it went\u001b[101Ginto J30.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCarrying\u001b[12Gon:\u001b[16Groadmap\u001b[24Gand\u001b[28Ghistory,\u001b[37Gformatting,\u001b[49Gtidy,\u001b[55Gthen\u001b[60Gthe\u001b[64Ggate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-c/docs/history/neutral-sdk.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m7\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 268 \u001b[12G\u001b[22m|\u001b[14G--- |\u001b[20G---\u001b[24G|\u001b[26G---\u001b[30G|\r\u001b[8C\u001b[1B\u001b[2m9\u001b[14G\u001b[22mJ05. Packs and mods\u001b[34G|\u001b[36GNone\u001b[41Gyet;\u001b[46GManifest's\u001b[57Gmods\u001b[62Gare\u001b[66Gthe\u001b[70Gfirst\u001b[76Gconsumer\u001b[85G|\u001b[87GA\u001b[89Gpatch\u001b[95Gcould\u001b[101Gonly\u001b[106Greplace\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22ma\u001b[14Glist, \u001b[21G pack was read\u001b[36Gas it was\u001b[46Gm\u001b[76Gand string\u001b[87Gtables layered, so\u001b[106Ga mod re\u001b[27;1H\u001b[21;3H\u001b[?25h"]
