[0.031, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 190 \u001b[12G\u001b[22m[\u001b[38;2;230;219;116mdecided\u001b[39m](decisions.md#persistence).\u001b[49GOn\u001b[52Gfailure\u001b[60Git\u001b[63Gthrows\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.\u001b[31Ga\u001b[34G-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m`RENAME_NOREPLACE` (Linux;\u001b[40Ghe\u001b[43Gone call is in\u001b[58G`core/src/File.cpp`), so\u001b[83Gthere is\u001b[92Gno check for ano\u001b[109Gher\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22mwrit\u001b[17Gr to come between: of\u001b[39Gtwo writers making the same\u001b[67Gfile one leaves it\u001b[86Gwhole and the other gets\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 198 \u001b[22m `Core::FileExistsError`, a `std::runtime_error` naming the path, with its partial file removed. A file\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m199\u001b[12G\u001b[38;2;248;248;242malready there is as it was, a directory \u001b[54G the way \u001b[64Gncluded. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mfile \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnamed\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfor\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mwriter\u001b[48;2;61;1;0m,\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m0\u001b[12G\u001b[38;2;248;248;242m`<name>:partial.<process ID>.<\u001b[45Gnt>`, since tw\u001b[60G writers o\u001b[71G one file a\u001b[83G once wou\u001b[93Gd otherwise write  \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m1\u001b[12G\u001b[38;2;248;248;242minto\u001b[17Gthe s\u001b[23Gme partial and \u001b[39Gne could rename the other's half-writ\u001b[77Gen bytes\u001b[86Ginto place. A crash leave\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 202 -\u001b[38;2;248;248;242mthat partial behind, and nothing removes it. The file system must support the flag (ext4, xfs, btrfs  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m199\u001b[12G\u001b[38;2;248;248;242malready there is\u001b[29Gas\u001b[32Git\u001b[35Gwas,\u001b[40Ga\u001b[42Gdirectory\u001b[52Gin\u001b[55Gthe\u001b[59Gway\u001b[63Gincluded.\u001b[73G\u001b[48;2;4;71;0mThe\u001b[77G\u001b[48;2;2;40;0mfile\u001b[82G\u001b[48;2;4;71;0msystem\u001b[89Gmust\u001b[94Gsupport\u001b[102Gthe\u001b[106Gflag (ex\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mt4\u001b[48;2;2;40;0m,\u001b[48;2;4;71;0m xfs, btrfs\u001b[48;2;2;40;0m                                                                                        \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m0\u001b[12G\u001b[22mand\u001b[16Gtmpfs\u001b[22Gdo);\u001b[27Gon\u001b[30Gone\u001b[34Gthat\u001b[39Gdoes\u001b[44Gnot,\u001b[49Gthe\u001b[53Gwrite\u001b[59Gthrows\u001b[66Gnaming\u001b[73Gthe\u001b[77Gpath\u001b[82Gand\u001b[86Gthe\u001b[90Greason.\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 202 \u001b[12G\u001b[22mA\u001b[14Gmissing\u001b[22Gdirectory\u001b[32Gis\u001b[35Gmade\u001b[40Gby\u001b[43G`Core::CreateDirectoriesDurably`,\u001b[77Goutermost\u001b[87Gfirst,\u001b[94Geach\u001b[99Gone's\u001b[105Gparent\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7G\u001b[38;2;177;185;249mcore\u001b[12G\u001b[39msuite\u001b[18Gpasses.\u001b[26GTidy,\u001b[32Gcommit,\u001b[40Gthen\u001b[45Gth\u001b[27;1H\u001b[24;24H\u001b[?25h"]
[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[2m89\u001b[12G\u001b[22mis never op\u001b[24Gn to others on \u001b[40Gts way. Why\u001b[52Gboth flushes are needed\u001b[76Gis\r\u001b[5C\u001b[1B\u001b[2m 190 \u001b[12G\u001b[22m[\u001b[38;2;230;219;116mdecided\u001b[39m](decisions.md#persistence).\u001b[49GOn\u001b[52Gfailure\u001b[60Git\u001b[63Gthrows\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.\u001b[31Ga\u001b[34G-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m`RENAME_NOREPLACE` (Linux;\u001b[40Ghe\u001b[43Gone call is in\u001b[58G`core/src/File.cpp`), so\u001b[83Gthere is\u001b[92Gno check for ano\u001b[109Gher\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22mwrit\u001b[17Gr to come between: of\u001b[39Gtwo writers making the same\u001b[67Gfile one leaves it\u001b[86Gwhole and the other gets\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 198 \u001b[22m `Core::FileExistsError`, a `std::runtime_error` naming the path, with its partial file removed. A file\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m199\u001b[12G\u001b[38;2;248;248;242malready there is as it was, a directory \u001b[54G the way \u001b[64Gncluded. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mfile \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnamed\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfor\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mwriter\u001b[48;2;61;1;0m,\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m0\u001b[12G\u001b[38;2;248;248;242m`<name>:partial.<process ID>.<\u001b[45Gnt>`, since tw\u001b[60G writers o\u001b[71G one file a\u001b[83G once wou\u001b[93Gd otherwise write  \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m1\u001b[12G\u001b[38;2;248;248;242minto\u001b[17Gthe s\u001b[23Gme partial and \u001b[39Gne could rename the other's half-writ\u001b[77Gen bytes\u001b[86Ginto place. A crash leave\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 202 -\u001b[38;2;248;248;242mthat partial behind, and nothing removes it. The file system must support the flag (ext4, xfs, btrfs  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m199\u001b[12G\u001b[38;2;248;248;242malready there is\u001b[29Gas\u001b[32Git\u001b[35Gwas,\u001b[40Ga\u001b[42Gdirectory\u001b[52Gin\u001b[55Gthe\u001b[59Gway\u001b[63Gincluded.\u001b[73G\u001b[48;2;4;71;0mThe\u001b[77G\u001b[48;2;2;40;0mfile\u001b[82G\u001b[48;2;4;71;0msystem\u001b[89Gmust\u001b[94Gsupport\u001b[102Gthe\u001b[106Gflag (ex\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mt4\u001b[48;2;2;40;0m,\u001b[48;2;4;71;0m xfs, btrfs\u001b[48;2;2;40;0m                                                                                        \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m0\u001b[12G\u001b[22mand\u001b[16Gtmpfs\u001b[22Gdo);\u001b[27Gon\u001b[30Gone\u001b[34Gthat\u001b[39Gdoes\u001b[44Gnot,\u001b[49Gthe\u001b[53Gwrite\u001b[59Gthrows\u001b[66Gnaming\u001b[73Gthe\u001b[77Gpath\u001b[82Gand\u001b[86Gthe\u001b[90Greason.\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 202 \u001b[12G\u001b[22mA\u001b[14Gmissing\u001b[22Gdirectory\u001b[32Gis\u001b[35Gmade\u001b[40Gby\u001b[43G`Core::CreateDirectoriesDurably`,\u001b[77Goutermost\u001b[87Gfirst,\u001b[94Geach\u001b[99Gone's\u001b[105Gparent\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m \u001b[3G   \u001b[7G    \u001b[12G     \u001b[18G       \u001b[26G     \u001b[32G       \u001b[40G    \u001b[45G  \u001b[27;1H\u001b[24;24H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22m(`Core::kFilePermissions`), so\u001b[43Ga file a\u001b[52Ggame\u001b[57Gkeeps private, such as\u001b[80Ga\u001b[82Gserver's\u001b[91Gsecret\u001b[98Gkey\u001b[102Gat\u001b[105G0600,\r\u001b[7C\u001b[1B\u001b[2m89\u001b[12G\u001b[22mis never op\u001b[24Gn to others on \u001b[40Gts way. Why\u001b[52Gboth flushes are needed\u001b[76Gis\r\u001b[5C\u001b[1B\u001b[2m 190 \u001b[12G\u001b[22m[\u001b[38;2;230;219;116mdecided\u001b[39m](decisions.md#persistence).\u001b[49GOn\u001b[52Gfailure\u001b[60Git\u001b[63Gthrows\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.\u001b[31Ga\u001b[34G-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m`RENAME_NOREPLACE` (Linux;\u001b[40Ghe\u001b[43Gone call is in\u001b[58G`core/src/File.cpp`), so\u001b[83Gthere is\u001b[92Gno check for ano\u001b[109Gher\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22mwrit\u001b[17Gr to come between: of\u001b[39Gtwo writers making the same\u001b[67Gfile one leaves it\u001b[86Gwhole and the other gets\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 198 \u001b[22m `Core::FileExistsError`, a `std::runtime_error` naming the path, with its partial file removed. A file\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m199\u001b[12G\u001b[38;2;248;248;242malready there is as it was, a directory \u001b[54G the way \u001b[64Gncluded. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mfile \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnamed\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfor\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mwriter\u001b[48;2;61;1;0m,\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m0\u001b[12G\u001b[38;2;248;248;242m`<name>:partial.<process ID>.<\u001b[45Gnt>`, since tw\u001b[60G writers o\u001b[71G one file a\u001b[83G once wou\u001b[93Gd otherwise write  \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m1\u001b[12G\u001b[38;2;248;248;242minto\u001b[17Gthe s\u001b[23Gme partial and \u001b[39Gne could rename the other's half-writ\u001b[77Gen bytes\u001b[86Ginto place. A crash leave\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 202 -\u001b[38;2;248;248;242mthat partial behind, and nothing removes it. The file system must support the flag (ext4, xfs, btrfs  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m199\u001b[12G\u001b[38;2;248;248;242malready there is\u001b[29Gas\u001b[32Git\u001b[35Gwas,\u001b[40Ga\u001b[42Gdirectory\u001b[52Gin\u001b[55Gthe\u001b[59Gway\u001b[63Gincluded.\u001b[73G\u001b[48;2;4;71;0mThe\u001b[77G\u001b[48;2;2;40;0mfile\u001b[82G\u001b[48;2;4;71;0msystem\u001b[89Gmust\u001b[94Gsupport\u001b[102Gthe\u001b[106Gflag (ex\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mt4\u001b[48;2;2;40;0m,\u001b[48;2;4;71;0m xfs, btrfs\u001b[48;2;2;40;0m                                                                                        \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m0\u001b[12G\u001b[22mand\u001b[16Gtmpfs\u001b[22Gdo);\u001b[27Gon\u001b[30Gone\u001b[34Gthat\u001b[39Gdoes\u001b[44Gnot,\u001b[49Gthe\u001b[53Gwrite\u001b[59Gthrows\u001b[66Gnaming\u001b[73Gthe\u001b[77Gpath\u001b[82Gand\u001b[86Gthe\u001b[90Greason.\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 202 \u001b[12G\u001b[22mA\u001b[14Gmissing\u001b[22Gdirectory\u001b[32Gis\u001b[35Gmade\u001b[40Gby\u001b[43G`Core::CreateDirectoriesDurably`,\u001b[77Goutermost\u001b[87Gfirst,\u001b[94Geach\u001b[99Gone's\u001b[105Gparent\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
[0.225, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 187 +\u001b[38;2;248;248;242mkept). The partial file is made anew with the permissions the caller gives, 0644 unless told otherwise\r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m8\u001b[12G\u001b[22m(`Core::kFilePermissions`), so\u001b[43Ga file a\u001b[52Ggame\u001b[57Gkeeps private, such as\u001b[80Ga\u001b[82Gserver's\u001b[91Gsecret\u001b[98Gkey\u001b[102Gat\u001b[105G0600,\r\u001b[7C\u001b[1B\u001b[2m89\u001b[12G\u001b[22mis never op\u001b[24Gn to others on \u001b[40Gts way. Why\u001b[52Gboth flushes are needed\u001b[76Gis\r\u001b[5C\u001b[1B\u001b[2m 190 \u001b[12G\u001b[22m[\u001b[38;2;230;219;116mdecided\u001b[39m](decisions.md#persistence).\u001b[49GOn\u001b[52Gfailure\u001b[60Git\u001b[63Gthrows\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/jettison.\u001b[31Ga\u001b[34G-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m`RENAME_NOREPLACE` (Linux;\u001b[40Ghe\u001b[43Gone call is in\u001b[58G`core/src/File.cpp`), so\u001b[83Gthere is\u001b[92Gno check for ano\u001b[109Gher\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22mwrit\u001b[17Gr to come between: of\u001b[39Gtwo writers making the same\u001b[67Gfile one leaves it\u001b[86Gwhole and the other gets\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 198 \u001b[22m `Core::FileExistsError`, a `std::runtime_error` naming the path, with its partial file removed. A file\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m199\u001b[12G\u001b[38;2;248;248;242malready there is as it was, a directory \u001b[54G the way \u001b[64Gncluded. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mfile \u001b[48;2;92;2;0mis\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mnamed\u001b[48;2;61;1;0m \u0