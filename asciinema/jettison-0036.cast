y w\u001b[49Gite listed\u001b[60Gits\u001b[64Gwh\u001b[67Gl\u001b[69G directory, about thr\u001b[91Ge times slower with 10,000\u001b[K\r\u001b[5C\u001b[1Bfil\u001b[10Gs there.\u001b[19GThe cleanup now looks\u001b[41Gonce\u001b[46Gper\u001b[50Gdirectory\u001b[60Gper\u001b[64Gprocess,\u001b[73Gwhich\u001b[79Gis\u001b[82Genough\u001b[89Gbecause\u001b[97Gcrash\u001b[103Gleftovers\u001b[113Galways\r\u001b[2C\u001b[1B  \u001b[6Gcome from an earlier process.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mThe neutrality test (blocker).\u001b[22m It \u001b[42Gver actually s\u001b[57Garted the world. It\u001b[77Gnow does, and a new\u001b[97Gcheck\u001b[103Gcompares\u001b[112Gthe\r\u001b[2C\u001b[1B  \u001b[6Gshell's world byte for byte with one\u001b[43Ga server starts alone, before and aft\u001b[81Gr five steps.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mThe first-start language (major).\u001b[40G\u001b[22mIt\u001b[43Ghad\u001b[47Gno\u001b[50Gend-to-end\u001b[61Gtest.\u001b[67GIt\u001b[70Gnow\u001b[74Ghas\u001b[78Gone\u001b[82Gthrough\u001b[90Gthe\u001b[94GUI\u001b[97Gstage,\u001b[104Gcovering:\r\u001b[7C\u001b[1Bw\u001b[10Gich locale var\u001b[25Gabl\u001b[29G wins;\r\u001b[12C\u001b[1Bthe choice is kept;\u001b[K\r\u001b[13C\u001b[1B \u001b[38;2;177;185;249m--frame-step\u001b[39m run \u001b[33Gever r\u001b[40Ga\u001b[42Gs the locale;\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- that an unwritable settings file\u001b[41Gdoesn'\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
