[0.065, "o", "\u001b[?25l\u001b[H\r\u001b[1B  \u001b[1mThe world belongs to the game, the screen to the shell.\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gshell\u001b[15Gstops\u001b[21Gadding\u001b[28Gpieces\u001b[35Gof\u001b[38Gits\u001b[42Gown\u001b[46Gto\u001b[49Gthe\u001b[53Gworld.\u001b[60GIt\u001b[63Gonly\u001b[68Greads\u001b[74Gthe\u001b[78Gworld's\u001b[86Gsnapshots\u001b[96Gand\u001b[100Gsends\u001b[106Gcommands,\u001b[116Gas\u001b[119Ga\r\u001b[2C\u001b[1B  remote player\u001b[19Gwould.\r\u001b[2C\u001b[1B-\u001b[5GSo\u001b[8Gthe\u001b[12Gworld\u001b[18Ginside\u001b[25Gthe\u001b[29Gclient\u001b[36Gis\u001b[39Gthe\u001b[43Gserver's\u001b[52Gworld,\u001b[59Gdown\u001b[64Gto\u001b[67Gthe\u001b[71Gbyte.\u001b[77GA\u001b[79Gsave\u001b[84Gmade\u001b[89Gin\u001b[92Gone\u001b[96Gloads\u001b[102Gin\u001b[105Gthe\u001b[109Gother,\u001b[116Gand\r\u001b[1B \u001b[3G  the server's determinism tests cover what the\u001b[51Gclient\u001b[58Gplays.\r\u001b[1B  - What exists only for the scre\u001b[35Gn\u001b[37Gstays\u001b[43Gwith\u001b[48Gthe\u001b[52Gshell:\u001b[59Gsounds\u001b[66Gfor\u001b[70Gevents,\u001b[78Gthe\u001b[82Gmods'\u001b[88Gscripts,\u001b[97Ginput\u001b[103Gand\u001b[107GUI.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it means for a game author:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA game is two classes with separate jobs:\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mHost::Game\u001b[39m holds the rules and the world: its types, its content, its world and its starting state.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mApp::Game\u001b[39m holds the look and feel: input, scenes, UI, sounds, picking and saves.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gshell's\u001b[17Gown\u001b[21Gcopies\u001b[28Gof\u001b[31Gworld\u001b[37Gstart-up\u001b[46G(\u001b[38;2;177;185;249mLoadDefinitions\u001b[39m,\u001b[64G\u001b[38;2;177;185;249mDefine\u001b[39m,\u001b[72Gthe\u001b[76Gworld\u001b[82Ghandle\u001b[89Gin\u001b[92G\u001b[38;2;177;185;249mRegister\u001b[39m)\u001b[102Gare\u001b[106Gremoved.\r\u001b[1B \u001b[3G- If a game wan\u001b[19Gs bodies\u001b[28Gdrawn\u001b[34Gand\u001b[38Gpicked,\u001b[46Gits\u001b[50Gworld\u001b[56Gregisters\u001b[66Gthem\u001b[71Gand\u001b[75Gattaches\u001b[84Gphysics\u001b[92Gitself.\u001b[100GManifest\u001b[109Galready\r\u001b[1B    does.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mWhat it means for Manifest:\u001b[22m\u001b[K\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.179, "o", "\u001b[?25l\u001b[H\r\u001b[99C\u001b[26B\u001b[38;2;153;153;153m7\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
