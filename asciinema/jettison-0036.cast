[0.039, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThat\u001b[8Gmatches\u001b[16GJ30's\u001b[22Gdesign.\u001b[30GThe\u001b[34Gworld\u001b[40Gbelongs\u001b[48Gto\u001b[51Gthe\u001b[55Ggame's\u001b[62G\u001b[38;2;177;185;249mHost::Game\u001b[73G\u001b[39mand\u001b[77Gthe\u001b[81Gshell\u001b[87Gonly\u001b[92Greads\u001b[98Gsnapshots\u001b[108Gand\u001b[112Gsends\r\u001b[1B \u001b[3Gcommands, so\u001b[16Gevery\u001b[22Gcheck lives\u001b[35Ghere\u001b[40Gthe world is. One thing to know:\u001b[73GJ30's local session is for playing\u001b[109Glone or\u001b[K\r\u001b[2C\u001b[1Bh\u001b[5Gsti\u001b[9Gg your\u001b[16Gown world. A client connected to a remot\u001b[58Gserver shouldn't run\u001b[79Ga session at all; it\u001b[100Gshould mirror\u001b[114Gthe\r\u001b[2C\u001b[1Bserver's snapshots. That's Manifest's L15 work,\u001b[51Gbuil\u001b[56G on th\u001b[63G same seam.\u001b[75G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSplitting assets and mods into client and server folders\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFor it:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA\u001b[7Gsmaller server.\u001b[23G\u001b[22mA\u001b[25Gdedicated\u001b[35Gserver\u001b[42Gships\u001b[48Gwithout\u001b[56Gmodels,\u001b[64Gtextures,\u001b[74Gsounds,\u001b[82GUI\u001b[85Gor\u001b[88Gfonts,\u001b[95Gso\u001b[98Git\u001b[101Gstarts\u001b[108Gfaster\u001b[115Gand\r\u001b[2C\u001b[1B \u001b[5Guses less memory.\u001b[23G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA visible trust boundary.\u001b[31G\u001b[22mWhat\u001b[36Gthe\u001b[40Gserver\u001b[47Greads\u001b[53Gdecides\u001b[61Gthe\u001b[65Ggame.\u001b[71GA\u001b[73Gclient-side\u001b[85Gmod\u001b[89Gcan\u001b[93Gonly\u001b[98Gchange\u001b[105Glooks.\u001b[112GWith\u001b[117Gan\r\u001b[2C\u001b[1B \u001b[5Gauthoritative server, nothing the client holds can change the rules\u001b[73Ganyway.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA clear rule for which mods must match.\u001b[22m Only \u001b[51Gerver co\u001b[60Gt\u001b[62Gn\u001b[64G needs to match between\u001b[88Gplayers;\u001b[97Ga\u001b[99Gcosmetic\u001b[108Gclient\u001b[115Gmod\r\u001b[2C\u001b[1B \u001b[5Gneedn't. Saves would record only the server's mods.\u001b[57G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAgainst it:\u001b[22m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
