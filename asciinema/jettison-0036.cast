[0.130, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Greviewed\u001b[17GJ17's\u001b[23Gdiff\u001b[28G(\u001b[38;2;177;185;249m07dbd81\u001b[39m)\u001b[38Gand\u001b[42Git's\u001b[47Gcorrect.\u001b[56G\u001b[38;2;177;185;249mglm::two_pi<float>()\u001b[77G\u001b[39mrounds\u001b[84Gto\u001b[87Gthe\u001b[91Gsame\u001b[96Gfloat\u001b[102Gas\u001b[105Gthe\u001b[109Gold\u001b[113Gliteral,\r\u001b[1B \u001b[3Gso no reference frame\u001b[25Gshould move. It merges\u001b[48Gafter the J30\u001b[62Ggate.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255many other low hanging fruit?\u001b[39m                                                                                          \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Glisted\u001b[15Gfour\u001b[20Gsmall\u001b[26Gfollow-up\u001b[36Gitems:\u001b[43GJ34\u001b[47G(naming\u001b[55Ga\u001b[57Glock's\u001b[64Gholder)\u001b[72Gand\u001b[76GJ32\u001b[80G(a\u001b[83Gno-replace\u001b[94Gdurable\u001b[102Gwrite)\u001b[109Gcan\u001b[113Ggo\u001b[116Gin\r\u001b[2C\u001b[1Blane B after J17 merges, while J29's ground-naming\u001b[54Gand\u001b[58GJ15's\u001b[64Glanguage\u001b[73Gdefault\u001b[81Gwait\u001b[86Gfor\u001b[90GJ30.\u001b[95GShould\u001b[102GI\u001b[104Gqueue\u001b[110GJ34\u001b[114Gand\r\u001b[2C\u001b[1BJ32?\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRun\u001b[7Ging cd '/home/ivan/projects/jettison.lane-c/' && ./sc…\u001b[62G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-c/' && ./scripts/ci.sh --werror --asan --log build/gate.log (13m 23s · 2 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mlines)\u