[0.145, "o", "\u001b[?25l\u001b[H\r\u001b[36C\u001b[1Bd\u001b[39Gcs/persist\u001b[50Gn\u001b[52Ge.md)\u001b[K\r\u001b[11C\u001b[1B\u001b[1m1\u001b[18G\u001b[22m, removed \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[6C\u001b[1B\u001b[2m196 \u001b[22m `RENAME_NOREPLACE` (Linux; the one call is in `core/src/File.cpp`), so there is no check for another\r\u001b[6C\u001b[1B\u001b[2m197 \u001b[22m writer to come between: of two writers making the same file one leaves it whole and the other gets\u001b[K\r\u001b[6C\u001b[1B\u001b[2m198 \u001b[22m `Core::FileExistsError`, a `std::runtime_error` naming the path, with its partial file removed. A file\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m199 -\u001b[38;2;248;248;242malready the\u001b[25G is\u001b[29Gas it\u001b[35Gwas, a directory in the way included. \u001b[48;2;92;2;0mIts\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mpartial \u001b[48;2;61;1;0mfile\u001b[90G\u001b[48;2;92;2;0mis\u001b[93Gnamed\u001b[99Gfor\u001b[103Gits\u001b[107Gwriter\u001b[48;2;61;1;0m,\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m200 -\u001b[38;2;248;248;242m`<name>:partial.<process ID>.<count>`, since two\u001b[72Gon\u001b[76Gfil\u001b[81Gat once\u001b[89Gwould \u001b[96Gtherwis\u001b[104G \u001b[106Grite\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m201 -\u001b[38;2;248;248;242minto \u001b[18Ghe same partial \u001b[35Gnd\u001b[38Gone could\u001b[48Gr\u001b[50Gname the\u001b[59Gother's half-written bytes into place. A crash\u001b[106Gleaves\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m2\u001b[9G2 -\u001b[38;2;248;248;242mthat \u001b[18Ga\u001b[21Gial behind, and nothing removes i\u001b[55G. The file sys\u001b[70Gem must\u001b[78Gsupport\u001b[86Gthe flag (ext4,\u001b[102Gxfs,\u001b[107Gbtrfs\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m199 +\u001b[38;2;248;248;242malready there is as it was, a directory in the way included. \u001b[48;2;4;71;0mThe\u001b[48;2;2;40;0m file \u001b[48;2;4;71;0msystem\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mmust\u001b[48;2;2;40;0m \u001b[48;2;4;71;0msupport\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mflag (ex\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  \u001b[10G +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mt4\u001b[48;2;2;40;0m,\u001b[48;2;4;71;0m xfs, btrfs\u001b[48;2;2;40;0m                                                                                        \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m200 \u001b[22m and\u001b[16Gtmpfs do); on one that\u001b[39Gdoes\u001b[44Gnot,\u001b[49Gthe\u001b[53Gwrite\u001b[59Gthrows\u001b[66Gnaming\u001b[73Gthe\u001b[77Gpath\u001b[82Gand\u001b[86Gthe\u001b[90Greason.\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G1 \u001b[15G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m202 \u001b[12G\u001b[22mA\u001b[14Gmissing direc\u001b[28Gory is \u001b[36Gade by `Core::CreateDirector\u001b[65GesDurably`,\u001b[77Goutermost\u001b[87Gfirst,\u001b[94Geach\u001b[99Gone's\u001b[105Gparent\r\u001b[10C\u001b[2B\u001b[1m3\u001b[22m shell comm\u001b[25Gds…\u001b[K\r\u001b[2C\u001b[4B\u001b[38;2;230;149;117mShenaniganing…\u001b[19G\u001b[38;2;153;153;153m1m 39s\u001b[26G· ↓\u001b[39m \u001b[38;2;153;153;153m7.1k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle)\u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
