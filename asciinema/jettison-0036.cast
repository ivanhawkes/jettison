[0.019, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/session-handoff.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, remov\u001b[27Gd \u001b[1m3\u001b[22m line\u001b[36G\u001b[K\r\u001b[1B     \u001b[2m 20 \u001b[22m The us\u001b[18Gr plays the first loop\u001b[41Gin\u001b[44Gthe\u001b[48Ggraphical\u001b[58Gclient\u001b[65G([\u001b[38;2;230;219;116mL15\u001b[39m](delivery-order.md#l15)),\u001b[97Gnot\u001b[101Gthe\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22mterminal\u001b[20GUI, which\u001b[30Gis mainly for\u001b[44Gadministration (the user's, 2026-11-27). L15 stands o\u001b[98G Je\u001b[102Gtison's\r\u001b[7C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m[\u001b[38;2;230;219;116mJ30\u001b[39m](../../jettison/docs/roadmap.md#j30), started 2026-11-27, and on [\u001b[38;2;230;219;116mL04\u001b[39m](delivery-\u001b[97Grder.md#l04),\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m[L05](delivery-order.md#l05) and [L29](delivery-order.md#l29). The queue's first row, the drives past\u001b[48;2;92;2;0m t\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m  \u001b[11G\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mhe torch ([W22](delivery-order.md#w22)), waits\u001b[48;2;61;1;0m                \u001b[74G   \u001b[78G       \u001b[86G     \u001b[92G    \u001b[97G   \u001b[101G      \u001b[108G      \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m24\u001b[11G\u001b[38;2;248;248;242mfor the first larger hull. Saves still run on the\u001b[48;2;92;2;0m step's thread\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m5\u001b[11G\u001b[38;2;248;248;242m([L40](delivery-order.md#l40), [D-115](decision-ledger.md#d-115)).\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 23 +\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mL05\u001b[38;2;248;248;242m](delivery-order.md#l05) and [\u001b[38;2;230;219;116mL29\u001b[38;2;248;248;242m](delivery-order.md#l29). The queue's first row, the drives past  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mthe torch ([\u001b[38;2;230;219;116mW22\u001b[38;2;248;248;242m](delivery-order.md#w22)), waits \u001b[48;2;2;40;0mfor the first larger hull. Saves still run on the      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[11G\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mst\u001b[14Gp's t\u001b[20Gread \u001b[48;2;2;40;0m([\u001b[38;2;230;219;116mL40\u001b[38;2;248;248;242m](delivery-order.md#l40), [\u001b[38;2;230;219;116mD-115\u001b[38;2;248;248;242m](decision-ledger.md#d-115)).                       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mCommitted\u001b[13G\u001b[1m12ce87c, 63d09ed\u001b[22m,\u001b[31Gsearching\u001b[41Gfor\u001b[45G\u001b[1m3\u001b[47G\u001b[22mpatterns,\u001b[57Greading\u001b[65G\u001b[1m5\u001b[67G\u001b[22mfiles,\u001b[74Grunning\u001b[82G\u001b[1m3\u001b[84G\u001b[22mshell\u001b[90Gcommands…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ wc -l source/engine/host/src/Session.cpp source/engine/app/src/Application.cpp source/engine/app/src/Game.cpp \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153msource/engine/app/\u001b[25Grc/RenderApplication.cpp source/engine/app/src/Mounts.cpp source/engine/host/src/Package.cpp\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
