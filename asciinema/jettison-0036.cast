ns\u001b[92Gis\u001b[95Ganother\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 191 +\u001b[38;2;248;248;242mwriter's, and kept. A crash's partial is an earlier process's, so one                                 \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m2\u001b[12G\u001b[22mlook at a direct\u001b[29Gry a process is enough,\u001b[53Gand a\u001b[59Gwrite after i\u001b[74Gdoes not\u001b[83Glist\u001b[88Gthe\u001b[92Gdirectory\u001b[102Gagain.\u001b[109GA\r\u001b[8C\u001b[1B\u001b[2m3\u001b[12G\u001b[22mfailed\u001b[19Gwrite\u001b[25Gremoves\u001b[33Gits\u001b[37Gown\u001b[41Gpartial\u001b[49Gand\u001b[53Gnever\u001b[59Gone\u001b[63Git\u001b[66Gdid\u001b[70Gnot\u001b[74Gmake.\r\u001b[5C\u001b[1B\u001b[2m 194 \r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B●\u001b[3GRunning\u001b[11Gcd '/home/ivan/projects/jettison.lane-b'\u001b[52G&& ./scr…\u001b[K\r\u001b[2C\u001b[1B⎿\u001b[6G$ cd '/home/ivan/projects/jettison.lane-b'\u001b[49G&&\u001b[52G./scripts/ci.sh\u001b[68G--werror\u001b[77G--asan\u001b[84G--log\u001b[90Gbuild/gate.log\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[13G\u001b[38;2;153;153;153m11\u001b[16G 37s · ↓\u001b[39m \u001b[38;2;153;153;153m16.1k tok\u001b[35Gn\u001b[37G)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.035, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/docs/persistence.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, r\u001b[23Gmoved \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 186 \u001b[12G\u001b[22m4. Th\u001b[18G di\u001b[23Gctory\u001b[29Gis flu\u001b[36Ghed,\u001b[41Gsince\u001b[47Gthe\u001b[51Grename\u001b[58Gis\u001b[61Gan\u001b[64Gentry\u001b[70Gin\u001b[73Gthe\u001b[77Gdirectory.\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22mA\u001b[14Gprocess's\u001b[24Gfirst\u001b[30Gwrite\u001b[36Ginto\u001b[41Ga\u001b[43Gdirectory\u001b[53Gremoves\u001b[61Gthe\u001b[65Gpartial\u001b[73Gfiles\u001b[79Gthere\u001b[85Gthat\u001b[90Gwriters\u001b[98Gwhich\u001b[104Gno\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 189 -\u001b[38;2;248;248;242mlonger run left, as a crash leaves them, and the older shared `<name>:partial`; one named for a       \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m90\u001b[12G\u001b[38;2;248;248;242mproc\u001b[17Gss that runs is another writer's, and kept.\u001b[61GA crash's partial is an ear\u001b[89Gier process's, so one\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 189 +\u001b[38;2;248;248;242mlonger run left, as a crash leaves them: files named exactly so, never another file, and never the    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m90\u001b[12G\u001b[38;2;248;248;242mfile the write is writing, whatever its name. O\u001b[60Ge nam\u001b[66Gd for a proc\u001b[79Gss that runs \u001b[93Gs another    \u001b[107G   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;248;248;242mwriter's, and kept. A crash's partial is \u001b[54Gn earlier process's, s\u001b[77G one\u001b[82G    \u001b[87G    \u001b[92G  \u001b[95G       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m