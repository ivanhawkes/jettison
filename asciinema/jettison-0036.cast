[0.171, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 39m 8s · done 11:55 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mpush it all. Unify the two. L44 approved for now, pending a review at a later date.\u001b[39m                                   \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPushing\u001b[11Gboth\u001b[16Grepos\u001b[22Gfirst,\u001b[29Gsince\u001b[35Geverything\u001b[46Gon\u001b[49G\u001b[38;2;177;185;249mfeature-base\u001b[62G\u001b[39mis\u001b[65Ggated.\u001b[72GThen\u001b[77GI'll\u001b[82Gdo\u001b[85Gthe\u001b[89Gunification\u001b[101Gin\u001b[104Glane\u001b[109GB,\u001b[112Gwith\u001b[117Gits\r\u001b[1B \u001b[3Gown gate befo\u001b[18G it's pushed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth\u001b[8Gare\u001b[12Gpushed:\u001b[20GJettison\u001b[29G\u001b[38;2;177;185;249m1bf0c57..4012867\u001b[39m,\u001b[47GManifest\u001b[56G\u001b[38;2;177;185;249m021e981..cbd2d99\u001b[39m.\u001b[74GNow\u001b[78Gunifying\u001b[87Gthe\u001b[91Gpartial\u001b[99Gnames\u001b[105Gin\u001b[108Glane\u001b[113GB.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, read \u001b[1m2\u001b[22m files, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWriting\u001b[11Gthe\u001b[15Gunified\u001b[23Gversion:\u001b[32Gboth\u001b[37Gwrites\u001b[44Gtake\u001b[49Ga\u001b[51Gpartial\u001b[59Gname\u001b[64Gof\u001b[67Gtheir\u001b[73Gown,\u001b[78Gand\u001b[82Geach\u001b[87Gwrite\u001b[93Gfirst\u001b[99Gremoves\u001b[107Gpartials\u001b[116Gleft\r\u001b[1B \u001b[3Gby writers that are\u001b[23Ggone.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mEditing\u001b[11G~/projects/jettison.lane-b/source/engine/core/src/File.cpp\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~/projects/jettison.lane-b/source/engine/core/src/File.cpp)\r\u001b[2C\u001b[2B\u001b[38;2;228;144;112mShenaniganing…\u001b[39m\u001b[27;1H\u001b[24;24H\u001b[?25h"]
