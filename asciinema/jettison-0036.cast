1b[1B\u001b[38;2;177;185;249m\u001b[1mApp::Game\u001b[39m shrinks (choice 2):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249mLoadDefinitions\u001b[39m, \u001b[38;2;177;185;249mDefine\u001b[39m and\u001b[33G\u001b[38;2;177;185;249mShellWorld\u001b[44G\u001b[39mgo.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mRegister(Shell&)\u001b[22G\u001b[39mkeeps only\u001b[33Gthe input actions.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGround sample:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249mDefineGround\u001b[18G\u001b[39mmoves\u001b[24Gto\u001b[27Gits\u001b[31G\u001b[38;2;177;185;249mHost::Game\u001b[39m's\u001b[44G\u001b[38;2;177;185;249mRegisterWorld\u001b[39m,\u001b[59Gand\u001b[63G\u001b[38;2;177;185;249mMakeGround\u001b[74G\u001b[39mto\u001b[77G\u001b[38;2;177;185;249mCreateInitialState\u001b[39m.\r\u001b[4C\u001b[1BIt registers\u001b[18Gin the \u001b[26Grder\u001b[31Gthe shell does now, so no st\u001b[60Gte-hash pin should move. If one does,\u001b[98GI'll\u001b[103Gprove\u001b[109Gthe\u001b[113Gchange\r\u001b[2C\u001b[1B \u001b[5Gis\u001b[8Gin the bytes\u001b[21Gonly, not\u001b[36Gtate.    \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
