[0.233, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m 48 \u001b[22m ## Ship\u001b[19G and drives\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 49 \r\u001b[2C\u001b[1B\u001b[22m   \u001b[2m 50 \u001b[22m Today a skiff to a corvette flies a\u001b[47Gclean\u001b[53Gfusion\u001b[60G[\u001b[38;2;230;219;116mtorch\u001b[39m](glossary.md#torch).\u001b[88GLarger\u001b[95Ghulls\u001b[101Gcome\u001b[106Gnext,\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m2\u001b[22m scratchpad edits \u001b[38;2;56;166;96m+14\u001b[38;2;153;153;153m, committed \u001b[1mc52c576, e7f0654\u001b[22m, pushed to \u001b[1mdocs-review\u001b[22m, read \u001b[1m55\u001b[22m files, ran \u001b[1m3\u001b[22m shell commands, \r\u001b[2C\u001b[1Brecalled \u001b[1m1\u001b[22m memory, wrote \u001b[1m1\u001b[22m memory \u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth roadmaps now \u001b[22Gave a\u001b[28G\"Wai\u001b[33Ging on you\" sec\u001b[49Gion\u001b[53Glisting everything outstanding that\u001b[89Gisn't already\u001b[103Ga \u001b[106Goadmap it\u001b[116Gm\u001b[118Gor\r\u001b[2C\u001b[1Ba\u001b[5Grow in Manif\u001b[18Gst's queue. Both\u001b[35Gare committed and pushed: Jettison \u001b[38;2;177;185;249mc52c576\u001b[39m, Manifest \u001b[38;2;177;185;249me7f0654\u001b[97G\u001b[39mAll\u001b[101Glinks\u001b[107Gresolve.\r\u001b[2C\u001b[2B\u001b[1mJettison\r\u001b[4C\u001b[1BMerg\u001b[10G the docs review.\u001b[28G\u001b[22mNeither \u001b[38;2;177;185;249mdocs-review\u001b[39m branch is merged. Manifest pins \u001b[38;2;177;185;249m70cd4de\u001b[39m,\u001b[89Gwhich is on that \u001b[107Granch,\u001b[114Gso\r\u001b[2C\u001b[1B \u001b[5Gmerge without squashing\u001b[29Gor\u001b[32Gre-pin\u001b[39GManifest\u001b[48Gafterwards.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKeep or delete three unused pieces:\u001b[41G\u001b[22m\u001b[38;2;177;185;249mScene::ProxyFactory\u001b[39m,\u001b[62G\u001b[38;2;177;185;249mEcs::StateMachine\u001b[39m,\u001b[81Gand\u001b[85Gthe\u001b[89Grenderer's\u001b[100G\u001b[38;2;177;185;249mSetClusterRange\u001b[116G\u001b[39mand\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mSetShadowDistance\u001b[39m.\u001b[24G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNanite:\u001b[22m decide\u001b[20Gwhether\u001b[28Gcluster levels of d\u001b[76GThe research\u001b[89Gwas\u001b[93Gonly\u001b[98Gin\u001b[101Ga\u001b[103Gscratch\u001b[111Gfolder\u001b[27;1H\u001b[24;3H\u001b[?25h"]
