[0.170, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 126 \u001b[22m physics suite's room (`source/engine/physics/tests/RoomTests.cpp`) is a model with a lift and\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 127 \u001b[22m its own gravity, and no star system.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/ai.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 293 \u001b[22m ```\u001b[K\r\u001b[1B     \u001b[2m 294 \u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m5\u001b[12G\u001b[22mManifest\u001b[21Gplots\u001b[27Gits\u001b[31Groutes\u001b[38Gacross\u001b[45Gits\u001b[49Ggalaxy\u001b[56Gwith\u001b[61G`Ai::FindPath`\u001b[76Gand\u001b[80G`Ai::Waypoints`\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 296 -\u001b[38;2;248;248;242m(`source/game/space/src/Routes.cpp` in [Manifest](../../manifest/docs/\u001b[48;2;92;2;0marchitecture\u001b[48;2;61;1;0m.md)).              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 296 +\u001b[38;2;248;248;242m(`source/game/space/src/Routes.cpp` in [\u001b[38;2;230;219;116mManifest\u001b[38;2;248;248;242m](../../manifest/docs/\u001b[48;2;4;71;0mspace\u001b[48;2;2;40;0m.md)).                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 297 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 298 \u001b[22m ### A course round a sphere\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\r\u001b[5C\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWorking…\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;233;154;122mVibing…\u001b[27G\u001b[38;2;153;153;153m5\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
