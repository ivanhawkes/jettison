[0.019, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m  \u001b[38;2;255;255;255mJettison should provide an interface for dock control that allows a game to determine and create it's own rules for \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255madmission, refusal, rank, etc. It should be game agnostic, just supplying the core functions.\u001b[39m                         \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe M\u001b[9Gnifes\u001b[15G gate is st\u001b[27Gll running. Whil\u001b[45Git runs I'm reading \u001b[66Ghrough\u001b[73Gyour\u001b[78Ganswers;\u001b[87GI'll\u001b[92Gedit\u001b[97GManifest's\u001b[108Gcode\u001b[113Gand\u001b[117Gdata\r\u001b[2C\u001b[1Bonly\u001b[8Gafter\u001b[14Gthe\u001b[18Ggate\u001b[23Gfinishes,\u001b[33Gso\u001b[36Gthe\u001b[40Ggate\u001b[45Gchecks\u001b[52Gone\u001b[56Gconsistent\u001b[67Gtree.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mSearched for \u001b[1m12\u001b[22m p\u001b[21Gtte\u001b[25Gns, list\u001b[34Gd \u001b[1m1\u001b[22m directory, ran \u001b[1m92\u001b[22m shell commands, did\u001b[76Gnot run \u001b[1m2\u001b[22m o\u001b[88Gher calls \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/h\u001b[15Gme/ivan/projects/jettison'\u001b[42G&& find \u001b[51G -path\u001b[58G./b\u001b[62Gild -prune -o\u001b[77Gpath ./.g\u001b[87Gt -prune -o -path ./asciinema \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m-prune -o\u001b[16G-path ./.devenv -prune -o -path ./.direnv -prune -o -type d -empty -print\r\u001b[1B  ⎿  2 actions not run · permission denied\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mBash\u001b[22m(find source/samples/space source/test/content/textures/hulls -depth -type d -empty -delete)\u001b[K\r\u001b[1B\u001b