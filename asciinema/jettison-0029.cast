[0.017, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 519 \u001b[12G\u001b[22m-\u001b[14G`universe/station-names.yaml`\u001b[44Gis\u001b[47Gnot\u001b[51Gloaded\u001b[58Guntil\u001b[64Gsomething\u001b[74Ggenerates\u001b[84Gstations.\r\u001b[5C\u001b[1B\u001b[2m 520 \u001b[12G\u001b[22m-\u001b[14GNo\u001b[17Gcontent\u001b[25Gis\u001b[28Gmigrated\u001b[37Gyet:\u001b[42Gformats\u001b[50Gchange\u001b[57Gin\u001b[60Gplace\u001b[66Guntil\u001b[72Gplayer\u001b[79Gtesting\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/manifest/data/trade-items/precious-metals.yaml)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m\u001b[38;2;117;113;94m the first-draft value converted to the unit where it has none.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m \u001b[38;2;117;113;94m# Gold, silver and the platinum group, bars by the troy ounce (31.1034768 grams) as the market\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m  7 -\u001b[38;2;248;248;242m# quotes them, so unitsPerCubicMetre is the ounces in a cubic metre of \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0msolid metal\u001b[48;2;61;1;0m.                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m  7 +\u001b[38;2;117;113;94m# quotes them, so unitsPerCubicMetre is the ounces in a cubic metre of \u001b[48;2;4;71;0mstacked\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mbars\u001b[48;2;2;40;0m.\u001b[38;2;248;248;242m                   \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m8\u001b[11G\u001b[22m\u001b[38;2;166;226;46mitem-base:\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m 9\u001b[13G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[13G\u001b[22m-\u001b[15G\u001b[38;2;166;226;46mitem:\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m3\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~/projects/manifest/docs/sandbox.md)\r\u001b[2B\u001b[38;2;215;119;87m✶\u001b[3GSlithering…\u001b[21G\u001b[38;2;153;153;153m6\r\u001b[99C\u001b[9B7\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
