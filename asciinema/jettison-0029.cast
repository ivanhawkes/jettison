[0.047, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mskip the full gate on this set of changes, if it compiles and the yaml parses its accepted\u001b[39m                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mAgent\u001b[22m(Update\u001b[16GManifest\u001b[25Gtests\u001b[31Gfor\u001b[35Gpacked\u001b[42Gtotes)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded ag\u001b[22Gn\u001b[24G\u001b[38;2;153;153;153m (↓ to manage · ctrl+o to expand)\r\u001b[5C\u001b[1BMessage queued for\u001b[25Gdelivery to a629ddc8568305472 at its next tool round. Sending this moved nothing it is \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mrunning\u001b[14Gto the\u001b[21Gbackground just\u001b[37Gnow, so the message waits for\u001b[68Ghat\u001b[77G unless something moves sooner.\u001b[109GIf\u001b[112Git \r\u001b[5C\u001b[1Bfi\u001b[9Gishes first, it is resumed with the\u001b[45Gmessage \u001b[54Gnd\u001b[57Gnotifies again, so wait for\u001b[85Gthat notification before \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mresending.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m6\u001b[22m patterns, ran \u001b[1m6\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNow\u001b[7Gthe\u001b[11Gdocs:\u001b[17GJettison\u001b[26GJ35,\u001b[31Gthe\u001b[35Gdock\u001b[40Gcontrol\u001b[48Ginterface.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mEditing\u001b[11Gdocs/docks.md\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(docs/docks.md)\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
[0.070, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 283 \r\u001b[1B\u001b[22m     \u001b[2m 284 \u001b[22m Cheap to add when wanted, or waiting on a profile, and costing nothing meanwhile, except the log\u001b[K\r\u001b[2C\u001b[2B\u001b[1mUpda\u001b[8Ge\u001b[22m(docs/docks.md)\u001b[25G\u001b[K\r\u001b[5C\u001b[1BAdded \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 365 \u001b[22m - The way in replaces its stop along the normal, and a reservation lapses when a vehicle stops\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 366 \u001b[22m   making progress rather than at a fixed time: [\u001b[38;2;230;219;116mJ09\u001b[39m](roadmap.md#j09).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 367 \u001b[22m - Steering's course goes round a platform's sphere, not round its inside: [\u001b[38;2;230;219;116mJ08\u001b[39m](roadmap.md#j08).\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 368 +\u001b[38;2;248;248;242m- A game has no say in who docks: admitting, refusing and ranking arrivals by its own rules is        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 369 +\u001b[38;2;248;248;242m  [\u001b[38;2;230;219;116mJ35\u001b[38;2;248;248;242m](roadmap.md#j35).                                                                              \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[2m 370 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 371 \u001b[12G\u001b[22m##\u001b[15GDecisions\r\u001b[1B \u001b[3G   \u001b[2m 372 \u001b[22m\u001b[K\r\u001b[2C\u001b[2BSearching for \u001b[1m1\u001b[22m pattern,\u001b[28Grunning\u001b[36G\u001b[1m1\u001b[38G\u001b[22mshell\u001b[44Gcommand…\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ sed -n 1,40p docs/roadmap.md\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3G\u001b[38;2;218;124;92mSlithering…\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m2\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
