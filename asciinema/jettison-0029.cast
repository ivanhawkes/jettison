9m copper =\u001b[35Gstd::ranges::\u001b[38;2;166;226;46mfind\u001b[39m(\r\u001b[9C\u001b[1B\u001b[2m5\u001b[15G\u001b[22m    content.gam\u001b[31GMode.items, std\u001b[48Gstring{\u001b[38;2;230;219;116m\"ItemCopper\"\u001b[39m},\u001b[70G&Manifest::Core::ItemNode::itemId);\r\u001b[9C\u001b[1B\u001b[2m6\u001b[15G\u001b[22m\u001b[38;2;166;226;46mREQUIRE\u001b[39m(copper != content.gameMode.items.\u001b[38;2;166;226;46mend\u001b[39m());\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 1367 -\u001b[38;2;248;248;242m  CHECK(copper->unitsPerCubicMetre == \u001b[48;2;92;2;0m8\u001b[48;2;61;1;0m.\u001b[48;2;92;2;0m96\u001b[48;2;61;1;0m);                                                         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1367 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(copper->unitsPerCubicMetre == \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m7\u001b[48;2;2;40;0m.\u001b[48;2;4;71;0m616\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m);                                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 1368 \u001b[22m }\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m2\u001b[13G\u001b[22mshell\u001b[19Gcommands\u001b[38;2;153;153;153m · 29s\u001b[39m…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && ctest --test-dir build/clang-debug -j 24 --output-on-failure -E 'fixture' \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m(3s · 202 lines)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
