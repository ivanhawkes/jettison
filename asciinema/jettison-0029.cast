[0.059, "o", "\u001b[?25l\u001b[H\u001b[3Gmerge\u001b[9Gcommit.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mJettison:\u001b[22m \u001b[38;2;177;185;249mmain\u001b[20G\u001b[39mis\u001b[23Gat\u001b[26G\u001b[38;2;177;185;249mf7d79f9\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mmain\u001b[20G\u001b[39mis\u001b[23Gat\u001b[26G\u001b[38;2;177;185;249m7576f10\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBecause nothing wa\u001b[23Gsquashed, Manifest's\u001b[44Gpin,\u001b[49G\u001b[38;2;177;185;249m70cd4de\u001b[39m,\u001b[58Gis\u001b[61Gnow\u001b[65Ga\u001b[67Gcommit\u001b[74Gon\u001b[77GJettison's\u001b[88G\u001b[38;2;177;185;249mmain\u001b[39m.\r\u001b[4C\u001b[2Bfore merging,\u001b[19GI added on\u001b[30G small commit\u001b[44Gto each branch that removes \u001b[73Ghe \"m\u001b[79Grge the docs review\"\u001b[100Gline\u001b[105Gfrom\u001b[110Gboth\r\u001b[2C\u001b[1Broadmaps'\u001b[13G\"Waiting\u001b[22Gon\u001b[25Gyou\"\u001b[30Glists.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJettison\u001b[12Gs merge bri\u001b[24Ggs in\u001b[30G\u001b[38;2;177;185;249masciinema/jettison-0028.cast\u001b[39m,\u001b[60Gwhich\u001b[66Gyou\u001b[70Gcommitted\u001b[80Gon\u001b[83Gthe\u001b[87Gbranch\u001b[94Gyourself.\r\u001b[2C\u001b[2BBo\u001b[6Gh repo\u001b[14Gare now checked\u001b[30Gout on \u001b[39G\u001b[38;2;177;185;249min\u001b[39m, and I left the \u001b[38;2;177;185;249mdocs-review\u001b[70G\u001b[39mbranches in place.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 1m 1s · done 7:47 pm\u001b[34G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mdelete the docs-review branches\u001b[39m                                                                                       \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[39m Working…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
