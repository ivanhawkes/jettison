[0.175, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mskip the full gate on this set of changes, if it compiles and the yaml parses its accepted\u001b[39m                            \r\u001b[2B\u001b[49m\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mAgent\u001b[22m(Update Manifest tests for packed totes)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mBackgrounded\u001b[19Gagent\u001b[38;2;153;153;153m (↓ to manage · ctrl+o to expand)\r\u001b[1B  ⎿  Message queued for delivery to a629ddc8568305472 at its next tool round. Sending this moved nothing it is \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mrunning to the background just now, so the m\u001b[51Gss\u001b[54Gge waits for that round unless something moves sooner. If it \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mfinish\u001b[13Gs first, it\u001b[25Gis resumed with the message and no\u001b[60Gifi\u001b[64Gs again, so wait for that notification before \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;153;153;153mesending.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSea\u001b[7Gch\u001b[10Gd for \u001b[1m6\u001b[22m patterns, ran \u001b[1m6\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNow the docs: Jettison J35, the dock control interface.\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mW\u001b[5Grking…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;218;124;92mSlithering…\u001b[21G\u001b[38;2;153;153;153m4\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
