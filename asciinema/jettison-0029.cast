[2.149, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBo\u001b[7G roadmaps now have a \"Waiting on you\" section listing everything outs\u001b[77Ganding that is\u001b[92G't already\u001b[103Ga\u001b[105Groadmap\u001b[113Gitem\u001b[118Gor\r\u001b[2C\u001b[1Ba\u001b[5Grow\u001b[9Gin\u001b[12GManifest's\u001b[23Gqueue.\u001b[30GBoth\u001b[35Gare\u001b[39Gcommitted\u001b[49Gand\u001b[53Gpushed:\u001b[61GJettison\u001b[70G\u001b[38;2;177;185;249mc52c576\u001b[39m,\u001b[79GManifest\u001b[88G\u001b[38;2;177;185;249me7f0654\u001b[39m.\u001b[97GAll\u001b[101Glinks\u001b[107Gresolve.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison\u001b[22m (\u001b[38;2;177;185;249mdocs/roadmap.md#waiting-on-you\u001b[39m):\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMerge th\u001b[14G docs review.\u001b[22m Neither\u001b[36G\u001b[38;2;177;185;249mdocs-review\u001b[48G\u001b[39mbranch\u001b[55Gis\u001b[58Gmerged.\u001b[66GManifest\u001b[75Gpins\u001b[80G\u001b[38;2;177;185;249m70cd4de\u001b[39m,\u001b[89Gwhich\u001b[95Gis\u001b[98Gon\u001b[101Gthat\u001b[106Gbranch,\u001b[114Gso\r\u001b[4C\u001b[1Bmerg\u001b[11Gw\u001b[13Gthout\u001b[20Gquashing or re-pin Manifest\u001b[48Gafterwards.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKeep or delete three unused pieces:\u001b[22m \u001b[38;2;177;185;249mScene::ProxyFactory\u001b[39m,\u001b[62G\u001b[38;2;177;185;249mEcs::StateMachine\u001b[39m,\u001b[81Gand\u001b[85Gthe\u001b[89Grenderer's\u001b[100G\u001b[38;2;177;185;249mSetClusterRange\u001b[116G\u001b[39mand\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mSetShadowDistance\u001b[39m.\u001b[24G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNanite:\u001b[22m decide whether clus\u001b[33Ger levels of detail\u001b[53Gbecome\u001b[60Ga\u001b[62Gbacklog\u001b[70Gitem.\u001b[76GThe\u001b[80Gresearch\u001b[89Gwas\u001b[93Gonly\u001b[98Gin\u001b[101Ga\u001b[103Gscratch\u001b[111Gfolder\r\u001b[2C\u001b[1B \u001b[5Gthat gets cleared, so I moved it to \u001b[38;2;177;185;249mdocs/nanite-research.md\u001b[39m and\u001b[69Gadded\u001b[75Git\u001b[78Gto\u001b[81Gthe\u001b[85Gdocs\u001b[90Gindex.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mdocs/roadmap.md#waiting-on-you\u001b[39m):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumbers to review:\u001b[22m \u001b[25Ghe\u001b[28G30× price bound ag\u001b[47Ginst pri\u001b[57Gs\u001b[59Greaching\u001b[68Gabout\u001b[74G27×\u001b[78G(L51),\u001b[85Gand\u001b[89GD-108's\u001b[97Gdrive\u001b[103Gnumbers.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe packed-tote change:\r\u001b[2C\u001b[1B\u001b[22m  -\u001b[7Gthe fixture suit\u001b[24Gs\u001b[26Gwere never run on it;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe\u001b[11Gagent's\u001b[19Gtest\u001b[24Gedits\u001b[30Ghaven't\u001b[38Gbeen\u001b[43Greviewed;\r\u001b[2C\u001b[1B \u001b[5G- nob\u001b[11Gdy\u001b[14Gknows yet\u001b[24Gwhy the\u001b[32GAI now opens 6 t\u001b[49Gnders where the test\u001b[70Gexpected 2.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMerging the docs review\u001b[22m,\u001b[30Gwith\u001b[35GJettison's.\r\u001b[1B \u001b[3G- \u001b[1mWhether to delete \u001b[38;2;177;185;249mdata/core-config/\u001b[22m\u001b[39m,\u001b[42Ga\u001b[44Ggit-ignored\u001b[56Gleftover.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
