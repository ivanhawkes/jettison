 [\u001b[38;2;230;219;116meconomy plan\u001b[39m](economy-and-dev\u001b[42Glopme\u001b[48Gt-plan.\u001b[56Gd).\u001b[60GThe\u001b[64Gbuilt rules (ho\u001b[80Gseholds and their needs,\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 80 \u001b[22m health and happiness,\u001b[33Ggrains and medical \u001b[53Gupplies) \u001b[63Gre [\u001b[38;2;230;219;116mthe regional economy\u001b[39m](econ\u001b[94Gmy.md), with\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 81 \u001b[11G\u001b[22m[\u001b[38;2;230;219;116mtrading\u001b[39m](trading.md)\u001b[33Gand\u001b[37G[\u001b[38;2;230;219;116mprices\u001b[39m](pricing.md).\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Recalling \u001b[1m1\u001b[22m memory, writing \u001b[1m2\u001b[22m memories…\u001b[K\r\u001b[18C\u001b[8B\u001b[38;2;153;153;153m(shift+tab to cycle)\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
