[0.096, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 125 -\u001b[38;2;248;248;242mplanets pull as point masses ([Manifest's \u001b[48;2;92;2;0marchitecture\u001b[48;2;61;1;0m](../../manifest/docs/\u001b[48;2;92;2;0marchitecture\u001b[48;2;61;1;0m.md)). The    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 125 +\u001b[38;2;248;248;242mplanets pull as point masses ([\u001b[38;2;230;219;116mManifest's \u001b[48;2;4;71;0mspace document\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m](../../manifest/docs/\u001b[48;2;4;71;0mspace\u001b[48;2;2;40;0m.md)). The         \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m126 \u001b[22m physics\u001b[20Gsuite's\u001b[28Groom (`source/engine/physic\u001b[56G/tests/RoomTests.cpp`) is\u001b[82Ga model with a lift and\u001b[106G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m127 \u001b[22m its own gravity,\u001b[29Gand\u001b[33Gno star\u001b[41Gsystem.\u001b[K\r\u001b[6C\u001b[1B\u001b[2m128 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/ai.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[14G\u001b[22ml\u001b[16Gne, removed \u001b[1m1\u001b[22m line\u001b[35G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m293 \u001b[22m ```\u001b[K\r\u001b[6C\u001b[1B\u001b[2m294 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m295 \u001b[22m Manifest plots its routes acr\u001b[42Gss\u001b[45Gits g\u001b[51Glaxy with `A\u001b[64G::FindPath` and\u001b[80G`Ai::Waypoints`\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 296 -\u001b[38;2;248;248;242m(`source/game/space/src/Routes.cpp` in [Manifest](../../manifest/docs/\u001b[48;2;92;2;0marchitecture\u001b[48;2;61;1;0m.md)).              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 296 +\u001b[38;2;248;248;242m(`source/game/space/src/Routes.cpp` in [\u001b[38;2;230;219;116mManifest\u001b[38;2;248;248;242m](../../manifest/docs/\u001b[48;2;4;71;0mspace\u001b[48;2;2;40;0m.md)).                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 297 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 298 \u001b[22m ### A cours\u001b[24G round a sphere\u001b[K\r\u001b[1B     \u001b[2m 299 \u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;228;144;112mVibing…\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle)\u001b[39m\u001b[27;1H\u001b[21;3H\u001b[?25h"]
