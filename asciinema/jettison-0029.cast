[0.233, "o", "\u001b[?25l\u001b[H\u001b[3G  item.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mClustered geom\u001b[20Gtry\u001b[24Gdrawn with mesh shaders:\u001b[22m about 5–8 weeks in total. Full Nanite parity i\u001b[97Groughly\u001b[105G6–9 months.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree conflicts to settle first:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- The scope doc lists occlusion culling as\u001b[48GOut.\u001b[K\r\u001b[4C\u001b[1B- The\u001b[11Ganti-aliasing\u001b[25Gis\u001b[28GMSAA,\u001b[34Gwhich\u001b[40Ga\u001b[42Gvisibility\u001b[53Gbuffer\u001b[60Gcan't\u001b[66Guse.\r\u001b[2C\u001b[1B \u001b[5G- \"Cluster\" already means the lighting grid, s\u001b[52G \u001b[54Ghe geom\u001b[62Gtry units would be call\u001b[86Gd meshlet\u001b[96G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIs it\u001b[11Gneeded?\u001b[22m Manifest's content\u001b[38Gis\u001b[41Gprocedural\u001b[52Gshapes\u001b[59Gand\u001b[63Gmid-poly\u001b[72GglTF,\u001b[78Gso\u001b[81GI'd\u001b[85Gonly\u001b[90Ggo\u001b[93Gbeyond\u001b[100Gthe\u001b[104Gfirst\u001b[110Gsteps\u001b[116Gonce\r\u001b[4C\u001b[1Bthat content shows a real cost.\u001b[37G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNew layout:\u001b[22m \u001b[38;2;177;185;249mdocs/README.md\u001b[39m is the index. There\u001b[52Gare 16\u001b[59Gfeature d\u001b[69Gcs\u001b[72Gwritten against the code, plus a glossary of 131\r\u001b[5C\u001b[1Berms a\u001b[13Gd five plans\u001b[26Gth\u001b[29Gt\u001b[31Gh\u001b[33Gld open\u001b[41Gwork\u001b[46Gonly.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHistory folder:\u001b[21G\u001b[22mthe\u001b[25G15\u001b[28Gclosed\u001b[35Gplans\u001b[41Gand\u001b[45Gassessments\u001b[57Gmoved\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mdocs/history/\u001b[39m,\u001b[81Gand\u001b[85G\u001b[38;2;177;185;249mhistory.md\u001b[96G\u001b[39mis\u001b[99Gnow\u001b[103Gits\u001b[107Gindex,\u001b[114Gwith\r\u001b[2C\u001b[1B  the old\u001b[13Gentries\u001b[21Gsplit\u001b[27Gby\u001b[30Gstage.\r\u001b[4C\u001b[1B\u001b[1mQueue:\u001b[22m \u001b[38;2;177;185;249mdelivery-order.md\u001b[39m holds only open\u001b[46Gwork,\u001b[52Go\u001b[54Gdered 1 \u001b[63Go 48. The duplicate L16 is split (moongates are now L35),\r\u001b[4C\u001b[1Band the fin\u001b[17Gshed rows are\u001b[31Gin \u001b[38;2;177;185;249mhistory/tasks.md\r\u001b[4C\u001b[1B\u001b[39m\u001b[1mNew queue rows L35–L50:\u001b[22m these\u001b[35Ginclude the \u001b[48Gpace i\u001b[55Gems that left Jettison's roa\u001b[84Gmap, saves off\u001b[99Gthe\u001b[103Gs\u001b[105Gep's thread, and\r\u001b[4C\u001b[1Bgaps the writ\u001b[19Grs found (L42–L50).\u001b[39GSome\u001b[44Gof\u001b[47Gthose\u001b[53Ggaps\u001b[58Ggo\u001b[61Gbeyond\u001b[68Gwhat\u001b[73Gyou\u001b[77Gasked\u001b[83Gfor,\u001b[88Gso\u001b[91Gplease\u001b[98Gconfirm\u001b[106Gthem:\r\u001b[2C\u001b[1B \u001b[5G- region supply\u001b[K\r\u001b[4C\u001b[1B- four languag\u001b[20Gs\u001b[22G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.151, "o", "\u001b[?25l\u001b[H\u001b[5G- The\u001b[11Gscope\u001b[17Gdoc\u001b[21Glists\u001b[27Gocclusion\u001b[37Gculling\u001b[45Gas\u001b[48GOut.\r\u001b[2C\u001b[1B \u001b[5G- The anti-aliasing is MSAA, which a visibility buffer can't use.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \"Cluster\" already means the lighting\u001b[44Ggrid,\u001b[50Gso\u001b[53Gthe\u001b[57Ggeometry\u001b[66Gunits\u001b[72Gwould\u001b[78Gbe\u001b[81Gcalled\u001b[88Gmeshlets.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIs it needed?\u001b[22m Man\u001b[23Gfe\u001b[26Gt's conte\u001b[36Gt is procedural shapes\u001b[59Gand\u001b[63Gmid-poly\u001b[72GglTF,\u001b[78Gso\u001b[81GI'd\u001b[85Gonly\u001b[90Ggo\u001b[93Gbeyond\u001b[100Gthe\u001b[104Gfirst\u001b[110Gsteps\u001b[116Gonce\r\u001b[4C\u001b[1Bthat co\u001b[14Gent shows a real cost.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew layout:\u001b[22m \u001b[38;2;177;185;249mdocs/README.md\u001b[39m i\u001b[34G the\u001b[39Gindex.\u001b[46GThere\u001b[52Gare\u001b[56G16\u001b[59Gfeature\u001b[67Gdocs\u001b[72Gwritten\u001b[80Gagainst\u001b[88Gthe\u001b[92Gcode,\u001b[98Gplus\u001b[103Ga\u001b[105Gglossary\u001b[114Gof\u001b[117G131\r\u001b[4C\u001b[1Bterms\u001b[11Gand\u001b[15Gfive\u001b[20Gplans\u001b[26Gthat\u001b[31Ghold\u001b[36Gopen\u001b[41Gwork\u001b[46Gonly.\r\u001b[2C\u001b[1B- \u001b[1mH\u001b[7Gstory folder:\u001b[21G\u001b[22mthe\u001b[25G15\u001b[28Gclosed\u001b[35Gplans\u001b[41Gand\u001b[45Gassessments\u001b[57Gmoved\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mdocs/history/\u001b[39m,\u001b[81Gand\u001b[85G\u001b[38;2;177;185;249mhistory.md\u001b[96G\u001b[39mis\u001b[99Gnow\u001b[103Gits\u001b[107Gindex,\u001b[114Gwith\r\u001b[2C\u001b[1B \u001b[5Gthe old entries split by stage.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mQueue:\u001b[22m \u001b[38;2;177;185;249mdelivery-order.md\u001b[39m holds\u001b[37Gnly\u001b[41Gopen\u001b[46Gwork,\u