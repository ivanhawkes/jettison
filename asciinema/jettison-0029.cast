[0.119, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 167 \u001b[22m     H->>K: buys each need's shortfall up to a × (1 + 3p)\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 168 \u001b[22m     K-->>H: fills against asks; nothing rests\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[16G\u001b[22mB\u001b[23Grequotes th\u001b[35G ladders its stock has\u001b[58Gmoved\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifes\u001b[29G/docs/pricing.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 165 \u001b[22m     E->>K: sell\u001b[28G its made goods \u001b[45Gown\u001b[49Gto\u001b[52Gits\u001b[56Gfloor\r\u001b[1B     \u001b[2m 166 \u001b[12G\u001b[22m \u001b[14G  K-->>E: fills\u001b[30Gagainst\u001b[38Gthe\u001b[42Gbroker's\u001b[51Gbids,\u001b[57Gthe\u001b[61Grest\u001b[66Gkept\r\u001b[8C\u001b[1B\u001b[2m7\u001b[16G\u001b[22mH\u001b[23Gbuys each\u001b[33Gneed's shortfall up \u001b[54Go\u001b[56Ga × (1\u001b[63G+\u001b[65G3p)\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 168 -\u001b[38;2;248;248;242m    K-->>H: fills against asks\u001b[48;2;92;2;0m;\u001b[48;2;61;1;0m nothing rests                                                         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 168 +\u001b[38;2;248;248;242m    K-->>H: fills against asks\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m nothing rests                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 169 \u001b[22m     B->>K: requotes the ladders its stock has moved\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 170 \u001b[22m ```\u001b[K\r\u001b[7C\u001b[1B\u001b[2m71\u001b[16G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+11\u001b[38;2;153;153;153m, read \u001b[1m1\u001b[22m file, ran \u001b[1m5\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitting Je\u001b[17Gtison\u001b[23Gnow:\u001b[28Ga code commit for the aud\u001b[54Go fade and\u001b[65Gthe durable\u001b[77Gdirectories,\u001b[90Gthen\u001b[95Ga\u001b[97Gdocs\u001b[102Gcommit\u001b[109Gfor\u001b[113Gyour\r\u001b[1B  answers and the Manifest links.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
