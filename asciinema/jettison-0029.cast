b[1mNew layout:\u001b[17G\u001b[22m\u001b[38;2;177;185;249mdocs/README.md\u001b[32G\u001b[39mis\u001b[35Gthe\u001b[39Gindex.\u001b[46GThere\u001b[52Gare\u001b[56G16\u001b[59Gfeature\u001b[67Gdocs\u001b[72Gwritten\u001b[80Gagainst\u001b[88Gthe\u001b[92Gcode,\u001b[98Gplus\u001b[103Ga\u001b[105Gglossary\u001b[114Gof\u001b[117G131\r\u001b[2C\u001b[1B \u001b[5Gterms and five plans that hold open work\u001b[46Gonly.\u001b[52G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHistory folder:\u001b[22m the 15 closed plans\u001b[41Gand assessments\u001b[57Gmoved\u001b[63Gto\u001b[66G\u001b[38;2;177;185;249mdocs/history/\u001b[39m,\u001b[81Gand\u001b[85G\u001b[38;2;177;185;249mhistory.md\u001b[96G\u001b[39mis\u001b[99Gnow\u001b[103Gits\u001b[107Gindex,\u001b[114Gwith\r\u001b[2C\u001b[1B \u001b[5Gthe old entries\u001b[21Gsplit by stage.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mQueue:\u001b[22m \u001b[38;2;177;185;249mdelivery-order.md\u001b[30G\u001b[39mholds only\u001b[41Gopen\u001b[46Gw\u001b[75Gplicate\u001b[83GL16\u001b[87Gis\u001b[90Gsplit\u001b[96G(moongates\u001b[107Gare\u001b[111Gnow\u001b[115GL35),\u001b[27;1H\u001b[24;3H\u001b[?25h"]
