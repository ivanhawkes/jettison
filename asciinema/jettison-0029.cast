[0.003, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Both \u001b[38;2;177;185;249mdocs-review\u001b[39m branches are merged into \u001b[38;2;177;185;249mmain\u001b[39m and pushed. Neither \u001b[38;2;177;185;249mmain\u001b[39m had moved, so both were fast-forwards\u001b[113Gwith\u001b[118Gno\r\u001b[2C\u001b[1Bmerge\u001b[9Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mmain\u001b[20G\u001b[39mis\u001b[23Gat\u001b[26G\u001b[38;2;177;185;249mf7d79f9\u001b[39m.\r\u001b[1B \u001b[3G- \u001b[1mManifest:\u001b[22m \u001b[38;2;177;185;249mmain\u001b[20G\u001b[39mis at \u001b[38;2;177;185;249m7576f10\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBecause\u001b[11Gnothing\u001b[19Gwas\u001b[23Gsquashed,\u001b[33GManifest's\u001b[44Gpin,\u001b[49G\u001b[38;2;177;185;249m70cd4de\u001b[39m,\u001b[58Gis\u001b[61Gnow\u001b[65Ga\u001b[67Gcommit\u001b[74Gon\u001b[77GJettison's\u001b[88G\u001b[38;2;177;185;249mmain\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBefore merging, I added one small\u001b[37Gcommit\u001b[44Gto\u001b[47Geach\u001b[52Gbranch\u001b[59Gthat\u001b[64Gremoves\u001b[72Gthe\u001b[76G\"merge\u001b[83Gthe\u001b[87Gdocs\u001b[92Greview\"\u001b[100Gline\u001b[105Gfrom\u001b[110Gboth\r\u001b[2C\u001b[1Broadmaps'\u001b[13G\"Waiting\u001b[22Gon\u001b[25Gyou\"\u001b[30Glists.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJettison's\u001b[14Gmerge\u001b[20Gbrings\u001b[27Gin\u001b[30G\u001b[38;2;177;185;249masciinema/jettison-0028.cast\u001b[39m,\u001b[60Gwhich\u001b[66Gyou\u001b[70Gcommitted\u001b[80Gon\u001b[83Gthe\u001b[87Gbranch\u001b[94Gyourself.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BB\u001b[5Gth repos are now\u001b[22Gchecked\u001b[30Gout on\u001b[37G\u001b[38;2;177;185;249mmain\u001b[39m,\u001b[43Gand\u001b[47GI\u001b[49Gleft\u001b[54Gthe\u001b[58G\u001b[38;2;177;185;249mdocs-review\u001b[70G\u001b[39m