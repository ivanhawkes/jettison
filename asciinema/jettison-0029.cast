[0.355, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 73 +\u001b[38;2;248;248;242mThe [\u001b[38;2;230;219;116mhost/script boundary\u001b[38;2;248;248;242m](docs/\u001b[48;2;4;71;0mhistory/\u001b[48;2;2;40;0mhost-script-boundary.md) assigns authoritative rules to linked \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 74 \u001b[22m native game\u001b[23Gcode\u001b[28Gand\u001b[32Gbounded\u001b[40Gpolicy\u001b[47Gdecisions\u001b[57Gto\u001b[60GWasm.\u001b[66GMarket\u001b[73Gprices\u001b[80Gnow\u001b[84Guse\u001b[88Gan\u001b[91Gexact\u001b[97Gdecimal\r\u001b[6C\u001b[1B\u001b[2m7\u001b[11G\u001b[22mrepresentation; other continuous values retain floats/doubles. Shipping gameplay\u001b[92Gstill needs\u001b[104G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m76\u001b[11G\u001b[22mthe VFS load\u001b[24Grs, world adapters\u001b[43Gand\u001b[47Gscripted\u001b[56Gscenario\u001b[65Gin\u001b[68Gthe\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m96 \u001b[22m `Manife\u001b[20Gt::Core` namespace.\r\u001b[6C\u001b[1B\u001b[2m 97 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m98 \u001b[22m [\u001b[38;2;230;219;116mArchitecture\u001b[39m](doc\u001b[31G/architecture.md),\u001b[50G[\u001b[38;2;230;219;116mcoding standards\u001b[39m](docs/coding-standards.md),\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m  99 -\u001b[38;2;248;248;242m[scope](docs/scope.md), and [model reference](docs/\u001b[48;2;92;2;0mmodel\u001b[48;2;61;1;0m.md) describe the implementation.             \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m99 +\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mscope\u001b[38;2;248;248;242m](docs/scope.md), and [\u001b[38;2;230;219;116mmodel reference\u001b[38;2;248;248;242m](docs/\u001b[48;2;4;71;0mcontent\u001b[48;2;2;40;0m.md)\u001b[75Gdescribe\u001b[84Gthe\u001b[88Gimplementation.\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 100 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 101 \u00