[0.323, "o", "\u001b[?25l\u001b[H\r\u001b[81C\u001b[7B\u001b[38;2;153;153;153m1\r\u001b[95C\u001b[2B4\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.269, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mcontinue\u001b[39m                                                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mdocs-review\u001b[22m, searched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m6\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ L35-L50: I confirm them all\u001b[39m                                                                                           \r\u001b[1B  \u001b[38;2;153;153;153mDelete the leftover empty folders.\u001b[39m                                                                                    \r\u001b[1B  \u001b[38;2;153;153;153mTote pricing must be set by it's actual weight. Fix weights that are incorrect. There is data available for packing \u001b[39m  \r\u001b[1B  \u001b[38;2;153;153;153mdensity and weight / density of all the items so you can work out the weight of a tote with any given item.\u001b[39m           \r\u001b[1B  \u001b[38;2;153;153;153mWhich development sandbox? If there is one in jettison, then probably yes, and each project builds it's own sandbox \u001b[39m  \r\u001b[1B  \u001b[38;2;153;153;153mas needed.\u001b[14GJett\u001b[19Gson should only provide structure, support, code, for common features or features that are exclusive \r\u001b[2C\u001b[1Bto jettison and not\u001b[24Gx\u001b[26Gected to be overridden by manifest and other games.\r\u001b[2C\u001b[1BSe\u001b[6G val\u001b[11Gdation to\u001b[21G30\u001b[24Gtimes now, but that does seem like a massive amou\u001b[74Gt of price inflation so schedu\u001b[107Ga task to \u001b[39m  \r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mevaluate what \u001b[18Gs causing \u001b[30G and\u001b[35Gif i\u001b[40G should stay at\u001b[56Gthat value.\u001b[39m                                           \r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRemind me t\u001b[15G r\u001b[18Gview those number once the next s\u001b[52Gep\u001b[55G are do\u001b[63Ge.\u001b[39m                                                      \r\u001b[2C\u001b[1B                                                                                                                     \r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mJettison shoul\u001b[19Gprovide an in\u001b[33Gerface fo\u001b[43G \u001b[45Gock\u001b[49Gcontrol that all\u001b[66Gws a\u001b[75G to determine and create it's own rules for \r\u001b[1B\u001b[39m  \u001b[38;2;153;153;153madmission, refusal, rank, etc. It should be game agnostic, just supplying the core functions.\u001b[39m                         \r\u001b[2C\u001b[5B\u001b[49m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
