[0.058, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m  \u001b[38;2;255;255;255mthat can be completed concurrently with low risk of merge conflicts. We will do all the work at once, and only run \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mthe full gate after merging all of the individual work pieces. Smaller work tasks might be added as lanes become idle\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mand th\u001b[10Gse should\u001b[20Galso be completed, committed, and prep\u001b[59Gred to\u001b[66Gmerge with the other tasks.\u001b[94GThe idea is to\u001b[109Gredu\u001b[114Ge \u001b[117Ghe\u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mnumber of times w\u001b[21G ru\u001b[25G th\u001b[29G full\u001b[35Ggate to speed up development cycl\u001b[69Gs without running into cha\u001b[96Gs and\u001b[102Gke\u001b[105Gping merge \u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mconflicts and int\u001b[21Ggrati\u001b[28G issues lo\u001b[39G.\u001b[39m                                                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRecalled \u001b[1m4\u001b[22m memories, wrote \u001b[1m4\u001b[22m memories \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Resuming agent a673fc8\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Resuming agent ad0d4cb\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd '/home/ivan/projects/jettison.lane-b/'\u001b[53G&&\u001b[56Gscri…\r\u001b[4C\u001b[1B\u001b[38;2;153;153;153m $ cd '/home/ivan/projects/jettison.lane-b/' && scripts/heavy.sh cmake --build --preset clang-debug --target \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mj\u001b[8Gttison_host_tests 2>&1 | grep -E \"error|warning:\" -A3 | head -40 (3m 21s)\u001b[39m\u001b[27;1H\u001b[18;3H\u001b[?25h"]
[0.063, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mof \u001b[7Ghem is com\u001b[18Git\u001b[21Gd and merged, and whether\u001b[47Gwe can sta\u001b[58Gt to re-use them. Then pick out t\u001b[93G to four pieces\u001b[110Gf wo\u001b[115Gk \u001b[39m \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mat can\u001b[12Gbe compl\u001b[21Gted concurrently\u001b[38Gwith low risk of merge \u001b[62Gonflicts. We will do all t\u001b[89Ge\u001b[91Gwork at once, and\u001b[109Gonly run \u001b[39m  \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mthe\u001b[7Gfull gate after merging a\u001b[33Gl of the individu\u001b[51Gl wo\u001b[56Gk pi\u001b[61Gces.\u001b[66GSmaller work tasks might be\u001b[94Gadded as\u001b[103Glanes\u001b[109Gb\u001b[111Gcom\u001b[116Gidle\r\u001b[2C\u001b[1Band those\u001b[13Gshould also be comp\u001b[33Geted, committ\u001b[48G, an\u001b[53G prepar\u001b[61Gd to merge with \u001b[78Ghe other\u001b[87Gtasks. The\u001b[98Gidea is to reduc\u001b[116Gthe\r\u001b[2C\u001b[1Bnumber of\u001b[13Gtimes w\u001b[21G \u001b[23Gun the full gate to speed up development cycles without running into chaos and keeping merge \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255mconflicts and integration issues low.\u001b[39m                                                                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRecalled \u001b[1m4\u001b[22m memories, wrote \u001b[1m4\u001b[22m memories \r\u001b[21C\u001b[1B673f\u001b[27G8\r\u001b[1B  ⎿  Resuming agent ad0d4cb\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running cd '/home/ivan/projects/jettison.lane-b/' && scri…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-b/' && scripts/heavy.sh cmake --build --preset clang-debug --target \r\u001b[5C\u001b[1Bjettison_host_tests 2>&1 | grep -E \"error|warning:\" -A3 | head -40 (3m 21s)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[3GOsmosing… \u