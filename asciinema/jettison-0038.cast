[0.673, "o", "\u001b[H\r\u001b[4C\u001b[12Bunl\u001b[9Gss \u001b[38;2;177;185;249m-fuse-ld=\u001b[39m is set somewhere, but I haven't con\u001b[58Girm\u001b[62Gd that.   \u001b[73G     \u001b[79G       \u001b[87G       \u001b[95G        \u001b[104G  \u001b[107G   \u001b[111G  \r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPrecompiled headers: none seen.\u001b[37G\u001b[22mThe\u001b[41G\"from\u001b[47Gthe\u001b[51Gprecompiled\u001b[63Gheader\"\u001b[71Gdiagnostics\u001b[83Gcame\u001b[88Gfrom\u001b[93Gclangd's\u001b[102Gown\u001b[106Geditor\u001b[113Gcache,\r\u001b[4C\u001b[1Bnot from the build.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\r\u001b[4C\u001b[1B- \u001b[1mTurning off module scanning\u001b[22m (\u001b[38;2;177;185;249mCMAKE_CXX_SCAN_FOR_MODULES OFF\u001b[39m): the cheapest\u001b[82Gwin,\u001b[87Gabout\u001b[93Gone\u001b[97Gline\u001b[102Gof\u001b[105GCMake.\u001b[112GPerhaps\r\u001b[4C\u001b[1B \u001b[7G5–15% off a cold build and some off incremental ones.        \u001b[69G   \u001b[73G        \u001b[82G    \u001b[87G     \u001b[93G   \u001b[97G    \u001b[102G  \u001b[105G      \u001b[112G       \u001b[27;1H"]
[0.043, "o", "\u001b[H\r\u001b[4C\u001b[12B      \u001b[12G         \u001b[22G  \u001b[25G   \u001b[29G          \u001b[40G   \u001b[44G \u001b[46G       \u001b[54G         \u001b[64G     \r\u001b[4C\u001b[1B\u001b[1mPrecompiled headers: none seen.\u001b[37G\u001b[22mThe\u001b[41G\"from\u001b[47Gthe\u001b[51Gprecompiled\u001b[63Gheader\"\u001b[71Gdiagnostics\u001b[83Gcame\u001b[88Gfrom\u001b[93Gclangd's\u001b[102Gown\u001b[106Geditor\u001b[113Gcache,\r\u001b[4C\u001b[1Bnot from the build.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\r\u001b[4C\u001b[1B- \u001b[1mTurning off module scanning\u001b[22m (\u001b[38;2;177;185;249mCMAKE_CXX_SCAN_FOR_MODULES OFF\u001b[39m): the cheapest\u001b[82Gwin,\u001b[87Gabout\u001b[93Gone\u001b[97Gline\u001b[102Gof\u001b[105GCMake.\u001b[112GPerhaps\r\u001b[4C\u001b[1B \u001b[7G5–15% off a cold build and some off incremental ones.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mmold or lld instead of GNU ld:\u001b[22m linking is of\u001b[52Gen\u001b[55G3–10×\u001b[61Gfaster,\u001b[69Gespecially\u001b[80Gfor\u001b[84Glarge\u001b[90GDebug\u001b[96Gand\u001b[100GASan\u001b[105Gbinaries\u001b[114Gwith\u001b[27;1H"]
