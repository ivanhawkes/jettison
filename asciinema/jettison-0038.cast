[0.109, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m… +2 lines\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated \u001b[1mdocs/history.md\u001b[22m \u001b[38;2;56;166;96m+1\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated \u001b[1msource/CMakeLists.txt\u001b[36G\u001b[22m\u001b[38;2;56;166;96m+13\u001b[40G\u001b[38;2;179;89;107m-2\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m(a git step in this command can move the working tree, so these may be its changes, not edits) \r\u001b[5C\u001b[1B(another command ran in this repository at the same time; a change made by either may show under either \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mresul\u001b[12G)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJ13 next, in lane C. Finding how a\u001b[38Gscene\u001b[44Gswitch\u001b[51Greaches\u001b[59Gthe\u001b[63Grenderer\u001b[72Gand\u001b[76Gthe\u001b[80Gmodel\u001b[86Gcache.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m22\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWrit\u001b[11GJ13 now:\u001b[20Gthe renderer\u001b[33Greports\u001b[41Gwhether\u001b[49Ga\u001b[51Gscene's\u001b[59Gmodel\u001b[65Gfiles\u001b[71Ghave\u001b[76Gloaded,\u001b[84Gand\u001b[88Gthe\u001b[92Gshell\u001b[98Gholds\u001b[104Gthe\u001b[108Gfade\u001b[113Gfor\u001b[117Gup\r\u001b[1B  to five seconds until they have, with \u001b[38;2;177;185;249mShell::SceneReady()\u001b[39m letting a game wait on it.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m·\u001b[3GWhir\u001b[38;2;235;159;127mlpo\u001b[38;2;215;119;87moling… \u001b[45G\u001b[38;2;153;153;153mthought for 16s)\u001b[39m\u001b[K\u001b[27;1H\u001b[20;3H\u001b[?25h"]
