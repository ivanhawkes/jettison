[0.015, "o", "\u001b[?25l\u001b[H\u001b[3G│ hasvk (Intel)       │ Ivy Bridge, Haswell, Broadwell │ \u001b[1mNo\u001b[22m              │ Broadwell reports 1.3                 │\r\u001b[2C\u001b[1B└─────────────────────┴────────────────────────────────┴─────────────────┴───────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProprietary drivers (not confirmed):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mAMD on Win\u001b[16Gows:\u001b[22m the Vulkan \"Roadmap\u001b[41G2022\"\u001b[47Gprofile\u001b[55Grequires\u001b[64Gdescriptor\u001b[75Gindexing,\u001b[85Gand\u001b[89GAMD\u001b[93Gsays\u001b[98Gits\u001b[102Gdriver\u001b[109Gsupports\r\u001b[2C\u001b[1B \u001b[5Gthat profile on\u001b[21GRX Vega \u001b[31Gd \u001b[34GDNA cards. I\u001b[47Gdidn't ch\u001b[57Gck Polari\u001b[67G (RX 400/500) or older.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA's own driver:\u001b[22m I couldn't check it.\u001b[47GThere's no source to\u001b[68Gread, and gpuinf\u001b[85G's device\u001b[95Gdata\u001b[100Gwas\u001b[104Grefused\u001b[112Gwhen\u001b[117GI\r\u001b[2C\u001b[1B \u001b[5Gtried to query it. Running \u001b[38;2;177;185;249mvulkaninfo\u001b[43G\u001b[39mon an older\u001b[55Gcard would settle it.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gfindings\u001b[18Gare\u001b[22Gwritten\u001b[30Ginto\u001b[35Gthe\u001b[39Gplan's\u001b[46Gfacts\u001b[52Gsection\u001b[60G(\u001b[38;2;177;185;249mdocs/dense-geometry-and-ray-tracing.md\u001b[39m,\u001b[101G\"Devices\"),\u001b[113Gand\u001b[117GJ68\r\u001b[2C\u001b[1Blinks\u001b[9Gto them.\u001b[18GI skipped the gate because the commit changes only docs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 2m 9s · done 5:25 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mpush it, those are acceptable limits\u001b[39m                                                            