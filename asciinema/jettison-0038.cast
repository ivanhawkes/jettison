h\u001b[23Gdocs'\u001b[29G\"r\u001b[32Gbase and\u001b[41Ggate\u001b[46Gagain before merging\" rule\u001b[73Gin \u001b[38;2;177;185;249mbuild-and-gates.md\u001b[95G\u001b[39mstill\u001b[101Gdescribes\u001b[111Gthe\u001b[115Gold\r\u001b[4C\u001b[1Bflow.\u001b[11GI'll\u001b[16Gupdate\u001b[23Git\u001b[26Gin\u001b[29Gthe\u001b[33Gbatch's\u001b[41Gdocs\u001b[46Gcommit\u001b[53Gunless\u001b[60Gyou'd\u001b[66Grather\u001b[73GI\u001b[75Gdidn't.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[20;3H\u001b[?25h"]
