                     │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BRADV\u001b[10G(AMD)\u001b[27GEvery GCN and\u001b[41GRDNA\u001b[46Gcard\u001b[51G(HD\u001b[60GYes\u001b[78G1.3\u001b[82Gor\u001b[85G1.4\r\u001b[2C\u001b[1B│                     │ 7000 onwards)                  │                 │                                       │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BNVK (NVIDIA,\u001b[18Gopen\u001b[27GMaxwell onwards\u001b[43G(GTX\u001b[48G900\u001b[60GYes\u001b[78G1.3 or 1.4 (K\u001b[92Gpler\u001b[97Ggets\u001b[102G1.2,\u001b[107Gso\u001b[110Git's\r\u001b[2C\u001b[1B│ source)             │ onwards)            \u001b[76G│ already refused)                      │\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[16.450, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gcommitted\u001b[15GJ68\u001b[19Gand\u001b[23Gthe\u001b[27Gresearch\u001b[36Gfindings\u001b[45Gas\u001b[48G\u001b[38;2;177;185;249m28650ef\u001b[56G\u001b[39mon\u001b[59G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[73Gnot\u001b[77Gpushed.\u001b[85GAlmost\u001b[92Gevery\u001b[98Gcard\u001b[103Gthat\u001b[108Gpasses\r\u001b[1B \u001b[3Gtoday's Vulkan 1.3 check also supports descriptor indexing; the one exception I found is\u001b[92GIntel\u001b[98GBroadwell\u001b[108Gon Linux.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the Vulkan spec says.\u001b[30G\u001b[22mNo\u001b[33Gcore\u001b[38Gversion\u001b[46Grequires\u001b[55Gdescriptor\u001b[66Gindexing,\u001b[76Gnot\u001b[80Geven\u001b[85G1.3\u001b[89Gor\u001b[92G1.4.\u001b[97GFrom\u001b[102G1.2\u001b[106Gon,\u001b[110Ga\u001b[112Gdriver\r\u001b[2C\u001b[1Bonly has to support it if it also expo\u001b[42Ges th\u001b[48G \u001b[38;2;177;185;249mVK_EXT_descriptor_indexing\u001b[76G\u001b[39mex\u001b[79Gension. So making\u001b[97Git required at\u001b[113Gevice\r\u001b[2C\u001b[1Bchoice does\u001b[15Gnarr\u001b[20Gw which device\u001b[35G the engine accepts, a little.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLinux drivers (checked in Mesa's current source):\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B┌─────────────────────┬────────────────────────────────┬─────────────────┬───────────────────────────────────────┐\r\u001b[2C\u001b[1B│       Driver        │             Cards              │   Descriptor    │        Vulkan version reported        │\r\u001b[10C\u001b[1B      \u001b[39G     \u001b[62G indexing \u001b[85G      \u001b[92G       \u001b[100G        \r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ RADV (AMD)          │ Every GCN and RDNA card (HD    │ Yes             │ 1.3 or 1.4                            │\r\u001b[4C\u001b[1B    \u001b[10G     \u001b[27G7000 onwards)\u001b[41G    \u001b[46G    \u001b[51G   \u001b[60G   \u001b[78G   \u001b[82G  \u001b[85G   \r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ NVK (NVIDIA, open   │ Maxwell onwards (GTX 900       │ Yes             │ 1.3 or 1.4 (Kepler gets 1.2, so it's  │\r\u001b[4C\u001b[1Bsource)     \u001b[18G    \u001b[27Gonwards)       \u001b[43G    \u001b[48G   \u001b[60G   \u001b[78Galready refus\u001b[92Gd)  \u001b[97G    \u001b[102G    \u001b[107G  \u001b[110G    \r\u001b[2C\u001b[1B├─────────────────────┼─────────────────────\u001b[76G┼───────────────────────────────────────┤\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.287, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gcommitted\u001b[15GJ68\u001b[19Gand\u001b[23Gthe\u001b[27Gresearch\u001b[36Gfindings\u001b[45Gas\u001b[48G\u001b[38;2;177;185;249m28650ef\u001b[56G\u001b[39mon\u001b[59G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[73Gnot\u001b[77Gpushed.\u001b[85GAlmost\u001b[92Gevery\u001b[98Gcard\u001b[103Gthat\u001b[108Gpasses\r\u001b[1B \u001b[3Gtoday's Vulkan 1.3 check also supports descriptor indexing; the one exception I found is\u001b[92GIntel\u001b[98GBroadwell\u001b[108Gon Linux.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the Vulkan spec says.\u001b[30G\u001b[22mNo\u001b[33Gcore\u001b[38Gversion\u001b[46Grequires\u001b[55Gdescriptor\u001b[66Gindexing,\u001b[76Gnot\u001b[80Geven\u001b[85G1.3\u001b[89Gor\u001b[92G1.4.\u001b[97GFrom\u001b[102G1.2\u001b[106Gon,\u001b[110Ga\u001b[112Gdriver\r\u001b[2C\u001b[1Bonly has to support it if it also expo\u001b[42Ges th\u001b[48G \u001b[38;2;177;185;249mVK_EXT_descriptor_indexing\u001b[76G\u001b[39mex\u001b[79Gension. So making\u001b[97Git required at\u001b[113Gevice\r\u001b[2C\u001b[1Bchoice does\u001b[15Gnarr\u001b[20Gw which device\u001b[35G the engine accepts, a little.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLinux drivers (checked in Mesa's current source):\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B┌─────────────────────┬────────────────────────────────┬─────────────────┬───────────────────────────────────────┐\r\u001b[2C\u001b[1B│       Driver        │             Cards              │   Descriptor    │        Vulkan version reported        │\r\u001b[10C\u001b[1B      \u001b[39G     \u001b[62G indexing \u001b[85G      \u001b[92G       \u001b[100G        \r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ RADV (AMD)          │ Every GCN and RDNA card (HD    │ Yes             │ 1.3 or 1.4                            │\r\u001b[4C\u001b[1B    \u001b[10G     \u001b[27G7000 onwards)\u001b[41G    \u001b[46G    \u001b[51G   \u001b[60G   \u001b[78G   \u001b[82G  \u001b[85G   \r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ NVK (NVIDIA, open   │ Maxwell onwards (GTX 900       │ Yes             │ 1.3 or 1.4 (Kepler gets 1.2, so it's  │\r\u001b[4C\u001b[1Bsource)     \u001b[18G    \u001b[27Gonwards)       \u001b[43G    \u001b[48G   \u001b[60G   \u001b[78Galready refus\u001b[92Gd)  \u001b[97G    \u001b[102G    \u001b[107G  \u001b[110G    \r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ ANV (Intel)         │ Skylake onwards     \u001b[76G│ 1.3 or later                          │\u001b[27;1H\u001b[24;3H\u001b[?25h"]
