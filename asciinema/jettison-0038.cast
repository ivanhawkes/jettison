[0.081, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI committed J68 and the research findings as \u001b[38;2;177;185;249m28650ef\u001b[39m on \u001b[38;2;177;185;249mfeature-base\u001b[39m, not pushed. Almost\u001b[92Gevery\u001b[98Gcard that\u001b[108Gpasses\u001b[K\r\u001b[2C\u001b[1Btoday's\u001b[11GVulkan\u001b[18G1.3\u001b[22Gcheck\u001b[28Galso\u001b[33Gsupports\u001b[42Gdescriptor\u001b[53Gindexing;\u001b[63Gthe\u001b[67Gone\u001b[71Gexception\u001b[81GI\u001b[83Gfound\u001b[89Gis\u001b[92GIntel\u001b[98GBroadwell\u001b[108Gon\u001b[111GLinux.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the Vulkan spec says.\u001b[22m No core ver\u001b[42Gion r\u001b[48Gquires descriptor indexing,\u001b[76Gno\u001b[79G even 1.3 or 1.4.\u001b[97GFrom 1.2 on, a\u001b[113Griver\r\u001b[2C\u001b[1Bonly has to\u001b[15Gsupp\u001b[20Grt it if it al\u001b[35Go exposes the \u001b[38;2;177;185;249mVK_EXT_descriptor_indexing\u001b[76G\u001b[39mextension.\u001b[87GSo\u001b[90Gmaking\u001b[97Git\u001b[100Grequired\u001b[109Gat\u001b[112Gdevice\r\u001b[2C\u001b[1Bchoice\u001b[10Gdoes\u001b[15Gnarrow\u001b[22Gwhich\u001b[28Gdevices\u001b[36Gthe\u001b[40Gengine\u001b[47Gaccepts,\u001b[56Ga\u001b[58Glittle.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLinux drivers (checked in Mesa's current source):\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B┌─────────────────────┬────────────────────────────────┬─────────────────┬───────────────────────────────────────┐\r\u001b[10C\u001b[1BDriver\u001b[39GCards\u001b[62GDescriptor\u001b[85GVulkan\u001b[92Gversion\u001b[100Greported\r\u001b[2C\u001b[1B│                     │                                │    indexing     │                                       │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BRADV\u001b[10G(AMD)\u001b[27GEvery GCN and\u001b[41GRDNA\u001b[46Gc