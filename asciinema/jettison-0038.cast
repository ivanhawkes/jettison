[0.142, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOther\u001b[9Gopen\u001b[14Gwork,\u001b[20Gin\u001b[23Gorder\u001b[29Gof\u001b[32Gvalue:\r\u001b[2C\u001b[1B- \u001b[1mJ14:\u001b[22m UI hot reload and RmlUi's debugger.\u001b[46GUseful\u001b[53Gwhile\u001b[59Gthe\u001b[63Gclient's\u001b[72Gscreens\u001b[80Ggrow,\u001b[86Gbut\u001b[90Git\u001b[93Gshares\u001b[100G\u001b[38;2;177;185;249mui\u001b[103G\u001b[39mwith\u001b[108GJ15,\u001b[113Gso\u001b[116Git\r\u001b[2C\u001b[1B \u001b[5Gwould follow J15.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJ07, physics:\u001b[22m shapes\u001b[26Goffset\u001b[33Gin\u001b[36Gtheir\u001b[42Gbody\u001b[47Gand\u001b[51Gcompound\u001b[60Gshapes,\u001b[68Gcollision\u001b[78Gfiltering,\u001b[89GJolt's\u001b[96Gdebug\u001b[102Gdrawing,\u001b[111Gand\u001b[115GJolt\r\u001b[2C\u001b[1B \u001b[5Gon several threads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJ27 rows:\u001b[22m an emis\u001b[23Give\u001b[27Gscale\u001b[33Gper\u001b[37Gdraw\u001b[42G(Manifest's\u001b[54Gnozzle\u001b[61Gglow),\u001b[68Gand\u001b[72Gnormal\u001b[79Gmapping\u001b[87Gin\u001b[90G\u001b[38;2;177;185;249mmesh\u001b[39m.\r\u001b[5C\u001b[1B\u001b[1m3\u001b[8G, the cook:\u001b[22m the big un\u001b[31Gock. J12 (station collision from a model), J38 to J43 and the art-standards\u001b[107Gitems\u001b[113GJ64\u001b[117Gto\r\u001b[2C\u001b[1B \u001b[5GJ67 all wait on it. It's three\u001b[36Gto four weeks, so a lane \u001b[62Gf\u001b[64Gits own.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot yet on the roadmap:\u001b[22m drawing a\u001b[39Gw\u001b[41Grld streamed\u001b[54Gfrom a\u001b[61Gserver, \u001b[70Ghich\u001b[75Gthe\u001b[79Gclient\u001b[86Gneeds\u001b[92Gbefore\u001b[99Git\u001b[102Gcan\u001b[106Gplay\u001b[111Gon\u001b[114Ga\r\u001b[2C\u001b[1B \u001b[5Gserver.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Grecommend\u001b[15Gthis\u001b[20Gbatch:\u001b[27GJ15\u001b[31Gin\u001b[34Glane\u001b[39GB,\u001b[42GJ13\