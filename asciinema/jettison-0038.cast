[0.067, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1BWhat J68 delivers: every material texture goes in one descriptor array, and the material buffer holds each slot's\r\u001b[2C\u001b[1Bindex into it. The fixed set of 8 slots and the one-pool-per-material setup go away, and the slot count becomes\u001b[115Ga\r\u001b[2C\u001b[1Bnamed constant instead of a property of the descriptor layout. It counts as done when:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Gthe reference frames are unchanged;\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Ga test program with more than 8 slots draws;\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Gtexture reloads run clean under synchronisation validation;\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Ga device without descriptor indexing is refused with its reason.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThree choices were mine, so check them:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDescriptor indexing becomes required.\u001b[22m J68 makes the device check refuse any GPU without it. Before, only the\u001b[K\r\u001b[4C\u001b[1Bray-tracing path needed it, and only as an option. I haven't checked whether every GPU you target supports it,\u001b[116Golder\r\u001b[4C\u001b[1Bfallback cards included.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt can go first.\u001b[22G\u001b[22mSince\u001b[28Git\u001b[31Gneeds\u001b[37Gnothing\u001b[45Gelse\u001b[50Gin\u001b[53Gthe\u001b[57Gtrack,\u001b[64Gthe\u001b[68Gsection\u001b[76Gsays\u001b[81Git\u001b[84Gmay\u001b[88Gbe\u001b[91Gscheduled\u001b[101Gahead\u001b[107Gof\u001b[110Gthe\u001b[114Grest.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe 1 to 2 week effort is my estimate.\u001b[22m\u001b[K\r\u001b[2B \u001b[3GNothing is committed yet; this is docs only. I \u001b[51Gidn't\u001b[57Grecord\u001b[64Ga\u001b[66Gmatching\u001b[75Gentry\u001b[81Gin\u001b[84G\u001b[38;2;177;185;249mdocs/decisions.md\u001b[39m,\u001b[103Gsince\u001b[109Gyou\u001b[113Ghaven't\r\u001b[1B  settled the design yet.\r\u001b[24C\u001b[2B\u001b[38;2;153;153;153m7\u001b[27G2\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.033, "o", "\u001b]0;✳ jettison-0038\u0007"]
[0.003, "o", "\u001b[?25l\u001b[H\u001b[5Gdevice-capabilities\u001b[25Gtable\u001b[31Gwere\u001b[36Gupdated\u001b[44Gto\u001b[47Gmatch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat J68 delivers:\u001b[22Gevery\u001b[28Gma\u001b[31Gerial\u001b[37Gtex\u001b[41Gure goes in one descriptor array, and\u001b[79Gthe m\u001b[85Gterial\u001b[92Gbuffer holds each slot's\r\u001b[2C\u001b[1Bind\u001b[7Gx\u001b[9Ginto it.\u001b[18GThe fixed set of 8 slots\u001b[43Gand\u001b[47Gthe one-poo\u001b[59G-per-material setup\u001b[79Gg\u001b[81G away, and\u001b[92Gthe\u001b[96Gslot\u001b[101Gcount\u001b[107Gbecomes\u001b[115Ga\r\u001b[2C\u001b[1Bnamed\u001b[9Gconsta\u001b[16Gt instead\u001b[26Gof a property of\u001b[43Gthe\u001b[47Gdescriptor\u001b[58Glayout.\u001b[66GIt\u001b[69Gcounts\u001b[76Gas\u001b[79Gdone\u001b[84Gwhen:\r\u001b[4C\u001b[1Bthe refe\u001b[14Gence frames a\u001b[30Gunchanged;\u001b[K\r\u001b[4C\u001b[1Ba test p\u001b[14Gogr\u001b[18Gm with\u001b[25Gmore than 8\u001b[38Glots draws;\u001b[K\r\u001b[4C\u001b[1Btexture reloads run \u001b[26Glean under sy\u001b[40Gchronisation\u001b[53Gvalida\u001b[60Gion;\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Ga\u001b[7Gdevice\u001b[14Gwithout\u001b[22Gdescriptor\u001b[33Gindexing\u001b[42Gis\u001b[45Grefused\u001b[53Gwith\u001b[58Gits\u001b[62Greason.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThree choices were mine, so check them:\u001b[43G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDescriptor indexing becomes required.\u001b[22m J68 makes the device check r\u001b[72Gfuse any GPU without it. Before, only the\u001b[K\r\u001b[4C\u001b[1Br\u001b[7Gy-tracing path nee\u001b[28G it,\u001b[33Gand\u001b[37Gonly\u001b[42Gas\u001b[45Gan\u001b[48Goption.\u001b[56GI\u001b[58Ghaven't\u001b[66Gchecked\u001b[74Gwhether\u001b[82Gevery\u001b[88GGPU\u001b[92Gyou\u001b[96Gtarget\u001b[103Gsupports\u001b[112Git,\u001b[116Golder\r\u001b[2C\u001b[1B \u001b[5Gfallback cards includ\u001b[27Gd.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIt can go first.\u001b[22m Since it needs nothing\u001b[45Gelse\u001b[50Gin\u001b[53Gthe\u001b[57Gtrack,\u001b[64Gthe\u001b[68Gsection\u001b[76Gsays\u001b[81Git\u001b[84Gmay\u001b[88Gbe\u001b[91Gscheduled\u001b[101Gahead\u001b[107Gof\u001b[110Gthe\u001b[114Grest.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe 1 to 2 week effort is my estimate.\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BNo\u001b[6Ghing\u001b[11Gis comm\u001b[19Gtted yet;\u001b[29Gthis\u001b[34Gis\u001b[37Gdocs\u001b[42Gonly.\u001b[48GI\u001b[50Gdidn't\u001b[57Grecord\u001b[64Ga\u001b[66Gmatching\u001b[75Gentry\u001b[81Gin\u001b[84G\u001b[38;2;177;185;249mdocs/decisions.md\u001b[39m,\u001b[103Gsince\u001b[109Gyou\u001b[113Ghaven't\r\u001b[2C\u001b[1Bsettled\u001b[11Gthe\u001b[15Gdesign\u001b[22Gyet.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCogitated for 1\u001b[19G 22s ·\u001b[26Gdone\u001b[31G5:21 pm\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
