[0.057, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mAgent\u001b[9G\"Manifest\u001b[19Gadopts\u001b[26GJettison\u001b[35Gb8134e3\"\u001b[44Gfinished\u001b[38;2;153;153;153m · 17m 39s\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMerged \u001b[1madopt-b8134e3\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;107;128m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest.lane-c/build/lane.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[38;2;255;107;128mError: File has been modified since read, either by the user or by a linter. Read it again before attempting to \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;255;107;128mwrite it.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m30\u001b[22m new diagnostic issues in 8 files (ctrl+o to expand)\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gadoption\u001b[16Gpiece\u001b[22Gis\u001b[25Gmerged\u001b[32Ginto\u001b[37GManifest's\u001b[48G\u001b[38;2;177;185;249mfeature-base\u001b[61G\u001b[39m(\u001b[38;2;177;185;249meebc37a\u001b[39m);\u001b[72Gall\u001b[76G67\u001b[79GDebug\u001b[85Gsuites\u001b[92Gpass.\u001b[98GOne\u001b[102Gpart\u001b[107Gis\u001b[110Gundone\u001b[117Gand\r\u001b[1B \u001b[3Gneeds you\u001b[13G call later. Manifest's ru\u001b[40Ge D-004 keeps\u001b[54Gscripts\u001b[62Gto\u001b[65Gobserving\u001b[75Gand\u001b[79Gsupplying\u001b[89Gpolicy\u001b[96Ginputs,\u001b[104Gso\u001b[107Gthe\u001b[111Gserver\r\u001b[1B  runs mods' scripts and keeps what they store, but they cannot send commands. Allowing that is a design change.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  W22b has reached its grants step (W22b5). Waiting on it, then Manifest's\u001b[76Ggate.\u001b[27;1H\u001b[21;3H\u001b[?25h"]
