[0.194, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- Jettison:\u001b[15Gthe\u001b[19Groadmap's\u001b[29Gcurrent\u001b[37Gdeliveries\u001b[48Gand\u001b[52Gthe\u001b[56Gdense-geometry\u001b[71Gtrack's\u001b[79Gintro.\r\u001b[4C\u001b[1BManifest\u001b[19Gqueue, the decision \u001b[40Gedger, the economy plan's L29 section,\u001b[79Gthe graphical-client\u001b[100Gsection\u001b[108Gof\u001b[111Gits\r\u001b[2C\u001b[1B \u001b[5Groadmap, the session\u001b[26Ghandoff, and\u001b[39Ga link in \u001b[38;2;177;185;249mstations.md\u001b[39m that\u001b[66Gnow\u001b[70Gpoints to L15b.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open, but blocking nothing in these lanes:\r\u001b[2C\u001b[1B\u001b[22m- L01: the operating platform and security.\u001b[K\r\u001b[6C\u001b[1B2 and L03: the scoring, pricing and \u001b[44Gransfer\u001b[52Grules.\r\u001b[6C\u001b[1B4\u001b[15G5\u001b[22Gbo\u001b[25Gk\u001b[29G failure terms, const\u001b[51Guction amounts,\u001b[67Gand\u001b[71Gwhat\u001b[76Ghappens\u001b[84Gif\u001b[87Ga\u001b[89Ggovernor\u001b[98Gchanges\u001b[106Gduring\r\u001b[2C\u001b[1B \u001b[5Gconstruction.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gblock\u001b[15GL15b.\u001b[21GTell\u001b[26Gme\u001b[29Gwhen\u001b[34Gyou\u001b[38Gwant\u001b[43Gto\u001b[46Gwork\u001b[51Gthrough\u001b[59Gthem.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTwo\u001b[7Gdecisions\u001b[17Gfor\u001b[21Gyou:\r\u001b[2C\u001b[1B1. Should Mani\u001b[18Gest lane\u001b[27GC\u001b[29Gtake\u001b[34GL15a\u001b[39Gor\u001b[42GL29?\r\u001b[2C\u001b[1B2\u001b[13GI commi\u001b[22Gand push the docs in both\u001b[48Grepositories\u001b[61G(planning\u001b[71Gdocs\u001b[76Gon\u001b[79G\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[93Gas\u001b[96Gbefore)\u001b[104Gand\u001b[108Gthen\u001b[113Gstart\r\u001b[2C\u001b[1B  \u001b[6Gt\u001b[8Ge \u001b[11Ganes?     \u001b[22G   \u001b[26G    \u001b[31G   \u001b[35G    \u001b[40G  \u001b[43G    \u001b[76G\u001b[K\u001b[27;1H\u001b[20;3H\u001b[?25h"]
