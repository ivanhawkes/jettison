[0.489, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m7\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYou\u001b[7Gcan\u001b[11Graise\u001b[17Git,\u001b[21Gand\u001b[25G16\u001b[28Gcosts\u001b[34Glittle\u001b[41Gon\u001b[44Gdesktop\u001b[52GGPUs.\u001b[58GBut\u001b[62Gif\u001b[65Gthe\u001b[69Greal\u001b[74Ggoal\u001b[79Gis\u001b[82G\"no\u001b[86Gfixed\u001b[92Glimit\",\u001b[100Gbindless\u001b[109Gtextures\u001b[118Gare\r\u001b[2C\u001b[1Bthe proper fix.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's 8.\u001b[22m It's\u001b[20Gn\u001b[22Gt a hardwar\u001b[34G limit.\u001b[42GIt's\u001b[47Ga\u001b[49Gchoice\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[81G\u001b[39mat\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249msource/engine/render/include/jettison/render/Material.h:24\u001b[39m.\u001b[63GEvery\u001b[69Gscene\u001b[75Gprogram\u001b[83Gshares\u001b[90Gone\u001b[94Gpipeline\u001b[103Glayout,\u001b[111Gso\u001b[114Gset\u001b[118G1\r\u001b[2C\u001b[1Bhas a fixed\u001b[15Gnumber\u001b[22Gof\u001b[25Gslots:\u001b[32G8\u001b[34Gcombined\u001b[43Gimage\u001b[49Gsamplers,\u001b[59Gone\u001b[63Gsampler\u001b[71Gshared\u001b[78Gby\u001b[81Gall\u001b[85Gof\u001b[88Gthem\u001b[93G(\u001b[38;2;177;185;249mRenderer.cpp:380\u001b[39m).\u001b[113GThat\r\u001b[2C\u001b[1Bshared\u001b[10Glayout\u001b[17Gis\u001b[20Gwhat\u001b[25Glets\u001b[30Ga\u001b[32Gnew\u001b[36Gprogram\u001b[44Gbe\u001b[47Gjust\u001b[52Gdata\u001b[57Gplus\u001b[62GGLSL,\u001b[68Gwith\u001b[73Gno\u001b[76Gnew\u001b[80Gcode\u001b[85Gpath\u001b[90G(\u001b[38;2;177;185;249mdocs/rendering.md\u001b[39m,\u001b[110G\"Materials\r\u001b[2C\u001b[1Band programs\").\u001b[19GThe\u001b[23Gnumber\u001b[30Gstarted\u001b[38Gat\u001b[41G4\u001b[43Gand\u001b[47Gwas\u001b[51Graised\u001b[58Gto\