[0.045, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m8\u001b[12G\u001b[38;2;248;248;242mfixed in\u001b[22G further commit, not by rewriting\u001b[56Ghistory.\u001b[65G      \u001b[72G        \u001b[81G  \u001b[84G       \u001b[92G \u001b[94G    \u001b[99G       \u001b[107G  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 405 +\u001b[38;2;248;248;242mEach commit builds \u001b[48;2;4;71;0mand \u001b[48;2;2;40;0mpasses the suites of the modules it touches, \u001b[48;2;4;71;0mor\u001b[48;2;2;40;0m \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mlocal\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mrun\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthat\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mshows it\u001b[48;2;2;40;0m      \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242mworking. Work \u001b[27Gs done in batches of a few piec\u001b[59Gs, each in i\u001b[72Gs own lane\u001b[83G \u001b[85G     \u001b[91G   \u001b[95G    \u001b[100G        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mbatches\u001b[38;2;248;248;242m](build-and-gates.md#batches)): clang-tidy, the format and whitespace checks and the full    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mgate\u001b[38;2;248;248;242m](build-an\u001b[29Ggates.md#the-g\u001b[45Ge) run once, on `fea\u001b[66Gure-base`\u001b[77Gfter th\u001b[85G b\u001b[88Gtch's pieces are merged,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242mand their findings are fixed there together, before anything is pushed. A gate failure is fixed in    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m10\u001b[13G\u001b[38;2;248;248;242m furthe\u001b[22Gcomm\u001b[27Gt, not by r\u001b[39Gwriting\u001b[47Ghistory. \u001b[57G      \u001b[64G        \u001b[73G  \u001b[76G       \u001b[84G \u001b[86G    \u001b[91G       \u001b[99G  \u001b[102G     \u001b[108G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 411 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22mCommits,\u001b[21Gcode,\u001b[27Gcomments\u001b[36Gand\u001b[40Gdocuments\u001b[50Guse\u001b[54GBritish\u001b[62Gspelling\u001b[71G(serialise,\u001b[83Gcolour).\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/build-and-gates.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdde\u001b[11G \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\r\u001b[1B     \u001b[2m 239 \u001b[12G\u001b[22m## Th\u001b[18G gat\u001b[23G\u001b[K\r\u001b[7C\u001b[1B\u001b[2m40\u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22mThe\u001b[16G[\u001b[38;2;230;219;116mgate\u001b[39m](glossary.md#gate-ci)\u001b[44Gis\u001b[47G`scripts/ci.sh`:\u001b[64Gevery\u001b[70Gcheck\u001b[76Ga\u001b[78Gcommit\u001b[85Gmust\u001b[90Gpass,\u001b[96Gin\u001b[99Gone\u001b[103Glocal\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 242 -\u001b[38;2;248;248;242mcommand. The last commit of each ch\u001b[76G-werror --asan` before a push         \u001b[49m\u001b[39m\u001b[27;1H\u001b[20;3H\u001b[?25h"]
