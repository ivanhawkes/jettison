[0.002, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 351 \u001b[12G\u001b[22m-\u001b[14G**Clustered\u001b[26Gforward\u001b[34Grendering**\u001b[46G(2026-11-10).\u001b[60GLights\u001b[67Gare\u001b[71Gassigned\u001b[80Gto\u001b[83Gview-space\u001b[94Gclusters\u001b[103Gin\r\u001b[1B \u001b[3G   \u001b[2m 352 \u001b[22m   compute, and every\u001b[33Gsurface\u001b[41Gis\u001b[44Gshaded\u001b[51Gonce\u001b[56Gin\u001b[59Gits\u001b[63Gown\u001b[67Gmaterial\u001b[76Gprogram.\u001b[85GThere\u001b[91Gis\u001b[94Gno\u001b[97GG-buffer:\r\u001b[1B     \u001b[2m 353 \u001b[12G\u001b[22m \u001b[14Gambient\u001b[22Gocclusion\u001b[32Greads\u001b[38Gthe\u001b[42Gdepth\u001b[48Gprepass's\u001b[58Gdepth\u001b[64Gand\u001b[68Gnormals\u001b[76Ginstead.\u001b[85G[\u001b[38;2;230;219;116mRendering\u001b[39m](rendering.md)\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+6\u001b[38;2;153;153;153m, committed \u001b[1m7bc61d9\u001b[22m, pushed to \u001b[1mfeature-base\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gadded the decision entry under \"Rendering\" in \u001b[38;2;177;185;249mdocs/decisions.md\u001b[39m, committed it as \u001b[38;2;177;185;249m7bc61d9\u001b[39m, and pushed it to\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249morigin/feature-base\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe entry records three things:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe choice:\u001b[22m bindless textures, with descriptor indexing required at device choice.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhat it leaves out, accepted as you said:\u001b[22m Intel Broadwell on the \u001b[38;2;177;185;249mhasvk\u001b[39m driver, and NVIDIA's own driver, which\u001b[115Gisn't\r\u001b[4C\u001b[1Bchecked yet.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe rejected option:\u001b[26G\u001b[22mraising\u001b[34Gthe fixed slot count to 16.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIt\u001b[6Glinks\u001b[12Gto J68 and to the device facts.\u001b[K\r\u001b[2B \u001b[3GThe rejected-alternative\u001b[28Gline is my wording of what we\u001b[58Gdiscussed, not someth\u001b[83Gyou stated, so edit\u001b[103Git\u001b[106Gif\u001b[109Gyou\u001b[113Gsee\u001b[117Git\r\u001b[1B  differently.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBaked for \u001b[19Gdone 5:27 pm\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
