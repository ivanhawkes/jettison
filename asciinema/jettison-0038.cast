[0.090, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mCost:\u001b[22m Each material writes 16 descriptors\u001b[45Ginstead\u001b[53Gof\u001b[56G8,\u001b[59Gand\u001b[63Gmost\u001b[68Gof\u001b[71Gthem\u001b[76Gare\u001b[80Gstand-ins.\u001b[91GIt's\u001b[96Gstill\u001b[102Gone\u001b[106Gset\u001b[110Gbind\u001b[115Gper\r\u001b[2C\u001b[1B  draw,\u001b[11Gso\u001b[14Gthe\u001b[18Gcost\u001b[23Gis\u001b[26Gnegligible.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BForm\u001b[8Gts\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m Programs and materials only declare\u001b[45Gthe\u001b[49Gslots\u001b[55Gthey\u001b[60Guse,\u001b[65Gso\u001b[68Gno\u001b[71Gdata\u001b[76Gfile\u001b[81Gchanges.\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BOne sha\u001b[11Ged sampler\u001b[22G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m More slots doesn't give you a different\u001b[49Gsampler\u001b[57Gper\u001b[61Gslot.\u001b[67GIf\u001b[70Gyou\u001b[74Gwant,\u001b[80Gsay,\u001b[85Gclamped\u001b[93Gdecals\u001b[100Gnext\u001b[105Gto\u001b[108Gtiled\r\u001b[2C\u001b[1B  detail maps, that's\u001b[25Ga\u001b[27Gseparate\u001b[36Gchange.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BPins\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m Probably no reference frames or hashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[22m The engin\u001b[52G alre\u001b[58Gdy requires\u001b[70GVulkan 1.3 (\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescriptor\u001b[14Gindexing.\u001b[24GWith\u001b[29Git,\u001b[33Gall\u001b[37Gtextures\u001b[46Glive\u001b[51Gin\u001b[54Gone\u001b[58Gglobal\u001b[65Garray,\u001b[72Gand\u001b[76Gthe\u001b[80Gmaterial\u001b[89Gbuffer\u001b[96Gholds\u001b[102Geach\u001b[107Gslot's\u001b[114Gindex\r\u001b[2C\u001b[1Binto it, next to the material's parameters. The benefits:\u001b[61G\u001b[K\r\u001b[2C\u001b[1B- The \u001b[10Ger-material lim\u001b[27G goes\u001b[34Gway \u001b[39Gn\u001b[41Gi\u001b[44Gly.\u001b[K\r\u001b[2C\u001b[1B- The one-descrip\u001b[21Gor-pool-per-mate\u001b[38Gial pattern in \u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[9C\u001b[1Blanned mesh-shader path (J40) and ray-traced\u001b[55Ghit\u001b[59Gshading\u001b[67G(J47)\u001b[73Gbecome\u001b[80Gmuch\u001b[85Geasier.\u001b[93GPer-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkward for both, and \u001b[32Gay-\u001b[36Graced\u001b[42Ghi\u001b[45G shad\u001b[52Gg effectively needs bindless.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.499, "o", "\u001b[?25l\u001b[H\u001b[3G  draw, so\u001b[14Gthe cost\u001b[23Gis n\u001b[28Ggligible.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BFormats\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m Programs\u001b[18Gand\u001b[22Gmaterials\u001b[32Gonly\u001b[37Gdeclare\u001b[45Gthe\u001b[49Gslots\u001b[55Gthey\u001b[60Guse,\u001b[65Gso\u001b[68Gno\u001b[71Gdata\u001b[76Gfile\u001b[81Gchanges.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BOne shared sampler\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m More\u001b[15Glots doesn't\u001b[28Ggive\u001b[33Gyou\u001b[37Ga\u001b[39Gdifferent\u001b[49Gsampler\u001b[57Gper\u001b[61Gslot.\u001b[67GIf\u001b[70Gyou\u001b[74Gwant,\u001b[80Gsay,\u001b[85Gclamped\u001b[93Gdecals\u001b[100Gnext\u001b[105Gto\u001b[108Gtiled\r\u001b[2C\u001b[1B  detail maps, that'\u001b[24G a separate change.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BPins\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[9G\u001b[22mProbably\u001b[18Gno\u001b[21Greference\u001b[31Gframes\u001b[38Gor\u001b[41Ghashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[42G\u001b[22mThe\u001b[46Gengine\u001b[53Galready\u001b[61Grequires\u001b[70GVulkan\u001b[77G1.3\u001b[81G(\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescriptor indexing. With it, all textures\u001b[46Glive in on\u001b[57G global a\u001b[67Gray, and the material buffer holds each slot's index\r\u001b[2C\u001b[1Binto \u001b[9Gt, next to the\u001b[24Gma\u001b[27Ger\u001b[30Gal's parameter\u001b[45G. Th\u001b[51Gbenefits:\u001b[K\r\u001b[2C\u001b[1B- The per-ma\u001b[16Gerial li\u001b[25Gi\u001b[27G goes away entirely.\u001b[K\r\u001b[8C\u001b[1Bone\u001b[13Gdesc\u001b[19Gptor-pool-p\u001b[31Gr-material pattern\u001b[50Gin\u001b[53G\u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[8C\u001b[1Bplann\u001b[15Gd mesh-shader \u001b[30Gath (J40) and ray-traced hit shading (J47) become\u001b[80Gmuch\u001b[85Geasier. Per-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkwar\u001b[17Gfor both, and ray-traced hit shading effectively needs bindless.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcost\u001b[12Gis\u001b[15Ga\u001b[17Gbigger\u001b[24Gchange.\u001b[32GShaders\u001b[40Ghave\u001b[45Gto\u001b[48Gmark\u001b[53Gtexture\u001b[61Gindices\u001b[69Gwith\u001b[74G\u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.251, "o", "\u001b[?25l\u001b[H\u001b[3G────────────────────────────────────────\r\u001b[2C\u001b[1BFormats\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m Programs\u001b[18Gand\u001b[22Gmaterials\u001b[32Gonly\u001b[37Gdeclare\u001b[45Gthe\u001b[49Gslots\u001b[55Gthey\u001b[60Guse,\u001b[65Gso\u001b[68Gno\u001b[71Gdata\u001b[76Gfile\u001b[81Gchanges.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BOne shared sampler\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m More\u001b[15Glots doesn't\u001b[28Ggive\u001b[33Gyou\u001b[37Ga\u001b[39Gdifferent\u001b[49Gsampler\u001b[57Gper\u001b[61Gslot.\u001b[67GIf\u001b[70Gyou\u001b[74Gwant,\u001b[80Gsay,\u001b[85Gclamped\u001b[93Gdecals\u001b[100Gnext\u001b[105Gto\u001b[108Gtiled\r\u001b[2C\u001b[1B  detail maps, that'\u001b[24G a separate change.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BPins\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[9G\u001b[22mProbably\u001b[18Gno\u001b[21Greference\u001b[31Gframes\u001b[38Gor\u001b[41Ghashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[42G\u001b[22mThe\u001b[46Gengine\u001b[53Galready\u001b[61Grequires\u001b[70GVulkan\u001b[77G1.3\u001b[81G(\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescriptor indexing. With it, all textures\u001b[46Glive in on\u001b[57G global a\u001b[67Gray, and the material buffer holds each slot's index\r\u001b[2C\u001b[1Binto \u001b[9Gt, next to the\u001b[24Gma\u001b[27Ger\u001b[30Gal's parameter\u001b[45G. Th\u001b[51Gbenefits:\u001b[K\r\u001b[2C\u001b[1B- The per-ma\u001b[16Gerial li\u001b[25Gi\u001b[27G goes away entirely.\u001b[K\r\u001b[8C\u001b[1Bone\u001b[13Gdesc\u001b[19Gptor-pool-p\u001b[31Gr-material pattern\u001b[50Gin\u001b[53G\u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[8C\u001b[1Bplann\u001b[15Gd mesh-shader \u001b[30Gath (J40) and ray-traced hit shading (J47) become\u001b[80Gmuch\u001b[85Geasier. Per-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkwar\u001b[17Gfor both, and ray-traced hit shading effectively needs bindless.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcost\u001b[12Gis\u001b[15Ga\u001b[17Gbigger\u001b[24Gchange.\u001b[32GShaders\u001b[40Ghave\u001b[45Gto\u001b[48Gmark\u001b[53Gtexture\u001b[61Gindices\u001b[69Gwith\u001b[74G\u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\r\u001b[2C\u001b[1BStand-ins become fixed i\u001b[28Gdices in the \u001b[42Grray,\u001b[48Gand validation gets harder to read. J64\u001b[88Galready moves vertex data to\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
