[0.013, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Message queued for delivery to a006364b5939cc9f5 at its next tool round. Sending this moved nothing it is \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mrunning to the background just now, so the message waits for that round unless something moves sooner. If it \r\u001b[5C\u001b[1Bfinishes first, it is resumed with the message and notifies again, so wait for that notification before \r\u001b[5C\u001b[1Bresending.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLanes now run only a working build plus a local check, so my J63 build is going ahead directly, since an incremental\r\u001b[2C\u001b[1Bbuild of one suite doesn't need L15a's gate lock.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/host/include/jettison/host/WorldContent.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 14 \r\u001b[2C\u001b[1B\u001b[22m   \u001b[2m 15 \u001b[22m namespace\u001b[21GJettison::Host\r\u001b[5C\u001b[1B\u001b[2m 16 \u001b[11G\u001b[22m{\r\u001b[1B \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 17 -\u001b[38;2;248;248;242m// Docs: files-and-mods.md, \"The server's world content\". The format of WorldContent's bytes.          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 17 +\u001b[38;2;117;113;94m// The format of WorldContent's bytes (docs/files-and-mods.md, \"The server's world content\").\u001b[38;2;248;248;242m          \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m8 \u001b[22m \u001b[13G\u001b[38;2;249;38;114mline\u001b[39m \u001b[38;2;166;226;46mconstexpr\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46muint32_t\u001b[39m kWorl\u001b[