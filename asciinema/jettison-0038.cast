[0.161, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m9\u001b[13G\u001b[22m  tests/HostTests.cpp\r\u001b[6C\u001b[1B\u001b[2m20\u001b[11G\u001b[22m)\u001b[15G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd '/home/ivan/projects/jettison.lane-b/'\u001b[53G&&\u001b[56Gscri…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-b/' && scripts/heavy.sh cmake --build --preset clang-debug --target \r\u001b[5C\u001b[1Bjettison_host_tests 2>&1 | grep -E \"error|warning:\" -A3 | head -40 (2m 46s)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ From now on when I ask to continue with the roadmap I want you to check the number of free lanes, whether the content\u001b[39m \r\u001b[1B  \u001b[38;2;153;153;153mof them is commited and merged, and whether we can start to re-use them. Then pick out two to four pieces of work \u001b[39m    \r\u001b[1B  \u001b[38;2;153;153;153mthat can be completed concurrently with low risk of merge conflicts. We will do all the work at once, and only run \u001b[39m   \r\u001b[1B  \u001b[38;2;153;153;153mthe full gate after merging all of the individual work pieces. Smaller work tasks might be added as lanes become idle\u001b[39m \r\u001b[1B  \u001b[38;2;153;153;153mand those should also be completed, committed, and prepared to merge with the other tasks. The idea is to reduce the\u001b[39m  \r\u001b[1B  \u001b[38;2;153;153;153mnumber of times we run the full gate to speed up development cycles without running into chaos and keeping merge \u001b[39m     \r\u001b[1B  \u001b[38;2;153;153;153mconflicts and integration issues low.\u001b[39m                                                                                 \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m*\u001b[39m \u001b[38;2;215;11