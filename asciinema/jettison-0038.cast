[0.242, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m   -\u001b[38;2;248;248;242muites pass. Ready to merge with the batch; tidy, format and the full gate at merge time.                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 3 +\u001b[38;2;248;248;242mFree: parked on feature-base after J63 merged (d1bd248, not yet gated or pushed: the batch gate runs onc\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m   +\u001b[38;2;248;248;242me every piece is merged).                                                                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe merge is done and\u001b[25Glane\u001b[30GB\u001b[32Gis\u001b[35Gfree,\u001b[41Gso\u001b[44GI'm\u001b[48Gadding\u001b[55Ga\u001b[57Gsmall\u001b[63Gcrash-stack\u001b[75Gand\u001b[79Gbuild-ID\u001b[88Gpiece\u001b[94Gthere,\u001b[101Gkeeping\u001b[109Gclear\u001b[115Gof\r\u001b[2C\u001b[1BJ36's\u001b[9Gfiles.\u001b[16GI'm\u001b[20Greading\u001b[28Gthe\u001b[32Gcrash\u001b[38Ghandler\u001b[46Gfirst.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, read \u001b[1m2\u001b[22m files, listed \u001b[1m2\u001b[22m directories, ran \u001b[1m8\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm still on lane B for J11, and since our binaries have no build IDs, I'm adding \u001b[38;2;177;185;249m--build-id\u001b[96G\u001b[39mto\u001b[99Gthe\u001b[103Glink\u001b[108Gand\u001b[112Gwiring\u001b[119Git\r\u001b[2C\u001b[1Bthrough\u001b[11Gthe\u001b[15Gcrash\u001b[21Gstack,\u001b[28Gthe\u001b[32Greport,\u001b[40Gand\u001b[44Gthe\u001b[48Gsymbolise\u001b[58Gscript's\u001b[67Glookup.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u0