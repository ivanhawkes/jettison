[4.809, "o", "\u001b[?25l\u001b[H\u001b[3G├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BRADV\u001b[10G(AMD)\u001b[27GEvery GCN and\u001b[41GRDNA\u001b[46Gcard\u001b[51G(HD\u001b[60GYes\u001b[78G1.3\u001b[82Gor\u001b[85G1.4\r\u001b[2C\u001b[1B│                     │ 7000 onwards)                  │                 │                                       │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BNVK (NVIDIA,\u001b[18Gopen\u001b[27GMaxwell onwards\u001b[43G(GTX\u001b[48G900\u001b[60GYes\u001b[78G1.3 or 1.4 (K\u001b[92Gpler\u001b[97Ggets\u001b[102G1.2,\u001b[107Gso\u001b[110Git's\r\u001b[2C\u001b[1B│ source)             │ onwards)                       │                 │ already refused)                      │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ ANV (Intel)         │ Skylake onwards                │ Yes             │ 1.3 or later                          │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ hasvk (Intel)       │ Ivy Bridge, Haswell, Broadwell │ \u001b[1mNo\u001b[22m              │ Broadwell reports 1.3                 │\r\u001b[2C\u001b[1B└─────────────────────┴────────────────────────────────┴─────────────────┴───────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProprietary \u001b[16Grivers (not confirmed):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD on Windows:\u001b[21G\u001b[22mthe Vulk\u001b[31G \"\u001b[34Goadmap 2022\"\u001b[47Gprofile r\u001b[57Gquires de\u001b[67Gcriptor indexing, and AMD\u001b[93Gsays\u001b[98Gits\u001b[102Gdriver\u001b[109Gsupports\r\u001b[2C\u001b[1B \u001b[5Gthat profile on RX Vega and RDNA cards. I\u001b[47Gdidn't check Polaris\u001b[68G(RX 400/500) or \u001b[85Glder.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA's own driver:\u001b[22m I couldn't check\u001b[43Git. There's\u001b[55Gno source to read, and\u001b[78Ggpuinfo's\u001b[88Gdevice\u001b[95Gdata\u001b[100Gwas\u001b[104Grefused\u001b[112Gwhen\u001b[117GI\r\u001b[4C\u001b[1Btried\u001b[11Gto\u001b[14Gquery\u001b[20Git.\u001b[24GRunning\u001b[32G\u001b[38;2;177;185;249mvulkaninfo\u001b[43G\u001b[39mon\u001b[46Gan\u001b[49Golder\u001b[55Gcard\u001b[60Gwould\u001b[66Gsettle\u001b[73Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gfindings\u001b[18Gare written into the plan's facts section (\u001b[38;2;177;185;249mdocs/dense-geometry-and-ray-tracing.md\u001b[39m,\u001b[101G\"Devices\"),\u001b[113Gand\u001b[117GJ68\r\u001b[2C\u001b[1Blinks\u001b[9Gto\u001b[12Gthem.\u001b[18GI\u001b[20Gskipped\u001b[28Gthe\u001b[32Ggate\u001b[37Gbecause\u001b[45Gthe\u001b[49Gcommit\u001b[56Gchanges\u001b[64Gonly\u001b[69Gdocs.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ commit it, but first do some research on which series of cards will support it\u001b[39m                                        \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BRADV\u001b[10G(AMD)\u001b[27GEvery GCN and\u001b[41GRDNA\u001b[46Gcard\u001b[51G(HD\u001b[60GYes\u001b[78G1.3\u001b[82Gor\u001b[85G1.4\r\u001b[2C\u001b[1B│                     │ 7000 onwards)                  │                 │                                       │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BNVK (NVIDIA,\u001b[18Gopen\u001b[27GMaxwell onwards\u001b[43G(GTX\u001b[48G900\u001b[60GYes\u001b[78G1.3 or 1.4 (K\u001b[92Gpler\u001b[97Ggets\u001b[102G1.2,\u001b[107Gso\u001b[110Git's\r\u001b[2C\u001b[1B│ source)             │ onwards)                       │                 │ already refused)                      │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ ANV (Intel)         │ Skylake onwards                │ Yes             │ 1.3 or later                          │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ hasvk (Intel)       │ Ivy Bridge, Haswell, Broadwell │ \u001b[1mNo\u001b[22m              │ Broadwell reports 1.3                 │\r\u001b[2C\u001b[1B└─────────────────────┴────────────────────────────────┴─────────────────┴───────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProprietary \u001b[16Grivers (not confirmed):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD on Windows:\u001b[21G\u001b[22mthe Vulk\u001b[31G \"\u001b[34Goadmap 2022\"\u001b[47Gprofile r\u001b[57Gquires de\u001b[67Gcriptor indexing, and AMD\u001b[93Gsays\u001b[98Gits\u001b[102Gdriver\u001b[109Gsupports\r\u001b[2C\u001b[1B \u001b[5Gthat profile on RX Vega and RDNA cards. I\u001b[47Gdidn't check Polaris\u001b[68G(RX 400/500) or \u001b[85Glder.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA's own driver:\u001b[22m I couldn't check\u001b[43Git. There's\u001b[55Gno source to read, and\u001b[78Ggpuinfo's\u001b[88Gdevice\u001b[95Gdata\u001b[100Gwas\u001b[104Grefused\u001b[112Gwhen\u001b[117GI\r\u001b[4C\u001b[1Btried\u001b[11Gto\u001b[14Gquery\u001b[20Git.\u001b[24GRunning\u001b[32G\u001b[38;2;177;185;249mvulkaninfo\u001b[43G\u001b[39mon\u001b[46Gan\u001b[49Golder\u001b[55Gcard\u001b[60Gwould\u001b[66Gsettle\u001b[73Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gfindings\u001b[18Gare written into the plan's facts section (\u001b[38;2;177;185;249mdocs/dense-geometry-and-ray-tracing.md\u001b[39m,\u001b[101G\"Devices\"),\u001b[113Gand\u001b[117GJ68\r\u001b[2C\u001b[1Blinks\u001b[9Gto\u001b[12Gthem.\u001b[18GI\u001b[20Gskipped\u001b[28Gthe\u001b[32Ggate\u001b[37Gbecause\u001b[45Gth\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│                     │                                │    indexing     │                                       │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BRADV\u001b[10G(AMD)\u001b[27GEvery GCN and\u001b[41GRDNA\u001b[46Gcard\u001b[51G(HD\u001b[60GYes\u001b[78G1.3\u001b[82Gor\u001b[85G1.4\r\u001b[2C\u001b[1B│                     │ 7000 onwards)                  │                 │                                       │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[4C\u001b[1BNVK (NVIDIA,\u001b[18Gopen\u001b[27GMaxwell onwards\u001b[43G(GTX\u001b[48G900\u001b[60GYes\u001b[78G1.3 or 1.4 (K\u001b[92Gpler\u001b[97Ggets\u001b[102G1.2,\u001b[107Gso\u001b[110Git's\r\u001b[2C\u001b[1B│ source)             │ onwards)                       │                 │ already refused)                      │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ ANV (Intel)         │ Skylake onwards                │ Yes             │ 1.3 or later                          │\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│ hasvk (Intel)       │ Ivy Bridge, Haswell, Broadwell │ \u001b[1mNo\u001b[22m              │ Broadwell reports 1.3                 │\r\u001b[2C\u001b[1B└─────────────────────┴────────────────────────────────┴─────────────────┴───────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProprietary \u001b[16Grivers (not confirmed):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD on Windows:\u001b[21G\u001b[22mthe Vulk\u001b[31G \"\u001b[34Goadmap 2022\"\u001b[47Gprofile r\u001b[57Gquires de\u001b[67Gcriptor indexing, and AMD\u001b[93Gsays\u001b[98Gits\u001b[102Gdriver\u001b[109Gsupports\r\u001b[2C\u001b[1B \u001b[5Gthat profile on RX Vega and RDNA cards. I\u001b[47Gdidn't check Polaris\u001b[68G(RX 400/500) or \u001b[85Glder.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA's own driver:\u001b[22m I couldn't check\u001b[43Git. There's\u001b[55Gno source to read, and\u001b[78Ggpuinfo's\u001b[88Gdevice\u001b[95Gdata\u001b[100Gwas\u001b[104Grefused\u001b[112Gwhen\u001b[117GI\r\u001b[4C\u001b[1Btried\u001b[11Gto\u001b[14Gquery\u001b[20Git.\u001b[24GRunning\u001b[32G\u001b[38;2;177;185;249mvulkaninfo\u001b[43G\u001b[39mon\u001b[46Gan\u001b[49Golder\u001b[55Gcard\u001b[60Gwould\u001b[66Gsettle\u001b[73Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gfindings\u001b[18Gare written into the plan's f\u001b[76G\u001b[38;2;177;185;249metry-and-ray-tracing.md\u001b[39m,\u001b[101G\"Devices\"),\u001b[113Gand\u001b[117GJ68\u001b[27;1H\u001b[24;3H\u001b[?25h"]
