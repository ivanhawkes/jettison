[0.005, "o", "\u001b[?25l\u001b[H     \u001b[38;2;153;153;153mrunning\u001b[14Gto the\u001b[21Gbackground just\u001b[37Gnow, so the message waits for\u001b[68Ghat\u001b[77G unless something moves sooner.\u001b[109GIf\u001b[112Git \r\u001b[5C\u001b[1Bfi\u001b[9Gishes first, it is resumed with the\u001b[45Gmessage \u001b[54Gnd\u001b[57Gnotifies again, so wait for\u001b[85Gthat notification before \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mresending.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  M\u001b[9Gsage queued for delivery to a006364b5939cc9f5 at its next tool round. Sending this moved nothing it is \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mrunning\u001b[14Gto the\u001b[21Gbackground just\u001b[37Gnow, so the message waits for\u001b[68Ghat\u001b[77G unless something moves sooner.\u001b[109GIf\u001b[112Git \r\u001b[5C\u001b[1Bfi\u001b[9Gishes first, it is resumed with the\u001b[45Gmessage \u001b[54Gnd\u001b[57Gnotifies again, so wait for\u001b[85Gthat notification before \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mresending.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gsaved\u001b[14Gthe\u001b[18Gnew\u001b[22Gworkflow\u001b[31Gas\u001b[34Ga\u001b[36Gmemory\u001b[43Gand\u001b[47Gtold\u001b[52Gboth\u001b[57Gimplementers\u001b[70Gthere's\u001b[78Gno\u001b[81Gfull\u001b[86Ggate\u001b[91Gin\u001b[94Gthe\u001b[98Glanes.\u001b[105GMy\u001b[108GJ63\u001b[112Gbuild\u001b[118Gis\r\u001b[1B \u001b[3Gqueued b\u001b[12Ghind th\u001b[20G heavy \u001b[29Gck th\u001b[35Gt the L15a gate holds, and the current batch is J63, J36, L15a\u001b[98Gand W22b.\u001b[38;2;153;153;153m · summary\u001b[118G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/jettison.lane-b/'\u001b[53G&&\u001b[56Gscri…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects