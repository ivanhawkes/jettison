1b[1B\u001b[K\r\u001b[2C\u001b[1B  \u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[22m The code uses ordinary \u001b[38;2;177;185;249m#include\u001b[39ms. The build logs\r\u001b[4C\u001b[1Bshow\u001b[10GCMake's\u001b[18Gmodule\u001b[25Gdependency\u001b[36Gscanning\u001b[45Grunning\u001b[53Ganyway:\u001b[61Glines\u001b[67Glike\u001b[72G\"Scanning\u001b[82G…\u001b[84Gfor\u001b[88GCXX\u001b[92Gdependencies\"\u001b[106Gand\r\u001b[4C\u001b[1B\"Ge\u001b[9Gerat\u001b[16G CXX\u001b[21Gdyndep\u001b[28Gfile\",\u001b[35Gand\u001b[39G\u001b[38;2;177;185;249m.modmap\u001b[47G\u001b[39mfiles\u001b[53Gon\u001b[56Gevery\u001b[62Gcompile\u001b[70Gline.\u001b[76GCMake\u001b[82Gdoes\u001b[87Gthis\u001b[92Gby\u001b[95Gdefault\u001b[103Gfor\u001b[107GC++20\u001b[113Gwith\r\u001b[2C\u001b[2B\u001b[38;2;153;153;153m\u001b[3m↑/↓\u001b[10Gscroll · c to copy · f to fork · Esc to close\u001b[23m\u001b[39m\u001b[27;1H"]
