[0.003, "o", "\u001b[?25l\u001b[H\u001b[3G│\u001b[5GRADV (AMD)\u001b[16G         │\u001b[27GEvery GCN and\u001b[41GRDNA\u001b[46Gcard\u001b[51G(HD\u001b[58G│\u001b[60GYes\u001b[76G│\u001b[78G1.3\u001b[82Gor\u001b[85G1.4\u001b[116G│\r\u001b[2C\u001b[1B│\u001b[6G     \u001b[25G│\u001b[27G7000\u001b[32Gonwards)\u001b[58G│\u001b[76G│\u001b[116G│\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GNVK\u001b[9G(NVIDIA,\u001b[18Gopen\u001b[25G│\u001b[27GMaxwell\u001b[35Gonwards\u001b[43G(GTX\u001b[48G900\u001b[58G│\u001b[60GYes\u001b[76G│\u001b[78G1.3\u001b[82Gor\u001b[85G1.4\u001b[89G(Kepler\u001b[97Ggets\u001b[102G1.2,\u001b[107Gso\u001b[110Git's\u001b[116G│\r\u001b[1B \u001b[3G│ source)             │ onw\u001b[31Gr\u001b[33Gs)              \u001b[58G│\u001b[76G│\u001b[78Galready\u001b[86Grefused)\u001b[116G│\r\u001b[1B  ├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5GANV (Intel)    \u001b[21G   \u001b[25G│ Skylake onwards              \u001b[57G │ Yes \u001b[65G  \u001b[68G     \u001b[74G  │ 1.3 \u001b[84G later     \u001b[96G  \u001b[99G     \u001b[105G   \u001b[116G│\r\u001b[2C\u001b[1B├─────────────────────┼────────────────────────────────┼─────────────────┼───────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5Ghasvk (Int\u001b[16Gl)   \u001b[22G \u001b[24G │ Ivy Bridge,\u001b[39GHaswell, Bro\u001b[52Gdwell │ \u001b[1mNo\u001b[22m   \u001b[66G   \u001b[70G      │ Broadwell reports 1.3   \u001b[103G   \u001b[116G│\r\u001b[2C\u001b[1B└─────────────────────┴────────────────────────────────┴─────────────────┴───────────────────────────────────────┘\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProprietary drivers (not confirmed):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD on Windows:\u001b[22m the Vulkan \"Roadm\u001b[39Gp 2022\" profile requires descriptor indexing, and AMD says its driver\u001b[109Gsupports\r\u001b[4C\u001b[1Bthat profile o\u001b[20G RX V\u001b[26Gga and RDNA cards.\u001b[45GI\u001b[47Gdidn't\u001b[54Gcheck\u001b[60GPolaris\u001b[68G(RX\u001b[72G400/500)\u001b[81Gor\u001b[84Golder.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA's own driver:\u001b[22m I couldn't ch\u001b[40Gck it. There's \u001b[56Go source to re\u001b[71Gd, and gpuinfo's device\u001b[95Gda\u001b[98Ga\u001b[100Gwas refused\u001b[112Gwhen\u001b[117GI\r\u001b[4C\u001b[1Btried\u001b[11Gto\u001b[14Gquery\u001b[20Git.\u001b[24GRunning\u001b[32G\u001b[38;2;177;185;249mvulkaninfo\u001b[43G\u001b[39mon\u001b[46Gan\u001b[49Golder\u001b[55Gcard\u001b[60Gwould\u001b[66Gsettle\u001b[73Git.\r\u001b[1B\u001b[K\r\u001b[1B  These findings are written\u001b[30Ginto\u001b[35Gthe\u001b[39Gplan's\u001b[46Gfacts\u001b[52Gsection\u001b[60G(\u001b[38;2;177;185;249mdocs/dense-geometry-and-ray-tracing.md\u001b[39m,\u001b[101G\"Devices\"),\u001b[113Gand\u001b[117GJ68\r\u001b[2C\u001b[1Blinks\u001b[9Gto\u001b[12Gthem.\u001b[18GI\u001b[20Gskipped\u001b[28Gthe\u001b[32Ggate\u001b[37Gbecause\u001b[45Gthe\u001b[49Gcommit\u001b[56Gchanges\u001b[64Gonly\u001b[69Gdocs.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mBrewed for 2m 9s · done 5:25 pm\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.333, "o", "\u001b[?25l\u001b[H\r\u001b[46C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m2\u001b[49G7\u001b[53G710\u001b[22m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
