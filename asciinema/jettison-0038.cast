[0.636, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GJ13:\u001b[10Gscene\u001b[16Gmodels\u001b[23Gloaded\u001b[30Gbefore\u001b[37Gthe\u001b[41Gscene\u001b[47Gis\u001b[50Gshown,\u001b[57Gbehind\u001b[64Ga\u001b[66Gfade\u001b[71Gfor\u001b[75G5\u001b[77Gseconds\u001b[85Gat\u001b[88Gmost;\r\u001b[2C\u001b[1B- J11's notice: the shell names\u001b[35Gon\u001b[38Gits\u001b[42Gnext\u001b[47Gstart\u001b[53Gthe\u001b[57Greport\u001b[64Ga\u001b[66Gcrash\u001b[72Gleft;\r\u001b[5C\u001b[1B15: prices, dates and\u001b[28Gtimes written eac\u001b[46G l\u001b[49Gnguage'\u001b[58Gway, and text in document attributes translated. Every\u001b[K\r\u001b[4C\u001b[1Breference vi\u001b[18Gw is\u001b[23Gunchanged,\u001b[34Gand\u001b[38Gthe\u001b[42Gsmoke\u001b[48Gtest\u001b[53Gpasses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRunning:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mJ62, Jettison lane B (Opus):\u001b[34G\u001b[22mthe\u001b[38Ggame's\u001b[45Gsession\u001b[53Gruns\u001b[58Ga\u001b[60Gmod's\u001b[66Gscripts,\u001b[75Gso\u001b[78Ga\u001b[80Gdedicated\u001b[90Gserver\u001b[97Gruns\u001b[102Gthem\u001b[107Gtoo.\r\u001b[2C\u001b[1B- \u001b[1mW22b, Manifest lane B:\u001b[28G\u001b[22mtwo of\u001b[35Gits\u001b[39Gfive \u001b[45Gtep\u001b[50Gar\u001b[54Gcommit\u001b[61Ged,\u001b[65Gand it's\u001b[74Gon\u001b[77Gthe\u001b[81Gdry\u001b[85Gdock\u001b[90Gand\u001b[94Gpulse\u001b[100Gcarrier.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAlready pushed earlier today:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison\u001b[14G\u001b[38;2;177;185;249m3c934b6\u001b[39m:\u001b[23GJ63,\u001b[28GJ36,\u001b[33GJ68,\u001b[38GJ11's\u001b[44Gthread\u001b[51Gstacks\u001b[58Gand\u001b[62Gbuild\u001b[68GIDs,\u001b[73Gthe\u001b[77Gfallback\u001b[86Gfonts,\u001b[93Gand\u001b[97Gthe\u001b[101Gengine's\u001b[110Gtext\u001b[115Gin\u001b[118Gall\r\u001b[1B \u001b[3G  four languages.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest\u001b[14G\u001b[38;2;177;185;249mb455f8f\u001b[39m:\u001b[23Gthe\u001b[27Ggraphical\u001b[37Gclient\u001b[44GL15a,\u001b[50Gthe\u001b[54Gfour\u001b[59Glanguages\u001b[69GL43,\u001b[74Gboth\u001b[79Gpin\u001b[83Gmoves,\u001b[90Gand\u001b[94Gthe\u001b[98GJapanese\u001b[107Gfont.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext, in order:\r\u001b[1B\u001b[22m \u001b[3G1. When J62 lands, merge it and run Jettison's one gate, then push.\u001b[K\r\u001b[2C\u001b[1B2. When W22b lands, move Manifest's pin to the new Jettison and\u001b[67Grun\u001b[71GManifest's\u001b[82Ggate.\u001b[88GManifest\u001b[97Gcan\u001b[101Gthen\u001b[106Galso\u001b[111Guse\u001b[115Gthe\u001b[27;1H\u001b[20;3H\u001b[?25h"]
