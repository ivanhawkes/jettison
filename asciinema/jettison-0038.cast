[0.070, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 39 \u001b[22m         \u001b[38;2;166;226;46mmanned:\u001b[39m {\u001b[38;2;166;226;46mboostAcceleration:\u001b[39m \u001b[38;2;190;132;255m5.88399\u001b[39m, \u001b[38;2;166;226;46mboostSeconds:\u001b[39m \u001b[38;2;190;132;255m21600\u001b[39m, \u001b[38;2;166;226;46msustainedAcceleration:\u001b[39m \u001b[38;2;190;132;255m2.941995\u001b[39m}\u001b[K\r\u001b[6C\u001b[1B\u001b[2m40\u001b[11G\u001b[22m        \u001b[38;2;166;226;46munmanned:\u001b[39m {\u001b[38;2;166;226;46mboostAcceleration:\u001b[39m \u001b[38;2;190;132;255m5.88399\u001b[39m, \u001b[38;2;166;226;46mboostSeconds:\u001b[39m \u001b[38;2;190;132;255m21600\u001b[39m, \u001b[38;2;166;226;46msustainedAcceleration:\u001b[39m \u001b[38;2;190;132;255m2.941995\u001b[39m}\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 41 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 42 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m# The nuclear pulse drive (W22b; docs/ships-plan.md, \"The pulse drive as a record\"): bombs behind a\u001b[38;2;248;248;242m  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 43 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m# pusher plate, their own reaction mass, so no exhaust speed; 0.0033 units of 100 kg a tonne-km/s,\u001b[38;2;248;248;242m   \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 44 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m# the rocket equation at 1% of light speed, no dearer above 1 g; kept 100,000 km from every station.\u001b[38;2;248;248;242m \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 45 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m# Manned or not, 2 g for at most 2 hours of a trip, 1 speeding up and 1 slowing down, and 0.5 g\u001b[38;2;248;248;242m      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 46 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m# between.\u001b[38;2;248;248;242m                                                                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 47 +\u001b[38;2;248;248;242m  - \u001b[38;2;166;226;46mdrive:\u001b[38;2;248;248;242m                                                                                             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 48 +\u001b[38;2;248;248;242m      \u001b[38;2;166;226;46mdriveId:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116mDrivePulse\u001b[38;2;248;248;242m                                                                              \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[17G\u001b[38;2;166;226;46mpelletItemId:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116mItemPulseUnits\u001b[38;2;248;248;242m                                                                     \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m50\u001b[13G\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mpelletMilligramsPerTonneKms:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m333564\u001b[38;2;248;248;242m                                                            \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m51\u001b[13G\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mcurveExponent:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m                                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m52\u001b[13G\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mexclusionRadius:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m1.0e8\u001b[38;2;248;248;242m                                                                          \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m53\u001b[13G\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mcruise:\u001b[38;2;248;248;242m                                                                                    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m54\u001