[0.058, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BFormats\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m Programs\u001b[18Gand\u001b[22Gmaterials\u001b[32Gonly\u001b[37Gdeclare\u001b[45Gthe\u001b[49Gslots\u001b[55Gthey\u001b[60Guse,\u001b[65Gso\u001b[68Gno\u001b[71Gdata\u001b[76Gfile\u001b[81Gchanges.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BOne shared sampler\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m More\u001b[15Glots doesn't\u001b[28Ggive\u001b[33Gyou\u001b[37Ga\u001b[39Gdifferent\u001b[49Gsampler\u001b[57Gper\u001b[61Gslot.\u001b[67GIf\u001b[70Gyou\u001b[74Gwant,\u001b[80Gsay,\u001b[85Gclamped\u001b[93Gdecals\u001b[100Gnext\u001b[105Gto\u001b[108Gtiled\r\u001b[2C\u001b[1B  detail maps, that'\u001b[24G a separate change.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BPins\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[9G\u001b[22mProbably\u001b[18Gno\u001b[21Greference\u001b[31Gframes\u001b[38Gor\u001b[41Ghashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[42G\u001b[22mThe\u001b[46Gengine\u001b[53Galready\u001b[61Grequires\u001b[70GVulkan\u001b[77G1.3\u001b[81G(\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescriptor indexing. With it, all textures\u001b[46Glive in on\u001b[57G global a\u001b[67Gray, and the material buffer holds each slot's index\r\u001b[2C\u001b[1Binto \u001b[9Gt, next to the\u001b[24Gma\u001b[27Ger\u001b[30Gal's parameter\u001b[45G. Th\u001b[51Gbenefits:\u001b[K\r\u001b[2C\u001b[1B- The per-ma\u001b[16Gerial li\u001b[25Gi\u001b[27G goes away entirely.\u001b[K\r\u001b[8C\u001b[1Bone\u001b[13Gdesc\u001b[19Gptor-pool-p\u001b[31Gr-material pattern\u001b[50Gin\u001b[53G\u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[8C\u001b[1Bplann\u001b[15Gd mesh-shader \u001b[30Gath (J40) and ray-traced hit shading (J47) become\u001b[80Gmuch\u001b[85Geasier. Per-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkwar\u001b[17Gfor both, and ray-traced hit shading effectively needs bindless.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcost\u001b[12Gis\u001b[15Ga\u001b[17Gbigger\u001b[24Gchange.\u001b[32GShaders\u001b[40Ghave\u001b[45Gto\u001b[76G\u001b[38;2;177;185;249mnuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
