[0.163, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  Message queued for delivery to ac1d470da4079111b at its next tool round. Sending this moved nothing it is \r\u001b[5C\u001b[1Brunning to the background just now, so the message waits for that round unless something moves sooner. If it \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mfinishes first, it is resumed with the message and notifies again, so wait for that notification before \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mresending.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Message queued for delivery to a006364b5939cc9f5 at its next tool round. Sending this moved nothing it is \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mrunning to the background just now, so the message waits for that round unless something moves sooner. If it \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mfinishes first,\u001b[22Git is\u001b[28Gresume\u001b[35G with th\u001b[44G message and n\u001b[60Gifies aga\u001b[70Gn,\u001b[73Gso wait for that notification before \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mr\u001b[9Gending.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLanes now run only a working build plus a local check, so my J63 build is going ahead directly, since an incremental\r\u001b[2C\u001b[1Bbuild of one suite\u001b[22Gdoesn't\u001b[30Gneed\u001b[35GL15a's\u001b[42Ggate\u001b[47Glock.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning cd '/home/ivan/projects/jettison.lane-b/' && scri…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/project\u001b[31G/j\u001b[34Gttison.lane-b/' &&\u001b[53Gscripts/heavy.sh cmake\u001b[76G--build --preset clang-debug --target \r\u001b[5C\u001b[1Bj\u001b[8Gttiso\u001b[14G_host_tests 2>&1 | grep -E \"error|warning:\" -A3 | head -40 (5m 53s)\r\u001b[2B\u001b[38;2;215;119;87m·\u001b[9