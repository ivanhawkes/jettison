[0.067, "o", "\u001b[?25l\u001b[H\u001b[3GThe builds and gates still take turns\u001b[41Gthrough \u001b[38;2;177;185;249mheavy.sh\u001b[39m's lock, so\u001b[69Go\u001b[71Gly one gate runs at a\u001b[93Gtime.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat was blocking, now resolved:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe graphical client (L15) is split.\r\u001b[4C\u001b[1B\u001b[22m-\u001b[7GL15a\u001b[12G(\u001b[38;2;177;185;249m#l15\u001b[18G\u001b[39mstill\u001b[24Gpoints\u001b[31Gto\u001b[34Git)\u001b[38Ghas\u001b[42Gnothing\u001b[50Gblocking\u001b[59Git.\u001b[63GIt\u001b[66Gcovers\u001b[73Gputting\u001b[81Gthe\u001b[85Ggame\u001b[90Ginto\u001b[95Gthe\u001b[99Gengine's\u001b[108Gshell,\u001b[115Gplus\r\u001b[1B \u001b[3G    travel, the \u001b[21Grket,\u001b[27Gthe\u001b[31Gshipyard\u001b[40Gand\u001b[44Gfleet\u001b[50Gscreens,\u001b[59Gand\u001b[63Gstation\u001b[71Glooks,\u001b[78Gup\u001b[81Gto\u001b[84Gplaying\u001b[92Gthe\u001b[96Gfirst\u001b[102Gloop.\r\u001b[1B    - L15b\u001b[12Gis th\u001b[18G owners' scree\u001b[33Gs:\u001b[36Gfees,\u001b[42Gtaxes,\u001b[49Gstation\u001b[57Gpolicy\u001b[64Gand\u001b[68Gbranding.\u001b[78GIt\u001b[81Gstill\u001b[87Gwaits\u001b[93Gon\u001b[96GL04,\u001b[101GL05\u001b[105Gand\u001b[109GL29.\r\u001b[4C\u001b[1B- Manifest's queue now has L15a\u001b[38Gs row 2, and the rows below it a\u001b[71Ge renumbered.\u001b[85GThat\u001b[90Grenumbering\u001b[102Gis\u001b[105Gmost\u001b[110Gof\u001b[113Gthe\r\u001b[5C\u001b[1B \u001b[38;2;177;185;249mdelivery-order.md\u001b[39m diff.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL29 (governors setting taxes) is settled as D-120\u001b[55G\u001b[22min\u001b[58GManifest's\u001b[69Gdecision\u001b[78Gledger:\u001b[86Gwages\u001b[92Gare\u001b[96Gthe\u001b[100Gonly\u001b[105Gtax\u001b[109Gfor\u001b[113Gnow,\u001b[118Gand\r\u001b[4C\u001b[1Ban AI governor steers its rate towards its budget by a bounded step each day. The rate bounds, 0 to 50%, are my\r\u001b[4C\u001b[1Bbest guess and live in the tuning file, not the ledger.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mUpdated:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison: the roadmap's current deliveries and the dense-geometry track's intro.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest: the queue, the decision ledger, the economy plan's\u001b[66GL29\u001b[70Gs\u001b[72Gction, the graphical-client\u001b[100Gsection\u001b[108Gof\u001b[111Gits\r\u001b[4C\u001b[1Broadmap,\u001b[14Gthe\u001b[18Gsession\u001b[26Ghandoff,\u001b[35Gand\u001b[39Ga\u001b[41Glink\u001b[46Gin\u001b[49G\u001b[38;2;177;185;249mstations.md\u001b[61G\u001b[39mthat\u001b[66Gnow\u001b[70Gpoints\u001b[77Gto\u001b[80GL15b.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mStill open, but blocking nothing in these lanes:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GL01:\u001b[10Gthe\u001b[14Goperating\u001b[24Gplatform\u001b[33Gand\u001b[37Gsecurity.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
