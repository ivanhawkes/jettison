[0.145, "o", "\u001b[H\r\u001b[4C\u001b[12B\u001b[1mPrecompiled headers: none seen.\u001b[37G\u001b[22mThe\u001b[41G\"from\u001b[47Gthe\u001b[51Gprecompiled\u001b[63Gheader\"\u001b[71Gdiagnostics\u001b[83Gcame\u001b[88Gfrom\u001b[93Gclangd's\u001b[102Gown\u001b[106Geditor\u001b[113Gcache,\r\u001b[4C\u001b[1Bnot from the build.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\r\u001b[4C\u001b[1B- \u001b[1mTurning off module scanning\u001b[22m (\u001b[38;2;177;185;249mCMAKE_CXX_SCAN_FOR_MODULES OFF\u001b[39m): the cheapest\u001b[82Gwin,\u001b[87Gabout\u001b[93Gone\u001b[97Gline\u001b[102Gof\u001b[105GCMake.\u001b[112GPerhaps\r\u001b[4C\u001b[1B \u001b[7G5–15% off a cold build and some off incremental ones.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mmold or lld instead of GNU ld:\u001b[22m linking is of\u001b[52Gen\u001b[55G3–10×\u001b[61Gfaster,\u001b[69Gespecially\u001b[80Gfor\u001b[84Glarge\u001b[90GDebug\u001b[96Gand\u001b[100GASan\u001b[105Gbinaries\u001b[114Gwith\r\u001b[4C\u001b[1B \u001b[7Gdebug info. There are many test executables, so\u001b[55Gincremental rebuilds might be 10–30% faster.\u001b[100G    \u001b[105G        \u001b[114G    \u001b[27;1H"]
[0.058, "o", "\u001b[H\r\u001b[4C\u001b[12Bnot from the build.            \u001b[37G   \u001b[41G     \u001b[47G   \u001b[51G           \u001b[63G       \u001b[71G           \u001b[83G    \u001b[88G    \u001b[93G        \u001b[102G   \u001b[106G      \u001b[113G      \r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\r\u001b[4C\u001b[1B- \u001b[1mTurning off module scanning\u001b[22m (\u001b[38;2;177;185;249mCMAKE_CXX_SCAN_FOR_MODULES OFF\u001b[39m): the cheapest\u001b[82Gwin,\u001b[87Gabout\u001b[93Gone\u001b[97Gline\u001b[102Gof\u001b[105GCMake.\u001b[112GPerhaps\r\u001b[4C\u001b[1B \u001b[7G5–15% off a cold build and some off incremental ones.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mmold or lld instead of GNU ld:\u001b[22m linking is of\u001b[52Gen\u001b[55G3–10×\u001b[61Gfaster,\u001b[69Gespecially\u001b[80Gfor\u001b[84Glarge\u001b[90GDebug\u001b[96Gand\u001b[100GASan\u001b[105Gbinaries\u001b[114Gwith\r\u001b[4C\u001b[1B \u001b[7Gdebug info. There are many test executables, so\u001b[55Gincremental rebuilds might be 10–30% faster.\u001b[100G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mPrecompiled headers\u001b[22m for the heavy headers (entt, glm, Jolt,\u001b[67GRmlU\u001b[72G, Vulkan,\u001b[82G\u001b[38;2;177;185;249m<format>\u001b[39m): of\u001b[97Gn 20–40%\u001b[106Goff\u001b[110Gcold\u001b[27;1H"]
[0.550, "o", "\u001b[H\r\u001b[4C\u001b[12B   \u001b[9G    \u001b[14G   \u001b[18G      \r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\r\u001b[4C\u001b[1B- \u001b[1mTurning off module scanning\u001b[22m (\u001b[38;2;177;185;249mCMAKE_CXX_SCAN_FOR_MODULES OFF\u001b[39m): the cheapest\u001b[82Gwin,\u001b[87Gabout\u001b[93Gone\u001b[97Gline\u001b[102Gof\u001b[105GCMake.\u001b[112GPerhaps\r\u001b[4C\u001b[1B \u001b[7G5–15% off a cold build and some off incremental ones.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mmold or lld instead of GNU ld:\u001b[22m linking is of\u001b[52Gen\u001b[55G3–10×\u001b[61Gfaster,\u001b[69Gespecially\u001b[80Gfor\u001b[84Glarge\u001b[90GDebug\u001b[96Gand\u001b[100GASan\u001b[105Gbinaries\u001b[114Gwith\r\u001b[4C\u001b[1B \u001b[7Gdebug info. There are many test executables, so\u001b[55Gincremental rebuilds might be 10–30% faster.\u001b[100G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mPrecompiled headers\u001b[22m for the heavy headers (entt, glm, Jolt,\u001b[67GRmlU\u001b[72G, Vulkan,\u001b[82G\u001b[38;2;177;185;249m<format>\u001b[39m): of\u001b[97Gn 20–40%\u001b[106Goff\u001b[110Gcold\r\u001b[4C\u001b[1B \u001b[7Gbuilds. It needs care wi\u001b[33G ccache\u001b[41G(its \u001b[38;2;177;185;249mpch_external_checksum\u001b[39m and sloppiness settings), cla\u001b[98Gg-tidy and clangd,\u001b[27;1H"]
