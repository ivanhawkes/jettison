3Gdraw.\r\u001b[2C\u001b[1BStand-ins become fixed i\u001b[28Gdices in the \u001b[42Grray,\u001b[48Gand validation gets harder to read. J64\u001b[88Galready moves vertex data to\u001b[K\r\u001b[2C\u001b[1Bfetch\u001b[9Gby-address, so bindless textur\u001b[40Gs would\u001b[48Gfit\u001b[52Gthe s\u001b[58Gme dir\u001b[65Gction.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22G\u001b[22mif\u001b[25Ga\u001b[27Greal\u001b[32Gmaterial\u001b[41Gneeds\u001b[47Gmore\u001b[52Gthan\u001b[57G8\u001b[59Gnow,\u001b[64Gbump\u001b[69Gthe\u001b[73Gconstant\u001b[82Gto\u001b[85G16\u001b[88Gand\u001b[92Gadd\u001b[96Gthe\u001b[100Glimit\u001b[106Gcheck.\r\u001b[2C\u001b[1BOtherwise, put bindless\u001b[27Gon the roadmap n\u001b[44Gxt\u001b[47Gt\u001b[49G J40 \u001b[56Gd J47 and don't spe\u001b[76Gd effort\u001b[85Gon\u001b[88Gthe\u001b[92Gslot count.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Gcheck\u001b[18Ghow\u001b[22Gmany\u001b[27Gtextures\u001b[36Gtoday's\u001b[44Gprograms\u001b[53Gactually\u001b[62Guse,\u001b[67Gdidn't\u001b[74Gbuild\u001b[80Ganything,\u001b[90Gand\u001b[94Gdidn't\u001b[101Gread\u001b[106Gthe\u001b[110Glimits\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.064, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mCost:\u001b[22m Prob\u001b[14Gbly\u001b[18Gno reference frames or hashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[42G\u001b[22mThe\u001b[46Gengine\u001b[53Galready\u001b[61Grequires\u001b[70GVulkan\u001b[77G1.3\u001b[81G(\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescript\u001b[12Gr indexing. With it, \u001b[34Gll textures live in\u001b[54Gone global array, \u001b[73Gnd\u001b[76Gthe material\u001b[89Gbuffer\u001b[96Gholds\u001b[102Geach\u001b[107Gslot's\u001b[114Gindex\r\u001b[2C\u001b[1Binto\u001b[8Git,\u001b[12Gnext\u001b[17Gto\u001b[20Gthe\u001b[24Gmaterial's\u001b[35Gparameters.\u001b[47GThe\u001b[51Gbenefits:\r\u001b[2C\u001b[1B- The per-material limit goes away entirely.\u001b[K\r\u001b[2C\u001b[1B- The one-descriptor-pool-per-material pattern in \u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes away too.\u001b[K\r\u001b[2C\u001b[1B- The pla\u001b[13Gned\u001b[17Gmesh-shader p\u001b[31Gth (J40) and ray-trac\u001b[53Gd h\u001b[58G shading\u001b[67G(J47)\u001b[73Gbecome\u001b[80Gmuch\u001b[85Geasier.\u001b[93GPer-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkward for both, and ray-traced hit shading\u001b[54Geffectively\u001b[66Gneeds\u001b[72Gbindless.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe cost is a\u001b[17Gbigger change. Shaders\u001b[40Ghave to mark texture indices with \u001b[38;2;177;185;249mnonuniformEXT\u001b[39m where they va\u001b[102Gy acro\u001b[109Gs a draw.\u001b[K\r\u001b[2C\u001b[1BSt\u001b[6Gnd-ins become fixed indices in th\u001b[40G array, \u001b[49Gnd validation gets harder to read.\u001b[84GJ64\u001b[88Galready\u001b[96Gmoves\u001b[102Gvertex\u001b[109Gdata\u001b[114Gto\r\u001b[2C\u001b[1Bfetch-by-address,\u001b[21Gso\u001b[24Gbindless\u001b[33Gtextures\u001b[42Gwould\u001b[48Gfit\u001b[52Gthe\u001b[56Gsame\u001b[61Gdirection.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22m if a real material\u001b[41Gneeds more\u001b[52Gthan 8 n\u001b[61Gw, bump the constant to 16\u001b[89Gnd \u001b[94Gd\u001b[96Gthe limit check.\u001b[K\r\u001b[2C\u001b[1BOtherwise, put bindless on the roadmap\u001b[42Gnext to J40 and J47 and don't\u001b[72Gspend\u001b[78Geffort\u001b[85Gon\u001b[88Gthe\u001b[92Gslot\u001b[97Gcount.\r\u001b[2C\u001b[2BI didn't check how\u001b[22Gmany\u001b[27Gt\u001b[29Gxtures today's programs actually use, didn't build anything, and \u001b[95Gidn't read\u001b[106Gt\u001b[109G limits\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mvulkaninfo\u001b[14G\u001b[39mreports on your\u001b[30GGPUs.\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m·\u001b[3GGalloping… \u001b[38;2;153;153;153m(45s · ↓\u001b[39m \u001b[38;2;153;153;153m3.4k tokens)\u001b[36G\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
