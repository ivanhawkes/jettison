[1.767, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYou\u001b[7Gcan\u001b[11Graise\u001b[17Git,\u001b[21Gand\u001b[25G16\u001b[28Gcosts\u001b[34Glittle\u001b[41Gon\u001b[44Gdesktop\u001b[52GGPUs.\u001b[58GBut\u001b[62Gif\u001b[65Gthe\u001b[69Greal\u001b[74Ggoal\u001b[79Gis\u001b[82G\"no\u001b[86Gfixed\u001b[92Glimit\",\u001b[100Gbindless\u001b[109Gtextures\u001b[118Gare\r\u001b[1B \u001b[3Gthe\u001b[7Gproper fix.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's 8.\u001b[15G\u001b[22mIt's\u001b[20Gnot\u001b[24Ga\u001b[26Ghardware\u001b[35Glimit.\u001b[42GIt's\u001b[47Ga\u001b[49Gchoice\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[81G\u001b[39mat\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249msource/engine/render/include/jettison/render/Material.h:24\u001b[39m. Every scene program shares\u001b[90Gone\u001b[94Gpipeline\u001b[103Glayout,\u001b[111Gso\u001b[114Gset\u001b[118G1\r\u001b[2C\u001b[1Bhas a fixed number of slots: 8 combined image samplers, one\u001b[63Gsampler shared by all of them (\u001b[38;2;177;185;249mRenderer.cpp:380\u001b[39m). Tha\u001b[118G\u001b[K\r\u001b[2C\u001b[1Bshared layout is what\u001b[25Glets a\u001b[32Gnew program be ju\u001b[50Gt data plus GLSL, with no new code\u001b[85Gpath (\u001b[38;2;177;185;249mdocs/rend\u001b[102Ging.md\u001b[39m, \"Materials\r\u001b[2C\u001b[1Band programs\"). The number\u001b[30Gstarted at 4 and\u001b[47Gwa\u001b[50G raised to 8 when\u001b[68Gsomething needed\u001b[85Gmore\u001b[90G\u001b[K\r\u001b[2C\u001b[1B(\u001b[38;2;177;185;249mdocs/history/architecture-notes.md:565\u001b[39m). Every\u001b[51Gm\u001b[53Gterial fills all 8 slots, using\u001b[85Gwhite,\u001b[92Gblack\u001b[98Gor\u001b[101Gflat-normal\r\u001b[2C\u001b[1Bstand-ins for the ones it leaves empty, so the set is \u001b[59Gways comp\u001b[69Gete.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRaising it to 16.\u001b[21G\u001b[22mIt's\u001b[26Gmostly\u001b[33Ga\u001b[35Gone-constant\u001b[48Gchange.\u001b[56GThe\u001b[60Glayout,\u001b[68Gthe\u001b[72Gdescriptor\u001b[83Gpool,\u001b[89Gthe\u001b[93Gdescriptor\u001b[104Gwrites,\u001b[112Gthe\u001b[116Gcache\r\u001b[2C\u001b[1Barrays and the refusal\u001b[26Gte\u001b[30G all\u001b[35Gfollow \u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[39m. The programs' GLSL declares\u001b[93Git\u001b[96G own set-1 bindings, so\u001b[K\r\u001b[2C\u001b[1Bcheck those, but mo\u001b[23Gt ne\u001b[28Gd no edit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTrade-offs:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDevice\u001b[10Glimits\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m The fragment\u001b[22Gstage\u001b[28Galready\u001b[36Guses\u001b[41G5\u001b[43Gsamp\u001b[76Gings\u001b[81G4,\u001b[84G5,\u001b[87G6,\u001b[90G10,\u001b[94G16).\u001b[99GWith\u001b[104G8\u001b[106Gmaterial\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.059, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYou\u001b[7Gcan\u001b[11Graise\u001b[17Git,\u001b[21Gand\u001b[25G16\u001b[28Gcosts\u001b[34Glittle\u001b[41Gon\u001b[44Gdesktop\u001b[52GGPUs.\u001b[58GBut\u001b[62Gif\u001b[65Gthe\u001b[69Greal\u001b[74Ggoal\u001b[79Gis\u001b[82G\"no\u001b[86Gfixed\u001b[92Glimit\",\u001b[100Gbindless\u001b[109Gtextures\u001b[118Gare\r\u001b[1B \u001b[3Gthe\u001b[7Gproper fix.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's 8.\u001b[15G\u001b[22mIt's\u001b[20Gnot\u001b[24Ga\u001b[26Ghardware\u001b[35Glimit.\u001b[42GIt's\u001b[47Ga\u001b[49Gchoice\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[81G\u001b[39mat\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249msource/engine/render/include/jettison/render/Material.h:24\u001b[39m. Every scene program shares\u001b[90Gone\u001b[94Gpipeline\u001b[103Glayout,\u001b[111Gso\u001b[114Gset\u001b[118G1\r\u001b[2C\u001b[1Bhas a fixed number of slots: 8 combined image samplers, one\u001b[63Gsampler shared by all of them (\u001b[38;2;177;185;249mRenderer.cpp:380\u001b[39m). Tha\u001b[118G\u001b[K\r\u001b[2C\u001b[1Bshared layout is what\u001b[25Glets a\u001b[32Gnew program be ju\u001b[50Gt data plus GLSL, with no new code\u001b[85Gpath (\u001b[38;2;177;185;249mdocs/rend\u001b[102Ging.md\u001b[39m, \"Materials\r\u001b[2C\u001b[1Band programs\"). The number\u001b[30Gstarted at 4 and\u001b[47Gwa\u001b[50G raised to 8 when\u001b[68Gsomething needed\u001b[85Gmore\u001b[90G\u001b[K\r\u001b[2C\u001b[1B(\u001b[38;2;177;185;249mdocs/history/architecture-notes.md:565\u001b[39m). Every\u001b[51Gm\u001b[53Gterial fills all 8 slots, using\u001b[85Gwhite,\u001b[92Gblack\u001b[98Gor\u001b[101Gflat-normal\r\u001b[2C\u001b[1Bstand-ins for the ones it leaves empty, so the set is \u001b[59Gways comp\u001b[69Gete.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRaising it to 16.\u001b[21G\u001b[22mIt's\u001b[26Gmostly\u001b[33Ga\u001b[35Gone-constant\u001b[48Gchange.\u001b[56GThe\u001b[60Glayout,\u001b[68Gthe\u001b[72Gdescriptor\u001b[83Gpool,\u001b[89Gthe\u001b[93Gdescriptor\u001b[104Gwrites,\u001b[112Gthe\u001b[116Gcache\r\u001b[2C\u001b[1Barrays and the refusal\u001b[26Gte\u001b[30G all\u001b[35Gfollow \u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[39m. The programs' GLSL declares\u001b[93Git\u001b[96G own set-1 bindings, so\u001b[K\r\u001b[2C\u001b[1Bcheck those, but mo\u001b[23Gt ne\u001b[28Gd no edit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTrade-offs:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDevice\u001b[10Glimits\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m The fragment\u001b[22Gstage\u001b[28Galready\u001b[36Guses\u001b[41G5\u001b[43Gsamplers\u001b[52Gfrom\u001b[57Gthe\u001b[61Gframe\u001b[67Gset\u001b[71G(bindings\u001b[81G4,\u001b[84G5,\u001b[87G6,\u001b[90G10,\u001b[94G16).\u001b[99GWith\u001b[104G8\u001b[106Gmaterial\r\u001b[2C\u001b[1B  slots that's 13,\u001b[22Ginside Vulkan's guarantee\u001b[76Gth 16 slots it's 2\u001b[95G, which goes past the\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.328, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gthe\u001b[7Gproper fix.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhy it's 8.\u001b[15G\u001b[22mIt's\u001b[20Gnot\u001b[24Ga\u001b[26Ghardware\u001b[35Glimit.\u001b[42GIt's\u001b[47Ga\u001b[49Gchoice\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[81G\u001b[39mat\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249msource/engine/render/include/jettison/render/Material.h:24\u001b[39m. Every scene program shares\u001b[90Gone\u001b[94Gpipeline\u001b[103Glayout,\u001b[111Gso\u001b[114Gset\u001b[118G1\r\u001b[2C\u001b[1Bhas a fixed number of slots: 8 combined image samplers, one\u001b[63Gsampler shared by all of them (\u001b[38;2;177;185;249mRenderer.cpp:380\u001b[39m). Tha\u001b[118G\u001b[K\r\u001b[2C\u001b[1Bshared layout is what\u001b[25Glets a\u001b[32Gnew program be ju\u001b[50Gt data plus GLSL, with no new code\u001b[85Gpath (\u001b[38;2;177;185;249mdocs/rend\u001b[102Ging.md\u001b[39m, \"Materials\r\u001b[2C\u001b[1Band programs\"). The number\u001b[30Gstarted at 4 and\u001b[47Gwa\u001b[50G raised to 8 when\u001b[68Gsomething needed\u001b[85Gmore\u001b[90G\u001b[K\r\u001b[2C\u001b[1B(\u001b[38;2;177;185;249mdocs/history/architecture-notes.md:565\u001b[39m). Every\u001b[51Gm\u001b[53Gterial fills all 8 slots, using\u001b[85Gwhite,\u001b[92Gblack\u001b[98Gor\u001b[101Gflat-normal\r\u001b[2C\u001b[1Bstand-ins for the ones it leaves empty, so the set is \u001b[59Gways comp\u001b[69Gete.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRaising it to 16.\u001b[21G\u001b[22mIt's\u001b[26Gmostly\u001b[33Ga\u001b[35Gone-constant\u001b[48Gchange.\u001b[56GThe\u001b[60Glayout,\u001b[68Gthe\u001b[72Gdescriptor\u001b[83Gpool,\u001b[89Gthe\u001b[93Gdescriptor\u001b[104Gwrites,\u001b[112Gthe\u001b[116Gcache\r\u001b[2C\u001b[1Barrays and the refusal\u001b[26Gte\u001b[30G all\u001b[35Gfollow \u001b[38;2;177;185;249mkMaterialTextureSlots\u001b[39m. The programs' GLSL declares\u001b[93Git\u001b[96G own set-1 bindings, so\u001b[K\r\u001b[2C\u001b[1Bcheck those, but mo\u001b[23Gt ne\u001b[28Gd no edit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTrade-offs:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDevice\u001b[10Glimits\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m The fragment\u001b[22Gstage\u001b[28Galready\u001b[36Guses\u001b[41G5\u001b[43Gsamplers\u001b[52Gfrom\u001b[57Gthe\u001b[61Gframe\u001b[67Gset\u001b[71G(bindings\u001b[81G4,\u001b[84G5,\u001b[87G6,\u001b[90G10,\u001b[94G16).\u001b[99GWith\u001b[104G8\u001b[106Gmaterial\r\u001b[2C\u001b[1B  slots that's 13,\u001b[22Ginside Vulkan's guaranteed minimu\u001b[57Gof 16 per\u001b[68Gtage. With 16 slots it's 2\u001b[95G, which goes past the\r\u001b[4C\u001b[1Bguaran\u001b[12Gee. NVIDIA, AMD and l\u001b[34Gvapipe all al\u001b[76Gevery\u001b[82Gmachine you target. But you'd be\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
