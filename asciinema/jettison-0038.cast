aced\u001b[55Ghit\u001b[59Gshading\u001b[67G(J47)\u001b[73Gbecome\u001b[80Gmuch\u001b[85Geasier.\u001b[93GPer-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkward for both, and \u001b[32Gay-\u001b[36Graced\u001b[42Ghi\u001b[45G shad\u001b[52Gg effectively needs bindless.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe cost is a\u001b[17Gbigger change. Shaders have to mark t\u001b[55Gxture indices with \u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\r\u001b[2C\u001b[1BStand-ins\u001b[13Gbecome\u001b[20Gfixed\u001b[26Gindices\u001b[34Gin\u001b[37Gthe\u001b[41Garray,\u001b[48Gand\u001b[52Gvalidation\u001b[63Ggets\u001b[68Gharder\u001b[75Gto\u001b[78Gread.\u001b[84GJ64\u001b[88Galready\u001b[96Gmoves\u001b[102Gvertex\u001b[109Gdata\u001b[114Gto\r\u001b[2C\u001b[1Bfetch-by-address, so\u001b[24Gbindl\u001b[30Gss textures would\u001b[48Gfit th\u001b[55G sam\u001b[61Gdire\u001b[66Gtion.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.297, "o", "\u001b[?25l\u001b[H\u001b[3G────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BOne shared sampler\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m More\u001b[15Glots doesn't\u001b[28Ggive\u001b[33Gyou\u001b[37Ga\u001b[39Gdifferent\u001b[49Gsampler\u001b[57Gper\u001b[61Gslot.\u001b[67GIf\u001b[70Gyou\u001b[74Gwant,\u001b[80Gsay,\u001b[85Gclamped\u001b[93Gdecals\u001b[100Gnext\u001b[105Gto\u001b[108Gtiled\r\u001b[2C\u001b[1B  detail maps, that'\u001b[24G a separate change.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1BPins\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[9G\u001b[22mProbably\u001b[18Gno\u001b[21Greference\u001b[31Gframes\u001b[38Gor\u001b[41Ghashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[42G\u001b[22mThe\u001b[46Gengine\u001b[53Galready\u001b[61Grequires\u001b[70GVulkan\u001b[77G1.3\u001b[81G(\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescriptor indexing. With it, all textures\u001b[46Glive in on\u001b[57G global a\u001b[67Gray, and the material buffer holds each slot's index\r\u001b[2C\u001b[1Binto \u001b[9Gt, next to the\u001b[24Gma\u001b[27Ger\u001b[30Gal's parameter\u001b[45G. Th\u001b[51Gbenefits:\u001b[K\r\u001b[2C\u001b[1B- The per-ma\u001b[16Gerial li\u001b[25Gi\u001b[27G goes away entirely.\u001b[K\r\u001b[8C\u001b[1Bone\u001b[13Gdesc\u001b[19Gptor-pool-p\u001b[31Gr-material pattern\u001b[50Gin\u001b[53G\u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[8C\u001b[1Bplann\u001b[15Gd mesh-shader \u001b[30Gath (J40) and ray-traced hit shading (J47) become\u001b[80Gmuch\u001b[85Geasier. Per-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkwar\u001b[17Gfor both, and ray-traced hit shading effectively needs bindless.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcost\u001b[12Gis\u001b[15Ga\u001b[17Gbigger\u001b[24Gchange.\u001b[32GShaders\u001b[40Ghave\u001b[45Gto\u001b[48Gmark\u001b[53Gtexture\u001b[61Gindices\u001b[69Gwith\u001b[74G\u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\r\u001b[2C\u001b[1BStand-ins become fixed i\u001b[28Gdices in the \u001b[42Grray,\u001b[48Gand validation gets harder to read. J64\u001b[88Galready moves vertex data to\u001b[K\r\u001b[2C\u001b[1Bfetch\u001b[9Gby-address, so bindless textur\u001b[40Gs would\u001b[48Gfit\u001b[52Gthe s\u001b[58Gme dir\u001b[65Gction.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22G\u001b[22mif\u001b[25Ga\u001b[27Greal\u001b[32Gmaterial\u001b[41Gneeds\u001b[47Gmore\u001b[52Gthan\u001b[57G8\u001b[59Gnow,\u001b[64Gbump\u001b[69Gthe\u001b[73Gconstant\u001b[82Gto\u001b[85G16\u001b[88Gand\u001b[92Gadd\u001b[96Gthe\u001b[100Glimit\u001b[106Gcheck.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.402, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mCost:\u001b[22m More slots doesn't give you a different\u001b[49Gsampler\u001b[57Gper\u001b[61Gslot.\u001b[67GIf\u001b[70Gyou\u001b[74Gwant,\u001b[80Gsay,\u001b[85Gclamped\u001b[93Gdecals\u001b[100Gnext\u001b[105Gto\u001b[108Gtiled\r\u001b[2C\u001b[1B  detail maps, that's\u001b[25Ga\u001b[27Gseparate\u001b[36Gchange.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1BPins\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[22m Probably no reference frames or hashes\u001b[48Gmove,\u001b[54Gbecause\u001b[62Gnothing\u001b[70Gdraws\u001b[76Gdifferently.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe better long-term answer: bindless.\u001b[22m The engin\u001b[52G alre\u001b[58Gdy requires\u001b[70GVulkan 1.3 (\u001b[38;2;177;185;249mDeviceContext.h:93\u001b[39m),\u001b[103Gwhich\u001b[109Gincludes\r\u001b[2C\u001b[1Bdescriptor\u001b[14Gindexing.\u001b[24GWith\u001b[29Git,\u001b[33Gall\u001b[37Gtextures\u001b[46Glive\u001b[51Gin\u001b[54Gone\u001b[58Gglobal\u001b[65Garray,\u001b[72Gand\u001b[76Gthe\u001b[80Gmaterial\u001b[89Gbuffer\u001b[96Gholds\u001b[102Geach\u001b[107Gslot's\u001b[114Gindex\r\u001b[2C\u001b[1Binto it, next to the material's parameters. The benefits:\u001b[61G\u001b[K\r\u001b[2C\u001b[1B- The \u001b[10Ger-material lim\u001b[27G goes\u001b[34Gway \u001b[39Gn\u001b[41Gi\u001b[44Gly.\u001b[K\r\u001b[2C\u001b[1B- The one-descrip\u001b[21Gor-pool-per-mate\u001b[38Gial pattern in \u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[9C\u001b[1Blanned mesh-shader path (J40) and ray-traced\u001b[55Ghit\u001b[59Gshading\u001b[67G(J47)\u001b[73Gbecome\u001b[80Gmuch\u001b[85Geasier.\u001b[93GPer-material\u001b[106Gdescriptor\u001b[117Gsets\r\u001b[2C\u001b[1B \u001b[5Gar\u001b[9Gawkward for both, and \u001b[32Gay-\u001b[36Graced\u001b[42Ghi\u001b[45G shad\u001b[52Gg effectively needs bindless.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe cost is a\u001b[17Gbigger change. Shaders have to mark t\u001b[55Gxture indices with \u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\r\u001b[2C\u001b[1BStand-ins\u001b[13Gbecome\u001b[20Gfixed\u001b[26Gindices\u001b[34Gin\u001b[37Gthe\u001b[41Garray,\u001b[48Gand\u001b[52Gvalidation\u001b[63Ggets\u001b[68Gharder\u001b[75Gto\u001b[78Gread.\u001b[84GJ64\u001b[88Galready\u001b[96Gmoves\u001b[102Gvertex\u001b[109Gdata\u001b[114Gto\r\u001b[2C\u001b[1Bfetch-by-address, so\u001b[24Gbindl\u001b[30Gss textures would\u001b[48Gfit th\u001b[55G sam\u001b[61Gdire\u001b[66Gtion.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22m if a real material needs more\u001b[54Gan 8 now, bump the\u001b[73Gconstant\u001b[82Gto\u001b[85G16\u001b[88Gand\u001b[92Gadd\u001b[96Gthe\u001b[100Glimit\u001b[106Gcheck.\r\u001b[2C\u001b[1BOtherwise,\u001b[14Gput\u001b[18Gbindless\u001b[27Gon\u001b[30Gthe\u001b[34Groadmap\u001b[42Gnext\u001b[47Gto\u001b[50GJ40\u001b[54Gand\u001b[58GJ47\u001b[62Gand\u001b[66Gdon't\u001b[72Gspend\u001b[78Geffort\u001b[85Gon\u001b[88Gthe\u001b[92Gslot\u001b[97Gcount.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
