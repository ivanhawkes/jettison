[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdde\u001b[11G \u001b[1m13\u001b[22m lines, removed \u001b[1m3\u001b[22m lines\r\u001b[1B     \u001b[2m 765 \u001b[12G\u001b[22m  ed\u001b[17Gt\u001b[19Gd by \u001b[26Gst tasks, \u001b[37Go\u001b[39Ga\u001b[41Gclash\u001b[47Gthere\u001b[53Gis\u001b[56Gexpected\u001b[65Gand\u001b[69Gresolved\u001b[78Gat\u001b[81Gthe\u001b[85Gmerge.\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m-\u001b[14G**Merging.** In the primary checkout, `git merge --ff-only <task>`, then th\u001b[90G branch\u001b[98Gis\u001b[101Gdeleted\u001b[109Gand\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m \u001b[14Gits lane parked\u001b[30Gwith `git switch --detach feature\u001b[64Gbase`. A\u001b[73Gtask cut\u001b[82Gbefore another merged is\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 768 -\u001b[38;2;248;248;242m  rebased onto `feature-base` in its lane \u001b[48;2;92;2;0mand\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mgated\u001b[48;2;61;1;0m again \u001b[48;2;92;2;0mthere\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mbefore\u001b[48;2;61;1;0m it merges\u001b[48;2;92;2;0m,\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mso\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mwhat\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mlands on\u001b[48;2;61;1;0m    \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m9\u001b[14G\u001b[38;2;248;248;242m`fe\u001b[18Gture-base\u001b[28G is what was gated. Only work\u001b[58Gmerged and tested\u001b[76Gon `feature-base`\u001b[94Gis\u001b[97Ga candidate for\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m70\u001b[15G\u001b[38;2;248;248;242mmain`, which the\u001b[32Guser\u001b[37Gdecides.  \u001b[48G    \u001b[53G    \u001b[58G      \u001b[65G   \u001b[69G      \u001b[76G  \u001b[79G              \u001b[94G  \u001b[97G \u001b[99G         \u001b[109G   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 768 +\u001b[38;2;248;248;242m  rebased onto `feature-base` in its lane\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m 