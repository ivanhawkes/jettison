[0.001, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 774 +\u001b[38;2;248;248;242m  once with little risk of a clash (other modules and files, no public header in common), and they    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 775 +\u001b[38;2;248;248;242m  are done together; a lane gone idle may take a smaller piece, finished and committed to merge with  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m76\u001b[14G\u001b[38;2;248;248;242mthe r\u001b[20Gst. In\u001b[27Ga l\u001b[31Gne, a pi\u001b[40Gce is ready to\u001b[55Gmerge when\u001b[66Git builds and a local ch\u001b[91Gck \u001b[95Ghows it complete  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m77\u001b[18G\u001b[38;2;248;248;242mworking:\u001b[27Gits s\u001b[33Gites, or\u001b[42Gthe program run. No\u001b[62Gcl\u001b[65Gng-tidy, form\u001b[80G check or gate runs\u001b[100Gin a lane.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;248;248;242mOn\u001b[17Ge \u001b[20Gvery\u001b[25Gpiece\u001b[31Gis\u001b[34Gmerged,\u001b[42Gthe\u001b[46Ggate\u001b[51Gruns\u001b[56Gonce\u001b[61Gon\u001b[64G`feature-base`,\u001b[80Gtidy\u001b[85Gand\u001b[89Gthe\u001b[93Gformat\u001b[100Gcheck\u001b[106Gwith\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242m \u001b[14Git, and what they find is fixed there as one batch, then pushed. Fewer gates make the cycle         \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m80\u001b[14G\u001b[38;2;248;248;242mfast\u001b[19Gr; small, low-c\u001b[36Gsh batches keep th\u001b[55G me\u001b[59Gges orderly.       \u001b[79G    \u001b[84G     \u001b[90G    \u001b[95G  \u001b[98G         \u001b[108G   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 781 \u001b[22m - **Kept, not made per branch.** A lane is never removed, so its build trees stay warm, Debug ones\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 782 \u001b[22m   included, which ccache shares within a tree only ([\u001b[38;2;230;219;116mcompiler cache\u001b[39m](#compiler-cache)). A switch\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 783 \u001b[22m   rebuilds what the branches change.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(AGENTS.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m4\u001b[22m lines, removed \u001b[1m3\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 108 \u001b[22m Run the gate as a background task and wait for it to finish rather than polling with `sleep`.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 109 \u001b[22m With `--log` it prints the stages and a summary, and for a failed stage its errors; the full output\u001b[K\r\u001b[6C\u001b[1B\u001b[2m110\u001b[12G\u001b[22mis in the\u001b[22Gl\u001b[24Gg. Warm, it t\u001b[38Gkes 3 to\u001b[76G4), two third\u001b[90G of\u001b[94Git the\u001b[K\u001b[27;1H\u001b[20;3H\u001b[?25h"]
