[0.038, "o", "\u001b[H\r\u001b[4C\u001b[12B\u001b[1mThe linker: unknown.\u001b[26G\u001b[22mNothing\u001b[34Gin\u001b[37Gthis\u001b[42Gconversation\u001b[55Gshows\u001b[61Gwhether\u001b[69Gthe\u001b[73Glinks\u001b[79Guse\u001b[83GGNU\u001b[87Gld,\u001b[91Glld\u001b[95Gor\u001b[98Gmold.\u001b[104GThe\u001b[108GJ11\u001b[112Gchange\r\u001b[4C\u001b[1Badded \u001b[38;2;177;185;249mLINKER:--build-id=sha1\u001b[39m, which works with a\u001b[54Gy of them. The\u001b[69GNix\u001b[73Gclang\u001b[79Gwrapper\u001b[87Gusua\u001b[93Gy\u001b[95Gdefau\u001b[101Gts\u001b[104Gto GNU ld\u001b[K\r\u001b[4C\u001b[1Bunl\u001b[9Gss \u001b[38;2;177;185;249m-fuse-ld=\u001b[39m is set somewhere, but I haven't con\u001b[58Girm\u001b[62Gd that.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPrecompiled headers: none seen.\u001b[37G\u001b[22mThe\u001b[41G\"from\u001b[47Gthe\u001b[51Gprecompiled\u001b[63Gheader\"\u001b[71Gdiagnostics\u001b[83Gcame\u001b[88Gfrom\u001b[93Gclangd's\u001b[102Gown\u001b[106Geditor\u001b[113Gcache,\r\u001b[4C\u001b[1Bnot from the build.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\u001b[27;1H"]
[0.038, "o", "\u001b[H\r\u001b[4C\u001b[12Badded \u001b[38;2;177;185;249mLINKER:--build-id=sha1\u001b[39m, which works with a\u001b[54Gy of them. The\u001b[69GNix\u001b[73Gclang\u001b[79Gwrapper\u001b[87Gusua\u001b[93Gy\u001b[95Gdefau\u001b[101Gts\u001b[104Gto GNU ld     \r\u001b[4C\u001b[1Bunl\u001b[9Gss \u001b[38;2;177;185;249m-fuse-ld=\u001b[39m is set somewhere, but I haven't con\u001b[58Girm\u001b[62Gd that.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPrecompiled headers: none seen.\u001b[37G\u001b[22mThe\u001b[41G\"from\u001b[47Gthe\u001b[51Gprecompiled\u001b[63Gheader\"\u001b[71Gdiagnostics\u001b[83Gcame\u001b[88Gfrom\u001b[93Gclangd's\u001b[102Gown\u001b[106Geditor\u001b[113Gcache,\r\u001b[4C\u001b[1Bnot from the build.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC++20 modules: not used, but the build still prepares for them.\u001b[69G\u001b[22mThe\u001b[73Gcode\u001b[78Guses\u001b[83Gordinary\u001b[92G\u001b[38;2;177;185;249m#include\u001b[39ms.\u001b[103GThe\u001b[107Gbuild\u001b[113Glogs\r\u001b[4C\u001b[1Bshow CMake's module dependency scanning running anyway: lines like \"Scanning … for CXX\u001b[92Gdependencies\" and\u001b[K\r\u001b[4C\u001b[1B\"Generating CXX dyndep fil\u001b[32G\", and \u001b[38;2;177;185;249m.modmap\u001b[39m files\u001b[53Go\u001b[55G every compi\u001b[68Ge line. CMake\u001b[82Gdoes this\u001b[92Gby default for C++20\u001b[113Gwith\r\u001b[4C\u001b[1BNinja, so each file pays an extra\u001b[39Gscan step and\u001b[53Ggets nothing for\u001b[70Git.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BRough\u001b[11Gexpectations,\u001b[25Gfrom\u001b[30Gtypical\u001b[38Gresults\u001b[46Grather\u001b[53Gthan\u001b[58Ganything\u001b[67Gmeasured\u001b[76Ghere:\r\u001b[4C\u001b[1B- \u001b[1mTurning off module scanning\u001b[22m (\u001b[38;2;177;185;249mCMAKE_CXX_SCAN_FOR_MODULES OFF\u001b[39m): the cheapest\u001b[82Gwin,\u001b[87Gabout\u001b[93Gone\u001b[97Gline\u001b[102Gof\u001b[105GCMake.\u001b[112GPerhaps\u001b[27;1H"]
