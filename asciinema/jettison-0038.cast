rial\u001b[42Gpattern\u001b[50Gin\u001b[53G\u001b[38;2;177;185;249mMaterialCache::AllocateSet\u001b[80G\u001b[39mgoes\u001b[85Gaway\u001b[90Gtoo.\r\u001b[2C\u001b[1B-\u001b[5GThe plann\u001b[15Gd mesh-shader path (J40) and\u001b[44Gray-traced hit shading\u001b[67G(J47) become\u001b[80Gmuch easier. Per-ma\u001b[100Ge\u001b[102Gi\u001b[104Gl\u001b[106Gdescr\u001b[112Gptor\u001b[117Gsets\r\u001b[2C\u001b[1B  are awkwa\u001b[15Gd for b\u001b[23Gth, and ray-traced\u001b[42Ghit\u001b[46Gshading\u001b[54Geffectively\u001b[66Gneeds\u001b[72Gbindless.\r\u001b[2B \u001b[3GThe cost is a bigger change. Shaders\u001b[40Ghave\u001b[45Gto\u001b[48Gmark\u001b[53Gtexture\u001b[61Gindices\u001b[69Gwith\u001b[74G\u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
