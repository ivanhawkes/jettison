[0.155, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m9\u001b[15G\u001b[22mtests/HostTests.cpp\r\u001b[6C\u001b[1B\u001b[2m20\u001b[11G\u001b[22m)\u001b[15G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mFrom now on when I ask to continue with the roadmap I want you to check the number of free lanes, whether the content\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mof them is commited and merged, and whether we can start to re-use them. Then pick out two to four pieces of work \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mthat can be completed concurrently with low risk of merge conflicts. We will do all the work at once, and only run \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mthe full gate after merging all of the individual work pieces. Smaller work tasks might be added as lanes become idle\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mand th\u001b[10Gse should\u001b[20Galso be completed, committed, and prep\u001b[59Gred to\u001b[66Gmerge with the other tasks.\u001b[94GThe idea is to\u001b[109Gredu\u001b[114Ge \u001b[117Ghe\u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mnumber of times w\u001b[21G ru\u001b[25G th\u001b[29G full\u001b[35Ggate to speed up development cycl\u001b[69Gs without running into cha\u001b[96Gs and\u001b[102Gke\u001b[105Gping merge \u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mconflicts and int\u001b[21Ggrati\u001b[28G issues lo\u001b[39G.\u001b[39m                                                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/jettison.lane-b/' && scri…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-b/' && scripts/heavy.sh cmake --build --preset clang-debug --target \u001b