The\u001b[7Gcost\u001b[12Gis\u001b[15Ga\u001b[17Gbigger\u001b[24Gchange.\u001b[32GShaders\u001b[40Ghave\u001b[45Gto\u001b[48Gmark\u001b[53Gtexture\u001b[61Gindices\u001b[69Gwith\u001b[74G\u001b[38;2;177;185;249mnonuniformEXT\u001b[88G\u001b[39mwhere\u001b[94Gthey\u001b[99Gvary\u001b[104Gacross\u001b[111Ga\u001b[113Gdraw.\r\u001b[2C\u001b[1BStand-ins become fixed i\u001b[28Gdices in the \u001b[42Grray,\u001b[48Gand validation gets harder to read. J64\u001b[88Galready moves vertex data to\u001b[K\r\u001b[2C\u001b[1Bfetch\u001b[9Gby-address, so bindless textur\u001b[40Gs would\u001b[48Gfit\u001b[52Gthe s\u001b[58Gme dir\u001b[65Gction.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation:\u001b[22G\u001b[22mif\u001b[25Ga\u001b[27Greal\u001b[32Gmaterial\u001b[41Gneeds\u001b[47Gmore\u001b[52Gthan\u001b[57G8\u001b[59Gnow,\u001b[64Gbump\u001b[69Gthe\u001b[73Gconstant\u001b[82Gto\u001b[85G16\u001b[88Gand\u001b[92Gadd\u001b[96Gthe\u001b[100Glimit\u001b[106Gcheck.\r\u001b[2C\u001b[1BOtherwise, put bindless\u001b[27Gon the roadmap n\u001b[44Gxt\u001b[76Gd effort\u001b[85Gon\u001b[88Gthe\u001b[92Gslot count.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
