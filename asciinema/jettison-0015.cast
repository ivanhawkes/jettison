[0.138, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m1\u001b[17G\u001b[38;2;248;248;242msr\u001b[20G/Sc\u001b[24Gne.cpp star-system     \u001b[48G         \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m2\u001b[31G\u001b[38;2;248;248;242mcelestial  \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m3\u001b[12G\u001b[38;2;248;248;242mim/src/SaveGame.c\u001b[30Gp galaxy  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/app/include/jettison/app/AppArguments.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m lin\u001b[18G, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[2m 71 \u001b[22m \u001b[12G \u001b[38;2;117;113;94m// is then the same in every run. Zero for the wall clock.\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m2\u001b[13G\u001b[22m\u001b[38;2;166;226;46mdouble\u001b[39m frameStep{\u001b[38;2;190;132;255m0.0\u001b[39m};\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[13G\u001b[22m\u001b[38;2;117;113;94m// Console lines run as if typed (--run), in the order given among those due on one frame: a\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 74 -\u001b[38;2;248;248;242m  // camera placed for a screenshot, say, or a \u001b[48;2;92;2;0mship\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mundocked\u001b[48;2;61;1;0m and a screenshot some frames later.       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 74 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// camera placed for a screenshot, say, or a \u001b[48;2;4;71;0mvehicle\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mmoved\u001b[48;2;2;40;0m and a screenshot some frames later.\u001b[38;2;248;248;242m       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 75 \u001b[22m   \u001b[38;2;166;226;46mstd\u001b[39m::\