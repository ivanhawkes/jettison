[0.016, "o", "\u001b[?25l\u001b[H\u001b[10G\u001b[2m1\u001b[15G\u001b[22mincludes n\u001b[26G Vulka\u001b[33G header.\u001b[42GThe resource manager updates once a\u001b[78Gfram\u001b[83G, before the render.\r\u001b[9C\u001b[1B\u001b[2m2\u001b[13G\u001b[22m \u001b[15G`RunFrameLoop` runs `Tick` (t\u001b[45Ge scheduler's pha\u001b[63Ges, from input to render) until\u001b[95Gclose.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1973 \u001b[13G\u001b[22m-\u001b[15G**Jumps**.\u001b[26GJ\u001b[28Gjumps\u001b[34Gout\u001b[38Gthrough\u001b[46Gthe\u001b[50Gnext\u001b[55Gof\u001b[58Gthe\u001b[62Gshown\u001b[68Gsystem's\u001b[77Glanes,\u001b[84Gso\u001b[87Gjumping\u001b[95Gagain\u001b[101Gtours\u001b[107Gthem;\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b[11Gocs/build-and-gates.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, \u001b[22Gmoved \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22mwhen \u001b[18Ghere is no dir\u001b[33Gc\u001b[35Gory, as \u001b[44Gn a shipped build; the test content likewi\u001b[88G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m167\u001b[12G\u001b[22m(`jettis\u001b[21Gn_test_\u001b[29Gontent`, `jet\u001b[43Gison_test_cont\u001b[58Gnt_pack`),\u001b[69Gunder\u001b[75G`build/<preset>/source/test`.\u001b[105G`--assets\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22m <directory | pa\u001b[29Gk>` selects other engi\u001b[52Ge assets,\r\u001b[5C\u001b[1B\u001b[2m 168 \u001b[22m `--content <directory | pack>` other content, and\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m69\u001b[12G\u001b[38;2;248;248;242m`--scene <fi\u001b[25Ge>` / `--save-scene <file>` load and write scene graphs\u001b[48;2;92;2;0m, and `--system <virtual path>`\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 170 -\u001b[38;2;248;248;242m(`systems/halcyon.yaml`) runs the scene a star system builds alone, in place of a scene file.         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 169 +\u001b[38;2;248;248;242m`--scene <file>` / `--save-scene <file>` load and write scene graphs\u001b[48;2;4;71;0m.\u001b[48;2;2;40;0m                                 \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m0\u001b[12G\u001b[22m`--gpu <name>` \u001b[28Graws\u001b[33Gwith the\u001b[42GGPU\u001b[46Gwhose name has that text in\u001b[74Git (`5060`, `llvmpipe`), in pl\u001b[105Gce\u001b[108Gof\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22mthe one the\u001b[24Grend\u001b[29Grer chooses,\u001b[46Gon\u001b[49G with the\u001b[59Gmonitor on \u001b[71Gt; \u001b[75Ghe log\u001b[82Glists\u001b[88Gthe d\u001b[94Gvices it saw.\r\u001b[5C\u001b[1B\u001b[2m 172 \u001b[12G\u001b[22m`--user-dir\u001b[24G<directory>`\u001b[37Gputs\u001b[42Gthe\u001b[46Guser's\u001b[53Gfiles\u001b[59Gunder\u001b[65Gone\u001b[69Gdirectory\u001b[79Gin\u001b[82Gplace\u001b[88Gof\u001b[91Gthe\u001b[95GXDG\u001b[99Gones:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Editing docs/architecture.md\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(docs/architecture.md)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.076, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1481 +\u001b[38;2;248;248;242mA body \u001b[48;2;4;71;0m(`BodyComponent`) \u001b[48;2;2;40;0mdrawn as a sphere can have air (`AtmosphereComponent`) and rings            \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m48\u001b[13G\u001b[22m(`RingsCo\u001b[23Gponent`), given in\u001b[42Ga scene file (10a). Both\u001b[67Ga\u001b[69Ge maths over a sphere rather than\u001b[103Gmeshes\u001b[110Gor\r\u001b[7C\u001b[1B\u001b[2m48\u001b[13G\u001b[22mtables: `atmosphere.glsl` and `rings.glsl`, written i\u001b[68Gthe sub\u001b[76Get of GLSL\u001b[87Gthat GLM compiles, so the\r\u001b[5C\u001b[1B\u001b[2m 1484 \u001b[13G\u001b[22mrender\u001b[20Gsuite\u001b[26Gruns\u001b[31Gthe\u001b[35Gshaders'\u001b[44Gown\u001b[48Gsource\u001b[55Gas\u001b[58GC++\u001b[62G(`render/Atmosphere.h`)\u001b[86Gagainst\u001b[94Gintegration\u001b[106Gby\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b[11Gocs/archit\u001b[22Gcture.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[22m lines\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2023 \u001b[22m   loader and \u001b[27Ghe writer share one ch\u001b[50Gck of wha\u001b[60G a file may say. It has transform, parent,\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2024 \u001b[13G\u001b[22m  world-transform, camera, lig\u001b[44Gt (a point or a spot,\u001b[66Gwith\u001b[71Ga\u001b[73Grange),\u001b[81Gsun,\u001b[86Gsky,\u001b[91Gcolour\u001b[98Ggrade\u001b[104Gand\u001b[108Gmesh\r\u001b[6C\u001b[1B\u001b[2m2025 \u001b[22m   \u001b[17Gmpo\u001b[21Gents (a glTF\u001b[34Gmodel by\u001b[43Gvirtual path or a procedural\u001b[72Gshape\u001b[78G-\u001b[80GUV,\u001b[84Gico\u001b[88Gor\u001b[91Gcube\u001b[96Gsphere,\u001b[104Gbox,\u001b[109Gring,\r\u001b[5C\u001b[1B\u001b[2m      \u001b[22m  cylinder\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m2026 -\u001b[38;2;248;248;242m  - and optionall\u001b[31G a material file, by\u001b[52Gvir\u001b[56Gual pa\u001b[63Gh), ce\u001b[70Ge\u001b[72Gtial bod\u001b[81Ges placed by\u001b[94Gth\u001b[97G star system\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 2027 -\u001b[38;2;248;248;242m  \u001b[48;2;92;2;0mthe scene names (a virtual path too), an \u001b[48;2;61;1;0morbit camera rig, and the animation module's              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2026 +\u001b[38;2;248;248;242m  - and optionally a material file, by virtual path), bodies (`BodyComponent`, the `celestial` record\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m      +\u001b[38;2;248;248;242m, by name, which a game may place), an                                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 2027 +\u001b[38;2;248;248;242m  orbit camera rig, and the animation module's                                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 2028 \u001b[15G\u001b[22mrotation-animation,\u001b[35Gskeleton\u001b[44Gand\u001b[48Ganimation-player\u001b[65Gcomponents,\u001b[77Ga\u001b[79Gclip\u001b[84Gfile's\u001b[91Gplayer\r\u001b[1B \u001b[3G   \u001b[2m 2029 \u001b[22m   (`ClipPlaye\u001b[27GCo\u001b[30Gponent`)\u001b[39Gand\u001b[43Gan\u001b[46Gentity's\u001b[55Glayer.\u001b[62GIt\u001b[65Gnames\u001b[71Gno\u001b[74Gdevice:\u001b[82Ga\u001b[84Gmodel\u001b[90Gmesh\u001b[95Gholds\u001b[101Gits\u001b[105Grig\u001b[109Gas\u001b[112Ga\r\u001b[1B     \u001b[2m 2030 \u001b[22m   resource handle (`RigComponent`),\u001b[49Gand\u001b[53G`SceneUpdateSystem`\u001b[73Gposes\u001b[79Gthe\u001b[83Gmodel\u001b[89Gonce\u001b[94Gthe\u001b[98Grig\u001b[102Gis\u001b[105Gin,\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m7m 47s · ↓\u001b[39m \u001b[38;2;153;153;153m34.9k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H