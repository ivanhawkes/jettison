[0.011, "o", "\u001b[?25l\u001b[H\u001b[5G \u001b[7Ground, with its air and ri\u001b[34Ggs. In scene files it is\u001b[59Gstill written as \u001b[38;2;177;185;249mcelestial\u001b[39m until slice\u001b[98G7 renames saved names.\r\u001b[4C\u001b[1B-\u001b[7GThe save migration from\u001b[31Gversion 1\u001b[41Ghas a\u001b[47Gneutral name, and\u001b[65Gthe docs no longer mention\u001b[92G\u001b[38;2;177;185;249m--system\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAllow-list:\u001b[22m down from 51 to 31 e\u001b[38Gtries.\u001b[45GFiv\u001b[49G a\u001b[52Ge the smoke sequence's jump stage, left\u001b[92Gfor slice\u001b[102G4;\u001b[105G26\u001b[108Gare\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5Gdock's, for\u001b[17Gslice 5.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPins:\u001b[22m none moved. Manifest's\u001b[34G53\u001b[37Gsuites\u001b[44Gpass\u001b[49Gwhen\u001b[54Gbuilt\u001b[60Gagainst\u001b[68Gthis\u001b[73Glocal\u001b[79Gengine,\u001b[87Gand\u001b[91Gthe\u001b[95Greference\u001b[105Gframes\u001b[112Gare\r\u001b[2C\u001b[1B \u001b[5Gunchanged.\u001b[16G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne departure from the plan:\u001b[32G\u001b[22mthe\u001b[36Gplan\u001b[41Gsaid\u001b[46Gthe\u001b[50Gsave\u001b[55Gmigration\u001b[65Gshould\u001b[72Gbe\u001b[75G\"supplied\u001b[85Gby\u001b[88Gthe\u001b[92Ggame\".\u001b[99GI\u001b[101Gkept\u001b[106Git\u001b[109Gin\u001b[112Gthe\r\u001b[2C\u001b[1Bengine and only made its wording\u001b[36Gneutral. Version 1's save header was the engin\u001b[83G's own record, so\u001b[101Ga game would have\r\u001b[2C\u001b[1Bnothing to\u001b[14Gsupply, and a\u001b[28Gh\u001b[30Gok for it would be new\u001b[53GAPI\u001b[57Gwith\u001b[62Gno user. Say if you want it\u001b[90Gthe plan's\u001b[101Gway.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\r\u001b[2C\u001b[1B\u001b[22m- Push,\u001b[11Gthen\u001b[16Gmove\u001b[21GManifest's\u001b[32GSDK\u001b[36Gpin\u001b[40Gto\u001b[43G\u001b[38;2;177;185;249mb9896d3\u001b[39m.\u001b[52GBoth\u001b[57Gneed\u001b[62Gyour\u001b[67Ggo-ahead.\r\u001b[4C\u001b[1BSlice\u001b[11G4 (transit, portals,\u001b[32Gmotion pr\u001b[42Gfiles and\u001b[52Gslots) is\u001b[62Gthe large, risky\u001b[79Gone:\u001b[84Git\u001b[87Ghas\u001b[91Gto\u001b[94Gkeep\u001b[99Gevery\u001b[105Gpinned\u001b[112Ghash\r\u001b[2C\u001b[1B \u001b[5Gbit-identic\u001b[17Gl. I'd use Opus a\u001b[35G high e\u001b[43Gfort; a cheaper\u001b[59Gmodel is likely to c\u001b[80Gst rework.\u001b[91GStart it in a\u001b[105Gfresh ses\u001b[115Gion\u001b[119Gor\r\u001b[4C\u001b[1Baf\u001b[8Ger \u001b[38;2;177;185;249m/compact\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Grun\u001b[16Gthe\u001b[20Gcross-review;\u001b[34Git's\u001b[39Gmeant\u001b[45Gfor\u001b[49Gwhen\u001b[54Gthe\u001b[58Gwhole\u001b[64Gextraction\u001b[75Gcloses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 18m 18s · done 9:32 pm\r\u001b[1B\u001b[39m \u001b[3G                                  \u001b[97G\u001b[38;2;153;153;153mctrl+g to edit in nano\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0015 ─\r\u001b[1B\u001b[39m❯ Make a note to revisit the save plan issue at a later time.\u001b[K\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
