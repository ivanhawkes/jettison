[0.102, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 1971 \u001b[22m   includes no Vulkan header. The resource manager updates once a frame, before the render.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1972 \u001b[22m   `RunFrameLoop` runs `Tick` (the scheduler's phases, from input to render) until close.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1973 \u001b[22m - **Jumps**. J jumps out through the next of the shown system's lanes, so jumping again tours them;\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/build-and-gates.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m2\u001b[30G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 166 \u001b[22m when there is no directory, a\u001b[42G in a shi\u001b[52Gped build; the\u001b[67Gtest\u001b[72Gcontent\u001b[80Glikewise\r\u001b[1B     \u001b[2m 167 \u001b[12G\u001b[22m(`jettison_test_content`,\u001b[38G`jettison_test_content_pack`),\u001b[69Gunder\u001b[75G`build/<preset>/source/test`.\u001b[105G`--assets\r\u001b[6C\u001b[1B\u001b[2m  \u001b[10G \u001b[13G\u001b[22m<directory | pack>` selects other engine assets,\u001b[K\r\u001b[6C\u001b[1B\u001b[2m168 \u001b[12G\u001b[22m`--content <dir\u001b[28Gctory |\u001b[36Gpack>`\u001b[43Gother\u001b[49Gcontent,\u001b[58Gand\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 169 -\u001b[38;2;248;248;242m`--scene <file>` / `--save-scene <file>` load and write scene graphs\u001b[48;2;92;2;0m, and `--system <virtual path>`\u001b[48;2;61;1;0m   \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m170 -\u001b[38;2;248;248;242m(`systems/ha\u001b[25Gcyon.yaml`) runs t\u001b[44Ge scene a st\u001b[57Gr system builds alone, in place\u001b[89Gof a\u001b[94Gscen\u001b[99G file.  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m169 +\u001b[38;2;248;248;242m`--scene <file>` / `--save-scene <file>` load and write scene graphs\u001b[48;2;4;71;0m.\u001b[48;2;2;40;0m                                 \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m170 \u001b[12G\u001b[22m`--gpu <name>` draws with the GPU whose\u001b[52Gname\u001b[57Ghas\u001b[61Gthat\u001b[66Gtext\u001b[71Gin\u001b[74Git\u001b[77G(`5060`,\u001b[86G`llvmpipe`),\u001b[99Gin\u001b[102Gplace\u001b[108Gof\r\u001b[6C\u001b[1B\u001b[2m171 \u001b[12G\u001b[22mthe\u001b[16Gone\u001b[20Gthe\u001b[24Grenderer\u001b[33Gchooses,\u001b[42Gthe\u001b[46Gone\u001b[50Gwith\u001b[55Gthe\u001b[59Gmonitor\u001b[67Gon\u001b[70Git;\u001b[74Gthe\u001b[78Glog\u001b[82Glists\u001b[88Gthe\u001b[92Gdevices\u001b[100Git\u001b[103Gsaw.\r\u001b[6C\u001b[1B\u001b[2m1\u001b[9G2 \u001b[12G\u001b[22m`--user-dir <directory>` puts the user's files under one directory in place of the XDG ones:\u001b[K\r\u001b[2C\u001b[2BRunn\u001b[11G\u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ sed -n 1945,1972p docs/architecture.md; sed -n 165,171p docs/build-and-gates.md\r\u001b[14C\u001b[2B7m 31s · ↓\u001b[39m \u001b[38;2;153;153;153m34.1k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
