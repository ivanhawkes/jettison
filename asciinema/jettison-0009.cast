[0.005, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mNPCs start at the starter venue,\u001b[22m s\u001b[40G its fr\u001b[48Ge\u001b[50Gpa\u001b[53Gs cap how\u001b[63Gmany there can\u001b[78Gbe.\r\u001b[2C\u001b[2BLeft out, and\u001b[17Glisted\u001b[24Gin \u001b[28Ghe plan: scouting\u001b[46Gu\u001b[48Gknown\u001b[54Gm\u001b[56Grke\u001b[60Gs, standing\u001b[72Groutes,\u001b[80GWasm\u001b[85Gpolicies,\u001b[95Gand\u001b[99Gthe\u001b[103Gobservation\u001b[115Gsystem\r\u001b[2C\u001b[1Brunning every step while a ship is docked.\u001b[46GT\u001b[48Gat last one me\u001b[63Gns a docked\u001b[75GNPC stop\u001b[84G the fast-forward\u001b[102Gfrom\u001b[107Gskipping\r\u001b[2C\u001b[1Bsteps.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mModel:\u001b[10G\u001b[22mstay\u001b[15Gon\u001b[18GOpus\u001b[23G5.5\u001b[27Gat\u001b[30Ghigh\u001b[35Geffort.\u001b[43GThis\u001b[48Gis\u001b[51Gmoney\u001b[57Gaccounting\u001b[68Gunder\u001b[74Gdeterministic\u001b[88Greplay,\u001b[96Gand\u001b[100Ga\u001b[102Gcheaper\u001b[110Gmodel\u001b[116Grisks\r\u001b[2C\u001b[1Bsub\u001b[7Gle rounding or replay bugs that would get l\u001b[51Gcked into saves.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShall I\u001b[11Gstart\u001b[17Gimplementing?\u001b[31GI'd\u001b[35Gbegin\u001b[41Gwith\u001b[46G\u001b[38;2;177;185;249mRequests::Act\u001b[39m,\u001b[61Gthe\u001b[65Gpolicy\u001b[72Gcomponent\u001b[82Gand\u001b[86Gits\u001b[90Gcommand.\u001b[99GIt\u001b[102Gmay\u001b[106Gbe\u001b[109Gworth\r\u001b[2C\u001b[1Brunning\u001b[11G\u001b[38;2;177;185;249m/compact\u001b[20G\u001b[39mfirst,\u001b[27Gsince\u001b[33Gthe\u001b[37Gplanning\u001b[46Greads\u001b[52Gfilled\u001b[59Ga\u001b[61Glot\u001b[65Gof\u001b[68Gthe\u001b[72Gcontext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 4m 38s · done 1:25 pm\u001b[39G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mMake allowance for the futu