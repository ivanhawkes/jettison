0Gsequence\u001b[79Gnumber,\u001b[87Gledger\u001b[94Gor\u001b[97Grecording.\u001b[108GIt's\u001b[113Ghow\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gexecutor will\u001b[19Gse\u001b[22Gd\u001b[24Gthe same commands a playe\u001b[50G does.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mWorld::Policy\u001b[19G\u001b[39mand \u001b[38;2;177;185;249mWorld::Job\u001b[39m are saved\u001b[44Gon the\u001b[51Gship and\u001b[60Gchecked\u001b[68Gwhen\u001b[73Ga\u001b[75Gsave\u001b[80Gloads.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m lets only the ship's own\u001b[50Gr set\u001b[56Gits\u001b[60Gpolicy.\u001b[68GAn edit leaves the\u001b[87Gjob\u001b[91Gand\u001b[95Gits\u001b[99Gcargo\u001b[105Gwhere\u001b[111Gthey\u001b[116Gare,\r\u001b[2C\u001b[1B \u001b[5Gand allowance already spent stays\u001b[40Gpent.\u001b[46G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNew\u001b[9Gtests in the \u001b[38;2;177;185;249mcommand\u001b[39m and \u001b[38;2;177;185;249mpolicy\u001b[39m suites.\r\u001b[4C\u001b[1BThe\u001b[9G\u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2;177;185;249mfixture\u001b[39m pi\u001b[32Gned hashe\u001b[42G moved\u001b[49Gbecause\u001b[57Gthe\u001b[61Gtwo\u001b[65Gnew\u001b[69Gcomponents\u001b[80Gare\u001b[84Gregistered.\u001b[96GWith\u001b[101Gthose\u001b[107Gregistrations\r\u001b[2C\u001b[1B \u001b[5Gtaken out, both\u001b[21Gpins pass at their old values, so the change is\u001b[69Gt\u001b[71G the save's layout, not its state.\u001b[K\r\u001b[4C\u001b[1B     \u001b[11G    \u001b[16G    \u001b[21G    \u001b[26G    \u001b[31G  \u001b[34G     \u001b[40G   \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
