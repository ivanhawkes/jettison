okers,\r\u001b[2C\u001b[1Bobservation and travel.\u001b[K\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mthought for 5s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
