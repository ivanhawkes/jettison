[0.016, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m983\u001b[12G\u001b[38;2;248;248;242m  \u001b[15Gaken first at the next hour\u001b[48;2;4;71;0m and all of it before the ship leaves\u001b[48;2;2;40;0m.\u001b[81GThe\u001b[85Gestimate's\u001b[96Gcharges\u001b[104Gare\u001b[108Gone\u001b[112Gfu\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242mnction's, `Policy::Charges`: the                                                                      \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m4\u001b[14G\u001b[22mdestination's docking\u001b[36Gfee, and the source's if the ship\u001b[70Gmust fly\u001b[79Gthere first. A lot keeps the\u001b[K\r\u001b[8C\u001b[1B\u001b[2m5\u001b[14G\u001b[22mcharg\u001b[20Gs attributed to\u001b[38G a\u001b[41G they fall (`cha\u001b[58Gges`, whole\u001b[70Gcredit\u001b[77G: its jou\u001b[87Gneys' docking fees and\r\u001b[5C\u001b[1B\u001b[2m 986 \u001b[14G\u001b[22mits\u001b[18Gberth\u001b[24Ghours),\u001b[32Gand\u001b[36Gits\u001b[40Gsale\u001b[45Gfloor\u001b[51Grecovers\u001b[60Gthem\u001b[65Gwith\u001b[70Gits\u001b[74Gcost.\u001b[80GTheir\u001b[86Greal\u001b[91Gamounts\u001b[99Gand\u001b[103Gbases,\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m1\u001b[22m new diagnostic issue in 1 file (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mArrears will be subject to inter\u001b[36Gst rate charges on\u001b[55Gouts\u001b[60Ganding amoun\u001b[73Gs, which will be charged\u001b[98Gdaily and \u001b[109Gccumulate \u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mwith th\u001b[11G pr\u001b[16Gciple in\u001b[25Garears. The game sh\u001b[45Guld set a max threshhold rate considered 'ursury' to prevent players going \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255mabove certain amounts e.g. a max of 35% compounded daily.\u001b[39m                                                             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'\u001b[6G adding arrears interest at 35% as an an\u001b[47Gual rate compounded\u001b[67Gdaily,\u001b[74Gand\u001b[78Gthe\u001b[82Gvenue\u001b[88Goperator\u001b[97Gsets\u001b[102Gthe\u001b[106Grate\u001b[111Gwithin\u001b[118Gthe\r\u001b[2C\u001b[1Bgame's\u001b[10Gusury\u001b[16Gcap.\u001b[21GI'm\u001b[25Gwaiting\u001b[33Gon\u001b[36Gthe\u001b[40Gbuild\u001b[46Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Editing ~/projects/manifest/source/game/content/src/Content.cpp\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~/projects/manifest/source/game/content/src/Content.cpp)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
