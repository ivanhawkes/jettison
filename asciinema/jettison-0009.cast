[0.039, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent checks:\u001b[21G\u001b[22ma\u001b[23Gtrader\u001b[30Glisted\u001b[37Gtwice\u001b[43Gis\u001b[46Grefused.\u001b[55GSo\u001b[58Gis\u001b[61Ga\u001b[63Glist\u001b[68Gthat\u001b[73Gleaves\u001b[80Gthe\u001b[84Gstarter\u001b[92Gstation\u001b[100Gno\u001b[103Gfree\u001b[108Gpad\u001b[112Gor\r\u001b[2C\u001b[1B  life-support connection for\u001b[33Ga player.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges from the plan\u001b[22m (no\u001b[29G i\u001b[33Gthe stage-4 pla\u001b[49G):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLogin refusal is in the server, not \u001b[38;2;177;185;249mmanifest-token\u001b[39m.\u001b[57G\u001b[22mThe\u001b[61Gtoken\u001b[67Gtool\u001b[72Gnever\u001b[78Gloads\u001b[84Gthe\u001b[88Gworld,\u001b[95Gso\u001b[98Git\u001b[101Gcan't\u001b[107Gtell\u001b[112Gwho\u001b[116Gis\u001b[119Gan\r\u001b[2C\u001b[1B \u001b[5GNPC. The server checks when a client logs in and refuses any NPC\u001b[70Gprincip\u001b[78Gl,\u001b[81Gwhatever the token file holds. That\u001b[K\r\u001b[4C\u001b[1Balso covers token\u001b[23Gfiles\u001b[29Gedited\u001b[36Gby\u001b[39Ghand.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA field instead of a component.\u001b[37G\u001b[22mI\u001b[39Gused\u001b[44Gthe\u001b[48G\u001b[38;2;177;185;249mnpc\u001b[52G\u001b[39mfield\u001b[58Grather\u001b[65Gthan\u001b[70Ga\u001b[72Gseparate\u001b[81G\u001b[38;2;177;185;249mWorld::Npc\u001b[92G\u001b[39mcomponent,\u001b[103Gwhich\u001b[109Gkeeps\u001b[115Git\u001b[118Gto\r\u001b[2C\u001b[1B  one\u001b[9Gsaved bool.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPins:\u001b[9G\u001b[22mtwo\u001b[13Gpinned\u001b[20Gsave\u001b[25Ghashes\u001b[32Gmoved,\u001b[39Gin\u001b[42G\u001b[38;2;177;185;249mcompany\u001b[50G\u001b[39mand\u001b[54G\u001b[38;2;177;185;249mfixture\u001b[39m.\u001b[63GWith\u001b[68Gthe\u001b[72Gnew\u001b[76Gfield\u001b[82Gtaken\u001b[88Gout\u001b[92Gof\u001b[95Gthe\u