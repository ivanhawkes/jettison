[0.060, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B-\u001b[7Ga re\u001b[12Gion's governor\u001b[27Gsets\u001b[32Gits\u001b[36Gtax\u001b[40Grates;\r\u001b[6C\u001b[1Bevery credit\u001b[20Gr cha\u001b[26Gges da\u001b[33Gly-compounding\u001b[48Ginterest\u001b[57Gon\u001b[60Garrears,\u001b[69Gcapped\u001b[76Gby\u001b[79Gthe\u001b[83Ggame's\u001b[90Gusury\u001b[96Glimit.\r\u001b[6C\u001b[1BEach change applies only to later charges. \u001b[1mW18\u001b[22m adds the operators' command to s\u001b[87Gt fees, \u001b[1mL29\u001b[22m the\u001b[103Ggovernors'\u001b[114Gtax\r\u001b[4C\u001b[1B \u001b[7Gr\u001b[9Gtes, \u001b[16Gd \u001b[1mL15\u001b[22m th\u001b[25G client screens\u001b[41Gfor both.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mD-099 / L30:\u001b[18G\u001b[22mregions\u001b[27Gan buy ess\u001b[39Gtials\u001b[45Gon credit,\u001b[56Gowing\u001b[62Gthe\u001b[66Gseller\u001b[73Gor\u001b[76Ga\u001b[78Glender,\u001b[86Gwho\u001b[90Gcharges\u001b[98Ginterest\u001b[107Gwithin\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gusury limit.\u001b[18G\u001b[K\r\u001b[4C\u001b[1B- So a government\u001b[23Gcan\u001b[27Gfeed\u001b[32Gits\u001b[36Gpeople\u001b[43Gthrough\u001b[51Ga\u001b[53Gbad\u001b[57Gpatch,\u001b[64Gor\u001b[67Gspiral\u001b[74Ginto\u001b[79Gdebt.\r\u001b[6C\u001b[1BThat\u001b[12Gdebt is how \u001b[25G merchan\u001b[34G class and a banking class cont\u001b[66Gol regions in\u001b[80Girectly.\r\u001b[6C\u001b[1BStill open: w\u001b[21Gat\u001b[24Gholding a region's \u001b[44Gebt gives the credito\u001b[66G, and what\u001b[77Ghappens on default.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlice 2 (now at nominal values):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFe\u001b[8Gs per venue:\u001b[22m each venue has\u001b[36Gits\u001b[40Gown\u001b[44Gfees\u001b[49G(\u001b[38;2;177;185;249mWorld::Fees\u001b[39m),\u001b[64Gso\u001b[67GW18\u001b[71Gcan\u001b[75Glet\u001b[79Goperators\u001b[89Gchange\u001b[96Gthem.\u001b[102GThey\u001b[107Gstart\u001b[113Gat\u001b[116Gthe\