[0.257, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCurrent priority:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mManifest W10:\u001b[20G\u001b[22mstanding\u001b[29Gtrade\u001b[35Gpolicies\u001b[44Gand\u001b[48GNPC\u001b[52Gjobs.\u001b[58GIt's\u001b[63Gthe\u001b[67Gnext\u001b[72Gtask.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mEncryption:\u001b[18G\u001b[22ma\u001b[20Gkey\u001b[24Gexchange\u001b[33Gwith\u001b[38Gthe\u001b[42Gserver's\u001b[51Gkey\u001b[55Gpinned\u001b[62Gby\u001b[65Gthe\u001b[69Gclient,\u001b[77Gthen\u001b[82Gevery\u001b[88Gpacket\u001b[95Gsealed.\u001b[103GIt's\u001b[108Gneeded\u001b[115Gbefore\r\u001b[2C\u001b[1B   Manifest hosts\u001b[21Goutside\u001b[29Ga\u001b[31Gtrusted\u001b[39Gnetwork.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mOngoing:\u001b[22m map each Ma\u001b[27Gifest mechanic to the public AP\u001b[59G or\u001b[64Go a reusable gap\u001b[81Gprovisioned\u001b[93Ghere,\u001b[99Gand\u001b[103Gupdate\u001b[110Gthe\u001b[114GSDK\r\u001b[2C\u001b[1B  \u001b[6Gpin.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCarried forward:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFirst:\u001b[12G\u001b[22mscript\u001b[19Gauthority\u001b[29Gunder\u001b[35Gnetworked\u001b[45Gplay.\u001b[51GThe\u001b[55Gserver\u001b[62Gshould\u001b[69Gdecide\u001b[76Gwhose\u001b[82Gbehalf\u001b[89Ga\u001b[91Gscript\u001b[98Gacts\u001b[103Gon,\u001b[107Gper\u001b[111Gcall,\r\u001b[4C\u001b[1Bincluding\u001b[15Ga\u001b[17G\u001b[38;2;177;185;249mSim::Controller\u001b[33G\u001b[39mnested\u001b[40Ginside\u001b[47Ga\u001b[49Gcommand's\u001b[59Gfields.\r\u001b[2C\u001b[1B- \u001b[1mNext:\u001b[22m behaviour-tree\u001b[26Gextensions\u001b[37G(reactive,\u001b[48Gparallel\u001b[57Gand\u001b[61Gsubtree\u001b[69Gnodes,\u001b[76Ga\u001b[78Gblackboard),\u001b[91Gscripts\u001b[99Greading\u001b[107Gthe\u001b[111Gworld,\u001b[118Gmod\r\u001b[2C\u001b[1B \u001b[5Glist editing and \u001b[24Gt reloa\u001b[32G, picking in\u001b[45Ga paused world, and physics extras (compound shapes,\u001b[98Gfiltering, over\u001b[114Gap\r\u001b[4C\u001b[1Bqueries).\u001b[15G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThen\u001b[11G\u001b[22mlogging in th\u001b[26Gshell, crash reports from other threads, prefetching a jump's destination, glTF collision\u001b[K\r\u001b[4C\u001b[1Bme\u001b[8Ghes, steeri\u001b[20Gg\u001b[22Gr\u001b[24Gund the ins\u001b[36Gde of\u001b[42Ga station, deck traffic, UI hot reload, fuller loc\u001b[93Gli\u001b[96Gation, and some comments\r\u001b[4C\u001b[1Bbetter as\u001b[15Gnames.\r\u001b[4C\u001b[1B\u001b[1mLast (presentation, when a scene needs it):\u001b[22m animation bl\u001b[62Gn\u001b[64Ging, audio crossfade and Doppler, cutscenes, RmlUi clip\r\u001b[5C\u001b[1Ba\u001b[8Gks and filters, transpare\u001b[34Gt-pass g\u001b[43Gp\u001b[45G, post-chain\u001b[58Ggaps, the dev \u001b[73Gools' theme, and sh\u001b[93Gdow and level-of-detail\u001b[K\r\u001b[4C\u001b[1Btuning.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
