[0.120, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 562 \u001b[12G\u001b[22m}\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 563 +\u001b[38;2;117;113;94m// A day's interest on the arrears at the yearly rate in basis points, compounded: added to what is\u001b[38;2;248;248;242m   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 564 +\u001b[38;2;117;113;94m// owed in whole credits, the part of a credit left carried to the next day.\u001b[38;2;248;248;242m                          \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 565 +\u001b[38;2;166;226;46mvoid\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mAccrue\u001b[38;2;253;151;31m(World::Arrears &arrears, \u001b[38;2;166;226;46mint\u001b[38;2;253;151;31m rateBps)\u001b[38;2;248;248;242m                                                     \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 566 +\u001b[38;2;248;248;242m{                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 567 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::\u001b[38;2;166;226;46mint64_t\u001b[38;2;248;248;242m part = arrears.owed % World::kRateYear * rateBps + arrears.carry;                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 568 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::\u001b[38;2;166;226;46mint64_t\u001b[38;2;248;248;242m interest = arrears.owed / World::kRateYear * rateBps + part / World::kRateYear;  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 569 +\u001b[38;2;248;248;242m  arrears.owed += std::\u001b[38;2;166;226;46mmin\u001b[38;2;248;248;242m(interest, kMaxCredits - arrears.owed);                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 570 +\u001b[38;2;248;248;242m  arrears.carry = part % World::kRateYear;                                                            \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m571\u001b[12G\u001b[38;2;248;248;242m}\u001b[20G       \u001b[28G                                  \u001b[63G                                       \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m572\u001b[20G\u001b[38;2;248;248;242m                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 573 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m574\u001b[12G\u001b[22m\u001b[38;2;117;113;94m// The hour's berth fee of every docked ship, in entity order, as the hour's last step ends\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 564 -\u001b[38;2;248;248;242m// (kBerthSystem).                                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 575 +\u001b[38;2;117;113;94m// (kBerthSystem), on the day's last its arrears' interest first.\u001b[38;2;248;248;242m                                     \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 576 \u001b[22m \u001b[38;2;166;226;46mvoid\u001b[39m \u001b[38;2;166;226;46mBerth\u001b[38;2;253;151;31m(SimWorld &world, \u001b[38;2;166;226;46mconst\u001b[38;2;253;151;31m Rules &rules)\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 577 \u001b[22m {\u001b[K\r\u001b[1B     \u001b[2m 578 \u001b[22m   \u001b[38;2;249;38;114mif\u001b[39m ((world.\u001b[38;2;166;226;46mClock\u001b[39m().\u001b[38;2;166;226;46mStep\u001b[39m() + \u001b[38;2;190;132;255m1\u001b[39m) % rules.hourSteps != \u001b[38;2;190;132;255m0\u001b[39m)\r\u001b[15C\u001b[2B\u001b[38;2;153;153;153m6m 24s ·\u001b[25G↓\u001b[39m \u001b[38;2;153;153;153m33.0k\u001b[33Gtok\u001b[37Gns)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle)\u001b[39m\u001b[27;1H\u001b[24;29H\u001b[?25h"]
