[0.377, "o", "\u001b[?25l\u001b[H\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gwritten\u001b[16Gthe\u001b[20GW10\u001b[24Gplan.\u001b[30GIt's\u001b[35Gin\u001b[38G\u001b[38;2;177;185;249m../manifest/docs/stage-4-trading-plan.md\u001b[79G\u001b[39mas\u001b[82G\"W10\u001b[87Gplan,\u001b[93G2026-11-21\",\u001b[106Gand\u001b[110Gyour\u001b[115Gfour\r\u001b[1B \u001b[3Gchoices ar\u001b[14G recorded\u001b[24Gas D-097 in \u001b[38;2;177;185;249mdecisio\u001b[44G-l\u001b[47Gdger.md\u001b[39m. Nothing is committed and no code is written yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEngine side:\u001b[16G\u001b[22mI\u001b[18Gdon't\u001b[24Gexpect\u001b[31Gan\u001b[34Gengine\u001b[41Gedit.\u001b[47GThe\u001b[51Gengine\u001b[58Gcan\u001b[62Galready\u001b[70Gapply\u001b[76Gcommands\u001b[85Gthat\u001b[90Ga\u001b[92Gsystem\u001b[99Gsends\r\u001b[2C\u001b[1B(\u001b[38;2;177;185;249mSimWorld::Apply\u001b[39m), and do\u001b[29Gking, trav\u001b[40Gl and the fast-forw\u001b[60Grd ov\u001b[66Gr quiet steps \u001b[81Gre all public. If\u001b[99Ga gap\u001b[105Gturns\u001b[111Gup,\u001b[115Git\r\u001b[2C\u001b[1Bgets built in Jettison\u001b[26Gfirst, as before.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe design:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mExecutor\u001b[15G\u001b[22ma\u001b[17Gnew\u001b[21GManifest\u001b[30Gsystem,\u001b[38G\u001b[38;2;177;185;249mmanifest.policy\u001b[39m,\u001b[55Gruns\u001b[60Gafter\u001b[66Gthe\u001b[70Gbrokers'\u001b[79Grequote\u001b[87Gand\u001b[91Gbefore\u001b[98Gmovement.\r\u001b[4C\u001b[1B\u001b[1mCommands\u001b[15G\u001b[22mit sends th\u001b[27G pla\u001b[32Gers' own commands (place, cancel,\u001b[66Gload, unload, travel) through a\u001b[98Gnew \u001b[38;2;177;185;249mRequests::Act\u001b[39m.\u001b[117GThat\r\u001b[2C\u001b[1B \u001b[5Gruns the same checks a\u001b[34G's\u001b[37Grequest meets, with no sequence number, and isn't recorded, because a replay\u001b[K\r\u001b[4C\u001b[1Bproduces\u001b[14Gthose commands again.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPolicy, per ship:\u001b[22m \u001b[38;2;177;185;249mManifest.Policy.Set\u001b[43G\u001b[39mturns\u001b[49Git\u001b[52Gon\u001b[55Gor\u001b[58Goff\u001b[62Gand\u001b[66Gsets\u001b[71Gtwo\u001b[75Gwhole-credit\u001b[88Gamounts,\u001b[97Gboth\u001b[102G0\u001b[104Gby\u001b[107Gdefault:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mtargetProfit\u001b[39m: a\u001b[23Gtrade starts only if its es\u001b[51Gimate beats it.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mlossAllowance\u001b[39m: how far below\u001b[36Gcost\u001b[41Ga sale\u001b[48Gmay go.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJob, saved on the ship:\u001b[22m choose\u001b[36G→ fly to th\u001b[76Gestination\u001b[87G→\u001b[89Gsell,\u001b[95Gor\u001b[98Gblocked.\u001b[107GThe\u001b[111Glot\u001b[27;1H\u001b[24;3H\u001b[?25h"]
