 on an owner's\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRunning the\u001b[15Ggate.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48GCMAKE_BUILD_…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 \r\u001b[5C\u001b[1B./scripts/ci.sh --werror --asan --log build/gate-w10c.log > build/gate-w10c.out 2>&1; echo \"exit=$?\" >> \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mbuild/gate-w10c.out; tail -30 build/gate-w10c.out\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
