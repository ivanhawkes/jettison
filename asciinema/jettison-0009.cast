226;46mResting\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"Company1\"\u001b[38;2;248;248;242m) == \u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m); \u001b[55G                \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[20G\u001b[38;2;248;248;242m                          \u001b[47G  \u001b[50G   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[14G\u001b[38;2;248;248;242m    hosted.world.\u001b[38;2;166;226;46mRegistry\u001b[38;2;248;248;242m().\u001b[38;2;166;226;46mget\u001b[38;2;248;248;242m<World::Journey>(hosted.\u001b[38;2;166;226;46mShip\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"Ship1\"\u001b[38;2;248;248;242m)).venueId\u001b[92G==\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[18G\u001b[38;2;230;219;116m\"VenueBrineHighport\"\u001b[38;2;248;248;242m);                                                   \u001b[92G  \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m}\u001b[18G                                                                                                \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m All 48 suites pass, and no pinned hash moved: no fixture has a job, so the new system changes no state. Updating the\r\u001b[2C\u001b[1BW10 plan where the implementation settled details.\u001b[K\r\u001b[42C\u001b[2B\u001b[38;2;153;153;153mthought for 5s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
