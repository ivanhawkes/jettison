[0.005, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mstart the plan\u001b[39m                                                                                                        \r\u001b[2C\u001b[2B\u001b[49m\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m9\u001b[22m files, ran \u001b[1m2\u001b[22m shell commands \u001b[63G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mReading Manifest's\u001b[22GW10\u001b[26Grequirements;\u001b[40Gthe\u001b[44Gplans\u001b[50Gsay\u001b[54Gseveral\u001b[62Gchoices\u001b[70Gmust\u001b[75Gbe\u001b[78Gsettled\u001b[86Gbefore\u001b[93Gimplementation,\u001b[109Gso\u001b[112GI'm\r\u001b[2C\u001b[1Bchecking\u001b[12Gwhich\u001b[18Gare\u001b[22Galready\u001b[30Gdecided.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m2\u001b[19G\u001b[22mpatterns,\u001b[29Greading\u001b[37G\u001b[1m2\u001b[39G\u001b[22mfiles,\u001b[46Glisting\u001b[54G\u001b[1m3\u001b[56G\u001b[22mdirectories…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  ~/projects/manifest/source/game/travel/include/manifest/travel/Travel.h\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Executor \u001b[39m\u001b[49m ☐ Cost split  ☐ Policy edits  ☐ Scope  ✔ Submit\u001b[65G→\r\u001b[2B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mWhat runs a standing trade policy (a player's ship while they're away, and an NPC company's)?\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mNative system (Recommended)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mA Manifest system with a saved job state per ship (choose → travel → buy → travel → sell), like the brokers' native\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mpolicy and Journ\u001b[23Gy. N\u001b[28G engine \u001b[37Gdit expected; Wasm policies stay l\u001b[72Gt\u001b[74Gr work.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[39mJettison\u001b[15Gbehaviour\u001b[25Gtrees\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153mDrive each ship by\u001b[25Gthe engine's `behaviour` system. Needs engine provisions first: a command giving an entity a \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mtree, a blackbo\u001b[22Grd\u001b[25Gof\u001b[28Gthe engine's, likely subtre\u001b[56Gs.\r\u001b[2C\u001b[1B3. Type something.\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  4.\u001b[6GChat\u001b[11Gabout\u001b[17Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0009 ─\u001b[39m\u001b[27;1H\u001b[16;1H"]
