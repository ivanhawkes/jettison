[0.084, "o", "\u001b[?25l\u001b[H    - Each\u001b[12Gcharg\u001b[18G is attributed to\u001b[36Gthe\u001b[40Gcargo\u001b[46Glot\u001b[50Git\u001b[53Gserves,\u001b[61Gcounted\u001b[69Gin\u001b[72Gthe\u001b[76Gprofit\u001b[83Gestimate,\u001b[93Gand\u001b[97Grecovered\u001b[107Gin\u001b[110Gthe\u001b[114Gminimum\r\u001b[5C\u001b[1B sale\u001b[12Gprice.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW18\u001b[22m, right after W10 in Manifest's delivery order, settles the charges' real amounts and bases, plus storage\u001b[114Gfees,\r\u001b[4C\u001b[1Btolls and the cost of life support used in transit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL28\u001b[22m, booked straight after W10, looks at why a docked fleet stops the fast-forward from skipping steps. The aim\u001b[117Gis\r\u001b[4C\u001b[1Bfor observation to run only when a covered market actually changes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThese are\u001b[15Grecorded\u001b[24Gin\u001b[27GD-097\u001b[33Gand\u001b[37Gthe\u001b[41G\"W10\u001b[46Gplan\"\u001b[52Gsection\u001b[60Gof\u001b[63Gthe\u001b[67Gstage-4\u001b[75Gplan.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat slice 1 adds:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[38;2;177;185;249mRequests::Act\u001b[19G\u001b[39mruns\u001b[24Ga\u001b[26Gcommand\u001b[34Gfor\u001b[38Gan\u001b[41Gactor\u001b[47Gstraight\u001b[56Gaway,\u001b[62Gwith\u001b[67Gno\u001b[70Gsequence\u001b[79Gnumber,\u001b[87Gledger\u001b[94Gor\u001b[97Grecording.\u001b[108GIt's\u001b[113Ghow\u001b[117Gthe\r\u001b[2C\u001b[1B  executor will send the same commands a\u001b[44Gplayer\u001b[51Gdoes.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mWorld::Policy\u001b[19G\u001b[39mand\u001b[23G\u001b[38;2;177;185;249mWorld::Job\u001b[34G\u001b[39mare\u001b[38Gsaved\u001b[44Gon\u001b[47Gthe\u001b[51Gship\u001b[56Gand\u001b[60Gchecked\u001b[68Gwhen\u001b[73Ga\u001b[75Gsave\u001b[80Gloads.\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m lets only the ship's\u001b[46Gowner set its\u001b[60Gpolicy. An ed\u001b[75G leaves the job and\u001b[95Gits\u001b[99Gcargo\u001b[105Gwhere\u001b[111Gthey\u001b[116Gare,\r\u001b[4C\u001b[1Band\u001b[9Gallowance\u001b[19Galready\u001b[27Gspent\u001b[33Gstays\u001b[39Gspent.\r\u001b[1B \u001b[3G- New test\u001b[14G in the \u001b[38;2;177;185;249mcommand\u001b[30G\u001b[39mand\u001b[34G\u001b[38;2;177;185;249mpolicy\u001b[41G\u001b[39msuites.\r\u001b[1B  - The \u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2;177;185;249mfixture\u001b[39m pinned hashes\u001b[43Gmoved\u001b[49Gbecause\u001b[57Gthe\u001b[61Gtwo\u001b[65Gnew\u001b[69Gcomponents\u001b[80Gare\u001b[84Gregistered.\u001b[96GWith\u001b[101Gthose\u001b[107Gregistrations\r\u001b[4C\u001b[1Btaken out, both pins pass at their old values, so the change is to the save's layout, not its state.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22mslice\u001b[15G2,\u001b[18Gthe\u001b[22Gcharges\u001b[30Gthemselves.\u001b[42GIt\u001b[45Gmoves\u001b[51Gthe\u001b[55Gsame\u001b[60Gpins\u001b[65Gagain,\u001b[72Gbecause\u001b[80Gstarter\u001b[88Gships\u001b[94Gsitting\u001b[102Gdocked\u001b[109Gwill\u001b[114Gnow\u001b[118Gpay\r\u001b[1B \u001b[3Gthe berth fee.\u001b[K\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.232, "o", "\u001b[?25l\u001b[H\r\u001b[46C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m6\u001b[53G8\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.165, "o", "\u001b[?25l\u001b[H\u001b[5Gtolls and th\u001b[19Gcost of lif\u001b[31G support\u001b[40Gused in \u001b[49Gransit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL28\u001b[22m, booked straight\u001b[26Gafter\u001b[32GW10,\u001b[37Glooks\u001b[43Gat\u001b[46Gwhy\u001b[50Ga\u001b[52Gdocked\u001b[59Gfleet\u001b[65Gstops\u001b[71Gthe\u001b[75Gfast-forward\u001b[88Gfrom\u001b[93Gskipping\u001b[102Gsteps.\u001b[109GThe\u001b[113Gaim\u001b[117Gis\r\u001b[2C\u001b[1B \u001b[5Gfor observation to run only when a\u001b[40Gcover\u001b[46Gd ma\u001b[51Gk\u001b[53Gt actua\u001b[61Gly\u001b[64Gc\u001b[66Ganges.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThese\u001b[12Gre\u001b[15Grecorded\u001b[24Gin\u001b[27GD-097 and the \"W10 plan\" \u001b[53Gection\u001b[60Gof\u001b[63Gthe\u001b[67Gstage-4\u001b[75Gplan.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat slice 1 adds:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mRequests::Act\u001b[39m \u001b[20Guns\u001b[24Ga command for an\u001b[41Gactor straight away, with\u001b[67Gno s\u001b[72Gquence number,\u001b[87Gledger\u001b[94Gor\u001b[97Grecording.\u001b[108GIt's\u001b[113Ghow\u001b[117Gthe\r\u001b[4C\u001b[1Bexecutor\u001b[14Gwill\u001b[19Gsend\u001b[24Gthe\u001b[28Gsame\u001b[33Gcommands\u001b[42Ga\u001b[44Gplayer\u001b[51Gdoes.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mWorld::Policy\u001b[39m and\u001b[23G\u001b[38;2;177;185;249mWorld::Job\u001b[34G\u001b[39mare\u001b[38Gsaved\u001b[44Gon\u001b[47Gthe\u001b[51Gship\u001b[56Gand\u001b[60Gchecked\u001b[68Gwhen\u001b[73Ga\u001b[75Gsave\u001b[80Gloads.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m lets o\u001b[32Gly the ship's owner se\u001b[56Gits pol\u001b[64Gcy. An \u001b[72Gdit l\u001b[78Gaves the\u001b[87Gjob and its \u001b[100Ga\u001b[102Ggo where they are,\r\u001b[4C\u001b[1Band allowance\u001b[19Galready spent\u001b[33Gstays spent.\u001b[K\r\u001b[4C\u001b[1BNew tests in the \u001b[38;2;177;185;249mcommand\u001b[39m and\u001b[34G\u001b[38;2;177;185;249mpolicy\u001b[39m suites.\u001b[K\r\u001b[4C\u001b[1BThe \u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2;177;185;249mfixture\u001b[39m pi\u001b[32Gned \u001b[37Gashes moved because \u001b[58Ghe two new components are r\u001b[86Ggistere\u001b[94G. With th\u001b[104Gse registrations\r\u001b[4C\u001b[1Btaken out, both pins pass at \u001b[35Gheir old values,\u001b[52Gso\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gto\u001b[72Gthe\u001b[76Gsave's\u001b[83Glayout,\u001b[91Gnot\u001b[95Gits\u001b[99Gstate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22mslice 2, the charges themselves. It moves the same pins\u001b[65Gagain, because\u001b[80Gstart\u001b[86Gr \u001b[89Ghips sitting d\u001b[104Gcked w\u001b[111Gll now pay\r\u001b[2C\u001b[1Bthe b\u001b[9Grth fee.\u001b[K\r\u001b[2C\u001b[2BThis i\u001b[10G a good\u001b[18Gpoint to run \u001b[38;2;177;185;249m/compact\u001b[39m. The\u001b[45Gplanning re\u001b[57Gds\u001b[60Gf\u001b[62Glled most\u001b[72Gof the context,\u001b[88Gand the sl\u001b[99Gces ahea\u001b[109Gneed\u001b[114Gthe\u001b[118G\u001b[K\r\u001b[2C\u001b[1Broom.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
