[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mSlice 2 (now at nominal values):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFe\u001b[8Gs per venue:\u001b[22m each venue has\u001b[36Gits\u001b[40Gown\u001b[44Gfees\u001b[49G(\u001b[38;2;177;185;249mWorld::Fees\u001b[39m),\u001b[64Gso\u001b[67GW18\u001b[71Gcan\u001b[75Glet\u001b[79Goperators\u001b[89Gchange\u001b[96Gthem.\u001b[102GThey\u001b[107Gstart\u001b[113Gat\u001b[116Gthe\r\u001b[2C\u001b[1B \u001b[5Gdefaults in \u001b[38;2;177;185;249mbalance.yaml\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocking fee:\u001b[22m 10 credits, paid\u001b[35Gto\u001b[38Gthe\u001b[42Gdestination\u001b[54Gas\u001b[57Ga\u001b[59G\u001b[38;2;177;185;249mTravel\u001b[66G\u001b[39mstarts.\u001b[74GIf\u001b[77Gthe\u001b[81Gcompany\u001b[89Gcan't\u001b[95Gcover\u001b[101Git\u001b[104Gplus\u001b[109Gthe\u001b[113Gship's\r\u001b[2C\u001b[1B \u001b[5Garrears, the\u001b[18Gjourn\u001b[24Gy i\u001b[28G refused with\u001b[42G\u001b[38;2;177;185;249mInsufficientFunds\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBerth fee:\u001b[22m 2\u001b[18Gcredits\u001b[26Gper simulation hour for each docked\u001b[62Gship,\u001b[68Gpaid\u001b[73Gto\u001b[76Gits\u001b[80Gvenue.\u001b[87GWhatever\u001b[96Gthe\u001b[100Gcompany\u001b[108Gcan't\u001b[114Gpay\r\u001b[2C\u001b[1B \u001b[5Gbecomes the ship's \u001b[38;2;177;185;249mWorld::Arrears\u001b[39m to that venue. Arrears\u001b[62Gmust be paid in full b\u001b[85Gfore \u001b[91Ghe ship can leave.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInterest:\u001b[22m arrears compound daily a\u001b[40G the venue's rate, 10% a year\u001b[70Gby \u001b[74Gefault, never abov\u001b[94Gt\u001b[96Ge 35% limit. Fractions\u001b[119Gof\r\u001b[2C\u001b[1B \u001b[5Ga credit c\u001b[18Gy over to the\u001b[32Gnext d\u001b[39Gy, so\u001b[45Gsmall debts still\u001b[64Gccrue.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPins:\u001b[22m the \u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2