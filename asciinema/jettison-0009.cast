[0.081, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mContent checks:\u001b[21G\u001b[22ma\u001b[23Gtrader\u001b[30Glisted\u001b[37Gtwice\u001b[43Gis\u001b[46Grefused.\u001b[55GSo\u001b[58Gis\u001b[61Ga\u001b[63Glist\u001b[68Gthat\u001b[73Gleaves\u001b[80Gthe\u001b[84Gstarter\u001b[92Gstation\u001b[100Gno\u001b[103Gfree\u001b[108Gpad\u001b[112Gor\r\u001b[2C\u001b[1B  life-support connection\u001b[29Gfor\u001b[33Ga\u001b[35Gplayer.\r\u001b[2B \u001b[3G\u001b[1mChanges from the plan\u001b[22m (now in the stage-4 plan):\r\u001b[1B  - \u001b[1mLogin refusal is in the s\u001b[31Grver, \u001b[38Got \u001b[38;2;177;185;249mmanifest-token\u001b[39m.\u001b[22m The token\u001b[67Gtool\u001b[72Gnever\u001b[78Gloads\u001b[84Gthe\u001b[88Gworld,\u001b[95Gso\u001b[98Git\u001b[101Gcan't\u001b[107Gtell\u001b[112Gwho\u001b[116Gis\u001b[119Gan\r\u001b[4C\u001b[1BNPC. The server \u001b[22Ghecks when a\u001b[35Gclient logs in and refuses \u001b[63Gny NPC principal, whatever\u001b[90Gthe\u001b[94Gtoken\u001b[100Gfile\u001b[105Gholds.\u001b[112GThat\r\u001b[4C\u001b[1Balso covers\u001b[17Gtoken\u001b[23Gfiles\u001b[29Gedited\u001b[36Gby\u001b[39Ghand.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA field instead of a component.\u001b[22m I used the \u001b[38;2;177;185;249mnpc\u001b[39m field rather than\u001b[70Ga \u001b[73Gep\u001b[76Grate \u001b[38;2;177;185;249mWorld::Npc\u001b[92G\u001b[39mcomponent,\u001b[103Gwhich\u001b[109Gkeeps\u001b[115Git\u001b[118Gto\r\u001b[4C\u001b[1Bone saved bool.\u001b[21G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPins:\u001b[22m two pinned save hashes mov\u001b[37G, in\u001b[42G\u001b[38;2;177;185;249mcompany\u001b[50G\u001b[39mand\u001b[54G\u001b[38;2;177;185;249mfixture\u001b[39m. W\u001b[65Gth the new field taken\u001b[88Gout\u001b[92Gof\u001b[95Gthe\u001b[99Gsave,\u001b[105Gboth\u001b[110Gpass\u001b[115Gat\r\u001b[2C\u001b[1Btheir old values, so\u001b[24Go\u001b[26Gly the save bytes \u001b[45Ghanged.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mcontent\u001b[39m:\u001b[22m the two refusals.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mremote\u001b[39m:\u001b[22m a client\u001b[22Gholding\u001b[30Ga\u001b[32Gvalid\u001b[38Gtoken\u001b[44Gfor\u001b[48Gan\u001b[51GNPC\u001b[55Gprincipal\u001b[65Gis\u001b[68Grefused,\u001b[77Gand\u001b[81Ga\u001b[83Gplayer\u001b[90Gstill\u001b[96Ggets\u001b[101Gin.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mpolicy\u001b[39m:\u001b[13G\u001b[22man\u001b[16GNPC\u001b[20Gis\u001b[23Gflagged,\u001b[32Gits\u001b[36Gpolicy\u001b[43Gis\u001b[46Gon,\u001b[50Gand\u001b[54Ga\u001b[56Gplayer\u001b[63Gset\u001b[67Gup\u001b[70Gbeside\u001b[77Git\u001b[80Gisn't\u001b[86Gflagged\u001b[94Gand\u001b[98Ggets\u001b[103Gthe\u001b[107Gsame\u001b[112Greports.\r\u001b[1B \u001b[3G  By \u001b[9Gh\u001b[11G end of the first economic\u001b[38Gturn the\u001b[47GNPC\u001b[51Ghas\u001b[55Gpicked\u001b[62Ga\u001b[64Gtrade\u001b[70Gand\u001b[74Gis\u001b[77Gflying\u001b[84Gto\u001b[87Gbuy\u001b[91Git.\u001b[95GToo\u001b[99Gmany\u001b[104Gtraders\u001b[112Gmakes\r\u001b[1B    world creation fail with an error.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mBehaviour worth knowing:\u001b[28G\u001b[22man NPC's first decision, at the\u001b[60Gvery\u001b[65Gfirst\u001b[71Gstep,\u001b[77Gfinds\u001b[83Gnothing\u001b[91Gworth\u001b[97Gtrading\u001b[105Gand\u001b[109Gwaits.\u001b[116GIt\u001b[27;1H\u001b[24;3H\u001b[?25h"]
