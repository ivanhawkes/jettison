[0.003, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  commands, saves\u001b[21Gand\u001b[25Gsnapshots.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRendering:\u001b[16G\u001b[22mVulkan\u001b[23G1.3\u001b[27Gin\u001b[30Gdouble\u001b[37Gprecision\u001b[47Gat\u001b[50Greal\u001b[55Gscale,\u001b[62Gwith\u001b[67GHDR,\u001b[72GPBR,\u001b[77Gimage-based\u001b[89Glighting,\u001b[99Ga\u001b[101Gprocedural\u001b[112Gsky,\r\u001b[1B \u001b[3G  clu\u001b[9Gtered lights, cascaded sun\u001b[36Gshadows, culling, instancing and levels of detail.\u001b[87GA frame\u001b[95Gc\u001b[97Gsts 0.30 ms of GPU time\r\u001b[2C\u001b[1B  on the 5060 Ti.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWorld:\u001b[12G\u001b[22mstar\u001b[17Gsystems,\u001b[26Gthe\u001b[30Ggalaxy\u001b[37Gand\u001b[41Gjumps,\u001b[48Ga\u001b[50Gspatial\u001b[58Goctree,\u001b[66Gdeterministic\u001b[80GJolt\u001b[85Gphysics\u001b[93Gin\u001b[96Gframes,\u001b[104Gflight,\u001b[112Gsensors\r\u001b[2C\u001b[1B  and picking.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGameplay systems:\u001b[23G\u001b[22mUI\u001b[26G(RmlUi),\u001b[35Gaudio,\u001b[42Gversioned\u001b[52Gsaves\u001b[58Gwith\u001b[63Gmigrations,\u001b[75GAI\u001b[78G(behaviour\u001b[89Gtrees,\u001b[96Gsteering),\u001b[107Gdocks,\r\u001b[2C\u001b[1B  presentation polish, Wasm scripting, mods\u001b[47Ga\u001b[49Gd packs, crash\u001b[64Ghandling,\u001b[74Glocalisation,\u001b[88Gcruising,\u001b[98Ggates\u001b[104Gand\u001b[108Gthe\u001b[112Gfleet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter phase 13:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mComment review (2026-11-18):\u001b[22m about\u001b[40G9,100\u001b[46Gcomment\u001b[54Glines\u001b[60Gacross\u001b[67G427\u001b[71Gfiles,\u001b[78Gtrimmed\u001b[86Gmodule\u001b[93Gby\u001b[96Gmodule.\r\u001b[6C\u001b[1B\u001b[1mference frames:\u001b[23G\u001b[22mthey \u001b[29Gow ho\u001b[35Gd\u001b[37Gunder l\u001b[45Gad, and the \u001b[59Glowed pixel difference went from 518 to\u001b[99Gzero.\u001b[K\r\