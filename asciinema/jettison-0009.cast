[0.164, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mdit\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mdocking\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mfee\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mas\u001b[48;2;2;40;0m \u001b[48;2;4;71;0ma `Travel` starts, a 2-credit berth fee each simulation hour docked, [\u001b[38;2;230;219;116mD-097\u001b[38;2;248;248;242m](decisi\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mon-ledger.md#d-097)) and \u001b[48;2;2;40;0mits \u001b[48;2;4;71;0mjobs\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mattribute\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthem to a lot \u001b[48;2;2;40;0mthrough `Policy::Charges`: select the berth \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242mfee\u001b[48;2;4;71;0m's\u001b[48;2;2;40;0m amount and basis \u001b[48;2;4;71;0m(\u001b[48;2;2;40;0mit includes connected life support, D-047)\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe docking fee's, arrears' conseq\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0muences, \u001b[48;2;2;40;0mand the cost of life support used in transit, attributed the \u001b[48;2;4;71;0msame\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mway\u001b[48;2;2;40;0m; storage fees (L16) and \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242mtolls (L10, L16) join \u001b[48;2;4;71;0mthat\u001b[48;2;2;40;0m attribution when they land. Prove an estimate and a floor with each charge.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242m | W10 |                                                                                              \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 197 \u001b[22m | 42\u001b[17G/ W11 | Resolve the clean public-project/tender lifecycle's remaining\u001b[87Groundi