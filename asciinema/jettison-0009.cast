[3.815, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRendering:\u001b[22m Vulkan 1.3 in d\u001b[32Guble\u001b[37Gprecision\u001b[47Gat\u001b[50Greal\u001b[55Gscale,\u001b[62Gwith\u001b[67GHDR,\u001b[72GPBR,\u001b[77Gimage-based\u001b[89Glighting,\u001b[99Ga\u001b[101Gprocedural\u001b[112Gsky,\r\u001b[2C\u001b[1B \u001b[5Gclustered lights,\u001b[23Gcascade\u001b[31G sun shadow\u001b[43G, culling, instancing and levels of detail. A\u001b[89Gframe costs\u001b[101G0.30 ms of\u001b[112GGPU time\r\u001b[4C\u001b[1Bon th\u001b[11G 5060 Ti.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWorld:\u001b[12G\u001b[22mstar\u001b[17Gsystems,\u001b[26Gthe\u001b[30Ggalaxy\u001b[37Gand\u001b[41Gjumps,\u001b[48Ga\u001b[50Gspatial\u001b[58Goctree,\u001b[66Gdeterministic\u001b[80GJolt\u001b[85Gphysics\u001b[93Gin\u001b[96Gframes,\u001b[104Gflight,\u001b[112Gsensors\r\u001b[2C\u001b[1B \u001b[5Gand picking.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGameplay systems:\u001b[23G\u001b[22mUI\u001b[26G(RmlUi),\u001b[35Gaudio,\u001b[42Gversioned\u001b[52Gsaves\u001b[58Gwith\u001b[63Gmigrations,\u001b[75GAI\u001b[78G(behaviour\u001b[89Gtrees,\u001b[96Gsteering),\u001b[107Gdocks,\r\u001b[2C\u001b[1B \u001b[5Gpresentation polish,\u001b[26GWasm scripting\u001b[42Gmod\u001b[46G a\u001b[49Gd packs,\u001b[58Gcrash handl\u001b[70Gng, localisation, cruising, gates and the fleet.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter phase 13:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComment review (2026-11-18):\u001b[34G\u001b[22mabout\u001b[40G9,100\u001b[46Gcomment\u001b[54Glines\u001b[60Gacross\u001b[67G427\u001b[71Gfiles,\u001b[78Gtrimmed\u001b[86Gmodule\u001b[93Gby\u001b[96Gmodule.\r\u001b[4C\u001b[1B\u001b[1mReference frames:\u001b[22m they now hold \u001b[38Gnder load, and the allowed pixel\u001b[71Gd\u001b[73Gfference w\u001b[84Gnt from 518\u001b[96Gt\u001b[98G zero.\r\u001b[4C\u001b[1B\u001b[1mThe gate:\u001b[22m it runs\u001b[23Ginside the sandbox,\u001b[43Gand fr\u001b[50Gmes can be drawn offscreen o\u001b[79G the GPU.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNeutral SDK and Manifest integration (approved 2026-11-15):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mH02–H05:\u001b[22m a public host (\u001b[38;2;177;185;249mJettison::Host\u001b[39m), a CPU-only build,\u001b[64Gan\u001b[67Gindependent\u001b[79Gnon-space\u001b[89Gconsumer,\u001b[99Gand\u001b[103Gthe\u001b[107Gsample\u001b[114Ggame\r\u001b[2C\u001b[1B \u001b[5Gmoved out to \u001b[38;2;177;185;249msource/sampl\u001b[31Gs/space\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA01 and W01:\u001b[18G\u001b[22mneutral frame IDs and\u001b[40Gsave\u001b[45Gmetadata,\u001b[55Gand\u001b[59Ggeneric\u001b[67Gmodule\u001b[74Gboundaries,\u001b[86Gso\u001b[89Gphysics,\u001b[98GAI\u001b[101Gand\u001b[105Gscene\u001b[111Gno\u001b[114Glonger\r\u001b[2C\u001b[1B \u001b[5Gneed anything space-specific. New \u001b[38;2;177;185;249mspace\u001b[45G\u001b[39mand \u001b[38;2;177;185;249mspacescene\u001b[39m modules hold that code, and pad cla\u001b[96Gses are now data.\u001b[114G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mG01:\u001b[10G\u001b[22mthe shell is generic, and a non-space ground sample r\u001b[64Gns in the smoke t\u001b[82Gst.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mContent pipeline:\u001b[23G\u001b[22mmap f\u001b[29Gelds, \u001b[38;2;177;185;249mDock::Fits\u001b[39m a\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
