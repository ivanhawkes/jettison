72Gthe\u001b[76Gprofit\u001b[83Gestimate,\u001b[93Gand\u001b[97Grecovered\u001b[107Gin\u001b[110Gthe\u001b[114Gminimum\r\u001b[4C\u001b[1B \u001b[7Gs\u001b[9Gle\u001b[12Gprice.\u001b[19G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW18\u001b[22m, right after\u001b[22GW10\u001b[26Gin\u001b[29GManifest's\u001b[40Gdelivery\u001b[49Gorder,\u001b[56Gsettles\u001b[64Gthe\u001b[68Gcharges'\u001b[77Greal\u001b[82Gamounts\u001b[90Gand\u001b[94Gbases,\u001b[101Gplus\u001b[106Gstorage\u001b[114Gfees,\r\u001b[2C\u001b[1B \u001b[5Gtolls and the cost of life support\u001b[40Gused in transit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL28\u001b[22m, booked straight after\u001b[32GW10, look\u001b[42G at why \u001b[51G docked\u001b[59Gfleet\u001b[65Gstops\u001b[71Gthe\u001b[75Gfast-forward\u001b[88Gfrom\u001b[93Gskipping\u001b[102Gsteps.\u001b[109GThe\u001b[113Gaim\u001b[117Gis\r\u001b[2C\u001b[1B \u001b[5Gfor o\u001b[11Gservation to run only when a covered market actua\u001b[61Gly changes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThese are rec\u001b[19Grded\u001b[24Gin D-097\u001b[33Gand the \"W10 plan\" section of the stage-4\u001b[75Gplan.\r\u001b[2C\u001b[1B \u001b[5G     \u001b[11G   \u001b[15G        \u001b[24G  \u001b[27G     \u001b[33G   \u001b[37G   \u001b[41G    \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
