[0.253, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7Gev\u001b[10Gry creditor\u001b[22Gcharges\u001b[30Gdaily-compounding\u001b[48Ginterest\u001b[57Gon\u001b[60Garrears,\u001b[69Gcapped\u001b[76Gby\u001b[79Gthe\u001b[83Ggame's\u001b[90Gusury\u001b[96Glimit.\r\u001b[6C\u001b[1BEach change applies\u001b[27Gonly\u001b[32Gto later charges.\u001b[50G\u001b[1mW18\u001b[54G\u001b[22madds\u001b[59Gthe\u001b[63Goperators'\u001b[74Gcommand\u001b[82Gto\u001b[85Gset\u001b[89Gfees,\u001b[95G\u001b[1mL29\u001b[99G\u001b[22mthe\u001b[103Ggovernors'\u001b[114Gtax\r\u001b[4C\u001b[1B \u001b[7Grates, an\u001b[17G \u001b[1mL15\u001b[22G\u001b[22mt\u001b[24Ge client screens for both.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mD-099 / L30:\u001b[22m regions ca\u001b[29G buy essentials on credit, owing the seller or a lender, who charges int\u001b[102Grest within\u001b[115Ghe\r\u001b[4C\u001b[1Busury limit.\u001b[18G\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- So a governm\u001b[20Gnt can feed its p\u001b[38Gople through a bad patch, or spiral into debt.\u001b[K\r\u001b[4C\u001b[1B- That deb\u001b[16G is\u001b[20Ghow\u001b[24Ga\u001b[26Gmerchant\u001b[35Gclass\u001b[41Gand\u001b[45Ga\u001b[47Gbanking\u001b[55Gclass\u001b[61Gcontrol\u001b[69Gregions\u001b[77Gindirectly.\r\u001b[7C\u001b[1Btill \u001b[14Gp\u001b[16Gn: what holding\u001b[32Ga regi\u001b[39Gn's\u001b[43Gdebt \u001b[49Gives the credit\u001b[66G, and what happens\u001b[85Gon\u001b[88Gdefault.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlice 2 (now at nominal values):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFees per venue:\u001b[21G\u001b[22meach\u001b[26Gvenue\u001b[32Ghas\u001b[36Gits\u001b[40Gown\u001b[44Gfees\u001b[49G(\u001b[38;2;177;185;249mWorld::Fees\u001b[39m),\u001b[64Gso\u001b[67GW18\u001b[71Gcan\u001b[75Glet\u001b[79Goperators\u001b[89Gchange\u001b[96Gthem.\u001b[102GThey\u001b[107Gstart\u001b[113Gat\u001b[116Gthe\r\u001b[2C\u001b[1B  defaults in \u001b[38;2;177;185;249mbalance.yaml\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mDocking fe\u001b[16G:\u001b[22m 10\u001b[21Gcredits, paid to the destination as a \u001b[38;2;177;185;249mTravel\u001b[39m starts. If \u001b[78Ghe company\u001b[90Gan't cov\u001b[99Gr it plu\u001b[108G the\u001b[113Gship's\r\u001b[4C\u001b[1Barrears,\u001b[14Gthe journey is refused\u001b[37Gwith\u001b[42G\u001b[38;2;177;185;249mInsufficientFunds\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mBerth fee:\u001b[22m 2\u001b[18Gcredits per\u001b[30Gsimulation hour for each docked ship, paid to i\u001b[78Gs venue. Whatever th\u001b[99G company can't pay\u001b[K\r\u001b[4C\u001b[1Bbecome\u001b[12G the ship's \u001b[38;2;177;185;249mWorld::Arrears\u001b[39m \u001b[40Go\u001b[42Gthat venue. Arrears\u001b[62Gmust\u001b[67Gbe\u001b[70Gpaid\u001b[75Gin\u001b[78Gfull\u001b[83Gbefore\u001b[90Gthe\u001b[94Gship\u001b[99Gcan\u001b[103Gleave.\r\u001b[4C\u001b[1B\u001b[1mInterest:\u001b[22m arrears com\u001b[27Gound daily at\u001b[41Gthe venue's rate, 10% a year by\u001b[73Gdefault, \u001b[83Gever above the 35% limit. Fractions\u001b[119Gof\r\u001b[4C\u001b[1Ba \u001b[8Gredit carry over to the next day,\u001b[42Gso small debts still accru\u001b[69G.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPins:\u001b[22m the\u001b[15G\u001b[38;2;177;185;249mcompany\u001b[23G\u001b[39mand \u001b[38;2;177;185;249mfixture\u001b[39m pinned \u001b[43Gash\u001b[47Gs moved. With the\u001b[65Gch\u001b[69Gges\u001b[73Gat zero a\u001b[83Gd the new components unregistered,\u001b[K\r\u001b[4C\u001b[1Bboth pass \u001b[16Gt their old\u001b[28Gvalues. So they moved only because\u001b[63Gof th\u001b[69G new\u001b[74Gcomponents\u001b[85Gand\u001b[89Gthe\u001b[93Gfees\u001b[98Gthe\u001b[102Gship\u001b[107Gpays.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
