[0.392, "o", "\u001b[?25l\u001b[H\u001b[3G3.\u001b[6G\u001b[1mOngoing:\u001b[15G\u001b[22mmap each Manifes\u001b[32G mechanic t\u001b[44G the\u001b[49Gpublic\u001b[56GAPI\u001b[60Gor\u001b[63Gto\u001b[66Ga\u001b[68Greusable\u001b[77Ggap\u001b[81Gprovisioned\u001b[93Ghere,\u001b[99Gand\u001b[103Gupdate\u001b[110Gthe\u001b[114GSDK\r\u001b[2C\u001b[1B  \u001b[6Gpin.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCarried forward:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFirst:\u001b[22m script authority\u001b[29Gunder\u001b[35Gnetworked\u001b[45Gplay.\u001b[51GThe\u001b[55Gserver\u001b[62Gshould\u001b[69Gdecide\u001b[76Gwhose\u001b[82Gbehalf\u001b[89Ga\u001b[91Gscript\u001b[98Gacts\u001b[103Gon,\u001b[107Gper\u001b[111Gcall,\r\u001b[2C\u001b[1B \u001b[5Gincluding a \u001b[38;2;177;185;249mSim::Controller\u001b[39m nested inside \u001b[48G command's fields.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNext:\u001b[22m behaviour-tree extension\u001b[36G (react\u001b[44Gv\u001b[46G, parallel and subtree\u001b[69Gnodes,\u001b[76Ga\u001b[78Gblackboard),\u001b[91Gscripts\u001b[99Greading\u001b[107Gthe\u001b[111Gworld,\u001b[118Gmod\r\u001b[2C\u001b[1B \u001b[5Glist editing and hot\u001b[26Greload, picking in a paused world,\u001b[61Gand physics extras (\u001b[82Gompound shapes, filtering, overlap\u001b[K\r\u001b[4C\u001b[1Bqueri\u001b[11Gs).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThen:\u001b[22m logging\u001b[19Gin\u001b[22Gthe\u001b[26Gshell,\u001b[33Gcrash\u001b[39Greports\u001b[47Gfrom\u001b[52Gother\u001b[58Gthreads,\u001b[67Gprefetching\u001b[79Ga\u001b[81Gjump's\u001b[88Gdestination,\u001b[101GglTF\u001b[106Gcollision\r\u001b[2C\u001b[1B \u001b[5Gmeshes, steering\u001b[22Ground the inside\u001b[39Gof a stati\u001b[50Gn, deck\u001b[59Graffic\u001b[67GUI ho\u001b[73G reload, fuller localisation, and some c\u001b[114Gmments\r\u001b[4C\u001b[1Bb\u001b[7Gtt\u001b[10Gr a\u001b[14G names.\u001b[22G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLast (presentation, when a scene needs it):\u001b[49G\u001b[22manimation\u001b[59Gblending,\u001b[69Gaudio\u001b[75Gcrossfade\u001b[85Gand\u001b[89GDoppler,\u001b[98Gcutscenes,\u001b[109GRmlUi\u001b[115Gclip\r\u001b[2C\u001b[1B \u001b[5Gmasks and filters, transparent-pass gaps, post-cha\u001b[56Gn gaps, the dev t\u001b[74Gols' them\u001b[84G, and shadow and level-of-detail\u001b[K\r\u001b[4C\u001b[1Btuning.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSample backlog (not engine requirements):\u001b[47G\u001b[22mground-sample\u001b[61Greference\u001b[71Gframes,\u001b[79Ga\u001b[81Gshipyard\u001b[90Gscreen,\u001b[98Gcruise\u001b[105Gand\u001b[109Ggate\u001b[114Ggaps,\r\u001b[2C\u001b[1B \u001b[5Glook-as-data, the station dressing, nozzle glow, and haze and planet looks.\u001b[81G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo\u001b[6Gdecisions\u001b[16Gare\u001b[20Gopen.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gread\u001b[10Gthe\u001b[14Gtwo\u001b[18Gdocuments,\u001b[29Gand\u001b[33Ghistory.md\u001b[44Gonly\u001b[49Gfor\u001b[53Gits\u001b[57Gphase\u001b[63Gsummaries\u001b[73Gand\u001b[77Gits\u001b[81Gpost-phase-13\u001b[95Gsections,\u001b[105Gnot\u001b[109Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
