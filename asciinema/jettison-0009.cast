[0.040, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gexecutor will\u001b[19Gsend the same commands a\u001b[44Gplayer\u001b[51Gdoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mWorld::Policy\u001b[39m and \u001b[38;2;177;185;249mWorld::Job\u001b[39m are saved on th\u001b[50G ship\u001b[56Gand\u001b[60Gchecked\u001b[68Gwhen a save loads.\u001b[87G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m lets only the\u001b[40Ghip's\u001b[46Gowner\u001b[52Gset\u001b[56Gits\u001b[60Gpolicy.\u001b[68GAn\u001b[71Gedit\u001b[76Gleaves\u001b[83Gthe\u001b[87Gjob\u001b[91Gand\u001b[95Gits\u001b[99Gcargo\u001b[105Gwhere\u001b[111Gthey\u001b[116Gare,\r\u001b[2C\u001b[1B \u001b[5Gand\u001b[9Gallowance already spent stays spent.\u001b[K\r\u001b[4C\u001b[1BNew\u001b[9Gtests in the \u001b[38;2;177;185;249mcommand\u001b[39m a\u001b[32Gd \u001b[38;2;177;185;249mpolicy\u001b[39m \u001b[42Guites.\u001b[49G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe \u001b[38;2;177;185;249mcompany\u001b[39m and\u001b[21G\u001b[38;2;177;185;249mfixture\u001b[39m pinned hashes moved because the two new\u001b[69Gc\u001b[71Gmponents are registered. With those\u001b[107Gregistrations\r\u001b[4C\u001b[1Btaken\u001b[11Gout,\u001b[16Gboth\u001b[21Gpins\u001b[26Gpass\u001b[31Gat\u001b[34Gtheir\u001b[40Gold\u001b[44Gvalues,\u001b[52Gso\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gto\u001b[72Gthe\u001b[76Gsave's\u001b[83Glayout,\u001b[91Gnot\u001b[95Gits\u001b[99Gstate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[22m slice 2,\u001b[18Gthe\u001b[22Gcharges\u001b[30Gthemselves.\u001b[42GIt\u001b[45Gmoves\u001b[51Gthe\u001b[55Gsame\u001b[60Gpins\u001b[65Gagain,\u001b[72Gbecause\u001b[80Gstarter\u001b[88Gships\u001b[94Gsitting\u001b[102Gdocked\u001b[109Gwill\u001b[114Gnow\u001b[118Gpay\r\u001b[2C\u001b[1Bthe\u001b[7Gberth\u001b[13Gfee.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis is\u001b[11Ga\u001b[13Ggood\u001b[18Gpoint\u001b[24Gto\u001b[27Gru