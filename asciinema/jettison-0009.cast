[0.033, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/tools/console/tests/ManifestConsoleTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[2m 537 \u001b[12G\u001b[22m \u001b[14G    \u001b[31G\u001b[38;2;166;226;46mReported\u001b[39m(arrived,\u001b[49G\u001b[38;2;230;219;116m\"VenueBrineHighport\"\u001b[39m,\u001b[71G\u001b[38;2;230;219;116m\"ItemFurs\"\u001b[39m,\u001b[83G\u001b[38;2;230;219;116m\"bid\"\u001b[39m));\r\u001b[8C\u001b[1B\u001b[2m8\u001b[14G\u001b[22m\u001b[38;2;166;226;46mMANIFEST_CHECK_CONTAINS\u001b[39m(\u001b[38;2;166;226;46mExecute\u001b[39m(session, \u001b[38;2;230;219;116m\"step\"\u001b[39m).text, \u001b[38;2;230;219;116m\"Manifest.Trade.Place: Succeeded\"\u001b[39m);\r\u001b[8C\u001b[1B\u001b[2m9\u001b[14G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[39m std::string sold = \u001b[38;2;166;226;46mExecute\u001b[39m(se\u001b[50Gsion, \u001b[38;2;230;219;116m\"observe Ada\"\u001b[39m).text;\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 540 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mMESSAGE\u001b[38;2;248;248;242m(sold.\u001b[38;2;166;226;46msubstr\u001b[38;2;248;248;242m(\u001b[38;2;190;132;255m0\u001b[38;2;248;248;242m, \u001b[38;2;190;132;255m400\u001b[38;2;248;248;242m));                                                                       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 541 \u001b[22m   \u001b[38;2;166;226;46mMANIFEST_CHECK_CONTAINS\u001b[39m(sold, \u001b[38;2;230;219;116m\"Company1 'Ada Co': 29590 credits\"\u001b[39m);\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[14G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(sold.\u001b[38;2;166;226;46msubstr\u001b[39m(\u001b[38;2;190;132;255m0\u001b[39m, sold.\u001b[38;2;1