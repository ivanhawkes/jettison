[0.005, "o", "\u001b[H\r\u001b[14C\u001b[9B ☒ Cost split \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Policy edits \r\u001b[2C\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mWhen a\u001b[10Gplayer edi\u001b[21Gs a standing policy while its ship holds cargo, when does the change apply?\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mAt the next decision (Recommended)\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;2;153;153;153mNew limits apply from the job's next choice, held cargo included; allowance already spent stays spent, and a raised\r\u001b[5C\u001b[1Ballowance only add\u001b[26Gfrom then on.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[6G\u001b[39mNext job only\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mT\u001b[8Ge held cargo keeps the limits i\u001b[40G was\u001b[45Gbought under; the edit applies once that cargo is sold.\r\u001b[2C\u001b[1B3\u001b[5G Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m4.\u001b[6GChat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[K\u001b[27;1H\u001b[14;1H"]
