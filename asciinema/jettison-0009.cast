[0.151, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mD-099 / L30:\u001b[18G\u001b[22mregions\u001b[27Gan buy ess\u001b[39Gtials\u001b[45Gon credit,\u001b[56Gowing\u001b[62Gthe\u001b[66Gseller\u001b[73Gor\u001b[76Ga\u001b[78Glender,\u001b[86Gwho\u001b[90Gcharges\u001b[98Ginterest\u001b[107Gwithin\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gusury limit.\u001b[18G\u001b[K\r\u001b[4C\u001b[1B- So a government\u001b[23Gcan\u001b[27Gfeed\u001b[32Gits\u001b[36Gpeople\u001b[43Gthrough\u001b[51Ga\u001b[53Gbad\u001b[57Gpatch,\u001b[64Gor\u001b[67Gspiral\u001b[74Ginto\u001b[79Gdebt.\r\u001b[6C\u001b[1BThat\u001b[12Gdebt is how \u001b[25G merchan\u001b[34G class and a banking class cont\u001b[66Gol regions in\u001b[80Girectly.\r\u001b[6C\u001b[1BStill open: w\u001b[21Gat\u001b[24Gholding a region's \u001b[44Gebt gives the credito\u001b[66G, and what\u001b[77Ghappens on default.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlice 2 (now at nominal values):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFe\u001b[8Gs per venue:\u001b[22m each venue has\u001b[36Gits\u001b[40Gown\u001b[44Gfees\u001b[49G(\u001b[38;2;177;185;249mWorld::Fees\u001b[39m),\u001b[64Gso\u001b[67GW18\u001b[71Gcan\u001b[75Glet\u001b[79Goperators\u001b[89Gchange\u001b[96Gthem.\u001b[102GThey\u001b[107Gstart\u001b[113Gat\u001b[116Gthe\r\u001b[2C\u001b[1B \u001b[5Gdefaults in \u001b[38;2;177;185;249mbalance.yaml\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocking fee:\u001b[22m 10 credits, paid\u001b[35Gto\u001b[38Gthe\u001b[42Gdestination\u001b[54Gas\u001b[57Ga\u001b[59G\u001b[38;2;177;185;249mTravel\u001b[66G\u001b[39mstarts.\u001b[74GIf\u001b[77Gthe\u001b[81Gcompany\u001b[89Gcan't\u001b[95Gcover\u001b[101Git\u001b[104Gplus\u001b[109Gthe\u001b[113Gship's\r\u001b[2C\u001b[1B \u001b[5Garrears, the\u001b[18Gjourn\u001b[24Gy i\u001b[28G refused with\u001b[42G\u001b[38;2;177;185;249mInsufficientFunds\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBerth fee:\u001b[22m 2\u001b[18Gcredits\u001b[26Gper simulation hour for each docked\u001b[62Gship,\u001b[68Gpaid\u001b[73Gto\u001b[76Gits\u001b[80Gvenue.\u001b[87GWhatever\u001b[96Gthe\u001b[100Gcompany\u001b[108Gcan't\u001b[114Gpay\r\u001b[2C\u001b[1B \u001b[5Gbecomes the ship's \u001b[38;2;177;185;249mWorld::Arrears\u001b[39m to that venue. Arrears\u001b[62Gmust be paid in full b\u001b[85Gfore \u001b[91Ghe ship can leave.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInterest:\u001b[22m arrears compound daily a\u001b[40G the venue's rate, 10% a year\u001b[70Gby \u001b[74Gefault, never abov\u001b[94Gt\u001b[96Ge 35% limit. Fractions\u001b[119Gof\r\u001b[2C\u001b[1B \u001b[5Ga credit c\u001b[18Gy over to the\u001b[32Gnext d\u001b[39Gy, so\u001b[45Gsmall debts still\u001b[64Gccrue.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPins:\u001b[22m the \u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2;177;185;249mfixture\u001b[39m pinned\u001b[42Ghashes mov\u001b[53Gd. Wi\u001b[59Gh the \u001b[66Gharges\u001b[73Gat\u001b[76Gzero\u001b[81Gand\u001b[85Gthe\u001b[89Gnew\u001b[93Gcomponents\u001b[104Gunregistered,\r\u001b[2C\u001b[1B \u001b[5Gboth pass\u001b[15Gat their old values. So they moved \u001b[51Gnly because of the new components\u001b[85Gand\u001b[89Gthe\u001b[93Gfees the \u001b[103Ghip pay\u001b[111G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTests:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- the hourly\u001b[18Gfee;\r\u001b[6C\u001b[1Barrears when the\u001b[24Gaccount\u001b[32Gruns\u001b[37Gshort;\u001b[27;1H\u001b[24;3H\u001b[?25h"]
