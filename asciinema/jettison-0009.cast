[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSlice\u001b[9G3,\u001b[12Gthe\u001b[16Gtrading\u001b[24Gexecutor,\u001b[34Gis\u001b[37Gdone\u001b[42Gand\u001b[46Gcommitted\u001b[56Gas\u001b[59GManifest\u001b[68G\u001b[38;2;177;185;249m69fc0d0\u001b[39m.\u001b[77GThe\u001b[81Gfull\u001b[86Ggate\u001b[91G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m)\u001b[109Gpassed,\r\u001b[1B \u001b[3G48/48\u001b[9Gsui\u001b[13Ges, an\u001b[20G \u001b[22Go\u001b[24Gpinned hash moved, sin\u001b[47Ge no fixture has a job yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat a job does:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mChoosing:\u001b[22m it picks\u001b[25Gthe\u001b[29Gbest\u001b[34Gtrade\u001b[40Gabove\u001b[46Gits\u001b[50Gtarget\u001b[57Gfrom\u001b[62Gits\u001b[66Gowner's\u001b[74Greports\u001b[82Gonly,\u001b[88Gstale\u001b[94Gones\u001b[99Gincluded.\u001b[109GThe\u001b[113Gestimate\r\u001b[2C\u001b[1B  \u001b[6Gis net of\u001b[16Gfees and\u001b[25Gdocking charg\u001b[39Gs, and\u001b[48G's sav\u001b[55Gd\u001b[57Gon the job so the player\u001b[82Gcan see it.\u001b[94G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mBuying:\u001b[22m dock\u001b[19Gd\u001b[22Gt the source, it checks\u001b[46Gthe e\u001b[52Gtimate again agains\u001b[72G the live\u001b[82Gask\u001b[86Gand\u001b[90Gdrops\u001b[96Gthe\u001b[100Gtrade\u001b[106Gif\u001b[109Git\u001b[112Gno\u001b[115Glonger\r\u001b[2C\u001b[1B  \u001b[6Gbeats the target.\u001b[24GOtherwise it buys at that\u001b[50Ga\u001b[52Gk, cancels anyth\u001b[70Gg left\u001b[77Gunfilled, and l\u001b[93Gads wha\u001b[101G it bough\u001b[111G.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSelling:\u001b[22m a\u001b[17G th\u001b[21G des\u001b[26Ginat\u001b[31Gon\u001b[37Goffers the lot at\u001b[55Gthe lowest pr\u001b[69Gce\u001b[72Gtha\u001b[77Gstil\u001b[82G covers the lot's cos\u001b[104G, charges\u001b[114Gand\r\u001b[2C\u001b[1B  \u001b[6Gtarget, however\u001b[22Gthe order book\u001b[37Gsplit\u001b[48Gfills.\u001b[55GAnything unsold is reloaded.\u001b[K\r\u001b[5C\u001b[1B- Par\u001b[12Gial sal\u001b[20Gs\u001b[23Gake a share of the cost and charges, rounded up.\u001b[K\r\u001b[7C\u001b[1BA sale th\u001b[18Gt falls short spends at\u001b[42Gm\u001b[47Gthe\u001b[51Gloss allowance left,\u001b[72Gso\u001b[75Gthe\u001b[79Gallowance\u001b[89Gcan't\u001b[95Gbe\u001b[98Gcounted\u001b[106Gtwice.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mBlocked:\u001b[15G\u001b[22mwith\u001b[20Gnothing worth doing, it keeps its cargo and tri\u001b[68Gs again at\u001b[79Gthe end of the next economic turn\u001b[113G(one\r\u001b[2C\u001b[1B  \u001b[6Gsimulation minute).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEvery\u001b[9Gaction\u001b[16Ggoes\u001b[21Gthrough\u001b[29Gthe\u001b[33Gsame\u001b[38Gcommands\u001b[47Ga\u001b[49Gplayer\u001b[56Guses.\u001b[62GThe\u001b[66Gplayer's\u001b[75Gship\u001b[80Gview\u001b[85Gnow\u001b[89Gshows\u001b[95Gthe\u001b[99Gpolicy\u001b[106Gand\u001b[110Gthe\u001b[114Gjob,\r\u001b[2C\u001b[1Band the server registers the syst\u001b[37Gm.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges from the plan\u001b[25G\u001b[22m(recorded\u001b[35Gin\u001b[38Git):\r\u001b[2C\u001b[1B- A blocked job only wak\u001b[28Gs at the turn's\u001b[44Gend;\u001b[49GI\u001b[51Gdropped\u001b[59Gthe\u001b[63Gplanned\u001b[71Gwake\u001b[76Gwhen\u001b[81Gone\u001b[85Gof\u001b[88Gthe\u001b[92Gowner's\u001b[100Gships\u001b[106Gdocks,\u001b[113Gsince\u001b[119Ga\u001b[27;1H\u001b[24;3H\u001b[?25h"]
