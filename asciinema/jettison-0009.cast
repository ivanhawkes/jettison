[0.002, "o", "\u001b[?25l\u001b[H     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 80 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mberthFeePerHour:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m2\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m                                                                                   \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m81\u001b[13G\u001b[22m\u001b[38;2;117;113;94m# Yearly interest on unpaid berth fees, in basis points, compounded daily on what is owed, and the\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m82\u001b[13G\u001b[22m\u001b[38;2;117;113;94m# game's usury limit, the most any venue may set (the user's, 2026-11-21).\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 83 -\u001b[38;2;248;248;242m  arrearsRateBps: \u001b[48;2;92;2;0m0\u001b[48;2;61;1;0m                                                                                    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m83\u001b[13G\u001b[38;2;166;226;46marrearsRateBps:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m1000\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m                                                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 84 \u001b[22m   \u001b[38;2;166;226;46mmaxArrearsRateBps:\u001b[39m \u001b[38;2;190;132;255m3500\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m85\u001b[13G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m86\u001b[11G\u001b[22m\u001b[38;2;166;226;46mbrokers:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/source/game/world/src/World.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 49 \u001b[13G\u001b[22mworld.\u001b[38;2;166;226;46mRegisterComponent\u001b[39m<Pantry>();\r\u001b[1B \u001b[3G   \u001b[2m 50 \u001b[22m   world.\u001b[38;2;166;226;