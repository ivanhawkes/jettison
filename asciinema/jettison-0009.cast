[0.083, "o", "\u001b[?25l\u001b[H\u001b[5Gserialisation,\u001b[20Gthe\u001b[24Gvirtual\u001b[32Gfile\u001b[37Gsystem,\u001b[45Gresources,\u001b[56GECS\u001b[60Gand\u001b[64Gscheduler,\u001b[75Gand\u001b[79Gthe\u001b[83Gsimulation/presentation\u001b[107Gsplit\u001b[113Gwith\r\u001b[1B    commands, saves and snapshots.\r\u001b[1B  - \u001b[1mRendering:\u001b[22m Vulkan 1.3 in double precision at real\u001b[55Gscale,\u001b[62Gwith\u001b[67GHDR,\u001b[72GPBR,\u001b[77Gimage-based\u001b[89Glighting,\u001b[99Ga\u001b[101Gprocedural\u001b[112Gsky,\r\u001b[1B    clustered lights, cascaded\u001b[32Gsun\u001b[36Gshadows,\u001b[45Gculling,\u001b[54Ginstancing\u001b[65Gand\u001b[69Glevels\u001b[76Gof\u001b[79Gdetail.\u001b[87GA\u001b[89Gframe\u001b[95Gcosts\u001b[101G0.30\u001b[106Gms\u001b[109Gof\u001b[112GGPU\u001b[116Gtime\r\u001b[4C\u001b[1Bon\u001b[8Gthe\u001b[12G5060\u001b[17GTi.\r\u001b[1B \u001b[3G- \u001b[1mWorld:\u001b[22m star systems, the galaxy and jumps, a spatial octree, deterministic Jolt physics\u001b[93Gin\u001b[96Gframes,\u001b[104Gflight,\u001b[112Gsensors\r\u001b[4C\u001b[1Band\u001b[9Gpicking.\r\u001b[1B  - \u001b[1mGameplay systems:\u001b[22m UI (RmlUi), audio, versioned saves with migrations, AI (behaviour trees, steering), docks,\u001b[K\r\u001b[4C\u001b[1Bpresentation\u001b[18Gpolish,\u001b[26GWasm\u001b[31Gscripting,\u001b[42Gmods\u001b[47Gand\u001b[51Gpacks,\u001b[58Gcrash\u001b[64Ghandling,\u001b[74Glocalisation,\u001b[88Gcruising,\u001b[98Ggates\u001b[104Gand\u001b[108Gthe\u001b[112Gfleet.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mAfter phase 13:\u001b[22m\u001b[K\r\u001b[1B  - \u001b[1mComment review (2026-11-18):\u001b[22m about\u001b[40G9,100\u001b[46Gcomment\u001b[54Glines\u001b[60Gacross\u001b[67G427\u001b[71Gfiles,\u001b[78Gtrimmed\u001b[86Gmodule\u001b[93Gby\u001b[96Gmodule.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mReference frames:\u001b[23G\u001b[22mthey\u001b[28Gnow\u001b[32Ghold\u001b[37Gunder\u001b[43Gload,\u001b[49Gand\u001b[53Gthe\u001b[57Gallowed\u001b[65Gpixel\u001b[71Gdifference\u001b[82Gwent\u001b[87Gfrom\u001b[92G518\u001b[96Gto\u001b[99Gzero.\r\u001b[1B \u001b[3G- \u001b[1mThe gate:\u001b[22m it runs\u001b[23Ginside\u001b[30Gthe\u001b[34Gsandbox,\u001b[43Gand\u001b[47Gframes\u001b[54Gcan\u001b[58Gbe\u001b[61Gdrawn\u001b[67Goffscreen\u001b[77Gon\u001b[80Gthe\u001b[84GGPU.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNeutral SDK and Manifest integration (approved 2026-11-15):\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mH02–H05:\u001b[14G\u001b[22ma\u001b[16Gpublic\u001b[23Ghost\u001b[28G(\u001b[38;2;177;185;249mJettison::Host\u001b[39m),\u001b[46Ga\u001b[48GCPU-only\u001b[57Gbuild,\u001b[64Gan\u001b[67Gindependent\u001b[79Gnon-space\u001b[89Gconsumer,\u001b[99Gand\u001b[103Gthe\u001b[107Gsample\u001b[114Ggame\r\u001b[4C\u001b[1Bmoved\u001b[11Gout\u001b[15Gto\u001b[18G\u001b[38;2;177;185;249msource/samples/space\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA01 and W01:\u001b[18G\u001b[22mneutral\u001b[26Gframe\u001b[32GIDs\u001b[36Gand\u001b[40Gsave\u001b[45Gmetadata,\u001b[55Gand\u001b[59Ggeneric\u001b[67Gmodule\u001b[74Gboundaries,\u001b[86Gso\u001b[89Gphysics,\u001b[98GAI\u001b[101Gand\u001b[105Gscene\u001b[111Gno\u001b[114Glonger\r\u001b[1B \u001b[3G  need anything space-specific. New \u001b[38;2;177;185;249mspace\u001b[39m and \u001b[38;2;177;185;249mspacescene\u001b[60G\u001b[39mmodules\u001b[68Ghold\u001b[73Gthat\u001b[78Gcode,\u001b[84Gand\u001b[88Gpad\u001b[92Gclasses\u001b[100Gare\u001b[104Gnow\u001b[108Gdata.\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.140, "o", "\u001b[?25l\u001b[H\u001b[5Gcomm\u001b[10Gnd\u001b[13G, saves and snapshots.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRendering:\u001b[22m Vulkan 1.3 in d\u001b[32Guble\u001b[37Gprecision\u001b[47Gat\u001b[50Greal\u001b[55Gscale,\u001b[62Gwith\u001b[67GHDR,\u001b[72GPBR,\u001b[77Gimage-based\u001b[89Glighting,\u001b[99Ga\u001b[101Gprocedural\u001b[112Gsky,\r\u001b[2C\u001b[1B \u001b[5Gclustered lights,\u001b[23Gcascade\u001b[31G sun shadow\u001b[43G, culling, instancing and levels of detail. A\u001b[89Gframe costs\u001b[101G0.30 ms of\u001b[112GGPU time\r\u001b[4C\u001b[1Bon th\u001b[11G 5060 Ti.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWorld:\u001b[12G\u001b[22mstar\u001b[17Gsystems,\u001b[26Gthe\u001b[30Ggalaxy\u001b[37Gand\u001b[41Gjumps,\u001b[48Ga\u001b[50Gspatial\u001b[58Goctree,\u001b[66Gdeterministic\u001b[80GJolt\u001b[85Gphysics\u001b[93Gin\u001b[96Gframes,\u001b[104Gflight,\u001b[112Gsensors\r\u001b[2C\u001b[1B \u001b[5Gand picking.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGameplay systems:\u001b[23G\u001b[22mUI\u001b[26G(RmlUi),\u001b[35Gaudio,\u001b[42Gversioned\u001b[52Gsaves\u001b[58Gwith\u001b[63Gmigrations,\u001b[75GAI\u001b[78G(behaviour\u001b[89Gtrees,\u001b[96Gsteering),\u001b[107Gdocks,\r\u001b[2C\u001b[1B \u001b[5Gpresentation polish,\u001b[26GWasm scripting\u001b[42Gmod\u001b[46G a\u001b[49Gd packs,\u001b[58Gcrash handl\u001b[70Gng, localisation, cruising, gates and the fleet.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter phase 13:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComment review (2026-11-18):\u001b[34G\u001b[22mabout\u001b[40G9,100\u001b[46Gcomment\u001b[54Glines\u001b[60Gacross\u001b[67G427\u001b[71Gfiles,\u001b[78Gtrimmed\u001b[86Gmodule\u001b[93Gby\u001b[96Gmodule.\r\u001b[4C\u001b[1B\u001b[1mReference frames:\u001b[22m they now hold \u001b[38Gnder load, and the allowed pixel\u001b[71Gd\u001b[73Gfference w\u001b[84Gnt from 518\u001b[96Gt\u001b[98G zero.\r\u001b[4C\u001b[1B\u001b[1mThe gate