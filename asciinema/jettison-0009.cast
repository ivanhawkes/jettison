[0.009, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mWorld::Policy\u001b[39m and \u001b[38;2;177;185;249mWorld::Job\u001b[39m are saved on the ship and\u001b[60Gcheck\u001b[66Gd when a\u001b[75Gsave loads.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[25G\u001b[39mlets\u001b[30Gonly\u001b[35Gthe\u001b[39Gship's\u001b[46Gowner\u001b[52Gset\u001b[56Gits\u001b[60Gpolicy.\u001b[68GAn\u001b[71Gedit\u001b[76Gleaves\u001b[83Gthe\u001b[87Gjob\u001b[91Gand\u001b[95Gits\u001b[99Gcargo\u001b[105Gwhere\u001b[111Gthey\u001b[116Gare,\r\u001b[2C\u001b[1B  and allowance already\u001b[27Gspent\u001b[33Gstays\u001b[39Gspent.\r\u001b[4C\u001b[1BNew tests in the \u001b[38;2;177;185;249mcommand\u001b[39m \u001b[34G\u001b[38;2;177;185;249mpolicy\u001b[41G\u001b[39msuites.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTh\u001b[8G \u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2;177;185;249mfixture\u001b[39m pinned h\u001b[38Gshes moved becau\u001b[55Ge\u001b[57Gthe\u001b[61Gtwo\u001b[65Gnew\u001b[69Gcomponents\u001b[80Gare\u001b[84Gregistered.\u001b[96GWith\u001b[101Gthose\u001b[107Gregistrations\r\u001b[2C\u001b[1B \u001b[5Gtaken out, both pins pass at\u001b[34Gth\u001b[37Gir ol\u001b[44Gvalues, so the change is to the save's layout,\u001b[91Gnot\u001b[95Gits\u001b[99Gstate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22ms\u001b[11Gice 2, the charges themselve\u001b[40G. I\u001b[44G moves\u001b[51Gthe\u001b[55Gsame\u001b[60Gpins\u001b[65Gagain,\u001b[72Gbecause\u001b[80Gstarter\u001b[88Gships\u001b[94Gsitting\u001b[102Gdocked\u001b[109Gwill\u001b[114Gnow\u001b[118Gpay\r\u001b[2C\u001b[1Bthe berth fee.\u001b[18G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis is\u001b[11Ga good point to run\u001b[31G\u001b[38;2;177;185;249m/compact\u001b[39m. The p\u001b[47Ganning reads fill\u001b[65Gd most\u001b[72Gof the context, and the slices ahead\u001b[109Gneed\u001b[114Gthe\r\u001b[2C\u001b[1Broom.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNot\u001b[7Gchecked: Jettison\u001b[25Gwasn't\u001b[32Gtouched,\u001b[41Gso\u001b[44Gits\u001b[48Ggate\u001b[53Gdidn't\u001b[60Grun.\u001b[65GNothing\u001b[73Ghas\u001b[77Gbeen\u001b[82Gpushed.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 12m 57s · done 1:44 pm\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m/compact\u001b[39m                                                                                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;147;165;255m*\u001b[3GCompacting conversation… \u001b[38;2;153;153;153m(0s)\u001b[33G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿\u001b[5G Tip: Run /install-slack-app to\u001b[37Guse\u001b[41GClaude in Slack\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
