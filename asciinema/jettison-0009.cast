[0.005, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gserver\u001b[12Gwith no client, saved\u001b[34Gmid-job, load\u001b[48Gd and \u001b[56Gplayed\u001b[63Gto one hash.\u001b[76G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThree\u001b[9Gchoices\u001b[17GI\u001b[19Gmade\u001b[24Gthat\u001b[29Gyou\u001b[33Gdidn't\u001b[40Gpick,\u001b[46Gand\u001b[50Gmay\u001b[54Gwant\u001b[59Gto\u001b[62Gchange:\r\u001b[2C\u001b[1B- \u001b[1mNo transport or holding charge\u001b[22m goes \u001b[42Gnto\u001b[46Gthe\u001b[50Gprofit es\u001b[60Gimate, because\u001b[75Gnone\u001b[80Gexists\u001b[87Gyet.\r\u001b[4C\u001b[1B\u001b[1mThe s\u001b[11Gle p\u001b[16Gice margin\u001b[22m is up to\u001b[36G1.5 credits per fill, a\u001b[60G \u001b[62Gost 64 fills, so about 96 credits\u001b[96Gat\u001b[99Gworst.\r\u001b[4C\u001b[1B\u001b[1mNPCs start at the starter venue,\u001b[22m so its free pads cap how many there can be.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLeft\u001b[8Gout,\u001b[13Gand\u001b[17Glisted\u001b[24Gin\u001b[27Gthe\u001b[31Gplan:\u001b[37Gscouting\u001b[46Gunknown\u001b[54Gmarkets,\u001b[63Gstanding\u001b[72Groutes,\u001b[80GWasm\u001b[85Gpolicies,\u001b[95Gand\u001b[99Gthe\u001b[103Gobservation\u001b[115Gsystem\r\u001b[2C\u001b[1Brunning every\u001b[17Gstep wh\u001b[25Gle a ship is d\u001b[40Gcked.\u001b[46GThat last on\u001b[59G means a docked NPC stops\u001b[85Gthe fast-forward from skippi\u001b[114Gg\u001b[K\r\u001b[2C\u001b[1Bsteps.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mModel:\u001b[10G\u001b[22mstay\u001b[15Gon\u001b[18GOpus\u001b[23G5.5\u001b[27Gat\u001b[30Ghigh\u001b[35Geffort.\u001b[43GThis\u001b[48Gis\u001b[51Gmoney\u001b[57Gaccounting\u001b[68Gunder\u001b[74Gdeterministic\u001b[88Greplay,\u001b[96Gand\u001b[100Ga\u001b[102Gcheaper\u001b[110Gmodel\u001b[116Grisks\r\u001b[2C\u001b[1Bsubtle\u001b[10Groundi\u001b[17Gg or replay bugs that would get locked into saves.\u001b[68G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShall\u001b[9GI\u001b[11Gstart\u001b[17Gimplementing?\u001b[31GI'd\u001b[35Gbegin\u001b[41Gwith\u001b[46G\u001b[38;2;177;185;249mRequests::Act\u001b[39m,\u001b[61Gthe\u001b[65Gpolicy\u001b[72Gcomponent\u001b[82Gand\u001b[86Gits\u001b[90Gcommand.\u001b[99GIt\u001b[102Gmay\u001b[106Gbe\u001b[109Gworth\r\u001b[2C\u001b[1Brunning\u001b[11G\u001b[38;2;177;185;249m/compact\u001b[39m first, since the plann\u001b[43Gng\u001b[46Greads filled a\u001b[61Glot\u001b[65Gof the\u001b[74Gntext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 4m 38s · done 1:25 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0009 ─\r\u001b[1B\u001b[39m❯ Make allowance for the future existance of transport and holding charges. Add them to the plan at an appropriate\u001b[K\r\u001b[1B  priority level.\u001b[K\r\u001b[2C\u001b[1BBook a tim\u001b[14G in the\u001b[22Gplan\u001b[27Gfor\u001b[31Gexamining\u001b[41Ghow\u001b[45Gwe\u001b[48Gcan\u001b[52Gfix\u001b[56Gdocked\u001b[63Gnpcs\u001b[68Gfrom\u001b[73Gstopping\u001b[82Gtime\u001b[87Gstepping.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
