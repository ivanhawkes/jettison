[0.084, "o", "\u001b[?25l\u001b[H\u001b[12Gnsit tim\u001b[22Gfirst. |\u001b[K\r\u001b[6C\u001b[1B\u001b[2m256\u001b[12G\u001b[22m| 70\u001b[17G/ L16 | Consignment\u001b[37Gstorage\u001b[45Gat\u001b[48Ga\u001b[50Gmarket's\u001b[59Gwarehouse\u001b[69G([\u001b[38;2;230;219;116mplan\u001b[39m](economy-and-development-plan.md#consi\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mgnment-storage-select\u001b[34Gd-2026-11-19), [\u001b[38;2;230;219;116mD-072\u001b[39m](decision-l\u001b[68Gdger.md#d-072)): goods un\u001b[95Gad\u001b[98Gd and listed und\r\u001b[11C\u001b[1Ber their \u001b[22Gwner'\u001b[28G titl\u001b[34G until bought or withdrawn, within the \u001b[74Garket's and the ship's space cap\u001b[107G, at a\u001b[K\r\u001b[11C\u001b[1Bstorage fee by the space \u001b[38Gaken. | W09;\u001b[51Gse\u001b[54Gtle the\u001b[62Gplan's\u001b[69Gop\u001b[72Gn fee, cap and collection choices firs\u001b[111G. |\r\u001b[6C\u001b[1B\u001b[2m257\u001b[12G\u001b[22m| 71 / L18 | Freight contr\u001b[39Gcts:\u001b[44Ga\u001b[46Gtrader posts cargo to carry\u001b[74Gb\u001b[76Gtween ve\u001b[85Gues and ship\u001b[98Gowners bid to ca\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mrry it\u001b[19G([\u001b[38;2;230;219;116mplan\u001b[39m](\u001b[28Gconomy-and-development-plan.md#fu\u001b[62Gther-market-s\u001b[76Grvices-sel\u001b[87Gcted-2026-11-19),\u001b[105G[\u001b[38;2;230;219;116mD-074\u001b[39m](d\r\u001b[11C\u001b[1Becis\u001b[17Gon-ledger.md#d-074)). | W09; s\u001b[48Gt\u001b[50Gle posting, bidding, delivery deadlines and failed delivery firs\r\u001b[11C\u001b[1Bt. |\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, read \u001b[1m5\u001b[22m files, ran \u001b[1m11\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCharges\u001b[11Gcode\u001b[16Gnext.\u001b[22GI'm\u001b[26Greading\