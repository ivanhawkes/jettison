[0.400, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mChanges from the plan\u001b[25G\u001b[22m(now\u001b[30Gin\u001b[33Gthe\u001b[37Gstage-4\u001b[45Gplan):\r\u001b[2C\u001b[1B- \u001b[1mLo\u001b[8Gin\u001b[11Grefusal is i\u001b[24G the server, not \u001b[38;2;177;185;249mmanifest-token\u001b[39m.\u001b[57G\u001b[22mThe\u001b[61Gtoken\u001b[67Gtool\u001b[72Gnever\u001b[78Gloads\u001b[84Gthe\u001b[88Gworld,\u001b[95Gso\u001b[98Git\u001b[101Gcan't\u001b[107Gtell\u001b[112Gwho\u001b[116Gis\u001b[119Gan\r\u001b[2C\u001b[1B \u001b[5GNPC. The server checks when a client logs in and refus\u001b[60Gs any NPC principa\u001b[79G, wha\u001b[85Gever the token file holds.\u001b[112GT\u001b[114Gat\u001b[K\r\u001b[4C\u001b[1Balso\u001b[10Gcovers token files edited by hand.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA field instead of a component.\u001b[22m I\u001b[39Guse\u001b[43G the\u001b[48G\u001b[38;2;177;185;249mnpc\u001b[52G\u001b[39mfield\u001b[58Grather\u001b[65Gthan\u001b[70Ga\u001b[72Gseparate\u001b[81G\u001b[38;2;177;185;249mWorld::Npc\u001b[92G\u001b[39mcomponent,\u001b[103Gwhich\u001b[109Gkeeps\u001b[115Git\u001b[118Gto\r\u001b[2C\u001b[1B \u001b[5Gone saved bool.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPins:\u001b[9G\u001b[22mtwo\u001b[13Gpinned\u001b[20Gsave\u001b[25Ghashes\u001b[32Gmoved,\u001b[39Gin\u001b[42G\u001b[38;2;177;185;249mcompany\u001b[50G\u001b[39mand\u001b[54G\u001b[38;2;177;185;249mfixture\u001b[39m.\u001b[63GWith\u001b[68Gthe\u001b[72Gnew\u001b[76Gfield\u001b[82Gtaken\u001b[88Gout\u001b[92Gof\u001b[95Gthe\u001b[99Gsave,\u001b[105Gboth\u001b[110Gpass\u001b[115Gat\r\u001b[2C\u001b[1Btheir\u001b[9Gold\u001b[13Gvalu\u001b[18Gs, so only the save bytes changed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;177;185;249m\u001b[1mcontent\u001b[39m:\u001b[14G\u001b[22mthe\u001b[18Gtwo\u001b[22Grefusals.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mremote\u001b[3