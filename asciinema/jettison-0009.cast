[22m a trader listed\u001b[37Gtwic\u001b[42G is refused.\u001b[55GSo is a list\u001b[68Gthat leaves the starter\u001b[92Gstation\u001b[100Gno\u001b[103Gfree\u001b[108Gpad\u001b[112Gor\r\u001b[2C\u001b[1B \u001b[5Glife-support connection for a player.\u001b[43G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges from the plan\u001b[25G\u001b[22m(now\u001b[30Gin\u001b[33Gthe\u001b[37Gstage-4\u001b[45Gplan):\r\u001b[2C\u001b[1B- \u001b[1mLo\u001b[8Gin\u001b[11Grefusal is i\u001b[24G the server, not \u001b[38;2;177;185;249mmanifest-token\u001b[39m.\u001b[57G\u001b[22mThe\u001b[61Gtoken\u001b[67Gtool\u001b[72Gnever\u001b[78Gloads\u001b[84Gthe\u001b[88Gworld,\u001b[95Gso\u001b[98Git\u001b[101Gcan't\u001b[107Gtell\u001b[112Gwho\u001b[116Gis\u001b[119Gan\r\u001b[2C\u001b[1B \u001b[5GNPC. The server checks when a client logs in and refus\u001b[60Gs any NPC principa\u001b[79G, wha\u001b[85Gever the token file holds.\u001b[112GT\u001b[114Gat\u001b[K\r\u001b[4C\u001b[1Balso\u001b[10Gcovers token files edited by hand.  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
