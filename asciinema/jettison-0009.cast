2Gd \u001b[38;2;177;185;249mpolicy\u001b[39m \u001b[42Guites.\u001b[49G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe \u001b[38;2;177;185;249mcompany\u001b[39m and\u001b[21G\u001b[38;2;177;185;249mfixture\u001b[39m pinned hashes moved because the two new\u001b[69Gc\u001b[71Gmponents are registered. With those\u001b[107Gregistrations\r\u001b[4C\u001b[1Btaken\u001b[11Gout,\u001b[16Gboth\u001b[21Gpins\u001b[26Gpass\u001b[31Gat\u001b[34Gtheir\u001b[40Gold\u001b[44Gvalues,\u001b[52Gso\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gto\u001b[72Gthe\u001b[76Gsave's\u001b[83Glayout,\u001b[91Gnot\u001b[95Gits\u001b[99Gstate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[22m slice 2,\u001b[18Gthe\u001b[22Gcharges\u001b[30Gthemselves.\u001b[42GIt\u001b[45Gmoves\u001b[51Gthe\u001b[55Gsame\u001b[60Gpins\u001b[65Gagain,\u001b[72Gbecause\u001b[80Gstarter\u001b[88Gships\u001b[94Gsitting\u001b[102Gdocked\u001b[109Gwill\u001b[114Gnow\u001b[118Gpay\r\u001b[2C\u001b[1Bthe\u001b[7Gberth\u001b[13Gfee.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis is\u001b[11Ga\u001b[13Ggood\u001b[18Gpoint\u001b[24Gto\u001b[27Grun\u001b[31G\u001b[38;2;177;185;249m/compact\u001b[39m.\u001b[41GThe\u001b[45Gplanning\u001b[54Greads\u001b[60Gfilled\u001b[67Gmost\u001b[72Gof\u001b[75Gthe\u001b[79Gcontext,\u001b[88Gand\u001b[92Gthe\u001b[96Gslices\u001b[103Gahead\u001b[109Gneed\u001b[114Gthe\r\u001b[2C\u001b[1Broom.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW18\u001b[22m, right after W10 in Manifest's\u001b[40Gdelivery order, settles\u001b[64Gthe\u001b[68Gcharges'\u001b[77Greal\u001b[82Gamounts\u001b[90Gand\u001b[94Gbases,\u001b[101Gplus\u001b[106Gstorage\u001b[114Gfees,\r\u001b[2C\u001b[1B \u001b[5Gtolls and the cost of life\u001b[32Gsupport u\u001b[42Ged in tr\u001b[51Gnsit.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mL28\u001b[22m, \u001b[11Gooked straight after W10, looks at why a docked f\u001b[61Geet stops the\u001b[75Gfast-forward\u001b[88Gfrom\u001b[93Gskipping\u001b[102Gsteps.\u001b[109GThe\u001b[113Gaim\u001b[117Gis\r\u001b[2C\u001b[1B \u001b[5Gfor observati\u001b[19Gn to\u001b[24Grun only\u001b[33Gwhen a covered market actually changes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThese\u001b[11Gare\u001b[15Grecorded\u001b[24Gin\u001b[27GD-097\u001b[33Gand\u001b[37Gthe\u001b[41G\"W10\u001b[46Gplan\"\u001b[52Gsection\u001b[60Gof\u001b[63Gthe\u001b[67Gstage-4\u001b[75Gplan.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat slice 1 adds:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mRequests::Act\u001b[19G\u001b[39mru\u001b[22Gs\u001b[24Ga command for an actor st\u001b[50Gaight away,\u001b[62Gwith\u001b[67Gno\u001b[70Gsequence\u001b[79Gnumber,\u001b[87Gledger\u001b[94Gor\u001b[97Grecording.\u001b[108GIt's\u001b[113Ghow\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gexecutor will\u001b[19Gsend the same commands a\u001b[44Gplayer\u001b[51Gdoes.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mWorld::Policy\u001b[39m and \u001b[38;2;177;185;249mWorld::Job\u001b[39m are saved on th\u001b[50G ship\u001b[56Gand\u001b[60Gchecked\u001b[68Gwhen a save loads.\u001b[87G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m lets only the\u001b[40Ghip's\u001b[46Gowner\u001b[52Gset\u001b[56Gits\u001b[60Gpolicy.\u001b[68GAn\u001b[71Gedit\u001b[76Gleaves\u001b[83Gthe\u001b[87Gjob\u001b[91Gand\u001b[95Gits\u001b[99Gcargo\u001b[105Gwhere\u001b[111Gthey\u001b[116Gare,\r\u001b[2C\u001b[1B \u001b[5Gand\u001b[9Gallowance already spent stays spent.\u001b[K\r\u001b[4C\u001b[1BNew\u001b[9Gtests in the \u001b[38;2;177;185;249mcommand\u001b[39m a\u001b[32Gd \u001b[38;2;177;185;249mpolicy\u001b[39m \u001b[42Guites.\u001b[49G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe \u001b[38;2;177;185;249mcompany\u001b[39m and\u001b[21G\u001b[38;2;177;185;249mfixture\u001b[39m pinned hashes moved because the two new\u001b[69Gc\u001b[71Gmponents are registered. With those\u001b[107Gregistrations\r\u001b[4C\u001b[1Btaken\u001b[11Gout,\u001b[16Gboth\u001b[21Gpins\u001b[26Gpass\u001b[31Gat\u001b[34Gtheir\u001b[40Gold\u001b[44Gvalues,\u001b[52Gso\u001b[55Gthe\u001b[59Gchange\u001b[66Gis\u001b[69Gto\u001b[72Gthe\u001b[76Gsave's\u001b[83Glayout,\u001b[91Gnot\u001b[95Gits\u001b[99Gstate.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[22m slice 2,\u001b[18Gthe\u001b[22Gcharges\u001b[30Gthemselves.\u001b[42GIt\u001b[45Gmoves\u001b[51Gthe\u001b[55Gsame\u001b[60Gpins\u001b[65Gagain,\u001b[72Gbecause\u001b[80Gstarter\u001b[88Gships\u001b[94Gsitting\u001b[102Gdocked\u001b[109Gwill\u001b[114Gnow\u001b[118Gpay\r\u001b[2C\u001b[1Bthe\u001b[7Gberth\u001b[13Gfee.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis is\u001b[11Ga\u001b[13Ggood\u001b[18Gpoint\u001b[24Gto\u001b[27Grun\u001b[31G\u001b[38;2;177;185;249m/compact\u001b[39m.\u001b[41GThe\u001b[45Gpl\u001b[76Ghe\u001b[79Gcontext,\u001b[88Gand\u001b[92Gthe\u001b[96Gslices\u001b[103Gahead\u001b[109Gneed\u001b[114Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
