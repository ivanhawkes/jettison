any|console|fixture)$' \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153m-j4 --output-on-failure 2>&1 | grep -E -B3 -A12 \"FAILED|failed|REQUIRE|CHECK|with expansion\" | head -150 (7s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
