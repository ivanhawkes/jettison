[0.402, "o", "\u001b[?25l\u001b[H\u001b[3G  NPC. The server checks \u001b[29Ghe\u001b[33Ga client logs i\u001b[49G and\u001b[54Grefuses\u001b[62Gany\u001b[66GNPC\u001b[70Gprincipal,\u001b[81Gwhatever\u001b[90Gthe\u001b[94Gtoken\u001b[100Gfile\u001b[105Gholds.\u001b[112GThat\r\u001b[2C\u001b[1B \u001b[5Galso covers token files edited by hand.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA field instead of a component.\u001b[22m I used the \u001b[38;2;177;185;249mnpc\u001b[39m field rather than\u001b[70Ga separ\u001b[78Gte\u001b[81G\u001b[38;2;177;185;249mWorld::Npc\u001b[39m component, which keeps it\u001b[118Gto\r\u001b[4C\u001b[1Bone saved bool.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPins:\u001b[9G\u001b[22mtwo pinned save\u001b[25Ghashes\u001b[32Gmoved,\u001b[39Gin\u001b[42G\u001b[38;2;177;185;249mcompany\u001b[50G\u001b[39mand\u001b[54G\u001b[38;2;177;185;249mfixture\u001b[39m.\u001b[63GWith\u001b[68Gthe\u001b[72Gnew\u001b[76Gfield\u001b[82Gtaken\u001b[88Gout\u001b[92Gof\u001b[95Gthe\u001b[99Gsave,\u001b[105Gboth\u001b[110Gpass\u001b[115Gat\r\u001b[2C\u001b[1Btheir\u001b[9Gold\u001b[13Gvalues,\u001b[21Gso\u001b[24Gonly\u001b[29Gthe\u001b[33Gsave\u001b[38Gbytes\u001b[44Gchanged.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mcontent\u001b[39m:\u001b[14G\u001b[22mthe\u001b[18Gtwo\u001b[22Grefusals.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mremote\u001b[39m:\u001b[13G\u001b[22ma\u001b[15Gclient\u001b[22Gholding\u001b[30Ga\u001b[32Gvalid\u001b[38Gtoken\u001b[44Gfor\u001b[48Gan\u001b[51GNPC\u001b[55Gprincipal\u001b[65Gis\u001b[68Grefused,\u001b[77Gand\u001b[81Ga\u001b[83Gplayer\u001b[90Gstill\u001b[96Ggets\u001b[101Gin.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mp\u001b[7Glicy\u001b[39m:\u001b[22m an NPC is flagged,\u001b[32Gits\u001b[36Gpolicy\u001b[43Gis\u001b[46Gon,\u001b[50Gand\u001b[54Ga\u001b[56Gplayer\u001b[63Gset\u001b[