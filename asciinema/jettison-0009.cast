[0.064, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGameplay systems:\u001b[23G\u001b[22mUI\u001b[26G(RmlUi),\u001b[35Gaudio,\u001b[42Gversioned\u001b[52Gsaves\u001b[58Gwith\u001b[63Gmigrations,\u001b[75GAI\u001b[78G(behaviour\u001b[89Gtrees,\u001b[96Gsteering),\u001b[107Gdocks,\r\u001b[2C\u001b[1B \u001b[5Gpresentation polish,\u001b[26GWasm scripting\u001b[42Gmod\u001b[46G a\u001b[49Gd packs,\u001b[58Gcrash handl\u001b[70Gng, localisation, cruising, gates and the fleet.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter phase 13:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mComment review (2026-11-18):\u001b[34G\u001b[22mabout\u001b[40G9,100\u001b[46Gcomment\u001b[54Glines\u001b[60Gacross\u001b[67G427\u001b[71Gfiles,\u001b[78Gtrimmed\u001b[86Gmodule\u001b[93Gby\u001b[96Gmodule.\r\u001b[4C\u001b[1B\u001b[1mReference frames:\u001b[22m they now hold \u001b[38Gnder load, and the allowed pixel\u001b[71Gd\u001b[73Gfference w\u001b[84Gnt from 518\u001b[96Gt\u001b[98G zero.\r\u001b[4C\u001b[1B\u001b[1mThe gate:\u001b[22m it runs\u001b[23Ginside the sandbox,\u001b[43Gand fr\u001b[50Gmes can be drawn offscreen o\u001b[79G the GPU.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNeutral SDK and Manifest integration (approved 2026-11-15):\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mH02–H05:\u001b[22m a public host (\u001b[38;2;177;185;249mJettison::Host\u001b[39m), a CPU-only build,\u001b[64Gan\u001b[67Gindependent\u001b[79Gnon-space\u001b[89Gconsumer,\u001b[99Gand\u001b[103Gthe\u001b[107Gsample\u001b[114Ggame\r\u001b[2C\u001b[1B \u001b[5Gmoved out to \u001b[38;2;177;185;249msource/sampl\u001b[31Gs/space\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA01 and W01:\u001b[18G\u001b[22mneutral frame IDs and\u001b[40Gsave\u001b[45Gmetadata,\u001b[55Gand\u001b[59Ggeneric\u001b[67Gmodule\u001b[74Gboundaries,\u001b[86Gso\u001b[89Gphysics,\u001b[98GAI\u001b[101Gand\u001b[105Gscene\u001b[111Gno\u001b[114Glonger\r\u001b[2C\u001b[1B \u001b[5Gneed anything space-specific. New \u001b[38;2;177;185;249mspace\u001b[45G\u001b[39mand \u001b[38;2;177;185;249mspacescene\u001b[39m modules hold that code, and pad cla\u001b[96Gses are now data.\u001b[114G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mG01:\u001b[10G\u001b[22mthe shell is generic, and a non-space ground sample r\u001b[64Gns in the smoke t\u001b[82Gst.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mContent pipeline:\u001b[23G\u001b[22mmap f\u001b[29Gelds, \u001b[38;2;177;185;249mDock::Fits\u001b[39m and \u001b[38;2;177;185;249mHost::DescribePackages\u001b[39m.\u001b[74G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNetworking (N02)\u001b[23G\u001b[22ma \u001b[38;2;177;185;249mnet\u001b[39m mo\u001b[32Gule on ENet and libsodium, with handshake,\u001b[75Grefusals,\u001b[85Gbounded\u001b[93Gqueues,\u001b[101Gper-session\r\u001b[2C\u001b[1B \u001b[5Gsnapshots and tokens.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMovement and performance:\u001b[31G\u001b[22mthe\u001b[35Gdock→lanes\u001b[46Gorder,\u001b[53G\u001b[38;2;177;185;249mSpace::ClearOf\u001b[39m,\u001b[69Gcontrols\u001b[78Glet\u001b[82Ggo\u001b[85Gwith\u001b[90Ga\u001b[92Gdestination,\u001b[105Gcruise\u001b[112Gby\r\u001b[2C\u001b[1B \u001b[5Gacceleration, and orbits place\u001b[36G once p\u001b[44Gr\u001b[46Gbo\u001b[49Gy, which halved a cruising \u001b[77Gtep to 13 µs. A fast-forward over quiet\r\u001b[4C\u001b[1Bsteps took the Ore→Br\u001b[27Gne\u001b[30Gtrip fr\u001b[38Gm 4\u001b[42Gmin\u001b[46G5\u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
