f\u001b[112GGPU\u001b[116Gtime\r\u001b[4C\u001b[1Bon\u001b[8Gthe\u001b[12G5060\u001b[17GTi.\r\u001b[2C\u001b[1B- \u001b[1mWo\u001b[8Gld:\u001b[22m star systems, the galaxy and jumps, a spatial octree,\u001b[66Gdeterministic\u001b[80GJolt\u001b[85Gphysics\u001b[93Gin\u001b[96Gframes,\u001b[104Gflight,\u001b[112Gsensors\r\u001b[2C\u001b[1B \u001b[5Gand picking.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGameplay systems:\u001b[22m UI (RmlUi), audio,\u001b[42Gversioned\u001b[52Gsaves\u001b[58Gwith\u001b[63Gmigrations,\u001b[75GAI\u001b[78G(behaviour\u001b[89Gtrees,\u001b[96Gsteering),\u001b[107Gdocks,\r\u001b[2C\u001b[1B \u001b[5Gpresentation\u001b[18Gpolish,\u001b[26GWas\u001b[30G scripting, mods an\u001b[50G p\u001b[53Gcks, crash handling,\u001b[74Gl\u001b[76Gcalisation, crui\u001b[94Gng\u001b[98Ggates and the fleet.\u001b[K\r\u001b[4C\u001b[1B    \u001b[10G        \u001b[19G               \u001b[35G   \u001b[39G     \u001b[45G  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
