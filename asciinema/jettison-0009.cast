[0.124, "o", "\u001b[?25l\u001b[H\r\u001b[31C\u001b[19B\u001b[38;2;153;153;153m8\u001b[44Gthought for 8s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.081, "o", "\u001b[?25l\u001b[H\u001b[3Ggets built in Jettison first, as before.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe design:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExecutor:\u001b[22m a new Manifest system, \u001b[38;2;177;185;249mmanifest.policy\u001b[39m, runs after the brokers' requote and before movement.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommands:\u001b[22m it sends the players' own commands (place, cancel, load, unload, travel) through a new \u001b[38;2;177;185;249mRequests::Act\u001b[39m.\u001b[117GThat\r\u001b[4C\u001b[1Bruns the same checks a player's request meets, with no sequence number, and isn't recorded, because a replay\u001b[K\r\u001b[4C\u001b[1Bproduces those commands again.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPolicy, per ship:\u001b[22m \u001b[38;2;177;185;249mManifest.Policy.Set\u001b[39m turns it on or off and sets two whole-credit amounts, both 0 by default:\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mtargetProfit\u001b[39m: a trade starts only if its estimate beats it.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mlossAllowance\u001b[39m: how far below cost a sale may go.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJob, saved on the ship:\u001b[22m choose → fly to the source → buy → fly to the destination → sell, or blocked. The lot\r\u001b[4C\u001b[1Bcarries the cost its fills actually paid, fees included.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChoosing a trade:\u001b[23G\u001b[22mit\u001b[26Guses\u001b[31Gonly\u001b[36Gthe\u001b[40Gowner's\u001b[48Gown\u001b[52Gmarket\u001b[59Greports,\u001b[68Gand\u001b[72Gan\u001b[75Gunknown\u001b[83Gmarket\u001b[90Ggives\u001b[96Gnothing.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBuying and selling:\u001b[22m each is one place-then-cancel,\u001b[56Gso\u001b[59Gnothing\u001b[67Gis\u001b[70Gleft\u001b[75Gresting\u001b[83Gon\u001b[86Gthe\u001b[90Gbook.\u001b[96GA\u001b[98Gsale's\u001b[105Gprice\u001b[111Glimit\u001b[117Gis\r\u001b[4C\u001b[1Bset low\u001b[13Genough\u001b[20Gto\u001b[23Gtake\u001b[28Ga\u001b[30Gbid\u001b[34Gbut\u001b[38Ghigh\u001b[43Genough\u001b[50Gthat,\u001b[56Ghowever\u001b[64Gthe\u001b[68Gfills\u001b[74Gsplit,\u001b[81Git\u001b[84Gnever\u001b[90Gsells\u001b[96Gbelow\u001b[102Gthe\u001b[106Gfloor\u001b[112Gwithout\r\u001b[4C\u001b[1Ballowance.\u001b[16GWhatever\u001b[25Gdoesn't\u001b[33Gsell\u001b[38Ggoes\u001b[43Gback\u001b[48Gaboard.\r\u001b[1B \u001b[3G- \u001b[1mBlocked jobs\u001b[22m keep their\u001b[29Gcargo\u001b[35Gand\u001b[39Gtry\u001b[43Gagain\u001b[49Gevery\u001b[55G60\u001b[58Gsimulation\u001b[69Gseconds,\u001b[78Gor\u001b[81Gthe\u001b[85Gstep\u001b[90Gafter\u001b[96Gone\u001b[100Gof\u001b[103Gthe\u001b[107Gowner's\u001b[115Gships\r\u001b[1B    docks.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNPC traders\u001b[17G\u001b[22mare\u001b[21Glisted\u001b[28Gin\u001b[31Gthe\u001b[35Gscenario,\u001b[45Gset\u001b[49Gup\u001b[52Gat\u001b[55Gthe\u001b[59Gstart\u001b[65Gthe\u001b[69Gway\u001b[73Ga\u001b[75Gplayer\u001b[82Gis,\u001b[86Gand\u001b[90Grun\u001b[94Gthe\u001b[98Gsame\u001b[103Gexecutor\u001b[112Gon\u001b[115Gtheir\r\u001b[1B \u001b[3G  own reports.\u001b[K\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.140, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mTests:\u001b[12G\u001b[22ma\u001b[14G\u001b[38;2;177;185;249mpolicy\u001b[21G\u001b[39msuite\u001b[27Gcovers\u001b[34Geach\u001b[39Grule.\u001b[45GThe\u001b[49Gfixture\u001b[57Gsuite\u001b[63Gshows\u001b[69Gan\u001b[72GNPC\u001b[76Gand\u001b[80Ga\u001b[82Gdisconnected\u001b[95Gplayer's\u001b[104Gship\u001b[109Gtrading\u001b[117Gon\u001b[120Ga\u001b[27;1H\u001b[24;3H\u001b[?25h"]
