[0.122, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m80\u001b[22m lines to \u001b[1m~/projects/manifest/scripts/.stage-dryrun.sh\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;117;113;94m!/usr/bin/env bash\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m\u001b[38;2;117;113;94mS\u001b[16Gs the di\u001b[25Gtribution (\u001b[37Gocs/stage-5-recovery-p\u001b[60Gan.md, \"The runtime distribution contract\") from a\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m3\u001b[9G\u001b[22m\u001b[38;2;117;113;94m# clean checkout, so that its game tree names a commit: the release build, linked to run outside its\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m4\u001b[9G\u001b[22m\u001b[38;2;117;113;94m# toolchain (cmake/Distribution.cmake) and checked so (check-distribution.sh), laid out with its\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 5 \u001b[22m\u001b[38;2;117;113;94m# content, its BUILD and the licence of every source tree compiled into it, and packed as\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 6 \u001b[22m\u001b[38;2;117;113;94m# manifest-<version>-<game tree>-linux-x86_64.tar.gz in the output directory, which it names.\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 7 \u001b[22m\u001b[38;2;117;113;94m# stage-bundle.sh [<output directory>], build/bundle by default.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 8 \u001b[22m\u001b[38;2;166;226;46mset\u001b[13G\u001b[39m-euo\u001b[18Gpipefail\r\u001b[1B \u001b[3G   \u001b[2m 9 \u001b[22m\u001b[38;2;166;226;46mcd\u001b[39m \u001b[38;2;230;219;116m\"\u001b[39m$(dirname \u001b[38;2;230;219;116m\"\u001b[39m$0\u001b[38;2;230;219;116m\"\u001b[39m)\u001b[38;2;230;219;116m/..\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m… +71 lines \u001b[39m\u001b[K\r\u001b[10C\u001b[2B\u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[101C\u001b[4B\u001b[K\r\u001b[18C\u001b[2B\u001b[38;2;153;153;153m23m 55s · ↓\u001b[39m \u001b[38;2;153;153;153m91.8k token\u001b[43G)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
