[0.063, "o", "\u001b[?25l\u001b[H\u001b[5Gonly glibc's own libra\u001b[28Gies.\u001b[33GA new \u001b[38;2;177;185;249mdistr\u001b[45Gb\u001b[47Gtion\u001b[39m test fails \u001b[65Ge gate if a nixpkgs update brings in\u001b[102Ganything \u001b[112Gewer.\u001b[118G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefaults.\u001b[22m Ev\u001b[19Gy build tree\u001b[32Gis laid out like the bundle (\u001b[38;2;177;185;249mbin/\u001b[39m, \u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m). \u001b[38;2;177;185;249m--content\u001b[39m is now\u001b[K\r\u001b[5C\u001b[1Bptional. The \u001b[20Gor\u001b[23Gd, backups,\u001b[35Gtoken file and TUI transcrip\u001b[64G def\u001b[69Gult to the XDG direc\u001b[90Gories, each\u001b[102Gcreated 0700.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mScripts.\u001b[22m \u001b[38;2;177;185;249mscripts/stage-bundle.sh\u001b[39m writes th\u001b[50Garball with its \u001b[38;2;177;185;249mBUILD\u001b[39m file and the licences of every linked library.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mscripts/test-bundle.sh\u001b[39m runs it \u001b[37Gn the host and in the \u001b[60Gontain\u001b[67Grs. \u001b[38;2;177;185;249mscripts/bundle-smoke.sh\u001b[39m runs the full sequence:\r\u001b[2C\u001b[1B \u001b[5Gstart, validate, issue a token, se\u001b[40Gve, connect the TUI, stop, restore. It also runs as a\u001b[94Gtest on every build t\u001b[116Gee.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence:\u001b[22m the Manife\u001b[24Gt gate passed with \u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m.\u001b[67GThe tarball\u001b[79Gstaged from \u001b[38;2;177;185;249m0ac13fe\u001b[99G\u001b[39mpassed \u001b[38;2;177;185;249mtest-bundle.sh\r\u001b[2C\u001b[1B\u001b[39mfrom\u001b[8Ga\u001b[10Gread-only\u001b[20Gdirectory\u001b[30Gunder\u001b[36G\u001b[38;2;177;185;249menv -i\u001b[43G\u001b[39mon\u001b[46Gthis\u001b[51Gmachine\u001b[59Gand\u001b[63Gin\u001b[66Gboth\u001b[71Gcontainers,\u001b[83Gwith\u001b[88Gno\u001b[91Gnetwork.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Grelease\u001b[17Gpreset's\u001b[26Gtests\u001b[32Gnow\u001b[36Gneed\u001b[41Ga\u001b[43Gloader\u001b[50Gat\u001b[53G\u001b[38;2;177;185;249m/lib64\u001b[39m,\u001b[61Gwhich\u001b[67Gmeans\u001b[73Gnix-ld\u001b[80Gon\u001b[83GNixOS.\u001b[90GIf\u001b[93Gthe\u001b[97Glaptop\u001b[104Gdoesn't\u001b[112Ghave\r\u001b[2C\u001b[1B  nix-ld, its release\u001b[25Gstage\u001b[31Gwill\u001b[36Gfail.\r\u001b[4C\u001b[1BCI hasn't been checked. It\u001b[32Gshould run\u001b[43Gthe shipped binaries against Ubuntu 24.04's glibc\u001b[93G2.39 directly, bu\u001b[112GI can't\r\u001b[4C\u001b[1Bconfirm\u001b[13Gthat until the comm\u001b[33Gts\u001b[36Gare pushed.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mtest-bundle.sh\u001b[20G\u001b[39mne\u001b[23Gds Docker, so it is\u001b[43Grun\u001b[47Gby han\u001b[55Gand is not in CI.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mlibstdc++\u001b[39m \u001b[16Gnd \u001b[38;2;177;185;249mlibgcc\u001b[39m's\u001b[28Glicence\u001b[36Gtext i\u001b[43Gn't in\u001b[50Gthe\u001b[54Gbundle.\u001b[62GThey\u001b[67Gare\u001b[71Gunder\u001b[77GGCC's\u001b[83GRuntime\u001b[91GLibrary\u001b[99GException,\u001b[110Gwhich\u001b[116GI\r\u001b[2C\u001b[1B \u001b[5Gread as putting no condition\u001b[34Gon\u001b[37Gthe binaries.\u001b[K\r\u001b[4C\u001b[1BThe tarball is 40 MB because \u001b[35Gach binary keeps its debug\u001b[62Ginformatio\u001b[73G (30 to 32 MB each). I left them u\u001b[108Gstripped for\r\u001b[4C\u001b[1Bcr\u001b[8Gsh re\u001b[14Gor\u001b[17Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.400, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mDefaults.\u001b[22m Every bu\u001b[24Gld tr\u001b[30Ge is\u001b[35Glaid out like the bundle (\u001b[38;2;177;185;249mbin/\u001b[39m,\u001b[67G\u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m). \u001b[38;2;177;185;249m--content\u001b[39m is\u001b[112Go\u001b[114G\u001b[K\r\u001b[2C\u001b[1B \u001b[5Goptional.\u001b[15GTh\u001b[18G world, backups,\u001b[35Gtoken file and TUI transcript default to the XDG directories, each created 0700.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripts.\u001b[22m \u001b[38;2;177;185;249mscripts/stage-bundle.sh\u001b[39m writes the tarball with i\u001b[64Gs \u001b[38;2;177;185;249mBUILD\u001b[39m file and the licences of\u001b[98Gvery link\u001b[109G library.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mscripts/test-bundle.sh\u001b[39m runs it on the host and in the containers. \u001b[38;2;177;185;249mscripts/bundle-smoke.sh\u001b[39m runs the full sequence:\r\u001b[4C\u001b[1Bstart, validate, issue\u001b[28Ga token, serv\u001b[42G, connect\u001b[52Gthe TUI, s\u001b[63Gop, \u001b[68Gestore. It also runs as a test on \u001b[103Gvery build tr\u001b[117Ge.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence:\u001b[13G\u001b[22mthe\u001b[17GManifest\u001b[26Ggate\u001b[31Gpassed\u001b[38Gwith\u001b[43G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m.\u001b[67GThe\u001b[71Gtarball\u001b[79Gstaged\u001b[86Gfrom\u001b[91G\u001b[38;2;177;185;249m0ac13fe\u001b[99G\u001b[39mpassed\u001b[106G\u001b[38;2;177;185;249mtest-bundle.sh\r\u001b[2C\u001b[1B\u001b[39mfrom a read-only directory under \u001b[38;2;177;185;249menv -i\u001b[43G\u001b[39mon this machine and in both\u001b[71Gcont\u001b[76Giners, with no\u001b[91Gnetwork.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m- The release preset's\u001b[26Gtests\u001b[32Gnow\u001b[36Gneed\u001b[41Ga\u001b[43Gloader\u001b[50Gat\u001b[53G\u001b[38;2;177;185;249m/lib64\u001b[39m,\u001b[61Gwhich\u001b[67Gmeans\u001b[73Gnix-ld\u001b[80Gon\u001b[83GNixOS.\u001b[90GIf\u001b[93Gthe\u001b[97Glaptop\u001b[104Gdoesn't\u001b[112Ghave\r\u001b[2C\u001b[1B \u001b[5Gnix-ld, its\u001b[17Grelease s\u001b[27Gage will\u001b[36Gfail.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCI hasn't been checked. It should run\u001b[43Gthe\u001b[47Gshipped\u001b[55Gbinaries\u001b[64Gagainst\u001b[72GUbuntu\u001b[79G24.04's\u001b[87Gglibc\u001b[93G2.39\u001b[98Gdirectly,\u001b[108Gbut\u001b[112GI\u001b[114Gcan't\r\u001b[2C\u001b[1B \u001b[5Gconfirm \u001b[14Ghat until the commits are pushed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m needs Do\u001b[29Gker, \u001b[35Go it\u001b[40Gis run by\u001b[50Ghand\u001b[55Gand\u001b[59Gis\u001b[62Gnot\u001b[66Gin\u001b[69GCI.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibstdc++\u001b[39m and \u001b[38;2;177;185;249mlibgcc\u001b[39m's licence text isn't\u001b[47Gin\u001b[50Gthe bu\u001b[58Gle.\u001b[62GThey are under\u001b[77GGCC's\u001b[83GRuntime\u001b[91GLibrary\u001b[99GException,\u001b[110Gwhich\u001b[116GI\r\u001b[2C\u001b[1B \u001b[5Gread as putting no conditio\u001b[33G on the\u001b[41Gbi\u001b[44Garies.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe t\u001b[11Grball \u001b[18Gs 40 MB because\u001b[34Geach binary k\u001b[48Geps\u001b[52Gits\u001b[56Gdebug\u001b[62Ginformation\u001b[74G(30\u001b[78Gto\u001b[81G32\u001b[84GMB\u001b[87Geach).\u001b[94GI\u001b[96Gleft\u001b[101Gthem\u001b[106Gunstripped\u001b[117Gfor\r\u001b[2C\u001b[1B \u001b[5Gcrash \u001b[12Geports.\u001b[20G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNext\u001b[8Gis\u001b[11GR08,\u001b[16Gpersistent\u001b[27Greconnect\u001b[37Gand\u001b[41Grecovery.\u001b[51GIt\u001b[54Gdoesn't\u001b[62Gdepend\u001b[69Gon\u001b[72Gthis\u001b[77Gsession,\u001b[86Gand\u001b[90Gthe\u001b[94Ghandoff\u001b[102Gis\u001b[105Gin\u001b[108GManifest's\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.162, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G\u001b[38;2;177;185;249mscripts/test-bundle.sh\u001b[39m \u001b[29Guns it on the host and in the containers. \u001b[38;2;177;185;249mscripts/bundle-smoke.sh\u001b[39m runs the full \u001b[110Gequence:\r\u001b[4C\u001b[1Bstart, validate, issue a token, s\u001b[39Grve, con\u001b[48Gect the TUI, stop, restore.\u001b[76GIt also\u001b[84Gruns as a test on\u001b[102Gev\u001b[105Gry build tree.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence:\u001b[22m the Manifest gate passed with\u001b[43G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m. The\u001b[71Gtarball staged from \u001b[38;2;177;185;249m0ac13fe\u001b[39m passed \u001b[38;2;177;185;249mtest-bundle.sh\r\u001b[2C\u001b[1B\u001b[39mfrom a read-only directory\u001b[30Gund\u001b[34Gr \u001b[38;2;177;185;249menv -i\u001b[39m on this machine and in both containers, with no network.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mTh\u001b[6Gngs to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- The release preset's tests now\u001b[36Gneed a\u001b[43Gloader at \u001b[38;2;177;185;249m/lib64\u001b[39m, wh\u001b[64Gch means \u001b[74Gix-ld on\u001b[83GN\u001b[85GxOS. If \u001b[94Ghe laptop\u001b[104Gdoesn't\u001b[112Ghave\r\u001b[4C\u001b[1Bnix-ld,\u001b[13Gits\u001b[17Grelease\u001b[25Gstage\u001b[31Gwill\u001b[36Gfail.\r\u001b[2C\u001b[1B- CI hasn't been\u001b[20Gchecked.\u001b[29GIt\u001b[32Gshould\u001b[39Grun\u001b[43Gthe\u001b[47Gshipped\u001b[55Gbinaries\u001b[64Gagainst\u001b[72GUbuntu\u001b[79G24.04's\u001b[87Gglibc\u001b[93G2.39\u001b[98Gdirectly,\u001b[108Gbut\u001b[112GI\u001b[114Gcan't\r\u001b[2C\u001b[1B \u001b[5Gconfirm that until the commits\u001b[36Gar\u001b[39G pushed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m needs Docker, so it is\u001b[43Grun\u001b[47Gby\u001b[50Ghand\u001b[55Gand\u001b[59Gis\u001b[62Gnot\u001b[66Gin\u001b[69GCI.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mlibstdc++\u001b[15G\u001b[39ma