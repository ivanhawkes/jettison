[0.259, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe shipped binaries link about thirty static archives, so I'm pulling\u001b[74Gthe\u001b[78Glicence\u001b[86Glist\u001b[91Gfrom\u001b[96Gninja's\u001b[104Gbuild\u001b[110Grecord\r\u001b[2C\u001b[1Binstead\u001b[11Gof\u001b[14Ga\u001b[16Ghand-kept\u001b[26Gtable.\u001b[33GNext\u001b[38GI'm\u001b[42Greading\u001b[50Gthe\u001b[54Ggate\u001b[59Gand\u001b[63GCI\u001b[66Gscripts\u001b[74Gto\u001b[77Gsee\u001b[81Gwhere\u001b[87Gthe\u001b[91Gdistribution\u001b[104Gbuild\u001b[110Gbelongs.\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;153;153;153m· summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, listed \u001b[1m1\u001b[22m directory \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe release stage can build the shipped\u001b[43Gbinaries\u001b[52Gitself\u001b[59Gif\u001b[62GI\u001b[64Gput\u001b[68Gthe\u001b[72Gdistribution\u001b[85Glink\u001b[90Goptions\u001b[98Gon\u001b[101G\u001b[38;2;177;185;249mclang-release\u001b[39m,\u001b[116Gand\r\u001b[2C\u001b[1BI'm\u001b[7Gchecking\u001b[16Gthe\u001b[20GNix\u001b[24Gwrapper\u001b[32Gaccepts\u001b[40Gthose\u001b[46Gflags\u001b[52Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+6\u001b[38;2;153;153;153m, ran \u001b[1m2\u001b[22m shell commands \u001b[52G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe link flags work in the Nix shell, and the test\u001b[54Gbinary\u001b[61Gruns\u001b[66Gthrough\u001b[74Gnix-ld;\u001b[82GI'm\u001b[86Gchecking\u001b[95Gthe\u001b[99Gremaining\u001b[109Gdetails\r\u001b[2C\u001b[1Bbefo