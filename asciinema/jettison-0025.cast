[0.051, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/scripts/bundle-smoke.sh)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m83\u001b[22m lines to \u001b[1m~/projects/manifest/scripts/bundle-smoke.sh\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env bash\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  2 \u001b[22m\u001b[38;2;117;113;94m# The distribution run as its operator runs it, every place left to its default\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  3 \u001b[22m\u001b[38;2;117;113;94m# (docs/stage-5-recovery-plan.md, \"The runtime distribution contract\"): from an empty directory, the\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22m\u001b[38;2;117;113;94m# content found beside the executables, and the world, its backups, the token file and the TUI's\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m\u001b[38;2;117;113;94m# transcript under HOME's XDG directories, each made private. A start; the pack validated; an\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m\u001b[38;2;117;113;94m# administrator's token issued; the server started on a new world, the TUI (when there is one)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22m\u001b[38;2;117;113;94m# connected to it with the token, and the server stopped, which writes a snapshot and its backup; the\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m\u001b[38;2;117;113;94m# backup restored into a new directory at the step the server stopped at.\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m  9 \u001b[22m\u001b[38;2;117;113;94m# bundle-smoke.sh <prefix>, the directory holding bin/ and share/manifest/, a bundle's or a build\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 10 \u001b[22m\u001b[38;2;117;113;94m# tree's. HOME is made, and must be new or empty; the XDG variables are not read.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +73 lines \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ chmod +x '../manifest/'scripts/bundle-smoke.sh\r\u001b[18C\u001b[2B13m 29s ·\u001b[29G↓\u001b[39m \u001b[38;2;153;153;153m72.0k token\u001b[43G)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
