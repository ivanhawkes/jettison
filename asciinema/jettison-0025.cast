[40Glist\u001b[45Gto\u001b[48Gpick\u001b[53Ga\u001b[55Gworkaround.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m \u001b[10Ghell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe static libstdc++.a turns up in gcc's lib/ directory, so the contract's approach holds; next I'm reading the paths,\r\u001b[2C\u001b[1Bworld and token files, the\u001b[30Gsmoke\u001b[36Gtest\u001b[41Gand\u001b[45Gthe\u001b[49Gbuild\u001b[55Gidentity\u001b[64Gthat\u001b[69GR07\u001b[73Gtouches.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GTransfiguring… \u001b[45G\u001b[38;2;153;153;153mthought for 55s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
