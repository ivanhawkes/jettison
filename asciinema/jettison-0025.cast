[0.131, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mWrite\u001b[22m(~/projects/manifest/scripts/.stage-dryrun.sh)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m72\u001b[22m lines to \u001b[1m~/projects/manifest/scripts/.stage-dryrun.sh\r\u001b[6C\u001b[1B\u001b[22m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;117;113;94m!/usr/bin/\u001b[21Gnv bash\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2\u001b[11G\u001b[22m\u001b[38;2;117;113;94mStages the distribu\u001b[31Gion\u001b[35G(docs/stage-5-recovery-plan.md, \"Th\u001b[71G runtime distr\u001b[86Gbution contrac\u001b[101G\") from a\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m3\u001b[11G\u001b[22m\u001b[38;2;117;113;94mclean checkout, so that i\u001b[37Gs game tree \u001b[50Games a commit: the release bu\u001b[80Gld, linked to run outs\u001b[103Gde its\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;2;117;113;94mt\u001b[13Golchain (cmake/\u001b[29Gistribution.cmake) and checked so (che\u001b[68Gk-d\u001b[72Gstribu\u001b[79Gion.sh), laid out with its\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m5\u001b[11G\u001b[22m\u001b[38;2;117;113;94mco\u001b[14Gtent, its BUILD and the licence of every source\u001b[62Gtree compiled\u001b[76Ginto it, and packed\u001b[96Gas\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m6\u001b[11G\u001b[22m\u001b[38;2;117;113;94mmanifest-<v\u001b[23Gr\u001b[25Gion>-<game\u001b[36Gtre\u001b[40G>-linux-x86_64.tar.gz\u001b[62Gin\u001b[65Gthe ou\u001b[72Gput directory, which it names.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m7\u001b[9G\u001b[22m\u001b[38;2;117;113;94m# stage-bundle.sh [<output directory>], build/bundle by default.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m8\u001b[9G\u001b[22m\u001b[38;2;166;226;46mset\u001b[39m -euo pip\u001b[22Gfail\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[22m\u001b[38;2;166;226;46mcd\u001b[39m \u001b[38;2;230;219;116m\"\u001b[39m$(dirname\u001b[23G\u001b[38;2;230;219;116m\"\u001b[39m$0\u001b[38;2;230;219;116m\"\u001b[39m)\u001b[38;2;230;219;116m/..\"\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +63 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe staging script shipped without licences\u001b[47Gbecause\u001b[55Ga\u001b[57G\u001b[38;2;177;185;249msed\u001b[61G\u001b[39mdelimiter\u001b[71Gbug\u001b[75Gwent\u001b[80Gunnoticed\u001b[90Gunder\u001b[96G\u001b[38;2;177;185;249mset -e\u001b[39m.\u001b[104GI'm\u001b[108Gfixing\u001b[115Gthe\r\u001b[2C\u001b[1Bdelimiter and adding a guard so an empty list fails.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[22C\u001b[2B\u001b[38;2;153;153;153m5\u001b[45Gthought for 6s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
