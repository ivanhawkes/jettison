 exists,\u001b[33Gnaming each on\u001b[48G mi\u001b[52Gsing.\u001b[58G`sdk_import` configures Manif\u001b[88Gst\u001b[91Gunder a parent with\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest's\u001b[14Gdocs\u001b[19Gare\u001b[23Gupdated.\u001b[32GNow\u001b[36Gthe\u001b[40Gengine\u001b[47Gside:\u001b[53Gone\u001b[57Gline\u001b[62Geach\u001b[67Gin\u001b[70GJettison's\u001b[81Groadmap\u001b[89Gand\u001b[93Ghistory,\u001b[102Gfollowing\u001b[112Gthe\r\u001b[1B \u001b[3Gp\u001b[5Gttern the R05\u001b[19Gcommit us\u001b[32G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ git show b475aac -- docs/history.md docs/roadmap.md | head -60; git show d9f565c -- docs/history.md | head -40\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
