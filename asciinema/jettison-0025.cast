[0.007, "o", "\u001b[?25l\u001b[H\u001b[3Gfrom a read-only directory under\u001b[36G\u001b[38;2;177;185;249menv -i\u001b[43G\u001b[39mon \u001b[47Ghis machin\u001b[59Gand in both\u001b[71Gcontainers, with no network.\u001b[100G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m- The releas\u001b[17Gpreset's\u001b[26Gtests now need a\u001b[43Gloader at \u001b[38;2;177;185;249m/lib64\u001b[39m, which\u001b[67Gmeans nix-\u001b[78Gd on NixOS. If the la\u001b[100Gtop \u001b[105Goesn't have\u001b[K\r\u001b[2C\u001b[1B  nix-ld, its releas\u001b[24G stage will\u001b[36Gfail.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCI\u001b[8Ghasn't\u001b[15Gbeen\u001b[20Gchecked.\u001b[29GIt\u001b[32Gshould\u001b[39Grun\u001b[43Gthe\u001b[47Gshipped\u001b[55Gbinaries\u001b[64Gagainst\u001b[72GUbuntu\u001b[79G24.04's\u001b[87Gglibc\u001b[93G2.39\u001b[98Gdirectly,\u001b[108Gbut\u001b[112GI\u001b[114Gcan't\r\u001b[2C\u001b[1B  confirm that\u001b[18Guntil\u001b[24Gthe\u001b[28Gcommits\u001b[36Gare\u001b[40Gpushed.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m n\u001b[22Ged\u001b[26GDocker, so it is\u001b[43Grun by\u001b[50Ghand and is not in CI.\u001b[73G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mlibstdc++\u001b[39m and \u001b[38;2;177;185;249mlibgcc\u001b[39m's licence\u001b[36Gtext isn't\u001b[47Gin\u001b[50Gthe\u001b[54Gbundle.\u001b[62GThey\u001b[67Gare\u001b[71Gunder\u001b[77GGCC's\u001b[83GRuntime\u001b[91GLibrary\u001b[99GException,\u001b[110Gwhich\u001b[116GI\r\u001b[2C\u001b[1B \u001b[5Gread as putti\u001b[19Gg no condition \u001b[35Gn the binaries.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe tarball is 40 MB be\u001b[29Gause each binary keeps\u001b[52Gits\u001b[56Gdebug\u001b[62Ginformation\u001b[74G(30\u001b[78Gto\u001b[81G32\u001b[84GMB\u001b[87Geach).\u001b[94GI\u001b[96Gleft\u001b[101Gthem\u001b[106Gunstripped\u001b[117Gfor\r\u001b[2C\u001b[1B \u001b[5Gcrash reports.\u001b[20G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNext is R08, persistent recon\u001b[33Gect\u001b[37Gand\u001b[41Grecovery\u001b[51GIt\u001b[54Gdoesn't\u001b[62Gdepend\u001b[69Gon\u001b[72Gthis\u001b[77Gsession,\u001b[86Gand\u001b[90Gthe\u001b[94Ghandoff\u001b[102Gis\u001b[105Gin\u001b[108GManifest's\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdocs/session-handoff.md\u001b[39m, so I'd start it fresh with \u001b[38;2;177;185;249m/clear\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 46m 7s · done 5:26 pm\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m/clear\u001b[39m                                                                                                                \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;235;159;127mTra\u001b[38;2;215;119;87mnsmuting… \u001b[39m\u001b[K\r\u001b[32C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
