[0.979, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat changed in Manifest\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mRelease build\u001b[19Gis th\u001b[25G distribution build.\u001b[46G\u001b[22mThe\u001b[50Gfour\u001b[55Gbinaries\u001b[64G(server,\u001b[73Gvalidator,\u001b[84Gtoken\u001b[90Gtool,\u001b[96GTUI)\u001b[101Glink\u001b[106G\u001b[38;2;177;185;249mlibstdc++\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gstatically and load through \u001b[38;2;177;185;249m/lib64/ld-linux-x86-64.so.2\u001b[39m with no RUNPATH. The three glibc symbols newer than 2.39\u001b[118Gare\r\u001b[4C\u001b[1Bbound to older\u001b[20Gversions in \u001b[38;2;177;185;249msource/apps/distribution/GlibcFloor.cpp\u001b[39m. Each\u001b[78Gbinary now needs glibc 2.38 at most and\u001b[118G\u001b[K\r\u001b[4C\u001b[1Bonly glibc's own libraries. A new \u001b[38;2;177;185;249mdistribu\u001b[48Gion\u001b[39m test fails the gate if a nixpkgs\u001b[85Gupdat\u001b[91G brings in anything newer.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefaults.\u001b[22m Every bu\u001b[24Gld tr\u001b[30Ge is\u001b[35Glaid out like the bundle (\u001b[38;2;177;185;249mbin/\u001b[39m,\u001b[67G\u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m). \u001b[38;2;177;185;249m--content\u001b[39m is\u001b[112Go\u001b[114G\u001b[K\r\u001b[2C\u001b[1B \u001b[5Goptional.\u001b[15GTh\u001b[18G world, backups,\u001b[35Gtoken file and TUI transcript default to the XDG directories, each created 0700.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripts.\u001b[22m \u001b[38;2;177;185;249mscripts/stage-bundle.sh\u001b[39m writes the tarball with i\u001b[64Gs \u001b[38;2;177;185;249mBUILD\u001b[39m file and the licences of\u001b[98Gvery link\u001b[109G library.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mscripts/test-bundle.sh\u001b[39m runs it on the host and in the containers. \u001b[38;2;177;185;249mscripts/bundle-smoke.sh\u001b[39m runs the full sequence:\r\u001b[4C\u001b[1Bstart, validate, issue\u001b[28Ga token, serv\u001b[42G, connect\u001b[52Gthe TUI, s\u001b[63Gop, \u001b[68Gestore. It also runs as a test on \u001b[103Gvery build tr\u001b[117Ge.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence:\u001b[13G\u001b[22mthe\u001b[17GManifest\u001b[26Ggate\u001b[31Gpassed\u001b[38Gwith\u001b[43G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m.\u001b[67GThe\u001b[71Gtarball\u001b[79Gstaged\u001b[86Gfrom\u001b[91G\u001b[38;2;177;185;249m0ac13fe\u001b[99G\u001b[39mpassed\u001b[106G\u001b[38;2;177;185;249mtest-bundle.sh\r\u001b[2C\u001b[1B\u001b[39mfrom a read-only directory under \u001b[38;2;177;185;249menv -i\u001b[43G\u001b[39mon this machine and in both\u001b[71Gcont\u001b[76Giners, with no\u001b[91Gnetwork.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m- The release preset's\u001b[26Gtests\u001b[32Gnow\u001b[36Gneed\u001b[41Ga\u001b[43Gloader\u001b[50Gat\u001b[53G\u001b[38;2;177;185;249m/lib64\u001b[39m,\u001b[61Gwhich\u001b[67Gmeans\u001b[73Gnix-ld\u001b[80Gon\u001b[83GNixOS.\u001b[90GIf\u001b[93Gthe\u001b[97Glaptop\u001b[104Gdoesn't\u001b[112Ghave\r\u001b[2C\u001b[1B \u001b[5Gnix-ld, its\u001b[17Grelease s\u001b[27Gage will\u001b[36Gfail.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GCI hasn't been checked. It should run\u001b[43Gthe\u001b[47Gshipped\u001b[55Gbinaries\u001b[64Gagainst\u001b[72GUbuntu\u001b[79G24.04's\u001b[87Gglibc\u001b[93G2.39\u001b[98Gdirectly,\u001b[108Gbut\u001b[112GI\u001b[114Gcan't\r\u001b[2C\u001b[1B \u001b[5Gconfirm \u001b[14Ghat until the commits are pushed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m needs Do\u001b[29Gker, \u001b[35Go it\u001b[40Gis run \u001b[27;1H\u001b[24;3H\u001b[?25h"]
