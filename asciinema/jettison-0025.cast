[0.080, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m72\u001b[22m lines to \u001b[1m~/projects/manifest/scripts/.stage-dryrun.sh\r\u001b[6C\u001b[1B\u001b[22m\u001b[2m1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env bash\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2 \u001b[22m\u001b[38;2;117;113;94m# Stages the distribution\u001b[35G(docs/st\u001b[44Gge-5-recovery-pla\u001b[62G.md,\u001b[67G\"The runtime distribu\u001b[89Gio\u001b[92G contract\") from a\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3 \u001b[22m\u001b[38;2;117;113;94m# clean checkout, so\u001b[30Gthat its game tree\u001b[49Gnames a\u001b[57Gcomm\u001b[62Gt: the release build,\u001b[84Glinked\u001b[91Gto run\u001b[98Goutside\u001b[106Gits\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m4 \u001b[22m\u001b[38;2;117;113;94m# toolchain (cmake/D\u001b[30Gstribu\u001b[37Gion.cmake) and checked so (ch\u001b[68Gk-distribution.sh), laid out with its\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5 \u001b[22m\u001b[38;2;117;113;94m# content, its BUILD and the licence of every source tree compiled into it, and packed as\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m6 \u001b[22m\u001b[38;2;117;113;94m# manifest-<v\u001b[23Gr\u001b[25Gion>-<game t\u001b[38Gee>-linux-x86_64.tar.gz in the\u001b[69Goutput directory, which it names.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m7 \u001b[22m\u001b[38;2;117;113;94m# stage-bundle.sh [<output directory>], build/bundle by default.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m8 \u001b[22m\u001b[38;2;166;226;46mset\u001b[13G\u001b[39m-euo\u001b[18Gpipefail\r\u001b[6C\u001b[1B\u001b[2m9 \u001b[22m\u001b[38;2;166;226;46mcd\u001b[39m \u001b[38;2;230;219;116m\"\u001b[39m$(dirname \u001b[38;2;230;219;116m\"\u001b[39m$0\u001b[38;2;230;219;116m\"\u001b[39m)\u001b[38;2;230;219;116m/..\"\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;153;153;153m63\r\u001b[10C\u001b[2B\u001b[39m\u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[97C\u001b[4B\u001b[K\r\