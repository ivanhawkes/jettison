[0.134, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[38;2;177;185;249mlibstdc++\u001b[15G\u001b[39mand\u001b[19G\u001b[38;2;177;185;249mlibgcc\u001b[39m's\u001b[28Glicence\u001b[36Gtext\u001b[41Gisn't\u001b[47Gin\u001b[50Gthe\u001b[54Gbundle.\u001b[62GThey\u001b[67Gare\u001b[71Gunder\u001b[77GGCC's\u001b[83GRuntime\u001b[91GLibrary\u001b[99GException,\u001b[110Gwhich\u001b[116GI\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.154, "o", "\u001b[?25l\u001b[H\u001b[3G  statically and load through\u001b[33G\u001b[38;2;177;185;249m/lib64/ld-linux-x86-64.so.2\u001b[61G\u001b[39mwith\u001b[66Gno\u001b[69GRUNPATH.\u001b[78GThe\u001b[82Gthree\u001b[88Gglibc\u001b[94Gsymbols\u001b[102Gnewer\u001b[108Gthan\u001b[113G2.39\u001b[118Gare\r\u001b[2C\u001b[1B \u001b[5Gbound to older versions in \u001b[38;2;177;185;249msource/apps/distribution/GlibcFloor.cpp\u001b[39m.\u001b[73GE\u001b[75Gch binary now needs glibc\u001b[101G2.38\u001b[106Gat most and\r\u001b[4C\u001b[1Bonly glibc's own libra\u001b[28Gies.\u001b[33GA new \u001b[38;2;177;185;249mdistr\u001b[45Gb\u001b[47Gtion\u001b[39m test fails \u001b[65Ge gate if a nixpkgs update brings in\u001b[102Ganything \u001b[112Gewer.\u001b[118G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefaults.\u001b[22m Ev\u001b[19Gy build tree\u001b[32Gis laid out like the bundle (\u001b[38;2;177;185;249mbin/\u001b[39m, \u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m). \u001b[38;2;177;185;249m--content\u001b[39m is now\u001b[K\r\u001b[5C\u001b[1Bptional. The \u001b[20Gor\u001b[23Gd, backups,\u001b[35Gtoken file and TUI transcrip\u001b[64G def\u001b[69Gult to the XDG direc\u001b[90Gories, each\u001b[102Gcreated 0700.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mScripts.\u001b[22m \u001b[38;2;177;185;249mscripts/stage-bundle.sh\u001b[39m writes th\u001b[50Garball with its \u001b[38;2;177;185;249mBUILD\u001b[39m file and the licences of every linked library.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mscripts/test-bundle.sh\u001b[39m runs it \u001b[37Gn the host and in the \u001b[60Gontain\u001b[67Grs. \u001b[38;2;177;185;249mscripts/bundle-smoke.sh\u001b[39m runs the full sequence:\r\u001b[2C\u001b[1B \u001b[5Gstart, validate, issue a token, se\u001b[40Gve, connect the TUI, stop, restore. It also runs as a\u001b[94Gtest on every build t\u001b[116Gee.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mEvidence:\u001b[22m the Manife\u001b[24Gt gate passed with \u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m.\u001b[67GThe tarball\u001b[79Gstaged from \u001b[38;2;177;185;249m0ac13fe\u001b[99G\u001b[39mpassed \u001b[38;2;177;185;249mtest-bundle.sh\r\u001b[2C\u001b[1B\u001b[39mfrom\u001b[8Ga\u001b[10Gread-only\u001b[20Gdirectory\u001b[30Gunder\u001b[36G\u001b[38;2;177;185;249menv -i\u001b[43G\u001b[39mon\u001b[46Gthis\u001b[51Gmachine\u001b[59Gand\u001b[63Gin\u001b[66Gboth\u001b[71Gcontainers,\u001b[83Gwith\u001b[88Gno\u001b[91Gnetwork.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Grelease\u001b[17Gpreset's\u001b[26Gtests\u001b[32Gnow\u001b[36Gneed\u001b[41Ga\u001b[43Gloader\u001b[50Gat\u001b[53G\u001b[38;2;177;185;249m/lib64\u001b[39m,\u001b[61Gwhich\u001b[67Gmeans\u001b[73Gnix-ld\u001b[80Gon\u001b[83GNixOS.\u001b[90GIf\u001b[93Gthe\u001b[97Glaptop\u001b[104Gdoesn't\u001b[112Ghave\r\u001b[2C\u001b[1B  nix-ld, its release\u001b[25Gstage\u001b[31Gwill\u001b[36Gfail.\r\u001b[4C\u001b[1BCI hasn't been checked. It\u001b[32Gshould run\u001b[43Gthe shipped binaries against Ubuntu 24.04's glibc\u001b[93G2.39 directly, bu\u001b[112GI can't\r\u001b[4C\u001b[1Bconfirm\u001b[13Gthat until the comm\u001b[33Gts\u001b[36Gare pushed.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mtest-bundle.sh\u001b[20G\u001b[39mne\u001b[23Gds Docker, so it is\u001b[43Grun\u001b[47Gby han\u001b[55Gand is not in CI.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mlibstdc++\u001b[39m \u001b[16Gnd \u001b[38;2;177;185;249mlibgcc\u001b[39m's\u001b[28Glicence\u001b[36Gtext i\u001b[43Gn't in\u001b[50Gthe\u001b[54Gbundle.\u001b[62GThey\u001b[67Gare\u001b[71Gunder\u001b[77GGCC's\u001b[83GRuntime\u001b[91GLibrary\u001b[99GException,\u001b[110Gwhich\u001b[116GI\r\u001b[2C\u001b[1B \u001b[5Gread as putting no condition\u001b[34Gon\u001b[37Gthe binaries.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.247, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20BThe\u001b[9Gtarball\u001b[17Gis\u001b[20G40\u001b[23GMB\u001b[26Gbecause\u001b[34Geach\u001b[39Gbinary\u001b[46Gkeeps\u001b[52Gits\u001b[56Gdebug\u001b[62Ginformation\u001b[74G(30\u001b[78Gto\u001b[81G32\u001b[84GMB\u001b[87Geach).\u001b[94GI\u001b[96Gleft\u001b[101Gthem\u001b[106Gunstripped\u001b[117Gfor\u001b[27;1H\u001b[24;3H\u001b[?25h"]
