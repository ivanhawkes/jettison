[0.088, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m80\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1m~/projects/manifest/scripts/.stage-dryrun.sh\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 1 \u001b[22m\u001b[38;2;117;113;94m#!/usr/bin/env bash\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m 2 \u001b[22m\u001b[38;2;117;113;94m# Stages the distribution (docs/stage-5-recovery-plan.md, \"The runtime distribution contract\") from a\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m3\u001b[10G\u001b[22m\u001b[38;2;117;113;94m clean checkout, so that its game tree names a commit: the release build, linked to run outside its\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;2;117;113;94mtoolchain (cmake/Distribution.cm\u001b[44Gk\u001b[46G) and ch\u001b[55Gcked so (check-distribution.sh), laid\u001b[93Gout with its\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m\u001b[38;2;117;113;94montent, its BUILD\u001b[30Gand the licence of\u001b[49Gevery\u001b[55Gsource \u001b[63Gree compiled into it, a\u001b[87Gd packed as\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m6\u001b[11G\u001b[22m\u001b[38;2;117;113;94mmanifest-<version>-<game \u001b[37Gree>-linux-x86_64.tar.gz in the output directory, which\u001b[93Git names.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m\u001b[38;2;117;113;94mstag\u001b[16G-bundle.sh [<outpu\u001b[35G dire\u001b[41Gtory>],\u001b[49Gbuild/bundl\u001b[62Gby default.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22m\u001b[38;2;166;226;46mset\u001b[39m -euo pipefail\u001b[K\r\u001b[6C\u001b[1B\u001b[2m9\u001b[9G\u001b[22m\u001b[38;2;166;226;46mcd\u001b[39m \u001b[38;2;230;219;116m\"\u001b[39m$(dirname \u001b[38;2;230;219;116m\"\u001b[39m$0\u001b[38;2;230;219;116m\"\u001b[39m)\u001b[38;2;230;219;116m/..\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +71 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[3