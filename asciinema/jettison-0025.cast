[0.048, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat changed in Manifest\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRelease build is the distribution build.\u001b[22m The four binaries (server, validator, token tool, TUI) link \u001b[38;2;177;185;249mlibstdc++\r\u001b[4C\u001b[1B\u001b[39mstatical\u001b[14Gy and load through \u001b[38;2;177;185;249m/lib64/ld-linux-x86-64.so.2\u001b[39m w\u001b[63Gth no RUNPATH. The th\u001b[86Ge glibc sy\u001b[97Gbols new\u001b[106Gr than 2.39\u001b[118Gare\r\u001b[4C\u001b[1Bbound\u001b[11Gto olde\u001b[19G v\u001b[22Grsions in \u001b[38;2;177;185;249msource/apps/distribution/GlibcFloor.cpp\u001b[39m.\u001b[73GEach\u001b[78Gbinary\u001b[85Gnow\u001b[89Gneeds\u001b[95Gglibc\u001b[101G2.38\u001b[106Gat\u001b[109Gmost\u001b[114Gand\r\u001b[4C\u001b[1Bonly glibc'\u001b[17G \u001b[19Gwn lib\u001b[26Ga\u001b[28Gie\u001b[31G. A n\u001b[37Gw \u001b[38;2;177;185;249mdistribution\u001b[39m t\u001b[55Gt fails the gate if a nixpkgs upda\u001b[90Ge brings\u001b[99Gin\u001b[102Ganything\u001b[111Gnewer.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDefaults.\u001b[22m Every build tree is\u001b[35Glaid out lik\u001b[48G the bundle\u001b[60G(\u001b[38;2;177;185;249mbin/\u001b[39m, \u001b[38;2;177;185;249mshare/manifest/manifest.pack\u001b[39m).\u001b[98G\u001b[38;2;177;185;249m--content\u001b[108G\u001b[39mis\u001b[111Gnow\r\u001b[1B    optional. The world, backups, token file and TUI transcript default to the XDG directories, each created 0700.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripts.\u001b[14G\u001b[22m\u001b[38;2;177;185;249mscripts/stage-bundle.sh\u001b[38G\u001b[39mwrites\u001b[45Gthe\u001b[49Gtarball\u001b[57Gwith\u001b[62Gits\u001b[66G\u001b[38;2;177;185;249mBUILD\u001b[72G\u001b[39mfile\u001b[77Gand\u001b[81Gthe\u001b[85Glicences\u001b[94Gof\u001b[97Gevery\u001b[103Glinked\u001b[110Glibrary.\r\u001b[1B    \u001b[38;2;177;185;249mscripts/test-bundle.sh\u001b[39m runs it on the host and in the containers. \u001b[38;2;177;185;249mscripts/bundle-smoke.sh\u001b[39m runs the full sequence:\r\u001b[4C\u001b[1Bstart, validate, issue a token, serve,\u001b[44Gconnect\u001b[52Gthe\u001b[56GTUI,\u001b[61Gstop,\u001b[67Grestore.\u001b[76GIt\u001b[79Galso\u001b[84Gruns\u001b[89Gas\u001b[92Ga\u001b[94Gtest\u001b[99Gon\u001b[102Gevery\u001b[108Gbuild\u001b[114Gtree.\r\u001b[2C\u001b[2B\u001b[1mEvidence:\u001b[22m the\u001b[17GManifest\u001b[26Ggate\u001b[31Gpassed\u001b[38Gwith\u001b[43G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m.\u001b[67GThe\u001b[71Gtarball\u001b[79Gstaged\u001b[86Gfrom\u001b[91G\u001b[38;2;177;185;249m0ac13fe\u001b[99G\u001b[39mpassed\u001b[106G\u001b[38;2;177;185;249mtest-bundle.sh\r\u001b[2C\u001b[1B\u001b[39mfrom\u001b[8Ga\u001b[10Gread-only\u001b[20Gdirectory\u001b[30Gunder\u001b[36G\u001b[38;2;177;185;249menv -i\u001b[43G\u001b[39mon\u001b[46Gthis\u001b[51Gmachine\u001b[59Gand\u001b[63Gin\u001b[66Gboth\u001b[71Gcontainers,\u001b[83Gwith\u001b[88Gno\u001b[91Gnetwork.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Grelease\u001b[17Gpreset's\u001b[26Gtests\u001b[32Gnow\u001b[36Gneed\u001b[41Ga\u001b[43Gloader\u001b[50Gat\u001b[53G\u001b[38;2;177;185;249m/lib64\u001b[39m,\u001b[61Gwhich\u001b[67Gmeans\u001b[73Gnix-ld\u001b[80Gon\u001b[83GNixOS.\u001b[90GIf\u001b[93Gthe\u001b[97Glaptop\u001b[104Gdoesn't\u001b[112Ghave\r\u001b[1B \u001b[3G  n\u001b[7Gx-ld, its releas\u001b[24G s\u001b[27Gage will fa\u001b[39Gl.\u001b[K\r\u001b[1B  - CI hasn't been checked.\u001b[29GIt\u001b[32Gshould\u001b[39Grun\u001b[43Gthe\u001b[47Gshipped\u001b[55Gbinaries\u001b[64Gagainst\u001b[72GUbuntu\u001b[79G24.04's\u001b[87Gglibc\u001b[93G2.39\u001b[98Gdirectly,\u001b[108Gbut\u001b[112GI\u001b[114Gcan't\r\u001b[4C\u001b[1Bconfirm\u001b[13Gthat\u001b[18Guntil\u001b[24Gthe\u001b[28Gcommits\u001b[36Gare\u001b[40Gpushed.\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249mtest-bundle.sh\u001b[39m needs Docker, so it is run by hand and is\u001b[62Gnot\u001b[66Gin\u001b[69GCI.\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
