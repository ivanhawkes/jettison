[0.033, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Glink\u001b[12Gcheck\u001b[18Gis\u001b[21Gnow\u001b[25Gpart\u001b[30Gof\u001b[33Gthe\u001b[37Ggate,\u001b[43Gand\u001b[47Gthe\u001b[51Gfull\u001b[56Ggate\u001b[61Gpassed\u001b[68Gwith\u001b[73G\u001b[38;2;177;185;249m--werror --asan\u001b[89G\u001b[39min\u001b[92G267\u001b[96Gs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhen it runs:\u001b[22m it's the\u001b[28Gfirst step of \u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m, a\u001b[59Gd\u001b[61Git checks\u001b[71Gevery tracked \u001b[38;2;177;185;249m.md\u001b[39m file with \u001b[38;2;177;185;249mlychee --offline \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249m--include-fragments\u001b[39m. A brok\u001b[33Gn link to a file or heading fails the gate before anything is built.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt runs every time.\u001b[22m The\u001b[29Ggate's skip-if-\u001b[45Glready-passed check ignores \u001b[38;2;177;185;249m.md\u001b[39m files, so\u001b[87Ga docs-only \u001b[100Ghange still skips the\r\u001b[4C\u001b[1Bbuild. Putting the link\u001b[29Gcheck\u001b[35Gbefore\u001b[42Gthat\u001b[47Gskip\u001b[52Gmeans\u001b[58Git\u001b[61Gstill\u001b[67Gruns\u001b[72Gon\u001b[75Gevery\u001b[81Ggate,\u001b[87Gincluding\u001b[97Gdocs-only\u001b[107Gcommits.\u001b[116GIt\r\u001b[2C\u001b[1B \u001b[5Gtakes under a second.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot in the summary table:\u001b[22m for the\u001b[39Gsame\u001b[44Greason,\u001b[52Git\u001b[55Gshows\u001b[61Gas\u001b[64Gits\u001b[68Gown\u001b[72G\u001b[38;2;177;185;249m==> markdown links\u001b[91G\u001b[39mline\u001b[96Gbefore\u001b[103Gthe\u001b[107Gstages\u001b[114Grather\r\u001b[2C\u001b[1B \u001b[5Gthan in\u001b[13Gthe en\u001b[20G-of-gate summ\u001b[34Gry.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[11G\u001b[22mI\u001b[13Gupdated\u001b[21Gthe\u001b[25Gcomment\u001b[33Gat\u001b[36Gthe\u001b[40Gtop\u001b[44Gof\u001b[47G\u001b[38;2;177;185;249mci.sh\u001b[53G\u001b[39mand\u001b[57Gthe\u001b[61Ggate\u001b[66Gsection\u001b[74Gof\u001b[77G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[101G\u001b[39mto\u001b[104Gmatch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BY\u001b[5Gur\u001b[9Ghell had picked up the n\u001b[34Gw \u001b[38;2;177;185;249mdevenv.nix\u001b[39m,\u001b[48Gso\u001b[51Glychee\u001b[58Gcame\u001b[63Gfrom\u001b[68Gthe\u001b[72Gdevenv\u001b[79Genvironment.\u001b[92GCI\u001b[95Ginstalls\u001b[104Gfrom\u001b[109G\u001b[38;2;177;185;249mdevenv.nix\r\u001b[2C\u001b[1B\u001b[39mtoo,\u001b[8Gso\u001b[11Gthe\u001b[15GGitHub\u001b[22Gworkflow\u001b[31Gneeds\u001b[37Gno\u001b[40Gchange.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWaiting\u001b[11Gfor you\u001b[19Gto\u001b[22Gcommit:\u001b[30G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m,\u001b[42G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m,\u001b[57G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249mscripts/record-claude.sh\u001b[39m.\u001b[111GThey're\r\u001b[2C\u001b[1Balready\u001b[11Gstaged.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BT\u001b[6Gre'\u001b[10G \u001b[12G leftover, read-only \u001b[38;2;177;185;249m.git/config.lo\u001b[76Ggit lfs install\u001b[39m warn every time\u001b[108Gthe\u001b[112Gdevenv\u001b[27;1H\u001b[24;3H\u001b[?25h"]
