3;153;153mCTRL-D out of that shell would be very useful.\u001b[39m                                                                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;218;124;92mHatching…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(1m 3s · ↓\u001b[24G637 tokens)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[2mPress up to edit queued messages\u001b[22m\u001b[K\r\u001b[37C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
