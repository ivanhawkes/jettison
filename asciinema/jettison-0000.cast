[0.262, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Glink\u001b[12Gcheck\u001b[18Gis\u001b[21Gnow\u001b[25Gpart\u001b[30Gof\u001b[33Gthe\u001b[37Ggate,\u001b[43Gand\u001b[47Gthe\u001b[51Gfull\u001b[56Ggate\u001b[61Gpassed\u001b[68Gwith\u001b[73G\u001b[38;2;177;185;249m--werror --asan\u001b[89G\u001b[39min\u001b[92G267\u001b[96Gs.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhen it runs:\u001b[19G\u001b[22mit's\u001b[24Gthe\u001b[28Gfirst\u001b[34Gstep\u001b[39Gof\u001b[42G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m,\u001b[57Gand\u001b[61Git\u001b[64Gchecks\u001b[71Gevery\u001b[77Gtracked\u001b[85G\u001b[38;2;177;185;249m.md\u001b[89G\u001b[39mfile\u001b[94Gwith\u001b[99G\u001b[38;2;177;185;249mlychee --offline \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u001b[38;2;177;185;249m--include-fragments\u001b[39m. A\u001b[28Gbroken link to a file or headi\u001b[59Gg\u001b[61Gfails the\u001b[71Ggate before anything is built.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIt runs every time.\u001b[22m The gat\u001b[33G's skip-if-already-passed check ignores \u001b[38;2;177;185;249m.md\u001b[39m files, so a docs-only change\u001b[106Gstill\u001b[112Gskips\u001b[118Gthe\r\u001b[2C\u001b[1B \u001b[5Gbuild. Putting the link\u001b[29Gcheck before th\u001b[45Gt skip means it still runs on every gate,\u001b[87Gincluding do\u001b[100Gs-only commits. It\u001b[K\r\u001b[4C\u001b[1Btakes under a second.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNot in the summary table:\u001b[31G\u001b[22mfor\u001b[35Gthe\u001b[39Gsame\u001b[44Greason,\u001b[52Git\u001b[55Gshows\u001b[61Gas\u001b[64Gits\u001b[68Gown\u001b[72G\u001b[38;2;177;185;249m==> markdown links\u001b[91G\u001b[39mline\u001b[96Gbefore\u001b[103Gthe\u001b[107Gstages\u001b[114Grather\r\u001b[2C\u001b[1B \u001b[5Gthan in the end-of-gate summary.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[22m I\u001b[13Gupdate\u001b[20G the comment \u001b[34Gt the\u001b[40Gtop\u001b[44Gof\u001b[47G\u001b[38;2;177;185;249mci.sh\u001b[53G\u001b[39mand\u001b[57Gthe\u001b[61Ggate\u001b[66Gsection\u001b[74Gof\u001b[77G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[101G\u001b[39mto\u001b[104Gmatch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BYour\u001b[8Gshell\u001b[14Ghad\u001b[18Gpicked\u001b[25Gup\u001b[28Gthe\u001b[32Gnew\u001b[36G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m,\u001b[48Gso\u001b[51Glychee\u001b[58Gcame\u001b[63Gfrom\u001b[68Gthe\u001b[72Gdevenv\u001b[79Genvironment.\u001b[92GCI\u001b[95Ginstalls\u001b[104Gfrom\u001b[109G\u001b[38;2;177;185;249mdevenv.nix\r\u001b[2C\u001b[1B\u001b[39mt\u001b[5Go,\u001b[9Go the GitHub workflow ne\u001b[34Gds no change.\u001b[48G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWaiting\u001b[11Gfor\u001b[15Gyou\u001b[19Gto\u001b[22Gcommit:\u001b[30G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m,\u001b[42G\u001b[38;2;177;185;249mscripts/ci.sh\u001b[39m,\u001b[57G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[81G\u001b[39mand\u001b[85G\u001b[38;2;177;185;249mscripts/record-claude.sh\u001b[39m.\u001b[111GThey're\r\u001b[2C\u001b[1Balready\u001b[11Gstaged.\u001b[19G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThere's\u001b[11Ga\u001b[13Gleftover,\u001b[23Gread-only\u001b[33G\u001b[38;2;177;185;249m.git/config.lock\u001b[50G\u001b[39mfrom\u001b[55G2026-11-18.\u001b[67GIt\u001b[70Gmakes\u001b[76G\u001b[38;2;177;185;249mgit lfs install\u001b[92G\u001b[39mwarn\u001b[97Gevery\u001b[103Gtime\u001b[108Gthe\u001b[112Gdevenv\r\u001b[2C\u001b[1Bs\u001b[6Gll \u001b[10Gt\u001b[12Grts. It looks like it was left behi\u001b[75Gession; delete it with \u001b[38;2;177;185;249m! rm -f \u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
