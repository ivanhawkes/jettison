[0.142, "o", "\u001b[?25l\u001b[H\u001b[3Gand\u001b[7GManifest\u001b[16Gis\u001b[19Gpinned\u001b[26Gto\u001b[29GJettison\u001b[38G\u001b[38;2;177;185;249m14fc23a\u001b[46G\u001b[39mwith\u001b[51Gevery\u001b[57Ghash\u001b[62Gpin\u001b[66Gheld.\u001b[72GBoth\u001b[77Grepos'\u001b[84Gworking\u001b[92Gtrees\u001b[98Gare\u001b[102Gclean.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mNext is Manifest's W12\u001b[22m (order 43 in \u001b[38;2;177;185;249m../manifest/docs/delivery-order.md\u001b[39m):\u001b[76Gcompetitive\u001b[88Gprocurement,\u001b[101Gpartial\u001b[109Gdelivery\u001b[118Gand\r\u001b[1B  payment,\u001b[12Gperformance security,\u001b[34Gand\u001b[38Ga\u001b[40Gregional\u001b[49Gproject\u001b[57Gthat\u001b[62Gonly\u001b[67Ggoes\u001b[72Gahead\u001b[78Gonce\u001b[83Gits\u001b[87Gmaterials\u001b[97Gare\u001b[101Gphysically\r\u001b[2C\u001b[1Bdelivered.\u001b[14GIt\u001b[17Gbuilds\u001b[24Gon\u001b[27Gthe\u001b[31Gtender\u001b[38Gcontract\u001b[47Gfrom\u001b[52GW11\u001b[56Gand\u001b[60Gon\u001b[63GW19's\u001b[69Gpricing,\u001b[78Gboth\u001b[83Gdone.\u001b[89GIt's\u001b[94Gmostly\u001b[101Ggame\u001b[106Grules,\u001b[113Gso\u001b[116Gthe\r\u001b[1B \u001b[3Gengine side is checking whether it needs anything reusable from Jettison. Nothing has\u001b[89Gbeen\u001b[94Gflagged\u001b[102Gyet.\r\u001b[2B  \u001b[1mAfter W12:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW22\u001b[9G\u001b[22m(drives\u001b[17Gbeyond\u001b[24Gthe\u001b[28Gfusion\u001b[35Gtorch):\u001b[43Gneeds\u001b[49GW12\u001b[53Gand\u001b[57Gone\u001b[61GJettison\u001b[70Gprovision,\u001b[81Ga\u001b[83Gcruise\u001b[90Gdrive's\u001b[98Gclearance\u001b[108Gand\u001b[112Ghow\u001b[116Gfar\r\u001b[1B    \u001b[38;2;177;185;249mClearOf\u001b[39m reaches.\u001b[K\r\u001b[1B  - \u001b[1mW13\u001b[22m (multi-region idle governance),\u001b[41Gthen\u001b[46G\u001b[1mW14\u001b[22m,\u001b[51Gwhich\u001b[57Gcloses\u001b[64GStage 4.\r\u001b[2B \u001b[3G\u001b[1mStill open in Jettison's roadmap:\u001b[22m\u001b[K\r\u001b[1B  - \u001b[1mEncryption\u001b[22m of \u001b[38;2;177;185;249mnet\u001b[39m, needed before Manifest\u001b[47Ghosts\u001b[53Goutside\u001b[61Ga\u001b[63Gtrusted\u001b[71Gnetwork.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWho a script commands as under networked play\u001b[22m,\u001b[52Gthe\u001b[56Gtop\u001b[60Gof\u001b[63G\"Carried\u001b[72Gforward\".\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe way in to a pad, done properly.\u001b[41G\u001b[22mIt\u001b[44Gruns\u001b[49Gon\u001b[52Gthe\u001b[56G\u001b[38;2;177;185;249mDocks::FlyInbound\u001b[74G\u001b[39mstopgap\u001b[82Gfor\u001b[86Gnow.\r\u001b[2C\u001b[2BI\u001b[5Gonly\u001b[10Gread\u001b[15Gthe\u001b[19Groadmap\u001b[27Gand\u001b[31Gthe\u001b[35GW12\u001b[39Gsection\u001b[47Gof\u001b[50Gthe\u001b[54Gdelivery\u001b[63Gorder.\u001b[70GI\u001b[72Ghaven't\u001b[80Gread\u001b[85Gthe\u001b[89GW12\u001b[93Gplan\u001b[98Gitself,\u001b[106Gso\u001b[109GI\u001b[111Gcan't\u001b[117Gyet\r\u001b[2C\u001b[1Bsay\u001b[7Gwhether\u001b[15Git\u001b[18Gwill\u001b[23Gneed\u001b[28Gan\u001b[31Gengine\u001b[38Gchange.\r\u001b[22C\u001b[2B\u001b[38;2;153;153;153m758\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
