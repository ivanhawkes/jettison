[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter W12:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mW22\u001b[22m (drives\u001b[17Gbeyond\u001b[24Gthe\u001b[28Gfusion\u001b[35Gtorch):\u001b[43Gneeds\u001b[49GW12\u001b[53Gand\u001b[57Gone\u001b[61GJettison\u001b[70Gprovision,\u001b[81Ga\u001b[83Gcruise\u001b[90Gdrive's\u001b[98Gclearance\u001b[108Gand\u001b[112Ghow\u001b[116Gfar\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mClearOf\u001b[39m r\u001b[15Gach\u001b[19Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW13\u001b[22m (multi-region\u001b[23Gidle\u001b[28Ggovernance),\u001b[41Gthen\u001b[46G\u001b[1mW14\u001b[22m,\u001b[51Gwhich\u001b[57Gcloses\u001b[64GStage 4.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open in Jettison's roadmap:\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
