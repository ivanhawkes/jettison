[0.124, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39m\u001b[1mWhere we are (2026-11-23):\u001b[30G\u001b[22mthe\u001b[34Gspace\u001b[40Gextraction\u001b[51Gis\u001b[54Gfinished.\u001b[64GSpace\u001b[70Gnow\u001b[74Glives\u001b[80Gin\u001b[83GManifest,\u001b[93Gthe\u001b[97Gspace\u001b[103Gsample\u001b[110Gis\u001b[113Ggone,\r\u001b[1B \u001b[3Gand Manifest is pinned to Jetti\u001b[35Gon \u001b[38;2;177;185;249m14fc23a\u001b[39m w\u001b[48Gth\u001b[51Gevery hash pin held. Both repos' working tre\u001b[96Gs are clean.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext is Manifest's W12\u001b[26G\u001b[22m(order\u001b[33G43\u001b[36Gin\u001b[39G\u001b[38;2;177;185;249m../manifest/docs/delivery-order.md\u001b[39m):\u001b[76Gcompetitive\u001b[88Gprocurement,\u001b[101Gpartial\u001b[109Gdelivery\u001b[118Gand\r\u001b[2C\u001b[1Bpayment, performance secu\u001b[29Gity, and a regional project that only goes ahead once its materials are\u001b[102Ghys\u001b[106Gcally\u001b[K\r\u001b[2C\u001b[1Bdelivered. It builds\u001b[24Gon the tender\u001b[38Gcontract from W11 and on W19's pricing,\u001b[78Gboth\u001b[83Gdone. It's mostly\u001b[101Ggame ru\u001b[109Ges,\u001b[113Gso\u001b[116Gthe\r\u001b[2C\u001b[1Beng\u001b[7Gn\u001b[9G side is checking\u001b[27Gw\u001b[30Gth\u001b[33Gr it\u001b[38Gneeds anything reusable from Jett\u001b[72Gso\u001b[75G. Nothing has\u001b[89Gbeen\u001b[94Gflagged yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mAfter W12:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mW22\u001b[22m (drives\u001b[17Gbeyond\u001b[24Gthe\u001b[28Gfusion\u001b[35Gtorch):\u001b[43Gneeds\u001b[49GW12\u001b[53Gand\u001b[57Gone\u001b[61GJettison\u001b[70Gprovision,\u001b[81Ga\u001b[83Gcruise\u001b[90Gdrive's\u001b[98Gclearance\u001b[108Gand\u001b[112Ghow\u001b[116Gfar\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mClearOf\u001b[39m r\u001b[15Gach\u001b[19Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW13\u001b[22m (multi-region\u001b[23Gidle\u001b[28Ggovernance),\u001b[41Gthen\u001b[46G\u001b[1mW14\u001b[22m,\u001b[51Gwhich\u001b[57Gcloses\u001b[64GStage 4.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open in Jettison's roadmap:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEncry\u001b[11Gtion\u001b[22m of \u001b[38;2;177;185;249mnet\u001b[39m, needed before\u001b[38GManifest\u001b[47Ghosts\u001b[53Goutside\u001b[61Ga\u001b[63Gtrusted\u001b[71Gnetwork.\r\u001b[4C\u001b[1B\u001b[1mWho a script commands as under networked play\u001b[22m, the top of\u001b[63G\"Carried forward\".\r\u001b[4C\u001b[1B\u001b[1mT\u001b[7Ge\u001b[9Gway in \u001b[17Go a p\u001b[23Gd, done properly.\u001b[22m It runs on\u001b[56G\u001b[38;2;177;185;249mDocks::FlyInbound\u001b[39m stopgap\u001b[82Gfor\u001b[86Gnow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gonly\u001b[10Gread\u001b[15Gthe\u001b[19Groadmap\u001b[27Gand\u001b[31Gthe\u001b[35GW12\u001b[39Gsection\u001b[47Gof\u001b[50Gthe\u001b[54Gdelivery\u001b[63Gorder.\u001b[70GI\u001b[72Ghaven't\u001b[80Gread\u001b[85Gthe\u001b[89GW12\u001b[93Gplan\u001b[98Gitself,\u001b[106Gso\u001b[109GI\u001b[111Gcan't\u001b[117Gyet\r\u001b[2C\u001b[1Bsay whether\u001b[15Git will need an\u001b[31Gengine change. \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
