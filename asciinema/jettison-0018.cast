[89GIt's\u001b[94Gmostly\u001b[101Ggame\u001b[106Grules,\u001b[113Gso\u001b[116Gthe\r\u001b[2C\u001b[1Bengine side is checking whether it needs\u001b[44Ganythi\u001b[51Gg r\u001b[55Gusable from Jettison. Nothing has been\u001b[94Gflagged\u001b[102Gyet.\r\u001b[2C\u001b[2B\u001b[1mAfter W12:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mW22\u001b[22m (drives beyond the\u001b[28Gfusion tor\u001b[40G): needs\u001b[49GW12\u001b[53Gand\u001b[57Gone\u001b[61GJettison\u001b[70Gprovision,\u001b[81Ga\u001b[83Gcruise\u001b[90Gdrive's\u001b[98Gclearance\u001b[108Gand\u001b[112Ghow\u001b[116Gfar\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mClearOf\u001b[13G\u001b[39mreaches.\r\u001b[1B \u001b[3G- \u001b[1mW13\u001b[22m (multi-region idle governance),\u001b[41Gthen\u001b[46G\u001b[1mW14\u001b[22m,\u001b[51Gwhich\u001b[57Gcloses\u001b[64GStage 4.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
