Gand\u001b[112Ghow\u001b[116Gfar\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mClearOf\u001b[39m r\u001b[15Gach\u001b[19Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mW13\u001b[22m (multi-region\u001b[23Gidle\u001b[28Ggovernance),\u001b[41Gthen\u001b[46G\u001b[1mW14\u001b[22m,\u001b[51Gwhich\u001b[57Gcloses\u001b[64GStage 4.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mStill open in Jettison's roadmap:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mEncry\u001b[11Gtion\u001b[22m of \u001b[38;2;177;185;249mnet\u001b[39m, needed before\u001b[38GManifest\u001b[47Ghosts\u001b[53Goutside\u001b[61Ga\u001b[63Gtrusted\u001b[71Gnetwork.\r\u001b[4C\u001b[1B\u001b[1mWho a script commands as under networked play\u001b[22m, the top of\u001b[63G\"Carried forward\".\r\u001b[4C\u001b[1B\u001b[1mT\u001b[7Ge\u001b[9Gway in \u001b[17Go a p\u001b[23Gd, done properly.\u001b[22m It run\u001b[76Gopgap\u001b[82Gfor\u001b[86Gnow.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
