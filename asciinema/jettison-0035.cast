[0.045, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mGates and merges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest's ful\u001b[20G gate passed in lane B in 21\u001b[49Gminutes, a\u001b[60Gl 63 suites\u001b[72Gincluded.\u001b[82GJettison's\u001b[93Ggate\u001b[98Gpassed\u001b[105Gin\u001b[108Glane\u001b[113GC\u001b[115Gin\u001b[118G323\r\u001b[4C\u001b[1Bs, r\u001b[10Gference f\u001b[20Gam\u001b[23Gs\u001b[29Gsanitised\u001b[39Gtests included.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GBoth\u001b[10G\u001b[38;2;177;185;249mfeature-base\u001b[39m branches are fast-forwarded: J\u001b[54Gttison\u001b[61Gto \u001b[38;2;177;185;249m63ddab0\u001b[39m, Man\u001b[77Gfest\u001b[82Gt\u001b[84G \u001b[38;2;177;185;249m854241e\u001b[39m. Manifest\u001b[103Glane B \u001b[112Gd\u001b[K\r\u001b[4C\u001b[1BJettison lane C are p\u001b[27Grked on \u001b[38;2;177;185;249mfeature-base\u001b[39m again. Nothing is pushed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison's \u001b[38;2;177;185;249mfeature-base\u001b[29G\u001b[39mnow\u001b[33Ghas\u001b[37Gone\u001b[41Gcommit\u001b[48Gthat\u001b[53Gthe\u001b[57GJ02\u001b[61Gto\u001b[64GJ09\u001b[68Gcross-review\u001b[81Gin\u001b[84Glane\u001b[89GB\u001b[91Ghasn't\u001b[98Gseen.\u001b[104GIf\u001b[107Gthat\u001b[112Greview\r\u001b[2C\u001b[1B \u001b[5Gco\u001b[9Grs \u001b[13Gverything up to \u001b[38;2;177;185;249mfeature-base\u001b[39m, it\u001b[47Gn\u001b[49Gxt round will include this commit.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mW22b plan\u001b[22m (Manifest lane C, \u001b[38;2;177;185;249mw22b-plan\u001b[39m, now up\u001b[49Gto date with the new \u001b[38;2;177;185;249mfeature-base\u001b[39m)\r\u001b[2C\u001b[1B-\u001b[5GUpdat\u001b[11Gd for y\u001b[19Gur answers\u001b[30Gso far:\u001b[38G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe out-of-date\u001b[23Ghull and drive\u001b[38Glines\u001b[44Gare\u001b[48Gfixed.\r\u001b[4C\u001b[1B- A gra\u001b[13Gt\u001b[15Gd hull must be one\u001b[34Gthe scenario's game\u001b[54Gmode\u001b[59Glists.\r\u001b[4C\u001b[1B- The pulse\u001b[17Gcarrier and its drive are li\u001b[46Gted in the \u001b[38;2;177;185;249mmanifest\u001b[39m mod\u001b[72Gnly.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GNo\u001b[10Gtitan\u001b[16Gpads.\u001b[22GA\u001b[24Gdry\u001b[28Gdock\u001b[33Gthat\u001b[38Gflies\u001b[44Gto\u001b[47Ga\u001b[49Gparked\u001b[56Gship\u001b[61Gand\u001b[65Gdocks\u001b[71Gwith\u001b[76Git\u001b[79Gis\u001b[82Gsomething\u001b[92GJettison's\u001b[103Gdocks\u001b[109Gcan't\u001b[115Gdo\r\u001b[2C\u001b[1B    yet.\u001b[12GI've noted it as a separate Jettiso\u001b[49Gjob\u001b[53Gout\u001b[57Gide W22b, and a\u001b[73Gdry\u001b[77Gdock with dreadnought pads\u001b[104Galso waits until\r\u001b[6C\u001b[1Ba\u001b[9Ghull\u001b[14Gneeds\u001b[20Gone.\r\u001b[1B \u001b[3G- Five questions are still open. The\u001b[40Gplan's\u001b[47Grecommendation\u001b[62Gis\u001b[65Gin\u001b[68Gbrackets:\r\u001b[4C\u001b[1Ba.\u001b[8GPulse\u001b[14Gunit\u001b[19Gprice\u001b[25G[10\u001b[29Gcredits\u001b[37Ginstead\u001b[45Gof\u001b[48G150;\u001b[53Gat\u001b[56G150\u001b[60Gno\u001b[63Gtrip\u001b[68Gpays\u001b[73Gfor\u001b[77Gitself].\r\u001b[1B    b. Grant prices [400,000 for the freighter, 6,000,000 for the pulse carrier].\u001b[K\r\u001b[4C\u001b[1Bc.\u001b[8GEmergency\u001b[18Goverride\u001b[27G[a\u001b[30Gfine\u001b[35Gof\u001b[38G10\u001b[41Gcredits\u001b[49Ga\u001b[51Gtonne\u001b[57Gfor\u001b[61Geach\u001b[66Gzone,\u001b[72G20\u001b[75Ghealth\u001b[82Gand\u001b[86G40\u001b[89Ghappiness\u001b[99Glost,\u001b[105Gand\u001b[109Gthe\u001b[113GAI\r\u001b[1B \u001b[3G     polity revokes the licence].\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Remove the gunboat. It seems to overlap the corvette and jettison doesn't need overlaps. Then perform the next steps…\u001b[39m \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.565, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gremov\u001b[11Gd the gunbo\u001b[24G,\u001b[26Gr\u001b[28Gn both gates, merged\u001b[49Gthe size-c\u001b[60Gass work into \u001b[38;2;177;185;249mfeature-base\u001b[39m in both r\u001b[97Gpos, and upd\u001b[110Gt\u001b[112Gd the\u001b[118G\u001b[K\r\u001b[2C\u001b[1BW22b\u001b[8Gplan. Th\u001b[18Gpl\u001b[21Gn is still uncommi\u001b[40Gted and needs five\u001b[59Ganswers\u001b[67Gfrom\u001b[72Gyou.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGunboat and titans\u001b[22m (Manifest\u001b[32G\u001b[38;2;177;185;249m854241e\u001b[39m)\u001b[K\r\u001b[4C\u001b[1BThe gunboat is gone from Manifest: its hull, dock hull,\u001b[61Gcruise\u001b[68Gd\u001b[70Give and game-mode entries, and the docs \u001b[111Ghat named\r\u001b[4C\u001b[1Bit. Jettison never had one: its fixtures ar\u001b[49G one vehicle per siz\u001b[71Gcla\u001b[75Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GTitans\u001b[12Gand\u001b[16Garks\u001b[21Gnow\u001b[25Gdock\u001b[30Gwith\u001b[35Gno\u001b[38Gone.\u001b[43GThey\u001b[48Gfly\u001b[52Gto\u001b[55Ga\u001b[57Gcoordinate\u001b[68Gand\u001b[72Gpark,\u001b[78Gand\u001b[82Gthe\u001b[86Gdry\u001b[90Gdock\u001b[95Gdocks\u001b[101Gwith\u001b[106Gthem.\u001b[112GThis\u001b[117Gis\r\u001b[2C\u001b[1B  recorded in decision D-058, and no platform\u001b[49Ggets a titan\u001b[62Gpad.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mGates and merges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest's ful\u001b[20G gate passed in lane B in 21\u001b[49Gminutes, a\u001b[60Gl 63 suites\u001b[72Gincluded.\u001b[82GJettison's\u001b[93Ggate\u001b[98Gpassed\u001b[105Gin\u001b[108Glane\u001b[113GC\u001b[115Gin\u001b[118G323\r\u001b[4C\u001b[1Bs, r\u001b[10Gference f\u001b[20Gam\u001b[23Gs\u001b[29Gsanitised\u001b[39Gtests included.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GBoth\u001b[10G\u001b[38;2;177;185;249mfeature-base\u001b[39m branches are fast-forwarded: J\u001b[54Gttison\u001b[61Gto \u001b[38;2;177;185;249m63ddab0\u001b[39m, Man\u001b[77Gfest\u001b[82Gt\u001b[84G \u001b[38;2;177;185;249m854241e\u001b[39m. Manifest\u001b[103Glane B \u001b[112Gd\u001b[K\r\u001b[4C\u001b[1BJettison lane C are p\u001b[27Grked on \u001b[38;2;177;185;249mfeature-base\u001b[39m again. Nothing is pushed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison's \u001b[38;2;177;185;249mfeature-base\u001b[29G\u001b[39mnow\u001b[33Ghas\u001b[37Gone\u001b[41Gcommit\u001b[48Gthat\u001b[53Gthe\u001b[57GJ02\u001b[61Gto\u001b[64GJ09\u001b[68Gcross-review\u001b[81Gin\u001b[84Glane\u001b[89GB\u001b[91Ghasn't\u001b[98Gseen.\u001b[104GIf\u001b[107Gthat\u001b[112Greview\r\u001b[2C\u001b[1B \u001b[5Gco\u001b[9Grs \u001b[13Gverything up to \u001b[38;2;177;185;249mfeature-base\u001b[39m, it\u001b[47Gn\u001b[49Gxt round will include this commit.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mW22b plan\u001b[22m (Manifest lane C, \u001b[38;2;177;185;249mw22b-plan\u001b[39m, now up\u001b[49Gto date with the new \u001b[38;2;177;185;249mfeature-base\u001b[39m)\r\u001b[2C\u001b[1B-\u001b[5GUpdat\u001b[11Gd for y\u001b[19Gur answers\u001b[30Gso far:\u001b[38G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe out-of-date\u001b[23Ghull and drive\u001b[38Glines\u001b[44Gare\u001b[27;1H\u001b[24;3H\u001b[?25h"]
