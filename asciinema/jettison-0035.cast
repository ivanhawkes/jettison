[5.025, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- Six new pad classes and their fees, at\u001b[44G1.25\u001b[49Gcredits\u001b[57Gper\u001b[61Gm²\u001b[64Gto\u001b[67Gdock\u001b[72Gand\u001b[76Ga\u001b[78Gfifth\u001b[84Gof\u001b[87Gthat\u001b[92Gper\u001b[96Ghour.\r\u001b[4C\u001b[1B21 hull\u001b[13Gtypes, each\u001b[25Gwith a dock hull and a cruise drive:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mMilitary, each on its own class:\u001b[22m shuttle, sk\u001b[52Gff, cutter,\u001b[64Gcorvette,\u001b[74Gfrigate,\u001b[83Gdestroyer,\u001b[94Gcruiser,\u001b[103Gbattlecruiser,\r\u001b[4C\u001b[1B \u001b[7Gbattleship, dreadnought, titan.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGunboat:\u001b[22m military, on \u001b[30Ghe corvette\u001b[42Gberth.\r\u001b[6C\u001b[1B\u001b[1mCivilian, on a berth no smaller than the ship:\u001b[54G\u001b[22msloop\u001b[60Gon\u001b[63Gcutter,\u001b[71Gbrig\u001b[76Gon\u001b[79Gcorvette,\u001b[89Gfreighter\u001b[99Gon\u001b[102Gdestroyer,\u001b[113Ggalleon\r\u001b[4C\u001b[1B \u001b[7Gand hauler on cruiser, barge and carrier on batt\u001b[56Geship,\u001b[63Gs\u001b[65Gpercarrier\u001b[79Gdreadnought, ark on\u001b[99Gtitan.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvery\u001b[12Gul\u001b[15G must\u001b[21Ghave at le\u001b[32Gst one st\u001b[42Gt, so\u001b[48Geach new one ha\u001b[64G a cargo hold I guessed: 0.5% to 5% of the\u001b[107Ghull's\u001b[114Gvolume\r\u001b[2C\u001b[1B \u001b[5Gfor warships, 2% to 25%\u001b[29Gfor merchan\u001b[41G ships.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcompact single-seat\u001b[29Gn\u001b[31Gw\u001b[33Gdocks as\u001b[42Ga shuttle.\u001b[53GThe\u001b[57Glargest\u001b[65Ghold\u001b[70Gallowed\u001b[78Gis\u001b[81Gnow\u001b[85Gthe\u001b[89Gtitan's\u001b[97Gsize.\r\u001b[4C\u001b[1BFive pinned\u001b[17Gworld hashes changed because every station now posts\u001b[70Gfees for \u001b[80Gix more classes.\u001b[97GW\u001b[99Gth those\u001b[108Gfees\u001b[113Gleft\r\u001b[2C\u001b[1B \u001b[5Gout,\u001b