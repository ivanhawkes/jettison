[0.115, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m   \u001b[12G\u001b[22m occupant (`charges`). An\u001b[38GAI operator moves its\u001b[60Gfees with occupancy once a day. [\u001b[38;2;230;219;116mArrears\u001b[39m](glossary.md#\r\u001b[11C\u001b[1Barrears) hold the\u001b[30Gship and, after a grace,\u001b[55Gits cargo\u001b[65Gis sold. See [\u001b[38;2;230;219;116mstations: fees by fee class\u001b[39m](sta\u001b[112Gio\r\u001b[11C\u001b[1Bns.md#fees-by-fee-class).\u001b[38G| Im\u001b[43Glemented (W18; `company`, `travel`, `policy`, `fixture_traffic`) |\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe titan and ark comments\u001b[30Gstill\u001b[36Gsay\u001b[40G\"on\u001b[44Ga\u001b[46Gtitan\u001b[52Gpad\",\u001b[58Gwhich\u001b[64Gnow\u001b[68Gcontradicts\u001b[80Gthe\u001b[84Grule.\u001b[90GFixing\u001b[97Gthat,\u001b[103Grunning\u001b[111Gthe\r\u001b[2C\u001b[1Baffected\u001b[12Gsuites,\u001b[20Gthen\u001b[25Gcommitting.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMemory is fine: 52 GB\u001b[25Gfree.\u001b[31GRunning\u001b[39GManifest's\u001b[50Gfull-width\u001b[61Ggate\u001b[66Gin\u001b[69Glane\u001b[74GB\u001b[76Gnow\u001b[80G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m);\u001b[106GJettison's\u001b[117Gruns\r\u001b[2C\u001b[1Bafter\u001b[9Git.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe Manifest gate passed\u001b[28G(21\u001b[32Gmin).\u001b[38GNow\u001b[42GJettison's\u001b[53Ggate\u001b[58Gin\u001b[61Glane\u001b[66GC.\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWorking…\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;230;149;117mReticulating…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
