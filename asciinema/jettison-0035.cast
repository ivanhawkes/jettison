[0.004, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mTier 1:\u001b[13G\u001b[22mempty.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTier 2:\u001b[13G\u001b[22mJ07,\u001b[18Gphysics:\u001b[27Gshape\u001b[33Goffsets,\u001b[42Gcompound\u001b[51Gshapes,\u001b[59Gcollision\u001b[69Gfiltering,\u001b[80GJolt's\u001b[87Gdebug\u001b[93Grenderer,\u001b[103Gmulti-threading\r\u001b[1B    and tuned capacities. J30: the rendered shell starts its world through \u001b[38;2;177;185;249mHost::Session\u001b[39m.\u001b[K\r\u001b[1B  - \u001b[1mTiers 3–5:\u001b[22m robustness, presentation\u001b[41Gand\u001b[45Gsample\u001b[52Gloose\u001b[58Gends.\u001b[64GNone\u001b[69Gis\u001b[72Gpressing.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSeparate tracks:\u001b[22G\u001b[22mdense\u001b[28Ggeometry\u001b[37Gand\u001b[41Gray\u001b[45Gtracing\u001b[53G(J36–J50)\u001b[63Gand\u001b[67Gcharacters\u001b[78G(J51–J60).\u001b[89GNeither\u001b[97Ghas\u001b[101Ga\u001b[103Gplace\u001b[109Gin\u001b[112Gthe\r\u001b[1B \u001b[3G  schedul\u001b[13G un\u001b[17Gil\u001b[20Gy\u001b[22Gu give it one.\r\u001b[2C\u001b[2B\u001b[1mWhat I'd do next:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mRound 5 of the J02–J09 cross-review.\u001b[43G\u001b[22mA\u001b[45Gnote\u001b[50Gfrom\u001b[55Gan\u001b[58Gearlier\u001b[66Gsession\u001b[74Gsays\u001b[79Git\u001b[82Gwas\u001b[86Gblocked\u001b[94Gby\u001b[97Gthe\u001b[101GCodex\u001b[107Gusage\u001b[113Glimit\r\u001b[2C\u001b[1B \u001b[5G and should be\u001b[20Grun\u001b[24Gwith\u001b[29G\u001b[38;2;177;185;249m--base f3f0056\u001b[39m.\u001b[45GRound\u001b[51G4\u001b[53Gis\u001b[56Gthe\u001b[60Glast\u001b[65Gone\u001b[69Gcommitted\u001b[79G(\u001b[38;2;177;185;249m0b9779d\u001b[39m).\u001b[90GThat's\u001b[97Gmore\u001b[102Gthan\u001b[107Gthe\u001b[111Gdefault\r\u001b[2C\u001b[1B \u001b[5G three rounds, so you\u001b[27Gdecide whether\u001b[42Gr\u001b[44Gund 5 still runs or whether you settle what's open.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mJ30 as the next delivery.\u001b[32G\u001b[22mManif\u001b[38Gst's graphical client (its L15) is t\u001b[75Ge first program\u001b[91Gthat\u001b[96Gneeds\u001b[102Git.\u001b[106GIt\u001b[109Galso\u001b[114Gremoves\r\u001b[2C\u001b[1B \u001b[5G the doubled start-up cod\u001b[31G that ca\u001b[41Gdrift a\u001b[49Gart, and\u001b[58Git gets more exp\u001b[75Gn\u001b[78Gve the\u001b[85Glonger\u001b[92Ga\u001b[94Ggame\u001b[99Gbuilds\u001b[106Gits\u001b[110Gown\r\u001b[2C\u001b[1B \u001b[5G workaround. J07\u001b[22Gis \u001b[27Gveral smaller\u001b[41Gitems, and none of them has \u001b[70G user waiting.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor\u001b[7Gmodel\u001b[13Gchoice:\u001b[21GJ30\u001b[25Gchanges\u001b[33Gthe\u001b[37Gboundary\u001b[46Gbetween\u001b[54Gthe\u001b[58Ghost\u001b[63Gand\u001b[67Gthe\u001b[71Gapp\u001b[75Gshell,\u001b[82Gso\u001b[85GI'd\u001b[89Guse\u001b[93GOpus\u001b[98Gat\u001b[101Ghigh\u001b[106Geffort.\u001b[114GA\r\u001b[2C\u001b[1Bcheaper model risks\u001b[23Ga\u001b[25Gsplit\u001b[31Gthat\u001b[36Glater\u001b[42Gwork\u001b[47Ghas\u001b[51Gto\u001b[54Gundo.\u001b[60GThe\u001b[64Gground\u001b[71Gsample's\u001b[80Gand\u001b[84Grender\u001b[91Gtest's\u001b[98Gstart-up\u001b[107Gchanges\u001b[115Gcould\r\u001b[2C\u001b[1Bgo\u001b[6Gto\u001b[9GSonnet\u001b[16Gonce\u001b[21Gthe\u001b[25Gdesign\u001b[32Gis\u001b[35Gfixed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhich do you want: round 5, J30, or somethin\u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
