[0.004, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GFive world hashes\u001b[23Gmoved.\u001b[30GWith the\u001b[39Gnew\u001b[43Gclasses'\u001b[52Gfees\u001b[57Gleft\u001b[62Gout,\u001b[67Gall\u001b[71Gfive\u001b[76Gmatched\u001b[84Gtheir\u001b[90Gold\u001b[94Gpins,\u001b[100Gso\u001b[103Gthe\u001b[107Gonly\u001b[112Gchange\u001b[119Gis\r\u001b[2C\u001b[1B \u001b[5Gsix\u001b[9Gm\u001b[11Gre fee rows per venue. They're re-pinn\u001b[50Gd.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gfull Manifest test\u001b[28Grun\u001b[32Gis\u001b[35Ggoing\u001b[41Gnow,\u001b[46Gafter\u001b[52Gone\u001b[56Gmore\u001b[61Gfee-check\u001b[71Gtest\u001b[76Gfix.\r\u001b[4C\u001b[1BStill to \u001b[15Go: t\u001b[21G docs (D-058,\u001b[39Gglossary, \u001b[50Gtations, the ships plan),\u001b[76Gtidy and the c\u001b[91Gmmit.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Hull and drive filter in Manifest\u001b[22m (lane\u001b[46GB, sec\u001b[54Gd\u001b[56Gc\u001b[58Gmmit, not started)\u001b[K\r\u001b[4C\u001b[1BYour new\u001b[14Grequest. The\u001b[27Gplan is\u001b[36Go add \u001b[38;2;177;185;249mhulls\u001b[39m and \u001b[38;2;177;185;249mdrives\u001b[59G\u001b[39mselect\u001b[66Gons to \u001b[38;2;177;185;249mManifest.GameMode\u001b[39m, l\u001b[94Gke\u001b[97Gits\u001b[101G\u001b[38;2;177;185;249mitems\u001b[107G\u001b[39mand\u001b[111G\u001b[38;2;177;185;249mskills\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5GContent\u001b[13Gchecks\u001b[20Gwill\u001b[25Grequire\u001b[33Gevery\u001b[39Gscenario's\u001b[50Gstarter\u001b[58Ghull,\u001b[64Gand\u001b[68Gevery\u001b[74Gselected\u001b[83Ghull's\u001b[90Gdrive,\u001b[97Gto\u001b[100Gbe\u001b[103Gin\u001b[106Gthe\u001b[110Gselection.\r\u001b[2C\u001b[1B  A UI lists only what's selected.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. W22b planning\u001b[20G\u001b[22m(Manif\u001b[27Gst lan\u001b[34G C, branch \u001b[38;2;177;185;249mw22b-plan\u001b[39m, docs only, not committed)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe draf\u001b[14G is done: proposals in \u001b[38;2;177;185;249mdocs/ships-plan.md\u001b[39m,\u001b[57Ga\u001b[59Gpointer\u001b[67Gin\u001b[70G\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m,\u001b[89Gand\u001b[93Gsix\u001b[97Gsub-steps,\u001b[108GW22b1\u001b[114Gto\r\u001b[4C\u001b[1BW22b6.\r\u001b[2C\u001b[1B- It leaves six quest\u001b[25Gon\u001b[28G for you:\u001b[38Gthe pulse unit price (it recommends cu\u001b[78Ging\u001b[82Git\u001b[85Gto\u001b[88G10\u001b[91Gcredits),\u001b[101Gthe\u001b[105Gdry\u001b[109Gdock\u001b[114Gsizes,\r\u001b[2C\u001b[1B \u001b[5Gt\u001b[9Gg\u001b[12Gn\u001b[15Gprices, the override numbers, the licence\u001b[57Gfee, and where the dry dock sits.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt will\u001b[13Gneed\u001b[18Ga\u001b[20Gsmall\u001b[26Gupdate\u001b[33Gfor\u001b[37Gthe\u001b[41Gfilter\u001b[48G(a\u001b[51Ggrant's\u001b[59Ghull\u001b[64Gmust\u001b[69Gbe\u001b[72Gin\u001b[75Gthe\u001b[79Gmode's\u001b[86Gselection).\r\u001b[6C\u001b[1Bs cros\u001b[14G-review on Sol\u001b[29G6.1\u001b[33Ghigh\u001b[38Gcomes after you've answered the questions.\u001b[K\r\u001b[7B❯ \u001b[27;1H\u001b[24;4H\u001b[?25h"]
