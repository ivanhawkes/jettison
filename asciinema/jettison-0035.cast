[0.072, "o", "\u001b[?25l\u001b[H  \u001b[1m2. Size classes in Manifest\u001b[22m (lane B, branch \u001b[38;2;177;185;249msize-classes\u001b[39m, not committed)\u001b[K\r\u001b[1B  - Six new pad classes with fees, and 21 hulls: 12 military, Gunboat among them, and 9 civilian. Each hull comes with\u001b[K\r\u001b[4C\u001b[1Bits\u001b[9Gdock\u001b[14Ghull\u001b[19Gand\u001b[23Gcruise\u001b[30Gdrive.\r\u001b[1B \u001b[3G- The compact single-sea\u001b[28G moved to\u001b[38G\u001b[38;2;177;185;249mshuttle\u001b[39m, the hold limit rose to the titan's\u001b[82Genvelope, and the old sample names are\r\u001b[2C\u001b[1B  out of the comm\u001b[21Gnts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFive\u001b[10Gworld\u001b[16Ghashes\u001b[23Gmoved.\u001b[30GWith\u001b[35Gthe\u001b[39Gnew\u001b[43Gclasses'\u001b[52Gfees\u001b[57Gleft\u001b[62Gout,\u001b[67Gall\u001b[71Gfive\u001b[76Gmatched\u001b[84Gtheir\u001b[90Gold\u001b[94Gpins,\u001b[100Gso\u001b[103Gthe\u001b[107Gonly\u001b[112Gchange\u001b[119Gis\r\u001b[2C\u001b[1B  six more fee rows per\u001b[27Gvenue.\u001b[34GThey're\u001b[42Gre-pinned.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gfull\u001b[14GManifest\u001b[23Gtest\u001b[28Grun\u001b[32Gis\u001b[35Ggoing\u001b[41Gnow,\u001b[46Gafter\u001b[52Gone\u001b[56Gmore\u001b[61Gfee-check\u001b[71Gtest\u001b[76Gfix.\r\u001b[1B \u001b[3G- Still to\u001b[14Gdo: the\u001b[22Gdo\u001b[25Gs\u001b[27G(D-058, the\u001b[39Gglos\u001b[44Gary, stations, the ships p\u001b[71Gan), tidy and th\u001b[88G commit.\u001b[97G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Hull and drive filter in Manifest\u001b[40G\u001b[22m(lane\u001b[46GB,\u001b[49Gsecond\u001b[56Gcommit,\u001b[64Gnot\u001b[68Gstarted)\r\u001b[1B \u001b[3G- Your new request.\u001b[23GThe plan \u001b[33Gs to add \u001b[38;2;177;185;249mhulls\u001b[39m and\u001b[52G\u001b[38;2;177;185;249mdrives\u001b[59G\u001b[39mselections\u001b[70Gto\u001b[73G\u001b[38;2;177;185;249mManifest.GameMode\u001b[39m,\u001b[92Glike\u001b[97Gits\u001b[101G\u001b[38;2;177;185;249mitems\u001b[107G\u001b[39mand\u001b[111G\u001b[38;2;177;185;249mskills\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5GContent\u001b[13Gchecks\u001b[20Gwill\u001b[25Grequire\u001b[33Gevery\u001b[39Gscenario's\u001b[50Gstarter\u001b[58Ghull,\u001b[64Gand\u001b[68Gevery\u001b[74Gselected\u001b[83Ghull's\u001b[90Gdrive,\u001b[97Gto\u001b[100Gbe\u001b[103Gin\u001b[106Gthe\u001b[110Gselection.\r\u001b[1B \u001b[3G  A\u001b[7GUI lists only what's s\u001b[30Glected.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. W22b planning\u001b[20G\u001b[22m(Manifest\u001b[30Glane\u001b[35GC,\u001b[38Gbranch\u001b[45G\u001b[38;2;177;185;249mw22b-plan\u001b[39m,\u001b[56Gdocs\u001b[61Gonly,\u001b[67Gnot\u001b[71Gcommitted)\r\u001b[2C\u001b[1B- The draft is done: proposals in \u001b[38;2;177;185;249mdocs/ships-plan.md\u001b[39m,\u001b[57Ga\u001b[59Gpointer\u001b[67Gin\u001b[70G\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m,\u001b[89Gand\u001b[93Gsix\u001b[97Gsub-steps,\u001b[108GW22b1\u001b[114Gto\r\u001b[4C\u001b[1BW22b6.\r\u001b[1B  - It leaves six questions for you: the pulse unit price (it recommends cutting it to 10 credits), the dry dock sizes,\u001b[K\r\u001b[4C\u001b[1Bthe\u001b[9Ggrant\u001b[15Gprices,\u001b[23Gthe\u001b[27Goverride\u001b[36Gnumbers,\u001b[45Gthe\u001b[49Glicence\u001b[57Gfee,\u001b[62Gand\u001b[66Gwhere\u001b[72Gthe\u001b[76Gdry\u001b[80Gdock\u001b[85Gsits.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
