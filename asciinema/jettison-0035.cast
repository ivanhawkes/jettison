[0.061, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G1\u001b[12G\u001b[22m  \u001b[38;2;117;113;94m// ship is a few kilometres off a station or a gate and clear of a planet's air; and no nearer a\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m2\u001b[9G2\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// body with gravity than where it pulls at kArrivalGravity. A station's or a gate's frame falls\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 213 \u001b[22m   \u001b[38;2;117;113;94m// round its planet with the ship, but a planet's own pull is the ship's to hold against: at 1.25\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m214\u001b[12G\u001b[38;2;248;248;242m  // radii Corva pulls at 16.6 m/s², past a \u001b[48;2;92;2;0mshuttle\u001b[48;2;61;1;0m's 15 m/s² of reverse thrust, wher\u001b[98G a fif\u001b[105Ge\u001b[107Gnth of \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 214 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// radii Corva pulls at 16.6 m/s², past a \u001b[48;2;4;71;0mskiff\u001b[48;2;2;40;0m's 15 m/s² of reverse thrust, where a fifteenth of\u001b[38;2;248;248;242m   \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 215 \u001b[22m   \u001b[38;2;117;113;94m// that leaves its assist all it needs (Ostra's is 20,000 km out, Corva's 356,000 km).\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 216 \u001b[22m   \u001b[38;2;166;226;46mstatic\u001b[39m \u001b[38;2;166;226;46mconstexpr\u001b[39m \u001b[38;2;166;226;46mdouble\u001b[39m kArrivalStandoff = \u001b[38;2;190;132;255m4000.0\u001b[39m;\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 217 \u001b[22m   \u001b[38;2;166;226;46mstatic\u001b[39m \u001b[38;2;166;226;46mconstexpr\u001b[39m \u001b[38;2;166;226;46mdouble\u001b[39m kArrivalRadiusShare = \u001b[38;2;190;132;255m1.25\u001b[39m;\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;107;128m●