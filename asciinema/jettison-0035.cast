\u001b[50G\u001b[39mand\u001b[54Gits\u001b[58Gplace\u001b[64Gin\u001b[67Gthe\u001b[71Gqueue\u001b[77Gin\u001b[80G\u001b[38;2;177;185;249mdocs/delivery-order.md\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison:\u001b[15G\u001b[22m\u001b[38;2;177;185;249mfeature-base\u001b[28G\u001b[39mis\u001b[31Gat\u001b[34G\u001b[38;2;177;185;249m63ddab0\u001b[39m,\u001b[43Glevel\u001b[49Gwith\u001b[54Gorigin.\r\u001b[4C\u001b[1B\u001b[1mRev\u001b[9Gew files:\u001b[22m git ignore\u001b[31G\u001b[38;2;177;185;249mbuild/reviews/w22b-plan/\u001b[39m \u001b[57Gn Manif\u001b[65Gst lane C,\u001b[76Gso\u001b[79Gthose files stay on disk but aren't\u001b[K\r\u001b[4C\u001b[1Bcommitted. They hold\u001b[26Grounds 1–6 with my replies and the r\u001b[63Gv\u001b[65Gewer's scratch\u001b[80Gscripts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat a fresh sess\u001b[21Gon needs to know is in the docs. The F13 fix (the fuel\u001b[77Gaved at\u001b[85Gdeparture)\u001b[96Ghas had\u001b[104Gno review.\u001b[115GThe\r\u001b[2C\u001b[1Bnext task is\u001b[16GW22b1, as\u001b[26Gset out in\u001b[37Gthe plan's st\u001b[51Gps table.\u001b[61G\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 5s · done 8:13 am\u001b[33G\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
