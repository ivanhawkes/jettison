[0.018, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gmove with the planet gets caught by it.\u001b[K\r\u001b[4C\u001b[1B- My\u001b[10Ground-2 fix made the\u001b[31Gship move\u001b[41Gwith\u001b[46Gthe\u001b[50Gplanets\u001b[58Gnear\u001b[63Geach\u001b[68Gend\u001b[72Gof\u001b[75Gthe\u001b[79Gtrip.\u001b[85GThe\u001b[89Greviewer\u001b[98Gshowed\u001b[105Git\u001b[108Gisn't\u001b[114Genough:\r\u001b[4C\u001b[1B \u001b[7Ga ship leaving\u001b[22Gat a\u001b[27G0.2% thrust share drifts back i\u001b[59Gto a station's zon\u001b[79Gwh\u001b[82Gle\u001b[85Gstill thrusting, abou\u001b[108G4 hours in.\u001b[K\r\u001b[6C\u001b[1BTheir scripts are\u001b[25Gin \u001b[38;2;177;185;249mbuild/reviews/w22b-plan/scratch/\u001b[39m.\u001b[62G\u001b[K\r\u001b[4C\u001b[1B-\u001b[10G fix now in the plan checks each trip before it starts\u001b[65Ginstead\u001b[73Gof\u001b[76Gtrusting\u001b[85Gthe\u001b[89Ggeometry.\u001b[99GIf\u001b[102Gthe\u001b[106Gdrive\u001b[112Gwould\r\u001b[4C\u001b[1B \u001b[7Gfire \u001b[13Gnside\u001b[19Ga zon\u001b[25G, travel lengthens that \u001b[50Gnd's\u001b[55Gcro\u001b[59Gsing and pl\u001b[71Gns again, up to 4\u001b[89Gtimes, then refuses the trip.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9.\u001b[22m Pulse units\u001b[21Gf\u001b[23Gr the magazine now go straight from the w\u001b[65Grehouse into it, so a\u001b[87Gfull hold ca\u001b[100G't block\u001b[109Ga refuel\u001b[119GA\r\u001b[2C\u001b[1B \u001b[5Gside eff\u001b[14Gct \u001b[18Gs that\u001b[29Gstarter hull's refuel changes\u001b[60Goo, so s\u001b[69Gme p\u001b[75Gned \u001b[80Gest h\u001b[86Gshes wil\u001b[95G move.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecision for you:\u001b[21G\u001b[22mshould\u001b[28GI\u001b[30Grun\u001b[34Ga\u001b[36Gfourth\u001b[43Greview\u001b[50Ground\u001b[56Gon\u001b[59Gthe\u001b[63GF3\u001b[66Gand\u001b[70GF9\u001b[73Gfixes,\u001b[80Gor\u001b[83Gdo\u001b[86Gyou\u001b[90Gaccept\u001b[97Gthem\u001b[102Gas\u001b[105Gwritten?\u001b[114GThe\u001b[118GF3\r\