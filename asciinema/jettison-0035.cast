[0.737, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mJettison, lane C, \u001b[38;2;177;185;249m63ddab0\u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe dock test fixtures now have eleven berth cl\u001b[53Gsses and one vehicle per class, named only\u001b[96Gby size (shuttle\u001b[113Gto\r\u001b[2C\u001b[1B \u001b[5Gtitan). Nothing in them says military or c\u001b[48Gvili\u001b[53Gn;\u001b[56G\u001b[38;2;177;185;249mfighter\u001b[65Gtransport\u001b[39m, \u001b[38;2;177;185;249mheavy-transport\u001b[39m an\u001b[96G\u001b[38;2;177;185;249mliner\u001b[39m are gone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe do\u001b[12Gk suite\u001b[20Gpasses.\u001b[28GOne pinned\u001b[39Gdeterminis\u001b[50G hash ch\u001b[59Gnged,\u001b[65Gand I re-pinned it. It changed because the saved\u001b[114Gvehicle\r\u001b[4C\u001b[1Bnames\u001b[11Gch\u001b[15Gged, nothing\u001b[28Gelse:\u001b[34Gwith\u001b[39Gthe\u001b[43Gold\u001b[47Gnames\u001b[53Gput\u001b[57Gback\u001b[62Git\u001b[65Ghashed\u001b[72Gas\u001b[75Gbefore,\u001b[83Gand\u001b[87Gthe\u001b[91Gapproach\u001b[100Gtimes\u001b[106Gare\u001b[110Gthe\u001b[114Gsame\r\u001b[4C\u001b[1B(86.7\u001b[11Gs\u001b[13Gand\u001b[17G29.8\u001b[22Gs).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest, lane B, \u001b[38;2;177;185;249ma14d3c2\u001b[39m (size classes)\u001b[44G\u001b[22m\u001b[K\r\u001b[4C\u001b[1BSix new\u001b[13Gpad classes\u001b[25Gand their fees, at 1.25 credits per m²\u001b[64Gto\u001b[67Gdock\u001b[72Gand\u001b[76Ga\u001b[78Gfifth\u001b[84Gof\u001b[87Gthat\u001b[92Gper\u001b[96Ghour.\r\u001b[2C\u001b[1B-\u001b[5G21 hull types, each with a dock hull and a cru\u001b[52Gse drive:\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mMilitary, each on its own class:\u001b[40G\u001b[22mshuttle,\u001b[49Gskiff,\u001b[56Gcutter,\u001b[64Gcorvette,\u001b[74Gfrigate,\u001b[83Gdestroyer,\u001b[94Gcruiser,\u001b[103Gbattlecruiser,\r\u001b[4C\u001b[1B \u001b[7Gbattleship, dreadnough\u001b[30G, titan.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mGunboat:\u001b[22m military, on the corvette berth.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mCivilian, on a berth no smaller than the ship:\u001b[22m s\u001b[56Goop on\u001b[63Gc\u001b[65Gtter, brig\u001b[79Gcorvette, freighter\u001b[99Gon destroyer,\u001b[113Ggalleon\r\u001b[2C\u001b[1B \u001b[5G  and\u001b[12Gau\u001b[15Ger on\u001b[21Gcruiser, b\u001b[32Grge and c\u001b[42Grrier\u001b[48Gon battleship, \u001b[64Gupercarrier on dreadnought, ark on titan.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvery hull must have at\u001b[29Gleast one s\u001b[41Gat, so each\u001b[53Gnew\u001b[57Gone\u001b[61Ghas\u001b[65Ga\u001b[67Gcargo\u001b[73Ghold\u001b[78GI\u001b[80Gguessed:\u001b[89G0.5%\u001b[94Gto\u001b[97G5%\u001b[100Gof\u001b[103Gthe\u001b[107Ghull's\u001b[114Gvolume\r\u001b[2C\u001b[1B \u001b[5Gfor\u001b[9Gwarships, 2% to 25%\u001b[29Gf\u001b[31Gr\u001b[33Gmerchant\u001b[42Gships.\u001b[K\r\u001b[4C\u001b[1BThe compact\u001b[17Gsingle-seat now docks as a shuttle. The largest hold\u001b[70Gallowed i\u001b[80G now the titan's\u001b[97Gs\u001b[99Gze.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFive\u001b[10Gpinned world \u001b[24Gashes changed because\u001b[46Gevery\u001b[52Gstation\u001b[60Gnow\u001b[64Gposts\u001b[70Gfees\u001b[75Gfor\u001b[79Gsix\u001b[83Gmore\u001b[88Gclasses.\u001b[97GWith\u001b[102Gthose\u001b[108Gfees\u001b[113Gleft\r\u001b[4C\u001b[1Bout,\u001b[10Gall\u001b[14Gfive\u001b[19Gmatched\u001b[27Gtheir\u001b[33Gold\u001b[37Gvalues.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
