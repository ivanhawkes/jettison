[0.093, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m33\u001b[12G\u001b[38;2;248;248;242m**Featur\u001b[22Gd\u001b[24Gc:** [\u001b[38;2;230;219;116mdocks\u001b[38;2;248;248;242m](docks.md#a-covered-berth).                                                   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m34\u001b[12G\u001b[38;2;248;248;242m      \u001b[19G             \u001b[33G          \u001b[44G  \u001b[47G        \u001b[56G     \u001b[62G        \u001b[71G  \u001b[74G  \u001b[77G        \u001b[86G    \u001b[91G     \u001b[97G  \u001b[100G    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 335 \u001b[22m ## Tier 4: presentation, when a scene asks\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 336 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 337 \u001b[22m Each is placed by the first scene or screen that needs it, and changes no data or save on the way.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe three suites touched (ai, dock, script) pass. Running the full gate in lane B next, about 4 minutes.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mNo more testing of the low approaches under a roof. I will test it myself in the GUI and determine the cause and fix.\u001b[39m \r\u001b[5C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gstopped\u001b[16Gthe\u001b[20Glow-approach\u001b[33Gtests;\u001b[40Gthe\u001b[44Ggate\u001b[49Gnow\u001b[53Gonly\u001b[58Gre-runs\u001b[66Gthe\u001b[70Gexisting\u001b[79Gsuites,\u001b[87Gand\u001b[91Gonce\u001b[96Git\u001b[99Gfinishes\u001b[108GI'll\u001b[113Grewrite\r\u001b[2C\u001b[1BJ61 to drop the prescribed suite matrix and leave\u001b[53Gthe\u001b[57Gcause\u001b[63Gand\u001b[67Gfix\u001b[71Gto\u001b[74Gyour\u001b[79GGUI\u001b[83Gtesting.\u001b[38;2;153;153;153m · summary\r\u001b[2B \u001b[3G\u001b[39mRunning cd '/home/ivan/projects/jettison.lane-b' && ./scr…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison.lane-b' && ./scripts/ci.sh --werror --asan --log build/gate.log 2>&1 | tail -30 \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m(58s)\u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;2;153;153;153mthought for 6s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;35H\u001b[?25h"]
