[0.053, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mThis list\u001b[13Gcontains ship types \u001b[34Gnd s\u001b[39Gzes which are not present in the game definitions.\r\u001b[2C\u001b[1BAdd them to the definitions. While most the sizes are military vehicles, the size applies to merchant and civilian \r\u001b[2C\u001b[1Bs\u001b[6Gps a\u001b[11G well. These civilian\u001b[33Gship\u001b[38G should be\u001b[50Gssigned to berth siz\u001b[71Gs from the military list, but given their own \r\u001b[2C\u001b[1Bseparate\u001b[12Gdefinitions:\u001b[39m                                                                                              \r\u001b[2C\u001b[1B                                                                                                                  \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255m- Sloop – small, i\u001b[22Gdependent vessel.\r\u001b[2C\u001b[1B- Gunboat – small, heavily armed vessel.\r\u001b[4C\u001b[1BBrig – smal\u001b[17G to medium vessel with a nautical heritage.\r\u001b[5C\u001b[1Balleon\u001b[15Glarge merchant\u001b[30Go\u001b[32G armed trading vessel.\r\u001b[4C\u001b[1BF\u001b[7Geighter – dedicated cargo transport.\u001b[39m                 \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mH\u001b[7Gu\u001b[10Gr – bulk cargo transport.\u001b[39m                   \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mBarge – slow, h\u001b[21Ggh-capacity\u001b[33Gcargo vessel.\r\u001b[4C\u001b[1BC\u001b[7Grrier – vessel carryi\u001b[29Gg smaller ships.\r\u001b[4C\u001b[1BSupercarrier – exceptionally large carrier.\r\u001b[4C\u001b[1BArk – massive colony or population transport.\r\u001b[2C\u001b[1B\u001b[39m                                             \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mMap all\u001b[11Gthe\u001b[15Ge ships to\u001b[26Ga berth of no\u001b[40Gless than the ship's size so they can land and berth correctly.\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m5s · ↓\u001b[39m \u001b[38;2;153;153;153m265 tokens · though\u001b[42G for 1s)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.014, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255ms\u001b[6Gps a\u001b[11G well. These civilian\u001b[33Gship\u001b[38G should be\u001b[50Gssigned to berth siz\u001b[71Gs from the military list, but given their own \r\u001b[2C\u001b[1Bseparate\u001b[12Gdefinitions:\u001b[39m                                                                                              \r\u001b[2C\u001b[1B                                                                                                                  \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255m- Sloop – small, i\u001b[22Gdependent vessel.\r\u001b[2C\u001b[1B- Gunboat – small, heavily armed vessel.\r\u001b[4C\u001b[1BBrig – smal\u001b[17G to medium vessel with a nautical heritage.\r\u001b[5C\u001b[1Balleon\u001b[15Glarge merchant\u001b[30Go\u001b[32G armed trading vessel.\r\u001b[4C\u001b[1BF\u001b[7Geighter – dedicated cargo transport.\u001b[39m                 \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mH\u001b[7Gu\u001b[10Gr – bulk cargo transport.\u001b[39m                   \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mBarge – slow, h\u001b[21Ggh-capacity\u001b[33Gcargo vessel.\r\u001b[4C\u001b[1BC\u001b[7Grrier – vessel carryi\u001b[29Gg smaller ships.\r\u001b[4C\u001b[1BSupercarrier – exceptionally large carrier.\r\u001b[4C\u001b[1BArk – massive colony or population transport.\r\u001b[2C\u001b[1B\u001b[39m                                             \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mMap all\u001b[11Gthe\u001b[15Ge ships to\u001b[26Ga berth of no\u001b[40Gless than the ship's size so they can land and berth correctly.\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && git status --short | head; git branch --show-current; rg -il \"hull|drive\" --type-add 'y:*.yaml'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m-t y . 