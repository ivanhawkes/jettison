[0.091, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[48;2;55;55;55m                                                                                                                  \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255m- Sloop – small, i\u001b[22Gdependent vessel.\r\u001b[2C\u001b[1B- Gunboat – small, heavily armed vessel.\r\u001b[4C\u001b[1BBrig – smal\u001b[17G to medium vessel with a nautical heritage.\r\u001b[5C\u001b[1Balleon\u001b[15Glarge merchant\u001b[30Go\u001b[32G armed trading vessel.\r\u001b[4C\u001b[1BF\u001b[7Geighter – dedicated cargo transport.\u001b[39m                 \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mH\u001b[7Gu\u001b[10Gr – bulk cargo transport.\u001b[39m                   \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mBarge – slow, h\u001b[21Ggh-capacity\u001b[33Gcargo vessel.\r\u001b[4C\u001b[1BC\u001b[7Grrier – vessel carryi\u001b[29Gg smaller ships.\r\u001b[4C\u001b[1BSupercarrier – exceptionally large carrier.\r\u001b[4C\u001b[1BArk – massive colony or population transport.\r\u001b[2C\u001b[1B\u001b[39m                                             \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mMap all\u001b[11Gthe\u001b[15Ge ships to\u001b[26Ga berth of no\u001b[40Gless than the ship's size so they can land and berth correctly.\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mChecking the historical size-class table before\u001b[51Gchanging\u001b[60Gdata,\u001b[66Gso\u001b[69Gthe\u001b[73Gnew\u001b[77Gpad\u001b[81Gclasses\u001b[89Gget\u001b[93Gconsistent\u001b[104Gdimensions.\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell c\u001b[21Gmmand…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3G\u001b[38;2;233;154;122mSimmering…\u001b[15G\u001b[38;2;153;153;153m44s · ↓\u001b[39m \u001b[38;2;153;153;153m3.6k token\u001b[34G ·