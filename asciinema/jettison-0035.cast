[0.206, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest.lane-c/docs/ships-plan.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m6\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 154 \u001b[22m totes the magazine's room needs, less the whole totes aboard, then fills the magazine from the hold\u001b[K\r\u001b[7C\u001b[1B\u001b[2m55\u001b[12G\u001b[22mas\u001b[15Git\u001b[18Gdoes\u001b[23Gtoday,\u001b[30Gso\u001b[33Ga\u001b[35Gpartly\u001b[42Gused\u001b[47Gmagazine\u001b[56Gis\u001b[59Gtopped\u001b[66Gup\u001b[69Gfrom\u001b[74Gan\u001b[77Gopened\u001b[84Gtote\u001b[89Gand\u001b[93Gthe\u001b[97Grest\u001b[102Gstays\r\u001b[7C\u001b[1B\u001b[2m56\u001b[12G\u001b[22maboard.\u001b[20GSo that the hold\u001b[37Ghas room for them,\u001b[56Gthe\u001b[60Gpolicy's free hold (`FreeHold`) keeps back the\u001b[107Gtotes\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 157 -\u001b[38;2;248;248;242mthe magazine's next refuel needs before it sizes a cargo. \u001b[48;2;92;2;0mThe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mstarter's\u001b[48;2;61;1;0m \u001b[48;2;92;2;0m12.5\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mkg\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mmagazine \u001b[48;2;61;1;0mstill        \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 158 -\u001b[38;2;248;248;242mtakes one tote.                                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 157 +\u001b[38;2;248;248;242mthe magazine's next refuel needs before it sizes a cargo. \u001b[48;2;4;71;0mCargo\u001b[48;2;2;40;0m \u001b[48;2;4;71;0malready\u001b[48;2;2;40;0m \u001b[48;2;4;71;0maboard\u001