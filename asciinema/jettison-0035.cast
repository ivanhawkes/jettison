[0.062, "o", "\u001b[?25l\u001b[H\u001b[5Ggranted\u001b[13Ghull\u001b[18Gmust\u001b[23Gbe\u001b[26Gin\u001b[29Gthe\u001b[33Gmode's\u001b[40Glist),\u001b[47Gand\u001b[51Gthe\u001b[55Gstale\u001b[61Glines\u001b[67Gin\u001b[70G\u001b[38;2;177;185;249mships-plan.md\u001b[39m:\u001b[85G\"three\u001b[92Ghulls\"\u001b[99Gand\u001b[103Gthe\u001b[107Gold\u001b[111Gseven\u001b[117Gpad\r\u001b[2C\u001b[1B  classes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22mrun\u001b[13Gthe\u001b[17Ggates,\u001b[24GManifest\u001b[33Glane\u001b[38GB\u001b[40Gand\u001b[44Gthen\u001b[49GJettison\u001b[58Glane\u001b[63GC,\u001b[66Gone\u001b[70Gat\u001b[73Ga\u001b[75Gtime.\u001b[81GThen\u001b[86Gfast-forward\u001b[99Gboth\u001b[104Ginto\u001b[109G\u001b[38;2;177;185;249mfeature-base\r\u001b[2C\u001b[1B\u001b[39mand answer the W22b questions. This\u001b[39Gis\u001b[43G good point to \u001b[38;2;177;185;249m/compact\u001b[39m before star\u001b[79Ging W22b.\u001b[89G\u001b[K\r\u001b[2B \u001b[3GI haven't checked that a 1 km titan\u001b[39Gor\u001b[42Gark\u001b[46Gcan\u001b[50Gactually\u001b[59Gfly\u001b[63Gin\u001b[66Gand\u001b[70Gdock;\u001b[76Gnothing\u001b[84Guses\u001b[89Gthem\u001b[94Gyet.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mCrunched for 15m 6s · done 6:29 am\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mRemove the gunboat. It seems to overlap the corvette and jettison doesn't need overlaps. Then perform the next steps \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255myou mentioned. Titan and ark won't dock with other ships, they will fly to a coordinate, park, and then the drydock \u001b[39m  \r\u001b[1B  \u001b[38;2;255;255;255mwill dock with them.\u001b[39m                                                                                                  \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRemoving\u001b[12Gthe\u001b[16Ggunboat\u001b[24Gand\u001b[28Grecording\u001b[38Gthe\u001b[42Gtitan\u001b[48Gand\u001b[52Gark\u001b[56Gdocking\u001b[64Grule\u001b[69Gfirst.\u001b[76GThen\u001b[81Gthe\u001b[85Ggates\u001b[91G(Manifest,\u001b[102Gthen\u001b[107GJettison),\u001b[118Gthe\r\u001b[1B \u001b[3Gfast-forwards, and the W22b\u001b[31Gplan\u001b[36Gupdates.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWriting ~/projects/manifest.lane-b/data/ships/hulls.yaml\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Write(~/projects/manifest.l\u001b[35Ge-b/data/ships/hulls.yaml)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
