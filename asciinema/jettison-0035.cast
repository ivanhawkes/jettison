[0.731, "o", "\u001b[?25l\u001b[H\r\u001b[46C\u001b[19B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m \u001b[5G  \u001b[8G  \u001b[11G     \u001b[17G     \u001b[23G    \u001b[28G  \u001b[31G   \u001b[35G      \u001b[42G  \u001b[45G                               \u001b[77G     \u001b[97G\u001b[38;2;153;153;153mctrl+g to edit in nano\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0035 ─\r\u001b[1B\u001b[39m❯ Remove the gunboat. It seems to overlap the corvette and jettison doesn't need overlaps.\u001b[K\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[3.070, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B21 hull\u001b[13Gtypes, each\u001b[25Gwith a dock hull and a cruise drive:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mMilitary, each on its own class:\u001b[22m shuttle, sk\u001b[52Gff, cutter,\u001b[64Gcorvette,\u001b[74Gfrigate,\u001b[83Gdestroyer,\u001b[94Gcruiser,\u001b[103Gbattlecruiser,\r\u001b[4C\u001b[1B \u001b[7Gbattleship, dreadnought, titan.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGunboat:\u001b[22m military, on \u001b[30Ghe corvette\u001b[42Gberth.\r\u001b[6C\u001b[1B\u001b[1mCivilian, on a berth no smaller than the ship:\u001b[54G\u001b[22msloop\u001b[60Gon\u001b[63Gcutter,\u001b[71Gbrig\u001b[76Gon\u001b[79Gcorvette,\u001b[89Gfreighter\u001b[99Gon\u001b[102Gdestroyer,\u001b[113Ggalleon\r\u001b[4C\u001b[1B \u001b[7Gand hauler on cruiser, barge and carrier on batt\u001b[56Geship,\u001b[63Gs\u001b[65Gpercarrier\u001b[79Gdreadnought, ark on\u001b[99Gtitan.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvery\u001b[12Gul\u001b[15G must\u001b[21Ghave at le\u001b[32Gst one st\u001b[42Gt, so\u001b[48Geach new one ha\u001b[64G a cargo hold I guessed: 0.5% to 5% of the\u001b[107Ghull's\u001b[114Gvolume\r\u001b[2C\u001b[1B \u001b[5Gfor warships, 2% to 25%\u001b[29Gfor merchan\u001b[41G ships.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcompact single-seat\u001b[29Gn\u001b[31Gw\u001b[33Gdocks as\u001b[42Ga shuttle.\u001b[53GThe\u001b[57Glargest\u001b[65Ghold\u001b[70Gallowed\u001b[78Gis\u001b[81Gnow\u001b[85Gthe\u001b[89Gtitan's\u001b[97Gsize.\r\u001b[4C\u001b[1BFive pinned\u001b[17Gworld hashes changed because every station now posts\u001b[70Gfees for \u001b[80Gix more classes.\u001b[97GW\u001b[99Gth those\u001b[108Gfees\u001b[113Gleft\r\u001b[2C\u001b[1B \u001b[5Gout,\u001b[10Gall five matc\u001b[24Ged their old values.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest, lane B, \u001b[38;2;177;185;249m70bc6e3\u001b[39m (the filter)\r\u001b[2C\u001b[1B\u001b[22m- Each game mode now lists which hulls\u001b[42Gand\u001b[46Gdrives\u001b[53Ga\u001b[55Gplayer\u001b[62Gis\u001b[65Gshown,\u001b[72Gthe\u001b[76Gsame\u001b[81Gway\u001b[85Git\u001b[88Galready\u001b[96Glists\u001b[102Ggoods\u001b[108Gand\u001b[112Gskills.\r\u001b[4C\u001b[1BContent is refused\u001b[24Gif a hull or drive in\u001b[46Gthe list\u001b[55Gdoesn't exist, if a list\u001b[80Gd hull's d\u001b[91Give isn'\u001b[100G als\u001b[105G listed, or if\u001b[120Ga\r\u001b[2C\u001b[1B \u001b[5Gscenario \u001b[15Gtarts players\u001b[29Gin a\u001b[34Ghull \u001b[40Gts\u001b[43Gmode doesn't li\u001b[59Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mmanifest\u001b[15G\u001b[39mhows ever\u001b[25Gthing.\u001b[32G\u001b[38;2;177;185;249mastralis\u001b[39m, the short mode, \u001b[59Ghows\u001b[64Gonly\u001b[69Gthe\u001b[73Gtorch\u001b[79Gdrive\u001b[85Gand\u001b[89Gthe\u001b[93Geleven\u001b[100Ghulls\u001b[106Gthat\u001b[111Gfly\u001b[115Git.\r\u001b[4C\u001b[1BThe filter is p\u001b[21Gr game mode, not per\u001b[42Gsc\u001b[45Gnario:\u001b[52Ga scenario that needs a different set uses a mode with that set.\u001b[K\r\u001b[4C\u001b[1BNo UI \u001b[12Gists hulls\u001b[23Gyet,\u001b[28Gs\u001b[30G the filt\u001b[42Gis in\u001b[76G does.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
