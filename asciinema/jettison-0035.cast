[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G   \u001b[2m 420 \u001b[22m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;107;128m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[38;2;255;107;128mError: File has not been read yet. Read it first before writing to it.\u001b[77G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/docs/roadmap.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m20\u001b[15G\u001b[22mlines\r\u001b[6C\u001b[1B\u001b[2m3\u001b[9G2\u001b[12G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m313\u001b[12G\u001b[22m**Feature\u001b[22Gdoc:**\u001b[29G[\u001b[38;2;230;219;116mpersistence\u001b[39m](persistence.md).\r\u001b[5C\u001b[1B\u001b[2m 314 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 315 +\u001b[38;2;248;248;242m<a \u001b[38;2;166;226;46mid\u001b[38;2;248;248;242m=\u001b[38;2;230;219;116m\"j61\"\u001b[38;2;248;248;242m></a>                                                                                      \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 316 +\u001b[38;2;248;248;242m### J61. Flown in under a low cover from any side                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 317 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 318 +\u001b[38;2;248;248;242m**What remains.** A vehicle flown in to a covered berth with the least headroom its class allows      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 319 +\u001b[38;2;248;248;242mlands from any start touching nothing but its berth. It is done when the `dock` suite's long, low     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 320 +\u001b[38;2;248;248;242mvehicle under a low roof (`source/engine/dock/tests/ApproachTests.cpp`) docks so from each start      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 321 +\u001b[38;2;248;248;242mthe J02 to J09 cross-review tried, in the platform's axes: 400 m up over each corner, over the        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 322 +\u001b[38;2;248;248;242mmiddle and 150 m out along +X, and \u001b[76Ge.                                    \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.471, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[2m313\u001b[12G\u001b[22m**Feature\u001b[22Gdoc:**\u001b[29G[\u001b[38;2;230;219;116mpersistence\u001b[39m](persistence.md).\r\u001b[5C\u001b[1B\u001b[2m 314 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 315 +\u001b[38;2;248;248;242m<a \u001b[38;2;166;226;46mid\u001b[38;2;248;248;242m=\u001b[38;2;230;219;116m\"j61\"\u001b[38;2;248;248;242m></a>                                                                                      \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 316 +\u001b[38;2;248;248;242m### J61. Flown in under a low cover from any side                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 317 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 318 +\u001b[38;2;248;248;242m**What remains.** A vehicle flown in to a covered berth with the least headroom its class allows      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 319 +\u001b[38;2;248;248;242mlands from any start touching nothing but its berth. It is done when the `dock` suite's long, low     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 320 +\u001b[38;2;248;248;242mvehicle under a low roof (`source/engine/dock/tests/ApproachTests.cpp`) docks so from each start      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 321 +\u001b[38;2;248;248;242mthe J02 to J09 cross-review tried, in the platform's axes: 400 m up over each corner, over the        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 322 +\u001b[38;2;248;248;242mmiddle and 150 m out along +X, and 20 m up 300 m out on each side.                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 323 +\u001b[38;2;248;248;242m                                 