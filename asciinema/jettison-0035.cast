[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[17B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m❯ /update-config              Change settings: hooks, permissions, environment variables\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /ponytail:ponytail-audit    (ponytail) Quality audit of a whole repo: bugs, security holes, what breaks under real\r\u001b[2C\u001b[1B\u001b[39m \u001b[33G\u001b[38;2;153;153;153mload, risky code without tests, slow paths, and what to delete, merge or split. Ranke…\r\u001b[2C\u001b[1B  /statusline                 Set up the status line\r\u001b[2C\u001b[2B\u001b[39m/\r\u001b[37C\u001b[3B\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
[0.104, "o", "\u001b[?25l\u001b[H\u001b[3G- Six new pad classes with fees, and\u001b[40G21 hulls: 12 military, Gunboat among\u001b[77Gthem,\u001b[83Gand\u001b[87G9\u001b[89Gcivilian.\u001b[99GEach\u001b[104Ghull\u001b[109Gcomes\u001b[115Gwith\r\u001b[2C\u001b[1B \u001b[5Gits\u001b[9Gdock hull \u001b[20Gnd cru\u001b[27Gse\u001b[30Gdrive.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gc\u001b[11Gmpact single-seat moved to\u001b[38G\u001b[38;2;177;185;249mshuttle\u001b[39m,\u001b[47Gthe\u001b[51Ghold\u001b[56Glimit\u001b[62Grose\u001b[67Gto\u001b[70Gthe\u001b[74Gtitan's\u001b[82Genvelope,\u001b[92Gand\u001b[96Gthe\u001b[100Gold\u001b[104Gsample\u001b[111Gnames\u001b[117Gare\r\u001b[2C\u001b[1B \u001b[5Gout\u001b[9Gof the comments.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFive world\u001b[16Ghash\u001b[21Gs moved.\u001b[30GWith\u001b[35Gthe\u001b[39Gnew\u001b[43Gclasses'\u001b[52Gfees\u001b[57Gleft\u001b[62Gout,\u001b[67Gall\u001b[71Gfive\u001b[76Gmatched\u001b[84Gtheir\u001b[90Gold\u001b[94Gpins,\u001b[100Gso\u001b[103Gthe\u001b[107Gonly\u001b[112Gchange\u001b[119Gis\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gx more fee row\u001b[23Gper venue. They'r\u001b[41G re-pinned.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gfull\u001b[14GManifest\u001b[23Gt\u001b[25Gst run is going now, aft\u001b[50Gr one\u001b[56Gmore\u001b[61Gfee-check\u001b[71Gtest\u001b[76Gfix.\r\u001b[4C\u001b[1BStill to\u001b[14Gdo: the doc\u001b[26G (D-058,\u001b[35Gthe \u001b[40Glossary, stations, the ships plan),\u001b[76Gt\u001b[78Gdy\u001b[81Gand\u001b[85Gthe\u001b[89Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Hull and drive filter in Manifest\u001b[40G\u001b[22m(lane\u001b[46GB,\u001b[49Gsecond\u001b[56Gcommit,\u001b[64Gnot\u001b[68Gstarted)\r\u001b[2C\u001b[1B- Your new request. The plan is to add \u001b[38;2;177;185;249mhulls\u001b[39m and \u001b[38;2;177;185;249mdrives\u001b[39m selection\u001b[69G to \u001b[38;2;177;185;249mManifest.GameMode\u001b[39m,\u001b[92Glike\u001b[97Gits\u001b[101G\u001b[38;2;177;185;249mitems\u001b[107G\u001b[39mand\u001b[111G\u001b[38;2;177;185;249mskills\u001b[39m.\r\u001b[4C\u001b[1BC\u001b[7Gnte\u001b[11Gt ch\u001b[16Gcks will require every scenario's starter hul\u001b[62G, and every selected hull's drive,\u001b[97Gto be in the selection.\r\u001b[2C\u001b[1B \u001b[5GA UI lists only what's sel\u001b[32Gcted.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. W22b planning\u001b[20G\u001b[22m(Manifest\u001b[30Glane\u001b[35GC,\u001b[38Gbranch\u001b[45G\u001b[38;2;177;185;249mw22b-plan\u001b[39m,\u001b[56Gdocs\u001b[61Gonly,\u001b[67Gnot\u001b[71Gcommitted)\r\u001b[2C\u001b[1B- The draft is done: proposals in \u001b[38;2;177;185;249mdocs/ships-plan.md\u001b[39m, a poi\u001b[63Gter\u001b[67Gin \u001b[38;2;177;185;249mdelivery-order.md\u001b[39m,\u001b[89Gand\u001b[93Gsix\u001b[97Gsub-steps,\u001b[108GW22b1\u001b[114Gto\r\u001b[2C\u001b[1B \u001b[5GW22b6.\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
