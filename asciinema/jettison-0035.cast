[0.042, "o", "\u001b[?25l\u001b[H\u001b[4G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mhips as\u001b[12Gw\u001b[14Gll. These civilian ships should be assigned to berth sizes from the military list, but given their own \r\u001b[2C\u001b[1Bseparate definitions:\r\u001b[2C\u001b[1B\u001b[39m                                    \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mSloop –\u001b[13Gsmall, ind\u001b[24Gpendent v\u001b[34Gssel.\u001b[39m    \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mGunboat – small, heavily armed vessel.\u001b[39m                 \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mBrig – sma\u001b[16Gl to\u001b[23Gdium vessel with a nautical heritage.\r\u001b[4C\u001b[1BGalleon –\u001b[15Glarge merchant or\u001b[33Ga\u001b[35Gmed t\u001b[41Gading vessel.\r\u001b[4C\u001b[1BFreighter – dedicated carg\u001b[32G \u001b[34Gransport.\r\u001b[4C\u001b[1BH\u001b[7Gul\u001b[10Gr – bulk\u001b[19Gcargo tr\u001b[28Gnsport.\u001b[39m           \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mB\u001b[8Gge –\u001b[13Gslow, high-capacity cargo\u001b[39Gvessel.\r\u001b[4C\u001b[1BCarrier – vessel \u001b[23Garryi\u001b[29Gg sma\u001b[35Gler ships.\u001b[39m   \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mSupercarrier – exceptionally large\u001b[40Gcarrier.\u001b[39m  \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255m- Ark – massive colony or population transport.\r\u001b[2C\u001b[1B\u001b[39m                                                                                                    \r\u001b[1B  \u001b[38;2;255;255;255mMap all these ships to a berth of no less than the ship's size so they can land and berth correctly.\u001b[39m                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m3\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ rg -n --no-heading -i\u001b[30G\"berth|largestV\u001b[46Ghicle\" source/test/content source/sampl\u001b[86Gs\u001b[88G-g\u001b[91G'*.yaml' |\u001b[102Ghead -60; ls \u001b[