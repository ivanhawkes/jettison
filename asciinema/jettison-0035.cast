[1.613, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gnames\u001b[11Gonly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GStill\u001b[11Gto\u001b[14Gdo:\u001b[18Gclang-tidy,\u001b[30Gthe\u001b[34Gformat\u001b[41Gcheck\u001b[47Gand\u001b[51Gthe\u001b[55Gcommit.\u001b[63GThe\u001b[67Ggate\u001b[72Ggoes\u001b[77Gwith\u001b[82Gthe\u001b[86Gnext\u001b[91Gchunk.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Size classes in Manifest\u001b[22m (lane B,\u001b[40Gbranch \u001b[38;2;177;185;249msize-classes\u001b[39m, not committed)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSix\u001b[9Gnew pad cl\u001b[20Gsses w\u001b[27Gth\u001b[30Gfees, and\u001b[40G21\u001b[43Ghulls:\u001b[50G12\u001b[53Gmilitary,\u001b[63GGunboat\u001b[71Gamong\u001b[77Gthem,\u001b[83Gand\u001b[87G9\u001b[89Gcivilian.\u001b[99GEach\u001b[104Ghull\u001b[109Gcomes\u001b[115Gwith\r\u001b[2C\u001b[1B \u001b[5Gits\u001b[9Gd\u001b[11Gck hull and cruise drive.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcompact single-seat\u001b[29Gmoved\u001b[35Gto\u001b[38G\u001b[38;2;177;185;249mshuttle\u001b[39m,\u001b[47Gthe\u001b[51Ghold\u001b[56Glimit\u001b[62Grose\u001b[67Gto\u001b[70Gthe\u001b[74Gtitan's\u001b[82Genvelope,\u001b[92Gand\u001b[96Gthe\u001b[100Gold\u001b[104Gsample\u001b[111Gnames\u001b[117Gare\r\u001b[2C\u001b[1B \u001b[5Gout of the\u001b[16Gcomm\u001b[21Gnts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GF\u001b[7Gve world hashe\u001b[23Gmoved. With the n\u001b[41Gw classes' fees\u001b[57Gleft\u001b[62Gout,\u001b[67Gall\u001b[71Gfive\u001b[76Gmatched\u001b[84Gtheir\u001b[90Gold\u001b[94Gpins,\u001b[100Gso\u001b[103Gthe\u001b[107Gonly\u001b[112Gchange\u001b[119Gis\r\u001b[2C\u001b[1B \u001b[5Gsix\u001b[9Gmore\u001b[14Gfee rows\u001b[23Gp\u001b[25Gr venue. They're re-pinn\u001b[50Gd.\u001b[K\r\u001b[4C\u001b[1BThe full\u001b[14GManifest te\u001b[26Gt run is\u001b[35Ggoin\u001b[40G now, after one more fee-check test\u001b[76Gf\u001b[78Gx.\u001b[81G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GStill\u001b[11Gto\u001b[14Gdo:\u001b[18Gthe\u001b[22Gdocs\u001b[27G(D-058,\u001b[35Gthe\u001b[39Gglossary,\u001b[49Gstations,\u001b[59Gthe\u001b[63Gships\u001b[69Gplan),\u001b[76Gtidy\u001b[81Gand\u001b[85Gthe\u001b[89Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Hull and drive filter in Manifest\u001b[22m (lane B, second commit, not \u001b[69Gtarted)\u001b[K\r\u001b[4C\u001b[1BY\u001b[7Gur \u001b[11Gew r\u001b[16Gquest. The plan is to add \u001b[38;2;177;185;249mhulls\u001b[39m and \u001b[38;2;177;185;249mdrives\u001b[39m se\u001b[62Gections to \u001b[38;2;177;185;249mManifest.GameMode\u001b[39m, like\u001b[97Gits \u001b[38;2;177;185;249mitems\u001b[39m and \u001b[38;2;177;185;249mskills\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GContent checks will requir\u001b[32G every\u001b[39Gscenario's\u001b[50Gstarter\u001b[58Ghull,\u001b[64Gand\u001b[68Gevery\u001b[74Gselected\u001b[83Ghull's\u001b[90Gdrive,\u001b[97Gto\u001b[100Gbe\u001b[103Gin\u001b[106Gthe\u001b[110Gselection.\r\u001b[4C\u001b[1BA\u001b[7GUI\u001b[10Glists\u001b[16Gonly\u001b[21Gwhat's\u001b[28Gselected.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. W22b planning\u001b[22m (Manifest lane C, branch \u001b[38;2;177;185;249mw22b-plan\u001b[39m, docs o\u001b[63Gly,\u001b[67Gnot committed)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe draft\u001b[15Gis\u001b[18Gdone:\u001b[24Gproposals\u001b[34Gin\u001b[37G\u001b[38;2;177;185;249mdocs/ships\u001b[76Gry-order.md\u001b[39m,\u001b[89Gand\u001b[93Gsix\u001b[97Gsub-steps,\u001b[108GW22b1\u001b[114Gto\u001b[27;1H\u001b[24;3H\u001b[?25h"]
