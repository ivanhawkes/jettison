[0.102, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7G\u001b[1mCivilian, on a berth no smaller than the ship:\u001b[54G\u001b[22msloop\u001b[60Gon\u001b[63Gcutter,\u001b[71Gbrig\u001b[76Gon\u001b[79Gcorvette,\u001b[89Gfreighter\u001b[99Gon\u001b[102Gdestroyer,\u001b[113Ggalleon\r\u001b[4C\u001b[1B \u001b[7Gand hauler on c\u001b[23Guiser, barge and carrier on\u001b[51Gbattleship,\u001b[63Gsupercarrier\u001b[76Gon\u001b[79Gdreadnought,\u001b[92Gark\u001b[96Gon\u001b[99Gtitan.\r\u001b[2C\u001b[1B-\u001b[5GEvery hull must have at least one stat, so each new \u001b[58Gne has a cargo hold I guessed:\u001b[89G0.5% to 5% of the hull's vo\u001b[117Gume\r\u001b[4C\u001b[1Bfor warships, 2% to 25% for m\u001b[35Grchant sh\u001b[45Gps.\u001b[K\r\u001b[4C\u001b[1BTh\u001b[8G compact single-se\u001b[29Gnow docks\u001b[39Gas a shuttle.\u001b[53GThe\u001b[57Glargest\u001b[65Ghold allowe\u001b[78Gis now the\u001b[89Gtitan's\u001b[97Gsize.\u001b[103G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFive pinned world hashes changed because every\u001b[52Gstation\u001b[60Gnow\u001b[64Gposts\u001b[70Gfees\u001b[75Gfor\u001b[79Gsix\u001b[83Gmore\u001b[88Gclasses.\u001b[97GWith\u001b[102Gthose\u001b[108Gfees\u001b[113Gleft\r\u001b[2C\u001b[1B \u001b[5Gout, all five matched \u001b[28Gheir\u001b[33Gold values.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest, lane B, \u001b[38;2;177;185;249m70bc6e3\u001b[39m (the filter)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEach\u001b[10Ggame\u001b[15Gmode\u001b[20Gnow\u001b[24Glists\u001b[30Gwhich\u001b[36Ghulls\u001b[42Gand\u001b[46Gdrives\u001b[53Ga\u001b[55Gplayer\u001b[62Gis\u001b[65Gshown,\u001b[72Gthe\u001b[76Gsame\u001b[81Gway\u001b[85Git\u001b[88Galready\u001b[96Glists\u001b[102Ggoods\u001b[108Gand\u001b[112Gskills.\r\u001b[2C\u001b[1B- Content is refused if a hull or drive\u001b[43Gin\u001b[46Gthe\u001b[50Glist\u001b[55Gdoesn't\u001b[63Gexist,\u001b[70Gif\u001b[73Ga\u001b[75Glisted\u001b[82Ghull's\u001b[89Gdrive\u001b[95Gisn't\u