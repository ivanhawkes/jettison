[0.015, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m- Brig – small to medium vessel with a nautical heritage.\r\u001b[4C\u001b[1BGalleon\u001b[13G– large merchant or arm\u001b[37Gd trading vessel.\r\u001b[4C\u001b[1BFreigh\u001b[12Ger\u001b[15G– dedicated cargo transport\r\u001b[4C\u001b[1BHauler\u001b[12G– bu\u001b[17Gk cargo transport.\u001b[39m                         \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mB\u001b[7Grg\u001b[10G –\u001b[13Gslow, high-\u001b[25Gapacity\u001b[33Gcargo\u001b[39Gvessel.\u001b[39m        \r\u001b[4C\u001b[1B\u001b[38;2;255;255;255mCarrier –\u001b[15Gvessel carrying smaller ships.\r\u001b[4C\u001b[1BSupercarrier – excep\u001b[26Gio\u001b[29Gally large carrier.\r\u001b[4C\u001b[1BArk –\u001b[11Gma\u001b[14Gsive\u001b[19Gcolony or popul\u001b[35Gti\u001b[38Gn transport.\r\u001b[2C\u001b[1B\u001b[39m                                          \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mMap all thes\u001b[16G ships to a berth\u001b[34Gof no\u001b[40Gless than the ship's size so they can land and berth correctly.\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mListed \u001b[1m1\u001b[22m directory, ran \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mChecking\u001b[12Gthe\u001b[16Ghistorical\u001b[27Gsize-class\u001b[38Gtable\u001b[44Gbefore\u001b[51Gchanging\u001b[60Gdata,\u001b[66Gso\u001b[69Gthe\u001b[73Gnew\u001b[77Gpad\u001b[81Gclasses\u001b[89Gget\u001b[93Gconsistent\u001b[104Gdimensions.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && awk '/Ship size classes/{f=1} f{print; n++} n>70{exit}' \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mdocs/history/small-trader-and-docking-plan.md; rg -n \"pad-class|fee-class\" -A6 d