[0.008, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m  \u001b[38;2;255;255;255m- Titan         Enormous capital ship\u001b[39m                                                                                 \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;255;255;255mThis list contains ship types and sizes which are not present in the game definitions.\u001b[39m                                \r\u001b[1B  \u001b[38;2;255;255;255mAdd them to the definitions. While most the sizes are military vehicles, the size applies to merchant and civilian \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mships as well. These civilian ships should be assigned to berth sizes from the military list, but given their own \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mseparate definitions:\u001b[39m                                                                                                 \r\u001b[1B                                                                                                                        \r\u001b[1B \u001b[3G\u001b[38;2;255;255;255m- Sloop – small, independent vessel.\r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255m- Gunboat – small, heavily armed vessel.\u001b[39m                                                                              \r\u001b[1B  \u001b[38;2;255;255;255m- Brig – small to medium vessel with a nautical heritage.\u001b[39m                                                             \r\u001b[1B  \u001b[38;2;255;255;255m- Galleon – large merchant or armed trading vessel.\u001b[39m                                                                   \r\u001b[1B  \u001b[38;2;255;255;255m- Freighter – dedicated cargo transport.\u001b[39m                                                                              \r\u001b[1B  \u001b[38;2;255;255;255m- Hauler – bulk cargo transport.\u001b[39m                                                                                      \r\u001b[1B  \u001b[38;2;255;255;255m- Barge – slow, high-capacity cargo vessel.\u001b[39m                                                                           \r\u001b[1B  \u001b[38;2;255;255;255m- Carrier – vessel carrying smaller ships.\u001b[39m                                                                            \r\u001b[1B  \u001b[38;2;255;255;255m- Supercarrier – exceptionally large carrier.\u001b[39m                                                                         \r\u001b[1B  \u001b[38;2;255;255;255m- Ark – massive colony or population transport.\u001b[39m                                                                       \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;255;255;255mMap all these ships to a berth of no less than the ship's size so they can land and berth correctly.\u001b[39m                  \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m·\u001b[3GSimmering\u001b[38;2;235;159;127m…\u001b[38;2;215;119;87m \r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[2C\u001b[3B\u001b[38;2;255;193;7m⏵⏵ auto mode on\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
