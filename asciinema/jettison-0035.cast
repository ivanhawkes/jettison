[0.080, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline\u001b[19Gto\u001b[22G\u001b[1m~/projects/manifest.lane-c/build/reviews/w22b-plan/round-4.before\r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 1 \u001b[22me3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934c\u001b[58G495991b7852b855  -\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound 4 is running against\u001b[30G\u001b[38;2;177;185;249meb81d6c\u001b[39m.\u001b[39GThe\u001b[43Greviewer\u001b[52Gwill\u001b[57Grerun\u001b[63Gits\u001b[67Gscripts\u001b[75Gfrom\u001b[80Ground\u001b[86G3\u001b[88Gagainst\u001b[96Gthe\u001b[100Gnew\u001b[104Gcheck.\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mBackground\u001b[14Gcomma\u001b[20Gd\u001b[22G\"Run the W22b plan cross-revie\u001b[53G, round 4\" completed (exit\u001b[80Gc\u001b[82Gde 0)\u001b[88G\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound 4 closes F3 and F9, and the\u001b[37Greviewer's\u001b[48Gnew\u001b[52Gcheck\u001b[58Gcatches\u001b[66Gthe\u001b[70Gday-460\u001b[78Gcase.\u001b[84GThree\u001b[90Gnew\u001b[94Gmajors\u001b[101Gare\u001b[105Graised\u001b[112G(F10,\r\u001b[2C\u001b[1BF11,\u001b[8GF12),\u001b[14Gand\u001b[18GI'm\u001b[22Gchecking\u001b[31Gthem\u001b[36Gnow.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mF10, F11 and F12 check out\u001b[30Gagainst\u001b[38Gthe\u001b[42Gcode.\u001b[48GI'm\u001b[52Gfixing\u001b[59GF11\u001b[63Gand\u001b[67GF12\u001b[71Gin\u001b[74Gthe\u001b[78Gplan\u001b[83Gnow,\u001b[88Gbut\u001b[92GF10\u001b[96Gneeds\u001b[102Gyour\u001b[107Gcall,\u001b[113Gsince\r\u001b[1B  moving the course with the planets is the wrong model.\u001b[38;2;153;153;153m · summa\u001b[66Gy\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GChoreographing… \u001b[44G\u001b[38;2;153;153;153mthought for 25s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
