;2;40;0m's\u001b[48;2;4;71;0m 1,000 x 250 x 200 m\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[15G\u001b[38;2;117;113;94m(data/docks/pads/titan.yaml): no hold is bigger than its hull. Content and the commands each refuse\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;117;113;94m a\u001b[38;2;248;248;242m    \u001b[19G         \u001b[29G             \u001b[43G             \u001b[57G \u001b[59G          \u001b[70G \u001b[72G             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 122 +\u001b[38;2;117;113;94m// hull over it.\u001b[38;2;248;248;242m                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 123 +\u001b[38;2;249;38;114minline\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mconstexpr\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mstd\u001b[38;2;248;248;242m::\u001b[38;2;166;226;46muint64_t\u001b[38;2;248;248;242m kMaxHoldTotes = \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m50\u001b[48;2;2;40;0m'\u001b[48;2;4;71;0m000\u001b[48;2;2;40;0m'000\u001b[38;2;248;248;242m * kTotesPerIbc;                             \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m4\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 125 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m// The most one owner holds of one item at one venue's warehouse: a hundred of the largest holds.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 126 \u001b[22m \u001b[38;2;117;113;94m// Even in gold's troy ounces, 77,644 to the tote, that many is below 2^53 units.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mEditing ~/projects/manifest.lane-b/source/game/space/include/manifest/space/Cruise.h\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(~/projects/\u001b[25Ganifest.lane-b\u001b[40Gsource/game/s\u001b[54Gace/include/manifest/space/Cruise.h)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
