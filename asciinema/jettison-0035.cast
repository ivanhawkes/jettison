[0.087, "o", "\u001b[?25l\u001b[H\u001b[5Gway is \u001b[13Gdded to the obstacles and\u001b[41Ge course is planned\u001b[61Gagain, up\u001b[71Gto four times,\u001b[86Gthe\u001b[90G \u001b[92Ghe j\u001b[97Gurney is\u001b[106Grefused. The\r\u001b[4C\u001b[1Bpolicy's route estimate uses the sam\u001b[44Gheck.\u001b[50GOption C, a Jettison\u001b[71Gm\u001b[73Gti\u001b[76Gn profile\u001b[86Gw\u001b[89Gre the ship leaves with its\u001b[K\r\u001b[5C\u001b[1Blanet\u001b[14Gvelocity and arrives with the target's, is\u001b[57Grecord\u001b[64Gd under L37 in \u001b[38;2;177;185;249mdelivery-order.md\u001b[39m as th\u001b[103G later replacement\r\u001b[4C\u001b[1Bfor the bl\u001b[16Gnd.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 5 raised two findings, both confirmed fixed by round 6:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[1mF9:\u001b[22m after a partial sale, the unsold cargo is loaded back and\u001b[69Gleaves\u001b[76Gtoo\u001b[80Glittle\u001b[87Ghold\u001b[92Groom\u001b[97Gto\u001b[100Grefuel.\u001b[108GThe\u001b[112Gestimate\r\u001b[4C\u001b[1B \u001b[7Gnow\u001b[11Gcounts only the\u001b[27Gfuel the hold can take.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mF10's hand-off:\u001b[27G\u001b[22mch\u001b[30Gck ran before undocking,\u001b[55Gbut\u001b[59Gthe\u001b[63Gcourse\u001b[70Gis\u001b[73Gplanned\u001b[81Gafter\u001b[87Gclearing\u001b[96Gthe\u001b[100Gstation.\u001b[109GThe\u001b[113Gcheck\r\u001b[4C\u001b[1B \u001b[7Gnow also runs at that point, and th\u001b[44Gcourse it set\u001b[58Gles is the one\u001b[73Gf\u001b[75Gow\u001b[78G and saved.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GR\u001b[9Gund 6 also confirmed tha\u001b[34G the earlier F11\u001b[51Gand F12 fixe\u001b[65Ghold.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 6 raised F13:\u001b[22m th\u001b[28G second check had nothing saved to compare\u001b[71Gits\u001b[75Gfuel\u001b[80Gagainst.\u001b[89GThe\u001b[93Gjourney\u001b[101Gnow\u001b[105Gsaves\u001b[111Gthe\u001b[115Gfuel\r\u001b[2C\u001b[1B \u001b[5Gburnt at departure,\u001b[25Gand\u001b[29Gthe cruis\u001b[39G settles \u001b[50Ge difference\u001b[63Gb\u001b[65Gth ways: a longer course burns th\u001b[99G extra or is r\u001b[114Gfus\u001b[118Gd,\r\u001b[4C\u001b[1Ba shorter one is refu\u001b[28Ged.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything\u001b[14Gup\u001b[17Gto\u001b[20GF13\u001b[24Ghas\u001b[28Gbeen\u001b[33Greviewed.\u001b[43GThe\u001b[47GF13\u001b[51Gfix\u001b[55Gis\u001b[58Gthe\u001b[62Gonly\u001b[67Gtext\u001b[72Gno\u001b[75Ground\u001b[81Ghas\u001b[85Gchecked.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gpush\u001b[12Galso\u001b[17Gcarried\u001b[25Gthree\u001b[31Gearlier\u001b[39Gcommits\u001b[47Gthat\u001b[52Gwere\u001b[57Gmerged\u001b[64Gbut\u001b[68Gnot\u001b[72Gyet\u001b[76Gpushed:\u001b[84Gthe\u001b[88Geleven\u001b[95Gpad\u001b[99Gclasses,\u001b[108Gthe\u001b[112Ggame-mode\r\u001b[2C\u001b[1Bhull filter, and th\u001b[23G gunboat removal.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJettison's\u001b[14G\u001b[38;2;177;185;249mfeature-base\u001b[27G\u001b[39mhas\u001b[31Gtwo\u001b[35Gcommits\u001b[43Gthat\u001b[48Garen't\u001b[55Gpushed:\u001b[63G\u001b[38;2;177;185;249m63ddab0\u001b[71G\u001b[39m(dock\u001b[77Gfixture\u001b[85Gnames)\u001b[92Gand\u001b[96G\u001b[38;2;177;185;249m8e74110\u001b[104G\u001b[39m(J02–J09\u001b[113Ground\r\u001b[2C\u001b[1B5). I left\u001b[14Gthem alone bec\u001b[29Guse they're ou\u001b[44Gside this task, and Manifest doesn't ne\u001b[84Gd th\u001b[89Gm.\u001b[92GIt pins Jettison \u001b[38;2;177;185;249m7a2d936\u001b[39m,\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.103, "o", "\u001b[?25l\u001b[H\u001b[5Gplanet's v\u001b[16Glocity and arriv\u001b[35Gwith the ta\u001b[47Gg\u001b[49Gt'\u001b[52G, is r\u001b[59Gcorded under L37 in\u001b[79G\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m as the lat\u001b[108Gr r\u001b[112Gplacement\r\u001b[4C\u001b[1Bf\u001b[7Gr the blend.\u001b[20G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 5 raised two findings, both confirmed fixed by round 6:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mF9:\u001b[22m after a partial\u001b[27Gsale,\u001b[33Gthe\u001b[37Gunsold\u001b[44Gcargo\u001b[50Gis\u001b[53Gloaded\u001b[60Gback\u001b[65Gand\u001b[69Gleaves\u001b[76Gtoo\u001b[80Glittle\u001b[87Ghold\u001b[92Groom\u001b[97Gto\u001b[100Grefuel.\u001b[108GThe\u001b[112Gestimate\r\u001b[2C\u001b[1B \u001b[5G  now counts only the fuel the hold can take.\u001b[K\r\u001b[7C\u001b[1B\u001b[1m10's hand-off:\u001b[22m the\u001b[27Gcheck\u001b[33Gran\u001b[37Gbef\u001b[41Gre\u001b[44Gundock\u001b[51Gng, but the course is planned af\u001b[84Ger\u001b[87Gclearing the\u001b[100Gstation. The check\u001b[K\r\u001b[10C\u001b[1Balso runs at that point,\u001b[36Gand the course\u001b[51Git\u001b[54Gsettles\u001b[62Gis\u001b[65Gthe\u001b[69Gone\u001b[73Gflown\u001b[79Gand\u001b[83Gsaved.\r\u001b[6C\u001b[1BRound 6 also confirmed that the ea\u001b[42Glier F11 and\u001b[55GF12\u001b[59Gfixes hold.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 6 raised F13:\u001b[22m the\u001b[29Gsecond\u001b[36Gcheck had nothing\u001b[55Gaved to compare its fuel against. The\u001b[93Gjourney\u001b[101Gnow\u001b[105Gsaves\u001b[111Gthe\u001b[115Gfuel\r\u001b[4C\u001b[1Bburnt at departure, and the cruise settles the difference both ways:\u001b[74Ga\u001b[76Glonger\u001b[83Gcourse\u001b[90Gburns\u001b[96Gthe\u001b[100Gextra\u001b[106Gor\u001b[109Gis\u001b[112Grefused,\r\u001b[2C\u001b[1B \u001b[5Ga shorter one is refunded.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything up to F13 has been\u001b[33Greviewed.\u001b[43GThe\u001b[47GF13\u001b[51Gfix\u001b[55Gis\u001b[58Gthe\u001b[62Gonly\u001b[67Gtext\u001b[72Gno\u001b[75Ground\u001b[81Ghas\u001b[85Gchecked.\r\u001b[2C\u001b[2BTh\u001b[6G push also\u001b[17Gcarried thre\u001b[30G ea\u001b[34Glier commits\u001b[47Gthat were merged but no\u001b[72Gyet p\u001b[78Gshed: the el\u001b[91Gven\u001b[95Gpad\u001b[99Gclasses,\u001b[108Gthe\u001b[112Ggame-mode\r\u001b[2C\u001b[1Bhull\u001b[8Gfilter,\u001b[16Gand\u001b[20Gthe\u001b[24Ggunboat\u001b[32Gremoval.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJettison's \u001b[38;2;177;185;249mfeature-base\u001b[39m has two commits\u001b[43Gthat\u001b[48Garen't\u001b[55Gpushed:\u001b[63G\u001b[38;2;177;185;249m63ddab0\u001b[71G\u001b[39m(dock\u001b[77Gfixture\u001b[85Gnames)\u001b[92Gand\u001b[96G\u001b[38;2;177;185;249m8e74110\u001b[104G\u001b[39m(J02–J09\u001b[113Ground\r\u001b[2C\u001b[1B5).\u001b[7GI\u001b[9Gleft\u001b[14Gthem\u001b[19Galone\u001b[25Gbecause\u001b[33Gthey're\u001b[41Goutside\u001b[49Gthis\u001b[54Gtask,\u001b[60Gand\u001b[64GManifest\u001b[73Gdoesn't\u001b[81Gneed\u001b[86Gthem.\u001b[92GIt\u001b[95Gpins\u001b[100GJettison\u001b[109G\u001b[38;2;177;185;249m7a2d936\u001b[39m,\r\u001b[2C\u001b[1Bwhich is already on origin.\u001b[31GSay\u001b[35Gif you want them pushed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.164, "o", "\u001b[?25l\u001b[H\u001b[5G- \u001b[1mF9:\u001b[22m after a partial\u001b[27Gsale, the unsold\u001b[44Gc\u001b[48Go i\u001b[52G loaded back and leaves\u001b[76Gtoo little hold room\u001b[97Gto\u001b[100Grefuel. The estimate\u001b[K\r\u001b[4C\u001b[1B  now counts only\u001b[23Gthe\u001b[27Gfuel\u001b[32Gthe\u001b[36Ghold\u001b[41Gcan\u001b[45Gtake.\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mF10's\u001b[13Gh\u001b[15Gnd-off:\u001b[22m the check ran before undocking, but the course\u001b[70Gis\u001b[73Gplanned\u001b[81Gafter\u001b[87Gclearing\u001b[96Gthe\u001b[100Gstation.\u001b[109GThe\u001b[113Gcheck\r\u001b[4C\u001b[1B \u001b[7Gnow\u001b[12Glso runs a\u001b[23G that poin\u001b[34G, and the\u001b[45Gourse it settles is\u001b[65Gthe\u001b[69Gone flown and saved.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GR\u001b[9Gund 6 als\u001b[19G confirmed that t\u001b[37Ge earlier F11\u001b[51Gand\u001b[55GF12\u001b[59Gfixes\u001b[65Ghold.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 6\u001b[13Gr\u001b[15Gised F13:\u001b[22m the second ch\u001b[39Gck had n\u001b[48Gth\u001b[53G saved to\u001b[65Gmpare its fuel against. The journ\u001b[99Gy now saves the fuel\r\u001b[4C\u001b[1Bburnt\u001b[12Gt departure, and\u001b[29Gthe cruise\u001b[40Gsettles the difference bo\u001b[67G ways: a longer\u001b[83Gcourse\u001b[90Gburns\u001b[96Gthe\u001b[100Gextra\u001b[106Gor\u001b[109Gis\u001b[112Grefused,\r\u001b[4C\u001b[1Ba\u001b[7Gshorter\u001b[15Gone is refunded.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BEverything\u001b[14Gup to F13 h\u001b[26Gs been\u001b[33Grev\u001b[37Gewed. Th\u001b[46G F13 fix is the only text no rou\u001b[79Gd has checked.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gpush\u001b[12Galso\u001b[17Gcarried\u001b[25Gthree\u001b[31Gearlier\u001b[39Gcommits\u001b[47Gthat\u001b[52Gwere\u001b[57Gmerged\u001b[64Gbut\u001b[68Gnot\u001b[72Gyet\u001b[76Gpushed:\u001b[84Gthe\u001b[88Geleven\u001b[95Gpad\u001b[99Gclasses,\u001b[108Gthe\u001b