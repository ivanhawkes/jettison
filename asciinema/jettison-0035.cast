[0.371, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[18B\u001b[1m5. The J02 to J09 cross-review\u001b[22m (Jettison lane B): untouched; that lane stays reserved.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 13m 26s · done 6:08 \u001b[36Gm · 1 background task\u001b[58Gstill running\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[2B\u001b[K\r\u001b[37C\u001b[3B\u001b[38;2;153;153;153m · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[2.659, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gout of the\u001b[16Gcomm\u001b[21Gnts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GF\u001b[7Gve world hashe\u001b[23Gmoved. With the n\u001b[41Gw classes' fees\u001b[57Gleft\u001b[62Gout,\u001b[67Gall\u001b[71Gfive\u001b[76Gmatched\u001b[84Gtheir\u001b[90Gold\u001b[94Gpins,\u001b[100Gso\u001b[103Gthe\u001b[107Gonly\u001b[112Gchange\u001b[119Gis\r\u001b[2C\u001b[1B \u001b[5Gsix\u001b[9Gmore\u001b[14Gfee rows\u001b[23Gp\u001b[25Gr venue. They're re-pinn\u001b[50Gd.\u001b[K\r\u001b[4C\u001b[1BThe full\u001b[14GManifest te\u001b[26Gt run is\u001b[35Ggoin\u001b[40G now, after one more fee-check test\u001b[76Gf\u001b[78Gx.\u001b[81G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GStill\u001b[11Gto\u001b[14Gdo:\u001b[18Gthe\u001b[22Gdocs\u001b[27G(D-058,\u001b[35Gthe\u001b[39Gglossary,\u001b[49Gstations,\u001b[59Gthe\u001b[63Gships\u001b[69Gplan),\u001b[76Gtidy\u001b[81Gand\u001b[85Gthe\u001b[89Gcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Hull and drive filter in Manifest\u001b[22m (lane B, second commit, not \u001b[69Gtarted)\u001b[K\r\u001b[4C\u001b[1BY\u001b[7Gur \u001b[11Gew r\u001b[16Gquest. The plan is to add \u001b[38;2;177;185;249mhulls\u001b[39m and \u001b[38;2;177;185;249mdrives\u001b[39m se\u001b[62Gections to \u001b[38;2;177;185;249mManifest.GameMode\u001b[39m, like\u001b[97Gits \u001b[38;2;177;185;249mitems\u001b[39m and \u001b[38;2;177;185;249mskills\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GContent checks will requir\u001b[32G every\u001b[39Gscenario's\u001b[50Gstarter\u001b[58Ghull,\u001b[64Gand\u001b[68Gevery\u001b[74Gselected\u001b[83Ghull's\u001b[90Gdrive,\u001b[97Gto\u001b[100Gbe\u001b[103Gin\u001b[106Gthe\u001b[110Gselection.\r\u001b[4C\u001b[1BA\u001b[7GUI\u001b[10Glists\u001b[16Gonly\u001b[21Gwhat's\u001b[28Gselected.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. W22b planning\u001b[22m (Manifest lane C, branch \u001b[38;2;177;185;249mw22b-plan\u001b[39m, docs o\u001b[63Gly,\u001b[67Gnot committed)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe draft\u001b[15Gis\u001b[18Gdone:\u001b[24Gproposals\u001b[34Gin\u001b[37G\u001b[38;2;177;185;249mdocs/ships-plan.md\u001b[39m,\u001b[57Ga\u001b[59Gpointer\u001b[67Gin\u001b[70G\u001b[38;2;177;185;249mdelivery-order.md\u001b[39m,\u001b[89Gand\u001b[93Gsix\u001b[97Gsub-steps,\u001b[108GW22b1\u001b[114Gto\r\u001b[2C\u001b[1B \u001b[5GW22b6.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt leaves\u001b[15Gsix ques\u001b[24Gions fo\u001b[32G you: th\u001b[41G pulse un\u001b[51Gt price (it recommends cutting it\u001b[85Gto 10\u001b[91Gcredits),\u001b[101Gthe\u001b[105Gdry\u001b[109Gdock\u001b[114Gsizes,\r\u001b[2C\u001b[1B \u001b[5Gthe grant price\u001b[21G, the override numbers, the licence fee, and wher\u001b[72Gthe dry dock sits.\u001b[K\r\u001b[6C\u001b[1B will need a small update\u001b[33Gfor the filter (a grant's hull must be in the mode's\u001b[86Gselection).\r\u001b[2C\u001b[1B-\u001b[5GIts\u001b[9Gcross-review\u001b[22Gon\u001b[25GSol\u001b[29G6.1\u001b[33Ghigh\u001b[38Gcomes\u001b[44Gafter\u001b[50Gyou've\u001b[57Ganswered\u001b[66Gthe\u001b[70Gquestions.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m5. The J02 to J09 cross-review\u001b[34G\u001b[22m(Jettison\u001b[44Glane\u001b[49GB):\u001b[53Guntouched;\u001b[64Gthat\u001b[69Glane\u001b[74Gstays\u001b[80Greserved.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
