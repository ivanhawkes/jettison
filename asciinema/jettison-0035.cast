[4C\u001b[1BEach game mode now\u001b[24Glists which hulls and\u001b[46Gdrives a\u001b[55Gplayer is shown, the sam\u001b[80G way it al\u001b[91Geady lis\u001b[100Gs go\u001b[105Gds and skills.\u001b[120G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GContent i\u001b[15G refused if a\u001b[29Ghull\u001b[34Gor dr\u001b[40Gve\u001b[43Gin the list doe\u001b[59Gn't\u001b[63Gexist,\u001b[70Gif\u001b[73Ga\u001b[75Glisted\u001b[82Ghull's\u001b[89Gdrive\u001b[95Gisn't\u001b[101Galso\u001b[106Glisted,\u001b[114Gor\u001b[117Gif\u001b[120Ga\r\u001b[2C\u001b[1B \u001b[5Gscenario\u001b[15Gtarts pla\u001b[25Gers in\u001b[32Ga hull its mode doesn't li\u001b[59Gt.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmanifest\u001b[39m shows \u001b[21Gverything. \u001b[38;2;177;185;249mastralis\u001b[39m,\u001b[42Gth\u001b[45G short\u001b[52Gmode, shows only the torch drive and the eleven hulls that fly it.\r\u001b[4C\u001b[1BThe fi\u001b[12Gter is per\u001b[23Ggame\u001b[28Gm\u001b[30Gde, not p\u001b[42Gscenario: a\u001b[54Gscenario tha\u001b[68Gne\u001b[71Gds \u001b[75G different\u001b[86Gset\u001b[90Guses\u001b[95Ga\u001b[97Gmode\u001b[102Gwith\u001b[107Gthat\u001b[112Gset.\r\u001b[4C\u001b[1BNo UI lists hull\u001b[22G yet,\u001b[28Gso the filter is \u001b[46Gn place for the first one that does.\u001b[83G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAll\u001b[9G63\u001b[12GManifest\u001b[21Gsuites\u001b[28Gpass,\u001b[34Gand\u001b[38Gclang-tidy\u001b[49Gand\u001b[53Gthe\u001b[57Gformat\u001b[64Gcheck\u001b[70Gare\u001b[74Gclean\u001b[80Gon\u001b[83Geverything\u001b[94Gchanged.\r\u001b[2C\u001b[1B                                            \u001b[27;1H\u001b[24;42H\u001b[?25h"]
