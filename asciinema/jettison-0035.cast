[2.259, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, merged \u001b[1mw22b-plan\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI\u001b[5Gwrote\u001b[11Goption\u001b[18GA\u001b[20Ginto\u001b[25Gthe\u001b[29GW22b\u001b[34Gplan,\u001b[40Gran\u001b[44Grounds\u001b[51G5\u001b[53Gand\u001b[57G6,\u001b[60Gand\u001b[64Gmerged\u001b[71Gthe\u001b[75Gplan\u001b[80Ginto\u001b[85GManifest's\u001b[96G\u001b[38;2;177;185;249mfeature-base\u001b[109G\u001b[39mand\u001b[113Gpushed\r\u001b[1B \u001b[3Git (\u001b[38;2;177;185;249m021e981\u001b[39m). Round 6\u001b[25Gstill came back \"changes\", with\u001b[57Gone \u001b[62Gew finding (F13).\u001b[80GI fixed \u001b[89Gt in the plan, but no round has\r\u001b[2C\u001b[1Breviewed that\u001b[17Gfix.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF10, the motion blend (your option A):\u001b[44G\u001b[22mbefore\u001b[51Ga\u001b[53Gjourney,\u001b[62Gtravel\u001b[69Gnow\u001b[73Gchecks\u001b[80Gthe\u001b[84Gcourse\u001b[91Gthe\u001b[95Gship\u001b[100Gwill\u001b[105Gactually\u001b[114Gfly.\u001b[119GIt\r\u001b[2C\u001b[1B \u001b[5Glooks each minute while the drive thrusts and\u001b[51Geach hour while the ship \u001b[77Goas\u001b[81Gs.\u001b[84GA plane\u001b[92G, moon or the s\u001b[108Gar in\u001b[114Gthe\u001b[K\r\u001b[4C\u001b[1Bway is \u001b[13Gdded to the obstacles and\u001b[41Ge course is planned\u001b[61Gagain, up\u001b[71Gto four times,\u001b[86Gthe\u001b[90G \u001b[92Ghe j\u001b[97Gurney is\u001b[106Grefused. The\r\u001b[4C\u001b[1Bpolicy's route estimate uses the sam\u001b[44Gheck.\u001b[50GOption C, a Jettison\u001b[71Gm\u001b[73Gti\u001b[76Gn profile\u001b[86Gw\u001b[89Gre the ship leaves with its\u001b[K\r\u001b[5C\u001b[1Blanet\u001b[14Gvelocity and arrives with the target's, is\u001b[57Grecord\u001b[64Gd under L37 in \u001b[38;2;177;185;249mdelivery-order.md\u001b[39m as th\u001b[103G later replacement\r\u001b[4C\u001b[1Bfor the bl\u001b[16Gnd.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 5 raised two findings, both confirmed fixed by round 6:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[1mF9:\u001b[22m after a partial sale, the unsold cargo is loaded back and\u001b[69Gleaves\u001b[76Gtoo\u001b[80Glittle\u001b[87Ghold\u001b[92Groom\u001b[97Gto\u001b[100Grefuel.\u001b[108GThe\u001b[112Gestimate\r\u001b[4C\u001b[1B \u001b[7Gnow\u001b[11Gcounts only the\u001b[27Gfuel the hold can take.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mF10's hand-off:\u001b[27G\u001b[22mch\u001b[30Gck ran before undocking,\u001b[55Gbut\u001b[59Gthe\u001b[63Gcourse\u001b[70Gis\u001b[73Gplanned\u001b[81Gafter\u001b[87Gclearing\u001b[96Gthe\u001b[100Gstation.\u001b[109GThe\u001b[113Gcheck\r\u001b[4C\u001b[1B \u001b[7Gnow also runs at that point, and th\u001b[44Gcourse it set\u001b[58Gles is the one\u001b[73Gf\u001b[75Gow\u001b[78G and saved.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GR\u001b[9Gund 6 also confirmed tha\u001b[34G the earlier F11\u001b[51Gand F12 fixe\u001b[65Ghold.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRound 6 raised F13:\u001b[22m th\u001b[28G second check had n\u001b[76Guel\u001b[80Gagainst.\u001b[89GThe\u001b[93Gjourney\u001b[101Gnow\u001b[105Gsaves\u001b[111Gthe\u001b[115Gfuel\u001b[27;1H\u001b[24;3H\u001b[?25h"]
