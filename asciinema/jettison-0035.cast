[0.379, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 63 \u001b[22m slice, or from a raw pointer only in `unsafe` (`jettison_string::from_raw`).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 64 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 65 \u001b[22m Every pointer and count a script hands back is checked against its memory's bounds, and every bool\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 66 -\u001b[38;2;248;248;242mand enumerator against its legal values. Only bytes cross the boundary.                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 66 +\u001b[38;2;248;248;242mand enumerator against its legal values. The strings and arrays of one value read no more bytes in     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 67 +\u001b[38;2;248;248;242mall than the script's memory holds, so pointers that share bytes cannot make the host copy more        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 68 +\u001b[38;2;248;248;242mthan the script could have written. Only bytes cross the boundary.                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 69 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 70 \u001b[22m The engine's own events that \u001b[41Gcripts \u001b[49Gee today\u001b[58Gare\u001b[62G`Transit.PassageEnded`,\u001b[86G`Transit.PortalLeft`,\r\u001b[1B     \u001b[2m 71 \u001b[22m `Dock.BerthGiven`, `Dock.BerthRefused`,\u001b[51G`Dock.Landed`\u001b[65Gand\u001b[69G`Dock.Left`\u001b[81G([\u001b[38;2;230;219;116mTransit\u001b[39m](transit.md),\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/jettison.lane-b/source/engine/script/tests/BindingsTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m11\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 119 \u001b[22m         bindings.\u001b[38;2;166;226;46mRead\u001b[39m(layout, memory, kAt, &read), doctest::\u001b[38;2;166;226;46mContains\u001b[39