[0.081, "o", "\u001b[?25l\u001b[H\u001b[5Gand an\u001b[12GNPC's\u001b[18Gas\u001b[21Gthat\u001b[26GNPC.\r\u001b[2C\u001b[1B-\u001b[5GThe host replaces every \u001b[38;2;177;185;249mSim::Controller\u001b[39m in a command, including ones nested in structs and inside arrays. With\u001b[116Gno\r\u001b[4C\u001b[1Bsender named, such a command still traps.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJ02 has moved from the roadmap to the history. Full gate \u001b[38;2;177;185;249m--werror --asan\u001b[39m passed (498 s).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mW22a, drives past the torch\u001b[22m: \u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mw22a-drives\u001b[39m, three commits\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m9e1df6e\u001b[39m: each hull now names a drive record (\u001b[38;2;177;185;249mManifest.Drive\u001b[39m). The torch's numbers moved there unchanged, so nothing\r\u001b[4C\u001b[1Bbehaves differently.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m7d51d6a\u001b[39m: the cruise itself crosses a drive's exclusion radius on thrusters at 15 m/s² at each end, and those metres\r\u001b[4C\u001b[1Bburn no fuel. Flying out on steering would have been capped at 150 m/s: nearly two hours per 1,000 km, with the\r\u001b[4C\u001b[1Bfast-forward unable to skip it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m391cc7a\u001b[39m: the hauler fusion drive, deuterium pellets, and a 2,500 t medium freighter that docks at a destroyer\u001b[115Gpad.\r\u001b[4C\u001b[1BIn the test, the freighter flies 49,374 km from Ore's Highport to Vale in a 2.1-hour cruise, burning 11.1 t of\r\u001b[4C\u001b[1Breaction mass and 4.0 kg of deuterium, and docks.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSix pinned state hashes moved in commit 2. I showed that only the save bytes moved: with the two new fields left\u001b[118Gout\r\u001b[4C\u001b[1Bof\u001b[8Gthe\u001b[12Gsave,\u001b[18Gthe\u001b[22Gold\u001b[26Gpins\u001b[31Gpassed.\u001b[39GCommit\u001b[46G3\u001b[48Gmoved\u001b[54Gnone.\r\u001b[1B \u001b[3G- Full gate \u001b[38;2;177;185;249m--werror --asan --tidy\u001b[38G\u001b[39mpassed\u001b[45G(20\u001b[49Gmin).\u001b[55GThe\u001b[59GManifest\u001b[68Gpin\u001b[72Gdoesn't\u001b[80Gneed\u001b[85Gto\u001b[88Gmove.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I left for you, now in the W22b row:\r\u001b[1B\u001b[22m \u001b[3G- \u001b[1mStarting a company in the freighter.\u001b[22m You'd agreed to hand\u001b[63Gthe\u001b[67Gfreighter\u001b[77Gover\u001b[82Gin\u001b[85Ga\u001b[87Gscenario's\u001b[98Gstarting\u001b[107Gfleet,\u001b[114Gbut\r\u001b[1B    scenario traders are created through \u001b[38;2;177;185;249mCompany::Provision\u001b[39m, the same command players use. Giving\u001b[99Git\u001b[102Ga\u001b[104Ghull\u001b[109Gfield\u001b[115Grisks\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.172, "o", "\u001b]0;◐ jettison-0033\u0007"]
