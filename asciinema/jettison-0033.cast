commits\u001b[107G2\u001b[109Gand\u001b[113G3.\u001b[116GI\r\u001b[1B  won't push or merge anything.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning c\u001b[13G '../jettison.lane-c' &&\u001b[38G./scripts/format-check…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../jettison.lane-c' && ./scripts/format-check.sh 2>&1 | tail -1 && ./scripts/ci.sh --werror --asan --log \r\u001b[5C\u001b[1Bbuild/gate.log > build/gate-j02.out 2>&1; echo \"exit=$?\" >> build/gate-j02.out; tail -16 build/gate-j02.out (8m 7s \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m· 2 lines)\u001b[39m\u001b[K\r\u001b[82C\u001b[2B\u001b[38;2;153;153;153mthought for 2s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
