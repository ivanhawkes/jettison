[0.090, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gtorch's\u001b[15Gfuel,\u001b[21Gcruise\u001b[28Gand\u001b[32Gdocking\u001b[40Gare\u001b[44Gmapped,\u001b[52Gand\u001b[56Gthe\u001b[60Gthrusters'\u001b[71G150\u001b[75Gm/s\u001b[79Gcap\u001b[83Gmeans\u001b[89Gthe\u001b[93G1,000\u001b[99Gkm\u001b[102Gsteering\u001b[111Gleg\u001b[115Gtakes\r\u001b[1B \u001b[3Gabout 1.85 h per end, so I'll fly\u001b[37Gthat\u001b[42Gcrossing\u001b[51Gas\u001b[54Gkinematic\u001b[64Gcruise\u001b[71Ginstead.\u001b[80GNext\u001b[85GI'm\u001b[89Gchecking\u001b[98Gthe\u001b[102GTransit\u001b[110GAPI.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m3\u001b[22m patterns, read \u001b[1m7\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest.lane-b/build/lane.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mW\u001b[8Gote \u001b[1m7\u001b[22m lines to \u001b[1m~/projects/manifest.lane-b/build/lane.md\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1 \u001b[22m#\u001b[11GLane\u001b[16GB:\u001b[19GW22a,\u001b[25Gdrives\u001b[32Gpast\u001b[37Gthe\u001b[41Gtorch\u001b[47G(first\u001b[54Gslice)\r\u001b[2C\u001b[1B   \u001b[2m 2 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 3 \u001b[22mBranch\u001b[16Gw22a-drives\u001b[28Goff\u001b[32Gfeature-base\u001b[45G4558791.\u001b[54GCommits:\r\u001b[1B \u001b[3G   \u001b[2m 4 \u001b[22m1. The torch as a M\u001b[30Gifest.Drive record a hull\u001b[56Gnames (no behaviour change).\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 5 \u001b[22m2\u001b[11G A\u001b[14Gdrive's clearance crossed on thrusters inside \u001b[61Ghe\u001b[71G(Space)\u001b[80G\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 6 \u001b[22m3. The\u001b[16Ghauler\u001b[23Gfusion\u001b[30Gdrive,\u001b[37Gdeuterium\u001b[47Gpellets