[0.050, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 107 \u001b[22m         .\u001b[38;2;166;226;46mField\u001b[39m<&CruiseDrive::exponent>(\u001b[38;2;230;219;116m\"exponent\"\u001b[39m, kDefined)\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 108 \u001b[22m         .\u001b[38;2;166;226;46mField\u001b[39m<&CruiseDrive::profile>(\u001b[38;2;230;219;116m\"profile\"\u001b[39m, kDefined)\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 109 -\u001b[38;2;248;248;242m;                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 109 +\u001b[38;2;248;248;242m        .\u001b[38;2;166;226;46mField\u001b[38;2;248;248;242m<&CruiseDrive::clearance>(\u001b[38;2;230;219;116m\"clearance\"\u001b[38;2;248;248;242m, kDefined)                                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 110 +\u001b[38;2;248;248;242m        .\u001b[38;2;166;226;46mField\u001b[38;2;248;248;242m<&CruiseDrive::crossingAcceleration>(\u001b[38;2;230;219;116m\"crossingAcceleration\"\u001b[38;2;248;248;242m, kDefined);                 \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m11\u001b[16G\u001b[22m\u001b[38;2;166;226;46mRegisterType\u001b[39m<Cruising>(\u001b[38;2;230;219;116m\"Space.Cruising\"\u001b[39m)\r\u001b[5C\u001b[1B\u001b[2m 112 \u001b[20G\u001b[22m.\u001b[38;2;166;226;46mField\u001b[39m<&Cruising::target>(\u001b[38;2;230;219;116m\"target\"\u001b[39m,\u001b[56GAttribute::Saved)\r\u001b[2C\u001b[1B   \u001b[2m 113 \u001b[22m         .\u001b[38;2;166;226;46mField\u001b[39m<&Cruising::frame>(\u001b[38;2;230;219;116m\"frame\"\u001b[39m,\u001b[54GAttribute::Saved)\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 117 \u001b[22m   \u001b[15G    \u001b[20G.\u001b[38;2;166;226;46mField\u001b[39m<&Cruising::arrivalStep>(\u001b[38;2;230;219;116m\"arrivalStep\"\u001b[39m, A\u001b[68Gtribut\u001b[75G::Saved)\u001b[84G\u001b[K\r\u001b[5C\