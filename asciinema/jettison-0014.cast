[0.158, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mUsing\u001b[9Gthe\u001b[13Gengine's\u001b[22Gown\u001b[26Gsaves\u001b[32Gscreen\u001b[39G(already\u001b[48Gworded\u001b[55Gin\u001b[58GGerman)\u001b[66Gfor\u001b[70Gthe\u001b[74GGerman\u001b[81GUI\u001b[84Gframe\u001b[90Ginstead\u001b[98Gof\u001b[101Ga\u001b[103Gtest\u001b[108Ggame:\r\u001b[1B \u001b[3Gsmaller, same coverage. Ch\u001b[30Gcking how \u001b[41G \u001b[43Gun line can\u001b[55Gopen it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommit\u001b[10GB's\u001b[14Gplan\u001b[19Gis\u001b[22Gset:\u001b[27Grender_test\u001b[39Gwill\u001b[44Grun\u001b[48Gthe\u001b[52Gbare\u001b[57Gshell\u001b[63Gover\u001b[68Gthe\u001b[72Gstatic\u001b[79Gscenes,\u001b[87Gthe\u001b[91GGerman\u001b[98Gframe\u001b[104Gwill\u001b[109Guse\u001b[113Gthe\r\u001b[1B \u001b[3Gsaves screen, and th\u001b[24G smoke mod's packed\u001b[48Ggets covered by the\u001b[68Ghost and script \u001b[85Gui\u001b[88Ges\u001b[91Glater.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m6\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm\u001b[7Gadding\u001b[14Gtwo\u001b[18Gneutral\u001b[26Gfallbacks\u001b[36Gto\u001b[39Gthe\u001b[43Gengine,\u001b[51Gthen\u001b[56Gre-exporting\u001b[69Gwith\u001b[74Gthe\u001b[78Gship\u001b[83Gand\u001b[87Gpad\u001b[91Ggiven\u001b[97Gtheir\u001b[103Gscene\u001b[109Gids.\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;153;153;153m· summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/jettison'\u001b[45G&&\u001b[48Gcmake\u001b[54G--buil…\r\u001b[1B\u00