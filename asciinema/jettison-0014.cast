8Gm)\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[18G\u001b[22m  \u001b[38;2;249;38;114mreturn\u001b[39m \u001b[38;2;166;226;46mFail\u001b[39m(journey,\u001b[41GFailure::CruiseRefused);\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Found the stall: travel's \u001b[38;2;177;185;249mClearOf\u001b[39m still treats the ship as inside Ore Vale's reach during the step, though it reports\r\u001b[2C\u001b[1Bclear afterward. I'm printing the distance \u001b[38;2;177;185;249mClearOf\u001b[39m measures to see why.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✻\u001b[3GComputing… \u001b[42G\u001b[38;2;153;153;153mthought for 18s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
