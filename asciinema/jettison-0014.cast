[0.142, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[17B\u001b[38;2;177;185;249m\u001b[1ml\u001b[22mear\u001b[33GStart a new \u001b[46Gession with empty context; l\u001b[75Gops carry over, and the old one stays in\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;177;185;249m/resume\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[1ml\u001b[22m\u001b[38;2;153;153;153maude-api\u001b[33GBuild\u001b[40Gnd debug apps that use the \u001b[39m\u001b[1mCl\u001b[22m\u001b[38;2;153;153;153maude API\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1mcl\u001b[22m\u001b[38;2;153;153;153maude-in-chrome           Let \u001b[39m\u001b[1mCl\u001b[22m\u001b[38;2;153;153;153maude browse and interact with pages in your Chrome\r\u001b[5C\u001b[1Bc\u001b[8Gde-review\u001b[33G3 free /ultrareview · Review\u001b[64Ge current diff or a PR for bugs\r\u001b[4C\u001b[2B\u001b[39ml\u001b[27;1H\u001b[24;6H\u001b[?25h"]
