[0.398, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mYou're\u001b[10Gright\u001b[16Gthat\u001b[21GManifest\u001b[30Gwill\u001b[35Gneed\u001b[40Gthem\u001b[45Glater.\u001b[52GToday\u001b[58Git\u001b[61Gdoesn't\u001b[69Guse\u001b[73Gthem:\u001b[79Gits\u001b[83Gonly\u001b[88Guse\u001b[92Gis\u001b[95G\u001b[38;2;177;185;249mLaneTravel::Attach\u001b[39m,\u001b[115Gthere\r\u001b[1B \u001b[3Gs\u001b[5G th\u001b[10Gcruise system can be order\u001b[37Gd aft\u001b[43Gr\u001b[45Gthe lanes s\u001b[57Gstem. It iss\u001b[70Ges\u001b[73Gno jump, gate request\u001b[95Gor route. So deleting th\u001b[120Gm\r\u001b[2C\u001b[1Bbreaks\u001b[10Gnothing now. The cost lands l\u001b[40Gter.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mIf they're deleted:\r\u001b[2C\u001b[1B\u001b[22m- Manifest's stargates\u001b[26Ghave\u001b[31Gto\u001b[34Gbe\u001b[37Grebuilt\u001b[45Gfrom\u001b[50Ggit\u001b[54Ghistory,\u001b[63Gabout\u001b[69G1,300\u001b[75Glines\u001b[81Gacross\u001b[88Glanes,\u001b[95Ggates\u001b[101Gand\u001b[105Groutes.\r\u001b[4C\u001b[1BBehaviour already worked out\u001b[34Gand tested\u001b[45Gwould be\u001b[54Glo\u001b[58G: arrivals\u001b[69Gplaced cl\u001b[79Gar of each other on rings\u001b[105Gof points,\u001b[116Gthe\r\u001b[2C\u001b[1B \u001b[5Gtoll checked again as a ship\u001b[34Gtouch\u001b[41G the ring, the gate's queue\u001b[69Gand lapses, and\u001b[85Gs\u001b[87Gves \u001b[92Gaken mid-jump.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEach\u001b[10Glater rebuild\u001b[24Gwould \u001b[31Gave to r\u001b[40Gpeat that work,\u001b[56Gand its bugs\u001b[69Gwould be found ag\u001b[87Gin.\u001b[91G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mIf they're kept\u001b[22m,\u001b[20Gthey're\u001b[28Gmostly\u001b[35Gneutral\u001b[43Galready:\r\u001b[2C\u001b[1B- \u001b[1mA jump lan\u001b[16G is a portal:\u001b[22m an entity leaves one frame\u001b[57Gfor\u001b[61Ga\u001b[63Gset\u001b[67Gtime\u001b[72Gand\u001b[76Gappears\u001b[84Gat\u001b[87Ga\u001b[89Gnamed\u001b[95Gexit\u001b[100Gin\u001b[103Ganother.\r\u001b[2C\u001b[1B \u001b[5GGeneralised to any frame, it covers your short intra-planet jumps as well as \u001b[83Gt\u001b[85Grg\u001b[88Gtes. Today's lanes only\u001b[112Ggo\r\u001b[4C\u001b[1Bb\u001b[7Gtween \u001b[14Gtar systems.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA gate is a portal guarded by a slot queue and a trigger volume\u001b[22m,\u001b[70Gwith\u001b[75Gthe\u001b[79Ggame's\u001b[86Gcharge\u001b[93Grule\u001b[98G(the\u001b[103Gexisting\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mTollRule\u001b[39m). It's the same queue and lapse machinery as pads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly the galaxy and routes are space-only.\u001b[22m T\u001b[50Gey'd move to Manifest,\u001b[73Gwhich\u001b[79Gwould\u001b[85Groute\u001b[91Gover\u001b[96Gits\u001b[100Gown\u001b[104Ggraph\u001b[110Gwith\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gengine's existing pathfinding (\u001b[38;2;177;185;249mAi::FindPath\u001b[39m).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcost\u001b[12Gof\u001b[15Gkeeping\u001b[23Gthem\u001b[28Gis\u001b[31Gconverting\u001b[42Gthem\u001b[47Gin\u001b[50Gslices\u001b[57G4–6.\u001b[62GThat's\u001b[69Gsomewhat\u001b[78Gmore\u001b[83Gsurface\u001b[91Garea,\u001b[97Gand\u001b[101Gthey\u001b[106Gneed\u001b[111Ga\u001b[113Gneutral\u001b[27;1H\u001b[24;3H\u001b[?25h"]
