[0.115, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 208 \u001b[14G\u001b[22mstation's\u001b[24Gtraffic,\u001b[33Gsixteen\u001b[41Gships;\u001b[48Ga\u001b[50Gbusier\u001b[57Glane's,\u001b[65Gwhere\u001b[71Gevery\u001b[77Gship\u001b[82Gqueries\u001b[90Gthe\u001b[94Gindex\u001b[100Geach\u001b[105Gstep,\r\u001b[6C\u001b[1B\u001b[2m209 \u001b[22m   is measured when a game\u001b[38Ghas\u001b[42Gone.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 210 -\u001b[38;2;248;248;242m- **Deck traffic, not yet placed** (9e): a buggy drives to its ship's hatch on the deck under the     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 211 -\u001b[38;2;248;248;242m  hull, through whatever of the hull's proxy is lower than the buggy, as a ramp or a lift a hull      \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m212 -\u001b[38;2;248;248;242m  lowers to its hatch would\u001b[40Gnot;\u001b[45Groads\u001b[51Grun\u001b[55Gonly\u001b[60Gon\u001b[63Gthe\u001b[67Gtops\u001b[72Gof\u001b[75Gdecks\u001b[81Gand\u001b[85Gpiers,\u001b[92Gso\u001b[95Ga\u001b[97Gpad\u001b[101Gon\u001b[104Ga\u001b[106Gside\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m213 -\u001b[38;2;248;248;242m  or an underside, which no\u001b[40Groad\u001b[45Greaches,\u001b[54Gis\u001b[57Grefused\u001b[65Gat\u001b[68Ga\u001b[70Gstation\u001b[78Gwith\u001b[83Gbays;\u001b[89Gthe\u001b[93Groads'\u001b[100Glegs\u001b[105Gare\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m2\u001b[9G4 -\u001b[38;2;248;248;242m  not \u001b[19Ghecked against each\u001b[39Gother,\u001b[46Gso\u001b[49Gtwo\u001b[53Gthat\u001b[58Gcross\u001b[64Gbetween\u001b[72Gnodes\u001b[78Glet\u001b[82Gbuggies\u001b[90Gpass\u001b[95Gthrough\u001b[103Geach\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m215 -\u001b[38;2;248;248;242m  other there, which neither\u001b[41Gsample\u001b[48Gstation\u001b[56Ghas;\u001b[61Ga\u001b[63Gbuggy\u001b[69Gcarries\u001b[77Gcrates,\u001b[85Gnot\u001b[89Ggoods,\u001b[96Gthe\u001b[100Gtrade\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 216 -\u001b[38;2;248;248;24