[0.126, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255ma\u001b[39m                                                                                                                     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTaking\u001b[10G(a):\u001b[15Gfirst\u001b[21Gthe\u001b[25G\u001b[38;2;177;185;249mClearOf\u001b[33G\u001b[39mfix\u001b[37Gin\u001b[40GJettison.\u001b[50GI'm\u001b[54Gfinding\u001b[62Gwhere\u001b[68Gthe\u001b[72G520\u001b[76Gm\u001b[78Gbetween\u001b[86Ga\u001b[88Gstation's\u001b[98Gplaced\u001b[105Gposition\u001b[114Gand\u001b[118Gits\r\u001b[1B \u001b[3Gorb\u001b[7Gt comes\u001b[16Grom.\u001b[21G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Groot\u001b[12Gcause\u001b[18Gis\u001b[21Ga\u001b[23Gtiming\u001b[30Gmismatch:\u001b[40Gphysics\u001b[48Gplaces\u001b[55Gbodies\u001b[62Gat\u001b[65Gthe\u001b[69Gend\u001b[73Gof\u001b[76Gthe\u001b[80Gstep,\u001b[86Gwhile\u001b[92GClearOf\u001b[100Gmeasures\u001b[109Gagainst\u001b[117Gthe\r\u001b[1B \u001b[3Gstati\u001b[9Gn's start-of-s\u001b[24Gep position, so\u001b[40Gt\u001b[42Ge ~500 m drift explains the 520 m\u001b[76Ggap. N\u001b[83Gxt\u001b[86GI'l\u001b[90G check whether the\u001b[109Gcru\u001b[113Gse's\u001b[K\r\u001b[2C\u001b[1B\"\u001b[5Goo near\u001b[13Ga station\" check has the same proble\u001b[50G.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gcruise\u001b[14Gcheck\u001b[20Gsuffers\u001b[28Gfrom\u001b[33Gthe\u001b[37Gsame\u001b[42Gtiming\u001b[49Gmismatch,\u001b[59Gsince\u001b[65Git\u001b[68Gcompares\u001b[77Gend-of-step\u001b[89Gpositions\u001b[99Gagainst\u001b[107Gstart-of-step\r\u001b[1B \u001b[3Gstations. The general fix is to have physics report t\u001b[57Ge\u001b[59Gt\u001b[61Gme its\u001b[68Gplacem\u001b[75Gnts apply \u001b[86Go,\u001b[89Gs\u001b[91G I'm reading phy\u001b[108Gics' step and\r\u001b[3C\u001b[1Bkip next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPhysics\u001b[11Gwill\u001b[16Gnow\u001b[20Grecord\u001b[27Gthe\u001b[31Gtime\u001b[36Gits\u001b[40Gplaceme\u001b[75Gce\u001b[78Gand\u001b[82Greach\u001b[88Gchecks\u001b[95Gwill\u001b[100Gmeasure\u001b[108Gat\u001b[111Gthat\u001b[116Gtime\u001b[27;1H\u001b[24;3H\u001b[?25h"]
