1b[39m,\u001b[45G\u001b[38;2;177;185;249mMayFly\u001b[39m,\u001b[53Ga\u001b[55Gsaved\u001b[61Gfield\u001b[67Gcalled\u001b[74G\u001b[38;2;177;185;249m\"ship\"\u001b[39m,\u001b[82G\u001b[38;2;177;185;249mPhysics.Thrusters\u001b[39m,\u001b[101Gand\u001b[105G\u001b[38;2;177;185;249mSystemIndices\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G(which is really one index per frame).\u001b[45GThese are\u001b[55Gmostly r\u001b[64Gnames, but saved names need aliases.\u001b[101G\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[38;2;177;185;249m\u001b[1mdock\u001b[39m counts as neutral but is all station, pad and cargo data.\u001b[22m Its \u001b[74Ge\u001b[76Gts also need \u001b[38;2;177;185;249mspace\u001b[39m, and \u001b[38;2;177;185;249mSaveGame\u001b[39m's\u001b[111Gmigration\r\u001b[2C\u001b[1B  \u001b[6Ghard-codes the keys \u001b[38;2;177;185;249m\"galaxy\"\u001b[39m and \u001b[38;2;177;185;249m\"system\"\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gagent\u001b[13Gdidn't\u001b[20Glook\u001b[25Gat\u001b[28Gshaders,\u001b[37Gthe\u001b[41Gstring\u001b[48Gtables,\u001b[56Gthe\u001b[60Gsamples\u001b[68Gor\u001b[71Gthe\u001b[75G\u001b[38;2;177;185;249mdevtools\u001b[84G\u001b[39mmodule.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22mturn\u001b[14Gthis\u001b[19Ginto\u001b[24Ga\u001b[26Gdecoupling\u001b[37Gplan\u001b[42Gto\u001b[45Gsettle\u001b[52Gwith\u001b[57Gyou,\u001b[62Gbefore\u001b[69GW12\u001b[73Gor\u001b[76Galongside\u001b[86Git.\u001b[90GThe\u001b[94Gcuts\u001b[99Gare\u001b[103GAPI\u001b[107Gand\r\u001b[2C\u001b[1Bsave-format changes,\u001b[24Gso I'd \u001b[33Ga\u001b[35G it o\u001b[42GOpu\u001b[46G a\u001b[49G high eff\u001b[59Grt. A ch\u001b[68Gaper\u001b[73Gmode\u001b[78G ri\u001b[82Gks ge\u001b[88Gting the mig\u001b[101Gations wrong.\u001b[115GStart\r\u001b[2C\u001b[1Bit in a fresh session: the inve\u001b[35Gtory above is t\u001b[51Ge only context it n\u001b[71Geds, and I can save it to\u001b[97Ga docume\u001b[106Gt\u001b[108Gfirst if you\r\u001b[2C\u001b[1Bwant it\u001b[11Gkept.\u001b[17G        \u001b[26G   \u001b[30G         \u001b[40G     \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
