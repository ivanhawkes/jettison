[0.169, "o", "\u001b[?25l\u001b[H\u001b[5G \u001b[2m    \u001b[22m a provisio\u001b[22Ged \u001b[26Geusable\u001b[34Ggap, with independe\u001b[55G engine and Manifest acceptance evidence; immut\u001b[103Gble\u001b[107GSDK pin\r\u001b[4C\u001b[1B \u001b[2m    \u001b[22m  upd\u001b[16Gted after engine\u001b[33Gvalidation.\u001b[45G|\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m 68 \u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(build/commit-extraction-plan3.txt)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrot\u001b[11G \u001b[1m10\u001b[22m l\u001b[17Gnes to \u001b[1mbuild/commit-extraction-plan3.txt\r\u001b[5C\u001b[1B\u001b[22m\u001b[2m  1 \u001b[22mPlan:\u001b[16Gjump\u001b[21Glanes\u001b[27Gand\u001b[31Ggates\u001b[37Gkept\u001b[42Gas\u001b[45Gportals\u001b[53Gin\u001b[56Gthe\u001b[60Gspace\u001b[66Gextraction\r\u001b[2C\u001b[1B   \u001b[2m  2 \u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  3 \u001b[22mThe user's:\u001b[22GM\u001b[24Gnifest will travel between systems by stargates and make\u001b[82Gho\u001b[85Gt\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22mjumps\u001b[16Gwithin\u001b[23Gone.\u001b[28GA\u001b[30Glane\u001b[35Gbecomes\u001b[43Ga\u001b[45Gportal\u001b[52Gto\u001b[55Gany\u001b[59Gframe's\u001b[67Gexit,\u001b[73Gthe\u001b[77Gsame\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m  5 \u001b[22mframe's included,\u001b[29Gnd a gate\u001b[39Ga portal entered through a\u001b[66Gtrigger once cle\u001b[83Gred\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m  6 \u001b[22mfrom\u001b[15Gits slots, char\u001b[31Ged by\u001b[37Gthe\u001b[41Ggame's rule; the galaxy and routes move to\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22mManifest.\u001b[20GConverted\u001b[30Gin\u001b[33Gslice\u001b[39G4,\u001b[42Gtested\u001b[49Gon\u001b[52Gneutral\u001b[60Gframes\u001b[67Guntil\u001b[73GManifest's\r\u001b[1B \u001b[3G   \u001b[2m  8 \u001b[22mstargates test them in play.\r\u001b[5C\u001b[1B\u001