[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[10G\u001b[22m\u001b[38;2;117;113;94m# hum and a music loop. The effects are written as WAV straight into the sample's audio; the music is\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m5 \u001b[22m \u001b[38;2;117;113;94m# written as WAV to the current directory and encoded with the reference FLAC encoder, which devenv\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m \u001b[38;2;117;113;94m#   nix shell nixpkgs#flac\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m \u001b[38;2;117;113;94m#   python3 scripts/make-sample-sounds.py\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 10 -\u001b[38;2;248;248;242m#   flac --best --force --silent -o source/\u001b[48;2;92;2;0msamples\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0mspace\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0massets/\u001b[48;2;61;1;0maudio/music/drift.flac drift.wav       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 10 +\u001b[38;2;117;113;94m#   flac --best --force --silent -o source/\u001b[48;2;4;71;0mtest\u001b[48;2;2;40;0m/\u001b[48;2;4;71;0mcontent\u001b[48;2;2;40;0m/audio/music/drift.flac drift.wav\u001b[38;2;248;248;242m               \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m1\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 12 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m# The effects are mono, as a positioned sound must be for miniaudio to place it, and the music is\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 13 \u001b[22m \u001b[38;2;117;113;94m# stereo. Everything is 48 kHz and 16-bit. The seed is fixed: the same script makes the same sounds.\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scripts/make-sample-textu