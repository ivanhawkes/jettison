[0.094, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(cd '/home/ivan/projects/jettison' && clang-format -i 'source/engine/ai/include/jettison/ai/BehaviourTree.h'\r\u001b[6C\u001b[1B'source/engine/ai/include/jettison/ai/Courses.h'\u001b[56G'so…)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mUpdated\u001b[14G\u001b[1msource/engine/dock/include/jettison/dock/Docks.h\u001b[22m \u001b[38;2;56;166;96m+2\u001b[39m \u001b[38;2;179;89;107m-2\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 329 \u001b[22m \u001b[38;2;117;113;94m// sphere (Ai::Waypoints) to a point out along its pad's normal, as far beyond the point above the\r\u001b[1B\u001b[39m     \u001b[2m 330 \u001b[22m \u001b[38;2;117;113;94m// pad as it stops in from its top speed, stopping there; then straight down the normal to the point\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m331 \u001b[22m \u001b[38;2;117;113;94m// above its pad, outside that sphere; then down the normal onto the pad, kept clear of the station by\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 332 -\u001b[38;2;248;248;242m// its hull (Ai::Destination::byShape), turned to the pad, slowing to stop a hand's breadth above it;\u001b[48;2;92;2;0m \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m     -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0mand\u001b[48;2;61;1;0m                                                                                                   \r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m333 -\u001b[38;2;248;248;242m// once clamp\u001b[26Gd i\u001b[30Gs Physics::Body i\u001b[48G kinematic, on the station's\u001b[77Grails\u001b[83Gat\u001b[86Gits\u001b[90Gplace\u001b[96Gon\u001b[99Gthe\u001b[103Gpad.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 332 +\u001b[38;2;117;113;94m// its hull (Ai::Destination::byShape), turned to the pad, slowing to stop a hand's breadth above it;\u001b[38;2;248;248;242m \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 333 +\u001b[38;2;117;113;94m// \u001b[48;2;4;71;0mand \u001b[48;2;2;40;0monce clamped its Physics::Body is kinematic, on the station's rails at its place on the pad.\u001b[38;2;248;248;242m   \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m334 \u001b[22m \u001b[38;2;117;113;94m// Undocking makes it dynamic again and lifts it the same way back up.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 335 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m//\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 336 \u001b[22m \u001b[38;2;117;113;94m// The definitions are the game's start-up, as physics' shapes are, and not state: a save names\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[13G\u001b[22mfile,\u001b[19Grunning\u001b[27G\u001b[1m4\u001b[29G\u001b[22mshell\u001b[35Gcommands…\r\u001b[4C\u001b[1B\u001b[38;2;153;153;153m $ cd '/home/iv\u001b[21Gn/project\u001b[31G/j\u001b[34Gtt\u001b[37Gson' && ctest --test-dir build/clang-debug -j24 --output-on-failure 2>&1 | tail -25\r\u001b[18C\u001b[8B(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
