[0.024, "o", "\u001b[H\u001b[3G6.\u001b[6G\u001b[38;2;177;185;249mb690066\u001b[39m:\u001b[15Gslice\u001b[21G2\u001b[23Grecorded\u001b[32Gin\u001b[35Gthe\u001b[39Gplan,\u001b[45Gwith\u001b[50Gthe\u001b[54Gthree\u001b[60Gchoices\u001b[68Gyou\u001b[72Gmade.\u001b[78GThe\u001b[82Glist\u001b[87Gof\u001b[90Gallowed\u001b[98Gsetting\u001b[106Gwords\u001b[112Gis\u001b[115Gdown\r\u001b[1B \u001b[3G   from 66 to 51.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest (committed, not pushed):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mab926c5\u001b[39m:\u001b[14Gyour\u001b[19Glanguages\u001b[29Gnote\u001b[34Gin\u001b[37G\u001b[38;2;177;185;249mdocs/scope.md\u001b[39m.\u001b[52GI\u001b[54Galso\u001b[59Gsaved\u001b[65Git\u001b[68Gto\u001b[71Gmemory.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m7cd0715\u001b[39m: the SDK\u001b[22Gpin\u001b[26Gmoved\u001b[32Gto\u001b[35G\u001b[38;2;177;185;249mb690066\u001b[39m.\u001b[44GHighport's\u001b[55Glayout\u001b[62Gno\u001b[65Glonger\u001b[72Ghas\u001b[76Gbays\u001b[81Gor\u001b[84Gdeck\u001b[89Gtraffic,\u001b[98Gand\u001b[102Gthe\u001b[106Ghulls\u001b[112Gno\u001b[115Glonger\r\u001b[2C\u001b[1B  have hatches. The travel test now gets its refused departure\u001b[66Gfrom\u001b[71Ga\u001b[73Gship\u001b[78Ganother\u001b[86Gcompany\u001b[94Gcommands,\u001b[104Gsince\u001b[110Gthe\u001b[114Gdeck\r\u001b[2C\u001b[1B  that used to block it is gone.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mLeft for later s\u001b[20Gices:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- The dock suite still flies in a copy of the sample's\u001b[58GHalcyon;\u001b[67Gits\u001b[71Gneutral\u001b[79Gframes\u001b[86Gfixture\u001b[94Gis\u001b[97Gslice\u001b[103G5's.\r\u001b[2C\u001b[1B- The planets keep \u001b[38;2;177;185;249mcelestial\u001b[39m records, because\u001b[49Gthe\u001b[53Grenderer\u001b[62Gdraws\u001b[68Gair,\u001b[73Grings\u001b[79Gand\u001b[83Gocclusion\u001b[93Gby\u001b[96Gthem\u001b[101Guntil\u001b[107Gslice 3.\u001b[116GA\r\u001b[4C\u001b[1Bscene\u001b[11Gwith\u001b[16Gno\u001b[19Gstar\u001b[24Gsystem\u001b[31Gmay\u001b[35Gnow\u001b[39Gname\u001b[44Ga\u001b[46Gbody.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mdocs/architecture.md\u001b[26G\u001b[39monly\u001b[31Ggot\u001b[35Gaccuracy\u001b[44Gedits;\u001b[51Gslice\u001b[57G8\u001b[59Grewrites\u001b[68Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BPacked runs no longer load a user mod; the\u001b[46Gapp\u001b[50Gsuite's\u001b[58Gmounts\u001b[65Gtests\u001b[71Gcover\u001b[77Gthat\u001b[82Ginstead.\r\u001b[2C\u001b[2BThis is a good point for \u001b[38;2;177;185;249m/compact\u001b[39m or\u001b[40Ga\u001b[42Gnew\u001b[46Gsession.\u001b[55GOpus\u001b[60Gat\u001b[63Gyour\u001b[68Gusual\u001b[74Geffort\u001b[81Gfits\u001b[86Gslice\u001b[92G3\u001b[94G(reasons,\u001b[104Gscenes\u001b[111Gand\r\u001b[2C\u001b[1Bsaves), since it moves reason keys and needs\u001b[48Gcare\u001b[53Garound\u001b[60Gthe\u001b[64Gpins.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 1h 20m 17s · done 9:09 pm\r\u001b[2B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0014 ─\r\u001b[1B\u001b[39m❯ \u001b[K\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m\u001b[2mOpus 5.5 ctx [#####-----] 52% | 5h: 20% | ↑518.0k ↓1.1k\r\u001b[2C\u001b[1B\u001b[22m\u001b[38;2;255;193;7m⏵⏵ auto mode on\u001b[27G\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
