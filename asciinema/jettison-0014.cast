[3.694, "o", "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSettled:\u001b[12Gkeep\u001b[17Gright,\u001b[24Glanes\u001b[30Gheld\u001b[35Glike\u001b[40Gpads,\u001b[46Glanes\u001b[52Gfirst.\u001b[59GNext\u001b[64GI'm\u001b[68Gchecking\u001b[77Gthe\u001b[81Gsystem's\u001b[90Gaxes,\u001b[96Gsteering's\u001b[107Gdestinations\r\u001b[2C\u001b[1Band the test systems, so the API can be specified exactly.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m5\u001b[22m patterns, read \u001b[1m7\u001b[22m files \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm writing\u001b[15Gthe\u001b[19Gdesign\u001b[26Ginto\u001b[31Gthe\u001b[35Groadmap\u001b[43Grow\u001b[47Gbefore\u001b[54Gcoding:\u001b[62Gcruises\u001b[70Guse\u001b[74Gthree\u001b[80Glanes\u001b[86Geach\u001b[91Gway,\u001b[96Gwith\u001b[101Gdepartures\u001b[112Gabove\u001b[118Gthe\r\u001b[2C\u001b[1Borbit plane\u001b[15Gand\u001b[19Garrivals\u001b[28Gbelow,\u001b[35Gand\u001b[39G\u001b[38;2;177;185;249mClearOf\u001b[47G\u001b[39mis\u001b[50Gbeing\u001b[56Gremoved.\u001b[38;2;153;153;153m · summary\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m8\u001b[22m patterns, read \u001b[1m6\u001b[22m files, listed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'm writing a Manifest timing test first, flying ships between two Ore stations and recording departure, arrival\u001b[116Gand\r\u001b[2C\u001b[1Bclosest approach to get a baseline on the current engine.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m6\u001b[22m patterns, read \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/source/test/FixtureTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m126\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1207 \u001b[22m       }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1208 \u001b[22m   }\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1209 \u001b[22m }\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m10\u001b[15G\u001b[38;2;248;248;242m           \u001b[27G       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m11\u001b[15G\u001b[38;2;248;248;242m            \u001b[28G                 \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m12\u001b[13G\u001b[38;2;117;113;94m// Jettison's station traffic lanes, measured: four ships flown both ways between two neighbouring\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m13\u001b[13G\u001b[38;2;117;113;94m// stations of Ore's one orbi\u001b[80Ge and to come in, and how near any\u001b[49m\u001b[39m\u001b[27;1H"]
[4.806, "o", "\u001b[H\u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Lanes \u001b[39m\u001b[49m\u001b[K\r\u001b[2B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mMeasured on today's engine, six starters flown both ways between Highport and Vale never came within 198 m of each \u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mother, hull to hull, checked between steps too. Courses flown both ways in the same hour are about 5,400 km apart, \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mbecause each aims where its target will be and the stations move about 15° an hour. What is shared: ships going the \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1msame way fly the same line 6–70 m apart, kept apart only by leaving seconds after one another, and a departure passes \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mabout 800 m from an arrival. Highport's four pads also cap how many leave at once. How should we proceed?\r\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[39m \u001b[38;2;177;185;249mKeep test, park lanes (Recommended)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mCommit the measurement as a Manifest fixture test that fails if any two hulls come within a steered ship's 20 m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mclearance, so \u001b[21Gh\u001b[23G probl\u001b[30Gm shows itse\u001b[43Gf when traffic grows. Record the numbers in the lanes row and put it back in \r\u001b[5C\u001b[1Bthe queue, triggered by that test failing. Then the way in to a pad, which has a measured failure (ships circling \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mthe point above the pad), or W12.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[39m Build lanes as designed\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mKeep right, three lanes each way held like pads, departures above the orbit plane and arrivals below it. This \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mguarantees separation\u001b[28Gby construction as traffic grows, at the cost of a sizeable engine change, moved pins in \r\u001b[5C\u001b[1BManifest, and Manifest and the sample switching from ClearOf to a single Cruise.\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;153;153;153m3.\u001b[39m Departure lanes only\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mThe smaller part: several departure gates per station, held like pads, so ships going the same way never share a \r\u001b[5C\u001b[1Bline, and arrivals offset below the orbit plane. No keep-right offset along the cruise, since opposite flows are \r\u001b[5C\u001b[1Balready thousands of km apart here.\r\u001b[2C\u001b[1B4. Type something.\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m5.\u001b[6GChat about this\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · ↑/↓ to navigate · Esc to cancel\u001b[39m\u001b[K\u001b[27;1H\u001b[9;1H"]
