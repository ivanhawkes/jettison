[0.016, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5GGeneralised to any frame, it covers your short intra-planet jumps as well as \u001b[83Gt\u001b[85Grg\u001b[88Gtes. Today's lanes only\u001b[112Ggo\r\u001b[4C\u001b[1Bb\u001b[7Gtween \u001b[14Gtar systems.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA gate is a portal guarded by a slot queue and a trigger volume\u001b[22m,\u001b[70Gwith\u001b[75Gthe\u001b[79Ggame's\u001b[86Gcharge\u001b[93Grule\u001b[98G(the\u001b[103Gexisting\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mTollRule\u001b[39m). It's the same queue and lapse machinery as pads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly the galaxy and routes are space-only.\u001b[22m T\u001b[50Gey'd move to Manifest,\u001b[73Gwhich\u001b[79Gwould\u001b[85Groute\u001b[91Gover\u001b[96Gits\u001b[100Gown\u001b[104Ggraph\u001b[110Gwith\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gengine's existing pathfinding (\u001b[38;2;177;185;249mAi::FindPath\u001b[39m).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gcost\u001b[12Gof\u001b[15Gkeeping\u001b[23Gthem\u001b[28Gis\u001b[31Gconverting\u001b[42Gthem\u001b[47Gin\u001b[50Gslices\u001b[57G4–6.\u001b[62GThat's\u001b[69Gsomewhat\u001b[78Gmore\u001b[83Gsurface\u001b[91Garea,\u001b[97Gand\u001b[101Gthey\u001b[106Gneed\u001b[111Ga\u001b[113Gneutral\r\u001b[2C\u001b[1Btest in the\u001b[15Gengine (a door betwe\u001b[36Gn two\u001b[42Gfra\u001b[46Ges,\u001b[50Ga toll\u001b[57Gbooth) until Manifest's stargates\u001b[91Gtest them\u001b[101Gfor real.\u001b[111G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Grecommend\u001b[15Gkeeping\u001b[23Gthem\u001b[28Gas\u001b[31Gneutral\u001b[39Gportals\u001b[47Gand\u001b[51Ggated\u001b[57Gportals,\u001b[66Gand\u001b[70Gmoving\u001b[77Gthe\u001b[81Ggalaxy\u001b[88Gand\u001b[92Groutes\u001b[99Gto\u001b[102GManifest.\u001b[112GSince\r\u001b[2C\u001b[1Byou'll wa\u001b[13Gt\u001b[15Gthis, conv\u001b[26Grting them now cost\u001b[47Gless than\u001b[57Grebui\u001b[63Gding them later. Sh\u001b[84Gl I\u001b[88Gup\u001b[91Gate \u001b[96Ghe\u001b[99Gplan that way?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 15s · done 7:09 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, keep them as portals and update the plan\u001b[39m                                                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mEditing\u001b[11Gdocs/space-extraction-plan.md\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Update(docs/space-extraction-plan.md)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
