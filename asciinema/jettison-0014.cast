[0.055, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1\u001b[14G\u001b[38;2;117;113;94mThe\u001b[18Gpost ch\u001b[26Gin's \u001b[32Gest b\u001b[38Gnch (docs/roadmap.md, 10c): under th\u001b[76Gsun and the sky, on\u001b[96Ga plated deck,\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 2\u001b[14G\u001b[38;2;117;113;94mwhat each of i\u001b[29Gs\u001b[31Gpasses is f\u001b[43Gr.\u001b[46GThe camera orbits the bench (W, A, S, D, Q, E, or drag with the\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 3\u001b[14G\u001b[38;2;117;113;94mright\u001b[20Gmouse button).\u001b[38;2;248;248;242m                                                                           \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 4\u001b[13G\u001b[38;2;248;248;242m                                                                   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 5\u001b[12G\u001b[38;2;117;113;94m#   - Crates on the deck, and a wall behind them: ambient occlusion darkens the sky's light in the\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 6\u001b[12G\u001b[38;2;117;113;94m#     corners where they meet the deck and each other, and leaves the open deck as it was.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 7\u001b[12G\u001b[38;2;117;113;94m#   - The crate on the left is selected: a line a pixel wide just outside it, amber. The pod on the\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m 8\u001b[12G\u001b[38;2;117;113;94m#     right, and the fin on top of it, are targeted: one red glow about the two, fading over 14 pixels\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m  \u001b[12G\u001b[38;2;117;113;94m.\u001b[38;2;248;248;242m                 \u001b[31G         \u001b[41G       \u001b[49G       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m \u001b[12G\u001b[38;2;117;113;94m#   - Two lamp panels on the wall, as bright as a lit window: the left one blooms, the right one is\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;117;113;94m#     marked as post-processing leaves alone, so it has no haze over it, though its light still\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;117;113;94m#     spreads onto the wall about it.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;117;113;94m#   - A beacon on the wall's top, blinking red: its glow and its light share one wave, period and\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;117;113;94m#     phase, so the wall below it is lit while the beacon is bright.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;166;226;46mversion:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m2\u001b[38;2;248;248;242m \u001b[24G  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;166;226;46mentities:\u001b[38;2;248;248;242m   \u001b[25G    \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[14G\u001b[38;2;248;248;242m-\u001b[16G\u001b[38;2;166;226;46mid:\u001b[38;2;248;248;242m \u001b[38;2;230;219;116msun\u001b[38;2;248;248;242m    \u001b[28G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;166;226;46mtransform:\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[18G\u001b[38;2;166;226;46mtransl\u001b[25Gtion:\u001b[38;2;248;248;242m [\u001b[38;2;190;132;255m-6.0e10\u001b[38;2;248;248;242m, \u001b[38;2;190;132;255m9.0e10\u001b[38;2;248;248;242m,\u001b[49G\u001b[38;2;190;132;255m8.0e10\u001b[38;2;248;248;242m]\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[16G\u001b[38;2;166;226;46msun:\u001b[38;2;248;248;242m      \u001b[27G    \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
