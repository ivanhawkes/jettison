[0.185, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 102 -\u001b[38;2;248;248;242m// The sample galaxy (\u001b[48;2;92;2;0msource/samples/space/assets/\u001b[48;2;61;1;0msystems/galaxy.yaml): Halcyon to Vesper in 40 s,    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 102 +\u001b[38;2;117;113;94m// The \u001b[48;2;4;71;0mretired space \u001b[48;2;2;40;0msample\u001b[48;2;4;71;0m's\u001b[48;2;2;40;0m galaxy (\u001b[48;2;4;71;0mits \u001b[48;2;2;40;0msystems/galaxy.yaml): Halcyon to Vesper in 40 s,\u001b[38;2;248;248;242m            \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m103 \u001b[12G\u001b[22m\u001b[38;2;117;113;94m// Vesper to Marrow in 65.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 104 \u001b[22m \u001b[38;2;249;38;114minline\u001b[39m Celestial::Galaxy \u001b[38;2;166;226;46mSample\u001b[38;2;253;151;31m()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 105 \u001b[22m {\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/space/tests/Halcyon.h)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m16\u001b[11G\u001b[22m\u001b[38;2;249;38;114minline\u001b[39m \u001b[38;2;166;226;46mconst\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46muint64_t\u001b[39m kHalcyon = Sim::FrameId(\u001b[38;2;230;219;116m\"Halcyon\"\u001b[39m);\u001b[K\r\u001b[6C\u001b[1B\u001b[2m17\u001b[11G\u001b[22m\u001b[38;2;249;38;114minline\u001b[39m \u001b[38;2;166;226;46mconstexpr\u001b[39m \u001b[38;2;166;226;46mstd\u001b[39m::string_view kStatio\u001b[53G = \u001b[38;2;230;219;116m\"Ostra Highport\"\u001b[39m;\u001b[K\r\u001b[6C\u001b[1B\u001b[2m18\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 19 -\u001b[38;2;248;248;242m// Halcyon as \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m system file \u001b[48;2;92;2;0mhas\u001b[48;2;61;1;0m it (\u001b[48;2;92;2;0msource/samples/space/assets/\u001b[48;2;61;1;0msystems/halcyon.yaml): a Sun-like    \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 19 +\u001b[38;2;117;113;94m// Halcyon as \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mretired space sample's \u001b[48;2;2;40;0msystem file \u001b[48;2;4;71;0mhad\u001b[48;2;2;40;0m it (systems/halcyon.yaml): a Sun-like\u001b[38;2;248;248;242m         \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 20 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// star, an Earth-like planet a hundred and fifty million kilometres out, and a station in low orbit\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 21 \u001b[22m \u001b[38;2;117;113;94m// over it, so the station moves at 7.7 km/s about the planet and 30 km/s about the star.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 22 \u001b[22m \u001b[38;2;249;38;114minline\u001b[39m Celestial::StarSystem \u001b[38;2;166;226;46mHalcyon\u001b[38;2;253;151;31m()\u001b[39m\u001b[K\r\u001b[2C\u001b[2BRunn\u001b[11G\u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ cd '/h\u001b[15Gme/iva\u001b[22G/projects/jetti\u001b[38Gon' && ls scripts | grep -i format; git status --short | head -30\r\u001b[11C\u001b[2B6m 24s\u001b[19G· ↓\u001b[39m \u001b[38;2;153;153;153m26.5k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
