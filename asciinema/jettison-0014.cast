[0.109, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1BBoth match the plan's p\u001b[27Gedictions (4.49 days with the boost;\u001b[64Gabout 5.7% and 13.9 days\u001b[89Gfor\u001b[93Gthe\u001b[97Gfull\u001b[102Ghold).\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat the test checks:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefuelling:\u001b[22m each run\u001b[26Gl\u001b[29Gves Ore with its\u001b[46Gt\u001b[48Gnks 16 totes\u001b[61Gshort\u001b[67Gand refuels\u001b[79Gfull.\u001b[85GThe\u001b[89Gfall\u001b[94Gin\u001b[97Gthe\u001b[101Gtanks\u001b[107Gequals\u001b[114Gthe\r\u001b[4C\u001b[1Bfuel t\u001b[12Ge job records for charging to the lot, and \u001b[56Ghe cruise flies the job's thrust.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFast-forward against stepping:\u001b[22m at\u001b[39G60 steps a second,\u001b[58Ga\u001b[60Gcruise\u001b[67Gis\u001b[70Gabout\u001b[76G24\u001b[79Gmillion\u001b[87Gsteps\u001b[93Gand\u001b[97Gcan't\u001b[103Gbe\u001b[106Gstepped\u001b[114Gwhole.\r\u001b[4C\u001b[1BSo stepping\u001b[17Gis\u001b[20Gcompared\u001b[29Gwith\u001b[34Gfast-forward\u001b[47Gover\u001b[52Gtwo\u001b[56Gminutes\u001b[64Garound\u001b[71Geach\u001b[76Gchange\u001b[83Gof\u001b[86Gthrust:\u001b[94Gthe\u001b[98Gend\u001b[102Gof\u001b[105Gthe\u001b[109Glight\u001b[115Grun's\r\u001b[4C\u001b[1Bboost,\u001b[12Gand the point where the heavy run stops thrusting and star\u001b[71Gs to coast.\u001b[83GThey\u001b[88Gmatch\u001b[94Gto\u001b[97Gthe\u001b[101Gbyte.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSave mid-coast:\u001b[21G\u001b[22ma\u001b[23Gsave\u001b[28Gloaded\u001b[35Ghalfway\u001b[43Gthrough\u001b[51Gthe\u001b[55Gheavy\u001b[61Grun\u001b[65Gdocks\u001b[71Gto\u001b[74Gthe\u001b[78Gsame\u001b[83Gbytes.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefusal:\u001b[14G\u001b[22mdocked\u001b[21Galmost\u001b[28Gdry,\u001b[33Ga\u001b[35Gleg\u001b[39Gback\u001b[44Gis\u001b[47Grefused\u001b[55G\u001b[38;2;177;185;249mInsufficientFuel\u001b[72G\u001b[39mwith\u001b[77Grefuelli