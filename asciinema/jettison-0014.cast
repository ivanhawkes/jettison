\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 471 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m// The reach measured where the bodies are as the ship's Transform has it (Physics::PlacedAt),\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;117;113;94m a\u001b[38;2;248;248;242m                                                                                               \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m472\u001b[20G\u001b[38;2;117;113;94m// step on from t0 for a cruise applied after physics, as a station's frame moves hundreds of\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 473 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m// metres a step with its planet. The course keeps t0, as the cruise's steps count from it.\u001b[38;2;248;248;242m   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 474 +\u001b[38;2;248;248;242m        \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m placed = m_physics.\u001b[38;2;166;226;46mPlacedAt\u001b[38;2;248;248;242m().\u001b[38;2;166;226;46mvalue_or\u001b[38;2;248;248;242m(t0);                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 475 +\u001b[38;2;248;248;242m        \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::vector<Celestial::SystemPosition> placedBodies =                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 476 +\u001b[38;2;248;248;242m            placed == t0 ? bodies : Celestial::\u001b[38;2;166;226;46mEvaluateSystem\u001b[38;2;248;248;242m(system, placed);                        \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m77\u001b[20G\u001b[22m\u001b[38;2;249;38;114mfor\u001b[39m (std::\u001b[38;2;166;226;46msize_t\u001b[39m station = \u001b[38;2;190;132;255m0\u001b[39m; station <\u001b[60Gsystem.bodies.\u001b[38;2;166;226;46msize\u001b[39m();\u001b[82G++station)\r\u001b[7C\u001b[1B\u001b[2m78\u001b[20G\u001b[22m     \u001b[26G  \u001b[38;2;249;38;114mif\u00