[0.540, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gwritten\u001b[16Gthe\u001b[20Gdecoupling\u001b[31Gplan\u001b[36Gas\u001b[39G\u001b[38;2;177;185;249mdocs/space-extraction-plan.md\u001b[69G\u001b[39min\u001b[72GJettison\u001b[81Gand\u001b[85Gadded\u001b[91Ga\u001b[93Groadmap\u001b[101Grow\u001b[105Gfor\u001b[109Git,\u001b[113Gpushed\r\u001b[1B \u001b[3Gas Jett\u001b[11Gson \u001b[38;2;177;185;249mea90b79\u001b[39m. It's planning only: no code has moved.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule it applies:\u001b[24G\u001b[22mthe\u001b[28Gengine\u001b[35Gkeeps\u001b[41Ga\u001b[43Gconcept\u001b[51Gonly\u001b[56Gif\u001b[59Git\u001b[62Ghas\u001b[66Ga\u001b[68Gneutral\u001b[76Gname\u001b[81Gand\u001b[85Gis\u001b[88Guseful\u001b[95Gin\u001b[98Gmore\u001b[103Gthan\u001b[108Gone\u001b[112Ggenre.\r\u001b[2C\u001b[1BWhat only space uses\u001b[24Gmoves to Manife\u001b[40Gt if Manifest uses\u001b[61G, or\u001b[66Gto the space sample if only the\u001b[98Gsample does. Th\u001b[114G sample\r\u001b[2C\u001b[1Bis rebuilt on the neutral pieces, as you chose (option 2).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat stays, under neutral names:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTransit:\u001b[22m an entity leaves physics,\u001b[40Gfollows\u001b[48Ga\u001b[50Gpath\u001b[55Gthe\u001b[59Ggame\u001b[64Ggives\u001b[70Gat\u001b[73Ga\u001b[75Gset\u001b[79Gspeed\u001b[85Gprofile,\u001b[94Gcan\u001b[98Gbe\u001b[101Gfast-forwarded\u001b[116Gand\r\u001b[2C\u001b[1B \u001b[5Gsaved mid-way, and\u001b[24Gcomes out \u001b[35Gomewhere clear.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMotion profiles:\u001b[22m today'\u001b[30Gcrui\u001b[35Ge profiles (\u001b[48Gccelerate,\u001b[59Gcoast,\u001b[66Gdecelerate).\r\u001b[4C\u001b[1B\u001b[1mP\u001b[7Grtals:\u001b[22m today's\u001b[22Gjump lanes.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSlo\u001b[9Gs:\u001b[22m the queue\u001b[22Gand reservations\u001b[39Gbehind\u001b[46Gtoday's\u001b[54Ggates\u001b[60Gand\u001b[64Gpads.\r\u001b[4C\u001b[1B\u001b[1mTrigger volumes:\u001b[22G\u001b[22mto\u001b[25Gay'\u001b[29G gate rings.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mBerths:\u001b[22m today's docks.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mUnchanged:\u001b[22m vehicle handling,\u001b[34Gsteering,\u001b[44Gframes,\u001b[52Gpaths\u001b[58Gthings\u001b[65Gride\u001b[70Gon,\u001b[74Gatmosphere\u001b[85Gand\u001b[89Glarge-world\u001b[101Gprecision.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat moves:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTo\u001b[8GManifest:\u001b[18G\u001b[22morbits,\u001b[26Gstar\u001b[31Gsystems,\u001b[40Gthe\u001b[44Ggalaxy,\u001b[52Gthe\u001b[56Gcourse\u001b[63Gplanning\u001b[72Ground\u001b[78Gplanets,\u001b[87Gand\u001b[91Gthe\u001b[95Gdrives'\u001b[103Gpower-law\u001b[113Gtiming\r\u001b[2C\u001b[1B \u001b[5Gthat Astralis uses. \u001b[26G    \u001b[31G        \u001b[40G   \u001b[44G   \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.352, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gas Jett\u001b[11Gson \u001b[38;2;177;185;249mea90b79\u001b[39m. It's planning only: no code has moved.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe rule it applies:\u001b[24G\u001b[22mthe\u001b[28Gengine\u001b[35Gkeeps\u001b[41Ga\u001b[43Gconcept\u001b[51Gonly\u001b[56Gif\u001b[59Git\u001b[62Ghas\u001b[66Ga\u001b[68Gneutral\u001b[76Gname\u001b[81Gand\u001b[85Gis\u001b[88Guseful\u001b[95Gin\u001b[98Gmore\u001b[103Gthan\u001b[108Gone\u001b[112Ggenre.\r\u001b[2C\u001b[1BWhat only space uses\u001b[24Gmoves to Manife\u001b[40Gt if Manifest uses\u001b[61G, or\u001b[66Gto the space sample if only the\u001b[98Gsample does. Th\u001b[114G sample\r\u001b[2C\u001b[1Bis rebuilt on the neutral pieces, as you chose (option 2).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat stays, under neutral names:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTransit:\u001b[22m an entity leaves physics,\u001b[40Gfollows\u001b[48Ga\u001b[50Gpath\u001b[55Gthe\u001b[59Ggame\u001b[64Ggives\u001b[70Gat\u001b[73Ga\u001b[75Gset\u001b[79Gspeed\u001b[85Gprofile,\u001b[94Gcan\u001b[98Gbe\u001b[101Gfast-forwarded\u001b[116Gand\r\u001b[2C\u001b[1B \u001b[5Gsaved mid-way, and\u001b[24Gcomes out \u001b[35Gomewhere clear.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMotion profiles:\u001b[22m today'\u001b[30Gcrui\u001b[35Ge profiles (\u001b[48Gccelerate,\u001b[59Gcoast,\u001b[66Gdecelerate).\r\u001b[4C\u001b[1B\u001b[1mP\u001b[7Grtals:\u001b[22m today's\u001b[22Gjump lanes.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSlo\u001b[9Gs:\u001b[22m the queue\u001b[22Gand reservations\u001b[39Gbehind\u001b[46Gtoday's\u001b[54Ggates\u001b[60Gand\u001b[64Gpads.\r\u001b[4C\u001b[1B\u001b[1mTrigger volumes:\u001b[22G\u001b[22mto\u001b[25Gay'\u001b[29G gate rings.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mBerths:\u001b[22m today's docks.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mUnchanged:\u001b[22m vehicle handling,\u001b[34Gsteering,\u001b[44Gframes,\u001b[52Gpaths\u001b[58Gthings\u001b[65Gride\u001b[70Gon,\u001b[74Gatmosphere\u001b[85Gand\u001b[89Glarge-world\u001b[101Gprecision.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat moves:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTo\u001b[8GManifest:\u001b[18G\u001b[22morbits,\u001b[26Gstar\u001b[31Gsystems,\u001b[40Gthe\u001b[44Ggalaxy,\u001b[52Gthe\u001b[56Gcourse\u001b[63Gplanning\u001b[72Ground\u001b[78Gplanets,\u001b[87Gand\u001b[91Gthe\u001b[95Gdrives'\u001b[103Gpower-law\u001b[113Gtiming\r\u001b[2C\u001b[1B \u001b[5Gthat Astralis uses.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTo the sample:\u001b[22m the star-system\u001b[36Gscene\u001b[42Gcode,\u001b[76Gbuggies,\u001b[85Groads),\u001b[93Gwhich\u001b[99GManifest\u001b[108Gdoesn't\u001b[116Guse.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
