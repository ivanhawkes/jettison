[0.024, "o", "\u001b[?25l\u001b[H     \u001b[2m 1 \u001b[22m \u001b[38;2;117;113;94m# Jettison feature-base, pinned rather than following main or a moving branch.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m2\u001b[12G\u001b[22m\u001b[38;2;117;113;94mUpdating\u001b[21Gthis commit and th\u001b[40G development she\u001b[58G is one SDK ch\u001b[73Gnge. Fetch the engine\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;117;113;94mfirs\u001b[17G: EnTT, yaml-cpp and doct\u001b[43Gst must be its targets, never second copies h\u001b[89Gre.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 4 -\u001b[38;2;248;248;242mset(MANIFEST_JETTISON_REVISION a9b830558d9f7d39f774bdedf9b62dc057835a34)                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 4 +\u001b[38;2;249;38;114mset\u001b[38;2;248;248;242m(MANIFEST_JETTISON_REVISION \u001b[38;2;190;132;255m2\u001b[38;2;248;248;242mb3cfced17393e18cfca117a8ed50a26c0db4bea)                                \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 5 \u001b[22m \u001b[38;2;249;38;114mset\u001b[39m(JETTISON_SOURCE_DIR \u001b[38;2;230;219;116m\"\"\u001b[39m CACHE PATH \u001b[38;2;230;219;116m\"Use a local Jettison checkout instead of the pinned revision\"\u001b[39m)\u001b[K\r\u001b[6C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[38;2;249;38;114mif\u001b[39m(\u001b[38;2;249;38;114mNOT\u001b[39m \u001b[38;2;249;38;114mTARGET\u001b[39m Jettison::\u001b[38;2;249;38;114mMath\u001b[39m)\u001b[K\r\u001b[6C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;2;249;38;114mif\u001b[39m(JETTISON_SOURCE_DIR)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gnotes\u001b[13Gabove\u001b[19Gcome\u001b[24Gfrom\u001b[29Gmy\u001b[32Gown\u001b[36Gstash,\u001b[43Gas\u001b[46Gexpected.\u001b[56GOn\u001b[59Gthe\u001b[63Gpin\u001b[67Galone,\u001b[74Gtwo\u001b[78GManifest\u001b[87Gsuites\u001b[94Gfail.\u001b[100GChecking\u001b[109Gwhether\u001b[117Gonly\r\u001b[1B \u001b[3Gpinned hashes moved:\u001b[24G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Only the two pinned state hashes moved; every other check held. To show the cause, I'll revert only \u001b[38;2;177;185;249mClearOf\u001b[39m's time in\u001b[K\r\u001b[2C\u001b[1Bthe fetched engine copy and check whether the old pins hold again:\r\u001b[40C\u001b[2B\u001b[38;2;153;153;153mthought for 5s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
