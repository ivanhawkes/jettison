[0.092, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242mifest's W21, for                                                                                      \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m164 \u001b[22m   departures, arrivals and cruis\u001b[45Gs s\u001b[49Garing one\u001b[59Gl\u001b[61Gne betwe\u001b[70Gn the five stations\u001b[90Gof\u001b[93GOre's\u001b[99Gone\u001b[103Gorbit,\u001b[110Gwhic\r\u001b[6C\u001b[1B\u001b[2m \u001b[9G  \u001b[22m h\u001b[K\r\u001b[6C\u001b[1B\u001b[2m165 \u001b[14G\u001b[22mits\u001b[18Gpolicies\u001b[27Ghop\u001b[31Ground.\u001b[38GMeasured\u001b[47Gfirst\u001b[53Gon\u001b[56Gthe\u001b[60Gengine\u001b[67Gas\u001b[70Git\u001b[73Gis,\u001b[77Gby\u001b[80GManifest's\u001b[91G`fixture_traffic`:\u001b[110Gsix\r\u001b[6C\u001b[1B\u001b[2m166 \u001b[22m   sta\u001b[18Gters flown both ways between Ore Highport and Vale,\u001b[70Gtwo\u001b[74Gsent\u001b[79Gin\u001b[82Gone\u001b[86Gstep\u001b[91Gas\u001b[94Ga\u001b[96Gpolicy\u001b[103Gsends\u001b[109Gthem\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/roadmap.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[2m 170 \u001b[22m   stations move some 15° an hour, so the two ways' courses in one hour are 5,400 km apart. What is\u001b[K\r\u001b[1B     \u001b[2m 171 \u001b[22m   shared: ships going the same way fly one line 6 to 70 m apart, kept apart by leaving seconds after\u001b[K\r\u001b[1B     \u001b[2m 172 \u001b[22m   one another, and a departure passes some 800 m from an arrival; a station's pads bound how many\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 173 -\u001b[38;2;248;248;242m  leave at once. Taken up when `fixture_traffic` fails\u001b[48;2;92;2;0m,\u001b[48;2;61;1;0m or \u001b[48;2;92;2;0mwhen \u001b[48;2;61;1;0mtraffic it does not cover asks (a     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 173 +\u001b[38;2;248;248;242m  leave at once. Taken up \u001b[48;2;4;71;0mafter that decoupling, \u001b[48;2;2;40;0mwhen `fixture_traffic` fails or traffic it does not c\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242mover asks (a                                                                                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 174 \u001b[14G\u001b[22mstation\u001b[22Gof\u001b[25Gmore\u001b[30Gpads,\u001b[36Glarger\u001b[43Ghulls,\u001b[50Ga\u001b[52Gbusier\u001b[59Gorbit),\u001b[67Gon\u001b[70Gthe\u001b[74Gdesign\u001b[81Gsettled\u001b[89Gwith\u001b[94Gthe\u001b[98Guser:\u001b[104Gevery\r\u001b[1B \u001b[3G   \u001b[2m 175 \u001b[22m  \u001b[14Gcruis\u001b[20G from a station flying one of sev\u001b[54Gral lanes\u001b[64Geach\u001b[69Gway,\u001b[74Gkept\u001b[79Gto\u001b[82Gthe\u001b[86Gright\u001b[92Gof\u001b[95Gits\u001b[99Gway\u001b[103Gas\u001b[106Groads\r\u001b[1B     \u001b[2m 176 \u001b[22m   and Freelancer's paired trade lanes do, held as pads are and kept from gate to gate, departures\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRecalling \u001b[1m1\u001b[22m memory, writing \u001b[1m2\u001b[22m memories…\u001b[K\r\u001b[20C\u001b[8B\u001b[38;2;0;204;204m1\u001b[38G\u001b[38;2;153;153;153m · esc to inter\u001b[54Gupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
