[0.076, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe baseline \u001b[17Gable is in, with\u001b[34Gt\u001b[36Ge closest\u001b[46Gapproach\u001b[55Gat\u001b[58G198\u001b[62Gm,\u001b[65Gbut\u001b[69Gper-step\u001b[78Gsampling\u001b[87Gcan\u001b[91Gmiss\u001b[96Gpasses\u001b[103Gmid-cruise\u001b[114Gand\u001b[118Gno\r\u001b[2C\u001b[1Bdeparture overlapped an arrival. I'm adding a check for closest approach between steps and two ships leaving Highport\r\u001b[2C\u001b[1Bas\u001b[6Gtwo others arrive.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/source/test/FixtureTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m41\u001b[15G\u001b[22mlines, removed\u001b[30G\u001b[1m18\u001b[33G\u001b[22mlines\r\u001b[5C\u001b[1B\u001b[2m 1258 \u001b[13G\u001b[22m{\r\u001b[8C\u001b[1B\u001b[2m59\u001b[15G\u001b[22mHosted hosted{MANIFEST_MOD_DIRECTORY};\r\u001b[8C\u001b[1B\u001b[2m60\u001b[15G\u001b[22mstd::vector<Flown> ships;\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 1261 -\u001b[38;2;248;248;242m  for (const std::string principal : {\"Ada\", \"Bo\", \"Cy\", \"Di\"})                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1261 +\u001b[38;2;248;248;242m  \u001b[38;2;249;38;114mfor\u001b[38;2;248;248;242m (\u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m std::string principal : {\u001b[38;2;230;219;116m\"Ada\"\u001b[38;2;248;248;242m, \u001b[38;2;230;219;116m\"Bo\"\u001b[38;2;248;248;242m, \u001b[38;2;230;219;116m\"Cy\"\u001b[38;2;248;248;242m, \u001b[38;2;230;219;11