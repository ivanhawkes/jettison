[0.082, "o", "\u001b[?25l\u001b[H\u001b[5Gcompany's last prices when the ship docks, the same way transit life support is.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEstimates at a burn:\u001b[22m \u001b[38;2;177;185;249mPolicy::EstimateRoute\u001b[39m replaces \u001b[38;2;177;185;249mCharges\u001b[39m. Each leg's fuel is priced by everything aboard plus\u001b[118Gthe\r\u001b[4C\u001b[1Blot's own mass. Each venue the ship refuels at is priced at its reported ask, and anywhere else at the last price\r\u001b[4C\u001b[1Bpaid. The\u001b[15Gestimate also gives the route's time \u001b[53Gnd whet\u001b[61Ger the\u001b[68Gtanks\u001b[74Gcan\u001b[78Gfly\u001b[82Git.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChoosing per hour:\u001b[24G\u001b[22mthe policy\u001b[35Gtries\u001b[41Gthe\u001b[45Gtrade\u001b[51Gat\u001b[54G100%,\u001b[60G50%,\u001b[65G25%\u001b[69Gand\u001b[73G10%\u001b[77Gthrust,\u001b[85Gplus\u001b[90Gthe\u001b[94Gmost\u001b[99Gthe\u001b[103Gtanks\u001b[109Gallow\u001b[115Gwhen\u001b[120Ga\r\u001b[4C\u001b[1Blisted\u001b[12Gthrust\u001b[19Gwon't fit. It takes the highest estimate per hour. \u001b[38;2;177;185;249mPolicy.Set\u001b[39m version\u001b[89G2\u001b[91Gadds\u001b[96G\u001b[38;2;177;185;249mthrustBps\u001b[39m,\u001b[107Gso\u001b[110Gan\u001b[113Gowner\r\u001b[4C\u001b[1Bcan fix\u001b[13Gone\u001b[17Gthrust\u001b[24Gfor\u001b[28Gevery\u001b[34Gleg.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTest results:\u001b[17G\u001b[22m48\u001b[20Gof\u001b[23G51\u001b[26Gsuites\u001b[33Gpass.\u001b[39GTwo\u001b[43Gfailures\u001b[52Gare\u001b[56Gthe\u001b[60Gexpected\u001b[69Gchange\u001b[76Gin\u001b[79Gwhat\u001b[84Ga\u001b[86Gpolicy\u001b[93Gpicks.\u001b[100GPer\u001b[104Ghour,\u001b[110Gshort\u001b[116Ghops\r\u001b[2C\u001b[1Bbetween Ore's\u001b[17Gstations now be\u001b[33Gt the 4.6-day runs\u001b[52Gto Brine, so Ada's first\u001b[77Gjob\u001b[81Gis\u001b[84Glentils\u001b[92Gfrom\u001b[97GOre\u001b[101GHighport\u001b[110Gto\u001b[113GOre\u001b[117GVale\r\u001b[2C\u001b[1Binstead of copper to Brine. Those checks and the pinned state hash need restating.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe third is a real bug in Jettison, which the short hops expose.\u001b[69G\u001b[22mShips\u001b[75Gleaving\u001b[83GOre\u001b[87GVale\u001b[92Gnever\u001b[98Gstart\u001b[104Gtheir\u001b[110Gcruise:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mSpace::ClearOf\u001b[20G\u001b[39mand the cruise's \"too near a\u001b[49Gstation\"\u001b[58Gcheck\u001b[64Gmeasure\u001b[72Gfrom\u001b[77Gthe\u001b[81Gstation's\u001b[91Gorbital\u001b[99Gposition.\r\u001b[2C\u001b[1B-\u001b[5GEach station\u001b[18Gis actually\u001b[30Gplaced\u001b[37Gabout\u001b[43G520\u001b[47Gm\u001b[49Gfrom\u001b[54Gthat\u001b[59Gposition.\r\u001b[2C\u001b[1B-\u001b[5GSo\u001b[8Gthe\u001b[12Gship\u001b[17Greaches\u001b[25Gthe\u001b[29Gclear\u001b[35Gpoint\u001b[41G3,063\u001b[47Gm\u001b[49Gfrom\u001b[54Gthe\u001b[58Gstation,\u001b[67Gbut\u001b[71Gby\u001b[74Gthe\u001b[78Gcheck\u001b[84Git\u001b[87Gis\u001b[90Gonly\u001b[95G2,543\u001b[101Gm\u001b[103Gout,\u001b[108Ginside\u001b[115Gthe\r\u001b[1B \u001b[3G  2,763\u001b[11Gm\u001b[13Greach.\u001b[K\r\u001b[1B  - \u001b[38;2;177;185;249mClearOf\u001b[39m then keeps handing it the same flight, so the ship sits there for good. Leaving Highport only worked\u001b[114Gbecause\r\u001b[4C\u001b[1Bthe\u001b[9Gway\u001b[13Gout\u001b[17Ghappened\u001b[26Gto\u001b[29Gpoint\u001b[35Gaway\u001b[40Gfrom\u001b[45Gthe\u001b[49Goffset.\r\u001b[1B\u001b[K\r\u001b[1B  The fix goes in Jettison: one reference point for the\u001b[57Greach\u001b[63Gcheck,\u001b[70Gthe\u001b[74Gclear\u001b[80Gpoint\u001b[86Gand\u001b[90Gthe\u001b[94Gcruise's\u001b[103Gcheck,\u001b[110Gplus\u001b[115Ga\u001b[117Gtest\u001b[27;1H\u001b[24;3H\u001b[?25h"]
