[0.038, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m2\u001b[10G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22mManifest's W21 policies, choosing a trad\u001b[51G per hour, sent ships between the\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[13G\u001b[22mtions of Ore's one orbit, and\u001b[45Gose leaving Ore V\u001b[63Gl\u001b[65G for Highport \u001b[81G Steppe\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22mstayed at the point ClearOf\u001b[38Gflew them\u001b[48Gto. Physics places every\u001b[73GTransfor\u001b[83Gfor\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22mth\u001b[13G step's end, so a sy\u001b[34Gtem after it,\u001b[48Gas Manifest's travel \u001b[70Gs, sees\u001b[78Gthem a\u001b[85G\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mstep\u001b[15Gon from the cl\u001b[30Gck's Now; ClearOf measured the\u001b[61Gs\u001b[63Gip against the bodies\u001b[85Gat\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mNow, when Ore\u001b[24Gwas som\u001b[33G500 m back\u001b[44Gon its way round the st\u001b[68Gr, and\u001b[75Gfound the\u001b[K\r\u001b[6C\u001b[1B\u001b[2m 9\u001b[10G\u001b[22mship, 3,063 m\u001b[25Grom \u001b[30Ghe station as\u001b[44Gplaced,\u001b[52G2,543\u001b[58Gm\u001b[60Gout\u001b[64Gof\u001b[67Ga\u001b[69G2,763\u001b[75Gm\u001b[77Greach.\u001b[84GIt\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22mgave the\u001b[19Gsame\u001b[24Gflight\u001b[31Gagain,\u001b[38Gevery\u001b[44Gstep.\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +14 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, ran \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe \u001b[8Gngi\u001b[12Ge\u001b[14Gis pushed as \u001b[38;2;177;185;249m2b3cfce\u001b[39m.\u001b[36GNext is the Manifest\u001b[57Gpin mov\u001b[65G as\u001b[69Gits\u001b[73Gown\u001b[77Gcommit.\u001b[85GFirst\u001b[91GI'll\u001b[96Gcheck\u001b[102Gthat\u001b[107GManifest's\r\u001b[2C\u001b[1Bsuites\u001b[10Gand\u001b[14Gpinned\u001b[21Ghashes\u001b[28Ghold\u001b[33Gon\u001b[36Git\u001b[39Gwithout\u001b[47Gthe\u001b[51Gslice\u001b[57G4\u001b[59Gchanges:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd ../manifest && cmake --preset clang-debug > /d…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest\u001b[23G&& cmake --pres\u001b[39Gt clang-debug > /dev/n\u001b[62Gll 2>&1; cmake --build --preset clang-debug 2>&1 | grep -E \r\u001b[5C\u001b[1B\"error|FAILED\" | head; ctest --test-dir build/clang-debug -j24 2>&1 | tail -8 (23s)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[39m \u001b[38;2;218;124;92mIdeating…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Move Manifest\u001b[28Gpin alone and test ·\u001b[49G16m 2s\u001b[56G· ↓\u001b[39m \u001b[38;2;153;153;153m43.4k\u001b[66Gtokens)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
