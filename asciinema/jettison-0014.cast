[0.063, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe ship reaches the\u001b[24Gclear\u001b[30Gpoint\u001b[36G(3,063\u001b[43Gm\u001b[45Gout,\u001b[50Gexactly\u001b[58Gthe\u001b[62Greach\u001b[68Gplus\u001b[73Gthe\u001b[77Gmargin)\u001b[85Gand\u001b[89Gthen\u001b[94Gsits\u001b[99Gthere\u001b[105Gfor\u001b[109Ggood.\r\u001b[2C\u001b[1BReading\u001b[11Ghow\u001b[15Gtravel\u001b[22Gdecides\u001b[30Gwhen\u001b[35Gto\u001b[38Gadvance\u001b[46Ga\u001b[48Gclearing\u001b[57Gleg:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mRunning arrivals, departures, and cruising on the same rails is going to lead to collisions. You need to spread them \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mout or give the rails an inwards / outward direction and have multiples of them.\u001b[39m                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTwo ships leaving\u001b[21GOre\u001b[25GVale\u001b[30Gboth\u001b[35Gstall\u001b[41Gat\u001b[44Gtheir\u001b[50Gclear\u001b[56Gpoints,\u001b[64Gand\u001b[68GOre's\u001b[74Gfive\u001b[79Gstations\u001b[88Gshare\u001b[94Gone\u001b[98Gorbit,\u001b[105Gso\u001b[108GI'm\u001b[112Gchecking\r\u001b[2C\u001b[1Bwhether\u001b[11Gthe\u001b[15Gstall\u001b[21Gcomes\u001b[27Gfrom\u001b[32Gthat\u001b[37Gshared-path\u001b[49Gconflict.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd ../manifest && c\u001b[31Gake --build \u001b[44G-preset c\u001b[54Gang-de…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && cmake --build --preset clang-debug 2>&1 | grep -E \"error\" -A3 | head -20; ctest --test-dir \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mbuild/clang-debug -R '^fixture_alone$' --output-on-failure 2>&1 | grep -