[0.003, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've update\u001b[15G \u001b[17Ghe\u001b[20Gplan to keep\u001b[33Gjump lanes and\u001b[48Ggates,\u001b[55Gpushed\u001b[62Gas\u001b[65GJettison\u001b[74G\u001b[38;2;177;185;249m7bfe72c\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJump lanes become portals.\u001b[32G\u001b[22mAn\u001b[35Gentity\u001b[42Gleaves\u001b[49Gits\u001b[53Gframe\u001b[59Gfor\u001b[63Ga\u001b[65Gset\u001b[69Gtime\u001b[74Gand\u001b[78Gappears\u001b[86Gat\u001b[89Ga\u001b[91Gnamed\u001b[97Gexit\u001b[102Gin\u001b[105Gany\u001b[109Gframe,\r\u001b[1B \u001b[3G  includ\u001b[12Gng the frame it left, which covers\u001b[47Gyour\u001b[52Gshort\u001b[58Gjumps\u001b[64Gwithin\u001b[71Gone\u001b[75Gsystem.\r\u001b[1B  - \u001b[1mGates become gated portals.\u001b[22m A ship enters through a trigger\u001b[65Gvolume\u001b[72Gonce\u001b[77Gits\u001b[81Gplace\u001b[87Gin\u001b[90Gthe\u001b[94Gslot\u001b[99Gqueue\u001b[105G(the\u001b[110Gsame\r\u001b[4C\u001b[1Bmechanism as pads) cle\u001b[28Grs\u001b[31Git, and the game's charge rule (today's \u001b[38;2;177;185;249mTollRule\u001b[39m)\u001b[81Gapplies\u001b[89Gthe\u001b[93Gtoll.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe galaxy and routes move to Manifest\u001b[22m,\u001b[45Gwhich\u001b[51Groutes\u001b[58Gover\u001b[63Gits\u001b[67Gown\u001b[71Ggraph\u001b[77Gwith\u001b[82Gthe\u001b[86Gengine's\u001b[95Gexisting\u001b[104Gpathfinding.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mChanges to the slices:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- Slice 2 no longer deletes the ju\u001b[40Gp l\u001b[44Gnes and\u001b[52Ggates;\u001b[59Git \u001b[63Goves their suites off\u001b[85Gthe\u001b[89Gsample's\u001b[98Ggalaxy\u001b[105Gonto\u001b[110Gtwo\u001b[114Gtest\r\u001b[5C\u001b[1B frames of their own.\u001b[28G\u001b[K\r\u001b[4C\u001b[1B- Slice 4\u001b[15Gnow\u001b[19Gbuilds\u001b[26Gt\u001b[28Ge n\u001b[32Gutral port\u001b[43Gls and gated portals next\u001b[69Gt\u001b[71G \u001b[73Gransit and\u001b[84Gslots,\u001b[91Gand\u001b[95Grebuilds\u001b[104Gtoday's\u001b[112Glanes\u001b[118Gand\r\u001b[5C\u001b[1B gates on them without moving a Manif\u001b[46G pin.\u001b[52G\u001b[K\r\u001b[4C\u001b[1B- Slice 6 moves the\u001b[25Ggalaxy and routes\u001b[43Gto\u001b[46GManifest\u001b[55Galong\u001b[61Gwith\u001b[66Gthe\u001b[70Gorbits.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTesting:\u001b[14G\u001b[22mportals\u001b[22Gare\u001b[26Gtested\u001b[33Gin\u001b[36Gthe\u001b[40Gengine\u001b[47Gwith\u001b[52Ga\u001b[54Gdoor\u001b[59Gbetween\u001b[67Gtwo\u001b[71Gframes,\u001b[79Ga\u001b[81Gdoor\u001b[86Gwithin\u001b[93Gone\u001b[97Gframe\u001b[103Gand\u001b[107Ga\u001b[109Gtoll\u001b[114Gbooth,\r\u001b[4C\u001b[1Buntil Manifest's stargates exercise them in pl\u001b[52Gy.\u001b[K\r\u001b[2B \u001b[3GTwo questions remain open: whether this\u001b[43Ggoes before or after W12,\u001b[69Gand\u001b[73Gwhether\u001b[81Gplanetary\u001b[91Grings\u001b[97Gstay\u001b[102Gin\u001b[105Gthe\u001b[109Grenderer\u001b[118Gas\r\u001b[1B  the one named exception, which I\u001b[36Grecommend.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 37s ·\u001b[20Gdone 7:11 pm\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
