[0.093, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 28 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 29 \u001b[22m \u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<manifest/company/Company.h>\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 30 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m#\u001b[38;2;249;38;114minclude\u001b[38;2;117;113;94m \u001b[38;2;230;219;116m<manifest/host/Start.h>\u001b[39m\u001b[K\r\u001b[2B  \u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gship\u001b[12Greaches\u001b[20Gthe\u001b[24Gclear\u001b[30Gpoint\u001b[36G(3,063\u001b[43Gm\u001b[45Gout,\u001b[50Gexactly\u001b[58Gthe\u001b[62Greach\u001b[68Gplus\u001b[73Gthe\u001b[77Gmargin)\u001b[85Gand\u001b[89Gthen\u001b[94Gsits\u001b[99Gthere\u001b[105Gfor\u001b[109Ggood.\r\u001b[2C\u001b[1BReading how travel\u001b[22Gdecides\u001b[30Gwhen\u001b[35Gto\u001b[38Gadvance\u001b[46Ga\u001b[48Gclearing\u001b[57Gleg:\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mRunning arrivals, departures, and cruising on the same rails is going to lead to collisions. You need to spread them \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mout or give the rails an inwards / outward direction and have multiples of them.\u001b[39m                                      \r\u001b[2B\u001b[49m \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTwo ships leaving Ore Vale both stall at their clear points, and Ore's five stations share one orbit, so I'm checking\r\u001b[2C\u001b[1Bwhether the stall comes from that shared-path conflict.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[8B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
