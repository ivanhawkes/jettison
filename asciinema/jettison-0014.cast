39m(\u001b[38;2;177;185;249mai/Types.h\u001b[39m)\u001b[30Gholds\u001b[36Gabout\u001b[42G15\u001b[45Gvalues\u001b[52Gthat\u001b[57Gonly\u001b[62Gspace\u001b[68Guses,\u001b[74Gsuch\u001b[79Gas\u001b[82G\u001b[38;2;177;185;249mNearStation\u001b[39m,\u001b[95G\u001b[38;2;177;185;249mOnLane\u001b[102G\u001b[39mand\u001b[106G\u001b[38;2;177;185;249mNoGalaxy\u001b[39m.\r\u001b[2C\u001b[1B  \u001b[6GMoving them into a \u001b[38;2;177;185;249mSpace::Reason\u001b[39m is\u001b[42Gthe c\u001b[48Gearest cut. It needs a migration,\u001b[82Gbecause saves store\u001b[102Gthese values by\r\u001b[5C\u001b[1Bname and the s\u001b[21Gring tables key them\u001b[42Gas \u001b[38;2;177;185;249mreason.ai.*\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mScene files\u001b[22m:\u001b[19Gthey store a star-system path, and the\u001b[58Gneutral\u001b[66Gscene\u001b[72Gmodule\u001b[79Ghas\u001b[83Ga\u001b[85G\u001b[38;2;177;185;249mCelestialBodyComponent\u001b[39m,\u001b[109Gwhich\u001b[115Gthe\r\u001b[2C\u001b[1B  \u001b[6Grenderer reads directly\u001b[30G(\u001b[38;2;177;185;249mSceneDraws.cpp:75\u001b[39m). Tha\u001b[55G could become a generic\u001b[79G\"placed by an extension\" record.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mRenderer and app\u001b[22m: atmosphere, rings and horizon culling\u001b[62Glive in th\u001b[73G neutral ren\u001b[86Gerer. The app has\u001b[104G\u001b[38;2;177;185;249m--galaxy\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mLoadSystem\u001b[39m, a jump stage in its smoke sequence,\u001b[54Gand orbit-camera targ\u001b[76Gts \u001b[80Ground bodies. These\u001b[100Gshould become\u001b[114Gan\r\u001b[5C\u001b[1Boptional presentation exte\u001b[33Gs\u001b[35Gon.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mShip words in neutral APIs\u001b[22m: \u001b[38;2;177;185;249mSim::Helm\u001b[39m,\u001b[45G\u001b[38;2;177;185;249mMayFly\u001b[39m,\u001b[53Ga\u001b[55Gsaved\u001b[61Gfield\u001b[67Gcalled\u001b[74G\u001b[38;2;177;185;249m\"ship\"\u001b[39m,\u001b[82G\u001b[38;2;177;185;249mPhysics.Thrusters\u001b[39m,\u001b[101Gand\u001b[105G\u001b[38;2;177;185;249mSystemIndices\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G(which is really one index per frame).\u001b[45GTh\u001b[76Gaved names need aliases.\u001b[101G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
