[0.022, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255ma\u001b[39m                                                                                                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTaking\u001b[10G(a):\u001b[15Gfirst\u001b[21Gthe\u001b[25G\u001b[38;2;177;185;249mClearOf\u001b[33G\u001b[39mfix\u001b[37Gin\u001b[40GJettison.\u001b[50GI'm\u001b[54Gfinding\u001b[62Gwhere\u001b[68Gthe\u001b[72G520\u001b[76Gm\u001b[78Gbetween\u001b[86Ga\u001b[88Gstation's\u001b[98Gplaced\u001b[105Gposition\u001b[114Gand\u001b[118Gits\r\u001b[1B \u001b[3Gorbit com\u001b[13Gs from.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell com\u001b[19Gands \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe root cause is a timing\u001b[30Gmismatch:\u001b[40Gphysics\u001b[48Gplaces\u001b[55Gbodies\u001b[62Gat\u001b[65Gthe\u001b[69Gend\u001b[73Gof\u001b[76Gthe\u001b[80Gstep,\u001b[86Gwhile\u001b[92GClearOf\u001b[100Gmeasures\u001b[109Gagainst\u001b[117Gthe\r\u001b[2C\u001b[1Bstation's\u001b[13Gstart-of-step\u001b[27Gposition,\u001b[37Gso\u001b[40Gthe\u001b[44G~500\u001b[49Gm\u001b[51Gdrift\u001b[57Gexplains\u001b[66Gthe\u001b[70G520\u001b[74Gm\u001b[76Ggap.\u001b[81GNext\u001b[86GI'll\u001b[91Gcheck\u001b[97Gwhether\u001b[105Gthe\u001b[109Gcruise's\r\u001b[1B \u001b[3G\"too near a station\" check has the \u001b[39Game problem.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m The cruise check suffers from the same timing mismatch, since it compares end-of-step positions against start-of-step\u001b[K\r\u001b[2C\u001b[1Bstations. The general fix is to have physics report the time its placements apply to, so I'm reading physics'\u001b[113Gstep\u001b[118Gand\r\u001b[2C\u001b[1Bskip next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Feel free to suggest other sulutions, especially ones with tested and known working results.\u001b[39m                          \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
