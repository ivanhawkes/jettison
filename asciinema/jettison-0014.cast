2m:\u001b[19Gthey store a star-system path, and the\u001b[58Gneutral\u001b[66Gscene\u001b[72Gmodule\u001b[79Ghas\u001b[83Ga\u001b[85G\u001b[38;2;177;185;249mCelestialBodyComponent\u001b[39m,\u001b[109Gwhich\u001b[115Gthe\r\u001b[2C\u001b[1B  \u001b[6Grenderer reads directly\u001b[30G(\u001b[38;2;177;185;249mSceneDraws.cpp:75\u001b[39m). Tha\u001b[55G could become a generic\u001b[79G\"placed by an extension\" record.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mRenderer and app\u001b[22m: atmosphere, rings and horizon culling\u001b[62Glive in th\u001b[73G neutral ren\u001b[86Gerer. The app has\u001b[104G\u001b[38;2;177;185;249m--galaxy\u001b[39m,\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mLoadSystem\u001b[39m, a jump stage in its smoke sequence,\u001b[54Gand orbit-camera targ\u001b[76Gts \u001b[80Ground bodies. These\u001b[100Gshould become\u001b[114Gan\r\u001b[5C\u001b[1Boptional presentation exte\u001b[33Gs\u001b[35Gon.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mShip words in neutral APIs\u001b[22m: \u001b[38;2;177;185;249mSim::Helm\u001b[39m,\u001b[45G\u001b[38;2;177;185;249mMayFly\u001b[39m,\u001b[53Ga\u001b[55Gsaved\u001b[61Gfield\u001b[67Gcalled\u001b[74G\u001b[38;2;177;185;249m\"ship\"\u001b[39m,\u001b[82G\u001b[38;2;177;185;249mPhysics.Thrusters\u001b[39m,\u001b[101Gand\u001b[105G\u001b[38;2;177;185;249mSystemIndices\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G(which is really one index per frame).\u001b[45GThese are\u001b[55Gmostly r\u001b[64Gnames, but saved names need aliases.\u001b[101G\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[38;2;177;185;249m\u001b[1mdock\u001b[39m counts as neutral but is all station, pad and cargo data.\u001b[22m Its \u001b[74Ge\u001b[76Gts also need \u001b[38;2;177;185;249mspace\u001b[39m, and \u001b[38;2;177;185;249mSaveGame\u001b[39m's\u001b[111Gmigration\r\u001b[2C\u001b[1B  \u001b[6Ghard-codes the keys \u001b[38;2;177;185;249m\"galaxy\"\u001b[39m and \u001b[38;2;177;185;249m\"system\"\u001b[39m.\u001b[K\r\u001b[5