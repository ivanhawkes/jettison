[0.073, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 18 -\u001b[38;2;248;248;242m\u001b[48;2;92;2;0m#\u001b[48;2;61;1;0mversion: 1                                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 18 +\u001b[38;2;166;226;46mversion:\u001b[38;2;248;248;242m \u001b[38;2;190;132;255m1\u001b[38;2;248;248;242m                                                                                             \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 19 \u001b[22m \u001b[38;2;166;226;46mdisplayName:\u001b[39m \u001b[38;2;230;219;116mOstra\u001b[39m \u001b[38;2;230;219;116mHighport\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m20\u001b[11G\u001b[22m\u001b[38;2;166;226;46mre\u001b[14GervationSeconds:\u001b[39m \u001b[38;2;190;132;255m300\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22m\u001b[38;2;166;226;46md\u001b[13Gcks:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(hulls/shuttle.yaml)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[2m 1 \u001b[22m \u001b[38;2;117;113;94m# The sample's ship and the console's traffic (docs/sample-game.md): ten metres long, a small\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 2 -\u001b[38;2;248;248;242m# hauler's twenty crates. \u001b[48;2;92;2;0mIts hatch is under the hull, aft. \u001b[48;2;61;1;0mA hull of the docks (Dock.HullDefinition):  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2 +\u001b[38;2;117;113;94m# hauler's twenty crates. A hull of the docks (Dock.HullDefinition):\u001b[38;2;248;248;242m                                    \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 3 \u001b[22m \u001b[38;2;117;113;94m# metres, its nose along -Z.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m\u001b[38;2;166;226;46mversion:\u001b[39m \u001b[38;2;190;132;255m2\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;166;226;46mdisplayName:\u001b[23G\u001b[38;2;230;219;116mShuttle\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/jettison'\u001b[45G&&\u001b[48Ggrep\u001b[53G-c\u001b[56Gcarg…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd '/home/ivan/projects/jettison' && grep -c cargo assets/strings/*/reasons.yaml; cmake --build --preset \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mclang-debug 2>&1 | gr\u001b[28Gp -E 'error' -A3\u001b[45G| head -40; cte\u001b[61Gt --test-dir build/clang-debug 2>&1 | tail\u001b[105G8 (10s · 3 \r\u001b[5C\u001b[1Blines)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
