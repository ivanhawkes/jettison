[0.019, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mAdjust yourself so you always stage the files by name to avoid tripping that hook again.\u001b[39m                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRecalled \u001b[1m2\u001b[22m memories, wrote \u001b[1m3\u001b[22m memories \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFrom\u001b[8Gnow\u001b[12Gon\u001b[15GI'll\u001b[20Gstage\u001b[26Gevery\u001b[32Gcommit\u001b[39Gby\u001b[42Gnaming\u001b[49Gits\u001b[53Gfiles,\u001b[60Gas\u001b[63Gin\u001b[66G\u001b[38;2;177;185;249mgit add docs/a.md source/b.cpp\u001b[39m.\u001b[98GI\u001b[100Gwon't\u001b[106Guse\u001b[110G\u001b[38;2;177;185;249m-A\u001b[39m,\u001b[114G\u001b[38;2;177;185;249m--all\u001b[39m,\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249m.\u001b[39m \u001b[6Gr\u001b[8G\u001b[38;2;177;185;249m-u\u001b[39m,\u001b[12Gi\u001b[14Gcluding with a path after them like \u001b[38;2;177;185;249mgit add -A docs\u001b[39m, which is what the hook blocked.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gsaved\u001b[11Gthis\u001b[16Gas\u001b[19Ga\u001b[21Gnew\u001b[25Gmemory,\u001b[33G\u001b[38;2;177;185;249mstage-files-by-name.md\u001b[39m,\u001b[57Gand\u001b[61Gadded\u001b[67Git\u001b[70Gto\u001b[73Gthe\u001b[77Gmemory\u001b[84Gindex,\u001b[91Gso\u001b[94Git's\u001b[99Gloaded\u001b[106Gat\u001b[109Gthe\u001b[113Gstart\u001b[119Gof\r\u001b[2C\u001b[1Bevery sess\u001b[14Gon. My\u001b[21Gexisting asciinema memory already said to stage by nam\u001b[77Gbut didn't stand\u001b[94Gout,\u001b[99Gs\u001b[101G I've link\u001b[112Gd it \u001b[118Go\u001b[K\r\u001b[2C\u001b[1Bth\u001b[6G new one.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 22s · done 6:07 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m