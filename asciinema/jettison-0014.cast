[0.104, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 101 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 102 -\u001b[38;2;248;248;242m// The sample galaxy (\u001b[48;2;92;2;0msource/samples/space/assets/\u001b[48;2;61;1;0msystems/galaxy.yaml): Halcyon to Vesper in 40 s,    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 102 +\u001b[38;2;117;113;94m// The \u001b[48;2;4;71;0mretired space \u001b[48;2;2;40;0msample\u001b[48;2;4;71;0m's\u001b[48;2;2;40;0m galaxy (\u001b[48;2;4;71;0mits \u001b[48;2;2;40;0msystems/galaxy.yaml): Halcyon to Vesper in 40 s,\u001b[38;2;248;248;242m            \r\u001b[8C\u001b[1B\u001b[39m\u001b[49m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;117;113;94m// Vesper to Marrow in 65.\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m\u001b[38;2;249;38;114minline\u001b[19G\u001b[39mCelestial::Galaxy\u001b[37G\u001b[38;2;166;226;46mSample\u001b[38;2;253;151;31m()\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 105 \u001b[12G\u001b[22m{\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(source/\u001b[18Gngine/space/tests/Halcyon.h)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[23G\u001b[22m \u001b[38;2;166;226;46mstd\u001b[39m::\u001b[38;2;166;226;46muint64_t\u001b[39m kHalcyon = S\u001b[51Gm::FrameId(\u001b[38;2;230;219;116m\"\u001b[64Galcy\u001b[69Gn\"\u001b[39m)\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m\u001b[38;2;249;38;114minline\u001b[18G\u001b[38;2;166;226;46mconstexpr\u001b[28Gstd\u001b[39m::string_view\u001b[45GkStation\u001b[54G=\u001b[56G\u001b[38;2;230;219;116m\"Ostra Highport\"\u001b[39m;\r\u001b[5C\u001b[1B\u001b[2m 18 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 19 -\u001b[38;2;248;248;242m// Halcyon as \u001b[48;2;92;2;0mits\u001b[48;2;61;1;0m system file \u001b[48;2;92;2;0mhas\u001b[48;2;61;1;0m it (\u001b[48;2;92;2;0msource/samples/space/assets/\u001b[48;2;61;1;0msystems/halcyon.yaml): a Sun-like    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 19 +\u001b[38;2;117;113;94m// Halcyon as \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mretired space sample's \u001b[48;2;2;40;0msystem file \u001b[48;2;4;71;0mhad\u001b[48;2;2;40;0m it (systems/halcyon.yaml): a Sun-like\u001b[38;2;248;248;242m         \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m0\u001b[14G\u001b[22m\u001b[38;2;117;113;94msta\u001b[18G, an\u001b[23GEar\u001b[28G-like planet a hundred\u001b[51Gand fifty million kilometres\u001b[80Gout,\u001b[86Gnd a\u001b[91Gstation in low orbit\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m1\u001b[11G\u001b[22m\u001b[38;2;117;113;94m// over it, so the station moves at 7.7 km/s about the planet and 30 km/s about the star.\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 22 \u001b[11G\u001b[22m\u001b[38;2;249;38;114minline\u001b[18G\u001b[39mCelestial::StarSystem\u001b[40G\u001b[38;2;166;226;46mHalcyon\u001b[38;2;253;151;31m()\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/jettison' && ls scripts | grep -i format; git status --short | head -30\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
