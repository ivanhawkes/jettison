[0.006, "o", "\u001b[H\r\u001b[7B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m←\u001b[4G☒\u001b[6GLane\u001b[11Gshape\u001b[18G☒\u001b[20GLane\u001b[25Gchoice\u001b[33G☒\u001b[35GScope\u001b[41G\u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ✔ Submit \u001b[49m\u001b[38;2;153;153;153m →\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u001b[1mReview your\u001b[13Ganswers\u001b[22m\u001b[39m\u001b[K\r\u001b[2B ● How should opposite flows be\u001b[33Gkept\u001b[38Gapart\u001b[44Galong\u001b[50Ga\u001b[52Gcruise\u001b[59Gand\u001b[63Gat\u001b[66Gits\u001b[70Gends?\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Keep right (Recommended)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B●\u001b[4GHow is a ship given one of the several lanes each way?\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Held like pads (Recommended)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[22m ●\u001b[6GThe roadmap \u001b[19Gow\u001b[22Gsays\u001b[27Gthe\u001b[31Glanes\u001b[37Gcome\u001b[42G\"with\u001b[48Gthe\u001b[52Gway\u001b[56Gin\u001b[59Gto\u001b[62Ga\u001b[64Gpad's\u001b[70Gcorridor\"\u001b[80G(entry\u001b[87G31:\u001b[91Gan\u001b[94Gapproach\u001b[103Gflown\u001b[109Gwithout\r\u001b[1C\u001b[1B\u001b[2m│\u001b[6G\u001b[22mstopping, speed falling with distance, the reservation lapsing on lost progress). Build both now?\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Lanes first (Recommended)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[39m \u001b[38;2;153;153;153m1. \u001b[38;2;177;185;249mSubmit answers\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2. \u001b[7G\u001b[39mancel\u001b[K\r\u001b[2B\u001b[K\u001b[27;1H\u001b[22;1H"]
