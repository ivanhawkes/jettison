[0.053, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B4\u001b[6GSplitting \u001b[17Gh\u001b[19G docks into berths and the rest.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6GThe move itself, int\u001b[27G Manifest\u001b[37Gand the sample.\r\u001b[2C\u001b[1B6.\u001b[6GClose-out,\u001b[17Gwith\u001b[22Ga\u001b[24Gcross-review\u001b[37Gof\u001b[40Gthe\u001b[44Gwhole.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisi\u001b[10Gns\u001b[13GI need from you:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[1mBefore or\u001b[16Gafter W12?\u001b[22m W12\u001b[31Ghardly touches travel, so \u001b[58Git\u001b[61Ger\u001b[64Gorder works.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPlanetary rings.\u001b[22m They're\u001b[31Gspace-only,\u001b[43Gbut the renderer has\u001b[64Gno hook for\u001b[76Ga\u001b[78Ggame's\u001b[85Gown\u001b[89Gdrawing.\u001b[98GDo\u001b[101Gthey\u001b[106Gstay\u001b[111Gas\u001b[114Gthe\u001b[118Gone\r\u001b[2C\u001b[1B  \u001b[6Gnamed exception until\u001b[28Git has on\u001b[38G, or does thi\u001b[53Gplan build that hook?\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mOrbits in the sample.\u001b[22m For the reference frames to stay byte-iden\u001b[71Gical, th\u001b[80G sampl\u001b[87G ne\u001b[91Gds its own copy of th\u001b[113G orbit\r\u001b[5C\u001b[1Bmaths\u001b[12G(about\u001b[19G150\u001b[23Glines).\u001b[31GThe\u001b[35Galternative\u001b[47Gis\u001b[50Gsimple\u001b[57Gcircular\u001b[66Gorbits,\u001b[74Gwith\u001b[79Gevery\u001b[85Greference\u001b[95Gframe\u001b[101Gre-made\u001b[109Gonce.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe estimate o\u001b[18G the sample'\u001b[31G share\u001b[41Grough,\u001b[48Gand I\u001b[54Ghaven't yet\u001b[66Gchecked how much\u001b[83GManifest's conte\u001b[100Gt loading depends on\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mcelestial\u001b[39m's\u001b[15Gdefinition\u001b[26Gtypes.\u001b[33GThis\u001b[38Gis\u001b[41Ga\u001b[43Ggood\u001b[48Gpoint\u001b[54Gfor\u001b[58Ga\u001b[60Gfresh\u001b[66