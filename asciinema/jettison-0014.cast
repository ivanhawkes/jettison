[0.116, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7GThe\u001b[11Gdelivery\u001b[20Gorder's\u001b[28GW21\u001b[32Grow\u001b[36Gis\u001b[39Gmarked\u001b[46Gdone,\u001b[52Gand\u001b[56Gnext\u001b[61Gis\u001b[64GJettison's\u001b[75Gstation\u001b[83Gtraffic\u001b[91Glanes,\u001b[98Gthen\u001b[103GW12.\r\u001b[1B \u001b[3G  - History has a new W21 entry,\u001b[36Gand\u001b[40Gthe\u001b[44Gsession\u001b[52Ghandoff\u001b[60Gis\u001b[63Grewritten\u001b[73Gfor\u001b[77Gafter\u001b[83GW21.\r\u001b[1B    - Every o\u001b[15Gd \u001b[38;2;177;185;249m#w21-plan\u001b[39m link now points to the\u001b[50Gnew\u001b[54Gsection.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison \u001b[38;2;177;185;249m0740c0f\u001b[39m:\u001b[22m the roa\u001b[31Gmap says\u001b[40GW21 \u001b[45Gs done and\u001b[56Gthe traffic\u001b[68Glanes\u001b[74Gare\u001b[78Gnext,\u001b[84Gand\u001b[88Gthe\u001b[92Ghistory\u001b[100Glink\u001b[105Gis\u001b[108Gfixed.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe plan lists what W21 leaves open:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gconsole\u001b[17Ghas\u001b[21Gno\u001b[24G\u001b[38;2;177;185;249mSetRefuel\u001b[39m,\u001b[35Gso\u001b[38Grefuelling\u001b[49Gis\u001b[52Galways\u001b[59Gon\u001b[62Gthere.\r\u001b[2C\u001b[1B- A fuel the company\u001b[24Ghas\u001b[28Gnever\u001b[34Gbought,\u001b[42Gwhere\u001b[48Gno\u001b[51Greport\u001b[58Ggives\u001b[64Ga\u001b[66Gprice,\u001b[73Gis\u001b[76Gpriced\u001b[83Gat\u001b[86G0\u001b[88Gin\u001b[91Gan\u001b[94Gestimate.\r\u001b[1B  - The policy's cost per decision (four thrust shares per\u001b[60Gtrade)\u001b[67Ghasn't\u001b[74Gbeen\u001b[79Gprofiled.\r\u001b[1B  - The larger drives and their exclusion\u001b[43Gradius\u001b[50Gare\u001b[54GW22's.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  I skipped two steps on purpose:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo Codex cross-review:\u001b[28G\u001b[22mthat\u001b[33Gruns\u001b[38Gonly\u001b[43Gwhen\u001b[48Ga\u001b[50Gstage\u001b[56Gcompletes,\u001b[67Gand\u001b[71GStage\u001b[77G4\u001b[79Gcloses\u001b[86Gat\u001b[89GW14,\u001b[94Gnot\u001b[98Ghere.\r\u001b[1B \u001b[3G- \u001b[1mRe-pin comments not pruned:\u001b[22m that's for the\u001b[48Glast development stage.\u001b[K\r\u001b[2B \u001b[3GNext is Jettison's station traffic lanes, which is\u001b[54Ga\u001b[56Gdesign-heavy\u001b[69Gengine\u001b[76Gtask.\u001b[82GI'd\u001b[86Gstart\u001b[92Git\u001b[95Gin\u001b[98Ga\u001b[100Gfresh\u001b[106Gsession\u001b[114Grather\r\u001b[1B  than \u001b[38;2;177;185;249m/compact\u001b[39m, since none of this session's context carries\u001b[63Gover\u001b[68Gto\u001b[71Git.\r\u001b[21C\u001b[4B\u001b[38;2;153;153;153m3\u001b[32G9\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
