[0.038, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scripts/make-sample-textures.py)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m3\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1 \u001b[22m \u001b[38;2;117;113;94m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 2 -\u001b[38;2;248;248;242m# Rebuilds the sample hull textures in source/\u001b[48;2;92;2;0msamples\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0mspace\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0massets/\u001b[48;2;61;1;0mtextures/hulls/hull-panels:          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2 +\u001b[38;2;117;113;94m# Rebuilds the sample hull textures in source/\u001b[48;2;4;71;0mtest\u001b[48;2;2;40;0m/\u001b[48;2;4;71;0mcontent\u001b[48;2;2;40;0m/textures/hulls/hull-panels:\u001b[38;2;248;248;242m                  \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;2;117;113;94mpainted\u001b[20Gplating (its colour)\u001b[41Gand a\u001b[47Gmask of lit\u001b[59Gwindows (its emissive), both 256\u001b[92G256 and tileable. Writ\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;117;113;94mes \u001b[14Ghe PNG\u001b[21G to the\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[10G\u001b[22m\u001b[38;2;117;113;94m# current directory; the KTX 2 files are encoded from them with KTX-Software's ktx tool (nixpkgs\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m5 \u001b[22m \u001b[38;2;117;113;94m# ktx-tools,\u001b[23Gthe version the engin\u001b[45G read\u001b[51G, in devenv):\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m7\u001b[15G\u001b[22m\u001b[38;2;117;113;94mpython3 sc\u001b[26Gipts/make-samp\u001b[41Ge-textures.py\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m \u001b[38;2;117;113;94m#   ktx create --format R8G8B8_SRGB --encode uastc --uastc-quality 2 --zstd 19 \\\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m \u001b[38;2;117;113;94m#       --generate-mipmap hull-panels-color.png \\\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 10 -\u001b[38;2;248;248;242m#       source/\u001b[48;2;92;2;0msamples\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0mspace\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0massets/\u001b[48;2;61;1;0mtextures/hulls/hull-panels/hull-panels-color.ktx2                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 10 +\u001b[38;2;117;113;94m#       source/\u001b[48;2;4;71;0mtest\u001b[48;2;2;40;0m/\u001b[48;2;4;71;0mcontent\u001b[48;2;2;40;0m/textures/hulls/hull-panels/hull-panels-color.ktx2\u001b[38;2;248;248;242m                          \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 11 \u001b[22m \u001b[38;2;117;113;94m#   ktx create --format R8G8B8_SRGB --encode basis-lz --clevel 2 --qlevel 192 \\\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 12 \u001b[22m \u001b[38;2;117;113;94m#       --generate-mipmap hull-panels-emissive.png \\\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 13 -\u001b[38;2;248;248;242m#       source/\u001b[48;2;92;2;0msamples\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0mspace\u001b[48;2;61;1;0m/\u001b[48;2;92;2;0massets/\u001b[48;2;61;1;0mtextures/hulls/hull-panels/hull-panels-emissive.ktx2               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 13 +\u001b[38;2;117;113;94m#       source/\u001b[48;2;4;71;0mtest\u001b[48;2;2;40;0m/\u001b[48;2;4;71;0mcontent\u001b[48;2;2;40;0m/textures\u001b[76Gs-emissive.ktx2\u001b[38;2;248;248;242m                       \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
