[0.222, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe r\u001b[9Got cause is a \u001b[24Giming mismatch:\u001b[40Gp\u001b[42Gysics places bodies at the end of\u001b[76Gthe st\u001b[83Gp,\u001b[86Gwhi\u001b[90Ge ClearOf measures\u001b[109Gaga\u001b[113Gnst the\r\u001b[2C\u001b[1Bs\u001b[5Gation's\u001b[13Gstart-of-step position, so the ~500 \u001b[50G drift explains\u001b[66Gthe\u001b[70G520\u001b[74Gm\u001b[76Ggap.\u001b[81GNext\u001b[86GI'll\u001b[91Gcheck\u001b[97Gwhether\u001b[105Gthe\u001b[109Gcruise's\r\u001b[2C\u001b[1B\"too\u001b[8Gnear\u001b[13Ga\u001b[15Gstation\"\u001b[24Gcheck\u001b[30Ghas\u001b[34Gthe\u001b[38Gsame\u001b[43Gproblem.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe cruise check suffers from the same timing mismatc\u001b[57G,\u001b[59Gs\u001b[61Gnce it\u001b[68Gcompar\u001b[75Gs end-of-s\u001b[86Gep\u001b[89Gp\u001b[91Gsitions against \u001b[108Gtart-of-step\u001b[K\r\u001b[3C\u001b[1Btations. The general\u001b[25Gfix\u001b[29Gis\u001b[32Gto\u001b[35Ghave\u001b[40Gphysics\u001b[48Greport\u001b[55Gthe\u001b[59Gtime\u001b[64Gits\u001b[68Gplacements\u001b[79Gapply\u001b[85Gto,\u001b[89Gso\u001b[92GI'm\u001b[96Greading\u001b[104Gphysics'\u001b[113Gstep\u001b[118Gand\r\u001b[2C\u001b[1Bskip\u001b[8Gnext.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPhysics\u001b[11Gwill now re\u001b[23Gord the\u001b[31Gtime its placements \u001b[52Gre for, and the clear\u001b[74Gnce\u001b[78Gand reach\u001b[89Ghecks will measure at that\u001b[116Gtime\r\u001b[2C\u001b[1Bwithout\u001b[11Gmoving\u001b[18Gany\u001b[22Gcruise's\u001b[31Garri