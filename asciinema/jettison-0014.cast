es out \u001b[35Gomewhere clear.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMotion profiles:\u001b[22m today'\u001b[30Gcrui\u001b[35Ge profiles (\u001b[48Gccelerate,\u001b[59Gcoast,\u001b[66Gdecelerate).\r\u001b[4C\u001b[1B\u001b[1mP\u001b[7Grtals:\u001b[22m today's\u001b[22Gjump lanes.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSlo\u001b[9Gs:\u001b[22m the queue\u001b[22Gand reservations\u001b[39Gbehind\u001b[46Gtoday's\u001b[54Ggates\u001b[60Gand\u001b[64Gpads.\r\u001b[4C\u001b[1B\u001b[1mTrigger volumes:\u001b[22G\u001b[22mto\u001b[25Gay'\u001b[29G gate rings.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mBerths:\u001b[22m today's docks.  \u001b[30G    \u001b[35G      \u001b[27;1H\u001b[24;3H\u001b[?25h"]
