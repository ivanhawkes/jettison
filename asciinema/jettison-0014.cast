[0.110, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mA jump lane is a portal:\u001b[30G\u001b[22man\u001b[33Gentity\u001b[40Gleaves\u001b[47Gone\u001b[51Gframe\u001b[57Gfor\u001b[61Ga\u001b[63Gset\u001b[67Gtime\u001b[72Gand\u001b[76Gappears\u001b[84Gat\u001b[87Ga\u001b[89Gnamed\u001b[95Gexit\u001b[100Gin\u001b[103Ganother.\r\u001b[2C\u001b[1B  Generalised to\u001b[20Gany f\u001b[26Game, it covers your short\u001b[52Gintra-planet\u001b[65Gjumps\u001b[71Gas\u001b[74Gwell\u001b[79Gas\u001b[82Gstargates.\u001b[93GToday's\u001b[101Glanes\u001b[107Gonly\u001b[112Ggo\r\u001b[2C\u001b[1B \u001b[5Gbetween star systems.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA gate is a portal guarded by a slot queue and a trigger volume\u001b[22m, with the\u001b[79Ggame's charge\u001b[93Grule (the existing\u001b[112G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mTollRule\u001b[39m). It's \u001b[22Ghe same\u001b[30Gqueue\u001b[36Gand\u001b[40Glapse\u001b[46Gmachinery\u001b[56Gas\u001b[59Gpads.\r\u001b[4C\u001b[1B\u001b[1mOnly the g\u001b[16Glaxy \u001b[22Gnd rout\u001b[30Gs\u001b[32Gare space-only.\u001b[22m They'd move to Manifest, which\u001b[79Gwould route over its own graph with\u001b[115Gthe\r\u001b[4C\u001b[1Bengine's existing pathfinding (\u001b[38;2;177;185;249mAi::FindPath\u001b[39m).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTh\u001b[6G cost of keep\u001b[23Gthem \u001b[29Gs converting them in slices\u001b[57G4–6.\u001b[62GThat's\u001b[69Gsomewhat\u001b[78Gmore\u001b[83Gsurface\u001b[91Garea,\u001b[97Gand\u001b[101Gthey\u001b[106Gneed\u001b[111Ga\u001b[113Gneutral\r\u001b[2C\u001b[1Btest\u001b[8Gin\u001b[11Gthe\u001b[15Gengine\u001b[22G(a\u001b[25Gdoor\u001b[30Gbetween\u001b[38Gtwo\u001b[42Gframes,\u001b[50Ga\u001b[52Gtoll\u001b[57Gbooth)\u001b[64Guntil\u001b[70GManifest's\u001b[81Gstargates\u001b[91Gtest\u001b[96Gthem\u001b[101Gfor\u001b[105Greal.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI recommend\u001b[15Gkeeping them as neutral p\u001b[41Grtals and gated\u001b[57Gp\u001b[59Gr\u001b[61Gals, and\u001b[70Gmov\u001b[74Gng \u001b[78Ghe\u001b[81Ggalaxy and routes to Manifest.\u001b[112GSince\r\u001b[2C\u001b[1Byou'll\u001b[10Gwant\u001b[15Gthis,\u001b[21Gconverting\u001b[32Gthem\u001b[37Gnow\u001b[41Gcosts\u001b[47Gless\u001b[52Gthan\u001b[57Grebuilding\u001b[68Gthem\u001b[73Glater.\u001b[80GShall\u001b[86GI\u001b[88Gupdate\u001b[95Gthe\u001b[99Gplan\u001b[104Gthat\u001b[109Gway?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 15s · done 7:09 pm\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255myes, keep them as portals and update the plan\u001b[39m                                                                         \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m \u001b[39m Working…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
