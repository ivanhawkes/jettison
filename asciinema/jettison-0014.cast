[0.834, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mLanguages noted in Manifest's \u001b[38;2;177;185;249mdocs/scope.md\u001b[39m (uncommitted there). Finishing commit A: rewording the space suites'\r\u001b[2C\u001b[1Bcomments that cite the sample's files, then format and commit.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(source/engine/sp\u001b[27Gce/tests/Sys\u001b[41Gms.h)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[30G\u001b[22mline\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 28 \r\u001b[2C\u001b[1B\u001b[22m   \u001b[2m 29 \u001b[22m \u001b[38;2;117;113;94m// A Sun-like star, an Earth-like planet with a moon, a station in low orbit over the planet, and\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 30 \u001b[11G\u001b[22m\u001b[38;2;117;113;94m// the gate to Vesper keeping station 5 km above the station, as\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 31 -\u001b[38;2;248;248;242m// source/samples/space/assets/systems/halcyon.yaml has them.                                          \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 31 +\u001b[38;2;117;113;94m// the retired space sample's systems/halcyon.yaml had them.\u001b[38;2;248;248;242m                                           \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 32 \u001b[11G\u001b[22m\u001b[38;2;249;38;114minline\u001b[18G\u001b[39mCelestial::StarSystem\u001b[40G\u001b[38;2;166;226;46mHalcyon\u001b[38;2;253;151;31m()\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m 33 \u001b[22m {\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 34 \u001b[13G\