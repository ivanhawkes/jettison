[0.123, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m2148 \u001b[22m   definitions and the scripts, the player, the orbit\u001b[66Gcameras\u001b[74Gframed\u001b[81Gon\u001b[84Ga\u001b[86Gtarget,\u001b[94Ga\u001b[96Gsequence\u001b[105Gplayed,\r\u001b[6C\u001b[1B\u001b[2m2149 \u001b[22m   the pick cleared, and the game UI. With none,\u001b[61Gas\u001b[64GFlotsam\u001b[72Gruns,\u001b[78Gthe\u001b[82Gshell\u001b[88Ghas\u001b[92Gphysics\u001b[100Gand\u001b[104Gno\u001b[107Gspace:\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 2157 -\u001b[38;2;248;248;242m  no galaxy, station, ship or market (`GameTests`)\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mJetsam \u001b[48;2;61;1;0mand the render test \u001b[48;2;92;2;0mcompose \u001b[48;2;61;1;0mthe \u001b[48;2;92;2;0mspace\u001b[48;2;61;1;0m     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 2158 -\u001b[38;2;248;248;242m  \u001b[48;2;92;2;0msample,\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mand\u001b[48;2;61;1;0m the \u001b[48;2;92;2;0m`\u001b[48;2;61;1;0mground\u001b[48;2;92;2;0m`\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mexecutable the ground \u001b[48;2;61;1;0msample ([sample game](sample-game.md#the-ground-samp\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m  \u001b[10G  -\u001b[38;2;248;248;242mle)).                 \u001b[36G      \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 2159 -\u001b[38;2;248;248;242m- **The space sample** (8b, `samples/space`, `Sample::SpaceGame`, [sample game](sample-game.md)\u001b[48;2;92;2;0m):\u001b[48;2;61;1;0m    \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 2160 -\u001b[38;2;248;248;242m  the first slice of Manifest's plan, as a game composed into the shell. Its space layer             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2150 +\u001b[38;2;248;248;242m  no galaxy, station, ship or market (`GameTests`)\u001b[48;2;4;71;0m,\u001b[48;2;2;40;0m and \u001b[48;2;4;71;0mso runs \u001b[48;2;2;40;0mthe render test\u001b[48;2;4;71;0m;\u001b[48;2;2;40;0m the \u001b[48;2;4;71;0m`ground`\u001b[48;2;2;40;0m        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 2151 +\u001b[38;2;248;248;242m  \u001b[48;2;4;71;0mexecutable\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mcomposes\u001b[48;2;2;40;0m the ground sample ([\u001b[38;2;230;219;116msample game\u001b[38;2;248;248;242m](sample-game.md#the-ground-sample)).           \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2152 +\u001b[38;2;248;248;242m- **The space sample** (8b, `samples/space`, `Sample::SpaceGame`, [\u001b[38;2;230;219;116msample game\u001b[38;2;248;248;242m](sample-game.md)\u001b[48;2;4;71;0m;\u001b[48;2;2;40;0m     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 2153 +\u001b[38;2;248;248;242m  \u001b[48;2;4;71;0mretired on 2026-11-22, Manifest testing all space code, so what follows is its record): \u001b[48;2;2;40;0mthe first s\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m      +\u001b[38;2;248;248;242mlice of Manifest's plan, as a game composed into the shell. Its space layer                          \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 2154 \u001b[15G\u001b[22m(`SpaceLayer`,\u001b[30GG01b)\u001b[36Gis\u001b[39Gwhat\u001b[44Gthe\u001b[48Gshell\u001b[54Gwas\u001b[58Gof\u001b[61Ga\u001b[63Gspace\u001b[69Ggame:\u001b[75Gthe\u001b[79Ggalaxy,\u001b[87Gthe\u001b[91Gsystem\u001b[98Gshown\u001b[104Gand\u001b[108Gthe\r\u001b[5C\u001b[1B\u001b[2m 2155 \u001b[15G\u001b[22mjumps\u001b[21Gbetween\u001b[29Gthem,\u001b[35Glanes,\u001b[42Ggates,\u001b[49Gcruises\u001b[57Gand\u001b[61Groutes,\u001b[69Gthe\u001b[73Gstations\u001b[82Gbuilt\u001b[88Gand\u001b[92Gdressed,\u001b[101Gthe\r\u001b[2C\u001b[1B   \u001b[2m 2156 \u001b[22m   player's ship\u001b[29Gand\u001b[33Gfleet,\u001b[40Gpiloting\u001b[49Gfrom\u001b[54Gbehind\u001b[61Gor\u001b[64Gthe\u001b[68Gseat,\u001b[74Gthe\u001b[78Gconsole's\u001b[88Gtraffic\u001b[96Gand\u001b[100Gthe\u001b[104Gflight\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning