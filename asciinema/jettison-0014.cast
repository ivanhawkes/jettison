sion.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat moves:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTo\u001b[8GManifest:\u001b[18G\u001b[22morbits,\u001b[26Gstar\u001b[31Gsystems,\u001b[40Gthe\u001b[44Ggalaxy,\u001b[52Gthe\u001b[56Gcourse\u001b[63Gplanning\u001b[72Ground\u001b[78Gplanets,\u001b[87Gand\u001b[91Gthe\u001b[95Gdrives'\u001b[103Gpower-law\u001b[113Gtiming\r\u001b[2C\u001b[1B \u001b[5Gthat Astralis uses.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTo the sample:\u001b[22m the star-system\u001b[36Gscene\u001b[42Gcode,\u001b[48Gand\u001b[52Gthe\u001b[56Gcargo\u001b[62Gdeck\u001b[67G(crates,\u001b[76Gbuggies,\u001b[85Groads),\u001b[93Gwhich\u001b[99GManifest\u001b[108Gdoesn't\u001b[116Guse.\r\u001b[4C\u001b[1B\u001b[1mOut of\u001b[12Gthe n\u001b[18Gutral modules:\u001b[22m the space-\u001b[44Gnly\u001b[75Gne's star-system fields.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
