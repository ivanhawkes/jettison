[0.124, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 13 +\u001b[38;2;248;248;242mthe burn per hour, is done on pin `2b3cfce` (2026-11-22), so slice 5, the fixture, is next. Then W12, c\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mompetitive procurement on the                                                                          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[2m 14 \u001b[22m [\u001b[38;2;230;219;116mtender contract\u001b[39m](stag\u001b[34G-4-trading-plan.md#tender-contract-w11-2026-11-21),\u001b[86Gits\u001b[90GAI\u001b[93Gissuer\u001b[100Gspending\r\u001b[6C\u001b[1B\u001b[2m15 \u001b[22m `Trade::Budget` and calling `Trade::Reliefs`. A commit is gated in\r\u001b[6C\u001b[1B\u001b[2m1\u001b[9G \u001b[22m the\u001b[15Gsecond\u001b[22Gcheckout,\u001b[32G`build/gate-tree`,\u001b[51Gwith\u001b[56G`--tidy`,\u001b[66Gediting\u001b[74Galone\u001b[80Gbeside\u001b[87Git\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/session-handoff.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m15 \u001b[22m `Trade::Budget`\u001b[27Gand\u001b[31Gcalling\u001b[39G`Trade::Reliefs`.\u001b[57GA\u001b[59Gcommit\u001b[66Gis\u001b[69Ggated\u001b[75Gin\r\u001b[6C\u001b[1B\u001b[2m1\u001b[9G \u001b[22m the\u001b[15Gsecond\u001b[22Gcheckout,\u001b[32G`build/gate-tree`,\u001b[51Gwith\u001b[56G`--tidy`,\u001b[66Gediting\u001b[74Galone\u001b[80Gbeside\u001b[87Git\r\u001b[6C\u001b[1B\u001b[2m17 \u001b[22m ([\u001b[38;2;230;219;116mgating beside the work\u001b[39m](build-and-gates.md#gating-beside-the-work)).\u001b[82GA\u001b[84Gship\u001b[89Gsteered\u001b[97Gin\u001b[100Ga\u001b[102Gstation's\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 18 -\u001b[38;2;248;248;242mframe still runs every step, which is most of the zero-client run's steps\u001b[48;2;92;2;0m.\u001b[48;2;61;1;0m                             \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 18 +\u001b[38;2;248;248;242mframe still runs every step, which is most of the zero-client run's steps\u001b[48;2;4;71;0m, more so since per hour\u001b[48;2;2;40;0m      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 19 +\u001b[38;2;248;248;242mthe policies hop between the stations of Ore's one orbit. Jettison's station traffic lanes follow      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 20 +\u001b[38;2;248;248;242mW21 (the user's, 2026-11-22).                                                                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 21 \u001b[11G\u001b[22mThe\u001b[15Gplanning\u001b[24Gdocuments'\u001b[35Ghome-region\u001b[47Gallocation\u001b[58G(scope,\u001b[66Gthe\u001b[70Groadmap's\u001b[80Gregion\u001b[87Gsupply\u001b[94Gand\u001b[98GD-076)\u001b[105Gwaits\r\u001b[1B \u001b[3G   \u001b[2m 22 \u001b[11G\u001b[22mfor W13 \u001b[20Go restate it a\u001b[35G founding.\u001b[K\r\u001b[1B     \u001b[2m 23 \u001b[22m\u001b[K\r\u001b[13C\u001b[2B\u001b[38;2;153;153;153m30m 26s · ↓\u001b[39m \u001b[38;2;153;153;153m54.8k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
