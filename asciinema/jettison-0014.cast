[0.002, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1\u001b[9G\u001b[1mkeeps a\u001b[17Gsmall copy of the space code it uses.\u001b[22m The\u001b[59Gduplication\u001b[71Gis mini\u001b[79Gal: orbits on rails\u001b[99Gand a simple cruise.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mIt shrinks to the neutral capabilities\u001b[22m, exerc\u001b[52Gs\u001b[54Gd by\u001b[59Ga\u001b[61Gnon-space\u001b[71Gtest\u001b[76Ggame\u001b[81Gor\u001b[84Gthe\u001b[88G\u001b[38;2;177;185;249mground\u001b[95G\u001b[39mand\u001b[99G\u001b[38;2;177;185;249mjetsam\u001b[106G\u001b[39msamples,\u001b[115Gand\r\u001b[2C\u001b[1B  \u001b[6Gthe space-specific code is tested only in Manifest.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe space code moves into an optional extension package in Jettison\u001b[22m, outside\u001b[83Gthe\u001b[87Gcore\u001b[92Gengine.\u001b[100GManifest\u001b[109Gand\u001b[113Gthe\r\u001b[5C\u001b[1Bsample\u001b[13Gboth\u001b[18Guse\u001b[22Git,\u001b[26Gso\u001b[29Gnothing\u001b[37Gis\u001b[40Gduplicated,\u001b[52Gbut\u001b[56Git\u001b[59Gisn't\u001b[65G\"into\u001b[71GManifest\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd choose option 2. It'\u001b[33Gclean\u001b[39Gst boundary\u001b[51Ga\u001b[53Gd matches your rule.\u001b[74GIts\u001b[78Gc\u001b[80Gs\u001b[82G is th\u001b[89Gt the space\u001b[101Gsample\u001b[108Gloses\u001b[114Gits\r\u001b[2C\u001b[1Bcruises\u001b[11Gand\u001b[15Gjumps,\u001b[22Gunless\u001b[29Gthe\u001b[33Gsample\u001b[40Gis\u001b[43Grebuilt\u001b[51Gon\u001b[54Gthe\u001b[58Gneutral\u001b[66Gtransit\u001b[74Gand\u001b[78Gportal\u001b[85Gcapabilities.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe line counts\u001b[19Gcom\u001b[23G from file totals, and the inventory age\u001b[64Gt's split estimates are rough. I\u001b[97Gh\u001b[99Gv\u001b[101Gn't ch\u001b[108Gcked\u001b[113Ghow far\r\u001b[2C\u001b[1BM\u001b[5Gnifest's cod\u001b[18G depends on \u001b[38;2;177;185;249mcelestial\u001b[39m beyon\u001b[46G travel and docking.\u001b[67GThe\u001b[71Grenames\u001b[79Gchange\u001b[86Gsaved\u001b[92Gtype\u001b[97Gnames,\u001b[104Gso\u001b[107Gevery\u001b[113Gpinned\r\u001b[2C\u001b[1Bhash\u001b[8Gin\u001b[11Gboth\u001b[16Grepos\u001b[22Gmoves,\u001b[29Gand\u001b[33Gthe\u001b[37Gwork\u001b[42Gneeds\u001b[48Gmigrations.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 1m 2s · done 6:57 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m2, and write the decoupling plan\u001b[39m                                                                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1C\u001b[1B Searching for \u001b[1m8\u001b[22m patterns, reading \u001b[1m1\u001b[22m file, listing \u001b[1m2\u001b[55G\u001b[22mdirectories…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ls '/home/ivan/projects/jettison'/source/test\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
