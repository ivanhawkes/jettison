[0.038, "o", "\u001b[?25l\u001b[H\u001b[3G2\u001b[9G\u001b[1mshrinks\u001b[17Gto the neutral capabilities\u001b[22m, exercised by\u001b[59Ga non-space\u001b[71Gtest ga\u001b[79Ge or the \u001b[38;2;177;185;249mground\u001b[39m and\u001b[99G\u001b[38;2;177;185;249mjetsam\u001b[39m samples, and\u001b[K\r\u001b[2C\u001b[1B  \u001b[6Gthe space-specific code is tested only in Man\u001b[52Gf\u001b[54Gst.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe space code moves into an optional extension package in Jettison\u001b[22m,\u001b[75Goutside\u001b[83Gthe\u001b[87Gcore\u001b[92Gengine.\u001b[100GManifest\u001b[109Gand\u001b[113Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsample both use it, so nothing is duplicated, but it isn't \"into Manifest\".\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd\u001b[7Gchoose\u001b[14Goption\u001b[21G2.\u001b[24GIt's\u001b[29Gthe\u001b[33Gcleanest\u001b[42Gboundary\u001b[51Gand\u001b[55Gmatches\u001b[63Gyour\u001b[68Grule.\u001b[74GIts\u001b[78Gcost\u001b[83Gis\u001b[86Gthat\u001b[91Gthe\u001b[95Gspace\u001b[101Gsample\u001b[108Gloses\u001b[114Gits\r\u001b[2C\u001b[1Bcruises and jumps, unles\u001b[33Gsampl\u001b[39G is rebuilt\u001b[51Go\u001b[53G the neutral transit\u001b[74Gand\u001b[78Gp\u001b[80Gr\u001b[82Gal cap\u001b[89Gbilities.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gline\u001b[12Gcounts\u001b[19Gcome\u001b[24Gfrom\u001b[29Gfile\u001b[34Gtotals,\u001b[42Gand\u001b[46Gthe\u001b[50Ginventory\u001b[60Gagent's\u001b[68Gsplit\u001b[74Gestimates\u001b[84Gare\u001b[88Grough.\u001b[95GI\u001b[97Ghaven't\u001b[105Gchecked\u001b[113Ghow\u001b[117Gfar\r\u001b[2C\u001b[1BManifest's code\u001b[19Gdep\u001b[23Gnds on \u001b[38;2;177;185;249mcelestial\u001b[39m beyond travel and docki\u001b[64Gg. The renames change saved type\u001b[97Gn\u001b[99Gm\u001b[101Gs, so \u001b[108Gvery\u001b[113Gpinned\u001b[K\r\u001b[2C\u001b[1Bh\u001b[5Gsh in both r\u001b[18Gpos moves, and the work nee\u001b[46Gs migrations.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 1m 2s · done 6:57 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m2, and write the decoupling plan\u001b[39m                                                                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m10\u001b[20G\u001b[22mpatterns,\u001b[30Greading\u001b[38G\u001b[1m1\u001b[40G\u001b[22mfile,\u001b[46Glisting\u001b[54G\u001b[1m2\u001b[56G\u001b[22mdirectories,\u001b[69Grunning\u001b[77G\u001b[1m1\u001b[79G\u001b[22mshell\u001b[85Gcommand…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ find '/home/ivan/projects/jettison'/source/samples/space/src -name '*.cpp' -o -name '*.h' | xargs cat | wc -l\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3GCoalescing… \u001b[38;2;153;153;153m(1m 43s · ↓\u001b[27G8.6k tokens)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0014 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39mJettison's space sample has served it's purpose well. Manifest is now available to test all space game related code.\u001b[K\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
