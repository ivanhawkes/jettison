[0.140, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m     \u001b[12G\u001b[22mh\r\u001b[1B \u001b[3G   \u001b[2m 165 \u001b[22m   its policies\u001b[27Ghop\u001b[31Ground.\u001b[38GMeasured\u001b[47Gfirst\u001b[53Gon\u001b[56Gthe\u001b[60Gengine\u001b[67Gas\u001b[70Git\u001b[73Gis,\u001b[77Gby\u001b[80GManifest's\u001b[91G`fixture_traffic`:\u001b[110Gsix\r\u001b[1B     \u001b[2m 166 \u001b[12G\u001b[22m \u001b[14Gstarte\u001b[21Gs flown both ways\u001b[39Gbetween\u001b[47GOre\u001b[51GHighport\u001b[60Gand\u001b[64GVale,\u001b[70Gtwo\u001b[74Gsent\u001b[79Gin\u001b[82Gone\u001b[86Gstep\u001b[91Gas\u001b[94Ga\u001b[96Gpolicy\u001b[103Gsends\u001b[109Gthem\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/roadmap.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 170 \u001b[22m   stations move some 15° an hour, so the two ways' courses in one hour are 5,400 km apart. What is\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 171 \u001b[22m   shared: ships going the same way fly one line 6 to 70 m apart, kept apart by leaving seconds after\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 172 \u001b[22m   one another, and a departure passes some 800 m from an arrival; a station's pads bound how many\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 173 -\u001b[38;2;248;248;242m  leave at once. Taken up when `fixture_traffic` fails\u001b[48;2;92;2;0m,\u001b[48;2;61;1;0m or \u001b[48;2;92;2;0mwhen \u001b[48;2;61;1;0mtraffic it does not cover asks (a     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 173 +\u001b[38;2;248;248;242m  leave at once. Taken up \u001b[48;2;4;71;0mafter that decoupling, \u001b[48;2;2;40;0mwhen `fixture_traffic` fails or traffic it does not c\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242mover asks (a                            