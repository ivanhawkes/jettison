[0.080, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mEngine/space coupling inventory\u001b[35G\u001b[22m(one search\u001b[47Gagent, read-only; I spot-c\u001b[75Gcked four of its claim\u001b[99Ga\u001b[101Gd\u001b[103Gthey hold):\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe split\u001b[13Gis most\u001b[21Gy done at\u001b[31Gthe build lev\u001b[45Gl. No neutral module depends on\u001b[77G\u001b[38;2;177;185;249mcelestial\u001b[39m, \u001b[38;2;177;185;249mspace\u001b[39m or \u001b[38;2;177;185;249mspacescene\u001b[39m, and the\r\u001b[2C\u001b[1Bconfigure\u001b[13Gstep (\u001b[38;2;177;185;249mjettison_check_optional\u001b[39m) fails if one ever \u001b[63Goes. What's left is mostly n\u001b[92Gmes\u001b[96Gand a few shared data\r\u001b[2C\u001b[1Bshapes.\u001b[11GThese\u001b[17Gare\u001b[21Gthe\u001b[25Gfive\u001b[30Gplaces\u001b[37Gwhere\u001b[43Ga\u001b[45Gsplit\u001b[51Gwould\u001b[57Gremove\u001b[64Gthe\u001b[68Gmost:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249m\u001b[1mAi::Reason\u001b[22m\u001b[39m (\u001b[38;2;177;185;249mai/Types.h\u001b[39m) holds about 15 values that only\u001b[62Gspace\u001b[68Guses, such as\u001b[82G\u001b[38;2;177;185;249mNearStation\u001b[39m, \u001b[38;2;177;185;249mOnLane\u001b[39m a\u001b[105G \u001b[38;2;177;185;249mNoGalaxy\u001b[39m.\r\u001b[5C\u001b[1BMoving\u001b[13Gthem\u001b[18Gi\u001b[20Gto a \u001b[38;2;177;185;249mSpace::Reason\u001b[39m is the clearest\u001b[55Gcut. It needs\u001b[70G m\u001b[73Ggration, because\u001b[90Gs\u001b[92Gves store these values\u001b[115Gby\r\u001b[5C\u001b[1Bname and the string tables key them as \u001b[38;2;177;185;249mreason.ai.*\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mScene files\u001b[22m: they store a star-system path, and the neutral scene module has a \u001b[38;2;177;185;249mCelestialBodyComponent\u001b[39m, which\u001b[115Gthe\r\u001b[5C\u001b[1Brenderer reads directly (\u001b[38;2;177;185;249mSceneDraws.cpp:75\u001b[39m). That could become a generic \"placed by an extension\" record.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mRenderer and app\u001b[22m: atmosphere\u001b[36Grin\u001b[40Gs and horizon culling live\u001b[67Gi\u001b[74Gn\u001b[76Gutral rend\u001b[87Grer. The app has\u001b[104G\u001b[38;2;177;185;249m--galaxy\u001b[39m,\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mLoadSystem\u001b[39m, a jump stage in its smoke s\u001b[46Gquenc\u001b[52G, and\u001b[58Gorbit-c\u001b[66Gmera targ\u001b[76Gts\u001b[79Garound\u001b[86Gbodies. The\u001b[98Ge should become\u001b[114Gan\r\u001b[5C\u001b[1Boptional presentation extension.\u001b[K\r\u001b[1B  4. \u001b[1mShip words in neutral APIs\u001b[22m: \u001b[38;2;177;185;249mSim::Helm\u001b[39m, \u001b[38;2;177;185;249mMayFly\u001b[39m, a saved field called \u001b[38;2;177;185;249m\"ship\"\u001b[39m, \u001b[38;2;177;185;249mPhysics.Thrusters\u001b[39m, and \u001b[38;2;177;185;249mSystemIndices\r\u001b[5C\u001b[1B\u001b[39m(which is\u001b[16Greally\u001b[23Gone\u001b[27Gindex\u001b[33Gper\u001b[37Gframe).\u001b[45GThese\u001b[51Gare\u001b[55Gmostly\u001b[62Grenames,\u001b[71Gbut\u001b[75Gsaved\u001b[81Gnames\u001b[87Gneed\u001b[92Galiases.\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[38;2;177;185;249m\u001b[1mdock\u001b[39m counts as neutral but is all station, pad and cargo data.\u001b[69G\u001b[22mIts\u001b[73Gtests\u001b[79Galso\u001b[84Gneed\u001b[89G\u001b[38;2;177;185;249mspace\u001b[39m,\u001b[96Gand\u001b[100G\u001b[38;2;177;185;249mSaveGame\u001b[39m's\u001b[111Gmigration\r\u001b[1B \u001b[3G   \u001b[7Gard-codes the keys \u001b[38;2;177;185;249m\"galaxy\"\u001b[35G\u001b[39mand \u001b[38;2;177;185;249m\"system\"\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gagent\u001b[13Gdidn't\u001b[20Glook\u001b[25Gat\u001b[28Gshaders,\u001b[37Gthe\u001b[41Gstring\u001b[48Gtables,\u001b[56Gthe\u001b[60Gsamples\u001b[68Gor\u001b[71Gthe\u001b[75G\u001b[38;2;177;185;249mdevtools\u001b[84G\u001b[39mmodule.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
