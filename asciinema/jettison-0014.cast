[0.009, "o", "\u001b[H\r\u001b[3B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Docs updated,\u001b[17Gno\u001b[20Gbroken\u001b[27Glinks\u001b[33Gfound.\u001b[40GRunning\u001b[48Gthe\u001b[52Glink\u001b[57Gcheck,\u001b[64Gformat\u001b[71Gcheck\u001b[77Gand\u001b[81Gtidy\u001b[86Gon\u001b[89Gthe\u001b[93Gtouched\u001b[101Gunit,\u001b[107Gthen\r\u001b[2C\u001b[1Bcommitting\u001b[14Gthe\u001b[18Gdeletion.\r\u001b[1B\u001b[K\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+14\u001b[38;2;153;153;153m, ran \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRetirement committed (\u001b[38;2;177;185;249md924475\u001b[39m).\u001b[35GLast\u001b[40Gpiece:\u001b[47Gthe\u001b[51Gcargo\u001b[57Gdeck.\u001b[63GChecking\u001b[72Gwhether\u001b[80GManifest's\u001b[91Gworlds\u001b[98Ghold\u001b[103Gbuggies,\u001b[112Gsince\r\u001b[2C\u001b[1Bremoving\u001b[12Gthem\u001b[17Gwould\u001b[23Gmove\u001b[28Gits\u001b[32Gpinned\u001b[39Ghashes.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m5\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRemoving the deck would change every pinned world hash in Manifest and Jettison's suites,\u001b[93Gsince\u001b[99Gthe\u001b[103Gworld\u001b[109Gwrites\u001b[116Geach\r\u001b[2C\u001b[1Bregist\u001b[10Gred component\u001b[24Gname\u001b[29Ginto\u001b[34Gsave\u001b[39Gbytes.\u001b[46GI'm\u001b[50Gchecking\u001b[59Gwhether\u001b[67GManifest\u001b[76Gpins\u001b[81Ganything\u001b[90Gover\u001b[95Gits\u001b[99Gdefinitions\u001b[111Gbefore\r\u001b[2C\u001b[1Basking how you want to handle it.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[3G\u001b[38;2;223;134;102mBaking…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(42m 27s · ↓\u001b[39m \u001b[38;2;153;153;153m119.8k\u001b[31Gtok\u001b[35Gns)\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0014 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  \u001b[38;2;153;153;153m\u001b[2mOpus 5.5 ctx [####------] 43% | 5h: 18% | ↑434.2k ↓8\r\u001b[1B\u001b[22m\u001b[39m  \u001b[38;2;255;193;7m⏵⏵ auto mode on\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
