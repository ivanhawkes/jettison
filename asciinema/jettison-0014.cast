[0.022, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mAdjust yourself so you always stage the files by name to avoid tripping that hook again.\u001b[39m                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRecalled \u001b[1m2\u001b[22m memories, wrote \u001b[1m3\u001b[22m memories \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFr\u001b[6Gm\u001b[8Gnow\u001b[12Go\u001b[14G I'll stage every commit by naming its files, as in \u001b[38;2;177;185;249mgit add docs/a.md source/b.cpp\u001b[39m. I\u001b[100Gwon't\u001b[106Guse\u001b[110G\u001b[38;2;177;185;249m-A\u001b[39m,\u001b[114G\u001b[38;2;177;185;249m--all\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m.\u001b[5G\u001b[39mor\u001b[8G\u001b[38;2;177;185;249m-u\u001b[39m,\u001b[12Gincluding\u001b[22Gwith\u001b[27Ga\u001b[29Gpath\u001b[34Gafter\u001b[40Gthem\u001b[45Glike\u001b[50G\u001b[38;2;177;185;249mgit add -A docs\u001b[39m,\u001b[67Gwhich\u001b[73Gis\u001b[76Gwhat\u001b[81Gthe\u001b[85Ghook\u001b[90Gblocked.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI saved th\u001b[14Gs as a\u001b[21Gnew memory, \u001b[38;2;177;185;249mstage-files-by-name.md\u001b[39m, and added it to th\u001b[77Gmemory index, so\u001b[94Git's\u001b[99Gl\u001b[101Gaded at th\u001b[112G star\u001b[118G of\r\u001b[2C\u001b[1Bev\u001b[6Gry session.\u001b[18GMy\u001b[21Gexisting\u001b[30Gasciinema\u001b[40Gmemory\u001b[47Galready\u001b[55Gsaid\u001b[60Gto\u001b[63Gstage\u001b[69Gby\u001b[72Gname\u001b[77Gbut\u001b[81Gdidn't\u001b[88Gstand\u001b[94Gout,\u001b[99Gso\u001b[102GI've\u001b[107Glinked\u001b[114Git\u001b[117Gto\r\u001b[2C\u001b[1Bthe\u001b[7Gnew\u001b[11Gone.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 22s · done 6:07 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;25