[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe word check.\u001b[22m The \u001b[26Gew \u001b[38;2;177;185;249mneutral_words\u001b[39m suite fails if\u001b[58Ga n\u001b[62Gutr\u001b[66Gl engine module uses\u001b[87Gone\u001b[91Gof\u001b[94Gthe\u001b[98Gspace\u001b[104Gwords:\u001b[111Gstar\r\u001b[4C\u001b[1Bsystem, c\u001b[15Glest\u001b[20Gal, galaxy,\u001b[32Gjump\u001b[37Gpoint/lane/gate,\u001b[54Gstation,\u001b[63Gship,\u001b[69Ghull,\u001b[75Gcruise,\u001b[83Gpad,\u001b[88Gcargo.\u001b[95GIt\u001b[98Greads\u001b[104Gcomments\u001b[113Gand\u001b[117Gcode\r\u001b[4C\u001b[1B(camelCase\u001b[16Gsplit\u001b[22Ginto\u001b[27Gwords)\u001b[34Gbut\u001b[38Gnot\u001b[42Gstring\u001b[49Gliterals,\u001b[59Gwhere\u001b[65Gthe\u001b[69Gsaved\u001b[75Gnames\u001b[81Glive.\u001b[87GIt\u001b[90Galso\u001b[95Gfails\u001b[101Gif\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcmake/neutral-words.txt\u001b[39m lists a\u001b[37Gword that's no longer there,\u001b[66Gso\u001b[69Gthe\u001b[73Glist\u001b[78Gcan\u001b[82Gonly\u001b[87Gshrink.\u001b[95GI\u001b[97Gtested\u001b[104Gboth\u001b[109Gdirections:\r\u001b[4C\u001b[1Ba\u001b[7Gplanted\u001b[15G\"ship\"\u001b[22Gfails\u001b[28Git.\r\u001b[2C\u001b[1B- \u001b[1mThe list went from 184 entries to 66.\u001b[43G\u001b[22mThe\u001b[47G66\u001b[50Gleft\u001b[55Geach\u001b[60Gbelong\u001b[67Gto\u001b[70Ga\u001b[72Glater\u001b[78Gslice:\u001b[85G39\u001b[88Gin\u001b[91Gthe\u001b[95Gdocks,\u001b[102Gplus\u001b[107Gthe\u001b[111Grefusal\r\u001b[4C\u001b[1Breasons,\u001b[14Gscene\u001b[20Gfiles,\u001b[27Gapp\u001b[31Goptions,\u001b[40Gsmoke\u001b[46Grun\u001b[50Gand\u001b[54Gsave\u001b[59Gmigration.\r\u001b[1B \u001b[3G- \u001b[1mComments\u001b[14G\u001b[22min ai, physics, \u001b[31Gim, spatial, render, scene, app,\u001b[64Gaudio and the s\u001b[80Gall\u001b[84Gr\u001b[86Gmodules\u001b[94Gnow say\u001b[102Gvehicle,\u001b[111Gplatform,\r\u001b[4C\u001b[1Bberth,\u001b[12Gframe\u001b[18Gand\u001b[22Gtransit.\u001b[31GThree\u001b[37Gcheaper\u001b[45Gagents\u001b[52Gdid\u001b[56Gthe\u001b[60Grewording;\u001b[71GI\u001b[73Greviewed\u001b[82Gthe\u001b[86Gdiffs.\r\u001b[2C\u001b[1B- \u001b[1mRenames in C++ only:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- \u001b[38;2;177;185;249mSystemIndices\u001b[21G\u001b[39mis now \u001b[38;2;177;185;249mFrameIndices\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B- S\u001b[10Gering's \u001b[38;2;177;185;249mbyHull\u001b[39m, \u001b[38;2;177;185;249mHullLimited\u001b[39m and \u001b[38;2;177;185;249mkHullSlack\u001b[39m are now \u001b[38;2;177;185;249mbyShape\u001b[39m, \u001b[38;2;177;185;249mShapeLimited\u001b[83G\u001b[39man\u001b[86G \u001b[38;2;177;185;249mkShapeSlack\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B- Th\u001b[10G s\u001b[13Gv\u001b[15Gd field is still \u001b[38;2;177;185;249m\"byHull\"\u001b[39m,\u001b[42Gas agreed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames I kept:\u001b[22m flight, thru\u001b[33Gers\u001b[37Gand helm, \u001b[48Gi\u001b[50Gce a\u001b[55Gy vehicl\u001b[64G has\u001b[72Gm, and \"convex\u001b[87Ghull\", which is ge\u001b[106Gmetry's own\u001b[K\r\u001b[4C\u001b[1Bterm.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mJettison's full gate passed\u001b[22m in 604 s.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest's quick gate passed\u001b[22m in\u001b[37G357 s, agai\u001b[49Gst\u001b[52Gabou\u001b[57G 17 minutes for\u001b[73Gits full\u001b[82Ggate. Every\u001b[94Gpinned\u001b[101Ghash\u001b[106Gheld.\r\u001b[2C\u001b[1B \u001b[5GManifest's commit \u001b[38;2;177;185;249m2df6420\u001b[31G\u001b[39mmoves\u001b[37Gits\u001b[41Gengine\u001b[76G\u001b[38;2;177;185;249mystemIndices\u001b[89G\u001b[39min\u001b[92Gthree\u001b[98Gfiles.\u001b[105GIt\u001b[108Gstays\u001b[114Glocal\u001b[27;1H\u001b[24;3H\u001b[?25h"]
