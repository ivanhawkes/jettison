Gone\u001b[49Gplayer\u001b[56Gsends\u001b[62Gcommands.\u001b[72GThe\u001b[76Gserver\u001b[83Gwould\u001b[89Gdecide\u001b[96Geach\u001b[101Gcall's\u001b[108Gcontext,\u001b[117Gso\r\u001b[2C\u001b[1B \u001b[5G a play\u001b[13Gr's handler sends as that player and an NPC's as that NPC. It\u001b[75Gwould also stamp \u001b[38;2;177;185;249mSim::Controller\u001b[39m values nested\r\u001b[2C\u001b[1B   \u001b[8Gside a command's\u001b[25Gfields,\u001b[33Gwhich\u001b[39Gthe\u001b[43Ghost\u001b[48Gdoesn't\u001b[56Gdo\u001b[59Gyet.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mEncryption.\u001b[18G\u001b[22mIt's\u001b[23Gwell\u001b[28Gspecified\u001b[38Gand\u001b[42Gself-contained,\u001b[58Gand\u001b[62GManifest\u001b[71Gwill\u001b[76Gneed\u001b[81Git\u001b[84Gbefore\u001b[91Gany\u001b[95Gpublic\u001b[102Ghosting.\r\u001b[1B \u001b[3G3. \u001b[1mThe way in to a pad, done properly.\u001b[42G\u001b[22mThis\u001b[47Gis\u001b[50Gfirst\u001b[56Gin\u001b[59Gthe\u001b[63G\"Then\"\u001b[70Gtier,\u001b[76Gand\u001b[80Gevery\u001b[86GNPC\u001b[90Gand\u001b[94Gautopilot\u001b[104Gtrade\u001b[110Gin\u001b[113GManifest\u001b[27;1H\u001b[24;3H\u001b[?25h"]
