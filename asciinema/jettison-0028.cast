[0.049, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat changed in Jettison\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mFacts ch\u001b[14Gcked\u001b[19Gagain\u001b[25Gt the code.\u001b[37G\u001b[22mNine\u001b[42Gaudit\u001b[48Gpasses\u001b[55Gfound\u001b[61Ga\u001b[63Glot\u001b[67Gof\u001b[70Gdrift:\u001b[77Gmigrations\u001b[88Gdescribed\u001b[98Gthat\u001b[103Gthe\u001b[107Gcode\u001b[112Gdeleted,\r\u001b[2C\u001b[1B \u001b[5Gthe retired space sample's examples,\u001b[42GGLM 1.0.1 instead of\u001b[63G1.0.3,\u001b[70Ga wrong physics \u001b[87Gav\u001b[90G layout, and\u001b[103Gfinished\u001b[112Gwork\u001b[K\r\u001b[4C\u001b[1Bwritt\u001b[11Gn as plann\u001b[22Gd. Al\u001b[28G of\u001b[32Git is corrected\u001b[48G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNew structure.\u001b[22m \u001b[38;2;177;185;249mdocs/README.md\u001b[38G\u001b[39mthe ind\u001b[46Gx\u001b[49G\u001b[38;2;177;185;249marchitecture.md\u001b[65G\u001b[39mis\u001b[68Gnow\u001b[72Gan\u001b[75Goverview\u001b[84G(1,940\u001b[91Glines\u001b[97Gdown\u001b[102Gto\u001b[105Gabout 440).\r\u001b[2C\u001b[1B \u001b[5GThere are 18 feature documents, from\u001b[42GSimulation through The\u001b[65Gapp shell\u001b[75Gand tools. \u001b[38;2;177;185;249mglossary.md\u001b[39m defines about 1\u001b[114G0 terms\r\u001b[4C\u001b[1Bonce,\u001b[12Gnd\u001b[15Gother documents link to it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDiagrams and examples.\u001b[22m There are 51 mermaid\u001b[49Gdiagrams,\u001b[59Gall\u001b[63Gchecked\u001b[71Gwith\u001b[76G\u001b[38;2;177;185;249mmmdc\u001b[39m,\u001b[82Gand\u001b[86Gthe\u001b[90Gexamples\u001b[99Gcome\u001b[104Gfrom\u001b[109Gthe\u001b[113Gtests,\r\u001b[2C\u001b[1B \u001b[5Gthe ground sample and the t\u001b[33Gst content.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo duplicates.\u001b[22m R\u001b[22Gpeated \u001b[30Gxplanations are\u001b[46Gcut\u001b[50Gto\u001b[53Ga\u001b[55Glink\u001b[60Gto\u001b[63Gtheir\u001b[69Gone\u001b[73Ghome,\u001b[79Gand\u001b[83Gevery\u001b[89Glink\u001b[94Gresolves.\r\u001b[4C\u001b[1B\u001b[1mBacklog renumbered J01–J29\u001b[22m in pr\u001b[39Grity order, with stable\u001b[63Ganchors. T\u001b[74Ge space-gam\u001b[86G items moved out to\u001b[106G\u001b[38;2;177;185;249mfor-manifest.md\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gin my scratch folder, for Ma\u001b[34Gifest's backl\u001b[76G\u001b[K\u001b[27;1H\u001b[17;3H\u001b[?25h"]
