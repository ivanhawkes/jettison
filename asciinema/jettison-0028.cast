[0.603, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B  \u001b[6Ga\u001b[8Gd level-of-detail\u001b[26Gsetters (nothing calls them)\u001b[56Gand k\u001b[62Gep \u001b[38;2;177;185;249mEcs::StateMachine\u001b[39m?\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6GShou\u001b[11Gd bus volume changes be eased, as the\u001b[49Gold docs promised? They currently change\u001b[90Ginstantly.\r\u001b[2C\u001b[1B5\u001b[6GT\u001b[8Ge shell's \u001b[19Gwn user directorie\u001b[38G and crash\u001b[49Gdirectory aren't created th\u001b[77Gough \u001b[38;2;177;185;249mCreateDirectoriesDurably\u001b[39m.\u001b[108GShould\u001b[115Gthey\r\u001b[2C\u001b[1B  \u001b[6Gbe?\u001b[10G\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6GShould\u001b[13Gthe\u001b[17Geditor's\u001b[26Gscope\u001b[32Gverdict\u001b[40Gbe\u001b[43G\"In,\u001b[48Gminimal\"\u001b[57Gor\u001b[60GDeferred?\u001b[70GFlotsam\u001b[78Gis\u001b[81Gthe\u001b[85Gshell\u001b[91Gwith\u001b[96Gno\u001b[99Ggame.\r\u001b[2C\u001b[1B7\u001b[13Gany\u001b[17Gof \u001b[21Ghese\u001b[26Gget a\u001b[32Gbacklog\u001b[40GID: the\u001b[48Gshell not starting through \u001b[38;2;177;185;249mHost::Session\u001b[39m, the parallel scheduler,\u001b[114Gor\r\u001b[2C\u001b[1B  \u001b[6Gt\u001b[8Gree persistenc\u001b[23G gaps (\u001b[32Gwrite that refuses to\u001b[54Greplace a file, fault injection under system ca\u001b[102Gl\u001b[104G, the lock\u001b[K\r\u001b[5C\u001b[1Bhold\u001b[11Gr's name)?\u001b[K\r\u001b[2C\u001b[1B8.\u001b[6GThe dev-tools theme\u001b[26Greview's\u001b[35Glast\u001b[40Gtwo\u001b[44Gfindings\u001b[53G(F5/F6)\u001b[61Gwere\u001b[66Gnever\u001b[72Gsettled.\u001b[81GThe\u001b[85Ghandoff\u001b[93Gis\u001b[96Garchived\u001b[105Gin\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mdocs/history/devtools-theme.md\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis\u001b[8Gis\u001b[11Ga\u001b[13Ggood\u001b[18Gpoint\u001b[24Gto\u001b[27G\u001b[38;2;177;185;249m/compact\u001b[36G\u001b[39mbefore\u001b[43Gthe\u001b[47GManifest\u001b[56Ghalf;\u001b[62Gthe\u001b[66Gnotes\u001b[72GI\u001b[74Gneed\u001b[79Gto\u001b[82Gresume\u001b[89Gare\u001b[93Gin\u001b[96Gthe\u001b[100Gscratch\u001b[108Gfolder.\r\u001b[2C\u001b[1B    \u001b[8G  \u001b[11G \u001b[13G    \u001b[18G     \u001b[24G  \u001b[27G        \u001b[36G      \u001b[43G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;6H\u001b[?25h"]
