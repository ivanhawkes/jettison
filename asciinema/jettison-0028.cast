[0.209, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWho a script commands as, under networked play.\u001b[54G\u001b[22mThis\u001b[59Gis\u001b[62Gthe\u001b[66Gtop\u001b[70Gof\u001b[73Gthe\u001b[77G\"First\"\u001b[85Gtier:\u001b[91Git\u001b[94Gfixes\u001b[100Gthe\u001b[104Gshape\u001b[110Gof\u001b[113Gcommands\r\u001b[2C\u001b[1B  \u001b[6Gand gets more expensive once more than one player send\u001b[62Gcommands. The server would decide each call's context, so\u001b[K\r\u001b[6C\u001b[1B player's handler \u001b[26Gends as that player and an NPC's a\u001b[62Gthat NPC\u001b[72GIt would als\u001b[85G stamp \u001b[38;2;177;185;249mSim::Controller\u001b[108G\u001b[39mvalu\u001b[113Gs ne\u001b[118Gted\r\u001b[5C\u001b[1Binside a command's\u001b[25Gfields, which\u001b[39Gthe host \u001b[49Goesn't do\u001b[59Gyet.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mEncryption.\u001b[22m It's well specified and self-contained, and Manifest\u001b[71Gwill\u001b[76Gneed\u001b[81Git\u001b[84Gbefore\u001b[91Gany\u001b[95Gpublic\u001b[102Ghosting.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mThe way i\u001b[16G to a pad, done properly.\u001b[42G\u001b[22mThis is first in the \"Then\" tier,\u001b[76Gand every NPC and autop\u001b[100Glot trade in\u001b[113GManifest\r\u001b[2C\u001b[1B  \u001b[6Gdocks through it. The fix is an approach\u001b[47Gcorr\u001b[52Gdor, a\u001b[59Greservation that\u001b[76Glaps\u001b[81Gs when a\u001b[90Gship s\u001b[99Gs making progress,\u001b[K\r\u001b[5C\u001b[1Band Arrive damping the sideways\u001b[38Gvelocity.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'd\u001b[7Gstart\u001b[13Gwith\u001b[18G\u001b[1m1\u001b[22m:\u001b[21Git's\u001b[26Gthe\u001b[30Gonly\u001b[35Gone\u001b[39Gthat\u001b[44Gchanges\u001b[52Gwhat\u001b[57Ggoes\u001b[62Ginto\u001b[67Gand\u001b[71Gout\u001b[75Gof\u001b[78Gthe\u001b[82Gstep,\u001b[88Gand\u001b[92Git\u001b[95Glines\u001b[101Gup\u001b[104Gwith\u001b[109Gencryption,\r\u001b[2C\u001b[1Bwhich can\u001b[13Gfollow straight after. Whic\u001b[41G one do you w\u001b[55Gnt?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gonly\u001b[10Gchecked\u001b[18GManifest's\u001b[29G\u001b[38;2;177;185;249mdelivery-order.md\u001b[47G\u001b[39mfor\u001b[51Gwhat\u001b[56Git's\u001b[61Gwaiting\u001b[69Gon;\u001b[73GI\u001b[75Gdidn't\u001b[82Gre-read\u001b[90Gthe\u001b[94Gscripting\u001b[104Gor\u001b[107G\u001b[38;2;177;185;249mnet\u001b[111G\u001b[39mcode\r\u001b[2C\u001b[1Bbehind\u001b[10Gt\u001b[13Gse items.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 19s · done 1:05 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0028 ─\r\u001b[1B\u001b[39m❯ Let's work on the documentation. I want you to thoroughly review all the files in ./docs. Compare their statements\u001b[K\r\u001b[1B  against the ground tr\u001b[25Gth of the code.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTake\u001b[8Gany\u001b[12Gdocumentation\u001b[26Gon\u001b[29Groadmap\u001b[37Gitems\u001b[43Gthat\u001b[48Gcan\u001b[52Gnow\u001b[56Gbe\u001b[59Garchived\u001b[68Gand\u001b[72Gmove\u001b[77Git\u001b[80Ginto\u001b[85Gthe\u001b[89Ghistory.md\u001b[100Gfile.\u001b[106GCheck\u001b[112Gthe\r\u001b[2C\u001b[1Bnumb\u001b[8G\u001b[K\u001b[27;1H\u001b[24;7H\u001b[?25h"]
