[0.006, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCode comments.\u001b[22m About 115 file\u001b[35G that ci\u001b[44Ged old doc s\u001b[57Gctions now point to\u001b[77Gthe new ones, and the\u001b[99Gstale c\u001b[107Gmm\u001b[110Gnts the\u001b[K\r\u001b[4C\u001b[1Baudit found are fixed.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mmermaid-cli\u001b[22m\u001b[39m is added to both r\u001b[36Gpos' \u001b[38;2;177;185;249mdevenv.nix\u001b[39m. Manif\u001b[59Gs\u001b[61G's change is not committed yet.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe docs are \u001b[19Gong\u001b[23Gr.\u001b[22m The non-history \u001b[43Gocs went from about 5,300 lines to about 12,000. The \u001b[97Gditing p\u001b[106Gsses only\u001b[116Gcut\r\u001b[4C\u001b[1B6–9% of the word\u001b[22G, because\u001b[32Gmost\u001b[37Gof\u001b[40Gwhat\u001b[45Gremains\u001b[53Gis\u001b[56Gexamples,\u001b[66Gtables\u001b[73Gand\u001b[77Gdiagrams.\u001b[87GIf\u001b[90Gyou\u001b[94Gwant\u001b[99Gthem\u001b[104Gshorter,\u001b[113Ga\u001b[115Gpass\r\u001b[4C\u001b[1Bthat\u001b[10Gtrims\u001b[16Gthe\u001b[20Gexamples\u001b[29Gis\u001b[32Gthe\u001b[36Glever.\r\u001b[2C\u001b[1B- \u001b[1mI d\u001b[9Gd\u001b[11G't run the full gate.\u001b[22m The code changes are\u001b[54Gcomments\u001b[63Gonly.\u001b[69GThe\u001b[73Gformat\u001b[80Gcheck\u001b[86Gpasses,\u001b[94Gand\u001b[98G\u001b[38;2;177;185;249mcomment-only.sh\u001b[114G\u001b[39mflags\r\u001b[2C\u001b[1B  only three edits\u001b[22Gouts\u001b[27Gde code comments: a CSS comment\u001b[60Gthe \u001b[38;2;177;185;249mdevenv.nix\u001b[39m line,\u001b[81Gand\u001b[85Ga string in \u001b[38;2;177;185;249mCheckNeutralWords.cmake\r\u001b[2C\u001b[1B\u001b[39m  (i\u001b[8Gs \u001b[38;2;177;185;249mneutral_words\u001b[39m test still passes).\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mAGENTS.md\u001b[39m still repeats\u001b[22m some build-and-gates how-tos (tidy, captur\u001b[72G, m\u001b[76Gmory). I left them because\u001b[103Gt\u001b[106Gt file is\u001b[K\r\u001b[4C\u001b[1Bloa\u001b[9Ged every session.       \u001b[34G        \u001b[43G    \u001b[76G\u001b[K\u001b[27;1H\u001b[17;3H\u001b[?25h"]
