[0.117, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mBacklog renumbered J01–J29\u001b[22m in pr\u001b[39Grity order, with stable\u001b[63Ganchors. T\u001b[74Ge space-gam\u001b[86G items moved out to\u001b[106G\u001b[38;2;177;185;249mfor-manifest.md\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gin my scratch folder, for Ma\u001b[34Gifest's backlog.\u001b[51G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHistory folder.\u001b[22m \u001b[38;2;177;185;249mhistory.md\u001b[39m is now the index of\u001b[52G\u001b[38;2;177;185;249mdocs/history/\u001b[39m.\u001b[67GThe\u001b[71Gfinished\u001b[80Gplans\u001b[86Gare\u001b[90Garchived\u001b[99Gthere,\u001b[106Galong\u001b[112Gwith\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gretired decisions and the notes moved\u001b[43Gout of the reference docum\u001b[70Gnts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCode comments.\u001b[22m About 115 files that cited\u001b[48Gld doc sections\u001b[64Gn\u001b[66Gw point to\u001b[77Gthe\u001b[81Gnew\u001b[85Gones,\u001b[91Gand\u001b[95Gthe\u001b[99Gstale\u001b[105Gcomments\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gaudit found are fixed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mmermaid-cli\u001b[17G\u001b[22m\u001b[39mis added to\u001b[29Gboth\u001b[34Grepos'\u001b[41G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m.\u001b[53GManifest's\u001b[64Gchange\u001b[71Gis\u001b[74Gnot\u001b[78Gcommitted\u001b[88Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe docs are longer.\u001b[26G\u001b[22mThe\u001b[30Gnon-history\u001b[42Gdocs\u001b[47Gwent\u001b[52Gfrom\u001b[57Gabout\u001b[63G5,300\u001b[69Glines\u001b[75Gto\u001b[78Gabout\u001b[84G12,000.\u001b[92GThe\u001b[96Gediting\u001b[104Gpasses\u001b[111Gonly\u001b[116Gcut\r\u001b[2C\u001b[1B \u001b[5G6–9% of the words, because most of what remains is examples\u001b[65G tab\u001b[70Ges and diagrams. If you want \u001b[100Ghem\u001b[104Gshorter, a pass\r\u001b[4C\u001b[1Bthat\u001b[10Gtrims the examples is\u001b[32Gthe lever.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mI didn't run the full gate.\u001b[22m The code changes\u001b[50Gare\u001b[54Gcomments\u001b[63Gonly.\u001b[69GThe\u001b[73Gformat\u001b[80Gcheck\u001b[86Gpasses,\u001b[94Gand\u001b[98G\u001b[38;2;177;185;249mcomment-only.sh\u001b[114G\u001b[39mflags\r\u001b[2C\u001b[1B \u001b[5Gonly three edits outside code comments: a CSS comment, \u001b[61Ghe \u001b[38;2;177;185;249mdevenv.nix\u001b[39m line, and a string\u001b[94Gi\u001b[96G \u001b[38;2;177;185;249mCheckNeutra\u001b[109GWords.cmake\u001b[39m\u001b[27;1H\u001b[17;3H\u001b[?25h"]
