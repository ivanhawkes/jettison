[0.019, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mHistory\u001b[13Gfolder.\u001b[22m \u001b[38;2;177;185;249mhistory.md\u001b[33G\u001b[39ms\u001b[35Gnow the index of \u001b[38;2;177;185;249mdocs/history/\u001b[39m. The finished plans are archi\u001b[99Gthere,\u001b[106Galong with the\u001b[K\r\u001b[4C\u001b[1Bretired decisions and\u001b[27Gthe\u001b[31Gnotes moved out \u001b[48Gf the\u001b[54Greference\u001b[64Gdocuments.\r\u001b[4C\u001b[1B\u001b[1mCode comments.\u001b[22m About 115 files tha\u001b[40G cite\u001b[46G old doc sections now point to the new ones, and the\u001b[99Gstal\u001b[104G comments \u001b[116Ge\u001b[K\r\u001b[4C\u001b[1Baud\u001b[9Gt found are fixe\u001b[26G.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mmermaid-cli\u001b[22m\u001b[39m is\u001b[20Gadded\u001b[26Gto both repos'\u001b[41G\u001b[38;2;177;185;249mdevenv.nix\u001b[39m. Manifest'\u001b[64Gchange is\u001b[74Gn\u001b[76Gt committed yet.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe docs are longer.\u001b[26G\u001b[22mThe\u001b[30Gnon-history\u001b[42Gdocs\u001b[47Gwent\u001b[52Gfrom\u001b[57Gabout\u001b[63G5,300\u001b[69Glines\u001b[75Gto\u001b[78Gabout\u001b[84G12,000.\u001b[92GThe\u001b[96Gediting\u001b[104Gpasses\u001b[111Gonly\u001b[116Gcut\r\u001b[2C\u001b[1B  6–9% of the words,\u001b[24Gbecause\u001b[32Gmost\u001b[37Gof\u001b[40Gwhat\u001b[45Gremains\u001b[53Gis\u001b[56Gexamples,\u001b[66Gtables\u001b[73Gand\u001b[77Gdiagrams.\u001b[87GIf\u001b[90Gyou\u001b[94Gwant\u001b[99Gthem\u001b[104Gshorter,\u001b[113Ga\u001b[115Gpass\r\u001b[2C\u001b[1B \u001b[5Gthat trims the examples is the lever.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mI didn't run the full gate.\u001b[22m The\u001b[37Gcode changes are comments only. The\u001b[73Gformat check passes,\u001b[94Gand \u001b[38;2;177;185;249mcomment-only.sh\u001b[39m fl\u001b[117Gg\r\u001b[4C\u001b[1Bonly\u001b[11Ghree\u001b[16Gedits outside code comm\u001b[40Gnts:\u001b[45Ga\u001b[47GCSS\u001b[51Gcomment,\u001b[60Gthe\u001b[64G\u001b[38;2;177;185;249mdevenv.nix\u001b[75G\u001b[39mline,\u001b[81Gand\u001b[85Ga\u001b[87Gstring\u001b[94Gin\u001b[97G\u001b[38;2;177;185;249mCheckNeutralWords.cmake\r\u001b[2C\u001b[1B\u001b[39m \u001b[5G(its \u001b[38;2;177;185;249mneutral_words\u001b[39m test still passes).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\r\u001b[109C\u001b[9B\u001b[38;2;153;153;153m3\u001b[39m\u001b[27;1H\u001b[17;3H\u001b[?25h"]
