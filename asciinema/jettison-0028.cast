[0.071, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mNo duplicates.\u001b[20G\u001b[22mRepeated\u001b[29Gexplanations\u001b[42Gare\u001b[46Gcut\u001b[50Gto\u001b[53Ga\u001b[55Glink\u001b[60Gto\u001b[63Gtheir\u001b[69Gone\u001b[73Ghome,\u001b[79Gand\u001b[83Gevery\u001b[89Glink\u001b[94Gresolves.\r\u001b[1B  - \u001b[1mBacklog renumbered J01–J29\u001b[22m in priority order, with stable\u001b[63Ganchors.\u001b[72GThe\u001b[76Gspace-game\u001b[87Gitems\u001b[93Gmoved\u001b[99Gout\u001b[103Gto\u001b[106G\u001b[38;2;177;185;249mfor-manifest.md\r\u001b[4C\u001b[1B\u001b[39min\u001b[8Gmy\u001b[11Gscratch\u001b[19Gfolder,\u001b[27Gfor\u001b[31GManifest's\u001b[42Gbacklog.\r\u001b[1B \u001b[3G- \u001b[1mHistory folder.\u001b[22m \u001b[38;2;177;185;249mhistory.md\u001b[39m is now the index\u001b[49Gof\u001b[52G\u001b[38;2;177;185;249mdocs/history/\u001b[39m.\u001b[67GThe\u001b[71Gfinished\u001b[80Gplans\u001b[86Gare\u001b[90Garchived\u001b[99Gthere,\u001b[106Galong\u001b[112Gwith\u001b[117Gthe\r\u001b[1B    retired decisions and the notes moved out of the reference\u001b[64Gdocuments.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCode comments.\u001b[20G\u001b[22mAbout\u001b[26G115\u001b[30Gfiles\u001b[36Gthat\u001b[41Gcited\u001b[47Gold\u001b[51Gdoc\u001b[55Gsections\u001b[64Gnow\u001b[68Gpoint\u001b[74Gto\u001b[77Gthe\u001b[81Gnew\u001b[85Gones,\u001b[91Gand\u001b[95Gthe\u001b[99Gstale\u001b[105Gcomments\u001b[114Gthe\r\u001b[1B \u001b[3G  audit found ar\u001b[20G fix\u001b[25Gd.\u001b[K\r\u001b[1B  - \u001b[38;2;177;185;249m\u001b[1mmermaid-cli\u001b[22m\u001b[39m is added to both repos' \u001b[38;2;177;185;249mdevenv.nix\u001b[39m. Manifest's\u001b[64Gchange\u001b[71Gis\u001b[74Gnot\u001b[78Gcommitted\u001b[88Gyet.\r\u001b[2B \u001b[3G\u001b[1mThings to know\u001b[22m\u001b[K\r\u001b[1B  - \u001b[1mThe docs are longer.\u001b[22m The non-history docs went from about 5,300 lines to about 12,000. The editing passes only\u001b[116Gcut\r\u001b[4C\u001b[1B6–9%\u001b[10Gof\u001b[13Gthe\u001b[17Gwords,\u001b[24Gbecause\u001b[32Gmost\u001b[37Gof\u001b[40Gwhat\u001b[45Gremains\u001b[53Gis\u001b[56Gexamples,\u001b[66Gtables\u001b[73Gand\u001b[77Gdiagrams.\u001b[87GIf\u001b[90Gyou\u001b[94Gwant\u001b[99Gthem\u001b[104Gshorter,\u001b[113Ga\u001b[115Gpass\r\u001b[1B \u001b[3G  that trims the examples is the lever.\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[17;3H\u001b[?25h"]
