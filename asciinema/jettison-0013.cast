[0.057, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDeclaration spacing is\u001b[26Gclean\u001b[32Gin\u001b[35Gmy\u001b[38Gfiles;\u001b[45Gthe\u001b[49Gtwo\u001b[53G\u001b[38;2;177;185;249mnet\u001b[57G\u001b[39mfiles\u001b[63Gflagged\u001b[71Gwere\u001b[76Galready\u001b[84Glike\u001b[89Gthat\u001b[94Gbefore\u001b[101Gthis\u001b[106Gchange.\r\u001b[2C\u001b[1BCommitting\u001b[14Gand\u001b[18Gstarting\u001b[27Gthe\u001b[31Ggate.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands, did not run \u001b[1m1\u001b[22m other call \r\u001b[1B  ⎿  $ git add -A docs source/engine/space source/samples/space/tests/ModsTests.cpp\r\u001b[1B  ⎿  1 action\u001b[15Gn\u001b[17Gt run ·\u001b[25Gpermission denied\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m│\u001b[22m \u001b[38;2;153;153;153mReason:\u001b[16GPreT\u001b[21GolU\u001b[25Ge:Bash hook error:\u001b[44Ggit add -A/--all/. would \u001b[70Gtage ./asciinema: add the files by name.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted as \u001b[38;2;177;185;249ma9b8305\u001b[39m; the gate is running. Meanwhile, reading (not building) how Manifest pins the SDK.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate is running. Moving Manifest's pin means\u001b[52Gfetching\u001b[61Gthe\u001b[65Gcommit\u001b[72Gfrom\u001b[77GGitHub,\u001b[85Gso\u001b[88Git\u001b[91Ghas\u001b[95Gto\u001b[98Gwait\u001b[103Guntil\u001b[109Gthis\u001b[114Gcommit\r\u001b[2C\u001b[1Bis\u001b[6Gpushed.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand…\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m17\u001b[18G 29s ·\u001b[25G↓\u001b[39m \u001b[38;2;153;153;153m33.2k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.038, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDeclaration\u001b[15Gspacing\u001b[23Gis\u001b[26Gclean\u001b[32Gin\u001b[35Gmy\u001b[38Gfiles;\u001b[45Gthe\u001b[49Gtwo\u001b[53G\u001b[38;2;177;185;249mnet\u001b[57G\u001b[39mfiles\u001b[63Gflagged\u001b[71Gwere\u001b[76Galready\u001b[84Glike\u001b[89Gthat\u001b[94Gbefore\u001b[101Gthis\u001b[106Gchange.\r\u001b[1B \u001b[3GCommitting and start\u001b[24Gng the gate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands, did not run \u001b[1m1\u001b[22m other call \r\u001b[1B  ⎿  $ git add -A doc\u001b[23G source/engi\u001b[36Ge/spac\u001b[43G source/samples/space/tests/ModsTests.cpp\r\u001b[5C\u001b[1B1\u001b[8Gac\u001b[11Gion not\u001b[19Grun · pe\u001b[28Gmission denied\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m│\u001b[22m \u001b[38;2;153;153;153mReas\u001b[14G: PreToolUse:Bash h\u001b[34Gok \u001b[38Grror: git add -A/--all/. would stage ./asciinema: add the files by name.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted\u001b[13Gas\u001b[16G\u001b[38;2;177;185;249ma9b8305\u001b[39m;\u001b[25Gthe\u001b[29Ggate\u001b[34Gis\u001b[37Grunning.\u001b[46GMeanwhile,\u001b[57Greading\u001b[65G(not\u001b[70Gbuilding)\u001b[80Ghow\u001b[84GManifest\u001b[93Gpins\u001b[98Gthe\u001b[102GSDK.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Ggate\u001b[12Gis\u001b[15Grunning.\u001b[24GMoving\u001b[31GManifest's\u001b[42Gpin\u001b[46Gmeans\u001b[52Gfetching\u001b[61Gthe\u001b[65Gcommit\u001b[72Gfrom\u001b[77GGitHub,\u001b[85Gso\u001b[88Git\u001b[91Ghas\u001b[95Gto\u001b[98Gwait\u001b[103Guntil\u001b[109Gthis\u001b[114Gcommit\r\u001b[1B \u001b[3Gis push\u001b[11Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ ./scripts/ci.sh --werror --asan --log build/gate.log\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
