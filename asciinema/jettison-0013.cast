[0.088, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/small-trader-and-docking-plan.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m19\u001b[12G\u001b[22mcurve\u001b[18Gthat rises\u001b[29Gsteeply with the\u001b[46Gacceleration, so a very hard burn is pun\u001b[87Gshingly expensive but\u001b[109Gcan\r\u001b[8C\u001b[1B\u001b[2m0\u001b[12G\u001b[22mwi\u001b[15G a\u001b[18Grace, such as to \u001b[36Golonise\u001b[45G new \u001b[51Gystem, and with the\u001b[71Gmass of eve\u001b[83Gything aboard: hull, fuel\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 121 \u001b[22m tanks and their fuel, occupants and passengers, and cargo. The tanks are apart from the cargo hold\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m122\u001b[12G\u001b[38;2;248;248;242mand grow \u001b[23G the tech\u001b[33Gtre\u001b[37G. A slow run coasts\u001b[57Gbetween\u001b[65Gits\u001b[69Gburns;\u001b[76Ga\u001b[78Gstation\u001b[86Grefuels\u001b[94Ga\u001b[96Gship\u001b[101Gautomatically\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m     -\u001b[38;2;248;248;242m, as it connects its life support, while                                                              \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m122\u001b[12G\u001b[38;2;248;248;242mand grow on the tech tree. A slow run coasts between its burns\u001b[48;2;4;71;0m, the player\u001b[87Gchoosing \u001b[97Ghe share of the c\r\u001b[11C\u001b[1Bruise's time the engines thrust as a percentage, and the acceleration in g up to what the ship can do\u001b[48;2;2;40;0m;\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;248;248;242m a station refuels a ship automatically, as it connects its life support, while                       \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m3\u001b[12G\u001b[22mits ow\u001b[19Ger allows it and it\u001b[40Gfunds last; and a \u001b[59Gtanding po\u001b[70Gicy picks the bur\u001b[88G that make\u001b[100Gthe mo\u001b[107Gt an\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22mhour unless its own\u001b[32Gr fixes one (the user's, \u001b[58Gs W21\u001b[64Gwas\u001b[68Gplanned).\u001b[78GThe\u001b[82Gmechanism\u001b[92Gand\u001b[96Gits\u001b[100Gnumbers\u001b[108Gare\r\u001b[5C\u001b[1B\u001b[2m 125 \u001b[12G\u001b[22mthe\u001b[16G[\u001b[38;2;230;219;116mW21 plan\u001b[39m](stage-4-trading-plan.md#w21-plan).\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Searching for \u001b[1m1\u001b[22m pattern, reading \u001b[1m1\u001b[22m file, running \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ sed -n 25,45p ..\u001b[25Gm\u001b[27Gnifest/source/game/trav\u001b[51Gl/include\u001b[61Gmanifest/travel/Travel.h; rg -n 'Result::|enum class' \r\u001b[5C\u001b[1B../manifest/source/\u001b[26Game/travel/include/manifest/trav\u001b[59Gl/Travel.h | head; git -C ../manifest diff -U0 \r\u001b[5C\u001b[1Bdocs/stage-4-trading-plan.md | grep -n '^+' | awk 'length > 102'\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m*\u001b[39m \u001b[38;2;235;159;127mIde\u001b[38;2;215;119;87mating… \u001b[38;2;153;153;153m(3m 7s\u001b[20G· ↓\u001b[39m \u001b[38;2;153;153;153m17.9k tokens · thought for 2s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
