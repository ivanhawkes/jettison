[0.030, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mFuel burned.\u001b[18G\u001b[22mThe\u001b[22Gleg's\u001b[28Greaction\u001b[37Gmass\u001b[42Gand\u001b[46Gpellets\u001b[54Gare\u001b[58Gworked\u001b[65Gout\u001b[69Gfrom\u001b[74Gthe\u001b[78Gdistance\u001b[87Gto\u001b[90Gthe\u001b[94Gdestination\u001b[106Gstation\u001b[114Gand\r\u001b[4C\u001b[1Beverything aboard: hull, tanks, fue\u001b[41G, cr\u001b[46Gw a\u001b[50Gd\u001b[52Gcargo. The fuel is taken from the tanks\u001b[92Gwhen\u001b[97Gthe\u001b[101Gjourney\u001b[109Gstarts.\u001b[117GA\r\u001b[4C\u001b[1Bleg the tanks can't cover \u001b[32Gs refused with\u001b[47Ga new result, \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m. Ships on\u001b[88Gthe\u001b[92Gold\u001b[96Gtime-compressed\u001b[112Gdrive\r\u001b[4C\u001b[1Bburn nothing.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumbers:\u001b[22m the formula reproduces the plan's figures (3,549 kg and 1.76\u001b[75Gkg of pell\u001b[86Gts\u001b[89Gfor\u001b[93Gthe\u001b[97Gstarter\u001b[105Gto\u001b[108GBrine\u001b[114Gat\u001b[117G1\u001b[119Gg,\r\u001b[4C\u001b[1B100%). At\u001b[15G50%\u001b[19Gthrust and 1 g the starter burns 2,097\u001b[58Gkg.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe fuel constants\u001b[22m went into \u001b[35Ghe\u001b[38Gbalance file.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mConsole:\u001b[14G\u001b[22m\u001b[38;2;177;185;249mtravel\u001b[21G\u001b[39mtakes two optional\u001b[40Goperands, \u001b[38;2;177;185;249m[thrust%] [g]\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommit 2, refuelling (\u001b[38;2;177;185;249m344058a\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mWhat happens on departure.\u001b[32G\u001b[22mA\u001b[34Gship\u001b[39Gleaving\u001b[47Ga\u001b[49Gvenue\u001b[55Gfirst:\r\u001b[2C\u001b[1B  a. buys whole totes of reaction mass at\u001b[45Gthe\u001b[49Gvenue's\u001b[57Glive\u001b[62Gasks,\u001b[68Gstraight\u001b[77Ginto\u001b[82Gits\u001b[86Gtanks;\r\u001b[4C\u001b[1Bb.\u001b[8Gbuys\u001b[13Ga\u001b[15Gtote\u001b[20Gof\u001b[23Gpellets\u001b[31Ginto\u001b[36Gthe\u001b[40Ghold,\u001b[46Gif\u001b[49Gthe\u001b[53Ghold\u001b[58Ghas\u001b[62Gnone,\u001b[68Ghas\u001b[72Groom\u001b[77Gand\u001b[81Gthe\u001b[85Gvenue\u001b[91Gsells\u001b[97Gthem;\r\u001b[1B \u001b[3G  c. fills its magazine from the pellets in the hold.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mBudget:\u001b[22m ev\u001b[16Grything it buys stays\u001b[38Gwithin\u001b[45Gthe company's\u001b[59Gaccount\u001b[67Gafter\u001b[73Gthe\u001b[77Gdocking\u001b[85Gfee\u001b[89Gand\u001b[93Gany\u001b[97Garrears\u001b[105Gthe\u001b[109Gjourney\r\u001b[4C\u001b[1Bstill\u001b[11Ghas\u001b[15Gto\u001b[18Gpay.\r\u001b[2C\u001b[1B- \u001b[1mThe buying\u001b[22m goes through a new Trade function that buys at\u001b[63Gthe\u001b[67Gasks\u001b[72Gand\u001b[76Gleaves\u001b[83Gnothing\u001b[91Gresting\u001b[99Gon\u001b[102Gthe\u001b[106Gbook.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA saved refuel flag\u001b[25G\u001b[22mis\u001b[28Gon\u001b[31Gby\u001b[34Gdefault,\u001b[43Gand\u001b[47Gthe\u001b[51Gowner\u001b[57Gcan\u001b[61Gswitch\u001b[68Git\u001b[71Goff\u001b[75Gwith\u001b[80Ga\u001b[82Gnew\u001b[86G\u001b[38;2;177;185;249mSetRefuel\u001b[96G\u001b[39mcommand.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges from the plan:\r\u001b[1B\u001b[22m \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
