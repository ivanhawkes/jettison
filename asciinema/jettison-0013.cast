[0.021, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[2m9\u001b[13G\u001b[22m\u001b[38;2;117;113;94mC\u001b[15Gast grows wheat a\u001b[33Gd chi\u001b[39Gkpeas and makes th\u001b[59Ggla\u001b[63Gsware, soap, welln\u001b[82Gs\u001b[85Ggoods a\u001b[93Gd medical\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m10\u001b[13G\u001b[22m\u001b[38;2;117;113;94msupplies; its Delt\u001b[32G barley and peas; its Saltwork\u001b[63G s\u001b[66Glt and lime. Ev\u001b[82Gry\u001b[85Gstation mak\u001b[97Gs reaction mass\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 11 -\u001b[38;2;248;248;242mfor the ships, 10,000 kg a day, and Ore Deeps and Brine Saltworks refine fusion pellets, 2 kg a day    \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m2\u001b[11G\u001b[38;2;248;248;242m(D-108). A station makes\u001b[36Gwhat its region     \u001b[57G   \u001b[61G     \u001b[67G         \u001b[77G      \u001b[84G      \u001b[91G        \u001b[100G \u001b[102G  \u001b[105G \u001b[107G   \r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m3\u001b[11G\u001b[38;2;248;248;242m# makes and its essentials' demand is its\u001b[53Gregion's\u001b[62Gneed,\u001b[68Gwhich\u001b[74Gset\u001b[78Gits\u001b[82Gprices;\u001b[90Ga\u001b[92Grow's\u001b[98Gregion\u001b[105Gis\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 11 +\u001b[38;2;117;113;94m\u001b[48;2;4;71;0m# \u001b[48;2;2;40;0mfor the ships, 10,000 kg a day, and Ore Deeps and Brine Saltworks refine fusion pellets, 2 kg a day\u001b[38;2;248;248;242m  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;117;113;94m# (D-108). A station makes\u001b[38Gwhat its region makes and its essential\u001b[78G' demand i\u001b[89G its region's need,\u001b[109Gwhich\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m  \u001b[11G\u001b[38;2;117;113;94m set its prices; a row's region\u001b[44Gs\u001b[38;2;248;248;242m                                                                     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 13 \u001b[22m \u001b[38;2;117;113;94m# the employer that makes it, and the households that want it when no need names it. Market rates\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m4\u001b[13G\u001b[22m\u001b[38;2;117;113;94mar\u001b[17Gper simulation day,\u001b[38Gn the i\u001b[46Gem's \u001b[52Gnit (\u001b[58Gocs/model.md);\u001b[73Gstock is in totes,\u001b[92Geight to \u001b[102Ghe IBC\r\u001b[7C\u001b[1B\u001b[39m\u001b[2m5\u001b[13G\u001b[22m\u001b[38;2;117;113;94m(D-087), about te\u001b[35Gs\u001b[37Gof\u001b[40Ga row's rate, so a broker's ladder ta\u001b[78Ges a star\u001b[89Gr's run (W19's\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;107;128m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/company/tests/CompanyTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[38;2;255;107;128mError: String to replace not found in file.\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;255;107;128mSt\u001b[9Ging:      \u001b[20G  \u001b[23G       \u001b[31G {4000.0,\u001b[41G12.5}, {4000.0, 12.5}}}});\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48GCMAKE_BUILD_…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && CMAKE_BUILD_PARALLEL_LEVEL=24 cmake --build --preset clang-debug > \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mbuild/w21s2-build.l\u001b[26Gg 2>&1; echo exit=$?; grep -E 'error:|FAILED' build/w21s2-build.log | head -10\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
