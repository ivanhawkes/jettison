[0.660, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projec\u001b[19Gs/manifest/docs/stage-4-trading-plan.md)\u001b[60G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[14G\u001b[22mline, remov\u001b[26Gd \u001b[1m1\u001b[22m line\u001b[35G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1458 \u001b[15G\u001b[22mand\u001b[19G9.9\u001b[23Gkg\u001b[26Gof\u001b[29Gpellets,\u001b[38G13,178\u001b[45Gcredits,\u001b[54Gfor\u001b[58G3.29\u001b[63Gdays.\u001b[69GWith\u001b[74Gits\u001b[78Ghold\u001b[83Gfull\u001b[88Gof\u001b[91Gcopper,\u001b[99G177\u001b[103Gt,\u001b[106Gits\u001b[110G4\u001b[112Gt\r\u001b[1B \u001b[3G   \u001b[2m 1459 \u001b[22m   of \u001b[19Ganks reach 677 km/s, a 5.7% share \u001b[55Gd 13.9\u001b[62Gdays;\u001b[68Gwith\u001b[73Ga\u001b[75Gtier\u001b[80Gof\u001b[83Gbunkers,\u001b[92G83%.\r\u001b[1B     \u001b[2m 1460 \u001b[22m - **The\u001b[21Gjourn\u001b[27Gy.** `Manifest.Travel.Travel`\u001b[57Gtakes\u001b[63G`accelerationMilliG`\u001b[84Gand\u001b[88G`thrustBps`\u001b[100G(version\u001b[109G2;\u001b[112Ga\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 1461 -\u001b[38;2;248;248;242m  version-1 command \u001b[48;2;92;2;0mflies\u001b[48;2;61;1;0m \u001b[48;2;92;2;0m1\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mg\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mat\u001b[48;2;61;1;0m \u001b[48;2;92;2;0m100%\u001b[48;2;61;1;0m), refused `InvalidQuantity` for either past the ship's bounds. \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m      -\u001b[38;2;248;248;242mIt                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1461 +\u001b[38;2;248;248;242m  version-1 command \u001b[48;2;4;71;0mis\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mrefus