[0.691, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m7\u001b[11G\u001b[38;2;248;248;242m                                                                                                       \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;117;113;94mT\u001b[17G fuel,\u001b[24Gin kilograms,\u001b[38Ga cruise of that many metres on th\u001b[73G profile\u001b[82Gburns for that many ton\u001b[106Ges\u001b[38;2;248;248;242m    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m7\u001b[14G\u001b[38;2;117;113;94maboard\u001b[21G(D-108):\u001b[30Geach phase's\u001b[43Gspeed\u001b[49Gchange, its acceleration times its seconds at each end\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;117;113;94m// (Space::CruiseThrust), burns reaction mass by the rocket equation to first order and pellets by the\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;117;113;94m// tuning's rate times the acceleration's factor, 1 up to 1 g and its g to the curve's power above;\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;117;113;94m// each rounded up to the gram.\u001b[38;2;248;248;242m        \u001b[51G            \u001b[64G      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m8\u001b[11G\u001b[38;2;248;248;242mWorld::Fuel\u001b[23G\u001b[38;2;166;226;46mBurned\u001b[38;2;253;151;31m(\u001b[38;2;248;248;242m                                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 81 +\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m Content::FuelTuning &tuning, \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m Jettison::Space::CruiseProfile &profile, \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m tonnes,   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 82 +\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m metres);                                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 83 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 84 +\u001b[38;2;117;113;94m// Everything the ship carries as a leg starts, in tonnes: its hull's mass, its tanks' and the fuel in\u001b[38;2;248;248;242m \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 85 +\u001b[38;2;117;113;94m// them, its occupants and its cargo, opened totes included, each unit at its item's density and pack\u001b[38;2;248;248;242m  \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 86 +\u001b[38;2;117;113;94m// factor over its units to the cubic metre.\u001b[38;2;248;248;242m                                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 87 +\u001b[38;2;166;226;46mdouble\u001b[38;2;248;248;242m \u001b[38;2;166;226;46mTonnesAboard\u001b[38;2;253;151;31m(\u001b[38;2;248;248;242m                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 88 +\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m entt::registry &registry, \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m World::Identities &identities,                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 89 +\u001b[38;2;248;248;242m    \u001b[38;2;166;226;46mconst\u001b[38;2;248;248;242m Content::ContentSet &content, entt::entity ship);                                            \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m90 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m91 \u001b[22m \u001b[38;2;117;113;94m// The system, by the name the step's table gives it.\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m92 \u001b[22m \u001b[13G\u001b[38;2;249;