[0.205, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mPolicy shares:\u001b[22m 10\u001b[23G,\u001b[25G50,\u001b[29G25\u001b[32Gand\u001b[36G10%.\u001b[41G10%\u001b[45Greplaces\u001b[54G12.5%\u001b[60Gbecause\u001b[68Git\u001b[71Gis\u001b[74Gthe\u001b[78Gonly\u001b[83Gshare\u001b[89Gwhose\u001b[95Gfuel\u001b[100Gfits\u001b[105Gthe\u001b[109Gstarter's\r\u001b[2C\u001b[1B  0.8 t tanks with a full hold of copper\u001b[44G(782\u001b[49Gkg).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManned boost:\u001b[19G\u001b[22ma\u001b[21Gmanned\u001b[28Gship\u001b[33Gkeeps\u001b[39Gits\u001b[43G2\u001b[45Gg\u001b[47Gboost\u001b[53G(at\u001b[57Gmost\u001b[62G4\u001b[64Gh)\u001b[67Gonly\u001b[72Gwhen\u001b[77Gset\u001b[81Gto\u001b[84G1\u001b[86Gg,\u001b[89Gand\u001b[93Gflies\u001b[99Gwithout\u001b[107Git\u001b[110Gbelow\u001b[116Gthat.\r\u001b[2C\u001b[1B- \u001b[1mRefu\u001b[10Gal:\u001b[22m a value outside the ship's range\u001b[47Gis\u001b[50Grefused\u001b[58Gwith\u001b[63GManifest's\u001b[74Gexisting\u001b[83G\u001b[38;2;177;185;249mInvalidQuantity\u001b[99G\u001b[39mrather\u001b[106Gthan\u001b[111Ga\u001b[113Gnew\r\u001b[2C\u001b[1B \u001b[5Gresult.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't checked\u001b[21Gthe slider design\u001b[39Gagainst\u001b[47GL15's\u001b[53Grow\u001b[57Gin delivery-order, which doesn't mention the c\u001b[104Gn\u001b[106Grols yet.\u001b[116GMy\u001b[K\r\u001b[2C\u001b[1Bmodel advice\u001b[16Gfor the impl\u001b[29Gmentation is u\u001b[44Gchanged: Opus\u001b[58Gh\u001b[60Gg\u001b[62G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 3m 19s · done 11:49 am\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mcommit the docs in both repos\u001b[39m                                                                                         \r\u001b[2B\u001b[49m\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning git -C ../mani