[0.677, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[2B\u001b[1mChanges from t\u001b[19G plan:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mAn old version-1 travel command is refused.\u001b[49G\u001b[22mThe plan said it\u001b[66Gwould fly at 1 g and 100%,\u001b[93Gbut the\u001b[101Grequest system\u001b[K\r\u001b[4C\u001b[1Bregisters only one\u001b[24Gversion per command.\r\u001b[8C\u001b[1B\u001b[1mTUI h\u001b[15Gs no stepped key controls for travel.\u001b[53G\u001b[22mIt has no\u001b[63Gtravel panel\u001b[76Gand \u001b[81Gravels by \u001b[92Ghe console line,\u001b[110Go the\u001b[K\r\u001b[4C\u001b[1Bline's\u001b[12Gtwo operands are its control.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe console has no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[47G\u001b[22mso\u001b[50Grefuelling\u001b[61Gis\u001b[64Galways\u001b[71Gon\u001b[74Gthere.\r\u001b[4C\u001b[1B\u001b[1mA \u001b[9Gfused journey can still spend money.\u001b[22m Fuel bought before an \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m r\u001b[87Gfusal stays boug\u001b[104Gt, so the\r\u001b[4C\u001b[1B\"refused, writing\u001b[23Gnothing\" rule\u001b[37Ghas\u001b[41Gthat\u001b[46Gone\u001b[50Gexception,\u001b[61Gwhich\u001b[67GI\u001b[69Gdocumented.\r\u001b[6C\u001b[1B\u001b[1mf\u001b[9Gelling is two commits.\u001b[22m It needed an immediate buy\u001b[59Gth\u001b[62Gt Tra\u001b[68Ge\u001b[70Gdidn't have, so\u001b[86GI split\u001b[94Git from the burn.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe two-ship\u001b[19Grading test's pin:\u001b[38G\u001b[22mmoved\u001b[44Gonly\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gt\u001b[9Gold hash comes back exactly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplay\u001b[10Gr is provisioned, b\u001b[30Gfore the\u001b[39Gt\u001b[41Gst\u001b[44Gswitches bo\u001b[57G ships to the compre\u001b[78Gsed\u001b[82Gd\u001b[84Give, so\u001b[92Gthat journey\u001b[105Gburns 3,307 kg\u001b[K\r\u001b[4C\u001b[1Bon the real profile.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThree pins in commit 2:\u001b[22m moved\u001b[35Gonly\u001b[40Gbecause\u001b[48Gthe refuel flag is\u001b[67Gregistered as \u001b[82G s\u001b[85Gved component.\u001b[100GW\u001b[102Gthout\u001b[108Gthat\r\u001b[4C\u001b[1Bregistration,\u001b[19Gall\u001b[23Gthree\u001b[29Ghold.\r\u001b[2C\u001b[1B- \u001b[1mResults:\u001b[22m in\u001b[17Gboth commits\u001b[30Gal\u001b[33G 51\u001b[37GManifest\u001b[46Gs\u001b[76Gan \u001b[80Gn the changed files and the format check\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
