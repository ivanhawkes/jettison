\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA\u001b[7G old version-1 travel command is refused.\u001b[49G\u001b[22mThe\u001b[53Gplan\u001b[58Gsaid\u001b[63Git\u001b[66Gwould\u001b[72Gfly\u001b[76Gat\u001b[79G1\u001b[81Gg\u001b[83Gand\u001b[87G100%,\u001b[93Gbut\u001b[97Gthe\u001b[101Grequest\u001b[109Gsystem\r\u001b[2C\u001b[1B \u001b[5Gregisters only one version per command.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TUI has no stepped key controls for travel.\u001b[53G\u001b[22mIt\u001b[56Ghas\u001b[60Gno\u001b[63Gtravel\u001b[70Gpanel\u001b[76Gand\u001b[80Gtravels\u001b[88Gby\u001b[91Gthe\u001b[95Gconsole\u001b[103Gline,\u001b[109Gso\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5Gline's two operands are its control.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe console has no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[47G\u001b[22mso\u001b[50Grefuelling\u001b[61Gis\u001b[64Galways\u001b[71Gon\u001b[74Gthere.\r\u001b[4C\u001b[1B\u001b[1mA refused journey can still spend money.\u001b[22m F\u001b[75G\u001b[38;2;177;185;249mcientFuel\u001b[85G\u001b[39mrefusal\u001b[93Gstays\u001b[99Gbought,\u001b[107Gso\u001b[110Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
