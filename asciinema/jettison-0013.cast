[1.802, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mThe design\u001b[22m, committed as \u001b[38;2;177;185;249m714e5cd\u001b[39m (decision D-108 and the W21 plan):\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mSmall ships\u001b[22m (skiff up to a Rocinante-class corvette) fly a clean fusion torch at 10% of light speed, burning two\u001b[K\r\u001b[2C\u001b[1B  goods:\u001b[K\r\u001b[2C\u001b[1B  - \u001b[1mReaction mass\u001b[22m (water ice): cheap, made at every station, about 3.5 t for the starter's full-thrust run from Ore to\r\u001b[2C\u001b[1B    Brine.\u001b[K\r\u001b[2C\u001b[1B  - \u001b[1mFusion pellets\u001b[22m (deuterium and helium-3): 1,200 credits a kg, refined at one station per planet. That makes them a\u001b[K\r\u001b[2C\u001b[1B    monopoly good and a cargo worth carrying.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mHard burns are a trade-off.\u001b[22m Pellet use rises steeply above 1 g. The best thrust share comes out of the ratio of\u001b[K\r\u001b[2C\u001b[1B  full-thrust fuel cost to the run's gross: about 45% for cheap cargo, 85% for dear cargo, and 100% only if fuel were\u001b[K\r\u001b[2C\u001b[1B  free.\u001b[K\r\u001b[2C\u001b[1B  - On a run grossing 4,590 credits, the starter earns 14 credits an hour at 100% thrust, 22 at 50% and 20 at 25%.\u001b[K\r\u001b[2C\u001b[1B  - A 2 g run costs about 13,000 credits, and the starter can only fly it with Fuel Bunkers.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mBigger ships fly dirtier drives,\u001b[22m designed now and booked as W22 for when the first larger hull is flown:\u001b[K\r\u001b[2C\u001b[1B  - Hauler fusion: 0.3 g, must stay 1,000 km from stations before lighting its drive.\u001b[K\r\u001b[2C\u001b[1B  - Pulse drive: 0.5 g, must stay 100,000 km from stations and inhabited planets; its fuel is made only under a\u001b[K\r\u001b[2C\u001b[1B    government's licence.\u001b[K\r\u001b[2C\u001b[1B  - Ships cross those radii on manoeuvring thrusters, or pay a station's tug.\u001b[K\r\u001b[2C\u001b[1B  - A pulse ship can override the limit in an emergency, at the price of a fine and harm to the regions it passes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.014, "o", "\u001b[?25l\u001b[H\r\u001b[46C\u001b[20B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.629, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe design\u001b[22m, committed as \u001b[38;2;177;185;249m714e5cd\u001b[39m (decision D-108 and the W21\u001b[64Gp\u001b[66Gan):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSmall ships\u001b[17G\u001b[22m(skiff\u001b[24Gup\u001b[27Gto\u001b[30Ga\u001b[32GRocinante-class\u001b[48Gcorvette)\u001b[58Gfly\u001b[62Ga\u001b[64Gclean\u001b[70Gfusion\u001b[77Gtorch\u001b[83Gat\u001b[86G10%\u001b[90Gof\u001b[93Glight\u001b[99Gspeed,\u001b[106Gburning\u001b[114Gtwo\r\u001b[4C\u001b[1Bgoods:\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mReaction mass\u001b[21G\u001b[22m(water\u001b[28Gice):\u001b[34Gcheap,\u001b[41Gmade\u001b[46Gat\u001b[49Gevery\u001b[55Gstation,\u001b[64Gabout\u001b[70G3.5\u001b[74Gt\u001b[76Gfor\u001b[80Gthe\u001b[84Gstarter's\u001b[94Gfull-thrust\u001b[106Grun\u001b[110Gfrom\u001b[115GOre\u001b[119Gto\r\u001b[4C\u001b[1B \u001b[7GBrine.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mFusion pellets\u001b[22m (\u001b[24Geuterium\u001b[33Gand \u001b[38Gelium-3): 1,200\u001b[54Gcredits\u001b[62Ga\u001b[64Gkg,\u001b[68Grefined\u001b[76Gat\u001b[79Gone\u001b[83Gstation\u001b[91Gper\u001b[95Gplanet.\u001b[103GThat\u001b[108Gmakes\u001b[114Gthem\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5G  monopoly good and a cargo\u001b[33Gworth carrying.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHard burns are a trade-off.\u001b[22m Pellet\u001b[40Guse rises s\u001b[52Geeply above 1 g. The best\u001b[78Gth\u001b[81Gust share comes out of the\u001b[108Gratio of\u001b[K\r\u001b[5C\u001b[1Bull-thrust\u001b[17Gfuel\u001b[22Gcost\u001b[27Gto\u001b[30Gthe\u001b[34Grun's\u001b[40Ggross:\u001b[47Gabout\u001b[53G45%\u001b[57Gfor\u001b[61Gcheap\u001b[67Gcargo,\u001b[74G85%\u001b[78Gfor\u001b[82Gdear\u001b[87Gcargo,\u001b[94Gand\u001b[98G100%\u001b[103Gonly\u001b[108Gif\u001b[111Gfuel\u001b[116Gwere\r\u001b[4C\u001b[1Bfree.\u001b[K\r\u001b[6C\u001b[1BOn a run gr\u001b[20Gsing 4,590 credits, the starter earns 14\u001b[62Gredits an hour\u001b[77Gat 100% thr\u001b[89Gst, 22\u001b[96Gat\u001b[99G50%\u001b[103Gand\u001b[107G20\u001b[110Gat\u001b[113G25%.\r\u001b[2C\u001b[1B \u001b[5G- A 2 g run costs about 13,000 credits, and the starter c\u001b[63Gn\u001b[65Gonly fly it with\u001b[82GFuel Bunkers.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBigger ships fly dirtier drives,\u001b[22m designed now and booked\u001b[62Gas W22\u001b[69Gfor when\u001b[78Gthe\u001b[82Gfirst larger\u001b[95Ghull\u001b[100Gis\u001b[103Gflown:\r\u001b[6C\u001b[1BHaul\u001b[12Gr fusion: 0.3 g, must stay 1\u001b[62Gbefore lighting its drive.\u001b[89G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GPulse drive:\u001b[20G0.5 g, must\u001b[32Gstay\u001b[37G100,000\u001b[45Gkm\u001b[48Gfrom\u001b[53Gstations\u001b[62Gand\u001b[66Ginhabited\u001b[76Gplanets;\u001b[85Gits\u001b[89Gfuel\u001b[94Gis\u001b[97Gmade\u001b[102Gonly\u001b[107Gunder\u001b[113Ga\r\u001b[4C\u001b[1B \u001b[7Ggovernment's lic\u001b[24Gnce.\u001b[K\r\u001b[6C\u001b[1BShips cross those radi\u001b[30G on manoeuvring\u001b[46Gthrusters, or\u001b[60Gpay a station's\u001b[76Gtug.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GA\u001b[9Gpulse\u001b[15Gship\u001b[20Gcan\u001b[24Goverride\u001b[33Gthe\u001b[37Glimit\u001b[43Gin\u001b[46Gan\u001b[49Gemergency,\u001b[60Gat\u001b[63Gthe\u001b[67Gprice\u001b[73Gof\u001b[76Ga\u001b[78Gfine\u001b[83Gand\u001b[87Gharm\u001b[92Gto\u001b[95Gthe\u001b[99Gregions\u001b[107Git\u001b[110Gpasses.\r\u001b[2C\u001b[1B        \u001b[12G         \u001b[22G  \u001b[25G        \u001b[34G   \u001b[38G   \u001b[42G    \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.115, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bworked\u001b[10Goutside\u001b[18Gthe\u001b[22Gsandbox,\u001b[31Gbecause\u001b[39Gof\u001b[42GSSH's\u001b[48Gconfig\u001b[55Gcheck.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe design\u001b[22m, committed as \u001b[38;2;177;185;249m714e5cd\u001b[39m (decision D-108 and the W21\u001b[64Gp\u001b[66Gan):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSmall ships\u001b[17G\u001b[22m(skiff\u001b[24Gup\u001b[27Gto\u001b[30Ga\u001b[32GRocinante-class\u001b[48Gcorvette)\u001b[58Gfly\u001b[62Ga\u001b[64Gclean\u001b[70Gfusion\u001b[77Gtorch\u001b[83Gat\u001b[86G10%\u001b[90Gof\u001b[93Glight\u001b[99Gspeed,\u001b[106Gburning\u001b[114Gtwo\r\u001b[4C\u001b[1Bgoods:\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mReaction mass\u001b[21G\u001b[22m(water\u001b[28Gice):\u001b[34Gcheap,\u001b[41Gmade\u001b[46Gat\u001b[49Gevery\u001b[55Gstation,\u001b[64Gabout\u001b[70G3.5\u001b[74Gt\u001b[76Gfor\u001b[80Gthe\u001b[84Gstarter's\u001b[94Gfull-thrust\u001b[106Grun\u001b[110Gfrom\u001b[115GOre\u001b[119Gto\r\u001b[4C\u001b[1B \u001b[7GBrine.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mFusion pellets\u001b[22m (\u001b[24Geuterium\u001b[33Gand \u001b[38Gelium-3): 1,200\u001b[54Gcredits\u001b[62Ga\u001b[64Gkg,\u001b[68Grefined\u001b[76Gat\u001b[79Gone\u001b[83Gstation\u001b[91Gper\u001b[95Gplanet.\u001b[103GThat\u001b[108Gmakes\u001b[114Gthem\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5G  monopoly good and a cargo\u001b[33Gworth carrying.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHard burns are a trade-off.\u001b[22m Pellet\u001b[40Guse rises s\u001b[52Geeply above 1 g. The best\u001b[78Gth\u001b[81Gust share comes out of the\u001b[108Gratio of\u001b[K\r\u001b[5C\u001b[1Bull-thrust\u001b[17Gfuel\u001b[22Gcost\u001b[27Gto\u001b[30Gthe\u001b[34Grun's\u001b[40Ggross:\u001b[47Gabout\u001b[53G45%\u001b[57Gfor\u001b[61Gcheap\u001b[67Gcargo,\u001b[74G85%\u001b[78Gfor\u001b[82Gdear\u001b[87Gcargo,\u001b[94Gand\u001b[98G100%\u001b[1