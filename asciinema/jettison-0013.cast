[0.636, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mClass:\u001b[10GClean torch\r\u001b[2C\u001b[1BTypical hulls:\u001b[22m skiffs,\u001b[26Gcouriers,\u001b[36GRocinante-class\u001b[52Gcorvettes\u001b[62G(a\u001b[65Gfew\u001b[69Ghundred\u001b[77Gtonnes)\r\u001b[2C\u001b[1B\u001b[1mDrive (p\u001b[12Gysics bent a little):\u001b[22m Aneutronic D–He3 fusion with \u001b[65Gmagnetic nozzle, exhaust\u001b[90Gabout\u001b[96G10%\u001b[100Gof\u001b[103Glight\u001b[109Gspeed\r\u001b[2C\u001b[1B\u001b[1mFuel:\u001b[22m Hydrogen or water reaction mass, plus \u001b[49G-3/deuterium pellets (dear and scarce)\u001b[K\r\u001b[2C\u001b[1B\u001b[1mS\u001b[5Gstained g:\u001b[22m 1\u001b[18Gg mann\u001b[25Gd\u001b[27G(crew-limited), up to 12 g \u001b[55Gnmanned\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCatch:\u001b[22m Pellets\u001b[18Gco\u001b[21Ge from a few gas-giant or regolith refineries:\u001b[68Ga\u001b[70Gcartel\u001b[77Ggood\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[44G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mClass:\u001b[22m \u001b[1mHauler fusion\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTypical h\u001b[14Gls:\u001b[22m medium\u001b[25Gfreighters\r\u001b[2C\u001b[1B\u001b[1mDrive (p\u001b[12Gysics bent a little):\u001b[22m D–D\u001b[38Gor\u001b[41GD–T\u001b[45Gfusion,\u001b[53Gneutron-heavy,\u001b[68Gabout\u001b[74G3%\u001b[77Gof\u001b[80Glight\u001b[86Gspeed\r\u001b[2C\u001b[1B\u001b[1mFuel:\u001b[22m Reaction mass plus deuterium\u001b[38G(cheap, from any water)\u001b[K\r\u001b[2C\u001b[1B\u001b[1mS\u001b[5Gstained g:\u001b[22m about 0.3 g\u001b[28G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCatch:\u001b[22m Neutron shieldin\u001b[28Gcosts\u001b[34Gmass;\u001b[40Gthe\u001b[44Gdrive\u001b[50Gmust\u001b[55Gstay\u001b[60Gcold\u001b[65Gwithin\u001b[72Ga\u001b[74Gstation's\u001b[84Gexclusion\u001b[94Gradius\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[44G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mClass:\u001b[22m \u001b[1mPulse drive\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTypical hulls:\u001b[22m bulk\u001b[23Gcarriers,\u001b[33Gdestroyer-class\u001b[49Gand\u001b[53Gup\r\u001b[2C\u001b[1B\u001b[1mDrive (p\u001b[12Gysics bent a little):\u001b[22m Nuclear pu\u001b[45Gse units (Orion-style),\u001b[69Ghigh\u001b[74Gthrust,\u001b[82Glow\u001b[86Gefficiency\r\u001b[2C\u001b[1B\u001b[1mFuel:\u001b[22m Fissile pulse units, made \u001b[36Gnd\u001b[39Gr a polity's licence\u001b[K\r\u001b[2C\u001b[1B\u001b[1mS\u001b[5Gstained g:\u001b[22m 1 g in\u001b[23Gbursts\u001b[30G    \u001b[35G     \u001b[41G \u001b[43G    \u001b[27;1H\u001b[24;3H\u001b[?25h"]
