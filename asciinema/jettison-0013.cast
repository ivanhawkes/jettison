[0.051, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands, did not run \u001b[1m1\u001b[22m other call \r\u001b[1B  ⎿  $ git add -A docs source/engine/space source/samples/space/tests/ModsTests.cpp\r\u001b[1B  ⎿  1 action\u001b[15Gn\u001b[17Gt run ·\u001b[25Gpermission denied\u001b[39m\u001b[K\r\u001b[1B     \u001b[2m│\u001b[22m \u001b[38;2;153;153;153mReason:\u001b[16GPreT\u001b[21GolU\u001b[25Ge:Bash hook error:\u001b[44Ggit add -A/--all/. would \u001b[70Gtage ./asciinema: add the files by name.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted as \u001b[38;2;177;185;249ma9b8305\u001b[39m; the gate is running. Meanwhile, reading (not building) how Manifest pins the SDK.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate is running. Moving Manifest's pin means\u001b[52Gfetching\u001b[61Gthe\u001b[65Gcommit\u001b[72Gfrom\u001b[77GGitHub,\u001b[85Gso\u001b[88Git\u001b[91Ghas\u001b[95Gto\u001b[98Gwait\u001b[103Guntil\u001b[109Gthis\u001b[114Gcommit\r\u001b[2C\u001b[1Bis\u001b[6Gpushed.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe gate passed in 411\u001b[26Gs.\u001b[29GBefore\u001b[36Gasking\u001b[43Gabout\u001b[49Gthe\u001b[53Gpush,\u001b[59GI'm\u001b[63Gchecking\u001b[72GManifest's\u001b[83Gsuites\u001b[90Gand\u001b[94Gpinned\u001b[101Ghashes\u001b[108Gagainst\u001b[116Gthis\r\u001b[2C\u001b[1Bengine\u001b[10Gcommit\u001b[17Gthrough\u001b[25Ga\u001b[27Glocal\u001b[33GSDK\u001b[37Goverride,\u001b[47Gin\u001b[50Ga\u001b[52Gseparate\u001b[61Gbuild\u001b[67Gdirectory.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWorking…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[