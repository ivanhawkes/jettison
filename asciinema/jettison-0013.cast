[0.824, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mModerat\u001b[11G to High\u001b[20G(likely for interplanetary cargo by the 2100s)\u001b[67G  \u001b[70GB\u001b[72Gtter suited to steady 0.05g–0.2g bur\u001b[109Gs\u001b[111Grather \r\u001b[2C\u001b[1Bthan continuous 1–2g \"gr\u001b[28Gv-drive\" cruising.\u001b[39m                                                                        \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mAnt\u001b[7Gmatter-Catalyzed\u001b[24G/ Beam-Core \u001b[37G  1–2g continuous (closest real-world equivalent to The Expanse's Epstein Drive)   \r\u001b[2C\u001b[1BVery\u001b[8GL\u001b[10Gw within 150 years    Producing and storing tons of antimatter, plus radiating terawatts of heat, remains far\r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255mbeyond 22nd-century engineering.\u001b[39m                                                                                      \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;255;255;255mThe Realistic 150-Year Outcome\u001b[39m                                                                                        \r\u001b[1B                                                                                                                        \r\u001b[1B  \u001b[38;2;255;255;255mBy the late 2100s, a corsair-sized cargo ship won't cruise at 1g for weeks at a time. Instead, it would likely cruise\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mefficiently at 0.05g to 0.2g using a pulsed fusion drive (still cutting a Mars trip down to a couple of weeks), \u001b[39m      \r\u001b[1B  \u001b[38;2;255;255;255mwhile keeping an auxiliary chemical or nuclear thermal thruster in reserve for short 1–2g combat or docking burns.\u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mWould you like to calculate travel times to Mars or Jupiter under a 0.1g vs. 1g burn, or explore how ship radiator \u001b[39m   \r\u001b[1B  \u001b[38;2;255;255;255mdesigns and magnetic nozzles deal with terawatt-level heat?\u001b[39m                                                           \r\u001b[1B  \u001b[38;2;255;255;255mShow Code\u001b[39m                                                                                                             \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSlice 2 is written but not built:\u001b[37GManifest's\u001b[48Ggate\u001b[53Gis\u001b[56Gstill\u001b[62Grunning\u001b[70Gin\u001b[73Gthe\u001b[77Gother\u001b[83Gcheckout,\u001b[93Gand\u001b[97GI'm\u001b[101Gholding\u001b[109Gslice\u001b[115G2's\r\u001b[2C\u001b[1Bcommit\u001b[10Guntil\u001b[16Gyou've\u001b[23Gsettled\u001b[31Gthe\u001b[35Gfuel\u001b[40Gdesign\u001b[47Gbelow.\u001b[54GThat\u001b[59Gdesign\u001b[66Gdecides\u001b[74Gwhat\u001b[79Gthe\u001b[83Gfuel\u001b[88Ggoods\u001b[94Gare\u001b[98Gand\u001b[102Gwhat\u001b[107Ga\u001b[109Gship's\u001b[116Gfuel\r\u001b[2C\u001b[1Brecord\u001b[10Gholds, and both\u001b[26Gend\u001b[30Gup\u001b[33Gin\u001b[36Gevery\u001b[42Gsave.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFuel and engine design, circa 2176\u001b[22m       \u001b[45G  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[3.831, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;255;255;255mthan continuous 1–2g \"grav-dr\u001b[33Gve\" cruising.\u001b[39m                                                                        \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mAntimatter-Catalyzed\u001b[24G/ Beam-Cor\u001b[35G \u001b[37G  1–2g continuous (closest real-world equivalent to The Expanse's Epstein Drive)   \r\u001b[2C\u001b[1BVery Low within 150 years    P\u001b[34Goducing and s\u001b[48Goring tons of antimatte\u001b[72G, plus r\u001b[81Gdia\u001b[85Ging\u001b[89Gterawatts of heat, remains far\u001b[39m \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mb\u001b[5Gyond 22nd-ce\u001b[18Gtury\u001b[23Gengineering.\u001b[39m                                                                                    \r\u001b[2C\u001b[1B                                \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mThe Realistic 150-Year Outcome\r\u001b[2C\u001b[1B\u001b[39m                              \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mBy the late 2100s, a corsair-sized cargo ship won't cruise at 1g for weeks at a time. Instead, it would likely cruise\r\u001b[2C\u001b[1Befficiently\u001b[15Gat \u001b[19G.05g\u001b[24Gt\u001b[26G 0.2g using\u001b[38Ga pulsed fusion drive (still cutting a M\u001b[79Grs tr\u001b[85Gp dow\u001b[91G \u001b[93Go a couple of\u001b[107Gweeks), \u001b[39m     \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mwhile keeping an auxiliary chem\u001b[35Gcal or nuclear thermal thruster\u001b[67Gin reserve for\u001b[82Gshort 1–2g combat or d\u001b[105Gcking burns.\r\u001b[2C\u001b[1BWou\u001b[7Gd\u001b[9Gyou like to calculate travel times to Mars o\u001b[54G Jupiter under a 0.1g vs. 1g bu\u001b[86Gn, or explore\u001b[100Ghow ship radiator \r\u001b[2C\u001b[1Bdesigns and magnetic nozzl\u001b[30Gs deal with terawatt-level heat?\u001b[39m                                                        \r\u001b[2C\u001b[1B\u001b[38;2;255;255;255mShow Code\u001b[39m     