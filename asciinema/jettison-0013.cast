[4.199, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe design\u001b[22m,\u001b[15Gcommitted\u001b[25Gas\u001b[28G\u001b[38;2;177;185;249m714e5cd\u001b[36G\u001b[39m(decision\u001b[46GD-108\u001b[52Gand\u001b[56Gthe\u001b[60GW21\u001b[64Gplan):\r\u001b[2C\u001b[1B- \u001b[1mSmall ships\u001b[22m (skiff up to a Rocinante-class corvette) fly a\u001b[64Gc\u001b[66Gean fusion\u001b[77Gtorch\u001b[83Gat\u001b[86G10%\u001b[90Gof\u001b[93Glight\u001b[99Gspeed,\u001b[106Gburning\u001b[114Gtwo\r\u001b[2C\u001b[1B \u001b[5Ggoods:\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mReaction mass\u001b[21G\u001b[22m(water\u001b[28Gice):\u001b[34Gcheap,\u001b[41Gmade\u001b[46Gat\u001b[49Gevery\u001b[55Gstation,\u001b[64Gabout\u001b[70G3.5\u001b[74Gt\u001b[76Gfor\u001b[80Gthe\u001b[84Gstarter's\u001b[94Gfull-thrust\u001b[106Grun\u001b[110Gfrom\u001b[115GOre\u001b[119Gto\r\u001b[4C\u001b[1B \u001b[7GBrine.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mFusion pellets\u001b[22G\u001b[22m(deuterium\u001b[33Gand\u001b[37Ghelium-3):\u001b[48G1,200\u001b[54Gcredits\u001b[62Ga\u001b[64Gkg,\u001b[68Grefined\u001b[76Gat\u001b[79Gone\u001b[83Gstation\u001b[91Gper\u001b[95Gplanet.\u001b[103GThat\u001b[108Gmakes\u001b[114Gthem\u001b[119Ga\r\u001b[4C\u001b[1B \u001b[7Gmonopoly good an\u001b[24G a cargo\u001b[33Gwort\u001b[38G carrying.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHard burns are a trade-off.\u001b[33G\u001b[22mPellet use rises\u001b[50Gsteeply\u001b[58Gabove\u001b[64G1\u001b[66Gg.\u001b[69GThe\u001b[73Gbest\u001b[78Gthrust\u001b[85Gshare\u001b[91Gcomes\u001b[97Gout\u001b[101Gof\u001b[104Gthe\u001b[108Gratio\u001b[114Gof\r\u001b[2C\u001b[1B \u001b[5Gfull-thrust fuel cost to the run's\u001b[40Ggross: abou\u001b[52G 45% for cheap cargo, 85%\u001b[78Gfo\u001b[81G dear cargo, and 100% only\u001b[108Gif fuel were\r\u001b[5C\u001b[1Bree.\u001b[K\r\u001b[4C\u001b[1B- On a\u001b[12Grun\u001b[16Ggrossing\u001b[25G4,590\u001b[31Gcredits,\u001b[40Gthe\u001b[44Gstarter\u001b[52Gearns\u001b[58G14\u001b[61Gcredits\u001b[69Gan\u001b[72Ghour\u001b[77Gat\u001b[80G100%\u001b[85Gthrust,\u001b[93G22\u001b[96Gat\u001b[99G50%\u001b[103Gand\u001b[107G20\u001b[110Gat\u001b[113G25%.\r\u001b[6C\u001b[1BA 2 g run c\u001b[20Gts about 13,000 credits, and the starter\u001b[62Gan only fly it\u001b[77Gwith Fuel B\u001b[89Gnkers.\u001b[96G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBigger ships fly dirtier drives,\u001b[22m designed now and booked \u001b[63Gs\u001b[65GW22 for when the\u001b[82Gfirst larger hull\u001b[100Gis\u001b[103Gflown:\r\u001b[2C\u001b[1B \u001b[5G- Hauler fusion: 0.3 g, must stay 1,000 km from stations\u001b[62Gbefore\u001b[69Glighting\u001b[78Gits\u001b[82Gdrive.\u001b[K\r\u001b[6C\u001b[1BPuls\u001b[12G drive: 0.5 g, must stay 100\u001b[62Gand inhabited planets; its\u001b[89Gfuel\u001b[94Gis\u001b[97Gmade\u001b[102Gonly\u001b[107Gunder\u001b[113Ga\r\u001b[4C\u001b[1B \u001b[7Ggovernment's\u001b[20Glicence.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GShips cross thos\u001b[24G radii\u001b[31Gon\u001b[34Gmanoeuvring\u001b[46Gthrusters,\u001b[57Gor\u001b[60Gpay\u001b[64Ga\u001b[66Gstation's\u001b[76Gtug.\r\u001b[6C\u001b[1BA pulse ship can overr\u001b[30Gde the limit in\u001b[46Gan emergency,\u001b[60Gat the price of\u001b[76Ga fine\u001b[83Gand\u001b[87Gharm\u001b[92Gto\u001b[95Gthe\u001b[99Gregions\u001b[107Git\u001b[110Gpasses.\r\u001b[4C\u001b[1B \u001b[7G \u001b[9G     \u001b[15G    \u001b[20G   \u001b[24G        \u001b[33G   \u001b[37G     \u001b[43G  \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
