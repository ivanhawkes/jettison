2mwith th\u001b[23Gi\u001b[25G effects) and its cargo, \u001b[51Gach tote its units times th\u001b[79G item's d\u001b[89Gnsity over its units per\r\u001b[9C\u001b[1B\u001b[2m4\u001b[15G\u001b[22mcubic\u001b[21Gmet\u001b[25Ge (c\u001b[30Gpper's 0.95 t), opened life\u001b[58Gsupport totes included. The fuel's mass counts a\u001b[107G the\u001b[K\r\u001b[6C\u001b[1B\u001b[2m1425\u001b[13G\u001b[22m \u001b[15Gleg's\u001b[21Gstart,\u001b[28Gnot\u001b[32Gas\u001b[35Git\u001b[38Gburns\u001b[44Gdown,\u001b[50Ga\u001b[52Gfirst-order\u001b[64Grocket\u001b[71Gequation.\u001b[81GThe\u001b[85Gstarter,\u001b[94G23.0\u001b[99Gt\u001b[101Gwith\u001b[106Gtwo\u001b[110Gtote\r\u001b[5C\u001b[1B\u001b[2m      \u001b[22m s\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m6\u001b[15G\u001b[38;2;248;248;242mof copper and its\u001b[33Gtanks full, burns 453 kg to Brine\u001b[67Gat 1\u001b[72Gg and \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfull\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mburn \u001b[48;2;61;1;0m(about \u001b[100G,600 credits),\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m1427\u001b[13G\u001b[38;2;248;248;242m \u001b[15G551\u001b[19Gkg\u001b[22Gwith\u001b[27Gthe\u001b[31G2\u001b[33Gg\u001b[35Gboost\u001b[41Ghours,\u001b[48Gand\u001b[52G\u001b[48;2;92;2;0m113\u001b[56G\u001b[48;2;61;1;0mkg\u001b[59Gat\u001b[62G25%;\u001b[67Gwith\u001b[72Gits\u001b[76Ghold\u001b[81Gfull\u001b[86Gof\u001b[89Gcopper,\u001b[97G173\u001b[101Gt,\u001b[104G3,410\u001b[110Gkg\u001b[113Ga\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m    \u001b[13G\u001b[38;2;248;248;242mt\u001b[15G   \u001b[19G             \u001b[33G   \u001b[37G  \u001b[40G  \u001b[43G      \u001b[50G   \u001b[54G    \u001b[59G   \u001b[63G     \u001b[69G      \u001b[76G  \u001b[79G \u001b[81G     \u001b[87G     \u001b[93G     \u001b[99G    \u001b[104G    \u001b[109G   \u001b[113G \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 1428 -\u001b[38;2;248;248;242m  \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m \u001b[48;2;92;