[0.040, "o", "\u001b[?25l\u001b[H\r\u001b[3C\u001b[1B\u001b[1mlass\u001b[10GHauler fusion\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTypical hulls:\u001b[22m medium freighters\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDrive (physics bent a little):\u001b[34G\u001b[22mD–D\u001b[38Gor\u001b[41GD–T\u001b[45Gfusion,\u001b[53Gneutron-heavy,\u001b[68Gabout\u001b[74G3%\u001b[77Gof\u001b[80Glight\u001b[86Gspeed\r\u001b[2C\u001b[1B\u001b[1mFuel:\u001b[22m Reaction\u001b[19Gass plus deu\u001b[34Gium\u001b[38G(cheap,\u001b[46Gfrom\u001b[51Gany\u001b[55Gwater)\r\u001b[2C\u001b[1B\u001b[1mSustained g:\u001b[22m about 0.3 g\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCatch:\u001b[22m Neu\u001b[14Gr\u001b[18Gshielding\u001b[28Gcos\u001b[32Gs mass; the drive must\u001b[55Gstay cold\u001b[65Gwithin\u001b[72Ga\u001b[74Gstation's\u001b[84Gexclusion\u001b[94Gradius\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[3C\u001b[1B\u001b[1mlass\u001b[10GPulse drive\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTypical hulls:\u001b[22m bulk carriers, destroyer-class\u001b[49Gand\u001b[53Gup\r\u001b[2C\u001b[1B\u001b[1mDrive (phy\u001b[14Gics bent a little):\u001b[34G\u001b[22mNuclear\u001b[42Gpulse\u001b[48Gunits\u001b[54G(Orion-style),\u001b[69Ghigh\u001b[74Gthrust,\u001b[82Glow\u001b[86Gefficiency\r\u001b[2C\u001b[1B\u001b[1mFuel:\u001b[22m Fissile pulse\u001b[23Gunits, made under a polity's licence\r\u001b[2C\u001b[1B\u001b[1mSustained g:\u001b[22m 1 g in bursts\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCatch:\u001b[22m Banned\u001b[17Gnear planets\u001b[30Gan\u001b[33G stations: fallout\u001b[52Gcosts a\u001b[60Gregion's\u001b[69Ghealth\u001b[76Gand\u001b[80Ghappiness,\u001b[91Gpolities\u001b[100Gfine\u001b[105Git,\u001b[109Gand\u001b[113Gan\r\u001b[2C\u001b[1B  unlicensed\u001b[16Gunit is smuggling\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMechanics that fall out of this\r\u001b[2C\u001b[2B\u001b[22m- \u001b[1mT\u001b[7Ge thrust slider\u001b[23Gma\u001b[26Gters more than now.\u001b[46G\u001b[22mAt\u001b[49Gabout\u001b[55G10%\u001b[59Gof\u001b[62Glight\u001b[68Gspeed,\u001b[75GOre\u001b[79Gto\u001b[82GBrine\u001b[88Gat\u001b[91Gfull\u001b[96Gthrust\u001b[103Gneeds\u001b[109Greaction\r\u001b[4C\u001b[1Bmass\u001b[10Gof\u001b[13Gabout\u001b[19G15%\u001b[23Gof\u001b[26Gthe\u001b[30Gship's\u001b[37Gmass,\u001b[43Gand\u001b[47G25%\u001b[51Gthrust\u001b[58Gneeds\u001b[64Gabout\u001b[70G5%.\u001b[74GTank\u001b[79Gsize\u001b[84Gbecomes\u001b[92Ga\u001b[94Greal\u001b[99Glogistics\u001b[109Gchoice,\u001b[117Gand\r\u001b[2C\u001b[1B \u001b[5Ga full hold flown hard needs bigger tanks.\u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
