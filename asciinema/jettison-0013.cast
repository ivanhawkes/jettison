[0.026, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 12 +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mfirst commit\u001b[48;2;2;40;0m, the burn, is \u001b[48;2;4;71;0mdone (2026-11-22), so its second, refuelling, is \u001b[48;2;2;40;0mnext\u001b[48;2;4;71;0m, then the gate\u001b[48;2;2;40;0m. Then W\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242m12, competitive procurement on the                                                                     \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m13\u001b[10G\u001b[22m [\u001b[38;2;230;219;116mtender contract\u001b[39m](stage-4-t\u001b[39Gadi\u001b[43Gg-plan.md#\u001b[54Gender-contract-w11-2026-11-21), its AI issuer\u001b[100Gspending\r\u001b[6C\u001b[1B\u001b[2m14\u001b[11G\u001b[22m`Trade::Budget`\u001b[27Gand\u001b[31Gcalling\u001b[39G`Trade::Reliefs`.\u001b[57GA\u001b[59Gcommit\u001b[66Gis\u001b[69Ggated\u001b[75Gin\r\u001b[6C\u001b[1B\u001b[2m15\u001b[10G\u001b[22m the sec\u001b[19Gnd\u001b[22Gcheckout, `build/gate-tree`, wi\u001b[54Gh\u001b[56G`--tidy`, editing alone beside\u001b[87Git\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m11\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFormat check\u001b[16Gclean, all 51 su\u001b[33Gt\u001b[35Gs pass and tidy is clean. Commi\u001b[67Gti\u001b[70Gg the\u001b[76Gburn as slice\u001b[90G3's\u001b[94Gfirst\u001b[100Gcommit.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projec\u001b[18Gs/manifest/build/commit-w21s3a.txt)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m21\u001b[22m lines to \u001b[1m~/projects/manifest/build/commit-w21s3a.txt\u001b[68G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  1 \u001b[22mBurn: a journey's\u001b[28Gthrust\u001b[35Gshare\u001b[41Gand\u001b[45Gacceleration,\u001b[59Gits\u001b[63Gfuel\u001b[68Gtaken\u001b[74Gas\u001b[77Git\u001b[80Gstarts,\u001b[88GW21\u001b[92Gslice\u001b[98G3\r\u001b[5C\u001b[1B\u001b[2m  2 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m  3 \u001b[22mTravel goes\u001b[22Gto version 2 with thrustBps\u001b[50G(1\u001b[53Gto\u001b[56G10,000)\u001b[64Gand\u001b[68GaccelerationMilliG\r\u001b[1B     \u001b[2m  4 \u001b[22m(0.1 g to the hull mode's sustained cap), refused InvalidQuantity out of\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22mbounds. A ship whose drive has a profile flies the burn: the mode's profile at\u001b[K\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22mits cap, its boost kept, that acceleration throughout below it, and a thrust\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22mbelow 100% as the profile's thrust share. The\u001b[56Gleg's\u001b[62Greaction\u001b[71Gmass\u001b[76Gand\u001b[80Gpellets\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m(D-108,\u001b[18Gbalance.yaml's\u001b[33Gnew\u001b[37Gfuel\u001b[42Gtuning)\u001b[50Gare\u001b[54Gpriced\u001b[61Gfrom\u001b[66GSpace::CruiseThrust\u001b[86Gat\r\u001b[1B \u001b[3G   \u001b[2m  9 \u001b[22mthe distance to the venue's station and everything aboard, taken from\u001b[80Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
