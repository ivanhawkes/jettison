[0.430, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gb. buys a tote of pellets into the hold, if\u001b[49Gthe hold has\u001b[62Gnone,\u001b[68Ghas\u001b[72Groom\u001b[77Gand\u001b[81Gthe\u001b[85Gvenue\u001b[91Gsells\u001b[97Gthem;\r\u001b[4C\u001b[1Bc\u001b[8Gfills its magazine f\u001b[29Gom \u001b[33Ghe pellets in the hold.\u001b[57G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBudget:\u001b[13G\u001b[22meverything it buys s\u001b[34Gays within the\u001b[49Gcompany's \u001b[60Gccou\u001b[65Gt after the\u001b[77Gdocking\u001b[85Gf\u001b[87Ge and any\u001b[97Garrears\u001b[105Gthe\u001b[109Gjourney\r\u001b[4C\u001b[1Bstill has \u001b[16Go\u001b[18Gp\u001b[20Gy.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe buying\u001b[22m goes through a new Trade fu\u001b[44Gc\u001b[46Gion that buys at the\u001b[68Gsks and leaves nothing resting on the book.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA saved refuel flag\u001b[25G\u001b[22mis\u001b[28Gon\u001b[31Gby\u001b[34Gdefault,\u001b[43Gand\u001b[47Gthe\u001b[51Gowner\u001b[57Gcan\u001b[61Gswitch\u001b[68Git\u001b[71Goff\u001b[75Gwith\u001b[80Ga\u001b[82Gnew\u001b[86G\u001b[38;2;177;185;249mSetRefuel\u001b[96G\u001b[39mcommand.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges from the\u001b[20Gp\u001b[23Gn:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAn old version-1 travel command is refused.\u001b[49G\u001b[22mThe\u001b[53Gplan\u001b[58Gsaid\u001b[63Git\u001b[66Gwould\u001b[72Gfly\u001b[76Gat\u001b[79G1\u001b[81Gg\u001b[83Gand\u001b[87G100%,\u001b[93Gbut\u001b[97Gthe\u001b[101Grequest\u001b[109Gsystem\r\u001b[2C\u001b[1B  registers only one version\u001b[32Gper\u001b[36Gcommand.\r\u001b[4C\u001b[1B\u001b[1mThe TUI ha\u001b[16G no stepped key co\u001b[35Gtrols for travel.\u001b[53G\u001b[22mIt ha\u001b[59G no\u001b[63Gtravel panel\u001b[77Gnd travels by the console line,\u001b[110Go \u001b[113Ghe\r\u001b[4C\u001b[1Bline's two opera\u001b[22Gds a\u001b[27Ge its control.\u001b[K\r\u001b[8C\u001b[1B\u001b[1mconsole\u001b[17Ghas no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[22m so refuelling is always o\u001b[73G there.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mA refused journey can still spend money.\u001b[46G\u001b[22mFuel\u001b[51Gbought\u001b[58Gbefore\u001b[65Gan\u001b[68G\u001b[38;2;177;185;249mInsufficientFuel\u001b[85G\u001b[39mrefusal\u001b[93Gstays\u001b[99Gbought,\u001b[107Gso\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5G\"refused, writing nothing\" rule has that one\u001b[50Gexceptio\u001b[59G,\u001b[61Gwhich I documented\r\u001b[4C\u001b[1B\u001b[1mRefuelling is two\u001b[24Gommi\u001b[29Gs.\u001b[22m It needed an imm\u001b[49Gdiate buy that Trade didn't have, so I split it from t\u001b[104Ge burn.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMov\u001b[7Gd test hashes, each traced to its cause:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe two-ship trading test's pin:\u001b[38G\u001b[22mmoved\u001b[44Gonly\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B  the old hash comes back exactly.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
