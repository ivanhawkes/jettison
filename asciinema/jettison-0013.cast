[32G\u001b[22mIt needed an imm\u001b[49Gdiat\u001b[54G buy that Trade didn't have,\u001b[83Gso\u001b[86GI\u001b[88Gsplit\u001b[94Git\u001b[97Gfrom\u001b[102Gthe\u001b[106Gburn.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe\u001b[10Gwo-s\u001b[15Gip trading test's pin:\u001b[22m moved only\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gthe old hash comes back exactly.\u001b[38G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplayer is provisioned, before the\u001b[39Gtest switches\u001b[53Gboth ships to\u001b[68Ghe compressed\u001b[82Gdrive, so that\u001b[97Gjourn\u001b[103Gy burn\u001b[110G 3,307 kg\r\u001b[4C\u001b[1Bon the\u001b[12Greal prof\u001b[22Gle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree pins in commit 2:\u001b[29G\u001b[22mmoved\u001b[35Gonly\u001b[40Gbecause\u001b[76Gd\u001b[78Gas\u001b[81Ga\u001b[83Gsaved\u001b[89Gcomponent.\u001b[100GWithout\u001b[108Gthat\u001b[27;1H\u001b[24;3H\u001b[?25h"]
