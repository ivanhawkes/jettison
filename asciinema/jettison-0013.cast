[0.066, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[1mf\u001b[9Gelling is two commits.\u001b[22m It needed an immediate buy\u001b[59Gth\u001b[62Gt Tra\u001b[68Ge\u001b[70Gdidn't have, so\u001b[86GI split\u001b[94Git from the burn.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe two-ship\u001b[19Grading test's pin:\u001b[38G\u001b[22mmoved\u001b[44Gonly\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gt\u001b[9Gold hash comes back exactly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplay\u001b[10Gr is provisioned, b\u001b[30Gfore the\u001b[39Gt\u001b[41Gst\u001b[44Gswitches bo\u001b[57G ships to the compre\u001b[78Gsed\u001b[82Gd\u001b[84Give, so\u001b[92Gthat journey\u001b[105Gburns 3,307 kg\u001b[K\r\u001b[4C\u001b[1Bon the real profile.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThree pins in commit 2:\u001b[22m moved\u001b[35Gonly\u001b[40Gbecause\u001b[48Gthe refuel flag is\u001b[67Gregistered as \u001b[82G s\u001b[85Gved component.\u001b[100GW\u001b[102Gthout\u001b[108Gthat\r\u001b[4C\u001b[1Bregistration,\u001b[19Gall\u001b[23Gthree\u001b[29Ghold.\r\u001b[2C\u001b[1B- \u001b[1mResults:\u001b[22m in\u001b[17Gboth commits\u001b[30Gal\u001b[33G 51\u001b[37GManifest\u001b[46Gsuites pass,\u001b[59Gclang-tidy is clean \u001b[80Gn the changed files and the format check\u001b[K\r\u001b[2C\u001b[1B  passes.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mProblems along the way:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gcompany\u001b[17Gtests\u001b[23Gsent\u001b[28Gtravel\u001b[35Grequests\u001b[44Gat\u001b[47Gtheir\u001b[53Gown\u001b[57Gsuite's\u001b[65Gversion,\u001b[74Gwhich\u001b[80Gno\u001b[83Glonger\u001b[90Gmatches\u001b[98Gtravel's.\u001b[108GI\u001b[110Ggave\u001b[115Gtheir\r\u001b[1B \u001b[3G  helper a\u001b[14Gversion p\u001b[24Grameter.\u001b[K\r\u001b[1B  - Three of my new test expectations were wrong, not the code. Reaction mass at Ore costs about 4 to 6 credits a tote,\r\u001b[4C\u001b[1Bnot 28, so 100 credits buys 16 totes. One check also used a player\u001b[72Gthe\u001b[76Gtest\u001b[81Gnever\u001b[87Gset\u001b[91Gup.\r\u001b[2C\u001b[1B-\u001b[5GOne probe didn't put its file back when it failed. I restored it straight away\u001b[84Gand\u001b[88Gchecked\u001b[96Gthe\u001b[100Gdiff.\r\u001b[2B \u001b[3G\u001b[1mNot done yet:\u001b[22m slice 4 (the policy choosing the burn for the most profit an hour),\u001b[85Gslice\u001b[91G5\u001b[93G(the\u001b[98Gend-to-end\u001b[109Gfixture)\u001b[118Gand\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ Give me a summary of what was written and the issues while we wait on the gate.\u001b[39m                                       \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
