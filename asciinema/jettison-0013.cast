0;200;80m     +\u001b[38;2;248;248;242m a station refuels a ship automatically, as it connects its life support, while                       \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m3\u001b[12G\u001b[22mits ow\u001b[19Ger allows it and it\u001b[40Gfunds last; and a \u001b[59Gtanding po\u001b[70Gicy picks the bur\u001b[88G that make\u001b[100Gthe mo\u001b[107Gt an\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22mhour unless its own\u001b[32Gr fixes one (the user's, \u001b[58Gs W21\u001b[64Gwas\u001b[68Gplanned).\u001b[78GThe\u001b[82Gmechanism\u001b[92Gand\u001b[96Gits\u001b[100Gnumbers\u001b[108Gare\r\u001b[5C\u001b[1B\u001b[2m 125 \u001b[12G\u001b[22mthe\u001b[16G[\u001b[38;2;230;219;116mW21 plan\u001b[39m](stage-4-trading-plan.md#w21-plan).\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Searching for \u001b[1m1\u001b[22m pattern, reading \u001b[1m1\u001b[22m file, running \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ sed -n 25,45p ..\u001b[25Gm\u001b[27Gnifest/source/game/trav\u001b[51Gl/include\u001b[61Gmanifest/travel/Travel.h; rg -n 'Result::|enum class' \r\u001b[5C\u001b[1B../manifest/source/\u001b[26Game/travel/include/manifest/trav\u001b[59Gl/Travel.h | head; git -C ../manifest diff -U0 \r\u001b[5C\u001b[1Bdocs/stage-4-trading-plan.md | grep -n '^\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
