[0.662, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3Gthe documented invocation a\u001b[31Gd free\u001b[38Gmemory first.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mGive me a summary of what was written and the issues while we wait on the gate.\u001b[39m                                       \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mWhile\u001b[9Gthe\u001b[13Ggate\u001b[18Gruns\u001b[23Gon\u001b[26G\u001b[38;2;177;185;249m344058a\u001b[34G\u001b[39m(W21\u001b[39Gslice\u001b[45G3\u001b[47Gis\u001b[50Gdone\u001b[55Gin\u001b[58Gtwo\u001b[62Gcommits,\u001b[71Gneither\u001b[79Gpushed):\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommit 1, the burn (\u001b[38;2;177;185;249ma8078f3\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe travel command is now version 2.\u001b[42G\u001b[22mIt\u001b[45Gcarries\u001b[53Gthe\u001b[57Gthrust\u001b[64Gshare\u001b[70G(1\u001b[73Gto\u001b[76G10,000\u001b[83Gbasis\u001b[89Gpoints)\u001b[97Gand\u001b[101Gthe\u001b[105Gacceleration\u001b[118G(in\r\u001b[2C\u001b[1B \u001b[5Gthousandths of g, from 0.1 g up to the hull's cap: 1 g manned, 12 g\u001b[73Gunmanned). A value out of rang\u001b[105Gis refused as\u001b[K\r\u001b[4C\u001b[1Ban invalid quantity.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe flight profile\u001b[22m is\u001b[27Gchosen\u001b[34Gfrom\u001b[39Gthose\u001b[45Gtwo\u001b[49Gvalues:\r\u001b[2C\u001b[1B \u001b[5G- at the cap it is\u001b[24Gthe gam\u001b[32G mode's own profile, keeping\u001b[61Gthe\u001b[65G2\u001b[67Gg\u001b[69Gboost\u001b[75Ghours;\r\u001b[6C\u001b[1Bbelow the cap\u001b[22Gt\u001b[24Gflies that acceleration throughout;\u001b[K\r\u001b[12C\u001b[1B100% thrust it coasts\u001b[35Gin th\u001b[41G middle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFuel burned.\u001b[18G\u001b[22mT\u001b[20Ge leg's\u001b[28Gre\u001b[31Gc\u001b[33Gion mass\u001b[42Gan\u001b[45G p\u001b[48Gllets\u001b[54Gare\u001b[58Gworked\u001b[65Gout\u001b[69Gfrom\u001b[74Gthe\u001b[78Gdistance\u001b[87Gto\u001b[90Gthe\u001b[94Gdestination\u001b[106Gstation\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Geverything aboard: hull, tanks,\u001b[37Gfuel, crew and cargo. The fuel is taken from the tanks when \u001b[98Ghe journey starts. A\r\u001b[4C\u001b[1Bleg the tanks can't cover is refus\u001b[40Gd with a \u001b[50Gew result, \u001b[38;2;177;185;249mInsufficientFuel\u001b[39m. Ships on the\u001b[92Gold tim\u001b[100G-c\u001b[103Gmpr\u001b[107Gssed drive\u001b[K\r\u001b[4C\u001b[1Bburn nothi\u001b[16Gg.\u001b[19G     \u001b[25G     \u001b[31G  \u001b[34G       \u001b[42G    \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
