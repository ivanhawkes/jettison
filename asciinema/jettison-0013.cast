[0.309, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22mthe s\u001b[17Gcond checkout, `bu\u001b[36Gld/gate-tree`, with `--tidy`,\u001b[66Gediting alone\u001b[80Gbeside\u001b[87Git\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mDone:\u001b[9Gyou\u001b[13Ghave\u001b[18Gthe\u001b[22Gfuel\u001b[27Gdesign,\u001b[35GManifest\u001b[44Gis\u001b[47Gpushed,\u001b[55Gand\u001b[59GW21's\u001b[65Gslice\u001b[71G2\u001b[73Gis\u001b[76Gcommitted\u001b[86Gin\u001b[89GManifest.\u001b[99GThe\u001b[103Gtwo\u001b[107Gnew\u001b[111Gcommits\r\u001b[1B \u001b[3Gare local\u001b[13Gand hav\u001b[21Gn't been gated yet.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPushed:\u001b[11G\u001b[22mManifest's\u001b[22Gearlier\u001b[30Gcommits\u001b[38G(\u001b[38;2;177;185;249m2fada11..6f4c67c\u001b[39m,\u001b[57Gthe\u001b[61Greworked\u001b[70Gplan\u001b[75Gand\u001b[79Gthe\u001b[83Gpin\u001b[87Gmove\u001b[92Gto\u001b[95G\u001b[38;2;177;185;249ma9b8305\u001b[39m).\u001b[105GThe\u001b[109Gpush\u001b[114Gonly\r\u001b[2C\u001b[1Bworked outs\u001b[15Gd\u001b[17G \u001b[19Ghe\u001b[22Gs\u001b[24Gndbox, becau\u001b[37Ge of SSH's config check.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe design\u001b[22m,\u001b[15Gcommitted\u001b[25Gas\u001b[28G\u001b[38;2;177;185;249m714e5cd\u001b[36G\u001b[39m(decision\u001b[46GD-108\u001b[52Gand\u001b[56Gthe\u001b[60GW21\u001b[64Gplan):\r\u001b[2C\u001b[1B- \u001b[1mSmall ships\u001b[22m (skiff up to a Rocinante-class corvette) fly a\u001b[64Gc\u001b[66Gean fusion\u001b[77Gtorch\u001b[83Gat\u001b[86G10%\u001b[90Gof\u001b[93Glight\u001b[99Gspeed,\u001b[106Gburning\u001b[114Gtwo\r\u001b[2C\u001b[1B \u001b[5Ggoods:\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mReaction mass\u001b[21G\u001b[22m(water\u001b[28Gice):\u001b[34Gcheap,\u001b[41Gmade\u001b[46Gat\u001b[49Gevery\u001b[55Gstation,\u001b[64Gabout\u001b[70G3.5\u001b[74Gt\u001b[76Gfor\u001b[80Gthe\u001b[84Gstarter's\u001b[94Gfull-thrust\u001b[106Grun\u001b[110Gfrom\u001b[115GOre\u001b[119Gto\r\u001b[4C\u001b[1B \u001b[7GBrine.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mFusion pellets\u001b[22G\u001b[22m(deuterium\u001b[33Gand\u001b[37Ghelium-3):\u001b[48G1,200\u001b[54Gcredits\u001b[62Ga\u001b[64Gkg,\u001b[68Grefined\u001b[76Gat\u001b[79Gone\u001b[83Gstation\u001b[91Gper\u001b[95Gplanet.\u001b[103GThat\u001b[108Gmakes\u001b[114Gthem\u001b[119Ga\r\u001b[4C\u001b[1B \u001b[7Gmonopoly good an\u001b[24G a cargo\u001b[33Gwort\u001b[38G carrying.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHard burns are a trade-off.\u001b[33G\u001b[22mPellet use rises\u001b[50Gsteeply\u001b[58Gabove\u001b[64G1\u001b[66Gg.\u001b[69GThe\u001b[73Gbest\u001b[78Gthrust\u001b[85Gshare\u001b[91Gcomes\u001b[97Gout\u001b[101Gof\u001b[104Gthe\u001b[108Gratio\u001b[114Gof\r\u001b[2C\u001b[1B \u001b[5Gfull-thrust fuel cost to the run's\u001b[40Ggross: abou\u001b[52G 45% for cheap cargo, 85%\u001b[78Gfo\u001b[81G dear cargo, and 100% only\u001b[108Gif fuel were\r\u001b[5C\u001b[1Bree.      \u001b[17G    \u001b[22G    \u001b[27G  \u001b[30G   \u001b[34G     \u001b[40G      \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
