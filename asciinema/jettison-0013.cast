[0.438, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mA\u001b[7G old version-1 travel command is refused.\u001b[49G\u001b[22mThe\u001b[53Gplan\u001b[58Gsaid\u001b[63Git\u001b[66Gwould\u001b[72Gfly\u001b[76Gat\u001b[79G1\u001b[81Gg\u001b[83Gand\u001b[87G100%,\u001b[93Gbut\u001b[97Gthe\u001b[101Grequest\u001b[109Gsystem\r\u001b[2C\u001b[1B \u001b[5Gregisters only one version per command.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TUI has no stepped key controls for travel.\u001b[53G\u001b[22mIt\u001b[56Ghas\u001b[60Gno\u001b[63Gtravel\u001b[70Gpanel\u001b[76Gand\u001b[80Gtravels\u001b[88Gby\u001b[91Gthe\u001b[95Gconsole\u001b[103Gline,\u001b[109Gso\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5Gline's two operands are its control.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe console has no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[47G\u001b[22mso\u001b[50Grefuelling\u001b[61Gis\u001b[64Galways\u001b[71Gon\u001b[74Gthere.\r\u001b[4C\u001b[1B\u001b[1mA refused journey can still spend money.\u001b[22m Fuel bo\u001b[54Gght before an \u001b[38;2;177;185;249mInsufficientFuel\u001b[85G\u001b[39mrefusal\u001b[93Gstays\u001b[99Gbought,\u001b[107Gso\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5G\"refused, writing nothing\" rule has that\u001b[46Gon\u001b[49G exception, which I documented.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefuelling is two commits.\u001b[32G\u001b[22mIt needed an imm\u001b[49Gdiat\u001b[54G buy that Trade didn't have,\u001b[83Gso\u001b[86GI\u001b[88Gsplit\u001b[94Git\u001b[97Gfrom\u001b[102Gthe\u001b[106Gburn.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe\u001b[10Gwo-s\u001b[15Gip trading test's pin:\u001b[22m moved only\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gthe old hash comes back exactly.\u001b[38G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplayer is provisioned, before the\u001b[39Gtest switches\u001b[53Gboth ships to\u001b[68Ghe compressed\u001b[82Gdrive, so that\u001b[97Gjourn\u001b[103Gy burn\u001b[110G 3,307 kg\r\u001b[4C\u001b[1Bon the\u001b[12Greal prof\u001b[22Gle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree pins in commit 2:\u001b[29G\u001b[22mmoved\u001b[35Gonly\u001b[40Gbecause\u001b[48Gthe\u001b[52Grefuel\u001b[59Gflag\u001b[64Gis\u001b[67Gregistered\u001b[78Gas\u001b[81Ga\u001b[83Gsaved\u001b[89Gcomponent.\u001b[100GWithout\u001b[108Gthat\r\u001b[2C\u001b[1B \u001b[5Gregistration, all three\u001b[29Gh\u001b[31Gld.\u001b[35G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mResults:\u001b[22m \u001b[15Gn both commits a\u001b[32Gl 51\u001b[37GManifest\u001b[46Gsuites\u001b[53Gpass,\u001b[59Gclang-tidy\u001b[70Gis\u001b[73Gclean\u001b[79Gon\u001b[82Gthe\u001b[86Gchanged\u001b[94Gfiles\u001b[100Gand\u001b[104Gthe\u001b[108Gformat\u001b[115Gcheck\r\u001b[2C\u001b[1B \u001b[5Gpasses.\u001b[K\r\u001b[4C\u001b[1B       \u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.061, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B \u001b[5Gregisters only one version per command.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TUI has no stepped key controls for travel.\u001b[53G\u001b[22mIt\u001b[56Ghas\u001b[60Gno\u001b[63Gtravel\u001b[70Gpanel\u001b[76Gand\u001b[80Gtravels\u001b[88Gby\u001b[91Gthe\u001b[95Gconsole\u001b[103Gline,\u001b[109Gso\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5Gline's two operands are its control.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe console has no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[47G\u001b[22mso\u001b[50Grefuelling\u001b[61Gis\u001b[64Galways\u001b[71Gon\u001b[74Gthere.\r\u001b[4C\u001b[1B\u001b[1mA refused journey can still spend money.\u001b[22m Fuel bo\u001b[54Gght before an \u001b[38;2;177;185;249mInsufficientFuel\u001b[85G\u001b[39mrefusal\u001b[93Gstays\u001b[99Gbought,\u001b[107Gso\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5G\"refused, writing nothing\" rule has that\u001b[46Gon\u001b[49G exception, which I documented.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefuelling is two commits.\u001b[32G\u001b[22mIt needed an imm\u001b[49Gdiat\u001b[54G buy that Trade didn't have,\u001b[83Gso\u001b[86GI\u001b[88Gsplit\u001b[94Git\u001b[97Gfrom\u001b[102Gthe\u001b[106Gburn.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe\u001b[10Gwo-s\u001b[15Gip trading test's pin:\u001b[22m moved only\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gthe old hash comes back exactly.\u001b[38G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplayer is provisioned, before the\u001b[39Gtest switches\u001b[53Gboth ships to\u001b[68Ghe compressed\u001b[82Gdrive, so that\u001b[97Gjourn\u001b[103Gy burn\u001b[110G 3,307 kg\r\u001b[4C\u001b[1Bon the\u001b[12Greal prof\u001b[22Gle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree pins in commit 2:\u001b[29G\u001b[22mmoved\u001b[35Gonly\u001b[40Gbecause\u001b[48Gthe\u001b[52Grefuel\u001b[59Gflag\u001b[64Gis\u001b[67Gregistered\u001b[78Gas\u001b[81Ga\u001b[83Gsaved\u001b[89Gcomponent.\u001b[100GWithout\u001b[108Gthat\r\u001b[2C\u001b[1B \u001b[5Gregistration, all three\u001b[29Gh\u001b[31Gld.\u001b[35G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mResults:\u001b[22m \u001b[15Gn both commits a\u001b[32Gl 51\u001b[37GManifest\u001b[46Gsuites\u001b[53Gpass,\u001b[59Gclang-tidy\u001b[70Gis\u001b[73Gclean\u001b[79Gon\u001b[82Gthe\u001b[86Gchanged\u001b[94Gfiles\u001b[100Gand\u001b[104Gthe\u001b[108Gformat\u001b[115Gcheck\r\u001b[2C\u001b[1B \u001b[5Gpasses.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProblems along the way:\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.086, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TUI has no stepped key controls for travel.\u001b[53G\u001b[22mIt\u001b[56Ghas\u001b[60Gno\u001b[63Gtravel\u001b[70Gpanel\u001b[76Gand\u001b[80Gtravels\u001b[88Gby\u001b[91Gthe\u001b[95Gconsole\u001b[103Gline,\u001b[109Gso\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5Gline's two operands are its control.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe console has no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[47G\u001b[22mso\u001b[50Grefuelling\u001b[61Gis\u001b[64Galways\u001b[71Gon\u001b[74Gthere.\r\u001b[4C\u001b[1B\u001b[1mA refused journey can still spend money.\u001b[22m Fuel bo\u001b[54Gght before an \u001b[38;2;177;185;249mInsufficientFuel\u001b[85G\u001b[39mrefusal\u001b[93Gstays\u001b[99Gbought,\u001b[107Gso\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5G\"refused, writing nothing\" rule has that\u001b[46Gon\u001b[49G exception, which I documented.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefuelling is two commits.\u001b[32G\u001b[22mIt needed an imm\u001b[49Gdiat\u001b[54G buy that Trade didn't have,\u001b[83Gso\u001b[86GI\u001b[88Gsplit\u001b[94Git\u001b[97Gfrom\u001b[102Gthe\u001b[106Gburn.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe\u001b[10Gwo-s\u001b[15Gip trading test's pin:\u001b[22m moved only\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gthe old hash comes back exactly.\u001b[38G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplayer is provisioned, before the\u001b[39Gtest switches\u001b[53Gboth ships to\u001b[68Ghe compressed\u001b[82Gdrive, so that\u001b[97Gjourn\u001b[103Gy burn\u001b[110G 3,307 kg\r\u001b[4C\u001b[1Bon the\u001b[12Greal prof\u001b[22Gle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree pins in commit 2:\u001b[29G\u001b[22mmoved\u001b[35Gonly\u001b[40Gbecause\u001b[48Gthe\u001b[52Grefuel\u001b[59Gflag\u001b[64Gis\u001b[67Gregistered\u001b[78Gas\u001b[81Ga\u001b[83Gsaved\u001b[89Gcomponent.\u001b[100GWithout\u001b[108Gthat\r\u001b[2C\u001b[1B \u001b[5Gregistration, all three\u001b[29Gh\u001b[31Gld.\u001b[35G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mResults:\u001b[22m \u001b[15Gn both commits a\u001b[32Gl 51\u001b[37GManifest\u001b[46Gsuites\u001b[53Gpass,\u001b[59Gclang-tidy\u001b[70Gis\u001b[73Gclean\u001b[79Gon\u001b[82Gthe\u001b[86Gchanged\u001b[94Gfiles\u001b[100Gand\u001b[104Gthe\u001b[108Gformat\u001b[115Gcheck\r\u001b[2C\u001b[1B \u001b[5Gpasses.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProblems along the way:\r\u001b[2C\u001b[1B\u001b[22m- The company tests sent\u001b[28Gtravel\u001b[35Grequests\u001b[44Gat\u001b[76Gich\u001b[80Gno\u001b[83Glonger\u001b[90Gmatches\u001b[98Gtravel's.\u001b[108GI\u001b[110Ggave\u001b[115Gtheir\u001b[27;1H\u001b[24;3H\u001b[?25h"]
