[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mClass:\u001b[22m \u001b[1mHa\u001b[14Ger fusion\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTypical \u001b[12Gulls:\u001b[22m medium freighters\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDrive (physics bent a little):\u001b[22m D–D\u001b[38Gor D–T fusion, neutron-heavy,\u001b[68Gabout\u001b[74G3%\u001b[77Gof\u001b[80Glight\u001b[86Gspeed\r\u001b[2C\u001b[1B\u001b[1mF\u001b[5Gel:\u001b[22m Reaction mass plus\u001b[28Gdeuterium\u001b[38G(cheap,\u001b[46Gfrom\u001b[51Gany\u001b[55Gwater)\r\u001b[2C\u001b[1B\u001b[1mSustained g:\u001b[22m about 0.3 \u001b[28G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCatch:\u001b[22m Neutron shielding costs mass; the\u001b[44Gdrive\u001b[50Gmust\u001b[55Gstay\u001b[60Gcold\u001b[65Gwithin\u001b[72Ga\u001b[74Gstation's\u001b[84Gexclusion\u001b[94Gradius\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1mClass:\u001b[22m \u001b[1mPulse drive\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTypical \u001b[12Gulls:\u001b[22m bulk carriers, destroyer-c\u001b[45Gass and up\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDrive (physics bent a little):\u001b[22m N\u001b[36Gcl\u001b[39Gar pulse units (Orion-style),\u001b[69Ghigh\u001b[74Gthrust,\u001b[82Glow\u001b[86Gefficiency\r\u001b[2C\u001b[1B\u001b[1mF\u001b[5Gel:\u001b[22m Fissile pulse\u001b[23Gunits,\u001b[30Gmade\u001b[35Gunder\u001b[41Ga\u001b[43Gpolity's\u001b[52Glicence\r\u001b[2C\u001b[1B\u001b[1mSustained g:\u001b[22m 1 g in burs\u001b[30G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCatch:\u001b[22m Banned \u001b[18Gear planets a\u001b[32Gd\u001b[34Gstations:\u001b[44Gfallout\u001b[52Gcosts\u001b[58Ga\u001b[60Gregion's\u001b[69Ghealth\u001b[76Gand\u001b[80Ghappiness,\u001b[91Gpolities\u001b[100Gfine\u001b[105Git,\u001b[109Gand\u001b[113Gan\r\u001b[4C\u001b[1Bunlicensed\u001b[16Gunit\u001b[21Gis\u001b[24Gsmuggling\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMechanics that fall out of this\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe thrust slider matters more than now.\u001b[22m At about 10% of light speed, Ore\u001b[79Gto Brine at full thrust need\u001b[109Greaction\u001b[K\r\u001b[4C\u001b[1Bmass of about 15%\u001b[23Gof the ship's mass, and \u001b[75Gank\u001b[79Gsize\u001b[84Gbecomes\u001b[92Ga\u001b[94Greal\u001b[99Glogistics\u001b[109Gchoice,\u001b[117Gand\u001b[27;1H\u001b[24;3H\u001b[?25h"]
