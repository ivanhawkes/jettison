[0.603, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mWha\u001b[10Ghapp\u001b[15Gns on departure.\u001b[22m A\u001b[34Gship\u001b[39Gleaving\u001b[47Ga\u001b[49Gvenue\u001b[55Gfirst:\r\u001b[2C\u001b[1B \u001b[5Ga. buys whole totes of reaction mass at the\u001b[54G's live\u001b[62Gasks,\u001b[68Gstraight\u001b[77Ginto\u001b[82Gits\u001b[86Gtanks;\r\u001b[4C\u001b[1Bb\u001b[13Ga tote \u001b[21Gf pellets int\u001b[35G the hold, if\u001b[49Gthe hold has\u001b[62Gnone\u001b[68Ghas room\u001b[77Ga\u001b[79Gd the venue sells\u001b[97Gthem;\r\u001b[4C\u001b[1Bc\u001b[8Gfills i\u001b[16Gs magazine from the\u001b[36Gpellets in the hold.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBudget:\u001b[22m everything it\u001b[27Gbuys\u001b[32Gstays within the company's\u001b[59Gaccount\u001b[67Gafter\u001b[73Gthe\u001b[77Gdocking\u001b[85Gfee\u001b[89Gand\u001b[93Gany\u001b[97Garrears\u001b[105Gthe\u001b[109Gjourney\r\u001b[2C\u001b[1B \u001b[5Gstill has to pay.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe buying\u001b[22m goes through\u001b[29Ga\u001b[31Gnew\u001b[35GTrade\u001b[41Gfunction\u001b[50Gthat\u001b[55Gbuys\u001b[60Gat\u001b[63Gthe\u001b[67Gasks\u001b[72Gand\u001b[76Gleaves\u001b[83Gnothing\u001b[91Gresting\u001b[99Gon\u001b[102Gthe\u001b[106Gbook.\r\u001b[4C\u001b[1B\u001b[1mA saved refuel flag\u001b[22m is on\u001b[31Gby def\u001b[38Gult, and the owner can switch it off with a new \u001b[38;2;177;185;249mSetRefuel\u001b[39m command.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges from the plan:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mA\u001b[7G old version-1 travel command is refused.\u001b[49G\u001b[22mThe\u001b[53Gplan\u001b[58Gsaid\u001b[63Git\u001b[66Gwould\u001b[72Gfly\u001b[76Gat\u001b[79G1\u001b[81Gg\u001b[83Gand\u001b[87G100%,\u001b[93Gbut\u001b[97Gthe\u001b[101Grequest\u001b[109Gsystem\r\u001b[2C\u001b[1B \u001b[5Gregisters only one version per command.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TUI has no stepped key controls for travel.\u001b[53G\u001b[22mIt\u001b[56Ghas\u001b[60Gno\u001b[63Gtravel\u001b[70Gpanel\u001b[76Gand\u001b[80Gtravels\u001b[88Gby\u001b[91Gthe\u001b[95Gconsole\u001b[103Gline,\u001b[109Gso\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5Gline's two operands are its control.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe console has no \u001b[38;2;177;185;249mSetRefuel\u001b[39m command yet,\u001b[47G\u001b[22mso\u001b[50Grefuelling\u001b[61Gis\u001b[64Galways\u001b[71Gon\u001b[74Gthere.\r\u001b[4C\u001b[1B\u001b[1mA refused journey can still spend money.\u001b[22m Fuel bo\u001b[54Gght before an \u001b[38;2;177;185;249mInsufficientFuel\u001b[85G\u001b[39mrefusal\u001b[93Gstays\u001b[99Gbought,\u001b[107Gso\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5G\"refused, writing nothing\" rule has that\u001b[46Gon\u001b[49G exception, which I documented.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefuelling is two commits.\u001b[32G\u001b[22mIt needed an imm\u001b[49Gdiat\u001b[54G buy that Trade didn't have,\u001b[83Gso\u001b[86GI\u001b[88Gsplit\u001b[94Git\u001b[97Gfrom\u001b[102Gthe\u001b[106Gburn.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
