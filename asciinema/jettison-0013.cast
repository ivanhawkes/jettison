[0.070, "o", "\u001b[?25l\u001b[H\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m1\u001b[15G\u001b[38;2;248;248;242msame bounds. The console's\u001b[42G`trav\u001b[48Gl` \u001b[52Gake\u001b[56G them as two optional operands,       \u001b[95G   \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242mtravel [pri\u001b[28Gc\u001b[30Gpal] <ship> <venue> [thrust%] [g]`. Each converts to `thrustBps`\u001b[95Gand\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1413 +\u001b[38;2;248;248;242m  `accelerationMilliG`, which the server checks against the ship again.                              \r\u001b[9C\u001b[1B\u001b[49m\u001b[39m\u001b[2m4\u001b[13G\u001b[22m-\u001b[15G**Fuel burned, on a curve.** Each phase of a l\u001b[62Gg burns `fuel.kilogra\u001b[84GsPerTonneKms` (0.005)\u001b[106Gtimes\u001b[K\r\u001b[9C\u001b[1B\u001b[2m5\u001b[15G\u001b[22mthe ship's m\u001b[28Gss\u001b[31Gin tonn\u001b[39Gs times the\u001b[51Gphase's speed change in km/s, times the acceleration's factor:\r\u001b[5C\u001b[1B\u001b[2m 1416 \u001b[15G\u001b[22m1\u001b[17Gup\u001b[20Gto\u001b[23G1\u001b[25Gg\u001b[27Gand\u001b[31Gthe\u001b[35Gacceleration\u001b[48Gin\u001b[51Gg\u001b[53Gsquared\u001b[61Gabove\u001b[67Git\u001b[70G(`fuel.curveExponent`,\u001b[93G2),\u001b[97Gso\u001b[100G2\u001b[102Gg\u001b[104Gcosts\u001b[110G4\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/manif\u001b[27Gst/docs/\u001b[36Gtage-4-trading-plan.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[14G\u001b[22mlin\u001b[18Gs, removed \u001b[1m2\u001b[31G\u001b[22mlines\u001b[K\r\u001b[9C\u001b[1B\u001b[2m5\u001b[15G\u001b[22mthe ship's m\u001b[28Gss\u001b[31Gin tonn\u001b[39Gs times the\u001b[51Gphase's speed change in km/s, times the acceleration's factor:\r\u001b[9C\u001b[1B\u001b[2m6\u001b[15G\u001b[22m1 up to\u001b[23G1 g and\u001b[31Gthe accelera\u001b[45Gon in g\u001b[53Gsquared abov\u001b[66G it (`fuel.curv\u001b[82GExponen\u001b[90G`,\u001b[93G2), \u001b[98Go 2 g costs\u001b[110G4\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1417 \u001b[22m   times a km/s at 1 g, 4 g 16 times and 12 g 144 times: a hard burn empties the tanks far faster and\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m8\u001b[15G\u001b[38;2;248;248;242mcan be punishingly expensive, yet worth it to\u001b[61Gwin a race, such as t\u001b[83G colonise a new sys\u001b[103Gem. \u001b[48;2;92;2;0mExact\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 1419 -\u001b[38;2;248;248;242m  in integers, the factor an integer power. The mass is everything aboard as the leg starts: the     \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m8\u001b[15G\u001b[38;2;248;248;242mcan be punishingly \u001b[35Gxpensive, y\u001b[47Gt worth i\u001b[57G to w\u001b[63Gn a race, such as to coloni\u001b[91Ge a\u001b[95Gnew\u001b[99Gsys\u001b[103Gem. \u001b[48;2;4;71;0mEach\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m19\u001b[15G\u001b[38;2;248;248;242mphase's\u001b[23Gspe\u001b[27Gd change is its acceleration\u001b[56Gtimes its \u001b[67Geconds from\u001b[79G`CruiseThrust`, the factor an\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1420 +\u001b[38;2;248;248;242m  integer power, the kilograms rounded up. The mass is everything aboard as the leg starts: the      \r\u001b[9C\u001b[1B\u001b[49m\u001b[39m\u001b[2m1\u001b[15G\u001b[22mhull's `mass`,\u001b[30Gits fuel tanks' (`fuel.tankTo\u001b[60GnesPerTonne`, 0.25 t of t\u001b[87Gk to each tonne of\u001b[K\r\u001b[9C\u001b[1B\u001b[2m2\u001b[15G\u001b[22mcapacity),\u001b[26Gthe fuel\u001b[35Gi\u001b[37G them, its occupan\u001b[56Gs and passengers (`fuel.occupantKilograms`,\u001b[100G100\u001b[104Geach,\u001b[110G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 1423 \u001b[15G\u001b[22mwith\u001b[20Gtheir\u001b[26Geffects)\u001b[35Gand\u001b[39Gits\u001b[43Gcarg\u001b[76Gthe\u001b[80Gitem's\u001b[87Gdensity\u001b[95Gover\u001b[100Gits\u001b[104Gunits\u001b[110Gper\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m0\u001b[15G\u001b[38;2;248;248;242mb\u001b[17Gsic: the two value\u001b[36G shown as numbers and stepped \u001b[67Gith keys (5% and 0.1\u001b[88Gg\u001b[90Ga\u001b[92Gpress),\u001b[100Gheld\u001b[105Gto\u001b[108Gthe\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m1\u001b[15G\u001b[38;2;248;248;242msame bounds. The console's\u001b[42G`trav\u001b[48Gl` \u001b[52Gake\u001b[56G them as two optional operands,       \u001b[95G   \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m2\u001b[16G\u001b[38;2;248;248;242mtravel [pri\u001b[28Gc\u001b[30Gpal] <ship> <venue> [thrust%] [g]`. Each converts to `thrustBps`\u001b[95Gand\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 1413 +\u001b[38;2;248;248;242m  `accelerationMilliG`, which the server checks against the ship again.                              \r\u001b[9C\u001b[1B\u001b[49m\u001b[39m\u001b[2m4\u001b[13G\u001b[22m-\u001b[15G**Fuel burned, on a curve.** Each phase of a l\u001b[62Gg burns `fuel.kilogra\u001b[84GsPerTonneKms` (0.005)\u001b[106Gtimes\u001b[K\r\u001b[9C\u001b[1B\u001b[2m5\u001b[15G\u001b[22mthe ship's m\u001b[28Gss\u001b[31Gin tonn\u001b[39Gs times the\u001b[51Gphase's speed change in km/s, times the acceleration's factor:\r\u001b[5C\u001b[1B\u001b[2m 1416 \u001b[15G\u001b[22m1\u001b[17Gup\u001b[20Gto\u001b[23G1\u001b[25Gg\u001b[27Gand\u001b[31Gthe\u001b[35Gacceleration\u001b[48Gin\u001b[51Gg\u001b[53Gsquared\u001b[61Gabove\u001b[67Git\u001b[70G(`fuel.curveExponent`,\u001b[93G2),\u001b[97Gso\u001b[100G2\u001b[102Gg\u001b[104Gcosts\u001b[110G4\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/manif\u001b[27Gst/docs/\u001b[36Gtage-4-trading-plan.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[14G\u001b[22mlin\u001b[18Gs, removed \u001b[1m2\u001b[31G\u001b[22mlines\u001b[K\r\u001b[9C\u001b[1B\u001b[2m5\u001b[15G\u001b[22mthe ship's m\u001b[28Gss\u001b[31Gin tonn\