u001b[38;2;248;248;242mthe hauler and puls\u001b[32Gdrives booked\u001b[46Gas\u001b[49GW22), \u001b[48;2;4;71;0mslices\u001b[48;2;2;40;0m 2\u001b[48;2;4;71;0m and 3\u001b[48;2;2;40;0m, the fuels and\u001b[85Gthe tanks, \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mburn\u001b[48;2;2;40;0m and      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m12\u001b[11G\u001b[38;2;248;248;242m\u001b[48;2;4;71;0mrefuelling\u001b[48;2;2;40;0m, \u001b[48;2;4;71;0mare\u001b[27G\u001b[48;2;2;40;0mdone\u001b[32G(2026-11-22),\u001b[46Gso\u001b[49G\u001b[48;2;4;71;0mthe\u001b[53Ggate\u001b[58G\u001b[48;2;2;40;0mis\u001b[61Gnext,\u001b[67Gthen\u001b[72G\u001b[48;2;4;71;0mslice 4, \u001b[48;2;2;40;0mthe\u001b[85G\u001b[48;2;4;71;0mpolicy\u001b[48;2;2;40;0m.\u001b[93GThen\u001b[98GW12,\u001b[103Gcompetitive\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m    +\u001b[38;2;248;248;242m procurement on the                                                                                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m3\u001b[11G\u001b[22m[\u001b[38;2;230;219;116mtender contract\u001b[39m](stage-4-trading-plan.md#tender-contract-w11-2026-11-21),\u001b[86Gits\u001b[90GAI\u001b[93Gissuer\u001b[100Gspending\r\u001b[7C\u001b[1B\u001b[2m4\u001b[11G\u001b[22m`Trad\u001b[17G::Budget` and call\u001b[36Gng `Trade::Reliefs`. A commit\u001b[66Gis gated in\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 15 \u001b[11G\u001b[22mthe\u001b[15Gsecond\u001b[22Gcheckout,\u001b[32G`build/gate-tree`,\u001b[51Gwith\u001b[56G`--tidy`,\u001b[66Gediting\u001b[74Galone\u001b[80Gbeside\u001b[87Git\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Writing ~/projects/manifest/build/commit-w21s3b.txt\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Write(~/projects/manifest/build/commit-w21s3b.txt)\r\u001b[2C\u001b[2B\u001b[38;2;228;144;112mComputing…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
