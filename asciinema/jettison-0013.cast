[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mMoved test hashes, each traced to its cause:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe\u001b[10Gwo-s\u001b[15Gip trading test's pin:\u001b[22m moved only\u001b[49Gby\u001b[52Gthe\u001b[56Grequest's\u001b[66Gnew\u001b[70Gversion\u001b[78Gnumber\u001b[85Gand\u001b[89Gtwo\u001b[93Gfields.\u001b[101GWith\u001b[106Gboth\u001b[111Gtaken\u001b[117Gout,\r\u001b[2C\u001b[1B \u001b[5Gthe old hash comes back exactly.\u001b[38G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe no-player trading test's pin:\u001b[39G\u001b[22mmoved\u001b[45Gby\u001b[48Greal\u001b[53Gfuel.\u001b[59GThe\u001b[63GNPC\u001b[67Gtrader's\u001b[76Gfirst\u001b[82Gjourney\u001b[90Gstarts\u001b[97Gin\u001b[100Gthe\u001b[104Gsame\u001b[109Gstep\u001b[114Gthe\r\u001b[2C\u001b[1B \u001b[5Gplayer is provisioned, before the\u001b[39Gtest switches\u001b[53Gboth ships to\u001b[68Ghe compressed\u001b[82Gdrive, so that\u001b[97Gjourn\u001b[103Gy burn\u001b[110G 3,307 kg\r\u001b[4C\u001b[1Bon the\u001b[12Greal prof\u001b[22Gle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree pins in commit 2:\u001b[29G\u001b[22mmoved\u001b[35Gonly\u001b[40Gbecause\u001b[48Gthe\u001b[52Grefuel\u001b[59Gflag\u001b[64Gis\u001b[67Gregistered\u001b[78Gas\u001b[81Ga\u001b[83Gsaved\u001b[89Gcomponent.\u001b[100GWithout\u001b[108Gthat\r\u001b[2C\u001b[1B \u001b[5Gregistration, all three\u001b[29Gh\u001b[31Gld.\u001b[35G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mResults:\u001b[22m \u001b[15Gn both commits a\u001b[32Gl 51\u001b[37GManifest\u001b[46Gsuites\u001b[53Gpass,\u001b[59Gclang-tidy\u001b[70Gis\u001b[73Gclean\u001b[79Gon\u001b[82Gthe\u001b[86Gchanged\u001b[94Gfiles\u001b[100Gand\u001b[104Gthe\u001b[108Gformat\u001b[115Gcheck\r\u001b[2C\u001b[1B \u001b[5Gpasses.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProblems along the way:\r\u001b[2C\u001b[1B\u001b[22m- The company tests sent\u001b[28Gtravel\u001b[35Grequests\u001b[44Gat\u001b[47Gtheir\u001b[53Gown\u001b[57Gsuite's\u001b[65Gversion,\u001b[74Gwhich\u001b[80Gno\u001b[83Glonger\u001b[90Gmatches\u001b[98Gtravel's.\u001b[108GI\u001b[110Ggave\u001b[115Gtheir\r\u001b[2C\u001b[1B \u001b[5Ghelper a version parame\u001b[29Ger.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThre\u001b[10G of\u001b[14Gmy new test exp\u001b[30Gctations\u001b[39Gwere\u001b[44Gwrong,\u001b[51Gnot\u001b[55Gthe\u001b[59Gcode.\u001b[65GReaction\u001b[74Gmass\u001b[79Gat\u001b[82GOre\u001b[86Gcosts\u001b[92Gabout\u001b[98G4\u001b[100Gto\u001b[103G6\u001b[105Gcredits\u001b[113Ga\u001b[115Gtote,\r\u001b[2C\u001b[1B \u001b[5Gnot 28, so 100 cr\u001b[23Gdits buys 16 totes. One check also use\u001b[62G a\u001b[65Gpl\u001b[68Gyer the test nev\u001b[85Gr se\u001b[90G up.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOne\u001b[9Gprobe didn't put its file back when it failed. I\u001b[58Grestored it straight away and checked\u001b[96Gthe\u001b[100Gdiff.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done yet:\u001b[17G\u001b[22mslice\u001b[23G4\u001b[25G(the\u001b[30Gpolicy\u001b[37Gchoosing\u001b[46Gthe\u001b[50Gburn\u001b[55Gfor\u001b[59Gthe\u001b[63Gmost\u001b[68Gprofit\u001b[75Gan\u001b[78Ghour),\u001b[85Gslice\u001b[91G5\u001b[93G(the\u001b[98Gend-to-end\u001b[109Gfixture)\u001b[118Gand\r\u001b[2C\u001b[1Bslice 6 (close-out). No t\u001b[29Gst yet cover\u001b[42G refu\u001b[76G own asks, only at another player's ask.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
