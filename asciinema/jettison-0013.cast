[1mThe buying\u001b[22m goes thr\u001b[25Gugh a new Trade\u001b[41Gfunction\u001b[50Gthat buys at the\u001b[67Gasks and l\u001b[78Gaves\u001b[83Gnothing\u001b[91Gresting\u001b[99Gon\u001b[102Gthe\u001b[106Gbook.\r\u001b[4C\u001b[1B\u001b[1mA saved refuel flag\u001b[22m is on by default, and the owner can switch it off with a new\u001b[86G\u001b[38;2;177;185;249mSetRefuel\u001b[39m command.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mChanges from t\u001b[19G plan:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mAn old version-1 travel command is refused.\u001b[49G\u001b[22mThe plan said it\u001b[66Gwould fly at 1 g and 100%,\u001b[93Gbut the\u001b[101Grequest system\u001b[K\r\u001b[4C\u001b[1Bregisters only one\u001b[24Gversion per command.\r\u001b[4C\u001b[1B\u001b[1mThe TUI has no stepped key controls for travel.\u001b[53G\u001b[22mIt\u001b[56Ghas\u001b[60Gno\u001b[63Gtravel\u001b[70Gpanel\u001b[76Gand\u001b[80Gtravels\u001b[88Gby\u001b[91Gthe\u001b[95Gconsole\u001b[103Gline,\u001b[109Gso\u001b[112Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
