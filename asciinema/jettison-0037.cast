[0.025, "o", "\u001b[?25l\u001b[H\u001b[3Gmerging.\r\u001b[2C\u001b[2B- \u001b[1mJettison\u001b[22m \u001b[38;2;177;185;249made7077\u001b[39m on \u001b[38;2;177;185;249mart-standards-support\u001b[39m (\u001b[38;2;177;185;249mjettison.lane-c\u001b[39m): the J64–J67 roadmap\u001b[86Gtrack\u001b[92Gand\u001b[96Gits\u001b[100Gdocs,\u001b[106Gplus\u001b[111Gthe\r\u001b[4C\u001b[1Brename.\r\u001b[1B \u001b[3G  - The texture slo\u001b[23G \u001b[26G \u001b[28Gow \u001b[38;2;177;185;249morm\u001b[39m in \u001b[38;2;177;185;249mmesh.program.yaml\u001b[56G\u001b[39mand\u001b[60G\u001b[38;2;177;185;249mmesh_triplanar.program.yaml\u001b[39m.\u001b[89GThe\u001b[93Gshader's\u001b[102Gsampler\u001b[110Gis\u001b[113Gnow\r\u001b[1B      \u001b[38;2;177;185;249mormTexture\u001b[39m; th\u001b[22G bin\u001b[27Ging number\u001b[38Gis\u001b[41Gunchanged.\r\u001b[4C\u001b[1B- No\u001b[10Gmaterial file\u001b[24Gnamed\u001b[30Gthe\u001b[34Gslot,\u001b[40Gso\u001b[43Gnone\u001b[48Gneeded\u001b[55Grewriting,\u001b[66Gand\u001b[70GManifest\u001b[79Ghas\u001b[83Gno\u001b[86Gmaterial\u001b[95Gfiles\u001b[101Gyet.\r\u001b[4C\u001b[1B- The material parameter of the same name (the metallic and roughness factors) keeps its name.\u001b[K\r\u001b[4C\u001b[1B- Reading occlusion from the red channel is still J66, which now records the rename.\u001b[K\r\u001b[4C\u001b[1B- The content-file naming rule in \u001b[38;2;177;185;249mcoding-standards.md\u001b[39m lists \u001b[38;2;177;185;249morm\u001b[39m as a map word.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m \u001b[38;2;177;185;249me2fc3de\u001b[39m on \u001b[38;2;177;185;249mart-standards\u001b[39m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m): \u001b[38;2;177;185;249mart-standards.md\u001b[39m, D-118 and D-119 in the decision ledger,\u001b[116Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gindex\u001b[15Grow.\r\u001b[1B\u001b[K\r\u001b[1B  The incremental \u001b[38;2;177;185;249mclang-debug\u001b[39m build\u001b[37Gin\u001b[40Glane\u001b[45GC\u001b[47Gpassed,\u001b[55Gas\u001b[58Gdid\u001b[62Gthe\u001b[66G\u001b[38;2;177;185;249mrender\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mresource\u001b[39m,\u001b[84G\u001b[38;2;177;185;249mapp\u001b[88G\u001b[39mand\u001b[92G\u001b[38;2;177;185;249msample-ground\u001b[106G\u001b[39msuites\u001b[113Gand\u001b[117Gthe\r\u001b[2C\u001b[1Bformat\u001b[10Gcheck.\u001b[17GLan\u001b[22GB\u001b[24Gwas\u001b[28Grunning\u001b[36Ga\u001b[38Ggate\u001b[43Gat\u001b[46Gthe\u001b[50Gtime,\u001b[56Gso\u001b[59GI\u001b[61Gdidn't\u001b[68Gstart\u001b[74Ga\u001b[76Gsecond\u001b[83Gone.\u001b[88GI\u001b[90Gdidn't\u001b[97Grun\u001b[101Gthe\u001b[105Greference\u001b[115Gframes\r\u001b[2C\u001b[1Bor\u001b[6Gsmoke test either; the gate covers those. Nothing is pushed or merged.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis is a good point to \u001b[38;2;177;185;249m/compact\u001b[39m, or start a fresh session for the merge.\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mTinkering…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
