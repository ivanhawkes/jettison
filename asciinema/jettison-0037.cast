[0.152, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mUV sets, which is the part to discuss.\u001b[42G\u001b[22mglTF\u001b[47Gallows\u001b[54Gany\u001b[58Gnumber\u001b[65Gof\u001b[68Gsets,\u001b[74Gbut\u001b[78Git\u001b[81Gdoesn't\u001b[89Gname\u001b[94Gthem.\u001b[100GThe\u001b[104Gdraft\u001b[110Gproposes:\r\u001b[2C\u001b[1B-\u001b[5GSet\u001b[9G0,\u001b[12G\u001b[38;2;177;185;249munique\u001b[39m,\u001b[20Gis\u001b[23Galways\u001b[30Gpresent\u001b[38Gand\u001b[42Gnon-overlapping;\u001b[59Git's\u001b[64Gwhat\u001b[69Gbakes\u001b[75Gand\u001b[79Gmasks\u001b[85Gread.\r\u001b[2C\u001b[1B- Each asset declares its sets by role\u001b[42Gin its c\u001b[51Gok\u001b[54Gsettings file, for example\u001b[81G\u001b[38;2;177;185;249muvSets: [unique, trim, detail, decal]\u001b[39m.\r\u001b[4C\u001b[1BMa\u001b[8Gerial slots\u001b[20Gpick a set by role (\u001b[38;2;177;185;249muv: trim\u001b[39m), so o\u001b[56Ge l\u001b[60Gbrary material\u001b[75Gworks on assets\u001b[91Gwhose\u001b[97Gsets\u001b[102Gdiffer\u001b[109Gin\u001b[112Gnumber\r\u001b[2C\u001b[1B \u001b[5Gand order.\u001b[16G\u001b[K\r\u001b[4C\u001b[1BAt most eigh\u001b[18G sets per mesh,\u001b[34Gbecause a material has eight textur\u001b[70G slots and\u001b[81Ga ninth \u001b[90Get could never b\u001b[107G read.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor the eng\u001b[15Gne,\u001b[19GI recommend \u001b[32Gaving th\u001b[42Gshaders fetch each se\u001b[64G from its own per-mesh buffer instead of\u001b[105Ga fixe\u001b[112G vertex\r\u001b[2C\u001b[1Blayout\u001b[10G(vertex\u001b[18Gpulling).\u001b[28GMesh\u001b[33Gshaders\u001b[41Gand\u001b[45Gray-traced\u001b[56Greflections\u001b[68Galready\u001b[76Gfetch\u001b[82Gvertices\u001b[91Gthis\u001b[96Gway,\u001b[101Gso\u001b[104Gone\u001b[108Gmethod\u001b[115Gcovers\r\u001b[2C\u001b[1Ball\u001b[9Gre\u001b[12G. Two alternatives\u001b[31Gare wri\u001b[39Gt\u001b[41Gn up as reje\u001b[54Gted: a\u001b[61Gfixed vertex\u001b[74Gwith the maxim\u001b[89Gm number of sets (wastes memory\r\u001b[2C\u001b[1Bon every vertex) and a shader\u001b[33Gvariant\u001b[41Gper\u001b[45Gset count (multipl\u001b[64Ges pipelines).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisions for you:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6GApprove\u001b[14Gthe\u001b[18GUV\u001b[21Gmethod.\u001b[29GJettison's\u001b[40Gscope\u001b[46Gcurrently\u001b[56Glists\u001b[62Gmultiple\u001b[71GUV\u001b[74Gsets\u001b[79Gas\u001b[82GDeferred.\r\u001b[2C\u001b[1B2. Which asset types\u001b[24Gneed\u001b[29Gsix\u001b[33Gsets?\u001b[39GThe\u001b[43Grole\u001b[48Gtable\u001b[54G(\u001b[38;2;177;185;249munique\u001b[39m,\u001b[63G\u001b[38;2;177;185;249mtrim\u001b[39m,\u001b[69G\u001b[38;2;177;185;249mtile\u001b[39m,\u001b[75G\u001b[38;2;177;185;249mdetail\u001b[39m,\u001b[83G\u001b[38;2;177;185;249mdecal\u001b[39m,\u001b[90G\u001b[38;2;177;185;249matlas\u001b[39m)\u001b[97Gis\u001b[100Gmy\u001b[103Gguess.\r\u001b[2C\u001b[1B3\u001b[6GShould the material library h\u001b[36Gld the look, with glTF material names\u001b[74Gonly\u001b[79Gpointing into\u001b[93Git?\u001b[97GThat\u001b[102Gneeds\u001b[108Gengine\u001b[115Gwork.\r\u001b[2C\u001b[1B4\u001b[6GHow the ar\u001b[18Gre\u001b[21Go\u001b[23Gitory\u001b[29Gis versioned (Git LFS, Perforce, a shared drive) is left open.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOnce thos\u001b[16Ge\u001b[18Gs\u001b[20Gttled, the Jettis\u001b[39G follow-ups ar\u001b[54G r\u001b[57Gadmap items for th\u001b[76G f\u001b[79Gve points at\u001b[92Gthe\u001b[96Gend\u001b[100Gof\u001b[103Gthe\u001b[107Gdoc.\u001b[112GThat\r\u001b[2C\u001b[1Bincludes\u001b[12Gpointing\u001b[21GJettison's\u001b[32Gcontent-file\u001b[45Grule\u001b[50Gat\u001b[53Gthis\u001b[58Gdoc\u001b[62Gand\u001b[66Gmoving\u001b[73Gits\u001b[77Gtest\u001b[82Gmaterials\u001b[92Ginto\u001b[97Gper-class\u001b[107Gfolders.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
