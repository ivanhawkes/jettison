6Gspace\u001b[62Gfrom\u001b[67Gthe\u001b[71Gmap\u001b[75Gword,\u001b[81G16-bit\u001b[88Gsources,\u001b[97Grefusing\u001b[106GglTF\u001b[111Gmaterial\r\u001b[2C\u001b[1B    extensions, and the \u001b[38;2;177;185;249mcollision-\u001b[39m and \u001b[38;2;177;185;249msocket-\u001b[39m nodes.\u001b[57GIt\u001b[60Galso\u001b[65Grenames\u001b[73G\u001b[38;2;177;185;249mmesh\u001b[39m's\u001b[80G\u001b[38;2;177;185;249mmetallicRoughness\u001b[98G\u001b[39mtexture\u001b[106Gslot\u001b[111Gto\u001b[114G\u001b[38;2;177;185;249morm\u001b[118G\u001b[39mand\r\u001b[2C\u001b[1B \u001b[5G  reads occlusion\u001b[23Gfrom its red channel,\u001b[45Grewriting\u001b[55Gevery\u001b[61Gexisting\u001b[70Gmaterial\u001b[79Gfile.\r\u001b[6C\u001b[1B\u001b[1mJ67:\u001b[22m Jettis\u001b[19Gn's test con\u001b[32Gent moves\u001b[42Gt\u001b[44G the standard's\u001b[60Glayout, and its\u001b[76Gcontent-file naming rule points to\u001b[111GManifest's\r\u001b[4C\u001b[1B \u001b[7Gstandard.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mJ12\u001b[11G\u001b[22m(collision mesh) now names \u001b[38;2;177;185;249mcollision-\u001b[39m n\u001b[51Gdes\u001b[55Gas\u001b[58Gthe author's collision mesh.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple\u001b[24GUV sets changes from Deferred to Open, u\u001b[65Gder J64.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[19G\u001b[22mthree settled\u001b[33Gdecisions\u001b[43Gunder\u001b[49GRendering:\u001b[60Gvertex\u001b[67Gpulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[4C\u001b[1Bthe\u001b[9Gstandards.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[26G\u001b[22ma new \"Art as\u001b[41Gt\u001b[43G\" ro\u001b[27;1H\u001b[24;3H\u001b[?25h"]
