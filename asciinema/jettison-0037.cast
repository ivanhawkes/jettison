[0.547, "o", "\u001b[?25l\u001b[H\u001b[5G \u001b[7Gextensions, and the\u001b[27G\u001b[38;2;177;185;249mcollision-\u001b[39m and\u001b[42G\u001b[38;2;177;185;249msocket-\u001b[39m nodes. It also renames \u001b[38;2;177;185;249mmesh\u001b[39m's \u001b[38;2;177;185;249mmetallicRoughness\u001b[39m texture\u001b[106Gs\u001b[108Got\u001b[111Gto \u001b[38;2;177;185;249morm\u001b[39m and\r\u001b[6C\u001b[1Breads occlusion\u001b[23Gfrom its red ch\u001b[40Gnel, rewriting every existi\u001b[68Gg material file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ67:\u001b[22m Jettison's\u001b[23Gtest\u001b[28Gcontent\u001b[36Gmoves to\u001b[45Gthe s\u001b[51Ga\u001b[53Gdard's layou\u001b[66G, and its content-file\u001b[89Gnaming\u001b[96Grule\u001b[101Gpoints\u001b[108Gto\u001b[111GManifest's\r\u001b[4C\u001b[1B \u001b[7Gstandard.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ12\u001b[22m (collision\u001b[22Gmesh)\u001b[28Gnow\u001b[32Gnames\u001b[38G\u001b[38;2;177;185;249mcollision-\u001b[49G\u001b[39mnodes\u001b[55Gas\u001b[58Gthe\u001b[62Gauthor's\u001b[71Gcollision\u001b[81Gmesh.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple UV sets\u001b[32Gchanges from Deferred to Open, \u001b[64Gnde\u001b[68G J64.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m thr\u001b[23Ge settled decisions und\u001b[47Gr Ren\u001b[53Gering: vertex pulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[2C\u001b[1B \u001b[5Gthe standards.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[26G\u001b[22ma\u001b[28Gnew\u001b[32G\"Art\u001b[37Gassets\"\u001b[45Grow\u001b[49Gin\u001b[52Gthe\u001b[56Gcapability\u001b[67Gmap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[12G\u001b[22m(\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[30Gbranch\u001b[37G\u001b[38;2;177;185;249mart-standards\u001b[39m):\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mart-standards.md\u001b[39m:\u001b[22m marked\u001b[30Gas settled.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- The art repository is Git\u001b[33Gwi\u001b[36Gh LFS\u001b[42Gfor\u001b[46Gbinary\u001b[53Gfiles;\u001b[60G\u001b[38;2;177;185;249m.gltf\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249m.yaml\u001b[76G\u001b[39mstay\u001b[81Gplain\u001b[87Gtext\u001b[92Gso\u001b[95Gchanges\u001b[103Gdiff.\r\u001b[10C\u001b[1BUV role table is the default for typ\u001b[48Gc\u001b[50Gl asset\u001b[58G,\u001b[60Gto be\u001b[66Grefined once \u001b[80Gou know which classes need six\u001b[111Gsets.\r\u001b[10C\u001b[1Bvertex-pulling design itse\u001b[38Gf\u001b[40Gn\u001b[42Gw\u001b[44Glives only in J64;\u001b[63Gthe Manifest doc lin\u001b[84Gs to it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDecision ledger:\u001b[22m a new \"Art\u001b[33Gs\u001b[35Gandards\"\u001b[44Ggroup\u001b[50Gwith\u001b[55GD-118 (Manifest d\u001b[73Gfines the standards)\u001b[94Gand\u001b[98GD-119\u001b[104G(the\u001b[109Gart\r\u001b[2C\u001b[1B \u001b[5Grepository on Git LFS).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBoth\u001b[8Glanes\u001b[14Ghave\u001b[19Ga\u001b[21Gnote\u001b[26Gso\u001b[29Gthe\u001b[33Gother\u001b[39Gsession\u001b[47Gsees\u001b[52Gthey're\u001b[60Gtaken.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BRenaming\u001b[12Gthe\u001b[16G\u001b[38;2;177;185;249mmetallicRoughness\u001b[34G\u001b[39mslot\u001b[39Gto\u001b[42G\u001b[38;2;177;185;249morm\u001b[46G\u001b[39min\u001b[49GJ66\u001b[53Gis\u001b[56Gmy\u001b[59Gaddition,\u001b[69Gnot\u001b[73Gsomething\u001b[83Gyou\u001b[87Gasked\u001b[93Gfor.\u001b[98GI\u001b[100Gadded\u001b[106Git\u001b[109Gso\u001b[112Gthe\u001b[116Gslot\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.367, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7G\u001b[1mJ12\u001b[22m (collisio\u001b[21G mesh) now names\u001b[38G\u001b[38;2;177;185;249mcollision-\u001b[39m nodes as \u001b[59Ghe author's collision mesh.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m mult\u001b[20Gple UV se\u001b[32Gchanges from\u001b[45GD\u001b[47Gferred to Open, under J64.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m three \u001b[26Gettled decisions under\u001b[49GRendering:\u001b[60Gvertex pulling,\u001b[76Gthe ma\u001b[83Ger\u001b[86Gal\u001b[89Glibrary, and Ma\u001b[105Gifest\u001b[111Gdef\u001b[115Gning\u001b[K\r\u001b[4C\u001b[1Bthe standards.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[22m a\u001b[29Ge\u001b[32G\"Art assets\" row\u001b[49Gin the capabili\u001b[65Gy map.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mart-standards\u001b[39m):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mart-standards.md\u001b[39m:\u001b[23G\u001b[22mmarked\u001b[30Gas\u001b[33Gsettled.\r\u001b[2C\u001b[1B \u001b[5G- The art repository\u001b[26Gis Git wi\u001b[36Gh LFS for binary files; \u001b[38;2;177;185;249m.gltf\u001b[39m and \u001b[38;2;177;185;249m.yaml\u001b[76G\u001b[39mstay\u001b[81Gplain\u001b[87Gtext\u001b[92Gso\u001b[95Gchanges\u001b[103Gdiff.\r\u001b[4C\u001b[1B-\u001b[7GThe\u001b[11GUV\u001b[14Grole\u001b[19Gtable\u001b[25Gis\u001b[28Gthe\u001b[32Gdefault\u001b[40Gfor\u001b[44Gtypical\u001b[52Gassets,\u001b[60Gto\u001b[63Gbe\u001b[66Grefined\u001b[74Gonce\u001b[79Gyou\u001b[83Gknow\u001b[88Gwhich\u001b[94Gclasses\u001b[102Gneed\u001b[107Gsix\u001b[111Gsets.\r\u001b[2C\u001b[1B  - The vertex-pulling design itself now lives only\u001b[55Gin\u001b[58GJ64;\u001b[63Gthe\u001b[67GManifest\