[0.314, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor\u001b[7Gthe\u001b[11Gengine,\u001b[19GI\u001b[21Grecommend\u001b[31Ghaving\u001b[38Gthe\u001b[42Gshaders\u001b[50Gfetch\u001b[56Geach\u001b[61Gset\u001b[65Gfrom\u001b[70Gits\u001b[74Gown\u001b[78Gper-mesh\u001b[87Gbuffer\u001b[94Ginstead\u001b[102Gof\u001b[105Ga\u001b[107Gfixed\u001b[113Gvertex\r\u001b[2C\u001b[1Blayout (vertex pulling). Mes\u001b[32G shaders and ray-traced\u001b[56Greflections already fetch v\u001b[84Grtices this way, s\u001b[103G one method covers\r\u001b[2C\u001b[1Ball three. Two\u001b[18Galter\u001b[24Gatives are written up \u001b[47Gs rejected: a fixed vert\u001b[72Gx with t\u001b[81Ge max\u001b[87Gmum\u001b[91Gnumber of\u001b[102Gets (was\u001b[111Ges memory\u001b[K\r\u001b[2C\u001b[1Bon eve\u001b[10Gy vertex) and \u001b[25G shader varian\u001b[40G per set\u001b[49Gcount (multipli\u001b[65Gs\u001b[67Gpipelines).\u001b[79G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDecisions for you:\r\u001b[2C\u001b[1B\u001b[22m1. Approve the UV method.\u001b[29GJettison's\u001b[40Gscope\u001b[46Gcurrently\u001b[56Glists\u001b[62Gmultiple\u001b[71GUV\u001b[74Gsets\u001b[79Gas\u001b[82GDeferred.\r\u001b[2C\u001b[1B2\u001b[6GWhich asset\u001b[18Gtypes need\u001b[29Gsix sets? The role table (\u001b[38;2;177;185;249munique\u001b[39m, \u001b[38;2;177;185;249mtrim\u001b[39m, \u001b[38;2;177;185;249mtile\u001b[39m, \u001b[38;2;177;185;249mdetail\u001b[39m, \u001b[38;2;177;185;249mdecal\u001b[39m, \u001b[38;2;177;185;249matlas\u001b[39m)\u001b[97Gis\u001b[100Gmy\u001b[103Gguess.\r\u001b[2C\u001b[1B3\u001b[6GS\u001b[8Gould th\u001b[16G material library hold\u001b[39Gt\u001b[43Gl\u001b[45Gok, with\u001b[54GglTF material names only pointing into it?\u001b[97GThat need\u001b[107G engine\u001b[115Gwork.\r\u001b[2C\u001b[1B4\u001b[6GHow the art repository is versioned (Git LFS, Perforce, a shared drive) is left ope\u001b[90G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOnce\u001b[8Gthose\u001b[14Gare\u001b[18Gsettled,\u001b[27Gthe\u001b[31GJettison\u001b[40Gfollow-ups\u001b[51Gare\u001b[55Groadmap\u001b[63Gitems\u001b[69Gfor\u001b[73Gthe\u001b[77Gfive\u001b[82Gpoints\u001b[89Gat\u001b[92Gthe\u001b[96Gend\u001b[100Gof\u001b[103Gthe\u001b[107Gdoc.\u001b[112GThat\r\u001b[2C\u001b[1Bi\u001b[6Gludes pointing Jettison's content-\u001b[41Gi\u001b[43Ge rule at this \u001b[59Goc and \u001b[67Goving\u001b[73Gits\u001b[77Gtest\u001b[82Gmaterials\u001b[92Ginto per-class\u001b[107Gf\u001b[109Glders.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gdidn't\u001b[12Grun\u001b[16Ga\u001b[18Gweb\u001b[22Gsearch;\u001b[30Gthe\u001b[34Gindustry\u001b[43Gpractice\u001b[52Gcomes\u001b[58Gfrom\u001b[63Gwhat\u001b[68GI\u001b[70Galready\u001b[78Gknow,\u001b[84Gnot\u001b[88Gfrom\u001b[93Gsources\u001b[101Gchecked\u001b[109Gtoday.\r\u001b[2C\u001b[1BSeveral rules (UV roles, collis\u001b[35Gon and socke\u001b[76Gour space from the map name) are\u001b[109Gmarked\u001b[27;1H\u001b[24;13H\u001b[?25h"]
