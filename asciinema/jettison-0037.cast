u001b[106Gs\u001b[108Got\u001b[111Gto \u001b[38;2;177;185;249morm\u001b[39m and\r\u001b[6C\u001b[1Breads occlusion\u001b[23Gfrom its red ch\u001b[40Gnel, rewriting every existi\u001b[68Gg material file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ67:\u001b[22m Jettison's\u001b[23Gtest\u001b[28Gcontent\u001b[36Gmoves to\u001b[45Gthe s\u001b[51Ga\u001b[53Gdard's layou\u001b[66G, and its content-file\u001b[89Gnaming\u001b[96Grule\u001b[101Gpoints\u001b[108Gto\u001b[111GManifest's\r\u001b[4C\u001b[1B \u001b[7Gstandard.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ12\u001b[22m (collision\u001b[22Gmesh)\u001b[28Gnow\u001b[32Gnames\u001b[38G\u001b[38;2;177;185;249mcollision-\u001b[49G\u001b[39mnodes\u001b[55Gas\u001b[58Gthe\u001b[62Gauthor's\u001b[71Gcollision\u001b[81Gmesh.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple UV sets\u001b[32Gchanges from Deferred to Open, \u001b[64Gnde\u001b[68G J64.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m thr\u001b[23Ge settled decisions und\u001b[47Gr Ren\u001b[53Gering: vertex pulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[2C\u001b[1B \u001b[5Gthe standards.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[26G\u001b[22ma\u001b[28Gnew\u001b[32G\"Art\u001b[37Gassets\"\u001b[45Grow\u001b[49Gin\u001b[52Gthe\u001b[56Gcapability\u001b[67Gmap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[12G\u001b[22m(\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[30Gbranch\u001b[37G\u001b[38;2;177;185;249mart-standa\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
