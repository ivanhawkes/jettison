[0.464, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAd\u001b[9Ged \u001b[1m1\u001b[22m line,\u001b[20Gremoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 148 \u001b[22m - **Blend shap\u001b[27Gs** \u001b[32Gre exported with the\u001b[53Gr normals.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[2m 149 \u001b[22m - **Vert\u001b[21Gx colours** are linear data wi\u001b[52Gh a meaning the materi\u001b[75Gl gives (a mask),\u001b[93Gn\u001b[95Gt\u001b[97Glighting.\u001b[107G\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 150 \u001b[12G\u001b[22m- **N\u001b[19Galpha-\u001b[26Gested aggregates**\u001b[45G(foliage,\u001b[55Gchain-link\u001b[66Gfences):\u001b[75Ghair\u001b[80Gcards\u001b[86Gare\u001b[90Gthe\u001b[94Gonly\u001b[99Galpha-tested\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 151 -\u001b[38;2;248;248;242m  geometry ([J59](../../jettison/docs/\u001b[48;2;92;2;0mroadmap\u001b[48;2;61;1;0m.md#j59)).                                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 151 +\u001b[38;2;248;248;242m  geometry ([\u001b[38;2;230;219;116mJ59\u001b[38;2;248;248;242m](../../jettison/docs/\u001b[48;2;4;71;0mcharacters\u001b[48;2;2;40;0m.md#j59\u001b[48;2;4;71;0m-hair-cards-and-alpha-tested-materials\u001b[48;2;2;40;0m)).      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m \u001b[5G \u001b[2m 152 \u001b[22m\u001b[K\r\u001b[4C\u001b[1B \u001b[2m 153 \u001b[22m ## Materials\u001b[K\r\u001b[4C\u001b[1B \u001b[2m 154 \u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI'\u001b[6Ge drafted the standard in Manifest, where you said it should be defined: \u001b[38;2;177;185;249m../manifest.lane-b/docs/art-standards.md\u001b[39m,\r\u001b[2C\u001b[1Babout 290 lines,\u001b[20Gon a new b\u001b[31Ganch \u001b[38;2;177;185;249mart-standards\u001b[39m, with a new row in \u001b[38;2;177;185;249mdocs/README.md\u001b[39m. Nothing is committed, and I've left\r\u001b[2C\u001b[1Ba\u001b[5Glane note so\u001b[18Gth\u001b[22Gother session sees\u001b[41Glane\u001b[46GB is taken.\u001b[58GJettison's docs\u001b[74Gare\u001b[78Gunchanged;\u001b[89Gthe\u001b[93Gdoc\u001b[97Gends\u001b[102Gwith\u001b[107Ga\u001b[109Glist\u001b[114Gof\u001b[117Gwhat\r\u001b[2C\u001b[1BJettison has to build to\u001b[28Gsupport it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it covers:\u001b[19G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo trees:\u001b[22m a work tree for \u001b[38;2;177;185;249m.blend\u001b[39m and Subs\u001b[48Gance files,\u001b[60Gand a source tree that\u001b[83Gholds only exports.\u001b[103GThey have to be\r\u001b[4C\u001b[1Bsepara\u001b[12Ge because the cook\u001b[31Gcopies\u001b[38Gthrough\u001b[46Gany\u001b[50Gfile\u001b[55Git\u001b[58Gdoesn't\u001b[66Grecognise,\u001b[77Gso\u001b[80Ga\u001b[82G\u001b[38;2;177;185;249m.blend\u001b[89G\u001b[39mleft\u001b[94Gin\u001b[97Gthe\u001b[101Gsource\u001b[108Gtree\u001b[113Gwould\r\u001b[2C\u001b[1B \u001b[5Gship. The cooked output mirrors the\u001b[41Gsource tree into\u001b[58G\u001b[38;2;177;185;249mmods/manifest/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames:\u001b[22m k\u001b[14Gbab-case everywh\u001b[31Gre, which the\u001b[46Go\u001b[76Gme\u001b[80Grun general to specifi\u001b[103G with a letter for\u001b[27;1H\u001b[24;3H\u001b[?25h"]
