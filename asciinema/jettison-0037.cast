[0.101, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m4\u001b[31G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[2m 599 \u001b[22m -\u001b[14G**Map words.**\u001b[29GA tex\u001b[35Gure'\u001b[40G col\u001b[45Gur space from i\u001b[61Gs map\u001b[67Gword\u001b[72G(`color`\u001b[81Gand\u001b[85G`emissive`\u001b[96GsRGB,\u001b[102Gthe\u001b[106Grest\r\u001b[5C\u001b[1B\u001b[2m 600 \u001b[14G\u001b[22mlinear),\u001b[23Gnot\u001b[27Gfrom\u001b[32Ga\u001b[34G`.linear.png`\u001b[48Gname;\u001b[54Ga\u001b[56Gmap\u001b[60Gword\u001b[65Gthe\u001b[69Gstandard\u001b[78Glacks\u001b[84Gis\u001b[87Grefused,\u001b[96Gnaming\u001b[103Gthe\u001b[107Gfile.\r\u001b[2C\u001b[1B   \u001b[2m 601 \u001b[12G\u001b[22m  16-bit PNG sources for `normal`\u001b[46Ga\u001b[48Gd `he\u001b[54Gght`.\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 602 -\u001b[38;2;248;248;242m- **`orm`.** `mesh`'s `metallicRoughness` texture slot renamed `orm`, its red channel read as         \u001b[115G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 603 -\u001b[38;2;248;248;242m  occlusion, beneath ray-traced and screen-space occlusion; every material file rewritten in the      \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 604 -\u001b[38;2;248;248;242m  same commit ([formats in place](decisions.md#persistence)). A `mask` slot for programs that take    \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 605 -\u001b[38;2;248;248;242m  one.                                                                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 602 +\u001b[38;2;248;248;242m- **`orm`.** The `orm` slot's red channel read as occlusion in `mesh`, beneath ray-traced and         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 603 +\u001b[38;2;248;248;242m  screen-space occlusion (the slot was renamed from `metallicRoughness` on 2026-11-27). A `mask`      \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 604 +\u001b[38;2;248;248;242m  slot for programs that take one.                                                                    \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 605 \u001b[22m - **Material extensions.** A glTF source using a material extension\u001b[80Gis\u001b[83Grefused,\u001b[92Gnaming\u001b[99Git.\r\u001b[5C\u001b[1B\u001b[2m 606 \u001b[12G\u001b[22m-\u001b[14G**Role\u001b[21Gnodes.**\u001b[30G`collision-`\u001b[43Gnodes\u001b[49Gkept\u001b[54Gout\u001b[58Gof\u001b[61Gthe\u001b[65Gdrawn\u001b[71Gmesh\u001b[76Gand\u001b[80Ghanded\u001b[87Gto\u001b[90G[\u001b[38;2;230;219;116mJ12\u001b[39m](#j12)'s\r\u001b[1B     \u001b[2m 607 \u001b[22m   collision file; `socket-` nodes kept in the cooked GLB, their transforms found by name on the\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunn\u001b[11G\u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ cd '..\u001b[15Gjettison.lane-c' && git diff --stat\u001b[39m\u001b[K\r\u001b[14C\u001b[2B\u001b[38;2;153;153;153m42s · ↓\u001b[39m \u001b[38;2;153;153;153m3.9k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
