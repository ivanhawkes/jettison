neral\u001b[92Gto\u001b[95Gspecific\u001b[104Gwith\u001b[109Ga\u001b[111Gletter\u001b[118Gfor\r\u001b[2C\u001b[1B \u001b[5Gvariants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), kit pi\u001b[33Gces carry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m), and textures follow\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<asset>-<map>\u001b[39m. The map words (\u001b[38;2;177;185;249mcolor\u001b[39m, \u001b[38;2;177;185;249mnormal\u001b[39m, \u001b[38;2;177;185;249morm\u001b[39m, \u001b[38;2;177;185;249memissive\u001b[39m, \u001b[38;2;177;185;249mheight\u001b[39m, \u001b[38;2;177;185;249mmask\u001b[39m) decide each tex\u001b[95Gure's col\u001b[105Gur space.\u001b[115GFace\r\u001b[4C\u001b[1Bblend shapes are the one exception: they use\u001b[50GARKit's names exactly.\u001b[73G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and axes:\u001b[22m 1 unit =\u001b[30G1 m, +Y up, nose along −Z (+Y in Blender),\u001b[73Gtransforms\u001b[84Gapplied\u001b[92Gbefore\u001b[99Gexport.\r\u001b[4C\u001b[1B\u001b[1mGeom\u001b[10Gtry for meshlets and ray tracing:\u001b[22m mode\u001b[49G real bevels rather than b\u001b[76Gking them, becaus\u001b[94G ray-traced shadows\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Gocclusion see only geometry. No hand-made levels of d\u001b[59Gtail or shadow\u001b[74Gproxies. Triangulat\u001b[95Gbefore baking and let the\r\u001b[4C\u001b[1Bcook make\u001b[15Gth\u001b[19Gtangents. Shadow-casting parts should\u001b[57Gb\u001b[59G closed, an\u001b[71G kit pieces\u001b[83Goverlap slightly at jo\u001b[107Gs\u001b[109Gso light\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gesn't leak through.  \u001b[29G              \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.081, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gdrafted\u001b[16Gthe\u001b[20Gstandard\u001b[29Gin\u001b[32GManifest,\u001b[42Gwhere\u001b[48Gyou\u001b[52Gsaid\u001b[57Git\u001b[60Gshould\u001b[67Gbe\u001b[70Gdefined:\u001b[79G\u001b[38;2;177;185;249m../manifest.lane-b/docs/art-standards.md\u001b[39m,\r\u001b[1B \u001b[3Gabout 290 lines,\u001b[20Gon a new\u001b[29Gbranch \u001b[38;2;177;185;249mart-standards\u001b[39m, with a new row in \u001b[38;2;177;185;249mdocs/README\u001b[81Gmd\u001b[39m. Nothing is committed, and I've left\r\u001b[3C\u001b[1B lane note so the other session\u001b[36Gsees lane B is\u001b[51Gtaken.\u001b[58GJ\u001b[60Gttison's\u001b[69Gdocs are unchanged; the\u001b[93Gdoc ends with\u001b[108G list of what\r\u001b[2C\u001b[1BJettiso\u001b[11G has to build to\u001b[29Gupport\u001b[36Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it covers:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mTwo \u001b[10Grees:\u001b[22m a work\u001b[23Gtree\u001b[28Gfor\u001b[32G\u001b[38;2;177;185;249m.blend\u001b[39G\u001b[39mand\u001b[43GSubstance\u001b[53Gfiles,\u001b[60Gand\u001b[64Ga\u001b[66Gsource\u001b[73Gtree\u001b[78Gthat\u001b[83Gholds\u001b[89Gonly\u001b[94Gexports.\u001b[103GThey\u001b[108Ghave\u001b[113Gto\u001b[116Gbe\r\u001b[2C\u001b[1B \u001b[5Gseparate because the cook copies through any file it doesn't\u001b[66Grecognise, so \u001b[81G \u001b[38;2;177;185;249m.blend\u001b[89G\u001b[39mleft\u001b[94Gin the source\u001b[108Gtre\u001b[113Gw\u001b[115Guld\r\u001b[5C\u001b[1Bhip. The cooked\u001b[22Goutput mirrors the source tree into\u001b[58G\u001b[38;2;177;185;249mmods/manifest/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames:\u001b[22m k\u001b[14Gbab-case everywhe\u001b[32Ge, which\u001b[41Gthe \u001b[46Gook already\u001b[58Genforces. Asset\u001b[74Gnames\u001b[80Grun\u001b[84Ggeneral\u001b[92Gto\u001b[95Gspecific\u001b[104Gwith\u001b[109Ga\u001b[111Gletter\u001b[118Gfor\r\u001b[2C\u001b[1B \u001b[5Gvariants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), kit pi\u001b[33Gces carry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m), and textures follow\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<asset>-<map>\u001b[39m. The map words (\u001b[38;2;177;185;249mcolor\u001b[39m, \u001b[38;2;177;185;249mnormal\u001b[39m, \u001b[38;2;177;185;249morm\u001b[39m, \u001b[38;2;177;185;249memissive\u001b[39m, \u001b[38;2;177;185;249mheight\u001b[39m, \u001b[38;2;177;185;249mmask\u001b[39m) decide each tex\u001b[95Gure's col\u001b[105Gur space.\u001b[115GFace\r\u001b[4C\u001b[1Bblend shapes are the one exception: they use\u001b[50GARKit's names exactly.\u001b[73G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and axes:\u001b[22m 1 unit =\u001b[30G1 m, +Y up, nose along −Z (+Y in Blender),\u001b[73Gtransforms\u001b[84Gapplied\u001b[92Gbefore\u001b[99Gexport.\r\u001b[4C\u001b[1B\u001b[1mGeom\u001b[10Gtry for meshlets and ray tracing:\u001b[22m mode\u001b[49G real bevels rather than b\u001b[76Gking them, becaus\u001b[94G ray-traced shadows\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Gocclusion see only geometry. No hand-made levels of d\u001b[59Gtail or shadow\u001b[74Gproxies. Triangulat\u001b[95Gbefore baking and let the\r\u001b[4C\u001b[1Bcook make\u001b[15Gth\u001b[19Gtangents. Shadow-casting parts should\u001b[57Gb\u001b[59G closed, an\u001b[71G kit pieces\u001b[83Goverlap slightly at jo\u001b[107Gs\u001b[109Gso light\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gesn't leak through.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMaterials:\u001b[22m me\u001b[19Gallic-roughness\u001b[35Gonly.\u001b[41GThe\u001b[45Ggl\u001b[76Gial\u001b[80Gnames,\u001b[87Gand\u001b[91Ga\u001b[93Glibrary\u001b[101Gof\u001b[104Gmaterial\u001b[113Gfiles\u001b[27;1H\u001b[24;3H\u001b[?25h"]
