[2.751, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G  can't find or finds twice. This r\u001b[41Gplaces J27's row for reading a\u001b[72Gmodel's\u001b[80Gown\u001b[84Gmaterial\u001b[93Gvalues,\u001b[101Gwhich\u001b[107GI\u001b[109Gremoved.\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ66:\u001b[12G\u001b[22mthe\u001b[16Gcook\u001b[21Greads\u001b[27Gthe\u001b[31Gstandard's\u001b[42Gnames:\u001b[49Gcolour\u001b[56Gspace\u001b[62Gfrom\u001b[67Gthe\u001b[71Gmap\u001b[75Gword,\u001b[81G16-bit\u001b[88Gsources,\u001b[97Grefusing\u001b[106GglTF\u001b[111Gmaterial\r\u001b[2C\u001b[1B    extensions, and the \u001b[38;2;177;185;249mcollision-\u001b[39m and \u001b[38;2;177;185;249msocket-\u001b[39m nodes.\u001b[57GIt\u001b[60Galso\u001b[65Grenames\u001b[73G\u001b[38;2;177;185;249mmesh\u001b[39m's\u001b[80G\u001b[38;2;177;185;249mmetallicRoughness\u001b[98G\u001b[39mtexture\u001b[106Gslot\u001b[111Gto\u001b[114G\u001b[38;2;177;185;249morm\u001b[118G\u001b[39mand\r\u001b[2C\u001b[1B \u001b[5G  reads occlusion\u001b[23Gfrom its red channel,\u001b[45Grewriting\u001b[55Gevery\u001b[61Gexisting\u001b[70Gmaterial\u001b[79Gfile.\r\u001b[6C\u001b[1B\u001b[1mJ67:\u001b[22m Jettis\u001b[19Gn's test con\u001b[32Gent moves\u001b[42Gt\u001b[44G the standard's\u001b[60Glayout, and its\u001b[76Gcontent-file naming rule points to\u001b[111GManifest's\r\u001b[4C\u001b[1B \u001b[7Gstandard.\u001b[K\r\u001b[6C\u001b[1B\u001b[1mJ12\u001b[11G\u001b[22m(collision mesh) now names \u001b[38;2;177;185;249mcollision-\u001b[39m n\u001b[51Gdes\u001b[55Gas\u001b[58Gthe author's collision mesh.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple\u001b[24GUV sets changes from Deferred to Open, u\u001b[65Gder J64.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[19G\u001b[22mthree settled\u001b[33Gdecisions\u001b[43Gunder\u001b[49GRendering:\u001b[60Gvertex\u001b[67Gpulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[4C\u001b[1Bthe\u001b[9Gstandards.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[26G\u001b[22ma new \"Art as\u001b[41Gt\u001b[43G\" row in\u001b[55G capability\u001b[67Gmap.\r\u001b[2C\u001b[2B\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m, branch \u001b[38;2;177;185;249mart-standards\u001b[39m):\u001b[53G\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mart-standards.md\u001b[39m:\u001b[22m marked as settled.\u001b[K\r\u001b[2C\u001b[1B  - The art repository\u001b[26Gis\u001b[29GGit\u001b[33Gwith\u001b[38GLFS\u001b[42Gfor\u001b[46Gbinary\u001b[53Gfiles;\u001b[60G\u001b[38;2;177;185;249m.gltf\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249m.yaml\u001b[76G\u001b[39mstay\u001b[81Gplain\u001b[87Gtext\u001b[92Gso\u001b[95Gchanges\u001b[103Gdiff.\r\u001b[4C\u001b[1B-\u001b[7GThe\u001b[11GUV\u001b[14Grole\u001b[19Gtable\u001b[25Gis\u001b[28Gthe\u001b[32Gdefault\u001b[40Gfor\u001b[44Gtypical\u001b[52Gassets,\u001b[60Gto\u001b[63Gbe\u001b[66Grefined\u001b[74Gonce\u001b[79Gyou\u001b[83Gknow\u001b[88Gwhich\u001b[94Gclasses\u001b[102Gneed\u001b[107Gsix\u001b[111Gsets.\r\u001b[1B \u001b[3G  - The vertex-pulling design itself\u001b[40Gnow\u001b[44Glives\u001b[50Gonly\u001b[55Gin\u001b[58GJ64;\u001b[63Gthe\u001b[67GManifest\u001b[76Gdoc\u001b[80Glinks\u001b[86Gto\u001b[89Git.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDecision ledger:\u001b[22G\u001b[22ma\u001b[24Gnew\u001b[28G\"Art\u001b[33Gstandards\"\u001b[44Ggroup\u001b[50Gwith\u001b[55GD-118\u001b[61G(Manifest\u001b[71Gdefines\u001b[79Gthe\u001b[83Gstandards)\u001b[94Gand\u001b[98GD-119\u001b[104G(the\u001b[109Gart\r\u001b[1B \u001b[3G  repository on Git LFS).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BBoth lanes have a note so the other session sees they're taken.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
