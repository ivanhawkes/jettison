lready\u001b[58Genforces. Asset\u001b[74Gnames\u001b[80Grun\u001b[84Ggeneral\u001b[92Gto\u001b[95Gspecific\u001b[104Gwith\u001b[109Ga\u001b[111Gletter\u001b[118Gfor\r\u001b[2C\u001b[1B \u001b[5Gvariants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), kit pi\u001b[33Gces carry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m), and textures follow\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<asset>-<map>\u001b[39m. The map words (\u001b[38;2;177;185;249mcolor\u001b[39m, \u001b[38;2;177;185;249mnormal\u001b[39m, \u001b[38;2;177;185;249morm\u001b[39m, \u001b[38;2;177;185;249memissive\u001b[39m, \u001b[38;2;177;185;249mheight\u001b[39m, \u001b[38;2;177;185;249mmask\u001b[39m) decide each tex\u001b[95Gure's col\u001b[105Gur space.\u001b[115GFace\r\u001b[4C\u001b[1Bblend shapes are the one exception: they use\u001b[50GARKit's names exactly.\u001b[73G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and axes:\u001b[22m 1 unit =\u001b[30G1 m, +Y up, nose along −Z (+Y in Blender),\u001b[73Gtransforms\u001b[84Gapplied\u001b[92Gbefore\u001b[99Gexport.\r\u001b[4C\u001b[1B\u001b[1mGeom\u001b[10Gtry for meshlets and ray tracing:\u001b[22m mode\u001b[49G real bevels rather than b\u001b[76Gking them, becaus\u001b[94G ray-traced shadows\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Gocclusion see only geometry. No hand-made levels of d\u001b[59Gtail or shadow\u001b[74Gproxies. Triangulat\u001b[95Gbefore baking and let the\r\u001b[4C\u001b[1Bcook make\u001b[15Gth\u001b[19Gtangents. Shadow-casting par\u001b[76Gpieces\u001b[83Goverlap slightly at jo\u001b[107Gs\u001b[109Gso light\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
