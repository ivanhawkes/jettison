[0.048, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mTwo \u001b[10Grees:\u001b[22m a work\u001b[23Gtree\u001b[28Gfor\u001b[32G\u001b[38;2;177;185;249m.blend\u001b[39G\u001b[39mand\u001b[43GSubstance\u001b[53Gfiles,\u001b[60Gand\u001b[64Ga\u001b[66Gsource\u001b[73Gtree\u001b[78Gthat\u001b[83Gholds\u001b[89Gonly\u001b[94Gexports.\u001b[103GThey\u001b[108Ghave\u001b[113Gto\u001b[116Gbe\r\u001b[2C\u001b[1B \u001b[5Gseparate because the cook copies through any file it doesn't\u001b[66Grecognise, so \u001b[81G \u001b[38;2;177;185;249m.blend\u001b[89G\u001b[39mleft\u001b[94Gin the source\u001b[108Gtre\u001b[113Gw\u001b[115Guld\r\u001b[5C\u001b[1Bhip. The cooked\u001b[22Goutput mirrors the source tree into\u001b[58G\u001b[38;2;177;185;249mmods/manifest/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames:\u001b[22m k\u001b[14Gbab-case everywhe\u001b[32Ge, which\u001b[41Gthe \u001b[46Gook already\u001b[58Genforces. Asset\u001b[74Gnames\u001b[80Grun\u001b[84Ggeneral\u001b[92Gto\u001b[95Gspecific\u001b[104Gwith\u001b[109Ga\u001b[111Gletter\u001b[118Gfor\r\u001b[2C\u001b[1B \u001b[5Gvariants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), kit pi\u001b[33Gces carry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m), and textures follow\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m<asset>-<map>\u001b[39m. The map words (\u001b[38;2;177;185;249mcolor\u001b[39m, \u001b[38;2;177;185;249mnormal\u001b[39m, \u001b[38;2;177;185;249morm\u001b[39m, \u001b[38;2;177;185;249memissive\u001b[39m, \u001b[38;2;177;185;249mheight\u001b[39m, \u001b[38;2;177;185;249mmask\u001b[39m) decide each tex\u001b[95Gure's col\u001b[105Gur space.\u001b[115GFace\r\u001b[4C\u001b[1Bblend shapes are the one exception: they use\u001b[50GARKit's names exactly.\u001b[73G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and axes:\u001b[22m 1 unit =\u001b[30G1 m, +Y up, nose along −Z (+Y in Blender),\u001b[73Gtransforms\u001b[84Gapplied\u001b[92Gbefore\u001b[99Gexport.\r