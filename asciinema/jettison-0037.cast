[0.445, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, listed \u001b[1m2\u001b[22m directories, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GJettison\u001b[16Groadmap\u001b[24Gnow\u001b[28Ghas\u001b[32GJ64–J67,\u001b[41Gand\u001b[45Gthe\u001b[49GManifest\u001b[58Gart\u001b[62Gstandards\u001b[72Greflect\u001b[80Gyour\u001b[85Gfour\u001b[90Ganswers.\u001b[99GAll\u001b[103Gof\u001b[106Git\u001b[109Gis\u001b[112Gdocs\u001b[117Gonly\r\u001b[1B \u001b[3Gand\u001b[7Guncommitted, on new br\u001b[30Gnches in two free lanes. I didn't run a gat\u001b[74G since nothing is code; there's\u001b[106Gno\u001b[109Glink\u001b[K\r\u001b[2C\u001b[1Bchecker in either repo,\u001b[27Gso I checked the anchors by\u001b[55Ghand.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mJettison\u001b[12G\u001b[22m(\u001b[38;2;177;185;249mjettison.lane-c\u001b[39m,\u001b[30Gbranch\u001b[37G\u001b[38;2;177;185;249mart-standards-support\u001b[39m):\r\u001b[2C\u001b[1B- \u001b[1mRoadmap:\u001b[22m a new track, \"The \u001b[33Grt standards' support\". Each\u001b[62Gitem\u001b[67Gneeds\u001b[73Gthe\u001b[77Gcook\u001b[82G(J37)\u001b[88Gand\u001b[92Gis\u001b[95Gleft\u001b[100Gfor\u001b[104Gyou\u001b[108Gto\u001b[111Gschedule.\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mJ64:\u001b[22m UV sets\u001b[20Gby role, f\u001b[31Gtched by ve\u001b[43Gtex\u001b[47Gp\u001b[49Glling, at most \u001b[65Gight per m\u001b[76Gsh, plus vertex\u001b[92Gcolour sets\u001b[104Gthe\u001b[108Gsame way.\u001b[K\r\u001b[8C\u001b[1B\u001b[1m5\u001b[12G\u001b[22mthe material \u001b[26Gibrary. The cook r\u001b[45Gsolves a glTF\u001b[60Gaterial's\u001b[70Gname to its material file and refuses\u001b[108Gn\u001b[112Gs it\u001b[K\r\u001b[4C\u001b[1B \u001b[7Gcan't find or finds twice\u001b[36Gis replaces J27's\u001b[54Grow for reading\u001b[70Ga \u001b[73Godel's own material values, which I removed.\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ66:\u001b[22m the co\u001b[19Gk\u001b[21Grea\u001b[28Ghe standard's n\u001b[44Gm\u001b[47G: colou\u001b[55G space\u001b[62Gfrom the map word, 16-bi\u001b[87G sources, refusing glTF \u001b[112Gat\u001b[115Grial\r\u001b[4C\u001b[1B \u001b[7Gextensions, and the\u001b[27G\u001b[38;2;177;185;249mcollision-\u001b[39m and\u001b[42G\u001b[38;2;177;185;249msocket-\u001b[39m nodes. It also renames \u001b[38;2;177;185;249mmesh\u001b[39m's \u001b[38;2;177;185;249mmetallicRoughness\u001b[39m texture\u001b[106Gs\u001b[108Got\u001b[111Gto \u001b[38;2;177;185;249morm\u001b[39m and\r\u001b[6C\u001b[1Breads occlusion\u001b[23Gfrom its red ch\u001b[40Gnel, rewriting every existi\u001b[68Gg material file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ67:\u001b[22m Jettison's\u001b[23Gtest\u001b[28Gcontent\u001b[36Gmoves to\u001b[45Gthe s\u001b[51Ga\u001b[53Gdard's layou\u001b[66G, and its content-file\u001b[89Gnaming\u001b[96Grule\u001b[101Gpoints\u001b[108Gto\u001b[111GManifest's\r\u001b[4C\u001b[1B \u001b[7Gstandard.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ12\u001b[22m (collision\u001b[22Gmesh)\u001b[28Gnow\u001b[32Gnames\u001b[38G\u001b[38;2;177;185;249mcollision-\u001b[49G\u001b[39mnodes\u001b[55Gas\u001b[58Gthe\u001b[62Gauthor's\u001b[71Gcollision\u001b[81Gmesh.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple UV sets\u001b[32Gchanges from Deferred to Open, \u001b[64Gnde\u001b[68G J64.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m thr\u001b[23Ge settled decisions und\u001b[47Gr Ren\u001b[53Gering: vertex pulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[2C\u001b[1B \u001b[5Gthe standards.     \u001b[25G       \u001b[33G         \u001b[43G    \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
