[0.085, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mJettison\u001b[12G\u001b[22m(\u001b[38;2;177;185;249mjettison.lane-c\u001b[39m,\u001b[30Gbranch\u001b[37G\u001b[38;2;177;185;249mart-standards-support\u001b[39m):\r\u001b[1B \u001b[3G- \u001b[1mRoadmap:\u001b[22m a new track, \"The art stan\u001b[41Gards' support\".\u001b[57GEach\u001b[62Gitem\u001b[67Gneeds\u001b[73Gthe\u001b[77Gcook\u001b[82G(J37)\u001b[88Gand\u001b[92Gis\u001b[95Gleft\u001b[100Gfor\u001b[104Gyou\u001b[108Gto\u001b[111Gschedule.\r\u001b[1B    - \u001b[1mJ64:\u001b[12G\u001b[22mUV set\u001b[19G by r\u001b[25Gl\u001b[27G,\u001b[29Gfetch\u001b[35Gd\u001b[37Gby\u001b[40Gvertex\u001b[47Gpulling,\u001b[56Gat\u001b[59Gmost\u001b[64Geight\u001b[70Gper\u001b[74Gmesh,\u001b[80Gplus\u001b[85Gvertex\u001b[92Gcolour\u001b[99Gsets\u001b[104Gthe\u001b[108Gsame\u001b[113Gway.\r\u001b[4C\u001b[1B- \u001b[1mJ65:\u001b[22m the material library. The cook resolves a glTF material's name to its material file and refuses names it\r\u001b[5C\u001b[1B can't find or finds twice. This replaces J27's row for reading a model's own material values, which I removed.\r\u001b[4C\u001b[1B- \u001b[1mJ66:\u001b[22m the cook reads the standard's names: colour space from the map word, 16-bit sources, refusing glTF material\r\u001b[5C\u001b[1B extensions, and the \u001b[38;2;177;185;249mcollision-\u001b[39m and \u001b[38;2;177;185;249msocket-\u001b[39m nodes. It also renames \u001b[38;2;177;185;249mmesh\u001b[39m's \u001b[38;2;177;185;249mmetallicRoughness\u001b[39m texture slot to \u001b[38;2;177;185;249morm\u001b[118G\u001b[39mand\r\u001b[5C\u001b[1B reads occlusion from its red channel, rewriting every existing material file.\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mJ67:\u001b[22m Jettison's test content moves to the standard's layout, and its content-file naming rule points to Manifest's\r\u001b[6C\u001b[1Bstandard.\r\u001b[1B \u001b[3G  - \u001b[1mJ12\u001b[22m (c\u001b[14Gllision mesh) now names \u001b[38;2;177;185;249mcollision-\u001b[39m nodes\u001b[55Gas\u001b[58Gthe\u001b[62Gauthor's\u001b[71Gcollision\u001b[81Gmesh.\r\u001b[1B  - \u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple UV sets changes\u001b[40Gfrom\u001b[45GDeferred\u001b[54Gto\u001b[57GOpen,\u001b[63Gunder\u001b[69GJ64.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m \u001b[20Ghree\u001b[25Gsettled\u001b[33Gdecisions\u001b[43Gunder\u001b[49GRendering:\u001b[60Gvertex\u001b[67Gpulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[4C\u001b[1Bthe standards.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[22m a new \"Art assets\" row in the capability map.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m, b\u001b[32Ganch \u001b[38;2;177;185;249mart-standards\u001b[39m):\u001b[K\r\u001b[1B  - \u001b[38;2;177;185;249m\u001b[1mart-standards.md\u001b[39m:\u001b[22m marked as settled.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe\u001b[11Gart\u001b[15Grepository\u001b[26Gis\u001b[29GGit\u001b[33Gwith\u001b[38GLFS\u001b[42Gfor\u001b[46Gbinary\u001b[53Gfiles;\u001b[60G\u001b[38;2;177;185;249m.gltf\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249m.yaml\u001b[76G\u001b[39mstay\u001b[81Gplain\u001b[87Gtext\u001b[92Gso\u001b[95Gchanges\u001b[103Gdiff.\r\u001b[1B \u001b[3G  - The UV role table is the default for typical assets,\u001b[60Gto\u001b[63Gbe\u001b[66Grefined\u001b[74Gonce\u001b[79Gyou\u001b[83Gknow\u001b[88Gwhich\u001b[94Gclasses\u001b[102Gneed\u001b[107Gsix\u001b[111Gsets.\r\u001b[1B    -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.139, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mRoadmap:\u001b[22m a new track, \"The \u001b[33Grt standards' support\". Each\u001b[62Gitem\u001b[67Gneeds\u001b[73Gthe\u001b[77Gcook\u001b[82G(J37)\u001b[88Gand\u001b[92Gis\u001b[95Gleft\u001b[100Gfor\u001b[104Gyou\u001b[108Gto\u001b[111Gschedule.\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mJ64:\u001b[22m UV sets\u001b[20Gby role, f\u001b[31Gtched by ve\u001b[43Gtex\u001b[47Gp\u001b[49Glling, at most \u001b[65Gight per m\u001b[76Gsh, plus vertex\u001b[92Gcolour sets\u001b[104Gthe\u001b[108Gsame way.\u001b[K\r\u001b[8C\u001b[1B\u001b[1m5\u001b[12G\u001b[22mthe material \u001b[26Gibrary. The cook r\u001b[45Gsolves a glTF\u001b[60Gaterial's\u001b[70Gname to its material file and refuses\u001b[108Gn\u001b[112Gs it\u001b[K\r\u001b[4C\u001b[1B \u001b[7Gcan't find or finds twice\u001b[36Gis replaces J27's\u001b[54Grow for reading\u001b[70Ga \u001b[73Godel's own material values, which I removed.\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ66:\u001b[22m the co\u001b[19Gk\u001b[21Grea\u001b[28Ghe standard's n\u001b[44Gm\u001b[47G: colou\u001b[55G space\u001b[62Gfrom the map word, 16-bi\u001b[87G sources, refusing glTF \u001b[112Gat\u001b[115Grial\r\u001b[4C\u001b[1B \u001b[7Gextensions, and the\u001b[27G\u001b[38;2;177;185;249mcollision-\u001b[39m and\u001b[42G\u001b[38;2;177;185;249msocket-\u001b[39m nodes. It also renames \u001b[38;2;177;185;249mmesh\u001b[39m's \u001b[38;2;177;185;249mmetallicRoughness\u001b[39m texture\u001b[106Gs\u001b[108Got\u001b[111Gto \u001b[38;2;177;185;249morm\u001b[39m and\r\u001b[6C\u001b[1Breads occlusion\u001b[23Gfrom its red ch\u001b[40Gnel, rewriting every existi\u001b[68Gg material file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ67:\u001b[22m Jettison's\u001b[23Gtest\u001b[28Gcontent\u001b[36Gmoves to\u001b[45Gthe s\u001b[51Ga\u001b[53Gdard's layou\u001b[66G, and its content-file\u001b[89Gnaming\u001b[96Grule\u001b[101Gpoints\u001b[108Gto\u001b[111GManifest's\r\u001b[4C\u001b[1B \u001b[7Gstandard.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ12\u001b[22m (collision\u001b[22Gmesh)\u001b[28Gnow\u001b[32Gnames\u001b[38G\u001b[38;2;177;185;249mcollision-\u001b[49G\u001b[39mnodes\u001b[55Gas\u001b[58Gthe\u001b[62Gauthor's\u001b[71Gcollision\u001b[81Gmesh.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple UV sets\u001b[32Gchanges from Deferred to Open, \u001b[64Gnde\u001b[68G J64.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m thr\u001b[23Ge settled decisions und\u001b[47Gr Ren\u001b[53Gering: vertex pulling,\u001b[76Gthe\u001b[80Gmaterial\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[2C\u001b[1B \u001b[5Gthe standards.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mgame-integration.md\u001b[39m:\u001b[26G\u001b[22ma\u001b[28Gnew\u001b[32G\"Art\u001b[37Gassets\"\u001b[45Grow\u001b[49Gin\u001b[52Gthe\u001b[56Gcapability\u001b[67Gmap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[12G\u001b[22m(\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m,\u001b[30Gbranch\u001b[37G\u001b[38;2;177;185;249mart-standards\u001b[39m):\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mart-standards.md\u001b[39m:\u001b[22m marked\u001b[30Gas settled.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- The art repository is Git\u001b[33Gwi\u001b[36Gh LFS\u001b[42Gfor\u001b[46Gbinary\u001b[53Gfiles;\u001b[60G\u001b[38;2;177;185;249m.gltf\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249m.yaml\u001b[76G\u001b[39mstay\u001b[81Gplain\u001b[87Gtext\u001b[92Gso\u001b[95Gchanges\u001b[103Gdiff.\r\u001b[10C\u001b[1BUV role table is the default for typ\u001b[48Gc\u001b[50Gl asset\u001b[58G,\u001b[60Gto be\u001b[66Grefined once \u001b[80Gou know which classes need six\u001b[111Gsets.\r\u001b[10C\u001b[1Bvertex-pulling design itse\u001b[38Gf\u001b[40Gn\u001b[42Gw\u001b[44Glives only in J64;\u001b[63Gthe Manifest doc lin\u001b[84Gs to it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.096, "o", "\u001b[?25l\u001b[H\r\u001b[49C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m8\u001b[54G3\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.305, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- \u001b[1mJ65:\u001b[22m the\u001b[16Gmateri\u001b[23Gl library. The cook resolves a glTF material's name to its\u001b[82Gmateri\u001b[89Gl f\u001b[93Gle and\u001b[100Grefuses\u001b[108Gnames it\u001b[K\r\u001b[4C\u001b[1B \u001b[7Gcan't find or finds twice. This replaces J27's row for reading\u001b[70Ga mod\u001b[76Gl's\u001b[80Gown material val\u001b[97Ges, whic\u001b[106G I removed\r\u001b[8C\u001b[1B\u001b[1m6\u001b[16G\u001b[22mcook reads the standard's names: colour space f\u001b[64Gom the map\u001b[75Gw\u001b[77Grd, 16-bit sources, refusing glTF material\r\u001b[6C\u001b[1Bextensio\u001b[16Gs, and the\u001b[27G\u001b[38;2;177;185;249mcollision-\u001b[39m and \u001b[38;2;177;185;249msocket-\u001b[39m nodes. It also re\u001b[68Games \u001b[38;2;177;185;249mmesh\u001b[80GmetallicRoughness\u001b[39m texture slot t\u001b[113G \u001b[38;2;177;185;249morm\u001b[118G\u001b[39mand\r\u001b[4C\u001b[1B \u001b[7Greads occlusion from its red channel, rewriting every existing material file.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mJ67:\u001b[22m Jettison's\u001b[24Gest content moves\u001b[42Gto the standard's\u001b[60Glay\u001b[64Gut, \u001b[69Gnd its content-file naming rul\u001b[100G point\u001b[107G to\u001b[111GManifest's\r\u001b[6C\u001b[1Bst\u001b[10Gndard.\u001b[K\r\u001b[7C\u001b[1B\u001b[1m12\u001b[22m (coll\u001b[18Gion mesh)\u001b[28Gn\u001b[30Gw names \u001b[38;2;177;185;249mcollision-\u001b[49G\u001b[39mnodes as the author's collision mesh.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m multiple\u001b[24GUV\u001b[27Gsets\u001b[32Gchanges\u001b[40Gfrom\u001b[45GDeferred\u001b[54Gto\u001b[57GOpen,\u001b[63Gunder\u001b[69GJ64.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m thre\u001b[24G settled decisions under\u001b[49GRendering: vertex pulling, the material\u001b[89Glibrary,\u001b[98Gand\u001b[102GManifest\u001b[111Gdefining\r\u001b[2C\u001b[1B \u001b[5Gthe standards.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mgame-\u001b[11Gntegration.md\u001b[39m:\u001b[22m a new \"Art assets\" row\u001b[49Gin the capability\u001b[67Gmap.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest\u001b[22m (\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m, branch\u001b[37G\u001b[38;2;177;185;249mart-standards\u001b[39m):\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mart-standards.md\u001b[39m:\u001b[23G\u001b[22mmarked\u001b[30Gas\u001b[33Gsettled.\r\u001b[2C\u001b[1B  - The art repository is Git with LFS for binary\u001b[53Gfiles;\u001b[60G\u001b[38;2;177;185;249m.gltf\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249m.yaml\u001b[76G\u001b[39mstay\u001b[81Gplain\u001b[87Gtext\u001b[92Gso\u001b[95Gchanges\u001b[103Gdiff.\r\u001b[2C\u001b[1B \u001b[5G- The UV role table is the defau\u001b[38Gt for\u001b[44Gtypical\u001b[52Gassets,\u001b[60Gto\u001b[63Gbe\u001b[66Grefined\u001b[74Gonce\u001b[79Gyou\u001b[83Gknow\u001b[88Gwhich\u001b[94Gclasses\u001b[102Gneed\u001b[107Gsix\u001b[111Gsets.\r\u001b[10C\u001b[1Bvertex-pulling\u001b[26Gdesign\u001b[33Gitself now lives only in J64; the Manifest\u001b[76Gdoc links to i\u001b[91G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDecision ledger:\u001b[22m a new\u001b[28G\"Art st\u001b[36Gndards\"\u001b[44Ggroup with D-118 (Manif\u001b[68Gst defi\u001b[76Ges\u001b[79Gthe\u001b[83Gstandards)\u001b[94Gand D-119 (the art\u001b[K\r\u001b[4C\u001b[1Breposito\u001b[14Gy on Git LFS).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
