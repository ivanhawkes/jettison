[0.037, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m20\u001b[12G\u001b[38;2;248;248;242m**What remains.**\u001b[30G`source/tes\u001b[42G/con\u001b[47Ge\u001b[49Gt` laid out and\u001b[65Gnamed\u001b[71Gas\u001b[74Gthe\u001b[78G[\u001b[38;2;230;219;116mart standards\u001b[38;2;248;248;242m](../../manifest/docs/\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;248;248;242mart-standards.md#files)\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m1\u001b[12G\u001b[38;2;248;248;242mhave it: \u001b[23Gterials in class folders (`materials/<class>/<name>.material.yaml`), maps by the           \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m622\u001b[12G\u001b[38;2;248;248;242mstandard's words. Th\u001b[33G [\u001b[38;2;230;219;116mcontent-file rule\u001b[38;2;248;248;242m](coding-standards.md#content-files) becomes a pointer to the \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;248;248;242mart standards, keep\u001b[33Gg the engin\u001b[45G'\u001b[48Gexceptions (shader programs, fonts)\u001b[84G Needs [\u001b[38;2;230;219;116mJ66\u001b[38;2;248;248;242m](#j66) for        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242m`orm`.    \u001b[23G      \u001b[30G   \u001b[34G                                                                                \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242m   \u001b[16G          \u001b[27G       \u001b[35G   \u001b[39G        \u001b[48G          \u001b[59G       \u001b[67G         \u001b[77G       \u001b[85G     \u001b[91G                       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m**Why\u001b[18G**\u001b[21GOne\u001b[25Gstandard\u001b[34Gserves\u001b[41GManifest\u001b[50Gand\u001b[54Gthe\u001b[58Gengine's\u001b[67Gown\u001b[71Gconsumers,\u001b[82Gso\u001b[85Gthe\u001b[89Gtest\u001b[94Gcontent\u001b[102Gis\u001b[105Gthe\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242mstandard's\u001b[23Gfirst\u001b[29Gexample.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242m        \u001b[21G   \u001b[25G        \u001b[34G      \u001b[41G        \u001b[50G   \u001b[54G   \u001b[58G        \u001b[67G   \u001b[71G          \u001b[82G  \u001b[85G   \u001b[89G    \u001b[94G       \u001b[102G  \u001b[105G   \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242m**What exists.**\u001b[29GThe test\u001b[38Gcontent's\u001b[48Geleven\u001b[55Gmaterials,\u001b[66Gflat\u001b[71Gunder\u001b[77G`materials/`,\u001b[91Gand\u001b[95Gits\u001b[99Gtextures\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m30\u001b[12G\u001b[38;2;248;248;242munder\u001b[18G`textures/<kind>/<asset>/`.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m31\u001b[12G\u001b[38;2;248;248;242m      \u001b[19G         \u001b[29G   \u001b[33G    \u001b[38G         \u001b[48G      \u001b[55G          \u001b[66G    \u001b[71G     \u001b[77G             \u001b[91G   \u001b[95G   \u001b[99G        \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[12G\u001b[38;2;248;248;242m**F\u001b[16Gatur\u001b[21G doc:** [\u001b[38;2;230;219;116msamples and test consumers\u001b[38;2;248;248;242m](sample-game.md).                                        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe J64–J67 \u001b[16Goadm\u001b[21Gp t\u001b[25Gack\u001b[29Gis\u001b[32Gin;\u001b[36Gnext\u001b[41GI'm\u001b[45Gchecking\u001b[54Git,\u001b[58Gthen\u001b[63Gmaking\u001b[70Gthe\u001b[74Gscope,\u001b[81Gdecisions\u001b[91Gand\u001b[95GManifest\u001b[104Gedits.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
