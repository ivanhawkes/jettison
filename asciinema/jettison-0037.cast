[0.003, "o", "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI \u001b[6Genamed\u001b[13Gthe\u001b[17Gslot\u001b[22Gand\u001b[26Gcommitted\u001b[36Gboth\u001b[41Gbranches.\u001b[51GThe\u001b[55Gfull\u001b[60Ggate\u001b[65Ghasn't\u001b[72Grun\u001b[76Gon\u001b[79Gthe\u001b[83GJettison\u001b[92Gcommit\u001b[99Gyet,\u001b[104Gso\u001b[107Grun\u001b[111Git\u001b[114Gbefore\r\u001b[2C\u001b[1Bmerging.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison\u001b[14G\u001b[22m\u001b[38;2;177;185;249made7077\u001b[22G\u001b[39mon\u001b[25G\u001b[38;2;177;185;249mart-standards-support\u001b[47G\u001b[39m(\u001b[38;2;177;185;249mjettison.lane-c\u001b[39m):\u001b[66Gthe\u001b[70GJ64–J67\u001b[78Groadmap\u001b[86Gtrack\u001b[92Gand\u001b[96Gits\u001b[100Gdocs,\u001b[106Gplus\u001b[111Gthe\r\u001b[4C\u001b[1Brename.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GThe texture\u001b[19Gslot \u001b[25Gs now\u001b[31G\u001b[38;2;177;185;249morm\u001b[39m in\u001b[38G\u001b[38;2;177;185;249mmesh.program.yaml\u001b[56G\u001b[39mand\u001b[60G\u001b[38;2;177;185;249mmesh_triplanar.program.yaml\u001b[39m.\u001b[89GThe\u001b[93Gshader's\u001b[102Gsampler\u001b[110Gis\u001b[113Gnow\r\u001b[4C\u001b[1B \u001b[7G\u001b[38;2;177;185;249mormTexture\u001b[39m;\u001b[19Gthe binding number is unchanged.\u001b[K\r\u001b[6C\u001b[1BNo material file nam\u001b[28Gd\u001b[30Gthe slot, so none ne\u001b[51Gded rewriti\u001b[63Gg, and Manifest ha\u001b[82G no material files\u001b[101Gyet.\r\u001b[6C\u001b[1BThe materia\u001b[19G parameter\u001b[30Gof th\u001b[36G same \u001b[43Game (the metallic and roughn\u001b[72Gss fac\u001b[79Gors) keeps\u001b[90Gits\u001b[94Gname.\r\u001b[6C\u001b[1BReading occlusion from the red channel is still J66, which now records\u001b[78Gthe rename.\r\u001b[2C\u001b[1B \u001b[5G- The content-file naming rule in\u001b[39G\u001b[38;2;177;185;249mcoding-\u001b[48Gandards.md\u001b[39m lists \u001b[38;2;177;185;249morm\u001b[39m as a map word.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest\u001b[22m \u001b[38;2;177;185;249me2fc3de\u001b[22G\u001b[39mon\u001b[25G\u001b[38;2;177;185;249mart-standards\u001b[39G\u001b[39m(\u001b[38;2;177;185;249mmanifest.lane-b\u001b[39m):\u001b[58G\u001b[38;2;177;185;249mart-standards.md\u001b[39m,\u001b[76GD-118\u001b[82Gand\u001b[86GD-119\u001b[92Gin\u001b[95Gthe\u001b[99Gdecision\u001b[108Gledger,\u001b[116Gand\r\u001b[4C\u001b[1Bthe\u001b[9Gindex\u001b[15Grow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe incremental \u001b[38;2;177;185;249mclang-debug\u001b[39m build in lane C passed, a\u001b[57G did the \u001b[38;2;177;185;249mrender\u001b[39m,\u001b[74G\u001b[38;2;177;185;249mresource\u001b[39m, \u001b[38;2;177;185;249mapp\u001b[88G\u001b[39man\u001b[91G \u001b[38;2;177;185;249msample-ground\u001b[39m suit\u001b[111Gs and th\u001b[120G\u001b[K\r\u001b[2C\u001b[1Bformat check.\u001b[17GLane B was running a gate at the \u001b[51Gime,\u001b[56Gso\u001b[59GI didn't sta\u001b[72Gt a second\u001b[83Gone.\u001b[88GI\u001b[90Gdidn't\u001b[97Grun\u001b[101Gthe\u001b[105Greference\u001b[115Gframes\r\u001b[2C\u001b[1Bor\u001b[6Gsmoke\u001b[12Gtest\u001b[17Geither;\u001b[25Gthe\u001b[29Ggate\u001b[34Gcovers\u001b[41Gthose.\u001b[48GNothing\u001b[56Gis\u001b[59Gpushed\u001b[66Gor\u001b[69Gmerged.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis\u001b[8Gis\u001b[11Ga\u001b[13Ggood\u001b[18Gpoint\u001b[24Gto\u001b[27G\u001b[38;2;177;185;249m/compact\u001b[39m,\u001b[37Gor\u001b[40Gstart\u001b[46Ga\u001b[48Gfresh\u001b[54Gsession\u001b[62Gfor\u001b[66Gthe\u001b[70Gmerge.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;153;153;153mBrewed for 1m 50s · done\u001b[28G12:25 pm\u001b[39m\u001b[K\r\u001b[3B❯ \r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← 1\u001b[46Gagent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
