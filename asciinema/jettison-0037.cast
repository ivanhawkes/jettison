[0.052, "o", "\u001b[?25l\u001b[H\u001b[3Gabout 290\u001b[13Glines, on\u001b[23Ga\u001b[25Gnew\u001b[29Gbranch\u001b[36G\u001b[38;2;177;185;249mart-standards\u001b[39m,\u001b[51Gwith\u001b[56Ga\u001b[58Gnew\u001b[62Grow\u001b[66Gin\u001b[69G\u001b[38;2;177;185;249mdocs/README.md\u001b[39m.\u001b[85GNothing\u001b[93Gis\u001b[96Gcommitted,\u001b[107Gand\u001b[111GI've\u001b[116Gleft\r\u001b[2C\u001b[1Ba\u001b[5Glane note so the other session sees lane B is taken. Jettison's docs are unchanged; the doc ends with a list of\u001b[117Gwhat\r\u001b[2C\u001b[1BJettison has to build to support it.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it covers:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo trees:\u001b[22m a work tree for \u001b[38;2;177;185;249m.blend\u001b[39m and Substance files, and a\u001b[66Gsource\u001b[73Gtree that\u001b[83Gh\u001b[85Glds only\u001b[94Gexports.\u001b[103GThey\u001b[108Ghave\u001b[113Gto\u001b[116Gbe\r\u001b[4C\u001b[1Bseparate\u001b[14Gbecause\u001b[22Gthe\u001b[26Gcook\u001b[31Gcopies\u001b[38Gthrough\u001b[46Gany\u001b[50Gfile\u001b[55Git\u001b[58Gdoesn't\u001b[66Grecognise,\u001b[77Gso\u001b[80Ga\u001b[82G\u001b[38;2;177;185;249m.blend\u001b[89G\u001b[39mleft\u001b[94Gin\u001b[97Gthe\u001b[101Gsource\u001b[108Gtree\u001b[113Gwould\r\u001b[2C\u001b[1B  ship. The cooked output mirrors the source tree into \u001b[38;2;177;185;249mmods/manifest/\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames:\u001b[12G\u001b[22mkebab-case\u001b[23Geverywhere,\u001b[35Gwhich\u001b[41Gthe\u001b[45Gcook\u001b[50Galready\u001b[58Genforces.\u001b[68GAsset\u001b[74Gnames\u001b[80Grun\u001b[84Ggeneral\u001b[92Gto\u001b[95Gspecific\u001b[104Gwith\u001b[109Ga\u001b[111Gletter\u001b[118Gfor\r\u001b[1B \u001b[3G  variants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), ki\u001b[29G pieces carry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m),\u001b[90Gand\u001b[94Gtextures\u001b[103Gfollow\r\u001b[1B    \u001b[38;2;177;185;249m<asset>-<map>\u001b[39m.\u001b[20GThe map\u001b[28Gwords (\u001b[38;2;177;185;249mcolor\u001b[39m,\u001b[42G\u001b[38;2;177;185;249mnormal\u001b[39m,\u001b[50G\u001b[38;2;177;185;249morm\u001b[39m,\u001b[55G\u001b[38;2;177;185;249memissive\u001b[39m,\u001b[65G\u001b[38;2;177;185;249mheight\u001b[39m,\u001b[73G\u001b[38;2;177;185;249mmask\u001b[39m)\u001b[79Gdecide\u001b[86Geach\u001b[91Gtexture's\u001b[101Gcolour\u001b[108Gspace.\u001b[115GFace\r\u001b[4C\u001b[1Bblend shapes are\u001b[22Gt\u001b[24Ge one exc\u001b[34Gption: they use ARKit's n\u001b[60Gmes\u001b[64Gexactly.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and axes:\u001b[22m 1\u001b[23Gunit = 1 m, +Y up, nose \u001b[48Glong −Z\u001b[56G(+Y \u001b[62G Blender), transforms \u001b[85Gpplied before export\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeometry for meshlets and ray tracing:\u001b[22m mode\u001b[49G real\u001b[55Gbevels rather than bak\u001b[78Gng them, b\u001b[89Gcause ra\u001b[98G-traced shadows\u001b[114Gand\r\u001b[4C\u001b[1Bocclusion see only geometry. No hand-made levels of detail or shadow proxies. Triangulate before baking and let\u001b[117Gthe\r\u001b[4C\u001b[1Bcook make the tangents. Shadow-casting parts should be closed, and kit pieces overlap slightly at joins so light\r\u001b[4C\u001b[1Bdoesn't\u001b[13Gleak\u001b[18Gthrough.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMaterials:\u001b[22m metallic-roughness\u001b[35Gonly.\u001b[41GThe\u001b[45GglTF\u001b[50Gcarries\u001b[58Ggeometry\u001b[67Gand\u001b[71Gmaterial\u001b[80Gnames,\u001b[87Gand\u001b[91Ga\u001b[93Glibrary\u001b[101Gof\u001b[104Gmaterial\u001b[113Gfiles\r\u001b[4C\u001b[1Bholds the\u001b[15Glook,\u001b[21Gso\u001b[24Ga\u001b[26Gshared\u001b[33Gmaterial\u001b[42Gis\u001b[45Gchanged\u001b[53Gin\u001b[56Gone\u001b[60Gplace.\u001b[67GIt\u001b[70Galso\u001b[75Gsets\u001b[80Gvalue\u001b[86Granges\u001b[93Gfor\u001b[97Gbase\u001b[102Gcolour,\u001b[110Gmetallic\r\u001b[4C\u001b[1Band\u001b[9Groughness,\u001b[20Gand\u001b[24Gsays\u001b[29Gocclusion\u001b[39Gmaps\u001b[44Ghold\u001b[49Gonly\u001b[54Gsmall\u001b[60Gcavities.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.141, "o", "\u001b[?25l\u001b[H\u001b[3GJettison has to build\u001b[25Gto support\u001b[36Git.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it covers:\u001b[19G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo trees:\u001b[16G\u001b[22ma\u001b[18Gwork\u001b[23Gtree\u001b[28Gfor\u001b[32G\u001b[38;2;177;185;249m.blend\u001b[39G\u001b[39mand\u001b[43GSubstance\u001b[53Gfiles,\u001b[60Gand\u001b[64Ga\u001b[66Gsource\u001b[73Gtree\u001b[78Gthat\u001b[83Gholds\u001b[89Gonly\u001b[94Gexports.\u001b[103GThey\u001b[108Ghave\u001b[113Gto\u001b[116Gbe\r\u001b[2C\u001b[1B  separate because\u001b[22Gthe\u001b[26Gcook\u001b[31Gcopies\u001b[38Gthrough\u001b[46Gany\u001b[50Gfile\u001b[55Git\u001b[58Gdoesn't\u001b[66Grecognise,\u001b[77Gso\u001b[80Ga\u001b[82G\u001b[38;2;177;185;249m.blend\u001b[89G\u001b[39mleft\u001b[94Gin\u001b[97Gthe\u001b[101Gsource\u001b[108Gtree\u001b[113Gwould\r\u001b[2C\u001b[1B \u001b[5Gship. The cooked output mirrors the source tre\u001b[53Ginto \u001b[38;2;177;185;249mmods/manifest/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames:\u001b[22m ke\u001b[15Gab-case everywhere, whic\u001b[40G the cook\u001b[50Galr\u001b[54Gady\u001b[58Genforces. Asset names\u001b[80Grun general \u001b[93Go specific with a letter for\r\u001b[4C\u001b[1Bvariants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), kit piece\u001b[37Gcarry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m),\u001b[90Gand\u001b[94Gtextures\u001b[103Gfollow\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<asset>-<map>\u001b[39m. The map \u001b[29Gords (\u001b[38;2;177;185;249mcolor\u001b[39m, \u001b[38;2;177;185;249mnormal\u001b[39m,\u001b[50G\u001b[38;2;177;185;249morm\u001b[39m, \u001b[38;2;177;185;249memissive\u001b[39m, \u001b[38;2;177;185;249mheight\u001b[39m, \u001b[38;2;177;185;249mmask\u001b[39m) decide each textur\u001b[98G's colour spac\u001b[113G. Face\u001b[K\r\u001b[4C\u001b[1Bblend shapes are the\u001b[26Gone\u001b[30Gexception: they use ARKit's names exactly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and axes:\u001b[22m 1 unit\u001b[28G= 1 m, +Y up\u001b[42Gnose along −Z (+Y in Blender)\u001b[73Gtransforms applied befo\u001b[98G exp\u001b[103Grt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeometry for meshlets and ray tracing:\u001b[22m model\u001b[50Greal bevels rather than\u001b[74Gbaking\u001b[81Gthem,\u001b[87Gbecause\u001b[95Gray-traced\u001b[106Gshadows\u001b[114Gand\r\u001b[2C\u001b[1B \u001b[5Gocclusion see only geometry. No hand-mad\u001b[47Glevels of detail or shadow proxies. Triangulat\u001b[94G before baking\u001b[109Gand\u001b[113Glet\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gcook make the tangents. Shadow-casting\u001b[44Gparts\u001b[50Gshould b\u001b[59G closed, and kit p\u001b[78Geces overlap slightly at joins s\u001b[111G light\r\u001b[4C\u001b[1Bdoesn't leak through.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMaterials:\u001b[22m m\u001b[18Gtallic-roughness only. The glTF\u001b[50Gcarries geometry and material names, and\u001b[91Ga library of material files\r\u001b[4C\u001b[1Bh\u001b[7Glds \u001b[12Ghe look, so a shared\u001b[33Gmaterial\u001b[42Gis\u001b[45Gchanged\u001b[53Gin\u001b[56Gone\u001b[60Gplace.\u001b[67GIt\u001b[70Galso\u001b[75Gsets\u001b[80Gvalue\u001b[86Granges\u001b[93Gfor\u001b[97Gbase\u001b[102Gcolour,\u001b[110Gmetallic\r\u001b[2C\u001b[1B \u001b[5Gand roughness, and says occlusion maps ho\u001b[47Gd only small cavities.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTextures:\u001b[15G\u001b[22mPNG sources (16-bit fo\u001b[38G normal and height), power-of-\u001b[69Gwo \u001b[73Gizes, OpenGL\u001b[86Gnormal\u001b[93Gmaps, padding around UV\u001b[K\r\u001b[4C\u001b[1Bislands.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.093, "o", "\u001b[?25l\u001b[H\r\u001b[45C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m6\u001b[48G1\u001b[52G3\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.354, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat it covers:\u001b[19G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo trees:\u001b[16G\u001b[22ma\u001b[18Gwork\u001b[23Gtree\u001b[28Gfor\u001b[32G\u001b[38;2;177;185;249m.blend\u001b[39G\u001b[39mand\u001b[43GSubstance\u001b[53Gfiles,\u001b[60Gand\u001b[64Ga\u001b[66Gsource\u001b[73Gtree\u001b[78Gthat\u001b[83Gholds\u001b[89Gonly\u001b[94Gexports.\u001b[103GThey\u001b[108Ghave\u001b[113Gto\u001b[116Gbe\r\u001b[2C\u001b[1B  separate because\u001b[22Gthe\u001b[26Gcook\u001b[31Gcopies\u001b[38Gthrough\u001b[46Gany\u001b[50Gfile\u001b[55Git\u001b[58Gdoesn't\u001b[66Grecognise,\u001b[77Gso\u001b[80Ga\u001b[82G\u001b[38;2;177;185;249m.blend\u001b[89G\u001b[39mleft\u001b[94Gin\u001b[97Gthe\u001b[101Gsource\u001b[108Gtree\u001b[113Gwould\r\u001b[2C\u001b[1B \u001b[5Gship. The cooked output mirrors the source tre\u001b[53Ginto \u001b[38;2;177;185;249mmods/manifest/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNames:\u001b[22m ke\u001b[15Gab-case everywhere, whic\u001b[40G the cook\u001b[50Galr\u001b[54Gady\u001b[58Genforces. Asset names\u001b[80Grun general \u001b[93Go specific with a letter for\r\u001b[4C\u001b[1Bvariants (\u001b[38;2;177;185;249mhauler-a\u001b[39m), kit piece\u001b[37Gcarry their size (\u001b[38;2;177;185;249mstation-kit-corridor-straight-4m\u001b[39m),\u001b[90Gand\u001b[94Gtextures\u001b[103Gfollow\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m<asset>-<map>\u001b[39m. The map \u001b[29Gords (\u001b[38;2;177;185;249mcolor\u001b[39m, \u001b[38;2;177;185;249mnormal\u001b[39m,\u001b[50G\u001b[38;2;177;185;249morm\u001b[39m, \u001b[38;2;177;185;249memissive\u001b[39m, \u001b[38;2;177;185;249mheight\u001b[39m, \u001b[38;2;177;185;249mmask\u001b[39m) decide each textur\u001b[98G's colour spac\u001b[113G. Face\u001b[K\r\u001b[4C\u001b[1Bblend shapes are the\u001b[26Gone\u001b[30Gexception: they use ARKit's names exactly.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScale and