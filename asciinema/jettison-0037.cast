001b[39Ghe\u001b[42Gslot w\u001b[49Gs rename\u001b[59Gfrom `metallicRoughness` o\u001b[86G 2026-11\u001b[95G27). A\u001b[102G`mask`\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[15G\u001b[38;2;248;248;242mlot for programs that\u001b[37Gtak\u001b[42Gone.\u001b[47G   \u001b[51G       \u001b[59G    \u001b[64G                   \u001b[84G  \u001b[87G            \u001b[100G \u001b[102G      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 605 \u001b[22m - **Material extensions.** A glTF source using a material extension is refused, naming it.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[16G\u001b[22mRol\u001b[20G nodes.** `c\u001b[33Gllision-` nodes kept out of\u001b[61Gthe dr\u001b[68Gwn mesh and\u001b[80Ghand\u001b[85Gd to [\u001b[38;2;230;219;116mJ12\u001b[39m](#j12)'s\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m \u001b[14Gcollision file;\u001b[31Gs\u001b[33Gcket-` nodes kept in\u001b[54Gthe\u001b[58Gcooked\u001b[65GGLB, th\u001b[73Gir\u001b[76Gtransforms\u001b[87Gf\u001b[89Gund by name on\u001b[104Gthe\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'../jettison.lane-c'\u001b[35G&&\u001b[38Gctest\u001b[44G--test-dir\u001b[55Gbuild…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '../jettison.lane-c' && ctest --test-dir build/clang-debug -R '^(render|app|sample-ground|resource)$' \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m--output-on-failure 2>&1 | tail -15\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
