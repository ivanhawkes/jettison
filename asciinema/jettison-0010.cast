[0.849, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[48;2;70;70;70m193\u001b[10GAn ancestor's result, a PR merge candidat\u001b[52G's\u001b[55Gresult, \u001b[64G partial gate, or \u001b[83G mi\u001b[87Gsing, running,\r\u001b[5C\u001b[1B197\u001b[10GAvoid the second full gate triggered solely by prom\u001b[62Gting the same SHA to `main`.\u001b[91GRet\u001b[95Gin \r\u001b[5C\u001b[1B199:need\u001b[15Gnot\u001b[19Galso\u001b[24Grun\u001b[28Ga\u001b[30Gfull\u001b[35Ggate\u001b[40Gwhen\u001b[45Gthe\u001b[49GPR\u001b[52Galready\u001b[60Gprovides\u001b[69Gthat\u001b[74Gcheck.\u001b[81GThe\u001b[85Gintegrated\u001b[96Gcommit\r\u001b[1B \u001b[3G   208:administration must be identified explicitly. `script\u001b[64G/tidy.py` needs no warning-policy change.    \r\u001b[2C\u001b[1B   211:Acceptance evide\u001b[27Gce must include a contro\u001b[52Gled \u001b[57Gidy fail\u001b[66Gre aft\u001b[73Gr\u001b[75Gsuccessful requeste\u001b[95G \u001b[97G    \u001b[102G  \u001b[105G        \u001b[114G    \r\u001b[2C\u001b[1B   212:build/test stages,\u001b[29Gwith a nonzero gate result and logs\u001b[65Gshowing \u001b[74Ghose stage\u001b[85G ran\u001b[90Gfirst;\u001b[97Ga\r\u001b[2C\u001b[1B   213:p\u001b[12Gssing full \u001b[24Gat\u001b[27G on the final imp\u001b[45Gementation; and\u001b[61Gpromotion\u001b[71Gchecks\u001b[78Gcovering\u001b[87Gexact-SHA\u001b[97Gsuccess,\r\u001b[1B     215\u001b[10Gdoes not start another full gate, while a new integration commit and an\u001b[82Gexplicit\u001b[91Gmanual\u001b[98Grun\r\u001b[6C\u001b[1B18\u001b[10GPreset builds live in `build/clang-debug/`, `build/clang-notui/`, `build/clang-release/`\u001b[99Gand\r\u001b[6C\u001b[1B42\u001b[10Gand test \u001b[20Gasks explicitly use the `clang-debug` presets, with\u001b[72Gconfigure\u001b[82Gbefore\u001b[89Gbuild\u001b[95Gand\r\u001b[6C\u001b[1B58\u001b[10Gchange i\u001b[19G needed for this repair; this check is separate from\u001b[72Gthe full gate's\u001b[88Gevidence.\r\u001b[6C\u001b[1B74\u001b[10G`CTEST_PARALLEL_LEVEL`). The tasks are shell tasks\u001b[61Gon the `clang-debug`\u001b[82Gpresets:\u001b[91G`CMake:\r\u001b[5C\u001b[1B         \u001b[16G    \u001b[21G    \u001b[26G      \u001b[33G \u001b[36G     \u001b[42G   \r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(cd '\u001b[13Ghome/ivan/projects/manifest' && grep -nE \"Total\u001b[61GTest time|fixture \\.|content\u001b[90G\\.|travel\u001b[100G\\.|Preset\r\u001b[2C\u001b[1BCMake|ninja:\u001b[16Gno work|Linking CXX executable\" build/gate-w18b.out |\u001b[70Ggrep -vE \"Linking\"\u001b[89G|\u001b[91Ghead;\u001b[97Ggrep\u001b[102G-c\u001b[105G\"Linking\u001b[114GCXX\"\r\u001b[2C\u001b[1Bbuild/gate-w18b.out; stat -c '%y' build/gate-w18b\u001b[53Gout; ls\u001b[61G-la --time-style=full-iso\r\u001b[2C\u001b[1Bbuild/clang-*/Testing/Temporary/LastTest\u001b[44Glog 2>/dev/null)\u001b[63G      \u001b[73G    \u001b[78G   \r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39m199:14/48\u001b[16GTest\u001b[21G#34:\u001b[26Gvalidate_missing_content\u001b[51G.........\u001b[63GPassed\u001b[73G0.01\u001b[78Gsec\r\u001b[7C\u001b[1B7:18/48 Test #19: cli_missing_content\u001b[46G..............\u001b[63GPassed\u001b[73G0.01\u001b[78Gsec\r\u001b[5C\u001b[1B239:44/48 Test #10: t\u001b[28Gavel ..............\u001b[75G64 sec                                      \u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
