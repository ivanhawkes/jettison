[0.006, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 92 +\u001b[38;2;248;248;242mthe push.                                                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 93 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 94 \u001b[22m ## Ma\u001b[17Ghine-specific concurrency\u001b[K\r\u001b[1B     \u001b[2m 95 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m96 \u001b[22m [\u001b[38;2;230;219;116mD-051\u001b[39m](decision-ledger.md#d-051) distinguish\u001b[57Gs the laptop's resource limit\u001b[87Gfrom\u001b[92Gother\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe split\u001b[13Gworks, with the longes\u001b[36G of\u001b[40Gthr\u001b[44Ge test entri\u001b[57Gs\u001b[59Gat\u001b[62G13 s \u001b[68Ggainst 25 s\u001b[80Gfor the whole suite in\u001b[103Gdebug.\u001b[110GI'm\r\u001b[2C\u001b[1Bcommitti\u001b[12Gg,\u001b[15Gthen r\u001b[22Gnning\u001b[30Ge first gate in a second checkou\u001b[63G,\u001b[65Gwhich w\u001b[73Gll be \u001b[80Glow since it\u001b[93Gbu\u001b[96Glds from\u001b[105Gscratch.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(~/projects/manifest/build/commit-gate-split.txt)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m11\u001b[22m lines\u001b[21Gto\u001b[24G\u001b[1m~/projects/manifest/build/commit-gate-split.txt\r\u001b[5C\u001b[1B\u001b[22m\u001b[2m 1 \u001b[22mGate:\u001b[15Gthe\u001b[19Gfixture's\u001b[29Gtwo\u001b[33Glongest\u001b[41Gcases\u001b[47Grun\u001b[51Gbeside\u001b[58Gthe\u001b[62Grest,\u001b[68Gtidy\u001b[73Gin\u001b[76Gthe\u001b[80Ggate\r\u001b[1B \u001b[3G   \u001b[2m 2 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 3 \u001b[22mThe fixture suite took 144 s of the sanitised stage's tests, the gate's critical path, most\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[22mof it two cases (13 s and 7 s of its 25 s in Debug). They are now the suites fixture_cruise\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 5 \u001b[22mand fixture_alone, and fixture is every case they do not match, so one added\u001b[86Gor\u001b[89Grenamed\u001b[97Gstill\r\u001b[5C\u001b[1B\u001b[2m 6 \u001b[22mruns;\u001b[15Gin\u001b[18GDebug\u001b[24Gthe\u001b[28Gthree\u001b[34Gtake\u001b[39G13\u001b[42Gs\u001b[44Gside\u001b[49Gby\u001b[52Gside.\u001b[58GA\u001b[60Ggate\u001b[65Gon\u001b[68GLythir\u001b[75Gtakes\u001b[81Gclang-tidy,\u001b[93Gwhich\u001b[99Glocal\r\u001b[1B \u001b[3G   \u001b[2m 7 \u001b[22mgates had left to CI, and runs\u001b[40Gin\u001b[43Ga\u001b[45Gsecond\u001b[52Gcheckout,\u001b[62Gbuild/gate-tree,\u001b[79Gwhile\u001b[85Gthe\u001b[89Gnext\u001b[94Gchange\u001b[101Gis\u001b[27;1H\u001b[24;3H\u001b[?25h"]
