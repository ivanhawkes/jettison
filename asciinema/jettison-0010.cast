[5.678, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[60G\u001b[22mthe\u001b[64Gautopilot\u001b[74Gflies\u001b[80Gto\u001b[83Ga\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[4C\u001b[1Banimation\u001b[15Gtakes\u001b[21Gover.\u001b[27GPhysics\u001b[35Gonly\u001b[40Ggets\u001b[45Gthe\u001b[49Gship\u001b[54Gto\u001b[57Gthe\u001b[61Gstart\u001b[67Gof\u001b[70Gthe\u001b[74Gcorridor.\r\u001b[2C\u001b[1B- \u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[62G\u001b[22mstations\u001b[71Gcarry\u001b[77Gauthored\u001b[86Gapproach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B  holding point, then approach point, then pad along a path, with obstacle avoidance relaxed against\u001b[104Gthe station\u001b[K\r\u001b[4C\u001b[1Bitself on the final leg. Stuck\u001b[39Gcircling ships still turn up\u001b[68Gin the\u001b[75Gr bug reports.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mAssis\u001b[11Ged m\u001b[16Gnual docking (Elite D\u001b[39Ggerous):\u001b[22m you request permission and get a\u001b[81Gpad,\u001b[86Gand th\u001b[93G p\u001b[96Grm\u001b[99Gssion lapses\u001b[112Gif you\u001b[K\r\u001b[4C\u001b[1Bd\u001b[8G'\u001b[10G land in tim\u001b[23G; that's\u001b[32Gthe\u001b[36Gsame\u001b[41Grole\u001b[46Gas\u001b[49Gour\u001b[53Greservation.\u001b[66GA\u001b[68Gspeed\u001b[74Glimit\u001b[80Gapplies\u001b[88Gnear\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B  computer flies a fixed approach \u001b[38Gn thr\u001b[44Gugh\u001b[48Gthe entrance.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mGeneral autopilot\u001b[23G(Space Engineer\u001b[39G):\u001b[22m the remote-control\u001b[62Gutopilot is known\u001b[80Gfo\u001b[83G circling or overshooting\u001b[109Gi\u001b[111Gs\u001b[K\r\u001b[4C\u001b[1Bwaypoints.\u001b[16GPlayers\u001b[24Gwork\u001b[29Garound\u001b[36Git\u001b[39Gwith\u001b[44Ga\u001b[46Gslow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThes\u001b[8G g\u001b[11Gmes combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship \u001b[63Go a point\u001b[73Gout along the pad's n\u001b[95Grmal and\u001b[104Gcome\u001b[109Gin straight,\r\u001b[2C\u001b[1B   so any\u001b[13Govershoot heads \u001b[30Goward or\u001b[39Gaway from the station ra\u001b[65Ger\u001b[68Gthan\u001b[73Gsideways into\u001b[87Gan orbit.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe a\u001b[72Gready do\u001b[81Gthis when descendin\u001b[101G (\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut not\r\u001b[2C\u001b[1B   on \u001b[10Ghe\u001b[13Gi\u001b[15Gbound l\u001b[23Gg.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSlow down near the station.\u001b[34G\u001b[22mArrive\u001b[41Gslowly\u001b[48Genough\u001b[55Gto\u001b[58Gstop\u001b[63Gwell\u001b[68Gshort\u001b[74Gof\u001b[77Ganything.\r\u001b[2C\u001b[1B4. \u001b[1mLapse a pad only when the ship isn't progressing.\u001b[22m Then a slow but working ar\u001b[83Gival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ How is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[46C\u001b[20B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.702, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 7m 20s · done 3:59 pm\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[4C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMost games avoid this problem rather than solve it. The last few hundred metres of\u001b[88G approach are rarely flown\u001b[115Gon\u001b[K\r\u001b[2C\u001b[1Bgeneral\u001b[11Gsteer\u001b[18Gg; they follow a fixed\u001b[41Gc\u001b[43Grridor, a\u001b[53Gspe\u001b[57Gd limit,\u001b[66Gor a script. These are my recollec\u001b[104Gs, \u001b[108Got checked\u001b[K\r\u001b[2C\u001b[1Bagainst sources:\u001b[20G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo physical approach (EVE Online):\u001b[22m once the ship is within range, docking\u001b[79Gis \u001b[83Gnstant.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[60G\u001b[22mthe\u001b[64Gautopilot\u001b[74Gflies\u001b[80Gto\u001b[83Ga\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[4C\u001b[1Banimation\u001b[15Gtakes\u001b[21Gover.\u001b[27GPhysics\u001b[35Gonly\u001b[40Ggets\u001b[45Gthe\u001b[49Gship\u001b[54Gto\u001b[57Gthe\u001b[61Gstart\u001b[67Gof\u001b[70Gthe\u001b[74Gcorridor.\r\u001b[2C\u001b[1B- \u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[62G\u001b[22mstations\u001b[71Gcarry\u001b[77Gauthored\u001b[86Gapproach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B  holding point, then approach point, then pad along a path, with obstacle avoidance relaxed against\u001b[104Gthe station\u001b[K\r\u001b[4C\u001b[1Bitself on the final leg. Stuck\u001b[39Gcircling ships still turn up\u001b[68Gin the\u001b[75Gr bug reports.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mAssis\u001b[11Ged m\u001b[16Gnual docking (Elite D\u001b[39Ggerous):\u001b[22m you request permission and get a\u001b[81Gpad,\u001b[86Gand th\u001b[93G p\u001b[96Grm\u001b[99Gssion lapses\u001b[112Gif you\u001b[K\r\u001b[4C\u001b[1Bd\u001b[8G'\u001b[10G land in tim\u001b[23G; that's\u001b[32Gthe\u001b[36Gsame\u001b[41Grole\u001b[46Gas\u001b[49Gour\u001b[53Greservation.\u001b[66GA\u001b[68Gspeed\u001b[74Glimit\u001b[80Gapplies\u001b[88Gnear\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B  computer flies a fixed approach \u001b[38Gn thr\u001b[44Gugh\u001b[48Gthe entrance.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mGeneral autopilot\u001b[23G(Space Engineer\u001b[39G):\u001b[22m the remote-control\u001b[62Gutopilot is known\u001b[80Gfo\u001b[83G circling or overshooting\u001b[109Gi\u001b[111Gs\u001b[K\r\u001b[4C\u001b[1Bwaypoints.\u001b[16GPlayers\u001b[24Gwork\u001b[29Garound\u001b[36Git\u001b[39Gwith\u001b[44Ga\u001b[46Gslow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
