[0.149, "o", "\u001b[?25l\u001b[H\u001b[3G  \u001b[6Git's low, for example when your local\u001b[44GAI is \u001b[51Goaded\u001b[57Gand\u001b[61G3.4 GB is free.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSplit the fixture suite into one test entry per test case,\u001b[22m so its\u001b[72Gcases run \u001b[83Gide by side. The sanitiser tests\u001b[116Gt\r\u001b[5C\u001b[1Btake\u001b[11Gabout 60\u001b[20Gto 75 s\u001b[28Ginstead of 144.\u001b[44GWith step 2,\u001b[57Gthe\u001b[61Gwhole gate would\u001b[78Gbe\u001b[81Gabout\u001b[87G2\u001b[89Gto\u001b[92G2.5\u001b[96Gminutes.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mClose\u001b[12Ga gap I found:\u001b[22m my local gates haven't been running clang-\u001b[70Gidy at all.\u001b[82GThe flag I passed\u001b[100Gonly sets\u001b[111Ghe numb\u001b[119Gr\r\u001b[5C\u001b[1Bof tidy jobs;\u001b[20GCI\u001b[23Grun\u001b[28Gtidy, but my gates didn't. I'd add tidy to every gate. It skips\u001b[92Gfiles that were\u001b[108Gclean\u001b[114Gand\r\u001b[2C\u001b[1B  \u001b[6Ghaven't changed, so it costs lit\u001b[39Gle.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[2B\u001b[22m- \u001b[1mManifes\u001b[13G:\u001b[22m nothing in its gate is engine-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[4C\u001b[1Bcandidates:\r\u001b[2C\u001b[1B \u001b[5G- The terminal-free build's tests repeat the debug te\u001b[59Gts on\u001b[65Gthe sam\u001b[73G game code.\u001b[K\r\u001b[4C\u001b[1B- The debug\u001b[17Gtests\u001b[23Grepeat\u001b[30Gthe\u001b[34Gsanitiser\u001b[44Gtests.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce th\u001b[13G build\u001b[20G run at \u001b[29Ghe same time, neither\u001b[51Gstage\u001b[57Gis\u001b[60Gthe\u001b[64Gslowest,\u001b[73Gso\u001b[76Gskipping\u001b[85Gthem\u001b[90Gsaves\u001b[96Galmost\u001b[103Gno\u001b[106Gtime.\u001b[112GI'd\u001b[116Gkeep\r\u001b[4C\u001b[1Bboth.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocumentation-only commits\u001b[32G\u001b[22malr\u001b[36Gady skip the gate automa\u001b[61Gical\u001b[66Gy, because the gate ignores \u001b[38;2;177;185;249m.md\u001b[39m files when deciding\u001b[K\r\u001b[4C\u001b[1Bwhether\u001b[13Ganything\u001b[22Gchanged.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.300, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[18B\u001b[1mJettison\u001b[22m,\u001b[15Gwhich\u001b[21Gonly\u001b[26Gmatters\u001b[34Gwhen\u001b[39GManifest\u001b[48Gneeds\u001b[54Ga\u001b[56Gnew\u001b[60Gengine\u001b[67Gversion:\u001b[76Gthe\u001b[80Grendering\u001b[90Gsmoke\u001b[96Gtests\u001b[102Gand\u001b[106Greference\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.151, "o", "\u001b[?25l\u001b[H\u001b[6Gtake\u001b[11Gabout 60\u001b[20Gto 75 s\u001b[28Ginstead of 144.\u001b[44GWith step 2,\u001b[57Gthe\u001b[61Gwhole gate would\u001b[78Gbe\u001b[81Gabout\u001b[87G2\u001b[89Gto\u001b[92G2.5\u001b[96Gminutes.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mClose\u001b[12Ga gap I found:\u001b[22m my local gates haven't been running clang-\u001b[70Gidy at all.\u001b[82GThe flag I passed\u001b[100Gonly sets\u001b[111Ghe numb\u001b[119Gr\r\u001b[5C\u001b[1Bof tidy jobs;\u001b[20GCI\u001b[23Grun\u001b[28Gtidy, but my gates didn't. I'd add tidy to every gate. It skips\u001b[92Gfiles that were\u001b[108Gclean\u001b[114Gand\r\u001b[2C\u001b[1B  \u001b[6Ghaven't changed, so it costs lit\u001b[39Gle.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[2B\u001b[22m- \u001b[1mManifes\u001b[13G:\u001b[22m nothing in its gate is engine-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[4C\u001b[1Bcandidates:\r\u001b[2C\u001b[1B \u001b[5G- The terminal-free build's tests repeat the debug te\u001b[59Gts on\u001b[65Gthe sam\u001b[73G game code.\u001b[K\r\u001b[4C\u001b[1B- The debug\u001b[17Gtests\u001b[23Grepeat\u001b[30Gthe\u001b[34Gsanitiser\u001b[44Gtests.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce th\u001b[13G build\u001b[20G run at \u001b[29Ghe same time, neither\u001b[51Gstage\u001b[57Gis\u001b[60Gthe\u001b[64Gslowest,\u001b[73Gso\u001b[76Gskipping\u001b[85Gthem\u001b[90Gsaves\u001b[96Galmost\u001b[103Gno\u001b[106Gtime.\u001b[112GI'd\u001b[116Gkeep\r\u001b[4C\u001b[1Bboth.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocumentation-only commits\u001b[32G\u001b[22malr\u001b[36Gady skip the gate automa\u001b[61Gical\u001b[66Gy, because the gate ignores \u001b[38;2;177;185;249m.md\u001b[39m files when deciding\u001b[K\r\u001b[4C\u001b[1Bwhether\u001b[13Ganything\u001b[22Gchanged.\r\u001b[4C\u001b[1B\u001b[1mJettison\u001b[22m, which only matters when Man\u001b[43Gfest needs\u001b[55G new engine version: the rend\u001b[85Gr\u001b[87Gng smoke tests and reference\u001b[K\r\u001b[4C\u001b[1Bframes are about\u001b[22Gtwo thirds\u001b[33Gof\u001b[36Gits\u001b[40Ggate.\r\u001b[2C\u001b[1B \u001b[5G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
