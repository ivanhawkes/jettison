[0.040, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSlice\u001b[9G5\u001b[11Gis\u001b[14Gcommitted\u001b[24Gas\u001b[27GManifest\u001b[36G\u001b[38;2;177;185;249ma1be7ef\u001b[39m,\u001b[45Gwith\u001b[50Gthe\u001b[54Ggate\u001b[59Ggreen\u001b[65G(\u001b[38;2;177;185;249m--werror --asan\u001b[39m,\u001b[83G48/48).\u001b[91GNothing\u001b[99Gis\u001b[102Gpushed.\u001b[110GOne\r\u001b[1B \u001b[3Gacceptance\u001b[14Gite\u001b[18G, \"a blocked job's wait passed over\u001b[54Gby the fast-forward\", couldn't be met yet and move\u001b[105G to L28.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe new \u001b[38;2;177;185;249mfixture\u001b[39m test:\r\u001b[2C\u001b[1B\u001b[22m- A new test overlay,\u001b[25G\u001b[38;2;177;185;249mone-trader\u001b[39m,\u001b[37Gadds\u001b[42Gan\u001b[45GNPC\u001b[49Gtrader,\u001b[57GNia,\u001b[62Gto\u001b[65Gthe\u001b[69Gtrading\u001b[77Gscenario.\u001b[87GAda's\u001b[93Gship\u001b[98Ggets\u001b[103Gits\u001b[107Gtrading\u001b[115Gpolicy\r\u001b[2C\u001b[1B \u001b[5Gwith on\u001b[13G command, and no command follows.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe w\u001b[11Grld then runs 25 minutes of simulation\u001b[50Gthe\u001b[54Gway\u001b[58Gthe\u001b[62Gserver's\u001b[71Gloop\u001b[76Gruns\u001b[81Git,\u001b[85Gskipping\u001b[94Gsteps\u001b[100Gwhere\u001b[106Git\u001b[109Gcan.\u001b[114GBoth\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gips buy\u001b[15Gand sell on their own, and both finish\u001b[55Gith more cr\u001b[67Gdits than they started with.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[7Ge world\u001b[15Gis saved\u001b[24Gwith Ada's cargo on its way to the\u001b[59Gbuy\u001b[63Gr, loaded into a fresh world, and\u001b[97Grun\u001b[101Gto\u001b[104Gthe\u001b[108Gend.\u001b[113GIt\r\u001b[2C\u001b[1B \u001b[5Greaches the same state as the\u001b[35Gori\u001b[39Ginal.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt is also replayed from the start one step\u001b[49Gat\u001b[52Ga\u001b[54Gtime,\u001b[60Gwith\u