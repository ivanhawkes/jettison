[0.121, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;2;215;119;87m*\u001b[3GScampering\u001b[38;2;235;159;127m…\u001b[38;2;215;119;87m \u001b[40G\u001b[38;2;193;193;193mthinking with high effort\u001b[38;2;153;153;153m)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;2;215;119;87m✢\u001b[12G\u001b[38;2;235;159;127mg\u001b[40G\u001b[38;2;153;153;153mthought for 37s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.079, "o", "\u001b[?25l\u001b[H  │ sanitisers                     │ 210 s │ build about 66 s, tests 144 s        │\u001b[K\r\u001b[1B  └────────────────────────────────┴───────┴──────────────────────────────────────┘\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  The sanitiser run is the long pole, and within it the fixture suite. The fixture suite has only 4 test cases, and two\u001b[K\r\u001b[1B  of them take 13 s and 7 s of its 25 s in debug. Under the sanitisers, the next slowest are content (60 s) and travel\u001b[K\r\u001b[1B  (31 s).\u001b[K\r\u001b[2B  \u001b[1mSpeed-ups that keep every check\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mGate a separate copy (biggest saving).\u001b[45G\u001b[22mKeep\u001b[50Ga\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbeside\u001b[75GManifest\u001b[84Gwith\u001b[89Gits\u001b[93Gown\u001b[97Gbuild\u001b[103Gfolders.\u001b[112GI\u001b[114Gcommit\r\u001b[5C\u001b[1Ba\u001b[8Gslice,\u001b[15Gpoint\u001b[21Gthe\u001b[25Gsecond\u001b[32Gcheckout\u001b[41Gat\u001b[44Gthat\u001b[49Gcommit,\u001b[57Grun\u001b[61Gthe\u001b[65Ggate\u001b[70Gthere\u001b[76Gin\u001b[79Gthe\u001b[83Gbackground,\u001b[95Gand\u001b[99Gstart\u001b[105Gthe\u001b[109Gnext\u001b[114Gslice\r\u001b[1B \u001b[3G   \u001b[7Gt\u001b[9Gai\u001b[12Gh\u001b[14G away. If the gate\u001b[33Gfails, the fix is the next commit, before you push.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B   -\u001b[8GThe\u001b[12Gfir\u001b[16Gt run there\u001b[28Gis\u001b[31Gslow,\u001b[37Gbecause\u001b[45Git\u001b[48Gbuilds\u001b[55Geverything\u001b[66Gfrom\u001b[71Gscratch;\u001b[80Glater\u001b[86Gruns\u001b[91Gonly\u001b[96Grebuild\u001b[104Gwhat\u001b[109Gchanged.\u001b[118GIt\r\u001b[7C\u001b[1Btakes\u001b[14Gabout\u001b[20G14\u001b[23GGB\u001b[26Gof\u001b[29Gdisk.\r\u001b[1B \u001b[3G   - Stage cross-rev\u001b[24Gews could run on that\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[1B  2. \u001b[1mRun the four builds at the same time.\u001b[22m They already use separate build folders, so the gate's time becomes the\u001b[K\r\u001b[5C\u001b[1Bsanitiser build's, about 3.5\u001b[35Gminutes.\u001b[44GThe\u001b[48Gscript\u001b[55Gwould\u001b[61Gcheck\u001b[67Gfree\u001b[72Gmemory\u001b[79Gfirst\u001b[85Gand\u001b[89Gfall\u001b[94Gback\u001b[99Gto\u001b[102Gone\u001b[106Gat\u001b[109Ga\u001b[111Gtime\u001b[116Gwhen\r\u001b[5C\u001b[1Bit's\u001b[11Glow,\u001b[16Gfor\u001b[20Gexample\u001b[28Gwhen\u001b[33Gyour\u001b[38Glocal\u001b[44GAI\u001b[47Gis\u001b[50Gloaded\u001b[57Gand\u001b[61G3.4\u001b[65GGB\u001b[68Gis\u001b[71Gfree.\r\u001b[1B  3. \u001b[1mSplit the fixture suite into one test entry per test case,\u001b[22m so its cases run side by side. The sanitiser tests then\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ don't run anything in parallel with either clang or clang-tidy\u001b[39m                                                        \u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.113, "o", "\u001b]0;◑ jettison-0010\u0007"]
[0.124, "o", "\u001b[?25l\u001b[H\r\u001b[29C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m5\u001b[48G9\u001b[50G2\u001b[54G6\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.195, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BThe sanitiser run is the long pole, and within it the fixture suite. The fixture suite\u001b[90Ghas\u001b[94Gonly\u001b[99G4\u001b[101Gtest\u001b[106Gcases,\u001b[113Gand\u001b[117Gtwo\r\u001b[2C\u001b[1Bof\u001b[6Gthem\u001b[11Gtake\u001b[16G13\u001b[19Gs\u001b[21Gand\u001b[25G7\u001b[27Gs\u001b[29Gof\u001b[32Gits\u001b[36G25\u001b[39Gs\u001b[41Gin\u001b[44Gdebug.\u001b[51GUnder\u001b[57Gthe\u001b[61Gsanitisers,\u001b[73Gthe\u001b[77Gnext\u001b[82Gslowest\u001b[90Gare\u001b[94Gcontent\u001b[102G(60\u001b[106Gs)\u001b[109Gand\u001b[113Gtravel\r\u001b[2C\u001b[1B(31\u001b[8G).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed-ups that keep every check\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[1mGate a\u001b[13Gseparat\u001b[21G copy (biggest saving).\u001b[45G\u001b[22mKeep\u001b[50Ga\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbeside\u001b[75GManifest\u001b[84Gwith\u001b[89Gits\u001b[93Gown\u001b[97Gbuild\u001b[103Gfolders.\u001b[112GI\u001b[114Gcommit\r\u001b[5C\u001b[1Ba\u001b[8Gslice,\u001b[15Gpoint\u001b[21Gthe\u001b[25Gsecond\u001b[32Gcheckout\u001b[41Gat\u001b[44Gthat\u001b[49Gcommit,\u001b[57Grun\u001b[61Gthe\u001b[65Ggate\u001b[70Gthere\u001b[76Gin\u001b[79Gthe\u001b[83Gbackground,\u001b[95Gand\u001b[99Gstart\u001b[105Gthe\u001b[109Gnext\u001b[114Gslice\r\u001b[2C\u001b[1B  \u001b[6Gstraight away. If the gate fails, the fix is th\u001b[54G next commit,\u001b[70Gfor\u001b[75Gyou pu\u001b[82Gh.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GThe first run ther\u001b[27G is slow, because it builds everything from sc\u001b[74Gatch; later runs only rebuild what\u001b[109Gchanged. It\r\u001b[5C\u001b[1B  t\u001b[10Gkes about 14 GB of disk.\u001b[K\r\u001b[7C\u001b[1BStage cross-revi\u001b[25Gws\u001b[28Gcould run on that copy too, so the\u001b[63Gr 10-minute rounds no longer b\u001b[94Gock work.\u001b[104G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[44G\u001b[22mThey\u001b[49Galready\u001b[57Guse\u001b[61Gseparate\u001b[70Gbuild\u001b[76Gfolders,\u001b[85Gso\u001b[88Gthe\u001b[92Ggate's\u001b[99Gtime\u001b[104Gbecomes\u001b[112Gthe\r\u001b[5C\u001b[1Bsanitiser build's, about 3.5 minutes. The script would check free m\u001b[74Gmory first\u001b[85Gand fall back to one\u001b[106Gat\u001b[109Ga\u001b[111Gtime\u001b[116Gwhen\r\u001b[2C\u001b[1B  \u001b[6Git's low, for example when your local\u001b[44GAI is \u001b[51Goaded\u001b[57Gand\u001b[61G3.4 GB is free.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSplit the fixture suite into one test entry per test case,\u001b[22m so its\u001b[72Gcases run \u001b[83Gide by side. The sanitiser tests\u001b[116Gt\r\u001b[5C\u001b[1Btake\u001b[11Gabout 60\u001b[20Gto 75 s\u001b[28Ginstead of 144.\u001b[44GWith step 2,\u001b[57Gthe\u001b[61Gwhole gate would\u001b[78Gbe\u001b[81Gabout\u001b[87G2\u001b[89Gto\u001b[92G2.5\u001b[96Gminutes.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.499, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[18B\u001b[1mClose a gap I found:\u001b[27G\u001b[22mmy\u001b[30Glocal\u001b[36Ggates\u001b[42Ghaven't\u001b[50Gbeen\u001b[55Grunning\u001b[63Gclang-tidy\u001b[74Gat\u001b[77Gall.\u001b[82GThe\u001b[86Gflag\u001b[91GI\u001b[93Gpassed\u001b[100Gonly\u001b[105Gsets\u001b[110Gthe\u001b[114Gnumber\u001b[27;1H\u001b[24;3H\u001b[?25h"]
