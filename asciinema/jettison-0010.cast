[0.268, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[60G\u001b[22mthe\u001b[64Gautopilot\u001b[74Gflies\u001b[80Gto\u001b[83Ga\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only\u001b[40Ggets\u001b[54Gto\u001b[57Gthe sta\u001b[65Gt of the corridor.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mApproach\u001b[14Gcorridors (X4, Star Citizen's traffic\u001b[52Gcontrol):\u001b[22m st\u001b[65Gti\u001b[68Gns carry auth\u001b[82Gred appr\u001b[91Gach paths. A ship flies\r\u001b[4C\u001b[1Bholding point, then approach p\u001b[36Gint, then pad along a path, with obsta\u001b[75Gle av\u001b[81Gidance\u001b[88Grelaxed\u001b[96Gagainst\u001b[104Gthe\u001b[108Gstation\r\u001b[2C\u001b[1B \u001b[5Gitself on the final leg. Stuck or circling ships still turn up in\u001b[71Gtheir\u001b[77Gb\u001b[79Gg reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[22m you request permission and g\u001b[77Gt a pad, and the permission lap\u001b[109Ges \u001b[113Gf you\r\u001b[4C\u001b[1Bdon't la\u001b[14Gd in\u001b[19Gt\u001b[21Gme;\u001b[25Gthat's the\u001b[36Gsame \u001b[42Go\u001b[44Ge as our reserva\u001b[61Gio\u001b[64G. A\u001b[68Gspeed limit applies near\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B \u001b[5Gcomputer flies a fixed approach in through\u001b[48Gthe\u001b[52Gentrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m th\u001b[46Grem\u001b[50Gte-cont\u001b[58Gol autopilot is\u001b[74Gknown\u001b[80Gfor circling\u001b[93Gor oversh\u001b[103Goting i\u001b[111Gs\u001b[K\r\u001b[4C\u001b[1Bway\u001b[9Goints. Players work around it with a slow precision mode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[2C\u001b[1B \u001b[5Greason the others constrain the last\u001b[42Gleg.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games c\u001b[17Gmbine\u001b[23Gf\u001b[25Gur techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[47G\u001b[22mBring\u001b[53Gthe\u001b[57Gship\u001b[62Gto\u001b[65Ga\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gthe\u001b[87Gpad's\u001b[93Gnormal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B   \u001b[7Go\u001b[9Gany overshoot\u001b[23Gheads toward or away\u001b[44Gfrom\u001b[49Gthe\u001b[53Gstation\u001b[61Grather\u001b[68Gthan\u001b[73Gsideways\u001b[82Ginto\u001b[87Gan\u001b[90Gorbit.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mDon't treat the destination as a\u001b[39G obstacle on the final leg.\u001b[67G\u001b[22mWe already d\u001b[80G this when descending (\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut not\u001b[K\r\u001b[5C\u001b[1Bon\u001b[9Gthe\u001b[13Ginbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near th\u001b[24G station.\u001b[22m Arrive slowly enough to stop well short of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[2C\u001b[1B  \u001b[6Gdropped.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.448, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Ganimation takes over. Physics only gets the ship to the start \u001b[68Gf the\u001b[74Gcorridor.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m sta\u001b[66Gi\u001b[68Gns carry authored\u001b[86Gapproach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B \u001b[5Gholding point, then approach point, then pad along a path, with obstacle avoidance rel\u001b[92Gxed \u001b[97Ggainst\u001b[104Gt\u001b[106Ge station\r\u001b[4C\u001b[1Bitself on the final\u001b[25Gleg. Stuck or circling ships still \u001b[61Gurn up in their bug reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[48G\u001b[22myou request\u001b[60Gpe\u001b[63Gmissio\u001b[71Gand get a\u001b[81Gpad, and\u001b[90Gthe\u001b[94Gpermission\u001b[105Glapses\u001b[112Gif\u001b[115Gyou\r\u001b[2C\u001b[1B \u001b[5Gdon't land in time; that's the same role as \u001b[51Gr res\u001b[57Grvation. A speed limit a\u001b[82Gplies near th\u001b[96G stat\u001b[104G, \u001b[107Gnd the docking\r\u001b[4C\u001b[1Bc\u001b[7Gmputer fl\u001b[17Ges a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the remote-control autopilot\u001b[71Gis\u001b[74Gknown\u001b[80Gfor\u001b[84Gcircling\u001b[93Gor\u001b[96Govershooting\u001b[109Gits\r\u001b[2C\u001b[1B \u001b[5Gwaypoints. Players work around it with a\u001b[46Gslow precisi\u001b[59Gn\u001b[61Gmode or \u001b[70Gheir own scripts. That\u001b[93Gis\u001b[97Gur failure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breas\u001b[10Gn \u001b[13Ghe\u001b[16Gothers constr\u001b[30Gin the last leg.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Ggames\u001b[15Gcombine\u001b[23Gfour\u001b[28Gtechniques:\r\u001b[2C\u001b[1B1. \u001b[1mMake the final approach one-dimensional.\u001b[47G\u001b[22mBring\u001b[53Gthe\u001b[57Gship\u001b[62Gto\u001b[65Ga\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gthe\u001b[87Gpad's\u001b[93Gnormal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the\u001b[53Gstation rather than\u001b[73Gsideways into\u001b[87Gan orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[22m We \u001b[71Glrea\u001b[76Gy do this when descending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSlow down near the station.\u001b[34G\u001b[22mArrive\u001b[41Gslowly\u001b[48Genough\u001b[55Gto\u001b[58Gstop\u001b[63Gwell\u001b[68Gshort\u001b[74Gof\u001b[77Ganything.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mLapse a pad only when \u001b[29Ghe ship isn't progressing.\u001b[22m Then a\u001b[63Gslow\u001b[68Gbut working arrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[2C\u001b[1B  \u001b[6Gdropped.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for us:\u001b[23G\u001b[22mthe\u001b[27Gfirst\u001b[33Gtechnique,\u001b[44Gin\u001b[47GJettison's\u001b[58Gdocks.\u001b[65GAdd\u001b[69Gan\u001b[72Gapproach\u001b[81Gpoint\u001b[87Gon\u001b[90Gthe\u001b[94Gpad's\u001b[100Gnormal,\u001b[108Gbeyond\u001b[115Gthe\u001b[27;1H\u001b[24;3H\u001b[?25h"]
