[0.063, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat goes wrong:\r\u001b[2C\u001b[1B\u001b[22m- The docks fly an\u001b[22Ginbound\u001b[30Gship\u001b[35Gto\u001b[38Ga\u001b[40Gpoint\u001b[46Gabove\u001b[52Gits\u001b[56Gpad.\u001b[61GThat\u001b[66Gpoint\u001b[72Gis\u001b[75Gonly\u001b[80G10\u001b[83Gm\u001b[85Goutside\u001b[93Gthe\u001b[97Gzone\u001b[102Gsteering\u001b[111Gkeeps\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gip away\u001b[16Grom around the stati\u001b[37Gn (\u001b[38;2;177;185;249mkAboveMargin = 10.0\u001b[39m in \u001b[38;2;177;185;249mDocks.cpp\u001b[39m).\u001b[75GThe ship only has\u001b[94Go get within 20 m of the\u001b[K\r\u001b[4C\u001b[1Bpo\u001b[8Gnt to ar\u001b[17Give, so the arrival zone already reaches into\u001b[63Gthe keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSh\u001b[8Gp2\u001b[11Greached Ore \u001b[24Gn the far side, so it was\u001b[51Gouted around the station through\u001b[84Ga\u001b[86Gwaypoint.\u001b[96GIt\u001b[99Gcame\u001b[104Goff\u001b[108Gthe\u001b[112Gwaypoint\r\u001b[2C\u001b[1B \u001b[5Gat about 100 m/s,\u001b[23Gmoving\u001b[30Gsideways to the\u001b[46Gt\u001b[48Grget, and overshot by \u001b[71Gbout\u001b[76G50 m into\u001b[86Gthe keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GInside \u001b[13Ghat zone\u001b[23Gavo\u001b[27Gdance commands\u001b[42Gup to about\u001b[54G190\u001b[58Gm/s outward\u001b[70Gwhile\u001b[76Garrival pulls\u001b[90Gth\u001b[93G ship back in.\u001b[108GThat\u001b[113Gputs\r\u001b[2C\u001b[1B \u001b[5Ge\u001b[7Gergy\u001b[12Gback\u001b[17Gin \u001b[21Gvery lap: the ship circled\u001b[48G30–55\u001b[54Gm from the point at about 40 m/s for the pad's full 300 s,\u001b[113Gnever\r\u001b[4C\u001b[1Barrived, and th\u001b[21G pad\u001b[29Gsed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GShip1 came in through \u001b[28G waypoint\u001b[38Gtoo\u001b[42Gand\u001b[46Garrived;\u001b[55Gits\u001b[59Ggeometry\u001b[68Ghappened\u001b[77Gnot\u001b[81Gto\u001b[84Govershoot.\r\u001b[2C\u001b