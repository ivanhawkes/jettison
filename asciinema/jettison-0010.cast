[0.024, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[2m7\u001b[9G\u001b[22mgates had left to CI,\u001b[31Gand runs in a\u001b[45Gs\u001b[47Gcond\u001b[52Gcheckout, build/gate\u001b[73Gtree, whil\u001b[85Gthe\u001b[89Gnext\u001b[94Gchange is\u001b[K\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22mwr\u001b[12Gtten,\u001b[18Gwith nothing\u001b[31Gelse\u001b[36Gbuilding\u001b[45Gbeside\u001b[52Git\u001b[55G(the\u001b[60Guser's,\u001b[68G2026-11-21).\u001b[81GThe\u001b[85GW18\u001b[89Gplan\u001b[94Ggates\u001b[100Gafter\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[22mslices 3\u001b[18Gand\u001b[22G5.\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +2 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m4\u001b[22m shell commands · \u001b[38;2;255;107;128m1 failed\u001b[38;2;153;153;153m \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe first gate in the\u001b[25Gsecond checkout finished \u001b[51Gn about 15 minutes, mostly from a cold\u001b[90Gbuild, and the sanitiser tests\r\u001b[2C\u001b[1Bdropped from\u001b[16G144\u001b[20Gs\u001b[22Gto\u001b[25G79\u001b[28Gs.\u001b[31GTidy\u001b[36Gflagged\u001b[44Gone\u001b[48Gexisting\u001b[57Gissue\u001b[63Gat\u001b[66GPolicy.cpp:673,\u001b[82Gand\u001b[86GI'm\u001b[90Gchecking\u001b[99Gfor\u001b[103Gothers\u001b[110Gnow.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mO\u001b[5Ge finding,\u001b[16Gand\u001b[20GCI\u001b[23Gwould\u001b[29Ghave\u001b[34Gfailed\u001b[41Gon\u001b[44Git\u001b[47Gat\u001b[50Gthe\u001b[54Gnext\u001b[59Gpush.\u001b[65GFixing\u001b[72Git\u001b[75Gand\u001b[79Ggating\u001b[86Gagain;\u001b[93Gthis\u001b[98Gtime\u001b[103Gthe\u001b[107Gbuild\u001b[113Gis\r\u001b[2C\u001b[1Bincremental.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/manifest/build/gate-tree'…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/project\u001b[31G/manifest/build/gate-tree' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24\u001b[115G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mMANIFEST_TIDY_JOBS=24 ./scripts/ci.sh --werror --asan --tidy --log build/gate-2.log > build/gate-2.out 2>&1; echo \r\u001b[5C\u001b[1Bexit $?; tail -4 build/gate-2.out (43s)\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
