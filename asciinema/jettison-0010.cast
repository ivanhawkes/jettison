[0.015, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[17B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m❯ /update-config              Change settings: hooks, permissions, environment variables\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /ponytail:ponytail-audit    (ponytail) Quality audit of a whole repo: bugs, security holes, what breaks under real\r\u001b[1B\u001b[39m \u001b[3G                             \u001b[33G\u001b[38;2;153;153;153mload, risky code without tests, slow paths, and what to delete, merge or split. Ranke…\r\u001b[2C\u001b[1B  /statusline                 Set up the status line\r\u001b[2C\u001b[2B\u001b[39m/\u001b[K\r\u001b[38C\u001b[3B\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
[0.391, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[17B\u001b[38;2;177;185;249m❯ /\u001b[1mc\u001b[22md                         Move this session to a new working dire\u001b[1mc\u001b[22mtory\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1mc\u001b[22m\u001b[38;2;153;153;153mopy                       \u001b[39m\u001b[1mC\u001b[22m\u001b[38;2;153;153;153mopy the last response to clipboard (/copy 2 for the one before)\r\u001b[5C\u001b[1B\u001b[39m\u001b[1mc\u001b[22m\u001b[38;2;153;153;153mlear                  \u001b[33GStart \u001b[40G new session with\u001b[58Gempty \u001b[39m\u001b[1mc\u001b[66G\u001b[22m\u001b[38;2;153;153;153mntext; loops carry over, and the old one \u001b[108Gtays in\u001b[39m\u001b[K\r\u001b[32C\u001b[1B\u001b[38;2;153;153;153m/resume\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[1mc\u001b[22m\u001b[38;2;153;153;153molor     \u001b[37Gthe prompt bar \u001b[39m\u001b[1mc\u001b[22m\u001b[38;2;153;153;153molor for this session\r\u001b[3C\u001b[2B\u001b[39mc\u001b[27;1H\u001b[24;5H\u001b[?25h"]
