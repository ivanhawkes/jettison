[47G\u001b[22mone\u001b[51Gper\u001b[55Gbuild\u001b[61Gvariant.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Ga\u001b[8Gflag\u001b[13Gfor\u001b[17GManifest-only\u001b[31Gchanges\u001b[39Gwould\u001b[45Gsave\u001b[50Gnothing,\u001b[59Gbecause\u001b[67Gnothing\u001b[75Gin\u001b[78Gthis\u001b[83Ggate\u001b[88Gis\u001b[91Gengine-only.\u001b[104GThese\u001b[110Gwould\u001b[116Ghelp\r\u001b[1B \u001b[3Ginstead:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBatching (no tooling change):\u001b[35G\u001b[22mgate\u001b[40Gtwo\u001b[44Gslices\u001b[51Gat\u001b[54Ga\u001b[56Gtime,\u001b[62Gas\u001b[65GI\u001b[67Gsuggested,\u001b[78Gso\u001b[81Gabout\u001b[87Ghalf\u001b[92Gthe\u001b[96Ggate\u001b[101Gruns.\r\u001b[1B  - \u001b[1mSplitting the fixture suite\u001b[22m into parts that run in parallel would bring the test stage closer to content's 60 s. It\u001b[K\r\u001b[4C\u001b[1Bwould\u001b[11Gbe\u001b[14Ga\u001b[16GManifest\u001b[25Gtest-layout\u001b[37Gchange,\u001b[45Gwith\u001b[50Gno\u001b[53Gchange\u001b[60Gto\u001b[63Gwhat\u001b[68Gis\u001b[71Gchecked.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
