r\u001b[2C\u001b[1B  \u001b[6Gof tidy jobs; CI runs tidy, but my gates didn't.\u001b[55GI'd add\u001b[63Gtidy to every\u001b[77Ggate. It\u001b[86Gskips file\u001b[97G that wer\u001b[107G clean\u001b[114Gand\u001b[K\r\u001b[5C\u001b[1Bhaven't\u001b[14Gchanged,\u001b[23Gso it costs little.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22mnothing\u001b[23Gin\u001b[26Gits\u001b[30Ggate\u001b[35Gis\u001b[38Gengine-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[2C\u001b[1B \u001b[5Gcandidates:\u001b[K\r\u001b[4C\u001b[1B- The terminal-free\u001b[25Gbuild's\u001b[33Gtests\u001b[39Grepeat\u001b[46Gthe\u001b[50Gdebug\u001b[56Gtests\u001b[62Gon\u001b[65Gthe\u001b[69Gsame\u001b[74Ggame\u001b[79Gcode.\r\u001b[10C\u001b[1Bd\u001b[13Gbug tests repeat the sanitiser \u001b[45Gests.\u001b[K\r\u001b[4C\u001b[1B \u001b[7G   \u001b[11G     \u001b[17G     \u001b[23G      \u001b[30G   \u001b[34G         \u001b[44G   \u001b[27;1H\u001b[24;3H\u001b[?25h"]
