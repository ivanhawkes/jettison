[0.024, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5GShip2 reached Ore\u001b[23Gon the\u001b[30Gfar side, so it\u001b[46Gw\u001b[48Gs routed around the st\u001b[71Gtion\u001b[76Gthrough a\u001b[86Gwaypoint. It came off\u001b[108Gthe\u001b[112Gwaypoint\r\u001b[2C\u001b[1B \u001b[5Gat abou\u001b[13G 100 m/s\u001b[23Gmov\u001b[27Gng sideways to\u001b[42Gthe target,\u001b[54Gand\u001b[58Govershot by\u001b[70Gabout\u001b[76G50 m into the\u001b[90Gke\u001b[93Gp-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gside\u001b[12Gthat\u001b[17Gzon\u001b[21G, avoidance commands up to\u001b[48Gabout\u001b[54G190 m/s outward while arrival pulls the ship back in. That\u001b[113Gputs\u001b[K\r\u001b[4C\u001b[1Benergy back in \u001b[21Gvery\u001b[29G: the\u001b[35Gship\u001b[40Gcircled\u001b[48G30–55\u001b[54Gm\u001b[56Gfrom\u001b[61Gthe\u001b[65Gpoint\u001b[71Gat\u001b[74Gabout\u001b[80G40\u001b[83Gm/s\u001b[87Gfor\u001b[91Gthe\u001b[95Gpad's\u001b[101Gfull\u001b[106G300\u001b[110Gs,\u001b[113Gnever\r\u001b[2C\u001b[1B \u001b[5Garrived, and the pad l\u001b[28Gpsed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GShip1\u001b[11Gcame\u001b[16Gin\u001b[19Gthrough\u001b[27Ga\u001b[29Gwaypoint\u001b[38Gtoo\u001b[42Gand\u001b[46Garrived;\u001b[55Gits\u001b[59Ggeometry\u001b[68Ghappened\u001b[77Gnot\u001b[81Gto\u001b[84Govershoot.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mI \u001b[22Gemporarily r\u001b[35Gised the margin\u001b[51Gto 100 m in the f\u001b[69Gtched\u001b[75Gengine copy and reran.\u001b[98GShip2 still overshot,\r\u001b[2C\u001b[1Bto about 180 m, but swu\u001b[27Gg back and\u001b[38Garrived 62 s after th\u001b[60G crui\u001b[66Ge\u001b[68Gended, about as\u001b[84Glong\u001b[89Gas\u001b[92Gother\u001b[98Garrivals\u001b[107Gtake,\u001b[113Gand\u001b[117Gno\r\u001b[2C\u001b[1Bpad\u001b[7Glapsed\u001b[14Gin\u001b[17Gthe\u001b[21G25\u001b[24Gminutes.\u001b[33GBoth\u001b[38Gedits\u001b[44Gand\u001b[48Gthe\u001b[52Gexperiment\u001b[63Gtest\u001b[68Gare\u001b[72Greverted.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposed fix (Jettison, dock):\u001b[22m widen\u001b[51Gs\u001b[56Gat the \u001b[64Ghip's arrival zone plus a f\u001b[92Gst arrival's overshoot stays\r\u001b[2C\u001b[1Bclear of the keep-away zone. I'\u001b[35G tie the m\u001b[46Grgi\u001b[51Gto the ship's braking distanc\u001b[81G rather than a fixed\u001b[102Gnumber, and add\u001b[118Ga\r\u001b[2C\u001b[1Bdock test:\u001b[14Gan inbound s\u001b[27Gip rounding\u001b[43Gstation from the far side at full spe\u001b[81Gd must arrive before the reservation\r\u001b[2C\u001b[1Blapses. I\u001b[14Gchanges flight paths,\u001b[36Gso \u001b[40Ghe world-hash pins in Jettison and Manifest's fixture pin will\u001b[103Gmove,\u001b[109Gand\u001b[113GI'll\r\u001b[2C\u001b[1Bcheck\u001b[9Gthat\u001b[14Gonly\u001b[19Gthose\u001b[25Gmoved.\u001b[32GOne\u001b[36GJettison\u001b[45Gcommit\u001b[52Gand\u001b[56Gone\u001b[60GManifest\u001b[69Gcommit,\u001b[77Geach\u001b[82Gwith\u001b[87Gthe\u001b[91Ggate\u001b[96Ggreen.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gdo\u001b[15Gthis\u001b[20Gfix\u001b[24Gbefore\u001b[31GL28,\u001b[36Gor\u001b[39Grecord\u001b[46Git\u001b[49Gand\u001b[53Ggo\u001b[56Gstraight\u001b[65Gto\u001b[68GL28?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gchecked\u001b[21Gwhether\u001b[29Ga\u001b[31G100\u001b[35Gm\u001b[37Gmargin\u001b[44Gcau\u001b[76Gads\u001b[80Gnear\u001b[85Ga\u001b[87Gneighbouring\u001b[100Gbody\u001b[105Gor\u001b[108Gdisplay\u001b[116Gpads.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
