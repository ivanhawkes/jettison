[0.346, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B- The first run there is \u001b[32Glow, because\u001b[45Git\u001b[48Gbuilds\u001b[55Geverything\u001b[66Gfrom\u001b[71Gscratch;\u001b[80Glater\u001b[86Gruns\u001b[91Gonly\u001b[96Grebuild\u001b[104Gwhat\u001b[109Gchanged.\u001b[118GIt\r\u001b[7C\u001b[1Btakes\u001b[14Gabout\u001b[20G14\u001b[23GGB\u001b[26Gof\u001b[29Gdisk.\r\u001b[2C\u001b[1B   - Stage cross-reviews could run on that\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[44G\u001b[22mThey\u001b[49Galready\u001b[57Guse\u001b[61Gseparate\u001b[70Gbuild\u001b[76Gfolders,\u001b[85Gso\u001b[88Gthe\u001b[92Ggate's\u001b[99Gtime\u001b[104Gbecomes\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5G sanitiser build's, about 3.5\u001b[35Gminutes. The script would check fr\u001b[70Ge memory fi\u001b[82Gst and fall back to one at \u001b[110G time when\r\u001b[4C\u001b[1B it's low, for\u001b[20Gexample\u001b[28Gwhen\u001b[33Gyour\u001b[38Glocal\u001b[44GAI\u001b[47Gis\u001b[50Gloaded\u001b[57Gand\u001b[61G3.4\u001b[65GGB\u001b[68Gis\u001b[71Gfree.\r\u001b[2C\u001b[1B3. \u001b[1mSplit the fixture suite into one test entry per test case,\u001b[65G\u001b[22mso its cases run side\u001b[87Gby\u001b[90Gside.\u001b[96GThe\u001b[100Gsanitiser\u001b[110Gtests\u001b[116Gthen\r\u001b[4C\u001b[1B tak\u001b[11Gabo\u001b[15Gt\u001b[17G60 \u001b[21Go\u001b[23G75 s inst\u001b[33Gad of 144.\u001b[44GWith step\u001b[54G2,\u001b[57Gthe\u001b[61Gwhole\u001b[67Ggate\u001b[72Gwould\u001b[78Gbe\u001b[81Gabout\u001b[87G2\u001b[89Gto\u001b[92G2.5\u001b[96Gminutes.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mClose a gap I found:\u001b[27G\u001b[22mmy\u001b[30Glocal\u001b[36Ggates\u001b[42Ghaven't\u001b[50Gbeen\u001b[55Grunning\u001b[63Gclang-tidy\u001b[74Gat\u001b[77Gall.\u001b[82GThe\u001b[86Gflag\u001b[91GI\u001b[93Gpassed\u001b[100Gonly\u001b[105Gsets\u001b[110Gthe\u001b[114Gnumber\r\u001b[4C\u001b[1B of tidy\u001b[14Gjobs; CI runs\u001b[29Gidy, but my gat\u001b[45Gs didn'\u001b[53G. I'd add tidy to every gate. It skip\u001b[91G files tha\u001b[103Gwere clean and\u001b[K\r\u001b[4C\u001b[1B haven't\u001b[14Gchanged,\u001b[23Gso\u001b[26Git\u001b[29Gcosts\u001b[35Glittle.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m nothing in\u001b[26Gits gate is en\u001b[41Gin\u001b[44G-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[4C\u001b[1Bcandidates:\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GT\u001b[9Ge terminal-fre\u001b[25Gbuild's\u001b[33Gtest\u001b[38G r\u001b[41Gpeat \u001b[47Ghe debug te\u001b[59Gts on th\u001b[68G same\u001b[74Ggame\u001b[79Gcode.\r\u001b[6C\u001b[1BThe debug \u001b[18Gests \u001b[24Gepeat the sani\u001b[39Giser tests.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce the builds run at the sam\u001b[36G time, n\u001b[45Git\u001b[76Gski\u001b[80Gping them \u001b[91Gaves almost no time.\u001b[112GI'd\u001b[116Gkeep\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.383, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gsanitiser run is the long pole,\u001b[39Gand\u001b[43Gwithin\u001b[50Git\u001b[53Gthe\u001b[57Gfixture\u001b[65Gsuite.\u001b[72GThe\u001b[76Gfixture\u001b[84Gsuite\u001b[90Ghas\u001b[94Gonly\u001b[99G4\u001b[101Gtest\u001b[106Gcases,\u001b[113Gand\u001b[117Gtwo\r\u001b[2C\u001b[1Bof\u001b[6Gthem take 13 s and 7 s \u001b[30Gf its 25 s\u001b[41Gin debug.\u001b[51GUnder the sanitisers, the next\u001b[82Gslowest are content (60\u001b[106Gs)\u001b[109Gand\u001b[113Gtravel\r\u001b[2C\u001b[1B(31 s).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed-ups that keep every check\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mGate a separate copy (biggest saving).\u001b[22m Keep a second checkout beside Manifest with\u001b[89Gits own build folders.\u001b[112GI\u001b[114Gcommit\r\u001b[2C\u001b[1B  \u001b[6Ga slice, point the second \u001b[33Gheckout at that commit, run the gate there in the background, and start\u001b[105Gthe next\u001b[114Gslic\u001b[119G\u001b[K\r\u001b[5C\u001b[1Bstra\u001b[11Gght away. \u001b[22Gf the\u001b[28Ggate fails, the fix \u001b[49Gs the\u001b[55Gnext comm\u001b[65Gt,\u001b[68Gbefor\u001b[74G \u001b[76Gou push.\u001b[K\r\u001b[5C\u001b[1B- The first run there is \u001b[32Glow, because\u001b[45Git\u001b[48Gbuilds\u001b[55Geverything\u001b[66Gfrom\u001b[71Gscratch;\u001b[80Glater\u001b[86Gruns\u001b[91Gonly\u001b[96Grebuild\u001b[104Gwhat\u001b[109Gchanged.\u001b[118GIt\r\u001b[7C\u001b[1Btakes\u001b[14Gabout\u001b[20G14\u001b[23GGB\u001b[26Gof\u001b[29Gdisk.\r\u001b[2C\u001b[1B   - Stage cross-reviews could run on that\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[44G\u001b[22mThey\u001b[49Galready\u001b[57Guse\u001b[61Gseparate\u001b[70Gbuild\u001b[76Gfolders,\u001b[85Gso\u001b[88Gthe\u001b[92Ggate's\u001b[99Gtime\u001b[104Gbecomes\u001b[112Gthe\r\u001b[2C\u001b[1B \u001b[5G sanitiser build's, about 3.5\u001b[35Gminutes. The script would check fr\u001b[70Ge memory fi\u001b[82Gst and fall back to one at \u001b[110G time when\r\u001b[4C\u001b[1B it's low, for\u001b[20Gexample\u001b[28Gwhen\u001b[33Gyour\u001b[38Glocal\u001b[44GAI\u001b[47Gis\u001b[50Gloaded\u001b[57Gand\u001b[61G3.4\u001b[65GGB\u001b[68Gis\u001b[71Gfree.\r\u001b[2C\u001b[1B3. \u001b[1mSplit the fixture suite into one test entry per test case,\u001b[65G\u001b[22mso its cases run side\u001b[87Gby\u001b[90Gside.\u001b[96GThe\u001b[100Gsanitiser\u001b[110Gtests\u001b[116Gthen\r\u001b[4C\u001b[1B tak\u001b[11Gabo\u001b[15Gt\u001b[17G60 \u001b[21Go\u001b[23G75 s inst\u001b[33Gad of 144.\u001b[44GWith step\u001b[54G2,\u001b[57Gthe\u001b[61Gwhole\u001b[67Ggate\u001b[72Gwould\u001b[78Gbe\u001b[81Gabout\u001b[87G2\u001b[89Gto\u001b[92G2.5\u001b[96Gminutes.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mClose a gap I found:\u001b[27G\u001b[22mmy\u001b[30Glocal\u001b[36Ggates\u001b[42Ghaven't\u001b[50Gbeen\u001b[55Grunning\u001b[63Gclang-tidy\u001b[74Gat\u001b[77Gall.\u001b[82GThe\u001b[86Gflag\u001b[91GI\u001b[93Gpassed\u001b[100Gonly\u001b[105Gsets\u001b[110Gthe\u001b[114Gnumber\r\u001b[4C\u001b[1B of tidy\u001b[14Gjobs; CI runs\u001b[29Gidy, but my gat\u001b[45Gs \u001b[76G gate. It skip\u001b[91G files tha\u001b[103Gwere clean and\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
