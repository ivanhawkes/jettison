[0.210, "o", "\u001b[?25l\u001b[H\u001b[3GThe\u001b[7Gsanitiser\u001b[17Grun\u001b[21Gis\u001b[24Gthe\u001b[28Glong\u001b[33Gpole,\u001b[39Gand\u001b[43Gwithin\u001b[50Git\u001b[53Gthe\u001b[57Gfixture\u001b[65Gsuite.\u001b[72GThe\u001b[76Gfixture\u001b[84Gsuite\u001b[90Ghas\u001b[94Gonly\u001b[99G4\u001b[101Gtest\u001b[106Gcases,\u001b[113Gand\u001b[117Gtwo\r\u001b[2C\u001b[1Bof them \u001b[12Gak\u001b[15G 13 s\u001b[21Gand 7 s \u001b[30Gf its 25\u001b[39Gs in debug. Under\u001b[57Gthe sanitisers, the next slowest\u001b[90Gare\u001b[94Gcontent (60\u001b[106Gs) and\u001b[113Gtravel\u001b[K\r\u001b[2C\u001b[1B(31 s).\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed-ups that keep every check\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mGate a separate copy (biggest saving).\u001b[45G\u001b[22mKeep\u001b[50Ga\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbeside\u001b[75GManifest\u001b[84Gwith\u001b[89Gits\u001b[93Gown\u001b[97Gbuild\u001b[103Gfolders.\u001b[112GI\u001b[114Gcommit\r\u001b[2C\u001b[1B  \u001b[6Ga slice, point the second checkout at that commit, run the gate there i\u001b[78G the background, and start th\u001b[108G next\u001b[114Gslice\u001b[K\r\u001b[5C\u001b[1Bstra\u001b[11Gght\u001b[15Gaway.\u001b[21GIf th\u001b[27G gate fails, the\u001b[44Gfix is the next commit, before you\u001b[79Gpush.\u001b[K\r\u001b[5C\u001b[1B- The first run ther\u001b[28Gis slow, because \u001b[46Gt\u001b[48Gbuilds\u001b[55Geverything from scratch; later\u001b[86Gruns\u001b[91Gonly\u001b[96Grebuild\u001b[104Gwhat\u001b[109Gchanged.\u001b[118GIt\r\u001b[5C\u001b[1B \u001b[8Gtakes about 14 GB of di\u001b[32Gk.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GStage\u001b[14Gcr\u001b[17Gss-reviews could run\u001b[38Gon\u001b[41Gthat\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[22m They already use separate b\u001b[72Gild fol\u001b[80Gers,\u001b[85Gs\u001b[87G the\u001b[92Ggate's time\u001b[104Gbecomes\u001b[112Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsanitiser build's, about 3.5 minutes.\u001b[47G script wo\u001b[58Gld\u001b[61Gcheck free memory fi\u001b[83Gt\u001b[85Gand fall back\u001b[100Go one at a tim\u001b[116Gwhen\r\u001b[5C\u001b[1Bit's low,\u001b[16Gfor example when your local\u001b[44GAI i\u001b[49G loaded an\u001b[61G3.4 GB is fr\u001b[74Ge.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSplit the fixture suite into one test entry per test case,\u001b[65G\u001b[22mso\u001b[69Gts cases\u001b[78Grun\u001b[82Gside\u001b[87Gby\u001b[90Gside.\u001b[96GThe\u001b[100Gsanitiser\u001b[110Gtests\u001b[116Gthen\r\u001b[2C\u001b[1B  \u001b[6Gtake about 60 to 75 s instead of 144. With step 2, the whole ga\u001b[70Ge\u001b[72Gwould\u001b[78Gbe about\u001b[87G2 to 2.5\u001b[96Gminutes.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mClose a gap I found:\u001b[22m my loc\u001b[34Gl\u001b[36Ggates haven't b\u001b[52Gen running c\u001b[65Gan\u001b[68G-\u001b[70Gidy at all. The flag I passed only\u001b[105Gsets\u001b[110Gthe\u001b[114Gnumber\r\u001b[2C\u001b[1B  \u001b[6Gof tidy jobs; CI runs tidy, but my gates didn't.\u001b[55GI'd add\u001b[63Gtidy to every\u001b[77Ggate. It\u001b[86Gskips file\u001b[97G that wer\u001b[107G clean\u001b[114Gand\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.150, "o", "\u001b[?25l\u001b[H\u001b[3G(31\u001b[8G).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed-ups that keep every check\r\u001b[2C\u001b[2B\u001b[22m1. \u001b[1mGate a\u001b[13Gseparat\u001b[21G copy (biggest saving).\u001b[45G\u001b[22mKeep\u001b[50Ga\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbeside\u001b[75GManifest\u001b[84Gwith\u001b[89Gits\u001b[93Gown\u001b[97Gbuild\u001b[103Gfolders.\u001b[112GI\u001b[114Gcommit\r\u001b[5C\u001b[1Ba\u001b[8Gslice,\u001b[15Gpoint\u001b[21Gthe\u001b[25Gsecond\u001b[32Gcheckout\u001b[41Gat\u001b[44Gthat\u001b[49Gcommit,\u001b[57Grun\u001b[61Gthe\u001b[65Ggate\u001b[70Gthere\u001b[76Gin\u001b[79Gthe\u001b[83Gbackground,\u001b[95Gand\u001b[99Gstart\u001b[105Gthe\u001b[109Gnext\u001b[114Gslice\r\u001b[2C\u001b[1B  \u001b[6Gstraight away. If the gate fails, the fix is th\u001b[54G next commit,\u001b[70Gfor\u001b[75Gyou pu\u001b[82Gh.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GThe first run ther\u001b[27G is slow, because it builds everything from sc\u001b[74Gatch; later runs only rebuild what\u001b[109Gchanged. It\r\u001b[5C\u001b[1B  t\u001b[10Gkes about 14 GB of disk.\u001b[K\r\u001b[7C\u001b[1BStage cross-revi\u001b[25Gws\u001b[28Gcould run on that copy too, so the\u001b[63Gr 10-minute rounds no longer b\u001b[94Gock work.\u001b[104G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[44G\u001b[22mThey\u001b[49Galready\u001b[57Guse\u001b[61Gseparate\u001b[70Gbuild\u001b[76Gfolders,\u001b[85Gso\u001b[88Gthe\u001b[92Ggate's\u001b[99Gtime\u001b[104Gbecomes\u001b[112Gthe\r\u001b[5C\u001b[1Bsanitiser build's, about 3.5 minutes. The script would check free m\u001b[74Gmory first\u001b[85Gand fall back to one\u001b[106Gat\u001b[109Ga\u001b[111Gtime\u001b[116Gwhen\r\u001b[2C\u001b[1B  \u001b[6Git's low, for example when your local\u001b[44GAI is \u001b[51Goaded\u001b[57Gand\u001b[61G3.4 GB is free.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSplit the fixture suite into one test entry per test case,\u001b[22m so its\u001b[72Gcases run \u001b[83Gide by side. The sanitiser tests\u001b[116Gt\r\u001b[5C\u001b[1Btake\u001b[11Gabout 60\u001b[20Gto 75 s\u001b[28Ginstead of 144.\u001b[44GWith step 2,\u001b[57Gthe\u001b[61Gwhole gate would\u001b[78Gbe\u001b[81Gabout\u001b[87G2\u001b[89Gto\u001b[92G2.5\u001b[96Gminutes.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mClose\u001b[12Ga gap I found:\u001b[22m my local gates haven't been running clang-\u001b[70Gidy at all.\u001b[82GThe flag I passed\u001b[100Gonly sets\u001b[111Ghe numb\u001b[119Gr\r\u001b[5C\u001b[1Bof tidy jobs;\u001b[20GCI\u001b[23Grun\u001b[28Gtidy, but my gates didn't. I'd add tidy to every gate. It skips\u001b[92Gfiles that were\u001b[108Gclean\u001b[114Gand\r\u001b[2C\u001b[1B  \u001b[6Ghaven't changed, so it costs lit\u001b[39Gle.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.151, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mGate a separate copy (biggest saving).\u001b[45G\u001b[22mKeep\u001b[50Ga\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbeside\u001b[75GManifest\u001b[84Gwith\u001b[89Gits\u001b[93Gown\u001b[97Gbuild\u001b[103Gfolders.\u001b[112GI\u001b[114Gcommit\r\u001b[2C\u001b[1B   a slice, point the second checkout\u001b[41Gat\u001b[44Gthat\u001b[49Gcommit,\u001b[57Grun\u001b[61Gthe\u001b[65Ggate\u001b[70Gthere\u001b[76Gin\u001b[79Gthe\u001b[83Gbackground,\u001b[95Gand\u001b[99Gstart\u001b[105Gthe\u001b[109Gnext\u001b[114Gslice\r\u001b[5C\u001b[1Bstraight\u001b[15Gaway.\u001b[21GIf\u001b[24Gthe\u001b[28Ggate\u001b[33Gfails,\u001b[40Gthe\u001b[44Gfix\u001b[48Gis\u001b[51Gthe\u001b[55Gnext\u001b[60Gcommit,\u001b[68Gbefore\u001b[75Gyou\u001b[79Gpush.\r\u001b[2C\u001b[1B  \u001b[6G- The first run there is slow, because\u001b[45Git builds everything from scratch; la\u001b[83Ger runs only rebuild what changed. I\r\u001b[5C\u001b[1B \u001b[8Gtakes ab\u001b[17Gut 14 GB of disk.\u001b[K\r\u001b[5C\u001b[1B- Sta\u001b[12Ge cross-reviews\u001b[28Gcould run on that copy\u001b[52Goo, so their 10-minut\u001b[75Gr\u001b[78Gnds no\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[22m They already use separate build folders, so the gate's t\u001b[101Gme\u001b[104Gbecomes th\u001b[115G\u001b[K\r\u001b[5C\u001b[1Bsaniti\u001b[13Ger b\u001b[18Gild's, about 3.5\u001b[35Gminutes.\u001b[44GThe\u001b[48Gscript\u001b[55Gwould\u001b[61Gcheck\u001b[67Gfree\u001b[72Gmemory\u001b[79Gfirst\u001b[85Gand\u001b[89Gfall\u001b[94Gback\u001b[99Gto\u001b[102Gone\u001b[106Gat\u001b[109Ga\u001b[111Gtime\u001b[116Gwhen\r\u001b[5C\u001b[1Bit's low, for example\u001b[28Gwhen yo\u001b[36Gr\u001b[38Glocal AI is loaded and 3.4\u001b[65GGB is fr\u001b[74Ge.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSpli\u001b[11G the fixt\u001b[21Gre \u001b[25Gui\u001b[28Ge into one test entry per test case,\u001b[22m so its cases run \u001b[83Gide by side. The sanitiser tests\u001b[116Gthen\r\u001b[5C\u001b[1Bt\u001b[8Gke about 60 to 75 s instead of 144\u001b[44GWith ste\u001b[53G 2, the\u001b[61Gw\u001b[63Gole\u001b[67Ggat\u001b[72Gwould be about 2\u001b[89Gto 2.5 minutes.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mClose a gap I found:\u001b[22m my local gates haven't\u001b[50Gbeen run\u001b[59Ging clang-tidy at\u001b[77Gall.\u001b[82GThe\u001b[86Gflag\u001b[91GI\u001b[93Gpassed\u001b[100Gonly\u001b[105Gsets\u001b[110Gthe\u001b[114Gnumber\r\u001b[2C\u001b[1B  \u001b[6Gof tidy jobs; CI runs tidy, but my gates didn't. I'd add tidy\u001b[68Gto every gate. It skip\u001b[91G files that were clean and\u001b[K\r\u001b[5C\u001b[1Bh\u001b[8Gv\u001b[10Gn't changed,\u001b[23Gso\u001b[26Git costs little.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[27;1H\u001b[24;3H\u001b[?25h"]
