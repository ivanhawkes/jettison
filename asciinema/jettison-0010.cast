[0.335, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bboth.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocumentation-only commits\u001b[32G\u001b[22malready\u001b[40Gskip\u001b[45Gthe\u001b[49Ggate\u001b[54Gautomatically,\u001b[69Gbecause\u001b[77Gthe\u001b[81Ggate\u001b[86Gignores\u001b[94G\u001b[38;2;177;185;249m.md\u001b[98G\u001b[39mfiles\u001b[104Gwhen\u001b[109Gdeciding\r\u001b[2C\u001b[1B  whether anything changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison\u001b[22m,\u001b[15Gwhich\u001b[21Gonly\u001b[26Gmatters\u001b[34Gwhen\u001b[39GManifest\u001b[48Gneeds\u001b[54Ga\u001b[56Gnew\u001b[60Gengine\u001b[67Gversion:\u001b[76Gthe\u001b[80Grendering\u001b[90Gsmoke\u001b[96Gtests\u001b[102Gand\u001b[106Greference\r\u001b[2C\u001b[1B  frames are about two thirds of its gate.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[1mSafe skip:\u001b[18G\u001b[22mskip\u001b[23Gthem\u001b[28Gwhen\u001b[33Gthe\u001b[37Grendering\u001b[47Gtest\u001b[52Gprogram and\u001b[64Gits assets are\u001b[79Gbyte-for-byte\u001b[93Gthe\u001b[97Gsame\u001b[102Gas\u001b[105Gat\u001b[108Gthe\u001b[112Glast\u001b[117Ggate\r\u001b[2C\u001b[1B    that passed. Same program and same inputs give the same frames.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mLimit:\u001b[14G\u001b[22mthat program li\u001b[30Gks almost\u001b[40Gevery engi\u001b[51Ge\u001b[53Gmodul\u001b[59G, so\u001b[64Gthis only saves time on change\u001b[95G to modules it\u001b[110Gdoesn't\u001b[K\r\u001b[2C\u001b[1B \u001b[7Glink,\u001b[13Gsuch\u001b[18Gas networking.\u001b[K\r\u001b[2C\u001b[1B  - \u001b[1mUnsafe:\u001b[22m skipping by \"no rendering files changed\" would miss physics or space changes that move a frame.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mAlso:\u001b[13G\u001b[22mits\u001b[17Grelease, term\u001b[31Gnal-free and sanitiser\u001b[54Gbuilds could run alongside th\u001b[84G smoke tests,\u001b[98Gas in\u001b[104Gstep 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBatching the remaining roadmap\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌──────────────┬──────────────────────────────────────────────────────────────────────────────────────────────────┐\r\u001b[2C\u001b[1B│     Work     │                                        What needs a gate                                         │\r\u001b[2C\u001b[1B├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[4C\u001b[1BW18\u001b[20GSlice 3 on its own;\u001b[40Gslices 4 and 5 together (bo\u001b[68Gh change\u001b[77Gthe\u001b[81Gsave\u001b[86Glayout,\u001b[94Gso\u001b[97Gthe\u001b[101Gstored\r\u001b[2C\u001b[1B│              │ world-hash checks are proven once); slice 6 is docs only.                                        │\r\u001b[2C\u001b[1B├──────────────┼────────────────────────────\u001b[76G─────────────────────────────────────────┤\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.315, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B haven't\u001b[14Gchanged,\u001b[23Gso\u001b[26Git\u001b[29Gcosts\u001b[35Glittle.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[22m nothing in\u001b[26Gits gate is en\u001b[41Gin\u001b[44G-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[4C\u001b[1Bcandidates:\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GT\u001b[9Ge terminal-fre\u001b[25Gbuild's\u001b[33Gtest\u001b[38G r\u001b[41Gpeat \u001b[47Ghe debug te\u001b[59Gts on th\u001b[68G same\u001b[74Ggame\u001b[79Gcode.\r\u001b[6C\u001b[1BThe debug \u001b[18Gests \u001b[24Gepeat the sani\u001b[39Giser tests.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce the builds run at the sam\u001b[36G time, n\u001b[45Gither stage is the \u001b[65Glowest, \u001b[74Go ski\u001b[80Gping them \u001b[91Gaves almost no time.\u001b[112GI'd\u001b[116Gkeep\r\u001b[4C\u001b[1Bboth.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocumentation-only commits\u001b[32G\u001b[22malready\u001b[40Gskip\u001b[45Gthe\u001b[49Ggate\u001b[54Gautomatically,\u001b[69Gbecause\u001b[77Gthe\u001b[81Ggate\u001b[86Gignores\u001b[94G\u001b[38;2;177;185;249m.md\u001b[98G\u001b[39mfiles\u001b[104Gwhen\u001b[109Gdeciding\r\u001b[2C\u001b[1B  whether anything changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison\u001b[22m,\u001b[15Gwhich\u001b[21Gonly\u001b[26Gmatters\u001b[34Gwhen\u001b[39GManifest\u001b[48Gneeds\u001b[54Ga\u001b[56Gnew\u001b[60Gengine\u001b[67Gversion:\u001b[76Gthe\u001b[80Grendering\u001b[90Gsmoke\u001b[96Gtests\u001b[102Gand\u001b[106Greference\r\u001b[2C\u001b[1B  frames are about two thirds of its gate.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G-\u001b[7G\u001b[1mSafe skip:\u001b[18G\u001b[22mskip\u001b[23Gthem\u001b[28Gwhen\u001b[33Gthe\u001b[37Grendering\u001b[47Gtest\u001b[52Gprogram and\u001b[64Gits assets are\u001b[79Gbyte-for-byte\u001b[93Gthe\u001b[97Gsame\u001b[102Gas\u001b[105Gat\u001b[108Gthe\u001b[112Glast\u001b[117Ggate\r\u001b[2C\u001b[1B    that passed. Same program and same inputs give the same frames.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mLimit:\u001b[14G\u001b[22mthat program li\u001b[30Gks almost\u001b[40Gevery engi\u001b[51Ge\u001b[53Gmodul\u001b[59G, so\u001b[64Gthis only saves time on change\u001b[95G to modules it\u001b[110Gdoesn't\u001b[K\r\u001b[2C\u001b[1B \u001b[7Glink,\u001b[13Gsuch\u001b[18Gas networking.\u001b[K\r\u001b[2C\u001b[1B  - \u001b[1mUnsafe:\u001b[22m skipping by \"no rendering files \u001b[76Gr space changes that move a frame.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
