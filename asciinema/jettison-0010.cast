G\u001b[1mManifest:\u001b[15G\u001b[22mnothing\u001b[23Gin\u001b[26Gits\u001b[30Ggate\u001b[35Gis\u001b[38Gengine-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[2C\u001b[1B \u001b[5Gcandidates:\u001b[K\r\u001b[4C\u001b[1B- The terminal-free\u001b[25Gbuild's\u001b[33Gtests\u001b[39Grepeat\u001b[46Gthe\u001b[50Gdebug\u001b[56Gtests\u001b[62Gon\u001b[65Gthe\u001b[69Gsame\u001b[74Ggame\u001b[79Gcode.\r\u001b[10C\u001b[1Bd\u001b[13Gbug tests repeat the sanitiser \u001b[45Gests.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce\u001b[10Gthe\u001b[14Gbuilds\u001b[21Grun\u001b[25Gat\u001b[28Gthe\u001b[32Gsame\u001b[37Gtime,\u001b[43Gneither\u001b[51Gstage\u001b[57Gis\u001b[60Gthe\u001b[64Gslowest,\u001b[73Gso\u001b[76Gskipping\u001b[85Gthem\u001b[90Gsaves\u001b[96Galmost\u001b[103Gno\u001b[106Gtime.\u001b[112GI'd\u001b[116Gkeep\r\u001b[4C\u001b[1Bboth.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocumentation-only commits\u001b[32G\u001b[22malready\u001b[40Gskip\u001b[45Gth\u001b[75Ge\u001b[77Gthe\u001b[81Ggate\u001b[86Gignores\u001b[94G\u001b[38;2;177;185;249m.md\u001b[98G\u001b[39mfiles\u001b[104Gwhen\u001b[109Gdeciding\u001b[27;1H\u001b[24;3H\u001b[?25h"]
