[0.104, "o", "\u001b[?25l\u001b[H\u001b[3Gcheck that\u001b[14Go\u001b[16Gly those\u001b[25Gmoved. O\u001b[34Ge Jet\u001b[40Gison commit and\u001b[56Gon\u001b[60GM\u001b[62Gnifest\u001b[69Gcommit,\u001b[77Geach with the gate green.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BS\u001b[5Gould I do this fix before L28,\u001b[36Gor rec\u001b[43Grd it and go\u001b[56Gstraight to L28?\u001b[K\r\u001b[2C\u001b[2BI haven't checked whether a\u001b[31G100 m ma\u001b[40Ggin causes other p\u001b[59Goblems, such as\u001b[75Gpads\u001b[80Gnear\u001b[85Ga\u001b[87Gneighbouring\u001b[100Gbody\u001b[105Gor\u001b[108Gdisplay\u001b[116Gpads.\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 7m 20s · done 3:59 pm\u001b[37G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Most games avoid this problem rather than solve it. The last few hundred metres of an approach are rarely flown on\u001b[K\r\u001b[2C\u001b[1Bgeneral\u001b[11Gsteering;\u001b[21Gthey\u001b[26Gfollow\u001b[33Ga\u001b[35Gfixed\u001b[41Gcorridor,\u001b[51Ga\u001b[53Gspeed\u001b[59Glimit,\u001b[66Gor\u001b[69Ga\u001b[71Gscript.\u001b[79GThese\u001b[85Gare\u001b[89Gmy\u001b[92Grecollections,\u001b[107Gnot\u001b[111Gchecked\r\u001b[1B \u001b[3Gagainst sources:\u001b[20G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mNo physical approach (EVE Online):\u001b[40G\u001b[22monce\u001b[45Gthe\u001b[49Gship\u001b[54Gis\u001b[57Gwithin\u001b[64Grange,\u001b[71Gdocking\u001b[79Gis\u001b[82Ginstant.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[60G\u001b[22mthe\u001b[64Gautopilot\u001b[74Gflies\u001b[80Gto\u001b[83Ga\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only\u001b[40Ggets\u001b[54Gto\u001b[57Gthe sta\u001b[65Gt of the corridor.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mApproach\u001b[14Gcorridors (X4, Star Citizen's traffic\u001b[52Gcontrol):\u001b[22m st\u001b[65Gti\u001b[68Gns carry auth\u001b[82Gred appr\u001b[91Gach paths. A ship flies\r\u001b[4C\u001b[1Bholding point, then approach p\u001b[36Gint, then pad along a path, with obsta\u001b[75Gle av\u001b[81Gidance\u001b[88Grelaxed\u001b[96Gagainst\u001b[104Gthe\u001b[108Gstation\r\u001b[2C\u001b[1B \u001b[5Gitself on the final leg. Stuck or circling ships still turn up in\u001b[71Gtheir\u001b[77Gb\u001b[79Gg reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.350, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[48G\u001b[22myou\u001b[52Grequest\u001b[60Gpermission\u001b[71Gand\u001b[75Gget\u001b[79Ga\u001b[81Gpad,\u001b[86Gand\u001b[90Gthe\u001b[94Gpermission\u001b[105Glapses\u001b[112Gif\u001b[115Gyou\u001b[27;1H\u001b[24;3H\u001b[?25h"]
