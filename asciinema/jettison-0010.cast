[0.106, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m 700 \u001b[22m   \u001b[38;2;166;226;46mconst\u001b[39m std::\u001b[38;2;166;226;46muint64_t\u001b[39m steps = end - first;\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 701 \u001b[22m   \u001b[38;2;166;226;46mMESSAGE\u001b[39m(steps << \u001b[38;2;230;219;116m\" steps in \"\u001b[39m << calls << \u001b[38;2;230;219;116m\" calls\"\u001b[39m);\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 703 -\u001b[38;2;248;248;242m  CHECK(calls * 2 < steps);                                                                           \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m02\u001b[14G\u001b[38;2;117;113;94m// The cruises passed over; every step a ship is docked runs, as observation has it (L28).\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m03\u001b[20G\u001b[38;2;248;248;242mcal\u001b[24Gs * \u001b[38;2;190;132;255m3\u001b[38;2;248;248;242m < steps * \u001b[38;2;190;132;255m2\u001b[38;2;248;248;242m);   \u001b[47G  \u001b[50G                          \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 704 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 705 \u001b[22m   \u001b[38;2;117;113;94m// Loaded mid-job, it goes on to the same world.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 706 \u001b[22m   Hosted loaded{MANIFEST_MOD_DIRECTORY, overlays};\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 728 \u001b[14G\u001b[22m\u001b[38;2;166;226;46mCHECK\u001b[39m(replayed.world.\u001b[38;2;166;226;46mStateHash\u001b[39m()\u001b[47G==\u001b[50Ghosted.world.\u001b[38;2;166;226;46mStateHash\u001b[39m());\r\u001b[2C\u001b[1B   \u001b[2m 729 \u001b[22m\u001b[K\r\u001b[1B     \u001b[2m 730 \u001b[22m   \u001b[38;2;117;113;94m// The same in every build the gate runs; it moves as the fixture's does.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 731 -\u001b[38;2;248;248;242m  CHECK(hosted.world.StateHash() == \u001b[48;2;92;2;0m0x0ULL\u001b[48;2;61