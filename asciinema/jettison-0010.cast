[0.294, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe fix is confi\u001b[20Gmed bit-identical with no observation\u001b[58Gblocks\u001b[65Gleft,\u001b[71Gbut\u001b[75Gthe\u001b[79Gzero-client\u001b[91Grun\u001b[95Gcan't\u001b[101Gshow\u001b[106Gthe\u001b[110Ggain\r\u001b[2C\u001b[1Bbecause docked\u001b[18Gwaits\u001b[24Goverlap\u001b[32Gthe\u001b[36Gother\u001b[42Gship's\u001b[49Gin-station\u001b[60Gflight.\u001b[68GI'm\u001b[72Glooking\u001b[80Gfor\u001b[84Ga\u001b[86Gfocused\u001b[94Gtest\u001b[99Gto\u001b[102Gserve\u001b[108Gas\u001b[111Gevidence.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m3\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/test/FixtureTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m16\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m4\u001b[32G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[2m 608 \u001b[22m   \u001b[38;2;117;113;94m// The cruise passed over between what wakes a system (its arrival, a batch finishing, the bid's\r\u001b[5C\u001b[1B\u001b[39m\u001b[2m 609 \u001b[14G\u001b[22m\u001b[38;2;117;113;94m// lapse, a turn), the economy working and the crew breathing throughout, then docking stepped; and\r\u001b[1B\u001b[39m \u001b[3G   \u001b[2m 610 \u001b[22m  \u001b[14G\u001b[38;2;117;113;94m// each stop the world stepping reaches.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 611 -\u001b[38;2;248;248;242m  const std::uint64_t end = forwarded.world.Clock().Step() + kJourneySteps;                           \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 611 \u001b[22m \u001b[14Gstd::\u001b[38;2;166;226;46muin