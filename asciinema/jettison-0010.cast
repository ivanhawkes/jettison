[0.003, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gthere, and the only work I\u001b[32Gd\u001b[34G while\u001b[41Git runs is editing\u001b[60Gc\u001b[62Gde\u001b[66GThe f\u001b[72Gr\u001b[74Gt run there\u001b[86Gtook\u001b[91G15 minutes because it built\u001b[K\r\u001b[4C\u001b[1Beverything from scratch; it won't need that again. The routine\u001b[68Gis in \u001b[38;2;177;185;249mdocs/bui\u001b[83Gd-and-gates.md\u001b[39m under \"Gating beside\u001b[K\r\u001b[4C\u001b[1Bthe wo\u001b[12Gk\", with your rule that \u001b[37Gothing builds alongside\u001b[61Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot pushed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest: \u001b[38;2;177;185;249mad8f6b3\u001b[39m (slice 2), \u001b[38;2;177;185;249mb108190\u001b[39m, \u001b[38;2;177;185;249m1d08379\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison: \u001b[38;2;177;185;249m209590e\u001b[39m.\u001b[K\r\u001b[2C\u001b[2BNext is W18\u001b[15Gslice\u001b[21G3,\u001b[24Gthe\u001b[28GAI\u001b[31Goperators'\u001b[42Gdaily\u001b[48Gfee\u001b[52Grule,\u001b[58Ggated\u001b[64Gin\u001b[67Gthe\u001b[71Gsecond\u001b[78Gcheckout.\u001b[88GOpus\u001b[93Gat\u001b[96Gmedium\u001b[103Geffort\u001b[110Gis\u001b[113Genough\r\u001b[2C\u001b[1Bfor it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gsecond\u001b[14Gcheckout\u001b[23Glives\u001b[29Ginside\u001b[36GManifest's\u001b[47G\u001b[38;2;177;185;249mbuild/\u001b[54G\u001b[39mfolder,\u001b[62Gso\u001b[65Gdeleting\u001b[74G\u001b[38;2;177;185;249mbuild/\u001b[81G\u001b[39mdeletes\u001b[89Git.\u001b[93GIf\u001b[96Gthat\u001b[101Ghappens,\u001b[110Grun\u001b[114G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1Bworktree prune\u001b[39m and recr\u001b[27Gate\u001b[31Git wi\u001b[37Gh the \u001b[38;2;177;185;249mgit worktree add\u001b[39m comma\u001b[66Gd in\u001b[71Gthe docs; the next gate th\u001b[98Gre th\u001b[104Gn takes about 15\r\u001b[2C\u001b[1Bminutes\u001b[11Gagain.\u001b[18GIt\u001b[21Galso\u001b[26Guses\u001b[31Gabout\u001b[37G14\u001b[40GGB\u001b[43Gof\u001b[46Gdisk.\u001b[52GI\u001b[54Gdidn't\u001b[61Grun\u001b[65Gthe\u001b[69Gcontent\u001b[77Gsuite\u001b[83G(60\u001b[87Gs\u001b[89Gunder\u001b[95Gthe\u001b[99Gsanitisers),\u001b[112Gso\u001b[115GI\r\u001b[2C\u001b[1Bdon't\u001b[9Gknow\u001b[14Gwhether\u001b[22Git\u001b[25Gis\u001b[28Gnow\u001b[32Gwhat\u001b[37Glimits\u001b[44Gthe\u001b[48Gtest\u001b[53Gstage.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 21m 18s · done 6:18 pm\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255msafe to /clear?\u001b[39m                                                                                                       \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m·\u001b[3GMisting… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[3B\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
