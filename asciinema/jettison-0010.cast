185;249m7fcde8f\u001b[39m;\u001b[72GJettison\u001b[81G\u001b[38;2;177;185;249m209590e\u001b[39m.\r\u001b[2B \u001b[3GAfter clearing,\u001b[19G\"continue\u001b[29GW18\u001b[33Gslice\u001b[39G3\"\u001b[42Gis\u001b[45Genough\u001b[52Gto\u001b[55Gpick\u001b[60Gup.\u001b[64GOpus\u001b[69Gat\u001b[72Gmedium\u001b[79Geffort\u001b[86Gwill\u001b[91Gdo\u001b[94Gfor\u001b[98Git.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne thing a fresh session won't pick up from those notes: the transit life-support cost basis (last\u001b[103Gprice\u001b[109Gpaid,\r\u001b[2C\u001b[1Bprovisioned supplies free) is still my choice in\u001b[52Gthe\u001b[56Gplan,\u001b[62Gand\u001b[66Gyou\u001b[70Ghaven't\u001b[78Gconfirmed\u001b[88Git.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
