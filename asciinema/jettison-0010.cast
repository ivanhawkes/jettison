[0.078, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bpo\u001b[8Gnt to ar\u001b[17Give, so the arrival zone already reaches into\u001b[63Gthe keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSh\u001b[8Gp2\u001b[11Greached Ore \u001b[24Gn the far side, so it was\u001b[51Gouted around the station through\u001b[84Ga\u001b[86Gwaypoint.\u001b[96GIt\u001b[99Gcame\u001b[104Goff\u001b[108Gthe\u001b[112Gwaypoint\r\u001b[2C\u001b[1B \u001b[5Gat about 100 m/s,\u001b[23Gmoving\u001b[30Gsideways to the\u001b[46Gt\u001b[48Grget, and overshot by \u001b[71Gbout\u001b[76G50 m into\u001b[86Gthe keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GInside \u001b[13Ghat zone\u001b[23Gavo\u001b[27Gdance commands\u001b[42Gup to about\u001b[54G190\u001b[58Gm/s outward\u001b[70Gwhile\u001b[76Garrival pulls\u001b[90Gth\u001b[93G ship back in.\u001b[108GThat\u001b[113Gputs\r\u001b[2C\u001b[1B \u001b[5Ge\u001b[7Gergy\u001b[12Gback\u001b[17Gin \u001b[21Gvery lap: the ship circled\u001b[48G30–55\u001b[54Gm from the point at about 40 m/s for the pad's full 300 s,\u001b[113Gnever\r\u001b[4C\u001b[1Barrived, and th\u001b[21G pad\u001b[29Gsed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GShip1 came in through \u001b[28G waypoint\u001b[38Gtoo\u001b[42Gand\u001b[46Garrived;\u001b[55Gits\u001b[59Ggeometry\u001b[68Ghappened\u001b[77Gnot\u001b[81Gto\u001b[84Govershoot.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mI\u001b[21Gtemporarily\u001b[33Graised\u001b[40Gthe\u001b[44Gmargin\u001b[51Gto\u001b[54G100\u001b[58Gm\u001b[60Gin\u001b[63Gthe\u001b[67Gfetched\u001b[75Gengine\u001b[82Gcopy\u001b[87Gand\u001b[91Greran.\u001b[98GShip2\u001b[104Gstill\u001b[110Govershot,\r\u001b[2C\u001b[1Bto about 180 m,\u001b[19Gbu\u001b[22G swung back \u001b[35Gnd arrived 62 s\u001b[51Gafter the cruise \u001b[69Gnded,\u001b[75Gabout as long as other\u001b[98Garrivals take, and no\r\u001b[2C\u001b[1Bpad lapsed in the 25 mi\u001b[27Gutes. Both\u001b[38Gedits and the experim\u001b[60Gnt te\u001b[66Gt\u001b[68Gare reverted.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposed fix (Jettison, dock):\u001b[34G\u001b[22mwiden\u001b[40Gthe\u001b[44Gmargin\u001b[51Gso\u001b[54Gthat\u001b[59Gthe\u001b[63Gship's\u001b[70Garrival\u001b[78Gzone\u001b[83Gplus\u001b[88Ga\u001b[90Gfast\u001b[95Garrival's\u001b[105Govershoot\u001b[115Gstays\r\u001b[2C\u001b[1Bclear of the keep-away zone. I'd tie\u001b[51Gt\u001b[56Ge ship'\u001b[64G braking distance rather th\u001b[92Gn a fixed number, and add a\u001b[K\r\u001b[2C\u001b[1Bdock test: an inbound ship roun\u001b[35Ging the st\u001b[46Gtio\u001b[51Gfrom the far side at full spe\u001b[81Gd must arrive before\u001b[102Gthe reservation\u001b[118G\u001b[K\r\u001b[2C\u001b[1Blapses. It\u001b[14Gchanges flig\u001b[27Gt paths, so\u001b[43Gworld-hash pins in Jettison and Manif\u001b[81Gst's fixture pin will move, and I'll\r\u001b[2C\u001b[1Bcheck tha\u001b[14Gonly those moved. One\u001b[36GJet\u001b[40Gison commit and one Manifest commit, each with the gate green.\u001b[103G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gdo\u001b[15Gthis\u001b[20Gfix\u001b[24Gbefore\u001b[31GL28,\u001b[36Gor\u001b[39Grecord\u001b[46Git\u001b[49Gand\u001b[53Ggo\u001b[56Gstraight\u001b[65Gto\u001b[68GL28?\r\u001b[2C\u001b[1B      \u001b[10G \u001b[12G  \u001b[15G    \u001b[20G   \u001b[24G      \u001b[31G    \u001b[36G  \u001b[39G      \u001b[46G \u001b[27;1H\u001b[24;3H\u001b[?25h"]
