[0.048, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GMy\u001b[8Gfirst\u001b[14Gtry\u001b[18Gmade\u001b[23Gthe\u001b[27Gapproach\u001b[36Gpoint\u001b[42Ga\u001b[44Gwaypoint,\u001b[54Gand\u001b[58Gthat\u001b[63Gmade\u001b[68Gthings\u001b[75Gworse.\u001b[82GSteering\u001b[91Gflies\u001b[97Gthrough\u001b[105Gwaypoints\u001b[115Gat\r\u001b[4C\u001b[1Bfull\u001b[10Gspeed,\u001b[17Gso\u001b[20Ga\u001b[22Gsample\u001b[29Gtrader\u001b[36Gpassed\u001b[43Git\u001b[46Ggoing\u001b[52Gsideways\u001b[61Gand\u001b[65Ghit\u001b[69GOstra\u001b[75GAnchorage\u001b[85Gat\u001b[88G126\u001b[92Gm/s.\u001b[97GStopping\u001b[106Gat\u001b[109Gthe\u001b[113Gpoint\u001b[119Gis\r\u001b[2C\u001b[1B  what fixed it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gnew\u001b[11Gdock\u001b[16Gtest\u001b[21Gflies\u001b[27Ga\u001b[29Gshuttle\u001b[37Gin\u001b[40Gfrom\u001b[45G12\u001b[48Gdirections,\u001b[60Geither\u001b[67Gstill\u001b[73Gor\u001b[76Gmoving\u001b[83Gsideways\u001b[92Gat\u001b[95G150\u001b[99Gm/s.\u001b[104GWith\u001b[109Gthe\u001b[113Gold\u001b[117Gcode\r\u001b[1B \u001b[3G  2 of those 24 never arrived; now all \u001b[44G.\u001b[K\r\u001b[1B  - It costs a little time: from 10 km, the shuttle now reaches the point\u001b[75Gabove\u001b[81Gits\u001b[85Gpad\u001b[89Gin\u001b[92G117\u001b[96Gs\u001b[98Ginstead\u001b[106Gof\u001b[109G111\u001b[113Gs.\r\u001b[2C\u001b[1B-\u001b[5GTwo \u001b[17G hash\u001b[23Gpins moved with\u001b[39Gthe new flight pa\u001b[57Gh: the dock approach\u001b[78Gtest\u001b[83Gand\u001b[87Gthe\u001b[91Gtraders'\u001b[100Gsave\u001b[105Gtest.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest (\u001b[38;2;177;185;249maec90b7\u001b[39m):\u001b[23G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe Jettison pin\u001b[22Gis bumped,\u001b[33Gand the zero-client run now\u001b[61Gfails if any ship loses its\u001b[89Gpad.\r\u001b[2C\u001b[1B-\u001b[5GThat run\u001b[14Gnow takes 42,483 calls for its 90,000 steps, down from 56,437.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe fixture\u001b[17Gloop and zero-client pi\u001b[41Gs\u001b[43Gare re-pinne\u001b[56G; nothing\u001b[67Glse moved.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe stage-4 plan's \"not yet \u001b[34Giagnosed\"\u001b[44Gitem now points to the roadmap entry.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe roadmap entry\u001b[21G\u001b[22mis \"The\u001b[29Gway in to a\u001b[41Gp\u001b[43Gd, done properly\", fir\u001b[66Gt in\u001b[71Gthe \"Then:\u001b[82Grobustness\"\u001b[94Gtier.\u001b[100GIt's\u001b[105Gahead\u001b[111Gof\u001b[114Gthe\r\u001b[2C\u001b[1Blogging and crash\u001b[21Gitems\u001b[27Gbecause\u001b[35Gevery\u001b[41GNPC\u001b[45Gand\u001b[49Gautopilot\u001b[59Gtrade\u001b[65Gin\u001b[68GManifest\u001b[77Gdocks\u001b[83Gthrough\u001b[91Git,\u001b[95Gbut\u001b[99Git\u001b[102Gisn't\u001b[108Gin\u001b[111G\"Next\"\r\u001b[2C\u001b[1Bbecause\u001b[11Gthe\u001b[15Gstopgap\u001b[23Gunblocks\u001b[32Gthe\u001b[36Gcurrent\u001b[44Gwork.\u001b[50GIt\u001b[53Grecords\u001b[61Gthe\u001b[65Gdiagnosis\u001b[75Gand\u001b[79Gthe\u001b[83Ggrid\u001b[88Gresult.\u001b[96GIt\u001b[99Glists\u001b[105Gmy\u001b[108Grecollection\r\u001b[1B \u001b[3Gof how other games\u001b[22Gha\u001b[25Gdle docking,\u001b[38Gmarked as\u001b[48Gunchecked.\u001b[59GAnd\u001b[63Git\u001b[66Gsets\u001b[71Gout\u001b[75Gthe\u001b[79Gproper\u001b[86Gsolution:\r\u001b[1B  - an approach corridor flown without stopping, slowing as the distance closes;\r\u001b[2C\u001b[1B-\u001b[5Gavoidance\u001b[15Grelaxed\u001b[23Gagainst\u001b[31Gthe\u001b[35Gstation\u001b[43Gon\u001b[46Gthe\u001b[50Gfinal\u001b[56Gleg;\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.140, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gfull speed, so a sample t\u001b[31Gader\u001b[37Gassed it going sideways and hit Ostra\u001b[75GAnchorage at 126 m/s.\u001b[97GStopping \u001b[107Gt the point\u001b[119Gis\r\u001b[4C\u001b[1Bwhat\u001b[10Gfix\u001b[15G it.\u001b[20G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA new dock\u001b[16Gtest\u001b[21Gflies\u001b[27Ga\u001b[29Gshuttle\u001b[37Gin\u001b[40Gfrom\u001b[45G12\u001b[48Gdirections,\u001b[60Geither\u001b[67Gstill\u001b[73Gor\u001b[76Gmoving\u001b[83Gsideways\u001b[92Gat\u001b[95G150\u001b[99Gm/s.\u001b[104GWith\u001b[109Gthe\u001b[113Gold\u001b[117Gcode\r\u001b[2C\u001b[1B \u001b[5G2\u001b[7Gof th\u001b[13Gse\u001b[16G24 never arrived; now all do.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt costs a\u001b[16Glittle time: from\u001b[34G10 km, the shuttle\u001b[53Gnow\u001b[57Greaches\u001b[65Gthe\u001b[69Gpoint\u001b[75Gabove\u001b[81Gits\u001b[85Gpad\u001b[89Gin\u001b[92G117\u001b[96Gs\u001b[98Ginstead\u001b[106Gof\u001b[109G111\u001b[113Gs.\r\u001b[4C\u001b[1BTwo Je\u001b[12Gtison hash\u001b[23Gp\u001b[25Gns moved\u001b[34Gwith the new flight path: t\u001b[63G dock\u001b[69Gapproach t\u001b[80Gst and the traders' \u001b[101Gave test.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest (\u001b[38;2;177;185;249maec90b7\u001b[39m):\r\u001b[2C\u001b[1B\u001b[22m- The Jettison pin is\u001b[25Gbumped,\u001b[33Gand\u001b[37Gthe\u001b[41Gzero-client\u001b[53Grun\u001b[57Gnow\u001b[61Gfails\u001b[67Gif\u001b[70Gany\u001b[74Gship\u001b[79Gloses\u001b[85Gits\u001b[89Gpad.\r\u001b[6C\u001b[1Bat run n\u001b[16Gw\u001b[18Gtakes 42,483 calls\u001b[37Gfor\u001b[41Gits 90,000 steps, down from 56,437.\u001b[K\r\u001b[6C\u001b[1Be fixture loop and zero-\u001b[32Glient pins are re-pinn\u001b[55Gd; nothing else moved.\r\u001b[8C\u001b[1Bstage-4\u001b[17Gplan's \"not yet diagnosed\" item now points \u001b[61Go the road\u001b[72Gap entry.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe roadmap entr