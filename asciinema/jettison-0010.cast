[0.111, "o", "\u001b[?25l\u001b[H\u001b[3GWithout the optional rows, the gate goes from about 6.4 minutes to about 5. With them, about 4.5.\u001b[K\r\u001b[2C\u001b[2BThe bigger saving is\u001b[24Gstill\u001b[30Gin batching the roadmap as I\u001b[59Gset out\u001b[67Gearlier:\u001b[76Gabout \u001b[83Galf as\u001b[90Gmany gates\u001b[101Gin\u001b[104GW18,\u001b[109Gdecisions\r\u001b[2C\u001b[1Basked\u001b[9Gduring\u001b[16Ggate\u001b[21Gwaits,\u001b[28Gand\u001b[32Gone\u001b[36Gengine-version\u001b[51Gmove\u001b[56Gfor\u001b[60GR02–R05.\u001b[69GNone\u001b[74Gof\u001b[77Gthat\u001b[82Gruns\u001b[87Ganything\u001b[96Gat\u001b[99Gthe\u001b[103Gsame\u001b[108Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BRecommended:\u001b[16Gthe second check\u001b[33Gut, the fixture split and tidy in every gate, \u001b[80Gs\u001b[82Gone commit; skip\u001b[103Goptional rows.\r\u001b[2C\u001b[1BShall\u001b[9GI\u001b[11Ggo\u001b[14Gahead?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BT\u001b[5Gese\u001b[9Gare estimates\u001b[23Gfrom\u001b[28Gone\u001b[32Ggate\u001b[37Grun.\u001b[42GTurning\u001b[50Gtidy\u001b[55Gon\u001b[58Gin\u001b[61Gthe\u001b[65Ggate\u001b[70Gmay\u001b[74Galso\u001b[79Gsurface\u001b[87Gfindings\u001b[96GCI\u001b[99Ghas\u001b[103Gbeen\u001b[108Greporting\r\u001b[2C\u001b[1Bthat\u001b[8GI\u001b[10Ghaven't\u001b[18Gseen\u001b[23Glocally.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 38s · done 5:52 pm\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mGo with the recommended option. Worktrunks should be available to you if needed.\u001b[39m                                      \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPl\u001b[6Gin \u001b[38;2;177;185;249mgit worktree\u001b[39m is enough here,\u001b[38Gso I'm\u001b[45Gskipping worktrunk; I'm splitting\u001b[79Gthe\u001b[83Gfixture\u001b[91Gsuite,\u001b[98Gadding\u001b[105Gtidy\u001b[110Gto\u001b[113Gthe\r\u001b[1B  gate, and documenting the second-checkout routine now.\u001b[38;2;153;153;153m · summary\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3GDrizzlin\u001b[38;2;235;159;127mg…\u001b[38;2;215;119;87m \u001b[37G\u001b[38;2;153;153;153mthought for 31s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
