1b[97G that wer\u001b[107G clean\u001b[114Gand\u001b[K\r\u001b[5C\u001b[1Bhaven't\u001b[14Gchanged,\u001b[23Gso it costs little.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22mnothing\u001b[23Gin\u001b[26Gits\u001b[30Ggate\u001b[35Gis\u001b[38Gengine-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[2C\u001b[1B \u001b[5Gcandidates:\u001b[K\r\u001b[4C\u001b[1B- The terminal-free\u001b[25Gbuild's\u001b[33Gtests\u001b[39Grepeat\u001b[46Gthe\u001b[50Gdebug\u001b[56Gtests\u001b[62Gon\u001b[65Gthe\u001b[69Gsame\u001b[74Ggame\u001b[79Gcode.\r\u001b[10C\u001b[1Bd\u001b[13Gbug tests repeat the sanitiser \u001b[45Gests.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce\u001b[10Gthe\u001b[14Gbuilds\u001b[21Grun\u001b[25Gat\u001b[28Gthe\u001b[32Gsame\u001b[37Gtime,\u001b[43Gneit\u001b[76Gskipping\u001b[85Gthem\u001b[90Gsaves\u001b[96Galmost\u001b[103Gno\u001b[106Gtime.\u001b[112GI'd\u001b[116Gkeep\u001b[27;1H\u001b[24;3H\u001b[?25h"]
