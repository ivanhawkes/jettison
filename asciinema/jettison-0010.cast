[2.780, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near the sta\u001b[29Gion.\u001b[22m Arrive slowly enough to stop\u001b[63Gwell\u001b[68Gshort of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for us:\u001b[22m th\u001b[27Gfirst t\u001b[35Gchn\u001b[39Gque, in Jettison's docks.\u001b[65GAdd a\u001b[71G approach poin\u001b[86G on t\u001b[92Ge pad's\u001b[100Gnormal, beyond the\r\u001b[2C\u001b[1Babove-pad poin\u001b[18G by more th\u001b[31G the ship's b\u001b[45Gaking di\u001b[56Gnce.\u001b[61GThe inbound\u001b[73Gcours\u001b[79G goes\u001b[85Gthrough it, so the\u001b[104Glas\u001b[109Gleg\u001b[113Gis\r\u001b[2C\u001b[1Bstraight down the normal, and the 10 m margin can stay as it is.\u001b[68GThis\u001b[73Gremoves\u001b[81Gthe \u001b[86Gideways overshoot that the\u001b[K\r\u001b[2C\u001b[1Bavoidance kept pumping, rather than moving the margin until this case passes.\u001b[81GIt is\u001b[87Gstill\u001b[94G fix inside our own\u001b[K\r\u001b[2C\u001b[1Bphysical docking, so\u001b[25Ghe docks'\u001b[35Goutwa\u001b[41Gd\u001b[43Gb\u001b[45Ghaviour\u001b[53Gis\u001b[56Gunchanged.\u001b[67GI'd\u001b[71Gleave\u001b[77Gthe\u001b[81Gspeed\u001b[87Glimit\u001b[93Gand\u001b[97Gprogress-based\u001b[112Glapsing\r\u001b[2C\u001b[1Bfor\u001b[7Glater\u001b[13Gunless\u001b[20Gthe\u001b[24Gtest\u001b[29Gshows\u001b[35Gthey're\u001b[43Gneeded.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gpin\u001b[11Gand\u001b[15Ggate\u001b[20Gcost\u001b[25Gis\u001b[28Gthe\u001b[32Gsame\u001b[37Gas\u001b[40Gfor\u001b[44Gthe\u001b[48Gmargin\u001b[55Gfix:\u001b[60Gthe\u001b[64Ghash\u001b[69Gpins\u001b[74Gin\u001b[77Gboth\u001b[82Grepos\u001b[88Gmove.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.014, "o", "\u001b[?25l\u001b[H\u001b[48;2;55;55;55m\u001b[38;2;255;255;255m❯ How is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[46C\u001b[18B\u001b[38;2;255;255;255m Jump to bottom (ctrl+End) ↓ \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.025, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near the sta\u001b[29Gion.\u001b[22m Arrive slowly enough to stop\u001b[63Gwell\u001b[68Gshort of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for us:\u001b[22m th\u001b[27Gfirst t\u001b[35Gchn\u001b[39Gque, in Jettison's docks.\u001b[65GAdd a\u001b[71G approach poin\u001b[86G on t\u001b[92Ge pad's\u001b[100Gnormal, beyond the\r\u001b[2C\u001b[1Babove-pad poin\u001b[18G by more th\u001b[31G the ship's b\u001b[45Gaking di\u001b[56Gnce.\u001b[61GThe inbound\u001b[73Gcours\u001b[79G goes\u001b[85Gthrough it, so the\u001b[104Glas\u001b[109Gleg\u001b[113Gis\r\u001b[2C\u001b[1Bstraight down the normal, and the 10 m margin can stay as it is.\u001b[68GThis\u001b[73Gremoves\u001b[81Gthe \u001b[86Gideways overshoot that the\u001b[K\r\u001b[2C\u001b[1Bavoidance kept pumping, rather than moving the margin until this case passes.\u001b[81GIt is\u001b[87Gstill\u001b[94G fix inside our own\u001b[K\r\u001b[2C\u001b[1Bphysical docking, so\u001b[25Ghe docks'\u001b[35Goutwa\u001b[41Gd\u001b[43Gb\u001b[45Ghaviour\u001b[53Gis\u001b[56Gunchanged.\u001b[67GI'd\u001b[71Gleave\u001b[77Gthe\u001b[81Gspeed\u001b[87Glimit\u001b[93Gand\u001b[97Gprogress-based\u001b[112Glapsing\r\u001b[2C\u001b[1Bfor\u001b[7Glater\u001b[13Gunless\u001b[20Gthe\u001b[24Gtest\u001b[29Gshows\u001b[35Gthey're\u001b[43Gneeded.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gpin\u001b[11Gand\u001b[15Ggate\u001b[20Gcost\u001b[25Gis\u001b[28Gthe\u001b[32Gsame\u001b[37Gas\u001b[40Gfor\u001b[44Gthe\u001b[77Gboth\u001b[82Grepos\u001b[88Gmove.\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.315, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near the sta\u001b[29Gion.\u001b[22m Arrive slowly enough to stop\u001b[63Gwell\u001b[68Gshort of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for us:\u001b[22m th\u001b[27Gfirst t\u001b[35Gchn\u001b[39Gque, in Jettison's docks.\u001b[65GAdd a\u001b[71G approach poin\u001b[86G on t\u001b[92Ge pad's\u001b[100Gnormal, beyond the\r\u001b[2C\u001b[1Babove-pad poin\u001b[18G by more th\u001b[31G the ship's b\u001b[45Gaking di\u001b[56Gnce.\u001b[61GThe inbound\u001b[73Gcours\u001b[79G goes\u001b[85Gthrough it, so the\u001b[104Glas\u001b[109Gleg\u001b[113Gis\r\u001b[2C\u001b[1Bstraight down the normal, and the 10 m margin can stay as it is.\u001b[68GThis\u001b[73Gremoves\u001b[81Gthe \u001b[86Gideways overshoot that the\u001b[K\r\u001b[2C\u001b[1Bavoidance kept pumping, rather than moving the margin until this case passes.\u001b[81GIt is\u001b[87Gstill\u001b[94G fix inside our own\u001b[K\r\u001b[2C\u001b[1Bphysical docking, so\u001b[25Ghe docks'\u001b[35Goutwa\u001b[41Gd\u001b[43Gb\u001b[45Ghaviour\u001b[53Gis\u001b[56Gunchanged.\u001b[67GI'd\u001b[71Gleave\u001b[77Gthe\u001b[81Gspeed\u001b[87Glimit\u001b[93Gand\u001b[97Gprogress-based\u001b[112Glapsing\r\u001b[2C\u001b[1Bfor\u001b[7Glater\u001b[13Gunless\u001b[20Gthe\u001b[24Gtest\u001b[29Gshows\u001b[35Gthey're\u001b[43Gneeded.\r\u001b[2C\u001b[1B   \u001b[7G   \u001b[11G   \u001b[15G    \u001b[20G    \u001b[25G  \u001b[28G   \u001b[32G    \u001b[37G  \u001b[40G   \u001b[44G   \u001b[77G\u001b[K\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.021, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bwayp\u001b[10Gin\u001b[13Gs.\u001b[16GPlayers work \u001b[30Ground it with a slow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near the sta\u001b[29Gion.\u001b[22m Arrive slowly enough to stop\u001b[63Gwell\u001b[68Gshort of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for us:\u001b[22m th\u001b[27Gfirst t\u001b[35Gchn\u001b[39Gque, in Jettison's docks.\u001b[65GAdd a\u001b[71G approach poin\u001b[86G on t\u001b[92Ge pad's\u001b[100Gnormal, beyond the\r\u001b[2C\u001b[1Babove-pad poin\u001b[18G by more th\u001b[31G the ship's b\u001b[45Gaking di\u001b[56Gnce.\u001b[61GThe inbound\u001b[73Gcours\u001b[79G goes\u001b[85Gthrough it, so the\u001b[104Glas\u001b[109Gleg\u001b[113Gis\r\u001b[2C\u001b[1Bstraight down the normal, and the 10 m margin can stay as it is.\u001b[68GThis\u001b[73Gremoves\u001b[81Gthe \u001b[86Gideways overshoot that the\u001b[K\r\u001b[2C\u001b[1Bavoidance kept pumping, rather than moving the margin until this case passes.\u001b[81GIt is\u001b[87Gstill\u001b[94G fix inside our own\u001b[K\r\u001b[2C\u001b[1Bphysical docking, so\u001b[25Ghe docks'\u001b[35Goutwa\u001b[41Gd\u001b[43Gb\u001b[45Ghaviour\u001b[53Gis\u001b[56Gunchanged.\u001b[67GI'd\u001b[71Gleave\u001b[77Gthe\u001b[81Gspeed\u001b[87Glimit\u001b[93Gand\u001b[97Gprogress-based\u001b[112Glapsing\r\u001b[2C\u001b[1Bfor\u001b[7Glater\u001b[13Gunless\u001b[20Gthe\u001b[24Gtest\u001b[29Gshows\u001b[35Gthey're\u001b[43Gneed\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.022, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the\u001b[46Gremote-contr\u001b[59Gl\u001b[61Gautopilo\u001b[70G is known for circling\u001b[93Gor\u001b[97Gvershooting\u001b[109Gits\u001b[113G\u001b[K\r\u001b[4C\u001b[1Bwayp\u001b[10Gin\u001b[13Gs.\u001b[16GPlayers work \u001b[30Ground it with a slow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near the sta\u001b[29Gion.\u001b[22m Arrive slowly enough to stop\u001b[63Gwell\u001b[68Gshort of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2