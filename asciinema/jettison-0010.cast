24Goverlap\u001b[32Gthe\u001b[36Gother\u001b[42Gship's\u001b[49Gin-station\u001b[60Gflight.\u001b[68GI'm\u001b[72Glooking\u001b[80Gfor\u001b[84Ga\u001b[86Gfocused\u001b[94Gtest\u001b[99Gto\u001b[102Gserve\u001b[108Gas\u001b[111Gevidence.\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B· summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m2\u001b[22m patterns, ran \u001b[1m3\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/test/FixtureTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m16\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m4\u001b[32G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[2m 608 \u001b[22m   \u001b[38;2;117;113;94m// The cruise passed over between\u001b[75Grival, a batch finishing, the bid's\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
