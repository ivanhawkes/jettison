[0.093, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[2m      \u001b[22m ked NPC keeps doing\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m6\u001b[15G\u001b[38;2;248;248;242m(L28). Not yet diagnosed: in the zero-client run Ada's ship spends its pad's whol\u001b[97G 300 s \u001b[105G  \u001b[108G  \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 1037 -\u001b[38;2;248;248;242m  reservation arriving at Ore and fails as `PadLost`, where every other arrival takes about 70 s.    \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[15G\u001b[38;2;248;248;242m(L28). A shi\u001b[28G flown in to\u001b[41Ga pad stops\u001b[53Gout along \u001b[64Gts normal first, Jettison's\u001b[92Gstopgap for one that\r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m7\u001b[15G\u001b[38;2;248;248;242mcircled it\u001b[27Gpad until the pad lapsed, as Ada's did at Ore in the zero-client run; the quality      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m1038\u001b[13G\u001b[38;2;248;248;242m  solution is Jettison's\u001b[38G([\u001b[38;2;230;219;116mroadmap\u001b[38;2;248;248;242m](../../jettison/docs/roadmap.md#then-robustness-tools-and-what-a-m\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m      +\u001b[38;2;248;248;242mod-can-reach)).                                                                                      \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m39\u001b[13G\u001b[22m\u001b[K\r\u001b[9C\u001b[1B\u001b[2m0\u001b[13G\u001b[22m##\u001b[16GHandoff\u001b[24Gto\u001b[27Gstage\u001b[33G5\r\u001b[5C\u001b[1B\u001b[2m 1041 \r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManif\u001b[9Gst's debug\u001b[20Gsuites pass at 48/48, and the\u001b[50Gz\u001b[52Gro-client run now needs 42k calls\u001b[86Ginstead\u001b[94Gof\u001b[97G56k.\u001b[102GI'm\u001b[106Gchecking\r\u001b[2C\u001b[1Bwhether\u001b[11Gthe\u001b[15Ggate\u001b[20Gcan\u001b[24Gfetch\u001b[30Gthe\u001b[34Gpinned\u001b[41GJettison\u001b[50Grevision\u001b[59Gwithout\u001b[67Ga\u001b[69Gpush.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/manifest' && CMAKE_BUILD_…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/\u001b[33Gan\u001b[36Gfest' && CMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24 \r\u001b[5C\u001b[1B./scripts/ci.sh --werror --asan --log build/\u001b[51Ga\u001b[53Ge\u001b[55Gdock.log > build/ga\u001b[75Ge-dock.ou\u001b[85G 2>&1; echo EXIT $?\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
