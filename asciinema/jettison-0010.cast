se \u001b[46Gt\u001b[48Gbuilds\u001b[55Geverything from scratch; later\u001b[86Gruns\u001b[91Gonly\u001b[96Grebuild\u001b[104Gwhat\u001b[109Gchanged.\u001b[118GIt\r\u001b[5C\u001b[1B \u001b[8Gtakes about 14 GB of di\u001b[32Gk.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GStage\u001b[14Gcr\u001b[17Gss-reviews could run\u001b[38Gon\u001b[41Gthat\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[22m They already use separate b\u001b[72Gild fol\u001b[80Gers,\u001b[85Gs\u001b[87G the\u001b[92Ggate's time\u001b[104Gbecomes\u001b[112Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsanitiser build's, about 3.5 minutes.\u001b[75Gory fi\u001b[83Gt\u001b[85Gand fall back\u001b[100Go one at a tim\u001b[116Gwhen\u001b[27;1H\u001b[24;3H\u001b[?25h"]
