[0.040, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│ sanitisers                     │ 210 s │ build about 66 s, tests 144 s        │\r\u001b[2C\u001b[1B└────────────────────────────────┴───────┴──────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gsanitiser\u001b[17Grun\u001b[21Gis\u001b[24Gthe\u001b[28Glong\u001b[33Gpole,\u001b[39Gand\u001b[43Gwithin\u001b[50Git\u001b[53Gthe\u001b[57Gfixture\u001b[65Gsuite.\u001b[72GThe\u001b[76Gfixture\u001b[84Gsuite\u001b[90Ghas\u001b[94Gonly\u001b[99G4\u001b[101Gtest\u001b[106Gcases,\u001b[113Gand\u001b[117Gtwo\r\u001b[2C\u001b[1Bof them \u001b[12Gak\u001b[15G 13 s\u001b[21Gand 7 s \u001b[30Gf its 25\u001b[39Gs in debug. Under\u001b[57Gthe sanitisers, the next slowest\u001b[90Gare\u001b[94Gcontent (60\u001b[106Gs) and\u001b[113Gtravel\u001b[K\r\u001b[2C\u001b[1B(31 s).\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed-ups that keep every check\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mGate a separate copy (biggest saving).\u001b[45G\u001b[22mKeep\u001b[50Ga\u001b[52Gsecond\u001b[59Gcheckout\u001b[68Gbeside\u001b[75GManifest\u001b[84Gwith\u001b[89Gits\u001b[93Gown\u001b[97Gbuild\u001b[103Gfolders.\u001b[112GI\u001b[114Gcommit\r\u001b[2C\u001b[1B  \u001b[6Ga slice, point the second checkout at that commit, run the gate there i\u001b[78G the background, and start th\u001b[108G next\u001b[114Gslice\u001b[K\r\u001b[5C\u001b[1Bstra\u001b[11Gght\u001b[15Gaway.\u001b[21GIf th\u001b[27G gate fails, the\u001b[44Gfix is the next commit, before you\u001b[79Gpush.\u001b[K\r\u001b[5C\u001b[1B- The first run ther\u001b[28Gis slow, because \u001b[46Gt\u001b[48Gbuilds\u001b[55Geverything from scratch; later\u001b[86Gruns\u001b[91Gonly\u001b[96Grebuild\u001b[104Gwhat\u001b[109Gchanged.\u001b[118GIt\r\u001b[5C\u001b[1B \u001b[8Gtakes about 14 GB of di\u001b[32Gk.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GStage\u001b[14Gcr\u001b[17Gss-reviews could run\u001b[38Gon\u001b[41Gthat\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[22m They already use separate b\u001b[72Gild fol\u001b[80Gers,\u001b[85Gs\u001b[87G the\u001b[92Ggate's time\u001b[104Gbecomes\u001b[112Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsanitiser build's, about 3.5 minutes.\u001b[47G script wo\u001b[58Gld\u001b[61Gcheck free memory fi\u001b[83Gt\u001b[85Gand fall back\u001b[100Go one at a tim\u001b[116Gwhen\r\u001b[5C\u001b[1Bit's low,\u001b[16Gfor example when your local\u001b[44GAI i\u001b[49G loaded an\u001b[61G3.4 GB is fr\u001b[74Ge.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSplit the fixture suite into one test entry per test case,\u001b[65G\u001b[22mso\u001b[69Gts cases\u001b[78Grun\u001b[82Gside\u001b[87Gby\u001b[90Gside.\u001b[96GThe\u001b[100Gsanitiser\u001b[110Gtests\u001b[116Gthen\r\u001b[2C\u001b[1B  \u001b[6Gtake about 60 to 75 s instead of 144. Wit\u001b[75Gld\u001b[78Gbe about\u001b[87G2 to 2.5\u001b[96Gminutes.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
