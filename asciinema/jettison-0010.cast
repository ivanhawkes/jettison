[0.073, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 1036 -\u001b[38;2;248;248;242m  (L28). Not yet diagnosed: in the zero-client run Ada's ship spends its pad's whole 300 s           \r\u001b[9C\u001b[1B\u001b[38;2;220;90;90m7\u001b[15G\u001b[38;2;248;248;242mreservation arriving at Ore and fails as `PadLost`, where every other arrival tak\u001b[97Gs about\u001b[105G70\u001b[108Gs.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 1036 +\u001b[38;2;248;248;242m  (L28). A ship flown in to a pad stops out along its normal first, Jettison's stopgap for one that  \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m7\u001b[15G\u001b[38;2;248;248;242mcircled its \u001b[28Gad until the\u001b[41Gpad lapsed,\u001b[53Gas Ada's d\u001b[64Gd at Ore in the zero-client\u001b[92Grun; the quality    \r\u001b[9C\u001b[1B\u001b[38;2;80;200;80m8\u001b[15G\u001b[38;2;248;248;242msolution i\u001b[27GJettison's ([\u001b[38;2;230;219;116mroadmap\u001b[38;2;248;248;242m](../../jettison/docs/roadmap.md#then-robustness-tools-and-what-a-m\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m    \u001b[13G\u001b[38;2;248;248;242mod-can-reach)).         \u001b[38G                                                                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 1039 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m40\u001b[13G\u001b[22m##\u001b[16GHandoff\u001b[24Gto\u001b[27Gstage\u001b[33G5\r\u001b[9C\u001b[1B\u001b[2m1\u001b[13G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest's\u001b[14Gdebug\u001b[20Gsuites\u001b[27Gpass\u001b[32Gat\u001b[35G48/48,\u001b[42Gand\u001b[46Gthe\u001b[50Gzero-client\u001b[62Grun\u001b[66Gnow\u001b[70Gneeds\u001b[76G42k\u001b[80Gcalls\u001b[86Ginstead\u001b[94Gof\u001b[97G56k.\u001b[102GI'm\u001b[106Gchecking\r\u001b[1B \u001b[3Gwheth\u001b[9Gr the gate\u001b[20Gcan fetch the pinned Jettison\u001b[50Gr\u001b[52Gvision without a push.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Ggit\u001b[15G-C\u001b[18G/home/ivan/projects/manifest/build/clang-a…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ git -C /home/ivan/projects/manifest/build/clang-asan/_deps/jettison-src fetch /home/ivan/projects/jettison \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mfeature-base && git -C /ho\u001b[33Ge/\u001b[36Gvan/projects/manifest/build/clang-asan/_deps\u001b[81Gj\u001b[83Gttison-s\u001b[92Gc\u001b[94Gcheckout --detach \r\u001b[5C\u001b[1B0f973b2\u001b[14G1c6938b271c820e7703018f51e35fe11 && git -C /home/ivan/projects/manifest/buil…\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
