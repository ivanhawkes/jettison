[1.000, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for the rest of W18:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThree gated chunks, not \u001b[30Give:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mGate A:\u001b[22m slice 2 (the command\u001b[36Gto\u001b[39Gset\u001b[43Gfees,\u001b[49Grunning\u001b[57Gnow)\u001b[62Gand\u001b[66Gslice\u001b[72G3\u001b[74G(the\u001b[79GAI\u001b[82Gpricing\u001b[90Grule).\r\u001b[11C\u001b[1B\u001b[1mB\u001b[21G\u001b[22m4\u001b[25Gransit life support) and slice 5 (seizure). Both\u001b[74Gchange the save\u001b[90Glayout\u001b[97Gand\u001b[101Gmove\u001b[106Gthe\u001b[110Gstored\r\u001b[4C\u001b[1B \u001b[7Gworld-ha\u001b[16Gh \u001b[19Ghecks, so doing them t\u001b[42Ggether means re-proving those on\u001b[75Ge instead\u001b[85Gof twice.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGate C:\u001b[22m \u001b[16Gli\u001b[19Ge 6, the cl\u001b[31Gse-out docs. Docs-only,\u001b[55Gso no gate; ju\u001b[70Gt\u001b[72Gthe format check.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBetwe\u001b[11Gn gates:\u001b[22m each sli\u001b[29Ge \u001b[32Gtill builds, pa\u001b[48Gses its \u001b[57Gw\u001b[59G modules' tes\u001b[73Gs (c\u001b[78Gmp\u001b[81Gny, policy,\u001b[93Gtravel,\u001b[101Gworld\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1B \u001b[5Gfixture tests), \u001b[22Gnd\u001b[25Ggets clang-tidy on only the files it changed. That takes seconds, no\u001b[94G minutes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mYour rule as written:\u001b[29G\u001b[22mevery\u001b[35Gcommit\u001b[42Gpasses\u001b[49Gthe\u001b[53Ggate.\u001b[59GUnder\u001b[65Git,\u001b[69Geach\u001b[74Gchunk\u001b[80Gbecomes\u001b[88Gone\u001b[92Gcommit,\u001b[100Gso\u001b[103Gyou'd\u001b[109Gget\u001b[113Gthree\r\u001b[4C\u001b[1B \u001b[7Gcommits instead of six.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mRelaxed, if you allow it:\u001b[33G\u001b[22mI\u001b[35Gkeep\u001b[40Gone\u001b[44Gcommit\u001b[51Gper\u001b[55Gslice.\u001b[62GOnly\u001b[67Gthe\u001b[71Glast\u001b[76Gcommit\u001b[83Gof\u001b[86Geach\u001b[91Gchunk\u001b[97Gis\u001b[100Gcertified\u001b[110Gby\u001b[113Ga\u001b[115Ggate\r\u001b[4C\u001b[1B \u001b[7Grun, and the commits in betwe\u001b[37Gn are checked\u001b[51Gby the\u001b[58Gr own tes\u001b[68Gs only.\u001b[76GIf a gate\u001b[86Grun fails,\u001b[97GI fix it \u001b[107Gn a further\u001b[K\r\u001b[6C\u001b[1Bcommit before you push.\u001b[31GThat keeps history readable,\u001b[60Gand\u001b[64Gsince\u001b[70Gyou push\u001b[79Gyours\u001b[85Glf, nothing\u001b[97Gungated ever leaves the\r\u001b[6C\u001b[1Bmach\u001b[12Gne.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[34G\u001b[22mis\u001b[37Gthe\u001b[41Gother\u001b[47Glever,\u001b[54Gbut\u001b[58Git's\u001b[63Gan\u001b[66Gengine-side\u001b[78Gchange,\u001b[86Gso\u001b[89GI'd\u001b[93Graise\u001b[99Git\u001b[102Gseparately.\u001b[114GBefore\r\u001b[2C\u001b[1Bdoing anything I'd check where\u001b[34Gthe time goes in the gate log. A Manife\u001b[74Gt-only change doesn't n\u001b[98Ged th\u001b[104G rend\u001b[110Grer's smoke\r\u001b[2C\u001b[1Btests\u001b[11Gd reference frames, whic\u001b[36G the Jetti\u001b[75Grds of the gate'\u001b[92G time there.\u001b[105GA flag that\u001b[K\u001b[27;1H\u001b[24;40H\u001b[?25h"]
[0.137, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for the rest of W18:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThree gated chunks, not \u001b[30Give:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mGate A:\u001b[22m slice 2 (the command\u001b[36Gto\u001b[39Gset\u001b[43Gfees,\u001b[49Grunning\u001b[57Gnow)\u001b[62Gand\u001b[66Gslice\u001b[72G3\u001b[74G(the\u001b[79GAI\u001b[82Gpricing\u001b[90Grule).\r\u001b[11C\u001b[1B\u001b[1mB\u001b[21G\u001b[22m4\u001b[25Gransit life support) and slice 5 (seizure). Both\u001b[74Gchange the save\u001b[90Glayout\u001b[97Gand\u001b[101Gmove\u001b[106Gthe\u001b[110Gstored\r\u001b[4C\u001b[1B \u001b[7Gworld-ha\u001b[16Gh \u001b[19Ghecks, so doing them t\u001b[42Ggether means re-proving those on\u001b[75Ge instead\u001b[85Gof twice.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGate C:\u001b[22m \u001b[16Gli\u001b[19Ge 6, the cl\u001b[31Gse-out docs. Docs-only,\u001b[55Gso no gate; ju\u001b[70Gt\u001b[72Gthe format check.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBetwe\u001b[11Gn gates:\u001b[22m each sli\u001b[29Ge \u001b[32Gtill builds, pa\u001b[48Gses its \u001b[57Gw\u001b[59G modules' tes\u001b[73Gs (c\u001b[78Gmp\u001b[81Gny, policy,\u001b[93Gtravel,\u001b[101Gworld\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1B \u001b[5Gfixture tests), \u001b[22Gnd\u001b[25Ggets clang-tidy on only the files it changed. That takes seconds, no\u001b[94G minutes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mYour rule as written:\u001b[29G\u001b[22mevery\u001b[35Gcommit\u001b[42Gpasses\u001b[49Gthe\u001b[53Ggate.\u001b[59GUnder\u001b[65Git,\u001b[69Geach\u001b[74Gchunk\u001b[80Gbecomes\u001b[88Gone\u001b[92Gcommit,\u001b[100Gso\u001b[103Gyou'd\u001b[109Gget\u001b[113Gthree\r\u001b[4C\u001b[1B \u001b[7Gcommits instead of six.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mRelaxed, if you allow it:\u001b[33G\u001b[22mI\u001b[35Gkeep\u001b[40Gone\u001b[44Gcommit\u001b[51Gper\u001b[55Gslice.\u001b[62GOnly\u001b[67Gthe\u001b[71Glast\u001b[76Gcommit\u001b[83Gof\u001b[86Geach\u001b[91Gchunk\u001b[97Gis\u001b[100Gcertified\u001b[110Gby\u001b[113Ga\u001b[115Ggate\r\u001b[4C\u001b[1B \u001b[7Grun, and the commits in betwe\u001b[37Gn are checked\u001b[51Gby the\u001b[58Gr own tes\u001b[68Gs only.\u001b[76GIf a gate\u001b[86Grun fails,\u001b[97GI fix it \u001b[107Gn a further\u001b[K\r\u001b[6C\u001b[1Bcommit before you push.\u001b[31GThat keeps history readable,\u001b[60Gand\u001b[64Gsince\u001b[70Gyou push\u001b[79Gyours\u001b[85Glf, nothing\u001b[97Gungated ever leaves the\r\u001b[6C\u001b[1Bmach\u001b[12Gne.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[34G\u001b[22mis\u001b[37Gthe\u001b[41Gother\u001b[47Glever,\u001b[54Gbut\u001b[58Git's\u001b[63Gan\u001b[66Gengine-side\u001b[78Gchange,\u001b[86Gso\u001b[89GI'd\u001b[93Graise\u001b[99Git\u001b[102Gseparately.\u001b[114GBefore\r\u001b[2C\u001b[1Bdoing anything I'd check where\u001b[34Gthe time goes in the gate log. A Manife\u001b[74Gt-only change doesn't n\u001b[98Ged th\u001b[104G rend\u001b[110Grer's smoke\r\u001b[2C\u001b[1Btests\u001b[11Gd reference frames, whic\u001b[36G the Jetti\u001b[47Gon docs\u001b[55Gpu\u001b[58G at about two thirds of the gate'\u001b[92G time there.\u001b[105GA flag that\u001b[K\r\u001b[2C\u001b[1Bskip\u001b[9Gthem wh\u001b[17Gn \u001b[20Go engin\u001b[28G code \u001b[36Gang\u001b[40Gd would\u001b[75Gicker.\u001b[82G\u001b[K\u001b[27;1H\u001b[24;40H\u001b[?25h"]
[0.315, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mThree gated chunks, not \u001b[30Give:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mGate A:\u001b[22m slice 2 (the command\u001b[36Gto\u001b[39Gset\u001b[43Gfees,\u001b[49Grunning\u001b[57Gnow)\u001b[62Gand\u001b[66Gslice\u001b[72G3\u001b[74G(the\u001b[79GAI\u001b[82Gpricing\u001b[90Grule).\r\u001b[11C\u001b[1B\u001b[1mB\u001b[21G\u001b[22m4\u001b[25Gransit life support) and slice 5 (seizure). Both\u001b[74Gchange the save\u001b[90Glayout\u001b[97Gand\u001b[101Gmove\u001b[106Gthe\u001b[110Gstored\r\u001b[4C\u001b[1B \u001b[7Gworld-ha\u001b[16Gh \u001b[19Ghecks, so doing them t\u001b[42Ggether means re-proving those on\u001b[75Ge instead\u001b[85Gof twice.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGate C:\u001b[22m \u001b[16Gli\u001b[19Ge 6, the cl\u001b[31Gse-out docs. Docs-only,\u001b[55Gso no gate; ju\u001b[70Gt\u001b[72Gthe format check.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBetwe\u001b[11Gn gates:\u001b[22m each sli\u001b[29Ge \u001b[32Gtill builds, pa\u001b[48Gses its \u001b[57Gw\u001b[59G modules' tes\u001b[73Gs (c\u001b[78Gmp\u001b[81Gny, policy,\u001b[93Gtravel,\u001b[101Gworld\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1B \u001b[5Gfixture tests), \u001b[22Gnd\u001b[25Ggets clang-tidy on only the files it changed. That takes seconds, no\u001b[94G minutes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mYour rule as written:\u001b[29G\u001b[22mevery\u001b[35Gcommit\u001b[42Gpasses\u001b[49Gthe\u001b[53Ggate.\u001b[59GUnder\u001b[65Git,\u001b[69Geach\u001b[74Gchunk\u001b[80Gbecomes\u001b[88Gone\u001b[92Gcommit,\u001b[100Gso\u001b[103Gyou'd\u001b[109Gget\u001b[113Gthree\r\u001b[4C\u001b[1B \u001b[7Gcommits instead of six.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mRelaxed, if you allow it:\u001b[33G\u001b[22mI\u001b[35Gkeep\u001b[40Gone\u001b[44Gcommit\u001b[51Gper\u001b[55Gslice.\u001b[62GOnly\u001b[67Gthe\u001b[71Glast\u001b[76Gcommit\u001b[83Gof\u001b[86Geach\u001b[91Gchunk\u001b[97Gis\u001b[100Gcertified\u001b[110Gby\u001b[113Ga\u001b[115Ggate\r\u001b[4C\u001b[1B \u001b[7Grun, and the commits in betwe\u001b[37Gn are checked\u001b[51Gby the\u001b[58Gr own tes\u001b[68Gs only.\u001b[76GIf a gate\u001b[86Grun fails,\u001b[97GI fix it \u001b[107Gn a further\u001b[K\r\u001b[6C\u001b[1Bcommit before you push.\u001b[31GThat keeps history readable,\u001b[60Gand\u001b[64Gsince\u001b[70Gyou push\u001b[79Gyours\u001b[85Glf, nothing\u001b[97Gungated ever leaves the\r\u001b[6C\u001b[1Bmach\u001b[12Gne.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[34G\u001b[22mis\u001b[37Gthe\u001b[41Gother\u001b[47Glever,\u001b[54Gbut\u001b[58Git's\u001b[63Gan\u001b[66Gengine-side\u001b[78Gchange,\u001b[86Gso\u001b[89GI'd\u001b[93Graise\u001b[99Git\u001b[102Gseparately.\u001b[114GBefore\r\u001b[2C\u001b[1Bdoing anything I'd check where\u001b[34Gthe time goes in the gate log. A Manife\u001b[74Gt-only change doesn't n\u001b[98Ged th\u001b[104G rend\u001b[110Grer's smoke\r\u001b[2C\u001b[1Btests\u001b[11Gd reference frames, whic\u001b[36G the Jetti\u001b[47Gon docs\u001b[55Gpu\u001b[58G at about two thirds of the gate'\u001b[92G time there.\u001b[105GA flag that\u001b[K\r\u001b[2C\u001b[1Bskip\u001b[9Gthem wh\u001b[17Gn \u001b[20Go engin\u001b[28G code \u001b[36Gang\u001b[40Gd would make Manifes\u001b[62Ggates\u001b[68Gmuch quicker.\u001b[82G\u001b[K\r\u001b[2C\u001b[1B     \u001b[9G    \u001b[14G    \u001b[19G  \u001b[22G      \u001b[29G    \u001b[34G       \u001b[42G     \u001b[75G\u001b[K\u001b[27;1H\u001b[24;40H\u001b[?25h"]
