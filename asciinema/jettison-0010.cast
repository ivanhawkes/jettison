[0.088, "o", "\u001b[?25l\u001b[H\u001b[3GThese\u001b[9Ggames\u001b[15Gcombine\u001b[23Gfour\u001b[28Gtechniques:\r\u001b[2C\u001b[1B1. \u001b[1mMake the final approach one-dimensional.\u001b[47G\u001b[22mBring\u001b[53Gthe\u001b[57Gship\u001b[62Gto\u001b[65Ga\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gthe\u001b[87Gpad's\u001b[93Gnormal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the\u001b[53Gstation rather than\u001b[73Gsideways into\u001b[87Gan orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[22m We \u001b[71Glrea\u001b[76Gy do this when descending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSlow down near the station.\u001b[34G\u001b[22mArrive\u001b[41Gslowly\u001b[48Genough\u001b[55Gto\u001b[58Gstop\u001b[63Gwell\u001b[68Gshort\u001b[74Gof\u001b[77Ganything.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mLapse a pad only when \u001b[29Ghe ship isn't progressing.\u001b[22m Then a\u001b[63Gslow\u001b[68Gbut working arrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[2C\u001b[1B  \u001b[6Gdropped.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd do for us:\u001b[23G\u001b[22mthe\u001b[27Gfirst\u001b[33Gtechnique,\u001b[44Gin\u001b[47GJettison's\u001b[58Gdocks.\u001b[65GAdd\u001b[69Gan\u001b[72Gapproach\u001b[81Gpoint\u001b[87Gon\u001b[90Gthe\u001b[94Gpad's\u001b[100Gnormal,\u001b[108Gbeyond\u001b[115Gthe\r\u001b[2C\u001b[1Babove-pad point by mor\u001b[27Gthan th\u001b[35G sh\u001b[39Gp's braking distance. The\u001b[65Ginbou\u001b[71Gd course goes \u001b[86Ghroug\u001b[92G it, so\u001b[100Gthe last leg is\u001b[K\r\u001b[2C\u001b[1Bstraight down \u001b[18Ghe normal, \u001b[31Gd the 10 m ma\u001b[45Ggin can \u001b[56Gy as\u001b[61Git is. This\u001b[73Gremov\u001b[79Gs the\u001b[85Gsideways overshoot\u001b[104Gtha\u001b[109Gthe\u001b[113G\u001b[K\r\u001b[2C\u001b[1Bavoidance kept pumping, rather than moving the margin until this\u001b[68Gcase\u001b[73Gpasses.\u001b[81GIt i\u001b[86G still a fix inside our own\r\u001b[2C\u001b[1Bphysical docking, so the docks' outward behaviour is unchanged. I'd leave the\u001b[81Gspeed\u001b[87Glimit\u001b[94Gnd progress-based lapsing\r\u001b[2C\u001b[1Bfor later unless the\u001b[25Gest shows\u001b[35Gthey'\u001b[41Ge\u001b[43Gn\u001b[45Geded.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gpin\u001b[11Gand\u001b[15Ggate\u001b[20Gcost\u001b[25Gis\u001b[28Gthe\u001b[32Gsame\u001b[37Gas\u001b[40Gfor\u001b[44Gthe\u001b[48Gmargin\u001b[55Gfix:\u001b[60Gthe\u001b[64Ghash\u001b[69Gpins\u001b[74Gin\u001b[77Gboth\u001b[82Grepos\u001b[88Gmove.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 24s · done 4:03 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0010 ─\r\u001b[1B\u001b[39m❯ Make a note of your findings and your recollection of issues with other games docking system. We will use your\u001b[K\r\u001b[1B  suggested fix right\u001b[23Gnow, and\u001b[32Greturn to the issue at a\u001b[57Glater date wi\u001b[72G a\u001b[75Gquality solution. Add\u001b[97Git\u001b[100Gto the roadmap,\r\u001b[3C\u001b[1Bele\u001b[K\u001b[27;1H\u001b[24;7H\u001b[?25h"]
