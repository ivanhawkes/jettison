[0.193, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m stations carry authored appro\u001b[92Gch p\u001b[97Gths. A\u001b[104Gs\u001b[106Gip flies\u001b[K\r\u001b[4C\u001b[1Bholding point, then\u001b[25Gapproach point, then pad along a pa\u001b[61Gh, with obstacle avoidance relaxed\u001b[96Gagainst\u001b[104Gthe\u001b[108Gstation\r\u001b[2C\u001b[1B \u001b[5Gitself on the final leg. Stuck or circling\u001b[48Gships still\u001b[60Gtu\u001b[63Gn up i\u001b[71Gtheir bug\u001b[81Greports.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[22m y\u001b[51G requ\u001b[57Gst permission and get a \u001b[82Gad, and the p\u001b[96Grmiss\u001b[104G l\u001b[107Gpses if you\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gn't land \u001b[17Gn time; that's the same role as our reservation.\u001b[66GA\u001b[68Gspeed\u001b[74Glimit\u001b[80Gapplies\u001b[88Gnear\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B \u001b[5Gcomputer flies a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the\u001b[46Gremote-contr\u001b[59Gl\u001b[61Gautopilo\u001b[70G is known for circling\u001b[93Gor\u001b[97Gvershooting\u001b[109Gits\u001b[113G\u001b[K\r\u001b[4C\u001b[1Bwayp\u001b[10Gin\u001b[13Gs.\u001b[16GPlayers work \u001b[30Ground it with a slow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSlow down near the sta\u001b[29Gion.\u001b[22m Arrive slowly enough to stop\u001b[63Gwell\u001b[68Gshort of anything.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLapse a pad only when the ship isn't progressing.\u001b[56G\u001b[22mThen\u001b[61Ga\u001b[63Gslow\u001b[68Gbut\u001b[72Gworking\u001b[80Garrival\u001b[88Gkeeps\u001b[94Gits\u001b[98Gpad,\u001b[103Gand\u001b[107Ga\u001b[109Gstuck\u001b[115Gone\u001b[119Gis\r\u001b[5C\u001b[1Bdropped.\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.022, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[1mScripted\u001b[14Gfinal docking (Freelancer, many older\u001b[52Ggames):\u001b[22m the \u001b[65Gut\u001b[68Gpilot flies t\u001b[82G a ring \u001b[91Gr entry point, then an\u001b[K\r\u001b[4C\u001b[1Banimation takes over. Physics \u001b[36Gnly gets the ship to the start of the \u001b[75Gorrid\u001b[81Gr.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m stations\u001b[71Gcarry\u001b[77Ga\u001b[79Gthored approach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B \u001b[5Gholding point, then approach point, then pad along a path, with obstacl\u001b[77G avoidance relaxed against the \u001b[109Gtat\u001b[113Gon\u001b[K\r\u001b[4C\u001b[1Bitself o\u001b[14G the\u001b[19Gf\u001b[21Gnal\u001b[25Gleg. Stuck\u001b[36Gor ci\u001b[42Gc\u001b[44Ging ships still \u001b[61Gur\u001b[64G up\u001b[68Gin their bug reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[48G\u001b[22myou\u001b[52Grequest permission\u001b[71Gand\u001b[75Gget\u001b[79Ga\u001b[81Gpad,\u001b[86Gand\u001b[90Gthe\u001b[94Gpermission\u001b[105Glapses\u001b[112Gif\u001b[115Gyou\r\u001b[2C\u001b[1B \u001b[5Gdon't land in time; that's the same rol\u001b[46Gas \u001b[50Gur rese\u001b[58Gvation. A speed\u001b[74Glimit\u001b[80Gapplies near\u001b[93Gthe stati\u001b[103Gn, and \u001b[111Ghe\u001b[114Gdocking\r\u001b[4C\u001b[1Bcom\u001b[9Guter flies a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[42G\u001b[22mthe remote-control\u001b[61Gautopilot\u001b[71Gis\u001b[74Gknown\u001b[80Gfor\u001b[84Gcircling\u001b[93Gor\u001b[96Govershooting\u001b[109Gits\r\u001b[4C\u001b[1Bwaypoints.\u001b[16GPlayers\u001b[24Gwork\u001b[29Garound\u001b[36Git\u001b[39Gwith\u001b[44Ga\u001b[46Gslow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[2C\u001b[1B  reason the \u001b[17Gthers\u001b[23Gc\u001b[25Gnstrain the last\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Ge\u001b[9Ggames combine\u001b[23Gfour techniques:\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[1mMake the final approach one-dime\u001b[39Gsional.\u001b[22m Bring the ship to a\u001b[67Gpoint out al\u001b[80Gng the pad's normal and come in\u001b[112Gstraight,\r\u001b[5C\u001b[1Bso\u001b[9Gany\u001b[13Govershoot heads\u001b[29Gtoward\u001b[36Gor\u001b[39Gaway\u001b[44Gfrom\u001b[49Gthe\u001b[53Gstation\u001b[61Grather\u001b[68Gthan\u001b[73Gsideways\u001b[82Ginto\u001b[87Gan\u001b[90Gorbit.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mDon't treat the d\u001b[24Gstination as an obstacle on the final leg.\u001b[22m We already do this when\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSlow down near the station.\u001b[34G\u001b[22mArrive\u001b[41Gslowly\u001b[77Ganything.\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.042, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[1mNo physical \u001b[18Gppr\u001b[22Gach (EVE On\u001b[34Gi\u001b[36Ge):\u001b[22m once the ship is within\u001b[64Grange, docking is insta\u001b[88Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[22m the aut\u001b[68Gpilot\u001b[74Gflies to a\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only gets the ship to the star\u001b[66G \u001b[68Gf the corridor.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m stations carry authored appro\u001b[92Gch p\u001b[97Gths. A\u001b[104Gs\u001b[106Gip flies\u001b[K\r\u001b[4C\u001b[1Bholding point, then\u001b[25Gapproach point, then pad along a pa\u001b[61Gh, with obstacle avoidance relaxed\u001b[96Gagainst\u001b[104Gthe\u001b[108Gstation\r\u001b[2C\u001b[1B \u001b[5Gitself on the final leg. Stuck or circling\u001b[48Gships still\u001b[60Gtu\u001b[63Gn up i\u001b[71Gtheir bug\u001b[81Greports.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[22m y\u001b[51G requ\u001b[57Gst permission and get a \u001b[82Gad, and the p\u001b[96Grmiss\u001b[104G l\u001b[107Gpses if you\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gn't land \u001b[17Gn time; that's the same role as our reservation.\u001b[66GA\u001b[68Gspeed\u001b[74Glimit\u001b[80Gapplies\u001b[88Gnear\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B \u001b[5Gcomputer flies a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the\u001b[46Gremote-contr\u001b[59Gl\u001b[61Gautopilo\u001b[70G is known for circling\u001b[93Gor\u001b[97Gvershooting\u001b[109Gits\u001b[113G\u001b[K\r\u001b[4C\u001b[1Bwayp\u001b[10Gin\u001b[13Gs.\u001b[16GPlayers work \u001b[30Ground it with a slow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.        \u001b[34G      \u001b[41G      \u001b[77G\u001b[K\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.229, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNo physical \u001b[18Gppr\u001b[22Gach (EVE On\u001b[34Gi\u001b[36Ge):\u001b[22m once the ship is within\u001b[64Grange, docking is insta\u001b[88Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[22m the aut\u001b[68Gpilot\u001b[74Gflies to a\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only gets the ship to the star\u001b[66G \u001b[68Gf the corridor.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m stations carry authored appro\u001b[92Gch p\u001b[97Gths. A\u001b[104Gs\u001b[106Gip flies\u001b[K\r\u001b[4C\u001b[1Bholding point, then\u001b[25Gapproach point, then pad along a pa\u001b[61Gh, with obstacle avoidance relaxed\u001b[96Gagainst\u001b[104Gthe\u001b[108Gstation\r\u001b[2C\u001b[1B \u001b[5Gitself on the final leg. Stuck or circling\u001b[48Gships still\u001b[60Gtu\u001b[63Gn up i\u001b[71Gtheir bug\u001b[81Greports.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[22m y\u001b[51G requ\u001b[57Gst permission and get a \u001b[82Gad, and the p\u001b[96Grmiss\u001b[104G l\u001b[107Gpses if you\u001b[K\r\u001b[4C\u001b[1Bd\u001b[7Gn't land \u001b[17Gn time; that's the same role as our reservation.\u001b[66GA\u001b[68Gspeed\u001b[74Glimit\u001b[80Gapplies\u001b[88Gnear\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B \u001b[5Gcomputer flies a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the\u001b[46Gremote-contr\u001b[59Gl\u001b[61Gautopilo\u001b[70G is known for circling\u001b[93Gor\u001b[97Gvershooting\u001b[109Gits\u001b[113G\u001b[K\r\u001b[4C\u001b[1Bwayp\u001b[10Gin\u001b[13Gs.\u001b[16GPlayers work \u001b[30Ground it with a slow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breason\u001b[12Gthe\u001b[16Gothers\u001b[23Gconstrain\u001b[33Gthe\u001b[37Glast\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games combine four techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mMake the final approach one-dimensional.\u001b[22m Bring\u001b[53Gthe ship to a point\u001b[73Gout along the\u001b[87Gpad's normal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[2C\u001b[1B  \u001b[6Gso any overshoot heads toward or away from the station rather th\u001b[71Gn si\u001b[76Geways into an orbit.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mDon't treat the destination as an obstacl\u001b[76G\u001b[22my\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.022, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bgeneral\u001b[11Gsteering;\u001b[21Gthey\u001b[26Gfollow\u001b[33Ga\u001b[35Gfixed\u001b[41Gcorridor,\u001b[51Ga\u001b[53Gspeed\u001b[59Glimit,\u001b[66Gor\u001b[69Ga\u001b[71Gscript.\u001b[79GThese\u001b[85Gare\u001b[89Gmy\u001b[92Grecollections,\u001b[107Gnot\u001b[111Gchecked\r\u001b[2C\u001b[1Bagainst sources:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo physical approach (EVE Online):\u001b[40G\u001b[22monce\u001b[54Gis\u001b[57Gwithin \u001b[65Gange, docking is instant.\r\u001b[4C\u001b[1B\u001b[1mScripted\u001b[14Gfinal docking (Freelancer, many older\u001b[52Ggames):\u001b[22m the \u001b[65Gut\u001b[68Gpilot flies t\u001b[82G a ring \u001b[91Gr entry point, then an\u001b[K\r\u001b[4C\u001b[1Banimation takes over. Physics \u001b[36Gnly gets the ship to the start of the \u001b[75Gorrid\u001b[81Gr.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m stations\u001b[71Gcarry\u001b[77Ga\u001b[79Gthored approach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B \u001b[5Gholding point, then approach point, then pad along a path, with obstacl\u001b[77G avoidance relaxed against the \u001b[109Gtat\u001b[113Gon\u001b[K\r\u001b[4C\u001b[1Bitself o\u001b[14G the\u001b[19Gf\u001b[21Gnal\u001b[25Gleg. Stuck\u001b[36Gor ci\u001b[42Gc\u001b[44Ging ships still \u001b[61Gur\u001b[64G up\u001b[68Gin their bug reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[48G\u001b[22myou\u001b[52Grequest permission\u001b[71Gand\u001b[75Gget\u001b[79Ga\u001b[81Gpad,\u001b[86Gand\u001b[90Gthe\u001b[94Gpermission\u001b[105Glapses\u001b[112Gif\u001b[115Gyou\r\u001b[2C\u001b[1B \u001b[5Gdon't land in time; that's the same rol\u001b[46Gas \u001b[50Gur rese\u001b[58Gvation. A speed\u001b[74Glimit\u001b[80Gapplies near\u001b[93Gthe stati\u001b[103Gn, and \u001b[111Ghe\u001b[114Gdocking\r\u001b[4C\u001b[1Bcom\u001b[9Guter flies a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[42G\u001b[22mthe remote-control\u001b[61Gautopilot\u001b[71Gis\u001b[74Gknown\u001b[80Gfor\u001b[84Gcircling\u001b[93Gor\u001b[96Govershooting\u001b[109Gits\r\u001b[4C\u001b[1Bwaypoints.\u001b[16GPlayers\u001b[24Gwork\u001b[29Garound\u001b[36Git\u001b[39Gwith\u001b[44Ga\u001b[46Gslow\u001b[51Gprecision\u001b[61Gmode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[2C\u001b[1B  reason the \u001b[17Gthers\u001b[23Gc\u001b[25Gnstrain the last\u001b[42Gleg.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Ge\u001b[9Ggames combine\u001b[23Gfour techniques:\u001b[K\r\u001b[2C\u001b[1B1\u001b[6G\u001b[1mMake the final approach one-dime\u001b[39Gsional.\u001b[22m \u001b[76G al\u001b[80Gng the pad's normal and come in\u001b[112Gstraight,\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.041, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMost games avoid this pr\u001b[28Gb\u001b[30Gem\u001b[33Grather than solve\u001b[51Git. The\u001b[60Gast few hundred metres of an\u001b[89Gapp\u001b[93Goach are rarely flown on\u001b[K\r\u001b[2C\u001b[1Bgeneral\u001b[12Gteering;\u001b[21Gthey\u001b[26Gfollow\u001b[33Ga\u001b[35Gfixed\u001b[41Gcorridor,\u001b[51Ga\u001b[53Gspeed\u001b[59Glimit,\u001b[66Gor\u001b[69Ga\u001b[71Gscript.\u001b[79GThese\u001b[85Gare\u001b[89Gmy\u001b[92Grecollections,\u001b[107Gnot\u001b[111Gchecked\r\u001b[2C\u001b[1Bagainst\u001b[11Gsources:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNo physical \u001b[18Gppr\u001b[22Gach (EVE On\u001b[34Gi\u001b[36Ge):\u001b[22m once the ship is within\u001b[64Grange, docking is insta\u001b[88Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScripted final docking (Freelancer, many older games):\u001b[22m the aut\u001b[68Gpilot\u001b[74Gflies to a\u001b[85Gring\u001b[90Gor\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only gets the ship to the star\u001b[66G \u001b[68Gf the corridor.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m stations carry authored appro\u001b[92Gch p\u001b[97Gths. A\u001b[104Gs\u001b[106Gip flies\u001b[K\r\u001b[4C\u001b[1Bholding point, then\u001b[25Gapproach point, then pad along a pa\u001b[61Gh, with obstacle avoidance relaxed\u001b[96Gagainst\u001b[104Gthe\u001b[108Gstation\r\u001b[2C\u001b[1B \u001b[5Gitself on the final leg. Stuck or circling\u001b[48Gships still\u001b[60Gtu\u001b[63Gn up i\u001b[71Gtheir bug\u001b[81Greports.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[22m y\u001b[51G requ\u001b[57Gst permission and get a \u001b[82Gad, and the p\u001b[96Grmiss\u001b[104G l\u001b[107Gpses if you\u001b[K\r\u001b[4C\u001b[1Bd\u001