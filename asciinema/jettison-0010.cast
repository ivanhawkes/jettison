le\r\u001b[2C\u001b[1Bcommit, then gat\u001b[21Gslices 4 and 5 together.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gtimed\u001b[19Gthe\u001b[23Gfour\u001b[28Gbuild\u001b[34Gpasses\u001b[41Gseparately,\u001b[53Gso\u001b[56GI\u001b[58Gdon't\u001b[64Gknow\u001b[69Ghow\u001b[73Gmuch\u001b[78Gof\u001b[81Gthe\u001b[85G6.3\u001b[89Gminutes\u001b[97Gthey\u001b[102Gtake.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 18s · done 5:47 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mRelax the rule to allow more commits.\u001b[39m                                                                                 \r\u001b[1B\u001b[49m                                              \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
