[0.066, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat I'd do for the rest of W18:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThree gated chunks, not five:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mGate A:\u001b[22m slice 2 (the command to set fees, running now) and slice 3 (the AI pricing rule).\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mGate B:\u001b[22m slice 4 (transit life support) and slice 5 (seizure). Both change\u001b[81Gthe\u001b[85Gsave\u001b[90Glayout\u001b[97Gand\u001b[101Gmove\u001b[106Gthe\u001b[110Gstored\r\u001b[5C\u001b[1B world-hash\u001b[18Gchecks,\u001b[26Gso\u001b[29Gdoing\u001b[35Gthem\u001b[40Gtogether\u001b[49Gmeans\u001b[55Gre-proving\u001b[66Gthose\u001b[72Gonce\u001b[77Ginstead\u001b[85Gof\u001b[88Gtwice.\r\u001b[4C\u001b[1B- \u001b[1mGate C:\u001b[15G\u001b[22mslic\u001b[20G 6, th\u001b[27G close-out\u001b[38Gdocs.\u001b[44GDocs-only,\u001b[55Gso\u001b[58Gno\u001b[61Ggate;\u001b[67Gjust\u001b[72Gthe\u001b[76Gformat\u001b[83Gcheck.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBetween gates:\u001b[20G\u001b[22meach\u001b[25Gslice\u001b[31Gstill\u001b[37Gbuilds,\u001b[45Gpasses\u001b[52Gits\u001b[56Gown\u001b[60Gmodules'\u001b[69Gtests\u001b[75G(company,\u001b[85Gpolicy,\u001b[93Gtravel,\u001b[101Gworld\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1B  fixture tests), and\u001b[25Ggets\u001b[30Gclang-tidy\u001b[41Gon\u001b[44Gonly\u001b[49Gthe\u001b[53Gfiles\u001b[59Git\u001b[62Gchanged.\u001b[71GThat\u001b[76Gtakes\u001b[82Gseconds,\u001b[91Gnot\u001b[95Gminutes.\r\u001b[1B  - \u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mYour rule as written:\u001b[29G\u001b[22mevery\u001b[35Gcommit\u001b[42Gpasses\u001b[49Gthe\u001b[53Ggate.\u001b[59GUnder\u001b[65Git,\u001b[69Geach\u001b[74Gchunk\u001b[80Gbecomes\u001b[88Gone\u001b[92Gcommit,\u001b[100Gso\u001b[103Gyou'd\u001b[109Gget\u001b[113Gthree\r\u001b[1B \u001b[3G    commits\u001b[15Ginstea\u001b[23Gof six.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mRelaxed, if you allow it:\u001b[33G\u001b[22mI\u001b[35Gkeep\u001b[40Gone\u001b[44Gcommit\u001b[51Gper\u001b[55Gslice.\u001b[62GOnly\u001b[67Gthe\u001b[71Glast\u001b[76Gcommit\u001b[83Gof\u001b[86Geach\u001b[91Gchunk\u001b[97Gis\u001b[100Gcertified\u001b[110Gby\u001b[113Ga\u001b[115Ggate\r\u001b[2C\u001b[1B    run, and the commits\u001b[28Gin\u001b[31Gbetween\u001b[39Gare\u001b[43Gchecked\u001b[51Gby\u001b[54Gtheir\u001b[60Gown\u001b[64Gtests\u001b[70Gonly.\u001b[76GIf\u001b[79Ga\u001b[81Ggate\u001b[86Grun\u001b[90Gfails,\u001b[97GI\u001b[99Gfix\u001b[103Git\u001b[106Gin\u001b[109Ga\u001b[111Gfurther\r\u001b[6C\u001b[1Bcommit\u001b[14Gbefore\u001b[21Gyou\u001b[25Gpush.\u001b[31GThat\u001b[36Gkeeps\u001b[42Ghistory\u001b[50Greadable,\u001b[60Gand\u001b[64Gsince\u001b[70Gyou\u001b[74Gpush\u001b[79Gyourself,\u001b[89Gnothing\u001b[97Gungated\u001b[105Gever\u001b[110Gleaves\u001b[117Gthe\r\u001b[1B      machine.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[34G\u001b[22mis\u001b[37Gthe\u001b[41Gother\u001b[47Glever,\u001b[54Gbut\u001b[58Git's\u001b[63Gan\u001b[66Gengine-side\u001b[78Gchange,\u001b[86Gso\u001b[89GI'd\u001b[93Graise\u001b[99Git\u001b[102Gseparately.\u001b[114GBefore\r\u001b[1B  doing anything I'd check where the time goes in the gate log. A Manifest-only change doesn't need the renderer's smoke\r\u001b[1B  tests and reference frames, which the Jettison docs put at about two thirds of the gate's time there. A flag that\u001b[K\r\u001b[2C\u001b[1Bskips\u001b[9Gthem\u001b[14Gwhen\u001b[19Gno\u001b[22Gengine\u001b[29Gcode\u001b[34Gchanged\u001b[42Gwould\u001b[48Gmake\u001b[53GManifest\u001b[62Ggates\u001b[68Gmuch\u001b[73Gquicker.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
