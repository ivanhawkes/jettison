[0.065, "o", "\u001b[?25l\u001b[H\u001b[5Gwith\u001b[10Gone\u001b[14Gcommand,\u001b[23Gand\u001b[27Gno\u001b[30Gcommand\u001b[38Gfollows.\r\u001b[1B  - The world\u001b[15Gthen runs 25 minutes of simulation the way the server's\u001b[71Gloop\u001b[76Gruns\u001b[81Git,\u001b[85Gskipping\u001b[94Gsteps\u001b[100Gwhere\u001b[106Git\u001b[109Gcan.\u001b[114GBoth\r\u001b[4C\u001b[1Bships buy and\u001b[19Gsell on their own, and both\u001b[47Gf\u001b[49Gnish with more credits than they started\u001b[90Gwith.\r\u001b[2C\u001b[1B-\u001b[5GThe world\u001b[15Gis\u001b[18Gsaved\u001b[24Gwith\u001b[29GAda's\u001b[35Gcargo\u001b[41Gon\u001b[44Gits\u001b[48Gway\u001b[52Gto\u001b[55Gthe\u001b[59Gbuyer,\u001b[66Gloaded\u001b[73Ginto\u001b[78Ga\u001b[80Gfresh\u001b[86Gworld,\u001b[93Gand\u001b[97Grun\u001b[101Gto\u001b[104Gthe\u001b[108Gend.\u001b[113GIt\r\u001b[4C\u001b[1Breaches the sam\u001b[23Gta\u001b[27G as the or\u001b[38Gginal.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt is also replayed from the start one \u001b[45Gtep at\u001b[52Ga time, w\u001b[62Gth\u001b[65Gthe \u001b[70Gredit and go\u001b[83Gds checks\u001b[93Gon.\u001b[97GIt\u001b[100Greaches\u001b[108Gthe\u001b[112Gsame\r\u001b[4C\u001b[1Bstate, so skipping steps never skipped a\u001b[46Gtrading decision.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe final state is\u001b[24Gp\u001b[26Gnned \u001b[32Gs \u001b[38;2;177;185;249m0xfb25e484936a45a8\u001b[39m, and\u001b[58Git holds in every\u001b[76Ggate build.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat moved to L28:\u001b[22G\u001b[22ma\u001b[24Gblocked\u001b[32Gjob\u001b[36Gwaits\u001b[42Geither\u001b[49Gdocked,\u001b[57Gwhere\u001b[63Gobservation\u001b[75Gruns\u001b[80Gevery\u001b[86Gstep\u001b[91G(L28's\u001b[98Gsubject),\u001b[108Gor\u001b[111Gin\u001b[114Gspace\r\u001b[2C\u001b[1Bafter a failed arrival, where th\u001b[36G engine'\u001b[46Gflight\u001b[53Gsystem runs every step. So\u001b[80Gin\u001b[83Gthis\u001b[88Gworld\u001b[94Gno\u001b[97Gblocked\u001b[105Gwait\u001b[110Gcan\u001b[114Gbe\r\u001b[2C\u001b[1Bskipped yet. I reco\u001b[23Gded\u001b[27Gthis in the\u001b[39Gplan and put i\u001b[54G in L28's row as that slice's evidence.\u001b[94GIn\u001b[97Gthis\u001b[102Grun\u001b[106G56k\u001b[110Gof\u001b[113Gthe\u001b[117G90k\r\u001b[2C\u001b[1Bsteps ran one at\u001b[20Ga\u001b[22Gtime;\u001b[28Gthe\u001b[32Grest,\u001b[38Gthe\u001b[42Gcruises,\u001b[51Gwere\u001b[56Gskipped.\r\u001b[2B \u001b[3G\u001b[1mA failure I haven't diagnosed:\u001b[34G\u001b[22mAda's\u001b[40Gship\u001b[45Gonce\u001b[50Gspent\u001b[56Gthe\u001b[60Gpad's\u001b[66Gfull\u001b[71G300\u001b[75Gs\u001b[77Greservation\u001b[89Garriving\u001b[98Gat\u001b[101GOre,\u001b[106Gthen\u001b[111Gfailed\r\u001b[1B  with \u001b[38;2;177;185;249mPadLost\u001b[39m. Every other arrival takes about 70 s. The trading job handled it correctly (blocked,\u001b[102Gretried\u001b[110Gat\u001b[113Gthe\u001b[117Gnext\r\u001b[2C\u001b[1Bminute, flew again), and it happens the same way every run. It's recorded in the plan's \"Left\" list,\u001b[104Gnot\r\u001b[2C\u001b[1Binvestigated. It's probably the same \u001b[38;2;177;185;249mPadLost\u001b[39m we saw in slice 3.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mCost:\u001b[22m under ASan the \u001b[38;2;177;185;249mfixture\u001b[39m suite now takes 127 s and is the\u001b[65Gslowest\u001b[73Gsuite.\u001b[80GIn\u001b[83Gthe\u001b[87Gdebug\u001b[93Gbuild\u001b[99Git\u001b[102Gtakes\u001b[108G23\u001b[111Gs.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
