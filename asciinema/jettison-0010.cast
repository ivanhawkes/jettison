[0.083, "o", "\u001b[?25l\u001b[H\u001b[5Greason the others constrain the\u001b[37Glas\u001b[41G leg.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese game\u001b[14G combine fou\u001b[27G techniques:\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mMake the final approach one-dimensional.\u001b[47G\u001b[22mBring\u001b[53Gthe\u001b[57Gship\u001b[62Gto\u001b[65Ga\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gthe\u001b[87Gpad's\u001b[93Gnormal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\r\u001b[5C\u001b[1Bso\u001b[9Gany\u001b[13Govershoot\u001b[23Gheads\u001b[29Gtoward\u001b[36Gor\u001b[39Gaway\u001b[44Gfrom\u001b[49Gthe\u001b[53Gstation\u001b[61Grather\u001b[68Gthan\u001b[73Gsideways\u001b[82Ginto\u001b[87Gan\u001b[90Gorbit.\r\u001b[2C\u001b[1B2. \u001b[1mDon't treat the destination as an obstacle on the final leg.\u001b[67G\u001b[22mWe\u001b[70Galready\u001b[78Gdo\u001b[81Gthis\u001b[86Gwhen\u001b[91Gdescending\u001b[102G(\u001b[38;2;177;185;249mbyHull\u001b[39m),\u001b[112Gbut\u001b[116Gnot\r\u001b[2C\u001b[1B  \u001b[6Gon the inbound leg.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSlow down near the station.\u001b[22m Arrive slowly enough to stop well\u001b[68Gs\u001b[70Gort of an\u001b[80Gth\u001b[84Gg.\u001b[87G\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mLapse\u001b[12Ga p\u001b[16Gd\u001b[18Gonly when the ship\u001b[37Gisn't progressing.\u001b[22m Then a slow but working arr\u001b[84Gval keeps its pad, and a stuck o\u001b[117Ge is\r\u001b[5C\u001b[1Bdropp\u001b[12Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd\u001b[12Gdo for us:\u001b[22m the first technique, in Jettison's docks. Add an\u001b[72Gapproach po\u001b[84Gnt on the\u001b[94Gpad's normal, beyond\u001b[115Gth\u001b[119G\u001b[K\r\u001b[2C\u001b[1Babove-\u001b[10Gad point\u001b[19Gby\u001b[22Gmore\u001b[27Gthan\u001b[32Gthe\u001b[36Gship's\u001b[43Gbraking\u001b[51Gdistance.\u001b[61GThe\u001b[65Ginbound\u001b[73Gcourse\u001b[80Ggoes\u001b[85Gthrough\u001b[93Git,\u001b[97Gso\u001b[100Gthe\u001b[104Glast\u001b[109Gleg\u001b[113Gis\r\u001b[2C\u001b[1Bstraight\u001b[12Gdown\u001b[17Gthe\u001b[21Gnormal,\u001b[29Gand\u001b[33Gthe\u001b[37G10\u001b[40Gm\u001b[42Gmargin\u001b[49Gcan\u001b[53Gstay\u001b[58Gas\u001b[61Git\u001b[64Gis.\u001b[68GThis\u001b[73Gremoves\u001b[81Gthe\u001b[85Gsideways\u001b[94Govershoot\u001b[104Gthat\u001b[109Gthe\r\u001b[2C\u001b[1Bavoidance kept pumping,\u001b[27Grather tha\u001b[38G moving th\u001b[49G margin until this c\u001b[70Gse \u001b[74Gasses.\u001b[81GIt is\u001b[87Gstill a fix i\u001b[101Gside our ow\u001b[113G\u001b[K\r\u001b[2C\u001b[1Bphysical docking, so the docks' outward\u001b[44Gehaviour is unchang\u001b[64Gd. I'd leave the speed limit\u001b[93Gand\u001b[97Gprogr\u001b[103Gss-based lapsing\r\u001b[2C\u001b[1Bfo\u001b[6G later unless the test\u001b[29Gshows they're needed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BT\u001b[5Ge pin and gate cost is\u001b[28Gthe \u001b[33Game as for t\u001b[46Ge margin fix: the hash pins in\u001b[77Gboth r\u001b[84Gpos move.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[3GThunderin\u001b[38;2;235;159;127mg…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(24s · ↓\u001b[24G1.7k tokens)\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
