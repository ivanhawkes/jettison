[4.405, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mAll three recommended\u001b[25Gchanges are \u001b[38Gn and\u001b[44Gcommitted, and the gate passed in the second checkout. A warm gate now takes\r\u001b[2C\u001b[1B\u001b[1m3.9 minutes, tidy included\u001b[22m, do\u001b[34Gn from 6.4 minutes without tidy.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFixture suite split:\u001b[26G\u001b[22mits\u001b[30Gtwo\u001b[34Glongest\u001b[42Gtest\u001b[47Gcases\u001b[53Gnow\u001b[57Grun\u001b[61Gas\u001b[64G\u001b[38;2;177;185;249mfixture_cruise\u001b[79G\u001b[39mand\u001b[83G\u001b[38;2;177;185;249mfixture_alone\u001b[39m,\u001b[98Gbeside\u001b[105Ga\u001b[107G\u001b[38;2;177;185;249mfixture\u001b[115G\u001b[39mentry\r\u001b[2C\u001b[1B  that runs\u001b[15Gevery\u001b[21Gother\u001b[27Gcase.\u001b[33GA\u001b[35Gcase\u001b[40Gthat\u001b[45Gis\u001b[48Gadded\u001b[54Gor\u001b[57Grenamed\u001b[65Gstill\u001b[71Gruns.\u001b[77GThe\u001b[81Gsanitiser\u001b[91Gtests\u001b[97Gwent\u001b[102Gfrom\u001b[107G144\u001b[111Gs\u001b[113Gto\u001b[116G79\u001b[119Gs,\r\u001b[2C\u001b[1B \u001b[13G \u001b[38;2;177;185;249mb10\u001b[18G190\u001b[39m.\u001b[23G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTidy in the gate:\u001b[22m the\u001b[27Ggate\u001b[32Gnow\u001b[36Gruns\u001b[41Gwith\u001b[46G\u001b[38;2;177;185;249m--tidy\u001b[39m,\u001b[54Gas\u001b[57GCI\u001b[60Gdoes.\u001b[66GIt\u001b[69Gskips\u001b[75Gfiles\u001b[81Gthat\u001b[86Gwere\u001b[91Gclean\u001b[97Gand\u001b[101Ghaven't\u001b[109Gchanged\u001b[117G(57\r\u001b[4C\u001b[1Bof\u001b[8G58\u001b[11Gskipped\u001b[19Gthis\u001b[24Gtime).\u001b[31GIts\u001b[35Gfirst\u001b[41Grun\u001b[45Gfound\u001b[51Gone\u001b[55Gfinding\u001b[63Gleft\u001b[68Gfrom\u001b[73GW10\u001b[77Gin\u001b[80G\u001b[38;2;177;185;249mPolicy.cpp:673\u001b[95G\u001b[39mthat\u001b[100GCI\u001b[103Gwould\u001b[109Ghave\u001b[114Grefused\r\u001b[2C\u001b[1B  on\u001b[8Gyour next push.\u001b[24GIt's fixed in Manifest \u001b[38;2;177;185;249m1d08379\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mSecond checkout:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mbuild/gate-tree\u001b[38G\u001b[39mis\u001b[41Ga\u001b[43Gseparate\u001b[52Gworking\u001b[60Gcopy\u001b[65Gof\u001b[68GManifest.\u001b[78GI\u001b[80Gpoint\u001b[86Git\u001b[89Gat\u001b[92Ga\u001b[94Gcommit\u001b[101Gand\u001b[105Grun\u001b[109Gthe\u001b[113Ggate\r\u001b[4C\u001b[1Bthere,\u001b[12Gand\u001b[16Gthe\u001b[20Gonly\u001b[25Gwork\u001b[30GI\u001b[32Gdo\u001b[35Gwhile\u001b[41Git\u001b[44Gruns\u001b[49Gis\u001b[52Gediting\u001b[60Gcode.\u001b[66GThe\u001b[70Gfirst\u001b[76Grun\u001b[80Gthere\u001b[86Gtook\u001b[91G15\u001b[94Gminutes\u001b[102Gbecause\u001b[110Git\u001b[113Gbuilt\r\u001b[2C\u001b[1B  \u001b[6Gverything from scratch; it won't ne\u001b[42Gd that again. Th\u001b[59G routin\u001b[67G is in\u001b[74G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[39m under \"Gating beside\r\u001b[2C\u001b[1B  the work\", with your rul\u001b[31Gthat nothing builds alongside it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot pushed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest:\u001b[15G\u001b[38;2;177;185;249mad8f6b3\u001b[23G\u001b[39m(slice 2),\u001b[34G\u001b[38;2;177;185;249mb108190\u001b[39m,\u001b[43G\u001b[38;2;177;185;249m1d08379\u001b[39m.\r\u001b[1B \u001b[3G- Jettison: \u001b[38;2;177;185;249m209590e\u001b[39m.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
