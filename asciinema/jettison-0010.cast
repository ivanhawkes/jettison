[0.016, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[2m5\u001b[12G\u001b[22m}\u001b[14G\u001b[K\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/policy/tests/PolicyTests.cpp)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, remov\u001b[27Gd \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[2m 461 \u001b[12G\u001b[22m \u001b[14G\u001b[38;2;166;226;46mCHECK\u001b[39m(bought.phase == World::Phase::ToDestination);\r\u001b[8C\u001b[1B\u001b[2m2\u001b[14G\u001b[22m\u001b[38;2;166;226;46mREQUIRE\u001b[39m(bought.totes > \u001b[38;2;190;132;255m0\u001b[39m);\u001b[K\r\u001b[8C\u001b[1B\u001b[2m3\u001b[14G\u001b[22m\u001b[38;2;117;113;94m// The lot's cost is what the account paid for it, its docking fee at Brine a charge of the lot.\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 464 -\u001b[38;2;248;248;242m  CHECK(bought.charges == \u001b[48;2;92;2;0m10\u001b[48;2;61;1;0m);                                                                        \r\u001b[8C\u001b[1B\u001b[38;2;220;90;90m5\u001b[28G\u001b[38;2;248;248;242most ==\u001b[35Gbefore -\u001b[44Ghosted.Balance(\"Company1\")\u001b[71G-\u001b[73G\u001b[48;2;92;2;0m10\u001b[48;2;61;1;0m);\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 464 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(bought.charges == \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m100\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m);                                                                       \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[28G\u001b[38;2;248;248;242most ==\u001b[35Gbefore - hosted.\u001b[38;2;166;226;46mBalance\u001b[38;2;248;248;242m(\u001b[38;2;230;219;116m\"Company1\"\u001b[38;2;248;248;242m) - \u001b[38;2;190;132;255m\u001b[48;2;4;71;0m100\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m);\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 466 \u001b[22m   \u001b[38;2;166;226;46mCHECK\u001b[39m(\u001b[K\r\u001b[8C\u001b[1B\u001b[2m7\u001b[14G\u001b[22m    hosted.world.\u001b[38;2;166;226;46mRegistry\u001b[39m().\u001b[38;2;166;226;46mget\u001b[39m<World::Cargo>(hosted.\u001b[38;2;166;226;46mShip\u001b[39m(\u001b[38;2;230;219;116m\"Ship1\"\u001b[39m)).lots\u001b[87G==\r\u001b[8C\u001b[1B\u001b[2m8\u001b[18G\u001b[22mstd::vector<World::Lot>{{\u001b[38;2;230;219;116m\"ItemFurs\"\u001b[39m, bought.totes}});\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gctest\u001b[17G--test-dir\u001b[28G'/home/ivan/projects/manifest'/b…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ctest --test-dir '/home/ivan/projects/manifest'/build/clang-debug -R console --output-on-failure 2>&1 | grep -E \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m\"ERROR|values:|tests passed\" | h\u001b[39Gad\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
