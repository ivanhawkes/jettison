[0.055, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5GThe w\u001b[11Grld then runs 25 minutes of simulation\u001b[50Gthe\u001b[54Gway\u001b[58Gthe\u001b[62Gserver's\u001b[71Gloop\u001b[76Gruns\u001b[81Git,\u001b[85Gskipping\u001b[94Gsteps\u001b[100Gwhere\u001b[106Git\u001b[109Gcan.\u001b[114GBoth\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gips buy\u001b[15Gand sell on their own, and both finish\u001b[55Gith more cr\u001b[67Gdits than they started with.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[7Ge world\u001b[15Gis saved\u001b[24Gwith Ada's cargo on its way to the\u001b[59Gbuy\u001b[63Gr, loaded into a fresh world, and\u001b[97Grun\u001b[101Gto\u001b[104Gthe\u001b[108Gend.\u001b[113GIt\r\u001b[2C\u001b[1B \u001b[5Greaches the same state as the\u001b[35Gori\u001b[39Ginal.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt is also replayed from the start one step\u001b[49Gat\u001b[52Ga\u001b[54Gtime,\u001b[60Gwith\u001b[65Gthe\u001b[69Gcredit\u001b[76Gand\u001b[80Ggoods\u001b[86Gchecks\u001b[93Gon.\u001b[97GIt\u001b[100Greaches\u001b[108Gthe\u001b[112Gsame\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gate, so ski\u001b[19Gping steps\u001b[30Gnever skipped\u001b[44Ga trading\u001b[54Gdecision.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe final\u001b[16Gtate is\u001b[24Gpinned as \u001b[38;2;177;185;249m0xfb25e484936a45a8\u001b[39m,\u001b[54Gand it holds\u001b[67Gin\u001b[70Gevery\u001b[76Ggate\u001b[81Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat moved to L28:\u001b[22G\u001b[22ma\u001b[24Gblocked\u001b[32Gjob\u001b[36Gwaits\u001b[42Geither\u001b[49Gdocked,\u001b[57Gwhere\u001b[63Gobservation\u001b[75Gruns\u001b[80Gevery\u001b[86Gstep\u001b[91G(L28's\u001b[98Gsubject),\u001b[108Gor\u001b[111Gin\u001b[114Gspace\r\u001b[2C\u001b[1Bafter a failed arrival, wh\u001b[30Gre the engin\u001b[43G's flight system \u001b[61Guns every step. So\u001b[80Gin thi\u001b[87G world no block\u001b[103Gd wait ca\u001b[114Gbe\u001b[K\r\u001b[2C\u001b[1Bskipped\u001b[11Gyet. I\u001b[18Grecorded\u001b[27Gt\u001b[29Gis in th\u001b[38G plan and put it in L28's row as\u001b[71Gthat slice's evidence.\u001b[94GIn\u001b[97Gthis run 56k\u001b[110Gof th\u001b[117G90k\r\u001b[3C\u001b[1Bte\u001b[7Gs ran one at a time; the\u001b[32Gres\u001b[36G, the cruises, were skipped.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mA failure I haven't diagnosed:\u001b[34G\u001b[22mAda's\u001b[40Gship\u001b[45Gonce\u001b[50Gspent\u001b[56Gthe\u001b[60Gpad's\u001b[66Gfull\u001b[71G300\u001b[75Gs\u001b[77Greservation\u001b[89Garriving\u001b[98Gat\u001b[101GOre,\u001b[106Gthen\u001b[111Gfailed\r\u001b[2C\u001b[1Bwith \u001b[38;2;177;185;249mPadLost\u001b[39m. Every other arrival takes ab\u001b[46Gut 70 s. The tr\u001b[63Ging job\u001b[71Ghandled it correctly (blocked, \u001b[104Gtried at th\u001b[116G next\r\u001b[2C\u001b[1Bm\u001b[5Gnute, flew again), and it happens the\u001b[43Gsame way\u001b[52Gevery run. It's recorded in \u001b[81Ghe plan's \"Left\" list, not\u001b[K\r\u001b[2C\u001b[1Binvestigat\u001b[14Gd. It's probably\u001b[31Gthe same \u001b[38;2;177;185;249mPadLost\u001b[49G\u001b[39me saw in\u001b[58Gslice 3.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCost:\u001b[9G\u001b[22munder\u001b[15GASan\u001b[20Gthe\u001b[24G\u001b[38;2;177;185;249mfixture\u001b[32G\u001b[39msuite\u001b[38Gnow\u001b[42Gtakes\u001b[48G127\u001b[52Gs\u001b[54Gand\u001b[58Gis\u001b[61Gthe\u001b[65Gslowest\u001b[73Gsuite.\u001b[80GIn\u001b[83Gthe\u001b[87Gdebug\u001b[93Gbuild\u001b[99Git\u001b[102Gtakes\u001b[108G23\u001b[111Gs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext is L28:\u001b[16G\u001b[22mstopping\u001b[25Gdocked\u001b[32Gships\u001b[38Gfrom\u001b[43Gforcing\u001b[51Gevery\u001b[57Gstep\u001b[62Gto\u001b[65Grun.\u001b[70GThat\u001b[75Gmeans\u001b[81Gchanging\u001b[90Gwhen\u001b[95Gobservation\u001b[107Gneeds\u001b[113Gto\u001b[116Grun\u001b[27;1H\u001b[24;3H\u001b[?25h"]
