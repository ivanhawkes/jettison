[0.001, "o", "\u001b[?25l\u001b[H\u001b[3G- Jettison:\u001b[15G\u001b[38;2;177;185;249m209590e\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNext is W18\u001b[15Gslice 3,\u001b[24Gthe\u001b[28GAI\u001b[31Goperators'\u001b[42Gdaily\u001b[48Gfee\u001b[52Grule,\u001b[58Ggated\u001b[64Gin\u001b[67Gthe\u001b[71Gsecond\u001b[78Gcheckout.\u001b[88GOpus\u001b[93Gat\u001b[96Gmedium\u001b[103Geffort\u001b[110Gis\u001b[113Genough\r\u001b[2C\u001b[1Bfor\u001b[7Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gsecond\u001b[14Gcheckout\u001b[23Glives\u001b[29Ginside\u001b[36GManifest's\u001b[47G\u001b[38;2;177;185;249mbuild/\u001b[54G\u001b[39mfolder,\u001b[62Gso\u001b[65Gdeleting\u001b[74G\u001b[38;2;177;185;249mbuild/\u001b[81G\u001b[39mdeletes\u001b[89Git.\u001b[93GIf\u001b[96Gthat\u001b[101Ghappens,\u001b[110Grun\u001b[114G\u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1Bworktree prune\u001b[18G\u001b[39mand\u001b[22Grecreate\u001b[31Git\u001b[34Gwith\u001b[39Gthe\u001b[43G\u001b[38;2;177;185;249mgit worktree add\u001b[60G\u001b[39mcommand\u001b[68Gin\u001b[71Gthe\u001b[75Gdocs;\u001b[81Gthe\u001b[85Gnext\u001b[90Ggate\u001b[95Gthere\u001b[101Gthen\u001b[106Gtakes\u001b[112Gabout\u001b[118G15\r\u001b[2C\u001b[1Bminut\u001b[9Gs again. It also u\u001b[28Ges about 14 GB of disk. I\u001b[54Gdidn't run\u001b[65Gthe co\u001b[72Gtent suite (60 \u001b[89Gunder the sanitisers), so I\u001b[K\r\u001b[2C\u001b[1Bdon't know whether\u001b[22Git is now what limits the test stage.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 21m 18s · done 6:18 pm\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255msafe to /clear?\u001b[39m                                                                                                       \r\u001b[2B\u001b[49m  \u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u0