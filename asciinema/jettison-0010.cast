[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mSlice 1\u001b[11G(fees by pad class):\u001b[22m\u001b[K\r\u001b[4C\u001b[1BEvery venue posts a docking f\u001b[35Ge and an hourly berth fee for\u001b[65Geach\u001b[70Gpad\u001b[74Gclass,\u001b[81Gplus\u001b[86Gthe\u001b[90Gper-occupant\u001b[103Grate.\u001b[109GA\u001b[111Gship\u001b[116Gpays\r\u001b[2C\u001b[1B \u001b[5Gthe ra\u001b[12Ge for its hull's\u001b[29Gown pad clas\u001b[42G,\u001b[44Gwhat\u001b[49Gver\u001b[55Gd it actually\u001b[69Glands on.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[7Ge defaults are i\u001b[24G \u001b[38;2;177;185;249mbalance.yaml\u001b[39m. The\u001b[43Gcontent\u001b[51Gc\u001b[53Geck refuses\u001b[65Ga pad class that is unknown,\u001b[94Gcharg\u001b[100Gd twice\u001b[108Gor\u001b[111Gleft\u001b[116Gout;\r\u001b[2C\u001b[1B \u001b[5Ga\u001b[7Gsave refu\u001b[17Ges fe\u001b[23Gs out of order.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI first ran the new layout with W10's\u001b[43Gold 10 and 2 credit f\u001b[65Ges. Only\u001b[76Gree stored world-hash\u001b[98Gchecks\u001b[105Gchanged\u001b[113G(one\r\u001b[2C\u001b[1B \u001b[5Gcompany, tw\u001b[18Gfixture) and every other check held, so the change w\u001b[71Gs in\u001b[76Ghow\u001b[80Gfe\u001b[83Gs ar\u001b[88G stored, not in\u001b[104Gbehaviour.\u001b[115GThe\r\u001b[4C\u001b[1Breal\u001b[10Gamounts\u001b[18Gthen\u001b[23Gchanged\u001b[31Gthose\u001b[37Gthree\u001b[43Gagain,\u001b[50Gand\u001b[54Gthe\u001b[58Gconsole's\u001b[68Gtrading\u001b[76Grun\u001b[80Gnow\u001b[84Gends\u001b[89G90\u001b[92Gcredits\u001b[100Glower:\u001b[107Gexactly\u001b[115Gthe\r\u001b[2C\u001b[1B  docking fe\u001b[16G's ris\u001b[23G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChoices I made myself\u001b[25G\u001b[22m(in\u001b[29Gthe\u001b[33Gplan;\u001b[39Geasy\u001b[44Gto\u001b[47Gchange\u001b[54Gbefore\u001b[61Gslices\u001b[68G4\u001b[70Gand\u001b[74G5):\r\u001b[2C\u001b[1B- A\u001b[7Gfailed journey's\u001b[24Gdocking fee \u001b[37Gs \u001b[40Gtill not\u001b[49Gr\u001b[51Gfunded,\u001b[59Gas\u001b[62Gin W10.\u001b[K\r\u001b[2C\u001b[1B- \"What the company paid\" means\u001b[35Gthe\u001b[39Glast price\u001b[50Git paid\u001b[58Gfor oxyge\u001b[68G or cartridges. Supplies it never\u001b[102Gbought, like a new\r\u001b[2C\u001b[1B  ship's starting tanks,\u001b[28Gcount\u001b[34Gas\u001b[37Gfree.\u001b[43GI\u001b[45Gchose\u001b[51Gthis\u001b[56Gto\u001b[59Gavoid\u001b[65Gtracking\u001b[74Ga\u001b[76Gcost\u001b[81Gon\u001b[84Gevery\u001b[90Glot\u001b[94Gin\u001b[97Gthe\u001b[101Ghold.\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gtrade's\u001b[15Gestimate\u001b[24Gleaves\u001b[31Gout\u001b[35Gberth\u001b[41Gfees,\u001b[47Gbecause\u001b[55Ga\u001b[57Gjob\u001b[61Gonly\u001b[66Gwaits\u001b[72Gdocked\u001b[79Gwhen\u001b[84Git's\u001b[89Gblocked.\u001b[98GLife\u001b[103Gsupport\u001b[111Gin\u001b[114Gtransit\r\u001b[1B \u001b[3G  is estimated from the engine's cruise\u001b[43Gtime\u001b[48Gover\u001b[53Gthe\u001b[57Gdistance\u001b[66Gbetween\u001b[74Gthe\u001b[78Gtwo\u001b[82Gstations.\r\u001b[2C\u001b[1B-\u001b[5GSeized\u001b[12Gcargo\u001b[18Gis\u001b[21Gsold\u001b[26Gthrough\u001b[34Gthe\u001b[38Gowner's\u001b[46Gown\u001b[50Gunload\u001b[57Gand\u001b[61Gsell\u001b[66Gcommands,\u001b[76Gand\u001b[80Gthe\u001b[84Gmoney\u001b[90Gpays\u001b[95Gthe\u001b[99Gdebt\u001b[104Gat\u001b[107Gonce.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNext\u001b[8Gis\u001b[11Gslice\u001b[17G2,\u001b[20Gthe\u001b[24Goperator's\u001b[35Gcommand\u001b[43Gthat\u001b[48Gsets\u001b[53Ga\u001b[55Gvenue's\u001b[63Gfees.\u001b[69GThis\u001b[74Gis\u001b[77Ga\u001b[79Ggood\u001b[84Gpoint\u001b[90Gto\u001b[93G\u001b[38;2;177;185;249m/compact\u001b[102G\u001b[39mfirst.\u001b[109GOpus\u001b[114Gat\r\u001b[1B \u001b[3Gmedium effort is enough for slices 2 and 3; seizure,\u001b[56Gin\u001b[59Gslice\u001b[65G5,\u001b[68Gwarrants\u001b[77Ghigh.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
