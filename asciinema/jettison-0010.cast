[0.044, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b[1mThree gated chunks, not \u001b[30Give:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mGate A:\u001b[22m slice 2 (the command\u001b[36Gto\u001b[39Gset\u001b[43Gfees,\u001b[49Grunning\u001b[57Gnow)\u001b[62Gand\u001b[66Gslice\u001b[72G3\u001b[74G(the\u001b[79GAI\u001b[82Gpricing\u001b[90Grule).\r\u001b[11C\u001b[1B\u001b[1mB\u001b[21G\u001b[22m4\u001b[25Gransit life support) and slice 5 (seizure). Both\u001b[74Gchange the save\u001b[90Glayout\u001b[97Gand\u001b[101Gmove\u001b[106Gthe\u001b[110Gstored\r\u001b[4C\u001b[1B \u001b[7Gworld-ha\u001b[16Gh \u001b[19Ghecks, so doing them t\u001b[42Ggether means re-proving those on\u001b[75Ge instead\u001b[85Gof twice.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mGate C:\u001b[22m \u001b[16Gli\u001b[19Ge 6, the cl\u001b[31Gse-out docs. Docs-only,\u001b[55Gso no gate; ju\u001b[70Gt\u001b[72Gthe format check.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBetwe\u001b[11Gn gates:\u001b[22m each sli\u001b[29Ge \u001b[32Gtill builds, pa\u001b[48Gses its \u001b[57Gw\u001b[59G modules' tes\u001b[73Gs (c\u001b[78Gmp\u001b[81Gny, policy,\u001b[93Gtravel,\u001b[101Gworld\u001b[107Gand\u001b[111Gthe\r\u001b[2C\u001b[1B \u001b[5Gfixture tests), \u001b[22Gnd\u001b[25Ggets clang-tidy on only the files it changed. That takes seconds, no\u001b[94G minutes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[1mYour rule as written:\u001b[29G\u001b[22mevery\u001b[35Gcommit\u001b[42Gpasses\u001b[49Gthe\u001b[53Ggate.\u001b[59GUnder\u001b[65Git,\u001b[69Geach\u001b[74Gchunk\u001b[80Gbecomes\u001b[88Gone\u001b[92Gcommit,\u001b[100Gso\u001b[103Gyou'd\u001b[109Gget\u001b[113Gthree\r\u001b[4C\u001b[1B \u001b[7Gcommits instead of six.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[1mRelaxed, if you allow it:\u001b[33G\u001b[22mI\u001b[35Gkeep\u001b[40Gone\u001b[44Gcommit\u001b[51Gper\u001b[55Gslice.\u001b[62GOnly\u001b[67Gthe\u001b[71Glast\u001b[76Gcommit\u001b[83Gof\u001b[86Geach\u001b[91Gchunk\u001b[97Gis\u001b[100Gcertified\u001b[110Gby\u001b[113Ga\u001b[115Ggate\r\u001b[4C\u001b[1B \u001b[7Grun, and the commits in betwe\u001b[37Gn are checked\u001b[51Gby the\u001b[58Gr own tes\u001b[68Gs only.\u001b[76GIf a gate\u001b[86Grun fails,\u001b[97GI fix it \u001b[107Gn a further\u001b[K\r\u001b[6C\u001b[1Bcommit before you push.\u001b[31GThat keeps history readable,\u001b[60Gand\u001b[64Gsince\u001b[70Gyou push\u001b[79Gyours\u001b[85Glf, nothing\u001b[97Gungated ever leaves the\r\u001b[6C\u001b[1Bmach\u001b[12Gne.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[34G\u001b[22mis\u001b[37Gthe\u001b[41Gother\u001b[47Glever,\u001b[54Gbut\u001b[58Git's\u001b[63Gan\u001b[66Gengine-side\u001b[78Gchange,\u001b[86Gso\u001b[89GI'd\u001b[93Graise\u001b[99Git\u001b[102Gseparately.\u001b[114GBefore\r\u001b[2C\u001b[1Bdoing anything I'd check where\u001b[34Gthe time goes in the gate log. A Manife\u001b[74Gt-only change doesn't n\u001b[98Ged th\u001b[104G rend\u001b[110Grer's smoke\r\u001b[2C\u001b[1Btests\u001b[11Gd reference frames, whic\u001b[36G the Jetti\u001b[47Gon docs\u001b[55Gpu\u001b[58G at about two thirds of the gate'\u001b[92G time there.\u001b[105GA flag that\u001b[K\r\u001b[2C\u001b[1Bskip\u001b[9Gthem wh\u001b[17Gn \u001b[20Go engin\u001b[28G code \u001b[36Gang\u001b[40Gd would make Manifes\u001b[62Ggates\u001b[68Gmuch quicker.\u001b[82G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTell\u001b[8Gme\u001b[11Gwhether\u001b[19Gyou\u001b[23Gprefer\u001b[30Gone\u001b[34Gcommit\u001b[41Gper\u001b[45Gchunk\u001b[51Gor\u001b[54Gkeeping\u001b[62Gper-slice\u001b[72Gcommits.\u001b[81GUntil\u001b[87Gyou\u001b[91Gsay,\u001b[96GI'll\u001b[101Ggo\u001b[104Gon\u001b[107Gwith\u001b[112Gslice\u001b[118G3\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.451, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- \u001b[1mGate B:\u001b[22m slice 4 (transit life\u001b[37Gsupport)\u001b[46Gand\u001b[50Gslice\u001b[56G5\u001b[58G(seizure).\u001b[69GBoth\u001b[74Gchange\u001b[81Gthe\u001b[85Gsave\u001b[90Glayout\u001b[97Gand\u001b[101Gmove\u001b[106Gthe\u001b[110Gstored\r\u001b[4C\u001b[1B \u001b[7Gworld-ha\u001b[16Gh \u001b[19Ghecks, so doing them together\u001b[49Gmea\u001b[53Gs re-provi\u001b[64Gg\u001b[66Gthos\u001b[72Gonce instead of twice.\u001b[K\r\u001b[11C\u001b[1B\u001b[1mC\u001b[21G\u001b[22m6, \u001b[25Ghe close-out docs. Docs-on\u001b[52Gy, so\u001b[58Gno gate; just the forma\u001b[82G check.\u001b[90G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBetween gates:\u001b[22m \u001b[21Gach slice still builds, passes its own modules' t\u001b[71Gsts (company,\u001b[85Gpolicy, travel,\u001b[101Gworld\u001b[107Gand\u001b[111Gthe\r\u001b[4C\u001b[1Bfixture te\u001b[16Gts),\u001b[21Gand g\u001b[27Gts clang-\u001b[37Gi\u001b[39Gy on\u001b[44Gonly the files it changed. That\u001b[76Gtakes seconds,\u001b[91Gnot\u001b[95Gminutes.\r\u001b[4C\u001b[1B\u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mYour rule as written:\u001b[22m every commit passes\u001b[53Ggat\u001b[57G.\u001b[59GUnder it, eac\u001b[73G chun\u001b[79G becomes one com\u001b[97Gt, so you'd\u001b[109Gget\u001b[113Gthree\r\u001b[2C\u001b[1B \u001b[5G  commits\u001b[15Ginstead\u001b[23Gof\u001b[26Gsix.\r\u001b[6C\u001b[1B\u001b[1mRelaxed, if you allow it:\u001b[22m I\u001b[35Gkeep one commi\u001b[50G per slice. Only th\u001b[70G last commit \u001b[84Gf each chunk is\u001b[100Gcertified by\u001b[113Ga gate\r\u001b[6C\u001b[1Brun, and the commit\u001b[27G in\u001b[31Gbetween\u001b[39Gare\u001b[43Gchecked\u001b[51Gby\u001b[54Gtheir\u001b[60Gown\u001b[64Gtests\u001b[70Gonly.\u001b[76GIf\u001b[79Ga\u001b[81Ggate\u001b[86Grun\u001b[90Gfails,\u001b[97GI\u001b[99Gfix\u001b[103Git\u001b[106Gin\u001b[109Ga\u001b[111Gfurther\r\u001b[4C\u001b[1B \u001b[7Gcommit before you push. That k\u001b[38Geps history readab\u001b[57Ge, and since you push yourself, not\u001b[93Gi\u001b[95Gg\u001b[97Gungated ev\u001b[108Gr\u001b[110Gleaves \u001b[118Ghe\r\u001b[6C\u001b[1Bmachine.\u001b[16G\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[34G\u001b[22mis\u001b[37Gthe\u001b[41Gother\u001b[47Glever,\u001b[54Gbut\u001b[58Git's\u001b[63Gan\u001b[66Gengine-side\u001b[78Gchange,\u001b[86Gso\u001b[89GI'd\u001b[93Graise\u001b[99Git\u001b[102Gseparately.\u001b[114GBefore\r\u001b[2C\u001b[1Bdoing\u001b[9Ganything\u001b[18GI'd\u001b[22Gcheck\u001b[28Gwhere\u001b[34Gthe\u001b[38Gtime\u001b[43Ggoes\u001b[48Gin\u001b[51Gthe\u001b[55Ggate\u001b[60Glog.\u001b[65GA\u001b[67GManifest-only\u001b[81Gchange\u001b[88Gdoesn't\u001b[96Gneed\u001b[101Gthe\u001b[105Grenderer's\u001b[116Gsmoke\r\u001b[2C\u001b[1Btests and reference frames, which\u001b[41GJettison docs put at about two th\u001b[75Grds of the\u001b[86Ggate\u001b[91Gs\u001b[93Gtime there. A flag that\u001b[K\r\u001b[2C\u001b[1Bsk\u001b[6Gps\u001b[9Gthem when no\u001b[22Gengine cod\u001b[34Gc\u001b[36Ganged would\u001b[48Gmake Manif\u001b[59Gst \u001b[63Gates much quicker.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTell me whet\u001b[17Gr\u001b[19Gy\u001b[21Gu pref\u001b[28Gr \u001b[31Gn\u001b[35Gommit per chunk or keeping\u001b[62Gper-\u001b[67Glice commits. Until\u001b[87Gyou\u001b[91Gsay,\u001b[96GI'll\u001b[101Ggo\u001b[104Gon\u001b[107Gwith\u001b[112Gslice\u001b[118G3\r\u001b[2C\u001b[1Bafter\u001b[9Gthis\u001b[14Ggate\u001b[19Gand\u001b[23Grun\u001b[27Gthe\u001b[31Gnext\u001b[36Ggate\u001b[41Gonly\u001b[46Gonce\u001b[51Gslice\u001b[57G3\u001b[59Gis\u001b[62Gdone\u001b[67G(one\u001b[72Gcommit\u001b[79Gper\u001b[83Gchunk).\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.335, "o", "\u001b[?25l\u001b[H\u001b[5Gfixture te\u001b[16Gts),\u001b[21Gand get\u001b[29G clang-tidy \u001b[42Gn only the files it changed. T\u001b[73Gat tak\u001b[80Gs s\u001b[84Gconds, not minutes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCommits:\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[1mYour\u001b[12Grule as written:\u001b[22m every commit passe\u001b[48G the gate. Under it, each chunk becom\u001b[86Gs one\u001b[92Gcommit,\u001b[100Gso\u001b[103Gyou'd\u001b[109Gget\u001b[113Gthree\r\u001b[2C\u001b[1B \u001b[5G  commits instead of s\u001b[28Gx.\u001b[31G\u001b[K\r\u001b[4C\u001b[1B- \u001b[1mRelaxed, if you allow it:\u001b[22m I keep one\u001b[44Gcommi\u001b[50G per slice.\u001b[62GOnly the\u001b[71Glas\u001b[76Gcommit of each\u001b[91Gchunk is certified\u001b[110Gby\u001b[113Ga\u001b[115Ggate\r\u001b[2C\u001b[1B \u001b[5G  run, and\u001b[16Gthe\u001b[20Gcommits\u001b[28Gin\u001b[31Gbetween\u001b[39Gare\u001b[43Gchecked\u001b[51Gby\u001b[54Gtheir\u001b[60Gown\u001b[64Gtests\u001b[70Gonly.\u001b[76GIf\u001b[79Ga\u001b[81Ggate\u001b[86Grun\u001b[90Gfails,\u001b[97GI\u001b[99Gfix\u001b[103Git\u001b[106Gin\u001b[109Ga\u001b[111Gfurther\r\u001b[4C\u001b[1B \u001b[7Gcommit before you push. That keeps\u001b[42Ghi\u001b[45Gtory r\u001b[52Gad\u001b[55Gble, and s\u001b[66Gnce you\u001b[74Gpush yourself, \u001b[90Gothing ungated ever leaves the\r\u001b[6C\u001b[1Bmach\u001b[12Gne.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMaking the gate itself shorter\u001b[22m is the other l\u001b[49Gver,\u001b[54Gbut it's an engine-side change,\u001b[86Gso I'd raise\u001b[99Git separately. Before\r\u001b[2C\u001b[1Bdoing any\u001b[13Ghing I'd check where \u001b[35Ghe time goes in the gate\u001b[60Glog. A Manifest-onl\u001b[80G change doesn't need \u001b[102Ghe\u001b[105Grender\u001b[112Gr's smoke\r\u001b[2C\u001b[1Btests and reference\u001b[23Gframes,\u001b[31Gwhich\u001b[37Gthe\u001b[41GJettison\u001b[50Gdocs\u001b[55Gput\u001b[59Gat\u001b[62Gabout\u00