[2.826, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[2m6\u001b[9G\u001b[22mt\u001b[11Ge 300 s\u001b[20Geservation lapse\u001b[37G, and failed as PadLost; now\u001b[66Gevery\u001b[72Garriv\u001b[78Gl\u001b[80Gdocks,\r\u001b[6C\u001b[1B\u001b[2m7\u001b[9G\u001b[22mw\u001b[11Gich the\u001b[20Gun checks,\u001b[31Gand it t\u001b[40Gkes 42,483 calls for its 90,000\u001b[72Gsteps, 56,437\u001b[K\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22mbefore. The fixture's\u001b[31Gloop and the\u001b[44Gzero-client run are re-pinned for the\u001b[K\r\u001b[6C\u001b[1B\u001b[2m9\u001b[9G\u001b[22mflight;\u001b[17Gt\u001b[21Gquality \u001b[30Go\u001b[32Gution is carried forward i\u001b[60GJettison's roadmap.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +2 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCommitted \u001b[1maec90b7\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gdocking\u001b[15Gfix\u001b[19Gis\u001b[22Gdone\u001b[27Gand\u001b[31Gcommitted\u001b[41Gin\u001b[44Gboth\u001b[49Grepos,\u001b[56Geach\u001b[61Gwith\u001b[66Gits\u001b[70Ggate\u001b[75Ggreen.\u001b[82GThe\u001b[86Gfindings\u001b[95Gand\u001b[99Gthe\u001b[103Gother-games\u001b[115Gsurvey\r\u001b[1B \u001b[3Gar\u001b[7Gwritten\u001b[15Gup in Jettiso\u001b[29G's roadmap.\u001b[41G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix (Jettison \u001b[38;2;177;185;249m0f973b2\u001b[39m):\r\u001b[2C\u001b[1B\u001b[22m- An inbound ship first flies\u001b[33Garound\u001b[40Gthe\u001b[44Gstation\u001b[52Gto\u001b[55Gan\u001b[58Gapproach\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gits\u001b[87Gpad's\u001b[93Gnormal.\u001b[101GThe\u001b[105Gpoint\u001b[111Gis\u001b[114Gas\u001b[117Gfar\r\u001b[2C\u001b[1B \u001b[5Gbeyo\u001b[10Gd the\u001b[16Gold above-pad point as the ship needs to sto\u001b[61G from\u001b[67Gt\u001b[69Gp speed. The ship\u001b[87Gstop\u001b[93Gthere, then\u001b[105Gfl\u001b[108Ges\u001b[111Gstr\u001b[115Gight\u001b[K\r\u001b[4C\u001b[1Bdown the normal from rest. The\u001b[36G10\u001b[39Gm marg\u001b[46Gn\u001b[48Gis unchanged.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMy first\u001b[14Gtry made the approach\u001b[36Gpoint \u001b[43G waypoint, and that\u001b[63Gmade\u001b[68Gthings\u001b[75Gworse.\u001b[82GSteering\u001b[91Gflies\u001b[97Gthrough\u001b[105Gwaypoints\u001b[115Gat\r\u001b[2C\u001b[1B \u001b[5Gfull speed, so a sample t\u001b[31Gader\u001b[37Gassed it going sideways and hit Ostra\u001b[75GAnchorage at 126 m/s.\u001b[97GStopping \u001b[107Gt the point\u001b[119Gis\r\u001b[4C\u001b[1Bwhat\u001b[10Gfix\u001b[15G it.\u001b[20G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA new dock\u001b[16Gtest\u001b[21Gflies\u001b[27Ga\u001b[29Gshuttle\u001b[37Gin\u001b[40Gfrom\u001b[45G12\u001b[48Gdirections,\u001b[60Geither\u001b[67Gstill\u001b[73Gor\u001b[76Gmoving\u001b[83Gsideways\u001b[92Gat\u001b[95G150\u001b[99Gm/s.\u001b[104GWith\u001b[109Gthe\u001b[113Gold\u001b[117Gcode\r\u001b[2C\u001b[1B \u001b[5G2\u001b[7Gof th\u001b[13Gse\u001b[16G24 never arrived; now all do.  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.127, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[1B\u001b[2m7\u001b[9G\u001b[22mw\u001b[11Gich the\u001b[20Gun checks,\u001b[31Gand it t\u001b[40Gkes 42,483 calls for its 90,000\u001b[72Gsteps, 56,437\u001b[K\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22mbefore. The fixture's\u001b[31Gloop and the\u001b[44Gzero-client run are re-pinned for the\u001b[K\r\u001b[6C\u001b[1B\u001b[2m9\u001b[9G\u001b[22mflight;\u001b[17Gt\u001b[21Gquality \u001b[30Go\u001b[32Gution is carried forward i\u001b[60GJettison's roadmap.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +2 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCommitted \u001b[1maec90b7\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7Gdocking\u001b[15Gfix\u001b[19Gis\u001b[22Gdone\u001b[27Gand\u001b[31Gcommitted\u001b[41Gin\u001b[44Gboth\u001b[49Grepos,\u001b[56Geach\u001b[61Gwith\u001b[66Gits\u001b[70Ggate\u001b[75Ggreen.\u001b[82GThe\u001b[86Gfindings\u001b[95Gand\u001b[99Gthe\u001b[103Gother-games\u001b[115Gsurvey\r\u001b[1B \u001b[3Gar\u001b[7Gwritten\u001b[15Gup in Jettiso\u001b[29G's roadmap.\u001b[41G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe fix (Jettison \u001b[38;2;177;185;249m0f973b2\u001b[39m):\r\u001b[2C\u001b[1B\u001b[22m- An inbound ship first flies\u001b[33Garound\u001b[40Gthe\u001b[44Gstation\u001b[52Gto\u001b[55Gan\u001b[58Gapproach\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gits\u001b[87Gpad's\u001b[93Gnormal.\u001b[101GThe\u001b[105Gpoint\u001b[111Gis\u001b[114Gas\u001b[117Gfar\r\u001b[2C\u001b[1B \u001b[5Gbeyo\u001b[10Gd the\u001b[16Gold above-pad point as the ship needs to sto\u001b[61G from\u001b[67Gt\u001b[69Gp speed. The ship\u001b[87Gstop\u001b[93Gthere, then\u001b[105Gfl\u001b[108Ges\u001b[111Gstr\u001b[115Gight\u001b[K\r\u001b[4C\u001b[1Bdown the normal from rest. The\u001b[36G10\u001b[39Gm marg\u001b[46Gn\u001b[48Gis unchanged.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMy first\u001b[14Gtry made the approach\u001b[36Gpoint \u001b[43G waypoint, and that\u001b[63Gmade\u001b[68Gthings\u001b[75Gworse.\u001b[82GSteering\u001b[91Gflies\u001b[97Gthrough\u001b[105Gwaypoints\u001b[115Gat\r\u001b[2C\u001b[1B \u001b[5Gfull speed, so a sample t\u001b[31Gader\u001b[37Gassed it going sideways and hit Ostra\u001b[75GAnchorage at 126 m/s.\u001b[97GStopping \u001b[107Gt the point\u001b[119Gis\r\u001b[4C\u001b[1Bwhat\u001b[10Gfix\u001b[15G it.\u001b[20G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GA new dock\u001b[16Gtest\u001b[21Gflies\u001b[27Ga\u001b[29Gshuttle\u001b[37Gin\u001b[40Gfrom\u001b[45G12\u001b[48Gdirections,\u001b[60Geither\u001b[67Gstill\u001b[73Gor\u001b[76Gmoving\u001b[83Gsideways\u001b[92Gat\u001b[95G150\u001b[99Gm/s.\u001b[104GWith\u001b[109Gthe\u001b[113Gold\u001b[117Gcode\r\u001b[2C\u001b[1B \u001b[5G2\u001b[7Gof th\u001b[13Gse\u001b[16G24 never arrived; now all do.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt costs a\u001b[16Glittle time: from\u001b[34G10 km, the sh\u001b[76Gbove\u001b[81Gits\u001b[85Gpad\u001b[89Gin\u001b[92G117\u001b[96Gs\u001b[98Ginstead\u001b[106Gof\u001b[109G111\u001b[113Gs.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
