[3.676, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMost\u001b[8Ggames\u001b[14Gavoid\u001b[20Gthis\u001b[25Gproblem\u001b[33Grather\u001b[40Gthan\u001b[45Gsolve\u001b[51Git.\u001b[55GThe\u001b[59Glast\u001b[64Gfew\u001b[68Ghundred\u001b[76Gmetres\u001b[83Gof\u001b[86Gan\u001b[89Gapproach\u001b[98Gare\u001b[102Grarely\u001b[109Gflown\u001b[115Gon\r\u001b[1B \u001b[3Ggeneral steering; they f\u001b[28Gl\u001b[30Gow\u001b[33Ga fixed corridor,\u001b[51Ga speed\u001b[60Gimit, or a script. These are\u001b[89Gmy \u001b[93Gecollections, not checked\r\u001b[2C\u001b[1Bagainst\u001b[12Gources:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo physical approach (EVE Online):\u001b[40G\u001b[22monce\u001b[45Gthe\u001b[49Gship\u001b[54Gis\u001b[57Gwithin\u001b[64Grange,\u001b[71Gdocking\u001b[79Gis\u001b[82Ginstant.\r\u001b[4C\u001b[1B\u001b[1mScripted fin\u001b[18Gl d\u001b[22Gcking (Free\u001b[34Ga\u001b[36Gcer, many older games):\u001b[22m the\u001b[64Gautopilot flies to a ri\u001b[88Gg or\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only gets the ship to the start \u001b[68Gf the\u001b[74Gcorridor.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m sta\u001b[66Gi\u001b[68Gns carry authored\u001b[86Gapproach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B \u001b[5Gholding point, then approach point, then pad along a path, with obstacle avoidance rel\u001b[92Gxed \u001b[97Ggainst\u001b[104Gt\u001b[106Ge station\r\u001b[4C\u001b[1Bitself on the final\u001b[25Gleg. Stuck or circling ships still \u001b[61Gurn up in their bug reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[48G\u001b[22myou request\u001b[60Gpe\u001b[63Gmissio\u001b[71Gand get a\u001b[81Gpad, and\u001b[90Gthe\u001b[94Gpermission\u001b[105Glapses\u001b[112Gif\u001b[115Gyou\r\u001b[2C\u001b[1B \u001b[5Gdon't land in time; that's the same role as \u001b[51Gr res\u001b[57Grvation. A speed limit a\u001b[82Gplies near th\u001b[96G stat\u001b[104G, \u001b[107Gnd the docking\r\u001b[4C\u001b[1Bc\u001b[7Gmputer fl\u001b[17Ges a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the remote-control autopilot\u001b[71Gis\u001b[74Gknown\u001b[80Gfor\u001b[84Gcircling\u001b[93Gor\u001b[96Govershooting\u001b[109Gits\r\u001b[2C\u001b[1B \u001b[5Gwaypoints. Players work around it with a\u001b[46Gslow precisi\u001b[59Gn\u001b[61Gmode or \u001b[70Gheir own scripts. That\u001b[93Gis\u001b[97Gur failure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breas\u001b[10Gn \u001b[13Ghe\u001b[16Gothers constr\u001b[30Gin the last leg.\u001b[K\r\u001b[4C\u001b[1B      \u001b[12G   \u001b[16G      \u001b[23G         \u001b[33G   \u001b[37G    \u001b[42G    \u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.158, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMost\u001b[8Ggames\u001b[14Gavoid\u001b[20Gthis\u001b[25Gproblem\u001b[33Grather\u001b[40Gthan\u001b[45Gsolve\u001b[51Git.\u001b[55GThe\u001b[59Glast\u001b[64Gfew\u001b[68Ghundred\u001b[76Gmetres\u001b[83Gof\u001b[86Gan\u001b[89Gapproach\u001b[98Gare\u001b[102Grarely\u001b[109Gflown\u001b[115Gon\r\u001b[1B \u001b[3Ggeneral steering; they f\u001b[28Gl\u001b[30Gow\u001b[33Ga fixed corridor,\u001b[51Ga speed\u001b[60Gimit, or a script. These are\u001b[89Gmy \u001b[93Gecollections, not checked\r\u001b[2C\u001b[1Bagainst\u001b[12Gources:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo physical approach (EVE Online):\u001b[40G\u001b[22monce\u001b[45Gthe\u001b[49Gship\u001b[54Gis\u001b[57Gwithin\u001b[64Grange,\u001b[71Gdocking\u001b[79Gis\u001b[82Ginstant.\r\u001b[4C\u001b[1B\u001b[1mScripted fin\u001b[18Gl d\u001b[22Gcking (Free\u001b[34Ga\u001b[36Gcer, many older games):\u001b[22m the\u001b[64Gautopilot flies to a ri\u001b[88Gg or\u001b[93Gentry\u001b[99Gpoint,\u001b[106Gthen\u001b[111Gan\r\u001b[2C\u001b[1B \u001b[5Ganimation takes over. Physics only gets the ship to the start \u001b[68Gf the\u001b[74Gcorridor.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mApproach corridors (X4, Star Citizen's traffic control):\u001b[22m sta\u001b[66Gi\u001b[68Gns carry authored\u001b[86Gapproach\u001b[95Gpaths.\u001b[102GA\u001b[104Gship\u001b[109Gflies\r\u001b[2C\u001b[1B \u001b[5Gholding point, then approach point, then pad along a path, with obstacle avoidance rel\u001b[92Gxed \u001b[97Ggainst\u001b[104Gt\u001b[106Ge station\r\u001b[4C\u001b[1Bitself on the final\u001b[25Gleg. Stuck or circling ships still \u001b[61Gurn up in their bug reports.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAssisted manual docking (Elite Dangerous):\u001b[48G\u001b[22myou request\u001b[60Gpe\u001b[63Gmissio\u001b[71Gand get a\u001b[81Gpad, and\u001b[90Gthe\u001b[94Gpermission\u001b[105Glapses\u001b[112Gif\u001b[115Gyou\r\u001b[2C\u001b[1B \u001b[5Gdon't land in time; that's the same role as \u001b[51Gr res\u001b[57Grvation. A speed limit a\u001b[82Gplies near th\u001b[96G stat\u001b[104G, \u001b[107Gnd the docking\r\u001b[4C\u001b[1Bc\u001b[7Gmputer fl\u001b[17Ges a fixed approach in through the entrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m the remote-control autopilot\u001b[71Gis\u001b[74Gknown\u001b[80Gfor\u001b[84Gcircling\u001b[93Gor\u001b[96Govershooting\u001b[109Gits\r\u001b[2C\u001b[1B \u001b[5Gwaypoints. Players work around it with a\u001b[46Gslow precisi\u001b[59Gn\u001b[61Gmode or \u001b[70Gheir own scripts. That\u001b[93Gis\u001b[97Gur failure,\u001b[109Gand\u001b[113Gthe\r\u001b[4C\u001b[1Breas\u001b[10Gn \u001b[13Ghe\u001b[16Gothers constr\u001b[30Gin the last leg.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Ggames\u001b[15Gcombine\u001b[23Gfour\u001b[28Gtechniques:\u001b[27;1H\u001b[24;3H\u001b[?25h"]
