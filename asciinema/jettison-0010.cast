[0.028, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mBerth fees\u001b[16G\u001b[22mare\u001b[20G20\u001b[23Gcredits\u001b[31Gan\u001b[34Ghour\u001b[39Gfor\u001b[43Ga\u001b[45Gskiff,\u001b[52Gup\u001b[55Gto\u001b[58G10,800\u001b[65Gfor\u001b[69Ga\u001b[71Gcruiser.\u001b[80GOn\u001b[83Gtop\u001b[87Gof\u001b[90Gthat\u001b[95Gis\u001b[98G2\u001b[100Gcredits\u001b[108Gan\u001b[111Ghour\u001b[116Gfor\r\u001b[1B \u001b[3G  each occupan\u001b[18G while the station's life support\u001b[52Gis\u001b[55Gconnected.\r\u001b[1B  - \u001b[1mArrears\u001b[22m keep the ship docked. After 7 simulation days the station\u001b[71Gsells\u001b[77Gits\u001b[81Gcargo\u001b[87Gat\u001b[90Gthe\u001b[94Glive\u001b[99Gbids\u001b[104Guntil\u001b[110Gthe\u001b[114Gdebt\u001b[119Gis\r\u001b[4C\u001b[1Bpaid.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLife support used in transit\u001b[34G\u001b[22mis\u001b[37Gcharged\u001b[45Gto\u001b[48Gthe\u001b[52Glot\u001b[56Gaboard,\u001b[64Gat\u001b[67Gwhat\u001b[72Gthe\u001b[76Gcompany\u001b[84Gpaid\u001b[89Gfor\u001b[93Gthose\u001b[99Gsupplies.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAI operators\u001b[18G\u001b[22mmove\u001b[23Gtheir fees once a day\u001b[45Gwith how\u001b[54Gfull their pads are: 10% up when\u001b[87Gmore\u001b[92Gthan\u001b[97G3/4\u001b[101Gare\u001b[105Gtaken,\u001b[112G10%\u001b[116Gdown\r\u001b[4C\u001b[1Bwhen fewer than\u001b[21G1/4 are, \u001b[31Gtaying between half and\u001b[55Gtwice the\u001b[65Gdefaults.\u001b[75G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlice 1 (fees by pad class):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvery\u001b[11Gvenue\u001b[17Gposts\u001b[23Ga\u001b[25Gdocking\u001b[33Gfee\u001b[37Gand\u001b[41Gan\u001b[44Ghourly\u001b[51Gberth\u001b[57Gfee\u001b[61Gfor\u001b[65Geach\u001b[70Gpad\u001b[74Gclass,\u001b[81Gplus\u001b[86Gthe\u001b[90Gper-occupant\u001b[103Grate.\u001b[109GA\u001b[111Gship\u001b[116Gpays\r\u001b[4C\u001b[1Bthe rate for it\u001b[23Gu\u001b[25Gl's own pad class, w\u001b[46Gatever pad it actually lands\u001b[75Gon.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe defaults are in \u001b[38;2;177;185;249mbalance.yaml\u001b[39m. The\u001b[43Gcontent check refuses a pad class that i\u001b[84G unknown,\u001b[94Gcharged\u001b[102Gtwice\u001b[108Gor\u001b[111Gleft\u001b[116Gout;\r\u001b[4C\u001b[1Ba save refuses fees out\u001b[29Gof\u001b[32Gorder.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI first ran the\u001b[21Gnew\u001b[25Glayout\u001b[32Gwith\u001b[37GW10's\u001b[43Gold\u001b[47G10\u001b[50Gand\u001b[54G2\u001b[56Gcredit\u001b[63Gfees.\u001b[69GOnly\u001b[74Gthree\u001b[80Gstored\u001b[87Gworld-hash\u001b[98Gchecks\u001b[105Gchanged\u001b[113G(one\r\u001b[4C\u001b[1Bcompany,\u001b[14Gtwo\u001b[18Gfixture)\u001b[27Gand\u001b[31Gevery\u001b[37Gother\u001b[43Gcheck\u001b[49Gheld,\u001b[55Gso\u001b[58Gthe\u001b[62Gchange\u001b[69Gwas\u001b[73Gin\u001b[76Ghow\u001b[80Gfees\u001b[85Gare\u001b[89Gstored,\u001b[97Gnot\u001b[101Gin\u001b[104Gbehaviour.\u001b[115GThe\r\u001b[1B \u001b[3G  real amounts then changed those three again,\u001b[50Gand\u001b[54Gthe\u001b[58Gconsole's\u001b[68Gtrading\u001b[76Grun\u001b[80Gnow\u001b[84Gends\u001b[89G90\u001b[92Gcredits\u001b[100Glower:\u001b[107Gexactly\u001b[115Gthe\r\u001b[1B    docking fee's rise.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mChoices I made myself\u001b[22m (in the plan; easy to change before slices 4 and 5):\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gfailed\u001b[14Gjourney's\u001b[24Gdocking\u001b[32Gfee\u001b[36Gis\u001b[39Gstill\u001b[45Gnot\u001b[49Grefunded,\u001b[59Gas\u001b[62Gin\u001b[65GW10.\r\u001b[1B \u001b[3G- \"What the company paid\" means the last price it paid\u001b[58Gfor\u001b[62Goxygen\u001b[69Gor\u001b[72Gcartridges.\u001b[84GSupplies\u001b[93Git\u001b[96Gnever\u001b[102Gbought,\u001b[110Glike\u001b[115Ga\u001b[117Gnew\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.138, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mAr\u001b[8Gears\u001b[22m keep the ship docked. After 7\u001b[43Gsimulation days the station\u001b[71Gsell\u001b[76G its cargo\u001b[87Gat\u001b[92Ge l\u001b[96Gve bids until t\u001b[112Ge debt is\r\u001b[4C\u001b[1Bp\u001b[7Gid.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mLif\u001b[9G support used in transit\u001b[22m is charged to the lot aboard, at what the company paid for thos\u001b[99Gsupplies.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAI operators\u001b[18G\u001b[22mmove\u001b[23Gtheir\u001b[29Gfees\u001b[34Gonce\u001b[39Ga\u001b[41Gday\u001b[45Gwith\u001b[50Ghow\u001b[54Gfull\u001b[59Gtheir\u001b[65Gpads\u001b[70Gare:\u001b[75G10%\u001b[79Gup\u001b[82Gwhen\u001b[87Gmore\u001b[92Gthan\u001b[97G3/4\u001b[101Gare\u001b[105Gtaken,\u001b[112G10%\u001b[116Gdown\r\u001b[2C\u001b[1B \u001b[5Gwhen fewer than 1/4 are, stay\u001b[35Gng betw\u001b[43Gen half and twice the defaults.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSlice 1 (fees by pad class):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GEvery\u001b[11Gvenue\u001b[17Gposts\u001b[23Ga\u001b[25Gdocking\u001b[33Gfee\u001b[37Gand\u001b[41Gan\u001b[44Ghourly\u001b[51Gberth\u001b[57Gfee\u001b[61Gfor\u001b[65Geach\u001b[70Gpad\u001b[74Gclass,\u001b[81Gplus\u001b[86Gthe\u001b[90Gper-occupant\u001b[103Grate.\u001b[109GA\u001b[111Gship\u001b[116Gpays\r\u001b[2C\u001b[1B  the rate for its hull's own\u001b[33Gpad\u001b[37Gclass,\u001b[44Gwhatever\u001b[53Gpad\u001b[57Git\u001b[60Gactually\u001b[69Glands\u001b[75Gon.\r\u001b[4C\u001b[1BTh\u001b[8G defaults are in\u001b[25G\u001b[38;2;177;185;249mbalance.yaml\u001b[39m. The content\u001b[51Gcheck\u001b[57Gr\u001b[59Gfuses\u001b[65Ga pad class that is unknown, charged twic\u001b[107G or\u001b[111Gleft\u001b[116Gout;\r\u001b[4C\u001b[1Ba save re\u001b[15Guses fees out\u001b[30Gf order.\u001b[K\r\u001b[4C\u001b[1BI first ran the new\u001b[25Glayout with W10's\u001b[43Gold 10 and 2 c\u001b[59Gdit fees. Only three stored world-hash checks \u001b[106Ghanged (one\u001b[K\r\u001b[4C\u001b[1Bcompany, two fixture) and every other\u001b[43Gcheck\u001b[49Gheld,\u001b[55Gso\u001b[58Gthe\u001b[62Gchange\u001b[69Gwas\u001b[73Gin\u001b[76Ghow\u001b[80Gfees\u001b[85Gare\u001b[89Gstored,\u001b[97Gnot\u001b[101Gin\u001b[104Gbehaviour.\u001b[115GThe\r\u001b[2C\u001b[1B \u001b[5Greal amounts the\u001b[22G changed those\u001b[37Gthree\u001b[43Gagain,\u001b[54Gthe consol\u001b[65G'\u001b[67G trading \u001b[77Gun\u001b[80Gnow \u001b[85Gnds 90 credits lower: exactly the\r\u001b[4C\u001b[1Bd\u001b[7Gcki\u001b[11Gg fee's rise.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChoices I made myself\u001b[25G\u001b[22m(in\u001b[29Gthe\u001b[33Gplan;\u001b[39Geasy\u001b[44Gto\u001b[47Gchange\u001b[54Gbefore\u001b[61Gslices\u001b[68G4\u001b[70Gand\u001b[74G5):\r\u001b[2C\u001b[1B-\u001b[5GA\u001b[7Gfailed\u001b[14Gjourney's\u001b[24Gdocking\u001b[32Gfee\u001b[36Gis\u001b[39Gstill\u001b[45Gnot\u001b[49Grefunded,\u001b[59Gas\u001b[62Gin\u001b[65GW10.\r\u001b[2C\u001b[1B- \"What the company paid\"\u001b[29Gmeans the\u001b[39Gl\u001b[42Gt\u001b[44Gpri\u001b[48Ge it paid for oxygen or cartridges.\u001b[84GSupplies\u001b[93Git\u001b[96Gnever\u001b[102Gbought,\u001b[110Glike\u001b[115Ga\u001b[117Gnew\r\u001b[2C\u001b[1B \u001b[5Gship's starti\u001b[19Gg tanks, count as free. I\u001b[45Gchose this to\u001b[60Gvo\u001b[63Gd\u001b[65Gtracking\u001b[74Ga\u001b[76Gcost\u001b[81Gon\u001b[84Gevery\u001b[90Glot\u001b[94Gin\u001b[97Gthe\u001b[101Ghold.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
