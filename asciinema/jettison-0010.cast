[0.006, "o", "\u001b[H\r\u001b[5B←  ☒ Docking fee \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Berth fee \r\u001b[16C\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mdock\u001b[22Gd ship's hourly berth fee be based on? D-047 s\u001b[70Gs it includes\u001b[84Gconnected life support. (Today it is\r\u001b[2C\u001b[1B2 cr\u001b[8Gdi\u001b[11Gs a simulation hour.)\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[2B\u001b[38;2;177;185;249mPad + occupants (Recommended)\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mAn hourly\u001b[16Grate f\u001b[23Gr th\u001b[28G pad cl\u001b[36Gss, plus\u001b[45Ga rate per occupant while connected to the station's\u001b[98Glife suppo\u001b[109Gt.\u001b[112GDefaults:\r\u001b[5C\u001b[1B20 \u001b[10Gn hour for a skiff pad and 2\u001b[39Gan hour\u001b[47Gper occupant.\u001b[39m\u001b[K\r\u001b[5C\u001b[1BPad class o\u001b[18Gly\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mA\u001b[8G hourly \u001b[17Gat\u001b[20G p\u001b[23Gr pad cla\u001b[33Gs, with life supp\u001b[51Grt fold\u001b[60G into it. No s\u001b[75Gparate \u001b[83Gccupant charge.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3.\u001b[6G\u001b[39mFlat per\u001b[15Gvenue\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;153;153;153mOne hourly fee per venue with life support included, defaulting to 20 an hour.\r\u001b[2C\u001b[1B4. Type som\u001b[15Gthing.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m5.\u001b[6GChat\u001b[11Gabout this\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to selec\u001b[16G · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[K\u001b[27;1H\u001b[11;1H"]
