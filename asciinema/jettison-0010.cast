[0.039, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bat about 100 m/s, moving sid\u001b[34Gways to the target,\u001b[54Gand \u001b[59Gvershot by about 50 m into the keep-away zone.\u001b[106G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIns\u001b[9Gd\u001b[11G th\u001b[15Gt zon\u001b[21G, \u001b[24Gvoidance commands\u001b[42Gup\u001b[45Gto\u001b[48Gabout\u001b[54G190\u001b[58Gm/s\u001b[62Goutward\u001b[70Gwhile\u001b[76Garrival\u001b[84Gpulls\u001b[90Gthe\u001b[94Gship\u001b[99Gback\u001b[104Gin.\u001b[108GThat\u001b[113Gputs\r\u001b[2C\u001b[1B \u001b[5Genergy back in every l\u001b[28Gp: the ship circled 30–55 m from th\u001b[64G point at about 40 m/s for the\u001b[95Gpad's\u001b[101Gfull\u001b[106G300\u001b[110Gs,\u001b[113Gnever\r\u001b[4C\u001b[1Barrived,\u001b[14Gand\u001b[18Gthe\u001b[22Gpad\u001b[26Glapsed.\r\u001b[2C\u001b[1B- Ship1 came in\u001b[19Gthrough \u001b[28G wa\u001b[32Gpoint too and arrived; its geometry happ\u001b[73Gned not to overshoot.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[22m I\u001b[21Gtemporarily\u001b[33Graised the\u001b[44Gmargin to 100 \u001b[59G in\u001b[64Ghe fetched \u001b[76Gngine\u001b[82Gcopy\u001b[87Gand\u001b[91Greran.\u001b[98GShip2\u001b[104Gstill\u001b[110Govershot,\r\u001b[2C\u001b[1Bto\u001b[6Gabout\u001b[12G180\u001b[16Gm,\u001b[19Gbut\u001b[23Gswung\u001b[29Gback\u001b[34Gand\u001b[38Garrived\u001b[46G62\u001b[49Gs\u001b[51Gafter\u001b[57Gthe\u001b[61Gcruise\u001b[68Gended,\u001b[75Gabout\u001b[81Gas\u001b[84Glong\u001b[89Gas\u001b[92Gother\u001b[98Garrivals\u001b[107Gtake,\u001b[113Gand\u001b[117Gno\r\u001b[2C\u001b[1Bpad lapsed in the 25 minutes. Both edits\u001b[44Gand the experiment\u001b[63Gtest are \u001b[73Ge\u001b[75Gerted.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposed fix (Jettison, dock):\u001b[22m w\u001b[36Gden the m\u001b[46Grgi\u001b[51Gso that the sh\u001b[66Gp's arrival zone\u001b[83Gplus\u001b[89G fast\u001b[95Garrival's ov\u001b[108Grshoo\u001b[114G stays\r\u001b[2C\u001b[1Bclear of \u001b[13Ghe keep-away zone. I'd\u001b[36Gtie the margin to\u001b[54Gthe ship's braking \u001b[74Gistanc\u001b[81G rather \u001b[90Ghan\u001b[94Ga fixed numb\u001b[107Gr, and add\u001b[118Ga\r\u001b[2C\u001b[1Bdock test:\u001b[14Ga\u001b[16G inbound\u001b[25Gship rou\u001b[34Gding \u001b[40Ghe station from\u001b[56Gth\u001b[60Gf\u001b[62Gr side\u001b[69Gat full\u001b[77Gspeed must arrive before the\u001b[106Greservation\r\u001b[2C\u001b[1Blapses.\u001b[11GIt\u001b[14Gchanges\u001b[22Gflight\u001b[29Gpaths,\u001b[36Gso\u001b[39Gthe\u001b[43Gworld-hash\u001b[54Gpins\u001b[59Gin\u001b[62GJettison\u001b[71Gand\u001b[75GManifest's\u001b[86Gfixture\u001b[94Gpin\u001b[98Gwill\u001b[103Gmove,\u001b[109Gand\u001b[113GI'll\r\u001b[2C\u001b[1Bc\u001b[5Geck that only those moved. One\u001b[36GJettis\u001b[43Gn commit and\u001b[56Gone Manifest commit,\u001b[77Geach\u001b[82Gwith\u001b[87Gthe\u001b[91Ggate\u001b[96Ggreen.\r\u001b[2C\u001b[2BShould I do this fix before\u001b[31GL28, or \u001b[40Gecord it and go st\u001b[59Gaight to L28?\u001b[K\u001b[27;1H\u001b[24;72H\u001b[?25h"]
