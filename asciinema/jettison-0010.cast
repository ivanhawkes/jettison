nce\u001b[10Gthe\u001b[14Gbuilds\u001b[21Grun\u001b[25Gat\u001b[28Gthe\u001b[32Gsame\u001b[37Gtime,\u001b[43Gneither\u001b[51Gstage\u001b[57Gis\u001b[60Gthe\u001b[64Gslowest,\u001b[73Gso\u001b[76Gskipping\u001b[85Gthem\u001b[90Gsaves\u001b[96Galmost\u001b[103Gno\u001b[106Gtime.\u001b[112GI'd\u001b[116Gkeep\r\u001b[4C\u001b[1Bboth.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocumentation-only commits\u001b[32G\u001b[22malready\u001b[40Gskip\u001b[45Gthe\u001b[49Ggate\u001b[54Gautomatically,\u001b[69Gbecause\u001b[77Gthe\u001b[81Ggate\u001b[86Gignores\u001b[94G\u001b[38;2;177;185;249m.md\u001b[98G\u001b[39mfiles\u001b[104Gwhen\u001b[109Gdeciding\r\u001b[2C\u001b[1B \u001b[5Gwhether anything changed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mJettison\u001b[22m, which only matters\u001b[34Gwhen\u001b[39GManifest\u001b[48Gneeds\u001b[54Ga\u001b[56Gnew\u001b[60Gengine\u001b[67Gversion:\u001b[76Gthe\u001b[80Grendering\u001b[90Gsmoke\u001b[96Gtests\u001b[102Gand\u001b[106Greference\r\u001b[2C\u001b[1B \u001b[5Gframes are about two\u001b[26Gthirds of its gate.  \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
