[0.206, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B│\u001b[17GBuild\u001b[36G│\u001b[38GTime\u001b[44G│\u001b[62GNote\u001b[83G│\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│ debug\u001b[11G    \u001b[16G  \u001b[19G \u001b[21G   \u001b[25G \u001b[27G \u001b[29G  \u001b[32G   \u001b[36G│ 38\u001b[41Gs \u001b[44G│ tests 25 s, mostly \u001b[66Ghe fixtur\u001b[77Gsui\u001b[81Ge │\u001b[K\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5Gwithout\u001b[13Gthe\u001b[17Gterminal\u001b[26Ginterface\u001b[36G│\u001b[38G66\u001b[41Gs\u001b[44G│\u001b[83G│\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5Grelease\u001b[36G│\u001b[38G69\u001b[41Gs\u001b[44G│\u001b[83G│\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5Gs\u001b[7Gnit\u001b[11Gs\u001b[13Grs     \u001b[21G   \u001b[25G      \u001b[32G    │ 210 s\u001b[44G│ build about 66\u001b[61Gs, tes\u001b[68Gs\u001b[70G144 s\u001b[76G  \u001b[79G   \u001b[83G│\u001b[K\r\u001b[2C\u001b[1B└────────────────────────────────┴───────┴──────────────────────────────────────┘\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gsanitiser run is the long pole,\u001b[39Gand\u001b[43Gwithin\u001b[50Git\u001b[53Gthe\u001b[57Gfixture\u001b[65Gsuite.\u001b[72GThe\u001b[76Gfixture\u001b[84Gsuite\u001b[90Ghas\u001b[94Gonly\u001b[99G4\u001b[101Gtest\u001b[106Gcases,\u001b[113Gand\u001b[117Gtwo\r\u001b[2C\u001b[1Bof\u001b[6Gthem take 13 s and 7 s \u001b[30Gf its 25 s\u001b[41Gin debug.\u001b[51GUnder the sanitisers, the next\u001b[82Gslowest are content (60\u001b[106Gs)\u001b[109Gand\u001b[113Gtravel\r\u001b[2C\u001b[1B(31 s).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed-ups that keep every check\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mGate a separate copy (biggest saving).\u001b[22m Keep a second checkout beside Manifest with\u001b[89Gits own build folders.\u001b[112GI\u001b[114Gcommit\r\u001b[2C\u001b[1B  \u001b[6Ga slice, point the second \u001b[33Gheckout at that commit, run the gate there in the background, and start\u001b[105Gthe next\u001b[114Gslic\u001b[119G\u001b[K\r\u001b[5C\u001b[1Bstra\u001b[11Gght away. \u001b[22Gf the\u001b[28Ggate fails, the fix\u001b[76Gou push.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.547, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Glooked\u001b[15Gat the remaining\u001b[32Gwork,\u001b[38Gat both\u001b[46Ggates'\u001b[53Gscripts,\u001b[62Gand at\u001b[69Gwhere\u001b[75Gthis\u001b[80Gmorning's\u001b[90Ggate\u001b[95Gspent\u001b[101Gits\u001b[105G6.4\u001b[109Gminutes.\u001b[118GThe\r\u001b[2C\u001b[1Bbiggest saving isn't fewer gates or skipped stages. It's running the gate on a separate\u001b[91Gcopy\u001b[96Gof\u001b[99Gthe\u001b[103Gcode,\u001b[109Gso\u001b[112GI\u001b[114Gkeep\r\u001b[2C\u001b[1Bworkin\u001b[11Gwhile\u001b[17Git\u001b[20Gruns,\u001b[26Gwhich\u001b[32Gkeeps\u001b[38Ga gated\u001b[46Gcheck\u001b[52Gon\u001b[55Gevery commit.\u001b[69GOn \u001b[73Gop of that,\u001b[85GManifest's\u001b[96Ggate\u001b[101Gcan\u001b[105Gbe\u001b[108Gmade\u001b[113Gabout\r\u001b[2C\u001b[1Btwice as fast without dropping anything.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere the Manifest gate's time goes\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BToday's gate ran four builds one after another, each building and then running the\u001b[86Gwhole\u001b[92Gtest\u001b[97Gset:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌\u001b[36G┬\u001b[44G┬\u001b[83G┐\r\u001b[2C\u001b[1B│\u001b[17GBuild\u001b[36G│\u001b[38GTime\u001b[44G│\u001b[62GNote\u001b[83G│\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│ debug\u001b[11G    \u001b[16G  \u001b[19G \u001b[21G   \u001b[25G \u001b[27G \u001b[29G  \u001b[32G   \u001b[36G│ 38\u001b[41Gs \u001b[44G│ tests 25 s, mostly \u001b[66Ghe fixtur\u001b[77Gsui\u001b[81Ge │\u001b[K\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5Gwithout\u001b[13Gthe\u001b[17Gterminal\u001b[26Ginterface\u001b[36G│\u001b[38G66\u001b[41Gs\u001b[44G│\u001b[83G│\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5Grelease\u001b[36G│\u001b[38G69\u001b[41Gs\u001b[44G│\u001b[83G│\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5Gs\u001b[7Gnit\u001b[11Gs\u001b[13Grs     \u001b[21G   \u001b[25G      \u001b[32G    │ 210 s\u001b[44G│ build about 66\u001b[61Gs, tes\u001b[68Gs\u001b[70G144 s\u001b[76G  \u001b[79G   \u001b[83G│\u001b[K\r\u001b[2C\u001b[1B└────────────────────────────────┴───────┴──\u001b[76G───────┘\u001b[27;1H\u001b[24;3H\u001b[?25h"]
