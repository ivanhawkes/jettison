[0.003, "o", "\u001b[?25l\u001b[H  - \u001b[1mTidy in the gate:\u001b[22m the gate now runs with \u001b[38;2;177;185;249m--tidy\u001b[39m, as CI does. It skips files that were clean and haven't changed (57\u001b[K\r\u001b[4C\u001b[1Bof\u001b[8G58\u001b[11Gskipped\u001b[19Gthis\u001b[24Gtime).\u001b[31GIts\u001b[35Gfirst\u001b[41Grun\u001b[45Gfound\u001b[51Gone\u001b[55Gfinding\u001b[63Gleft\u001b[68Gfrom\u001b[73GW10\u001b[77Gin\u001b[80G\u001b[38;2;177;185;249mPolicy.cpp:673\u001b[95G\u001b[39mthat\u001b[100GCI\u001b[103Gwould\u001b[109Ghave\u001b[114Grefused\r\u001b[2C\u001b[1B  on your next push. It's\u001b[29Gfixed\u001b[35Gin\u001b[38GManifest\u001b[47G\u001b[38;2;177;185;249m1d08379\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSecond checkout:\u001b[22G\u001b[22m\u001b[38;2;177;185;249mbuild/gate-tree\u001b[38G\u001b[39mis\u001b[41Ga\u001b[43Gseparate\u001b[52Gworking\u001b[60Gcopy\u001b[65Gof\u001b[68GManifest.\u001b[78GI\u001b[80Gpoint\u001b[86Git\u001b[89Gat\u001b[92Ga\u001b[94Gcommit\u001b[101Gand\u001b[105Grun\u001b[109Gthe\u001b[113Ggate\r\u001b[1B \u001b[3G  there, and the only\u001b[25Gwork I do wh\u001b[38Gle it\u001b[44Gruns is editing code. The first run there took 15 minutes because it built\u001b[K\r\u001b[2C\u001b[1B  everything from scratch; it \u001b[34Gon't need that again. The routine\u001b[68Gis\u001b[71Gin\u001b[74G\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[98G\u001b[39munder\u001b[104G\"Gating\u001b[112Gbeside\r\u001b[4C\u001b[1Bthe\u001b[9Gwork\",\u001b[16Gwith\u001b[21Gyour\u001b[26Grule\u001b[31Gthat\u001b[36Gnothing\u001b[44Gbuilds\u001b[51Galongside\u001b[61Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot pushed:\u001b[15G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[13G: \u001b[38;2;177;185;249mad\u001b[18Gf6b3\u001b[23G\u001b[39m(slice 2),\u001b[34G\u001b[38;2;177;185;249mb108190\u001b[39m,\u001b[43G\u001b[38;2;177;185;249m1d08379\u001b[39m.\r\u001b[4C\u001b[1BJettison: \u001b[38;2;177;185;249m209590e\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNext\u001b[8Gis W18 slice 3,\u001b[24Gthe AI operators' daily fee rule,\u001b[58Ggated\u001b[64Gin\u001b[67Gthe\u001b[71Gsecond\u001b[78Gcheckout.\u001b[88GOpus\u001b[93Gat\u001b[96Gmedium\u001b[103Geffort\u001b[110Gis\u001b[113Genough\r\u001b[2C\u001b[1Bfor it.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTh\u001b[6G second checkout lives inside Manif\u001b[42Gst's \u001b[38;2;177;185;249mbuild/\u001b[39m fold\u001b[59Gr, so d\u001b[67Gleting\u001b[74G\u001b[38;2;177;185;249mbuild/\u001b[39m deletes it. If that happens, run \u001b[38;2;177;185;249mgit \r\u001b[2C\u001b[1Bworktree prune\u001b[39m and recreat\u001b[31Git with the \u001b[38;2;177;185;249mgit worktree add\u001b[39m command\u001b[68Gin\u001b[71Gthe\u001b[75Gdocs;\u001b[81Gthe\u001b[85Gnext\u001b[90Ggate\u001b[95Gthere\u001b[101Gthen\u001b[106Gtakes\u001b[112Gabout\u001b[118G15\r\u001b[2C\u001b[1Bminutes\u001b[11Gagain.\u001b[18GIt\u001b[21Galso\u001b[26Guses\u001b[31Gabout\u001b[37G14\u001b[40GGB\u001b[43Gof\u001b[46Gdisk.\u001b[52GI\u001b[54Gdidn't\u001b[61Grun\u001b[65Gthe\u001b[69Gcontent\u001b[77Gsuite\u001b[83G(60\u001b[87Gs\u001b[89Gunder\u001b[95Gthe\u001b[99Gsanitisers),\u001b[112Gso\u001b[115GI\r\u001b[2C\u001b[1Bdon't know whether\u001b[22Git\u001b[25Gis\u001b[28Gnow\u001b[32Gwhat\u001b[37Glimits\u001b[44Gthe\u001b[48Gtest\u001b[53Gstage.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCogitated for 21m 18s · done 6:18 pm\u001b[47G\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
