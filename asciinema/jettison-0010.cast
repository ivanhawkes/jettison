[0.138, "o", "\u001b[?25l\u001b[H\u001b[3Gpad lapsed in the 25 mi\u001b[27Gutes. Both\u001b[38Gedits and the experim\u001b[60Gnt te\u001b[66Gt\u001b[68Gare reverted.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mProposed fix (Jettison, dock):\u001b[34G\u001b[22mwiden\u001b[40Gthe\u001b[44Gmargin\u001b[51Gso\u001b[54Gthat\u001b[59Gthe\u001b[63Gship's\u001b[70Garrival\u001b[78Gzone\u001b[83Gplus\u001b[88Ga\u001b[90Gfast\u001b[95Garrival's\u001b[105Govershoot\u001b[115Gstays\r\u001b[2C\u001b[1Bclear of the keep-away zone. I'd tie\u001b[51Gt\u001b[56Ge ship'\u001b[64G braking distance rather th\u001b[92Gn a fixed number, and add a\u001b[K\r\u001b[2C\u001b[1Bdock test: an inbound ship roun\u001b[35Ging the st\u001b[46Gtio\u001b[51Gfrom the far side at full spe\u001b[81Gd must arrive before\u001b[102Gthe reservation\u001b[118G\u001b[K\r\u001b[2C\u001b[1Blapses. It\u001b[14Gchanges flig\u001b[27Gt paths, so\u001b[43Gworld-hash pins in Jettison and Manif\u001b[81Gst's fixture pin will move, and I'll\r\u001b[2C\u001b[1Bcheck tha\u001b[14Gonly those moved. One\u001b[36GJet\u001b[40Gison commit and one Manifest commit, each with the gate green.\u001b[103G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gdo\u001b[15Gthis\u001b[20Gfix\u001b[24Gbefore\u001b[31GL28,\u001b[36Gor\u001b[39Grecord\u001b[46Git\u001b[49Gand\u001b[53Ggo\u001b[56Gstraight\u001b[65Gto\u001b[68GL28?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gchecked\u001b[21Gwhether\u001b[29Ga\u001b[31G100\u001b[35Gm\u001b[37Gmargin\u001b[44Gcauses\u001b[51Gother\u001b[57Gproblems,\u001b[67Gsuch\u001b[72Gas\u001b[75Gpads\u001b[80Gnear\u001b[85Ga\u001b[87Gneighbouring\u001b[100Gbody\u001b[105Gor\u001b[108Gdisplay\u001b[116Gpads.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 7m 20s · done 3:59 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mHow is this handled in other space games with ship docking?\u001b[39m                                                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMost\u001b[8Ggames\u001b[14Gavoid\u001b[20Gthis\u001b[25Gproblem\u001b[33Grather\u001b[40Gthan\u001b[45Gsolve\u001b[51Git.\u001b[55GThe\u001b[59Glast\u001b[64Gfew\u001b[68Ghundred\u001b[76Gmetres\u001b[83Gof\u001b[86Gan\u001b[89Gapproach\u001b[98Gare\u001b[102Grarely\u001b[109Gflown\u001b[115Gon\r\u001b[1B \u001b[3Ggeneral steering; they f\u001b[28Gl\u001b[30Gow\u001b[33Ga fixed corridor,\u001b[51Ga speed\u001b[60Gimit, or a script. These are\u001b[89Gmy \u001b[93Gecollections, not checked\r\u001b[2C\u001b[1Bagainst\u001b[12Gources:\u001b[K\r\u001b[2B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
