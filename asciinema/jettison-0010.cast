[0.017, "o", "\u001b[?25l\u001b[H\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m16\u001b[15G\u001b[22mlines to \u001b[1mbuild/commit-dock-approach.txt\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m1\u001b[9G\u001b[22mDock:\u001b[15Ga\u001b[17Gship\u001b[22Gflown\u001b[28Gin\u001b[31Gstops\u001b[37Gout\u001b[41Galong\u001b[47Gits\u001b[51Gpad's\u001b[57Gnormal,\u001b[65Gthen\u001b[70Gcomes\u001b[76Gstraight\u001b[85Gdown\u001b[90Git\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3\u001b[9G\u001b[22mM\u001b[11Gnifest'\u001b[19G W10 zer\u001b[28G-clien\u001b[36Grun\u001b[40Gl\u001b[42Gst a pad:\u001b[52Ga \u001b[55Ghip that came\u001b[69Ground th\u001b[79Gst\u001b[83Gion\r\u001b[6C\u001b[1B\u001b[2m4\u001b[9G\u001b[22mfast a\u001b[16Gd\u001b[18Gsideways\u001b[27Govershot the poi\u001b[44Gt above its pad,\u001b[61Gonly\u001b[66G10 m outside what\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[9G\u001b[22ms\u001b[11Geering\u001b[18Gkeeps\u001b[24Git from, and avoida\u001b[44Gce pushed it ou\u001b[60G each lap whil\u001b[76GArriv\u001b[83Gpulled\r\u001b[6C\u001b[1B\u001b[2m6\u001b[9G\u001b[22mit back, so \u001b[22Gt circled the poi\u001b[40Gt until its reservation lap\u001b[68Ged.\u001b[72GThe course now\u001b[K\r\u001b[6C\u001b[1B\u001b[2m7\u001b[9G\u001b[22mends at a\u001b[19Gpo\u001b[22Gnt out along the normal as far bey\u001b[57Gnd as the ship stops\u001b[78Gi\u001b[80G from\u001b[86Gits\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22mtop speed\u001b[19G(A\u001b[22G::BrakingAcceleration, steering's own), where it\u001b[71Gstops,\u001b[78Gand\u001b[82Gthe\u001b[86Gway\r\u001b[5C\u001b[1B\u001b[2m 9 \u001b[22mon to the\u001b[19Gpoint\u001b[25Gabove\u001b[31Gis\u001b[34Gstraight\u001b[43Gdown\u001b[48Gthe\u001b[52Gnormal\u001b[59Gfrom\u001b[64Grest.\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +7 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCommitted \u001b[1m0f973b2\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJet\u001b[7Gi\u001b[9Gon is committed as \u001b[38;2;177;185;249m0f973b2\u001b[39m. Manifest pins Jettison\u001b[60Gby\u001b[63Ga\u001b[65GGitHub\u001b[72Grevision,\u001b[82Gso\u001b[85Gfirst\u001b[91GI'm\u001b[95Grunning\u001b[103GManifest's\u001b[114Gdebug\r\u001b[2C\u001b[1Bsuites\u001b[10Gagainst\u001b[18Gthe\u001b[22Gnew\u001b[26Gcommit\u001b[33Glocally\u001b[41Gto\u001b[44Gsee\u001b[48Gwhat\u001b[53Gmoves.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running cd '/home/ivan/projects/manifest' && ctest --test…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ c\u001b[11G'/home/ivan/projects/manifest' && ctest --test-dir build/clang-debug -j24 2>&1 | grep -E \"Failed|tests passed\"\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
