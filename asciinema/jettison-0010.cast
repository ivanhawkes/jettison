[0.029, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mMeasuring\u001b[13Gthe\u001b[17Gfixture\u001b[25Gsuite's\u001b[33Gslow\u001b[38Gtest\u001b[43Gcases\u001b[49Gand\u001b[53Greading\u001b[61GJettison's\u001b[72Ggate\u001b[77Gstages,\u001b[85Gto\u001b[88Gsee\u001b[92Gwhat\u001b[97Gcan\u001b[101Grun\u001b[105Gin\u001b[108Gparallel\u001b[117Gand\r\u001b[1B \u001b[3Gwh\u001b[6Gt ca\u001b[11G be skipped.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Glooked\u001b[15Gat\u001b[18Gthe\u001b[22Gremaining\u001b[32Gwork,\u001b[38Gat\u001b[41Gboth\u001b[46Ggates'\u001b[53Gscripts,\u001b[62Gand\u001b[66Gat\u001b[69Gwhere\u001b[75Gthis\u001b[80Gmorning's\u001b[90Ggate\u001b[95Gspent\u001b[101Gits\u001b[105G6.4\u001b[109Gminutes.\u001b[118GThe\r\u001b[1B \u001b[3Gbiggest saving\u001b[18Gisn't fewer \u001b[31Gates or skipped s\u001b[49Gages. It's run\u001b[64Ging the gate on\u001b[80Ga separate copy of \u001b[100Ghe code,\u001b[109Gso I keep\u001b[K\r\u001b[2C\u001b[1Bworking\u001b[11Gwhile it runs, \u001b[27Ghich k\u001b[34Geps a gated check on\u001b[55Gevery commit. On\u001b[72Gtop of that, Manifest's\u001b[96Ggate can b\u001b[107G made about\r\u001b[2C\u001b[1Btwice as fast\u001b[17Gwithout dropping anything.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere the Manifest gate's time goes\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BToday's\u001b[11Ggate\u001b[16Gran\u001b[20Gfour\u001b[25Gbuilds\u001b[32Gone\u001b[36Gafter\u001b[42Ganother,\u001b[51Geach\u001b[56Gbuilding\u001b[65Gand\u001b[69Gthen\u001b[74Grunning\u001b[82Gthe\u001b[86Gwhole\u001b[92Gtest\u001b[97Gset:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌────────────────────────────────┬───────┬──────────────────────────────────────┐\r\u001b[2C\u001b[1B│             Build              │ Time  │                 Note                 │\r\u001b[2C\u001b[1B├────────────────────────────────┼───────┼──────────────────────────────────────┤\r\u001b[2C\u001b[1B│ debug                          │ 38 s  │ t\u001b[76G suite │\u001b[27;1H\u001b[24;3H\u001b[?25h"]
