Gcommits.\u001b[81GUntil\u001b[87Gyou\u001b[91Gsay,\u001b[96GI'll\u001b[101Ggo\u001b[104Gon\u001b[107Gwith\u001b[112Gslice\u001b[118G3\r\u001b[2C\u001b[1Bafter this gate\u001b[19Gand\u001b[23Grun the \u001b[33Gxt gate\u001b[41Gonly once\u001b[51Gslic\u001b[56G 3 is\u001b[62Gdone (on\u001b[78G per chunk).\u001b[91G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gyet\u001b[17Gmeasured\u001b[26Ghow\u001b[30Gthis\u001b[35Ggate's\u001b[42Gtime\u001b[47Gsplits\u001b[54Gacross\u001b[61Gits\u001b[65Gstages,\u001b[73Gso\u001b[76Gthe\u001b[80Gsaving\u001b[87Gfrom\u001b[92Ga\u001b[94G\"no\u001b[98Gengine\u001b[105Gchange\"\u001b[113Gflag\u001b[118Gis\r\u001b[2C\u001b[1Bstill an estimate.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 11s · done 5:46 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/stage-4-trad\u001b[27;1H\u001b[24;40H\u001b[?25h"]
