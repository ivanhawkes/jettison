1b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 18s · done 5:47 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mRelax the rule to allow more commits.\u001b[39m                                                                                 \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mSearching\u001b[13Gfor\u001b[17G\u001b[1m1\u001b[19G\u001b[22mpattern,\u001b[28Greading\u001b[36G\u001b[1m3\u001b[38G\u001b[22mfiles…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  ~/projects/manifest/AGENTS.md\u001b[36G\u001b[39m\u001b[K\r\u001b[1B                                  \u001b[27;1H\u001b[24;3H\u001b[?25h"]
