b[25Gthat's the\u001b[36Gsame \u001b[42Go\u001b[44Ge as our reserva\u001b[61Gio\u001b[64G. A\u001b[68Gspeed limit applies near\u001b[93Gthe\u001b[97Gstation,\u001b[106Gand\u001b[110Gthe\u001b[114Gdocking\r\u001b[2C\u001b[1B \u001b[5Gcomputer flies a fixed approach in through\u001b[48Gthe\u001b[52Gentrance.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneral autopilot (Space Engineers):\u001b[22m th\u001b[46Grem\u001b[50Gte-cont\u001b[58Gol autopilot is\u001b[74Gknown\u001b[80Gfor circling\u001b[93Gor oversh\u001b[103Goting i\u001b[111Gs\u001b[K\r\u001b[4C\u001b[1Bway\u001b[9Goints. Players work around it with a slow precision mode\u001b[66Gor\u001b[69Gtheir\u001b[75Gown\u001b[79Gscripts.\u001b[88GThat\u001b[93Gis\u001b[96Gour\u001b[100Gfailure,\u001b[109Gand\u001b[113Gthe\r\u001b[2C\u001b[1B \u001b[5Greason the others constrain the last\u001b[42Gleg.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese games c\u001b[17Gmbine\u001b[23Gf\u001b[25Gur techniques:\u001b[K\r\u001b[2C\u001b[1B1.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.398, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[20B\u001b[1mMake the final approach one-dimensional.\u001b[47G\u001b[22mBring\u001b[53Gthe\u001b[57Gship\u001b[62Gto\u001b[65Ga\u001b[67Gpoint\u001b[73Gout\u001b[77Galong\u001b[83Gthe\u001b[87Gpad's\u001b[93Gnormal\u001b[100Gand\u001b[104Gcome\u001b[109Gin\u001b[112Gstraight,\u001b[27;1H\u001b[24;3H\u001b[?25h"]
