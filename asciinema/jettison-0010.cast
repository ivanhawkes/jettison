[0.004, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mBehaviour worth knowing:\u001b[22m an NPC's first\u001b[43Gdecision, at\u001b[56Gthe very first step,\u001b[77Gfind\u001b[82G nothin\u001b[90G worth trading and waits. I\u001b[118G\u001b[K\r\u001b[2C\u001b[1Bpicks a tra\u001b[15Ge at the first turn's end, one minute in. Th\u001b[60G tes\u001b[65G ch\u001b[69Gcks it from there.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mtrading.yaml\u001b[16G\u001b[39mstill\u001b[22Glists\u001b[28Gno\u001b[31Gtraders.\u001b[40GAdding\u001b[47Gone\u001b[51Gnow\u001b[55Gwould\u001b[61Gchange\u001b[68Gthe\u001b[72Gprices\u001b[79Gand\u001b[83Gcredits\u001b[91Gthe\u001b[95Gconsole\u001b[103Gand\u001b[107Gfixture\u001b[115Gtests\r\u001b[2C\u001b[1Bexpect. Slice 5's fixture can add\u001b[37Gone \u001b[42Ghrough a tes\u001b[56Gov\u001b[59Grlay instead, as it already does for production batche\u001b[116G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext:\u001b[9G\u001b[22mslice\u001b[15G5,\u001b[18Gthe\u001b[22Gzero-client\u001b[34Gfixture\u001b[42Grun\u001b[46Gand\u001b[50Gchecking\u001b[59Gthat\u001b[64Gfast-forward\u001b[77Gskips\u001b[83Gthe\u001b[87Gright\u001b[93Gsteps.\u001b[100GThe\u001b[104Greplay\u001b[111Gand\r\u001b[2C\u001b[1Bfast-forward\u001b[16Gchecks are subtle, so I'd keep\u001b[47GOpus for it. Context\u001b[68Gis la\u001b[74Gge ag\u001b[80Gin, so \u001b[38;2;177;185;249m/compact\u001b[39m first is a\u001b[107Ggood idea.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gtried\u001b[19Ga\u001b[21Grunning\u001b[29Gserver\u001b[36Gwith\u001b[41Gan\u001b[44GNPC\u001b[48Gfrom\u001b[53Gthe\u001b[57Greal\u001b[62Gdata,\u001b[68Gsince\u001b[74Gnone\u001b[79Gis\u001b[82Gin\u001b[85Git\u001b[88Gyet.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 16m 30s · done 2:49 pm\u001b[38G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[3