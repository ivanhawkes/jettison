[0.222, "o", "\u001b[?25l\u001b[H     \u001b[2m 1 \u001b[22mDock:\u001b[15Ga ship flown in stops out along its pad's\u001b[57Gnormal,\u001b[65Gthen\u001b[70Gcomes\u001b[76Gstraight\u001b[85Gdown\u001b[90Git\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3\u001b[9G\u001b[22mManifest's\u001b[20GW10\u001b[24Gzero-client\u001b[36Grun\u001b[40Glost\u001b[45Ga\u001b[47Gpad:\u001b[52Ga\u001b[54Gship\u001b[59Gthat\u001b[64Gcame\u001b[69Ground\u001b[75Gthe\u001b[79Gstation\r\u001b[6C\u001b[1B\u001b[2m4\u001b[9G\u001b[22mf\u001b[11Gst and \u001b[19Gideways \u001b[28Gversho\u001b[36Gthe\u001b[40Gp\u001b[42Gint above\u001b[52Git\u001b[55G pad, only 10\u001b[69Gm outsid\u001b[79Gwh\u001b[83G\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[9G\u001b[22msteeri\u001b[16Gg\u001b[18Gkeeps it\u001b[27Gfrom, and avoida\u001b[44Gce pushed it out\u001b[61Geach\u001b[66Glap while Arrive pulled\r\u001b[6C\u001b[1B\u001b[2m6\u001b[9G\u001b[22mi\u001b[11G back,\u001b[18Gso it\u001b[24Gcircled the point u\u001b[44Gtil its reserva\u001b[60Gion lapsed. Th\u001b[76Gcours\u001b[83Gnow\u001b[K\r\u001b[6C\u001b[1B\u001b[2m7\u001b[9G\u001b[22mends at a po\u001b[22Gnt out along the \u001b[40Gormal as far beyond as the \u001b[68Ghip\u001b[72Gstops in from its\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22mtop speed\u001b[19G(A\u001b[22G::BrakingAcceleration, steering's \u001b[57Gwn), where it stops,\u001b[78Ga\u001b[80Gd the\u001b[86Gway\r\u001b[6C\u001b[1B\u001b[2m9\u001b[9G\u001b[22mon to the\u001b[19Gpo\u001b[22Gnt above is straight down the normal from rest.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +7 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCommitted \u001b[1m0f973b2\u001b[22m, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison\u001b[12Gis\u001b[15Gcommitted\u001b[25Gas\u001b[28G\u001b[38;2;177;185;249m0f973b2\u001b[39m.\u001b[37GManifest\u001b[46Gpins\u001b[51GJettison\u001b[60Gby\u001b[63Ga\u001b[65GGitHub\u001b[72Grevision,\u001b[82Gso\u001b[85Gfirst\u001b[91GI'm\u001b[95Grunning\u001b[103GManifest's\u001b[114Gdebug\r\u001b[1B \u001b[3Gsui\u001b[7Ge\u001b[9G against the new commit locally to see what moves.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48Gctest\u001b[54G--test…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && ctest --test-dir build/clang-debug -j24 2>&1 | grep -E \"Failed|tests passed\"\r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m(3s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
