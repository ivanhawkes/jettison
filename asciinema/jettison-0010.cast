[2.564, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B  ⎿  Found \u001b[1m10\u001b[15G\u001b[22mnew diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Gfound\u001b[14Gwhat\u001b[19Gcauses\u001b[26Gthe\u001b[30G\u001b[38;2;177;185;249mPadLost\u001b[39m,\u001b[39Gand\u001b[43Git\u001b[46Gis\u001b[49Gan\u001b[52Gengine\u001b[59Gbug\u001b[63Gin\u001b[66Gdocking,\u001b[75Gnot\u001b[79Ga\u001b[81Gframe\u001b[87Gmismatch.\u001b[97GI've\u001b[102Gonly\u001b[107Gdiagnosed\u001b[117Git,\r\u001b[1B \u001b[3Gnot fixed it; both r\u001b[24Gpos are back to clean.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mYour question about frames:\u001b[31G\u001b[22myes.\u001b[36GWhile\u001b[42Gapproaching,\u001b[55Gthe\u001b[59Gship\u001b[64Gis\u001b[67Gin\u001b[70Gthe\u001b[74Gsame\u001b[79Gphysics\u001b[87Gframe\u001b[93Gas\u001b[96Gthe\u001b[100Gstation:\u001b[109Gthe\u001b[113Gframe\u001b[119Gof\r\u001b[2C\u001b[1Bthe body the station orbits\u001b[31Gon rails. The ship \u001b[51Gs moved\u001b[59Ginto\u001b[65Gt\u001b[67Gwhen it\u001b[75G cruise ends (\u001b[38;2;177;185;249mCruise.cpp:599\u001b[39m), and the docks\u001b[K\r\u001b[2C\u001b[1Bgive up any pad wh\u001b[22Gse sh\u001b[28Gp is in a different frame. The\u001b[59Gstation\u001b[67Gdo\u001b[70Gsn'\u001b[74G spin (its angular velocity is 0). In system\u001b[K\r\u001b[2C\u001b[1Bcoordinates\u001b[15Geverything moves at about 33 km/s, but that\u001b[59Gis \u001b[63Ghe body's own orbit; inside the frame the\u001b[105Gship's\u001b[113Gpeeds\r\u001b[2C\u001b[1Bare te\u001b[10Gs of\u001b[15Gmet\u001b[19Ges a sec\u001b[28Gnd.\u001b[32GSo\u001b[35Gthe frames are\u001b[50Gconsistent.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat goes wrong:\r\u001b[2C\u001b[1B\u001b[22m- The docks fly an\u001b[22Ginbound\u001b[30Gship\u001b[35Gto\u001b[38Ga\u001b[40Gpoint\u001b[46Gabove\u001b[52Gits\u001b[56Gpad.\u001b[61GThat\u001b[66Gpoint\u001b[72Gis\u001b[75Gonly\u001b[80G10\u001b[83Gm\u001b[85Goutside\u001b[93Gthe\u001b[97Gzone\u001b[102Gsteering\u001b[111Gkeeps\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[7Gip away\u001b[16Grom around the stati\u001b[37Gn (\u001b[38;2;177;185;249mkAboveMargin = 10.0\u001b[39m in \u001b[38;2;177;185;249mDocks.cpp\u001b[39m).\u001b[75GThe ship only has\u001b[94Go get within 20 m of the\u001b[K\r\u001b[4C\u001b[1Bpo\u001b[8Gnt to ar\u001b[17Give, so the arrival zone already reaches into\u001b[63Gthe keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSh\u001b[8Gp2\u001b[11Greached Ore \u001b[24Gn the far side, so it was\u001b[51Gouted around the station through\u001b[84Ga\u001b[86Gwaypoint.\u001b[96GIt\u001b[99Gcame\u001b[104Goff\u001b[108Gthe\u001b[112Gwaypoint\r\u001b[2C\u001b[1B \u001b[5Gat about 100 m/s,\u001b[23Gmoving\u001b[30Gsideways to the\u001b[46Gt\u001b[48Grget, and overshot by \u001b[71Gbout\u001b[76G50 m into\u001b[86Gthe keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GInside \u001b[13Ghat zone\u001b[23Gavo\u001b[27Gdance commands\u001b[42Gup to about\u001b[54G190\u001b[58Gm/s outward\u001b[70Gwhile\u001b[76Garrival pulls\u001b[90Gth\u001b[93G ship back in.\u001b[108GThat\u001b[113Gputs\r\u001b[2C\u001b[1B \u001b[5Ge\u001b[7Gergy\u001b[12Gback\u001b[17Gin \u001b[21Gvery lap: the ship circled\u001b[76Gout 40 m/s for the pad's full 300 s,\u001b[113Gnever\u001b[27;1H\u001b[24;3H\u001b[?25h"]
