[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B \u001b[8Gtakes about 14 GB of di\u001b[32Gk.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GStage\u001b[14Gcr\u001b[17Gss-reviews could run\u001b[38Gon\u001b[41Gthat\u001b[46Gcopy\u001b[51Gtoo,\u001b[56Gso\u001b[59Gtheir\u001b[65G10-minute\u001b[75Grounds\u001b[82Gno\u001b[85Glonger\u001b[92Gblock\u001b[98Gwork.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRun the four builds at the same time.\u001b[22m They already use separate b\u001b[72Gild fol\u001b[80Gers,\u001b[85Gs\u001b[87G the\u001b[92Ggate's time\u001b[104Gbecomes\u001b[112Gthe\r\u001b[2C\u001b[1B  \u001b[6Gsanitiser build's, about 3.5 minutes.\u001b[47G script wo\u001b[58Gld\u001b[61Gcheck free memory fi\u001b[83Gt\u001b[85Gand fall back\u001b[100Go one at a tim\u001b[116Gwhen\r\u001b[5C\u001b[1Bit's low,\u001b[16Gfor example when your local\u001b[44GAI i\u001b[49G loaded an\u001b[61G3.4 GB is fr\u001b[74Ge.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSplit the fixture suite into one test entry per test case,\u001b[65G\u001b[22mso\u001b[69Gts cases\u001b[78Grun\u001b[82Gside\u001b[87Gby\u001b[90Gside.\u001b[96GThe\u001b[100Gsanitiser\u001b[110Gtests\u001b[116Gthen\r\u001b[2C\u001b[1B  \u001b[6Gtake about 60 to 75 s instead of 144. With step 2, the whole ga\u001b[70Ge\u001b[72Gwould\u001b[78Gbe about\u001b[87G2 to 2.5\u001b[96Gminutes.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mClose a gap I found:\u001b[22m my loc\u001b[34Gl\u001b[36Ggates haven't b\u001b[52Gen running c\u001b[65Gan\u001b[68G-\u001b[70Gidy at all. The flag I passed only\u001b[105Gsets\u001b[110Gthe\u001b[114Gnumber\r\u001b[2C\u001b[1B  \u001b[6Gof tidy jobs; CI runs tidy, but my gates didn't.\u001b[55GI'd add\u001b[63Gtidy to every\u001b[77Ggate. It\u001b[86Gskips file\u001b[97G that wer\u001b[107G clean\u001b[114Gand\u001b[K\r\u001b[5C\u001b[1Bhaven't\u001b[14Gchanged,\u001b[23Gso it costs little.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mParts of the gate that could be skipped\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22mnothing\u001b[23Gin\u001b[26Gits\u001b[30Ggate\u001b[35Gis\u001b[38Gengine-only,\u001b[51Gso\u001b[54Gthe\u001b[58Gskip\u001b[63GI\u001b[65Gsuggested\u001b[75Gearlier\u001b[83Gdoesn't\u001b[91Gapply.\u001b[98GOnly\u001b[103Gtwo\u001b[107Gstages\u001b[114Gare\r\u001b[2C\u001b[1B \u001b[5Gcandidates:\u001b[K\r\u001b[4C\u001b[1B- The terminal-free\u001b[25Gbuild's\u001b[33Gtests\u001b[39Grepeat\u001b[46Gthe\u001b[50Gdebug\u001b[56Gtests\u001b[62Gon\u001b[65Gthe\u001b[69Gsame\u001b[74Ggame\u001b[79Gcode.\r\u001b[10C\u001b[1Bd\u001b[13Gbug tests repeat the sanitiser \u001b[45Gests.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BOnce\u001b[10Gthe\u001b[14Gbuilds\u001b[21Grun\u001b[25Gat\u001b[28Gthe\u001b[32Gsame\u001b[37Gtime,\u001b[43Gneither\u001b[51Gstage\u001b[57Gis\u001b[60Gthe\u001b[64Gslowest,\u001b[73Gso\u001b[76Gskipping\u001b[85Gthem\u001b[90Gsaves\u001b[96Galmost\u001b[103Gno\u001b[106Gtime.\u001b[112GI'd\u001b[116Gkeep\r\u001b[4C\u001b[1Bboth.   \u001b[14G      \u001b[21G   \u001b[25G  \u001b[28G   \u001b[32G    \u001b[37G     \u001b[43G    \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
