[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bcoordi\u001b[10Gates\u001b[15Geve\u001b[19Gything m\u001b[28Gves\u001b[32Gat\u001b[35Gabout 33 km/s,\u001b[50Gbut that is\u001b[62Gthe\u001b[66Gbody's\u001b[73Gown\u001b[77Gorbit;\u001b[84Ginside\u001b[91Gthe\u001b[95Gframe\u001b[101Gthe\u001b[105Gship's\u001b[112Gspeeds\r\u001b[2C\u001b[1Bare\u001b[7Gtens\u001b[12Gof\u001b[15Gmetres\u001b[22Ga\u001b[24Gsecond.\u001b[32GSo\u001b[35Gthe\u001b[39Gframes\u001b[46Gare\u001b[50Gconsistent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat goes wrong:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GT\u001b[7Ge docks\u001b[16Gly an inbound ship t\u001b[37G a point above its pad. That point is\u001b[75Gonly 10 m outside\u001b[94Ghe zone steering keeps the\r\u001b[4C\u001b[1Bsh\u001b[8Gp away f\u001b[17Gom around the station (\u001b[38;2;177;185;249mkAboveMargin = 10.0\u001b[39m in\u001b[63G\u001b[38;2;177;185;249mDocks.cpp\u001b[39m). The ship\u001b[84Gonly\u001b[89Ghas\u001b[93Gto\u001b[96Gget\u001b[100Gwithin\u001b[107G20\u001b[110Gm\u001b[112Gof\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gpo\u001b[8Gnt\u001b[11Gto arrive, s\u001b[24G the arrival zone already\u001b[51Geaches into the keep-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GShip2 reached Ore\u001b[23Gon the\u001b[30Gfar side, so it\u001b[46Gw\u001b[48Gs routed around the st\u001b[71Gtion\u001b[76Gthrough a\u001b[86Gwaypoint. It came off\u001b[108Gthe\u001b[112Gwaypoint\r\u001b[2C\u001b[1B \u001b[5Gat abou\u001b[13G 100 m/s\u001b[23Gmov\u001b[27Gng sideways to\u001b[42Gthe target,\u001b[54Gand\u001b[58Govershot by\u001b[70Gabout\u001b[76G50 m into the\u001b[90Gke\u001b[93Gp-away zone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gside\u001b[12Gthat\u001b[17Gzon\u001b[21G, avoidance commands up to\u001b[48Gabout\u001b[54G190 m/s outward while arrival pulls the ship back in. That\u001b[113Gputs\u001b[K\r\u001b[4C\u001b[1Benergy back in \u001b[21Gvery\u001b[29G: the\u001b[35Gship\u001b[40Gcircled\u001b[48G30–55\u001b[54Gm\u001b[56Gfrom\u001b[61Gthe\u001b[65Gpoint\u001b[71Gat\u001b[74Gabout\u001b[80G40\u001b[83Gm/s\u001b[87Gfor\u001b[91Gthe\u001b[95Gpad's\u001b[101Gfull\u001b[106G300\u001b[110Gs,\u001b[113Gnever\r\u001b[2C\u001b[1B \u001b[5Garrived, and the pad l\u001b[28Gpsed.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GShip1\u001b[11Gcame\u001b[16Gin\u001b[19Gthrough\u001b[27Ga\u001b[29Gwaypoint\u001b[38Gtoo\u001b[42Gand\u001b[46Garrived;\u001b[55Gits\u001b[59Ggeometry\u001b[68Ghappened\u001b[77Gnot\u001b[81Gto\u001b[84Govershoot.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[19G\u001b[22mI \u001b[22Gemporarily r\u001b[35Gised the margin\u001b[51Gto 100 m in the f\u001b[69Gtched\u001b[75Gengine copy and reran.\u001b[98GShip2 still overshot,\r\u001b[2C\u001b[1Bto about 180 m, but swu\u001b[27Gg back and\u001b[38Garrived 62 s after th\u001b[60G crui\u001b[66Ge\u001b[68Gended, about as\u001b[84Glong\u001b[89Gas\u001b[92Gother\u001b[98Garrivals\u001b[107Gtake,\u001b[113Gand\u001b[117Gno\r\u001b[2C\u001b[1Bpad\u001b[7Glapsed\u001b[14Gin\u001b[17Gthe\u001b[21G25\u001b[24Gminutes.\u001b[33GBoth\u001b[38Gedits\u001b[44Gand\u001b[48Gthe\u001b[52Gexperiment\u001b[63Gtest\u001b[68Gare\u001b[72Greverted.\r\u001b[2C\u001b[1B                              \u001b[34G     \u001b[40G   \u001b[44G   \u001b[76G\u001b[K\u001b[27;1H\u001b[24;72H\u001b[?25h"]
[0.019, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bthe body the station orbits on r\u001b[36Gils.\u001b[41GThe ship\u001b[50Gis moved\u001b[60Gnto it when its cruise end\u001b[87G (\u001b[38;2;177;185;249mCruise.cpp:599\u001b[39m), and the docks\r\u001b[2C\u001b[1Bgive up any\u001b[15Gpad whose ship is in a different frame. Th\u001b[58G station\u001b[67Gdoesn't\u001b[75Gspin\u001b[80G(its\u001b[85Gangular\u001b[93Gvelocity\u001b[102Gis\u001b[105G0).\u001b[109GIn\u001b[112Gsystem\r\u001b[2C\u001b[1Bcoordinates\u001b[15Geverything\u001b[26Gmoves\u001b[32Gat\u001b[35Gabout\u001b[41G33\u001b[44Gkm/s,\u001b[50Gbut\u001b[54Gthat\u001b[59Gis\u001b[62Gthe\u001b[66Gbody's\u001b[73Gown\u001b[77Gorbit;\u001b[84Ginside\u001b[91Gthe\u001b[95Gframe\u001b[101Gthe\u001b[105Gship's\u001b[112Gspeeds\r\u001b[2C\u001b[1Bare tens of metres\u001b[22Ga\u001b[24Gsecond.\u001b[32GSo\u001b[35Gthe\u001b[39Gframes\u001b[46Gare\u001b[50Gconsistent.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat goes wrong:\u001b[20G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe docks fly an\u001b[22Ginbound sh\u001b[33Gp to a point \u001b[47Gbove its pad. That point is only 10\u001b[83Gm\u001b[85Goutside\u001b[93Gthe\u001b[97Gzone\u001b[102Gsteering\u001b[111Gkeeps\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gs\u001b[9G away from arou\u001b[25Gd the stat\u001b[36Gon (\u001b[38;2;177;185;249mkAboveMargin = 10.0\u001b[39m i\u001b[62G \u001b[38;2;177;185;249mDocks.cpp\u001b[39m). The ship\u001b[84Gonly has \u001b[94Go\u001b[96Gget within 20 m\u001b[112Gof the\u001b[K\r\u001b[4C\u001b[1Bpoint to\u001b[14Garrive, so the arrival zone\u001b[42Galready reaches\u001b[58Ginto the\u001b[67Gkeep-away zone.\u001b[K\r\u001b[4C\u001b[1BShip2 reached Ore\u001b[23Gon the far side, \u001b[41Go it was routed around \u001b[65Ghe stat\u001b[73Gon\u001b[76Gth\u001b[79Gough\u001b[84Ga waypoint. It\u001b[99Gc\u001b[101Gme\u001b[104Goff\u001b[108Gt\u001b[110Ge waypoint\r\u001b[4C\u001b[1Bat about 100 m/s, moving sid\u001b[34Gways to the target,\u001b[54Gand \u001b[59Gvershot by about 50 m into the keep-away zone.\u001b[106G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIns\u001b[9Gd\u001b[11G th\u001b[15Gt zon\u001b[21G, \u001b[24Gvoidance commands\u001b[42Gup\u001b[45Gto\u001b[48Gabout\u001b[54G190\u001b[58Gm/s\u001b[62Goutward\u001b[70Gwhile\u001b[76Garrival\u001b[84Gpulls\u001b[90Gthe\u001b[94Gship\u001b[99Gback\u001b[104Gin.\u001b[108GThat\u001b[113Gputs\r\u001b[2C\u001b[1B \u001b[5Genergy back in every l\u001b[28Gp: the ship circled 30–55 m from th\u001b[64G point at about 40 m/s for the\u001b[95Gpad's\u001b[101Gfull\u001b[106G300\u001b[110Gs,\u001b[113Gnever\r\u001b[4C\u001b[1Barrived,\u001b[14Gand\u001b[18Gthe\u001b[22Gpad\u001b[26Glapsed.\r\u001b[2C\u001b[1B- Ship1 came in\u001b[19Gthrough \u001b[28G wa\u001b[32Gpoint too and arrived; its geometry happ\u001b[73Gned not to overshoot.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I checked:\u001b[22m I\u001b[21Gtemporarily\u001b[33Graised the\u001b[44Gmargin to 100 \u001b[59G in\u001b[64Ghe fetched \u001b[76Gngine\u001b[82Gcopy\u001b[87Gand\u001b[91Greran.\u001b[98GShip2\u001b[104Gstill\u001b[110Govershot,\r\u001b[2C\u001b[1Bto\u001b[6Gabout\u001b[12G180\u001b[16Gm,\u001b[19Gbut\u001b[23Gswung\u001b[29Gback\u001b[34Gand\u001b[38Garrived\u001b[46G6\u001b[76Gbout\u001b[81Gas\u001b[84Glong\u001b[89Gas\u001b[92Gother\u001b[98Garrivals\u001b[107Gtake,\u001b[113Gand\u001b[117Gno\u001b[27;1H\u001b[24;72H\u001b[?25h"]
