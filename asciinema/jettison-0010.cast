[0.314, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNotes\u001b[9Gwritten:\u001b[18Gthe\u001b[22Groadmap\u001b[30Gentry\u001b[36Ggoes\u001b[41Gfirst\u001b[47Gin\u001b[50Gthe\u001b[54G\"Then:\u001b[61Grobustness\"\u001b[73Gtier,\u001b[79Gwith\u001b[84Gthe\u001b[88Gfindings\u001b[97Gand\u001b[101Gthe\u001b[105Gother-games\r\u001b[1B \u001b[3Gsurvey. Architecture \u001b[25Gnd histo\u001b[36Gp\u001b[38Gint to it. Running the\u001b[61GJettison gate now.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe\u001b[7GJettison\u001b[16Ggate\u001b[21Gpassed:\u001b[29G491\u001b[33Gs,\u001b[36Gevery\u001b[42Gstage\u001b[48Gok,\u001b[52Gthe\u001b[56Ghashes\u001b[63Gthe\u001b[67Gsame\u001b[72Gin\u001b[75GRelease\u001b[83Gand\u001b[87Gunder\u001b[93Gthe\u001b[97Gsanitisers.\u001b[109GCommitting.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(build/commit-dock-approach.txt)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m16\u001b[22m lines to \u001b[1mbuild/commit-dock-approach.txt\r\u001b[1B\u001b[22m     \u001b[2m 1 \u001b[22mDock:\u001b[15Ga ship flown in stops out along its pad's\u001b[57Gnormal,\u001b[65Gthen\u001b[70Gcomes\u001b[76Gstraight\u001b[85Gdown\u001b[90Git\r\u001b[6C\u001b[1B\u001b[2m2\u001b[9G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m3\u001b[9G\u001b[22mManifest's\u001b[20GW10\u001b[24Gzero-client\u001b[36Grun\u001b[40Glost\u001b[45Ga\u001b[47Gpad:\u001b[52Ga\u001b[54Gship\u001b[59Gthat\u001b[64Gcame\u001b[69Ground\u001b[75Gthe\u001b[79Gstation\r\u001b[6C\u001b[1B\u001b[2m4\u001b[9G\u001b[22mf\u001b[11Gst and \u001b[19Gideways \u001b[28Gversho\u001b[36Gthe\u001b[40Gp\u001b[42Gint above\u001b[52Git\u001b[55G pad, only 10\u001b[69Gm outsid\u001b[79Gwh\u001b[83G\u001b[K\r\