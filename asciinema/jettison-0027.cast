001b[12G\u001b[38;2;248;248;242mignores.        \u001b[29G     \u001b[35G      \u001b[42G  \u001b[45G     \u001b[51G    \u001b[56G   \u001b[60G    \u001b[65G       \u001b[73G    \u001b[78G  \u001b[81G    \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m501\u001b[12G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m502\u001b[12G\u001b[22mCodex\u001b[18Gruns\u001b[23Gwith\u001b[28G`workspace-write`\u001b[46G(it\u001b[50Gbuilds\u001b[57Gand\u001b[61Gruns\u001b[66Gsuites\u001b[73Gin\u001b[76G`build/`)\u001b[86Gat\u001b[89Greasoning\u001b[99Geffort\r\u001b[6C\u001b[1B\u001b[2m503\u001b[12G\u001b[22m`high`, since its own def\u001b[38Gu\u001b[40Gt is `none`. It m\u001b[58Gy not \u001b[65Gh\u001b[69Ge the source tree. The script compares\r\u001b[25C\u001b[2B,\u001b[28Grecalling\u001b[38G\u001b[1m2\u001b[40G\u001b[22mmemories,\u001b[50Gwriting\u001b[58G\u001b[1m3\u001b[60G\u001b[22mmemories…\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ gi\u001b[11G diff --stat\u001b[39m\u001b[K\r\u001b[20C\u001b[8B\u001b[38;2;0;204;204m2\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
