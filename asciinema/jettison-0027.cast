[0.080, "o", "\u001b[?25l\u001b[H  - \u001b[1mF13 (a symlink could put backups inside the world):\u001b[22m the location check now\u001b[80Gruns\u001b[85Gagain\u001b[91Gafter\u001b[97Gthe\u001b[101Gbackups\u001b[109Gdirectory\u001b[119Gis\r\u001b[4C\u001b[1Bmade, when every part of the p\u001b[36Gth exists and the symlinks resolve.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF14 (a world directory left open to everyone):\u001b[52G\u001b[22mdirectories\u001b[64Gare\u001b[68Gnow\u001b[72Gcreated\u001b[80G0700\u001b[85Gfrom\u001b[90Gthe\u001b[94Gstart\u001b[100Ginstead\u001b[108Gof\u001b[111Gbeing\r\u001b[2C\u001b[1B  changed afterwards.\u001b[25GThis\u001b[30Gneeded\u001b[37Gan\u001b[40Gengine\u001b[47Gchange:\u001b[55GJettison's\u001b[66G\u001b[38;2;177;185;249mCreateDirectoriesDurably\u001b[91G\u001b[39mtakes\u001b[97Gthe\u001b[101Gpermissions\u001b[113Gto\r\u001b[4C\u001b[1Bcreate\u001b[12Gwith.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits and gates:\r\u001b[1B\u001b[22m \u001b[3G- Jettison\u001b[14G\u001b[38;2;177;185;249m459af99\u001b[22G\u001b[39mholds \u001b[29Ghe engine change; its gate passed an\u001b[67Git's push\u001b[77Gd. Your\u001b[85Grule\u001b[90Gcommit\u001b[97G\u001b[38;2;177;185;249mc2be3ac\u001b[105G\u001b[39mwas\u001b[109Gpushed\u001b[116Gwith\r\u001b[4C\u001b[1Bit,\u001b[9Gsince\u001b[15Git\u001b[18Gsits\u001b[23Gunderneath.\r\u001b[2C\u001b[1B- Manifest \u001b[38;2;177;185;249m24f08d0\u001b[39m moves the pin to \u001b[38;2;177;185;249m459af99\u001b[39m and\u001b[51Gholds\u001b[57Gthe\u001b[61Grest.\u001b[67GIts\u001b[71Ggate\u001b[76Gpassed\u001b[83G(\u001b[38;2;177;185;249mbuild/gate-stage5-review5.out\u001b[39m).\u001b[116GIt\r\u001b[4C\u001b[1Bisn't\u001b[11Gpushed,\u001b[19Gnor\u001b[23Gare\u001b[27Gthe\u001b[31Gearlier\u001b[39GStage\u001b[45G5\u001b[47Greview\u001b[54Gcommits.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat Codex's own checks showed before the filter stopped it\u001b[22m (sav\u001b[68Gd \u001b[71Gn \u001b[38;2;177;185;249mbuild/reviews/stage-5/round-6a-scratch/\u001b[39m):\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mF12, F13, F14:\u001b[22m all three\u001b[30Gnow\u001b[34Gfail\u001b[39Gas\u001b[42Gintended.\u001b[52G\u001b[38;2;177;185;249mnew/..\u001b[59G\u001b[39mand\u001b[63Grelative\u001b[72Gpaths\u001b[78Gleave\u001b[84Gthe\u001b[88Gexisting\u001b[97Gparent\u001b[104Gat\u001b[107G0750\u001b[112Gand\u001b[116Gmake\r\u001b[4C\u001b[1Bthe\u001b[9Gnew\u001b[13Gdirectory 0700.\u001b[29GThe\u001b[33Gsymlink\u001b[41Gpath\u001b[46Ginto\u001b[51Gthe\u001b[55Gworld\u001b[61Gis\u001b[64Grefused\u001b[72Gwith\u001b[77Gno\u001b[80Gidentity\u001b[89Gwritten,\u001b[98Gand\u001b[102Ga\u001b[104Gworld\u001b[110Ginside\u001b[117Gits\r\u001b[1B \u001b[3G  backups is refused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo more checks it was running:\r\u001b[1B\u001b[22m \u001b[3G  - A symlink in\u001b[20Ga token\u001b[28Gfile's path left the other fi\u001b[58Ge int\u001b[64Gct.\u001b[K\r\u001b[1B    - It replaced the world's \u001b[38;2;177;185;249msnapshots\u001b[39m directory with a symlink to a folder outside. The server wrote\u001b[104Ga\u001b[106G474\u001b[110GKB\u001b[113Gsnapshot\r\u001b[6C\u001b[1Bthrough\u001b[15Git,\u001b[19Gand\u001b[23Gthe\u001b[27Gprobe's\u001b[35G\u001b[38;2;177;185;249moriginal_retained False\u001b[59G\u001b[39msuggests\u001b[68Gsomething\u001b[78Galready\u001b[86Gin\u001b[89Gthat\u001b[94Gfolder\u001b[101Gdidn't\u001b[108Gsurvive.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.137, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gmade, when every part of the path exists and the symlinks resolve.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF14 (a world directory left open to everyone):\u001b[22m directories are now\u001b[72Gcreated\u001b[80G0700\u001b[85Gfrom\u001b[90Gthe\u001b[94Gstart\u001b[100Ginstead\u001b[108Gof\u001b[111Gbeing\r\u001b[2C\u001b[1B \u001b[5Gchanged afterwards. This needed an engine change: Je\u001b[58Gtison's \u001b[38;2;177;185;249mCreateDirectoriesDurably\u001b[39m takes the permissions to\u001b[K\r\u001b[5C\u001b[1Breat\u001b[11G with.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits and gates:\r\u001b[2C\u001b[1B\u001b[22m- Jettison \u001b[38;2;177;185;249m459af99\u001b[22G\u001b[39mholds\u001b[28Gthe\u001b[32Gengine\u001b[39Gchange;\u001b[47Gits\u001b[51Ggate\u001b[56Gpassed\u001b[63Gand\u001b[67Git's\u001b[72Gpushed.\u001b[80GYour\u001b[85Grule\u001b[90Gcommit\u001b[97G\u001b[38;2;177;185;249mc2be3ac\u001b[105G\u001b[39mwas\u001b[109Gpushed\u001b[116Gwith\r\u001b[2C\u001b[1B \u001b[5Git, since it sits un\u001b[26Gerneath.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest \u001b[38;2;177;185;249m24f08d0\u001b[39m moves the pin\u001b[36Gto\u001b[39G\u001b[38;2;177;185;249m459af99\u001b[47G\u001b[39mand\u001b[51Gholds\u001b[57Gthe\u001b[61Grest.\u001b[67GIts\u001b[71Ggate\u001b[76Gpassed\u001b[83G(\u001b[38;2;177;185;249mbuild/gate-stage5-review5.out\u001b[39m).\u001b[116GIt\r\u001b[2C\u001b[1B \u001b[5Gis\u001b[8G't pushed, nor ar\u001b[26G the earlier\u001b[39GStage 5\u001b[47Greview commits.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat Codex's own checks showed before the filter stopped it\u001b[63G\u001b[22m(saved\u001b[70Gin\u001b[73G\u001b[38;2;177;185;249mbuild/reviews/stage-5/round-6a-scratch/\u001b[39m):\r\u001b[2C\u001b[1B- \u001b[1mF12, F13, F14:\u001b[22m all three now fail as intended. \u001b[38;2;177;185;249mnew/..\u001b[39m and\u001b[63Grelative paths leave the existing parent at 0750 and\u001b[116Gmake\r\u001b[2C\u001b[1B \u001b[5Gthe new directory 0700. The symlink path into the world is refused\u001b[72Gwi\u001b[76G no id\u001b[83Gn\u001b[85Gity wri\u001b[93Gten, \u001b[99Gnd a\u001b[104Gworld insi\u001b[115Ge its\r\u001b[4C\u001b[1Bbackups\u001b[13Gis refused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTwo more checks it was running:\r\u001b[2C\u001b[1B\u001b[22m \u001b[5G- A symlink in a token file's path\u001b[40Gleft\u001b[45Gthe\u001b[49Gother\u001b[55Gfile\u001b[60Gintact.\r\u001b[6C\u001b[1BIt replaced the world's \u001b[38;2;177;185;249msnapshots\u001b[39m directory with a symlink to\u001b[69Ga\u001b[71Gfolder\u001b[78Goutside.\u001b[87GThe\u001b[91Gserver\u001b[98Gwrote\u001b[104Ga\u001b[106G474\u001b[110GKB\u001b[113Gsnapshot\r\u001b[4C\u001b[1B \u001b[7Gthrough it,\u001b[19Gand\u001b[23Gthe probe's \u001b[38;2;177;185;249moriginal_retained False\u001b[39m suggests something\u001b[78Galrea\u001b[84Gy in that folde\u001b[100G didn't survive.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BI\u001b[7Ghaven't\u001b[15Gjudged\u001b[22Gthe\u001b[26Gsnapshots\u001b[36Gresult.\u001b[44GPlanting\u001b[53Ga\u001b[55Gsymlink\u001b[63Ginside\u001b[70Gthe\u001b[74Gworld\u001b[80Gmeans\u001b[86Galready\u001b[94Ghaving\u001b[101Gaccess\u001b[108Gto\u001b[111Gits\u001b[27;1H\u001b[24;3H\u001b[?25h"]
