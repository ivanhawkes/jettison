.\u001b[22m Th\u001b[48Gy expected one\u001b[63Gflush\u001b[69Gper\u001b[73G\u001b[38;2;177;185;249mAdvance\u001b[81G\u001b[39mcall,\u001b[87Gwhich\u001b[93Gwas\u001b[97Gthe\u001b[101Gbug.\u001b[106GThe\u001b[110Gfixtures'\r\u001b[2C\u001b[1B \u001b[5Gpinned state hashes did not move.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe F8/F10 fix:\u001b[22m directories\u001b[33Gare now\u001b[41Gcreated\u001b[49Gone\u001b[53Gcomponent\u001b[63Gat\u001b[66Ga\u001b[68Gtime,\u001b[74Geach\u001b[79Gmade\u001b[84Gprivate\u001b[92Gthrough\u001b[100Gthe\u001b[104Gsame\u001b[109Gpath\u001b[114Git\u001b[117Gwas\r\u001b[2C\u001b[1B \u001b[5Gcreated by. That covers \u001b[38;2;177;185;249mnew/..\u001b[39m paths and symlinks, and the world and\u001b[74Gb\u001b[77Gkup \u001b[82Girectori\u001b[91Gs use it\u001b[101Goo. A side effect:\u001b[K\r\u001b[4C\u001b[1Bwh\u001b[8Gn a world or backup directory's parent fo\u001b[50Gder\u001b[54G are missing, those\u001b[74Gp\u001b[76Grents a\u001b[85G n\u001b[88Gw creat\u001b[96Gd private a\u001b[108G w\u001b[111Gll, where\r\u001b[4C\u001b[1Bbefore\u001b[12Gonly the\u001b[21Gl\u001b[23Gst one was.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mYour new review rule\u001b[24G\u001b[22mis\u001b[27Gin\u001b[30GJettison\u001b[39G\u001b[38;2;177;185;249mc2be3ac\u001b[39m,\u001b[48Gnot\u001b[52Gyet\u001b[56Gpushed.\u001b[64G\u001b[38;2;177;185;249mcross-review.sh\u001b[80G\u001b[39mnow\u001b[84Gdefaults\u001b[93Gto\u001b[96Gthree\u001b[102Grounds.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[27G\u001b[39mnow says to\u001b[39Greview a\u001b[48Gstage's\u001b[56Gcommits\u001b[64Gwhen it closes.\u001b[80GWhen a major\u001b[93Gstage closes, a\u001b[K\r\u001b[2C\u001b[1Bwhole-codebase review follow\u001b[32G, Je\u001b[37Gtison first, th\u001b[53Gn Manifest, aimed at concerns th\u001b[86Gt cut across\u001b[99Gstag\u001b[105G.\u001b[107GThe\u001b[111Gmemory\u001b[118Gis\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.152, "o", "\u001b[?25l\u001b[H\u001b[3G│ 4     │ directories); new F10, my F8 fix broke across a symlink; new F11, two      │ \u001b[38;2;177;185;249m7b6a8d7\u001b[39m                    │\r\u001b[12C\u001b[1Bstal\u001b[18G documents\u001b[29G     \u001b[35G    \u001b[40G  \u001b[43G   \u001b[47G    \u001b[52G      \u001b[59G      \u001b[66G   \u001b[70G      \r\u001b[2C\u001b[1B└───────┴────────────────────────────────────────────────────────────────────────────┴────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B† \u001b[38;2;177;185;249mdd5b254\u001b[39m is a placeholder; the real hash of that format commit is in \u001b[38;2;177;185;249mgit log\u001b[39m, between \u001b[38;2;177;185;249m15a0ac5\u001b[39m and \u001b[38;2;177;185;249m7b6a8d7\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B-\u001b[5G\u001b[1mThe engine changed in three places.\u001b[22m \u001b[38;2;177;185;249mSimWorld::ComponentNames\u001b[39m and\u001b[70G\u001b[38;2;177;185;249mServ\u001b[75GceNames\u001b[39m no\u001b[86G return copies.\u001b[102G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mNet::Server::Closing\u001b[26G\u001b[39mis\u001b[29Gnew,\u001b[34Gso\u001b[37Ga\u001b[39Gstopping\u001b[48Gserver\u001b[55Gcan\u001b[59Gwait\u001b[64Gfor\u001b[68Gits\u001b[72Gclients\u001b[80Gto\u001b[83Greceive\u001b[91Gthe\u001b[95Glast\u001b[100Greplies.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mPlatform::ResolvePath\u001b[39m resolves one XDG directory alone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9 changed four existing journal tests.\u001b[22m They expected\u001b[59Gone flush per \u001b[38;2;177;185;249mAdvance\u001b[39m call, which was the bug. The\u001b[110Gfixtures'\r\u001b[4C\u001b[1Bpinned state hashes did n\u001b[31Gt move.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe F8/F10\u001b[17Gix:\u001b[22m directories are now created one compone\u001b[61Gt\u001b[63Gat a time, each made private throug\u001b[99G the same path it was\r\u001b[4C\u001b[1Bcreated by. T\u001b[20Gt covers\u001b[29G\u001b[38;2;177;185;249mnew/..\u001b[39m paths\u001b[42Gand\u001b[46Gsymlinks,\u001b[56Gand\u001b[60Gthe\u001b[64Gworld\u001b[70Gand\u001b[74Gbackup\u001b[81Gdirectories\u001b[93Guse\u001b[97Git\u001b[100Gtoo.\u001b[105GA\u001b[107Gside\u001b[112Geffect:\r\u001b[2C\u001b[1B \u001b[5Gwhen a world or\u001b[21Gbackup d\u001b[30Grectory's pa\u001b[44Gn\u001b[46G fold\u001b[52Grs are missing,\u001b[69Ghose\u001b[74Gp\u001b[76Grents are now created private as\u001b[109Gwell, where\r\u001b[4C\u001b[1Bbefor\u001b[11G only\u001b[17Gt\u001b[19Ge last one was.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mYour new review rule\u001b[22m is in\u001b[30GJettison\u001b[39G\u001b[38;2;177;185;249mc2be3ac\u001b[39m,\u001b[48Gnot\u001b[52Gyet\u001b[56Gpushed.\u001b[64G\u001b[38;2;177;185;249mcross-review.sh\u001b[80G\u001b[39mnow\u001b[84Gdefaults\u001b[93Gto\u001b[96Gthree\u001b[102Grounds.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[27G\u001b[39mnow\u001b[31Gsays\u001b[36Gto\u001b[39Greview\u001b[46Ga\u001b[48Gstage's\u001b[56Gcommits\u001b[64Gwhen\u001b[69Git\u001b[72Gcloses.\u001b[80GWhen\u001b[85Ga\u001b[87Gmajor\u001b[93Gstage\u001b[99Gcloses,\u001b[107Ga\r\u001b[2C\u001b[1Bwhole-codebase review follows, Jettison first, \u001b[51Ghen Manif\u001b[61Gst, aimed at concer\u001b[81Gs that cu\u001b[91G across stages. The\u001b[111Gmemory\u001b[118Gis\r\u001b[2C\u001b[1Bupdated too. I read \"major st\u001b[33Gge\" as one of Manif\u001b[53Gst's developm\u001b[68Gt stage\u001b[76G; tell me if y\u001b[91Gu\u001b[93Gme\u001b[96Gn something larger.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.299, "o", "\u001b[?25l\u001b[H\u001b[3G└───────┴────────────────────────────────────────────────────────────────────────────┴────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B† \u001b[38;2;177;185;249mdd5b254\u001b[39m is a placeholder; the real hash of that format commit is in \u001b[38;2;177;185;249mgit log\u001b[39m, between \u001b[38;2;177;185;249m15a0ac5\u001b[39m and \u001b[38;2;177;185;249m7b6a8d7\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B-\u001b[5G\u001b[1mThe engine changed in three places.\u001b[22m \u001b[38;2;177;185;249mSimWorld::ComponentNames\u001b[39m and\u001b[70G\u001b[38;2;177;185;249mServ\u001b[75GceNames\u001b[39m no\u001b[86G return copies.\u001b[102G\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mNet::Server::Closing\u001b[26G\u001b[39mis\u001b[29Gnew,\u001b[34Gso\u001b[37Ga\u001b[39Gstopping\u001b[48Gserver\u001b[55Gcan\u001b[59Gwait\u001b[64Gfor\u001b[68Gits\u001b[72Gclients\u001b[80Gto\u001b[83Greceive\u001b[91Gthe\u001b[95Glast\u001b[100Greplies.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mPlatform::ResolvePath\u001b[39m resolves one XDG directory alone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9 changed four existing journal tests.\u001b[22m They expected\u001b[59Gone flush per \u001b[38;2;177;185;249mAdvance\u001b[39m call, which was the bug. The\u001b[110Gfixtures'\r\u001b[4C\u001b[1Bpinned state hashes did n\u001b[31Gt move.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mThe F8/F10\u001b[17Gix:\u001b[22m directories are now created one compone\u001b[61Gt\u001b[63Gat a time, each made private throug\u001b[99G the same path it was\r\u001b[4C\u001b[1Bcreated by. T\u001b[20Gt covers\u001b[29G\u001b[38;2;177;185;249mnew/..\u001b[39m paths\u001b[42Gand\u001b[46Gsymlinks,\u001b[56Gand\u001b[60Gthe\u001b[64Gworld\u001b[70Gand\u001b[74Gbackup\u001b[81Gdirectories\u001b[93Guse\u001b[97Git\u001b[100Gtoo.\u001b[105GA\u001b[107Gside\u001b[112Geffect:\r\u001b[2C\u001b[1B \u001b[5Gwhen a world or\u001b[21Gbackup d\u0