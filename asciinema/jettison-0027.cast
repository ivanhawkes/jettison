[0.073, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(docs/build-and-gates.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 725 \u001b[22m - The full gate'\u001b[29G shape\u001b[36Gon\u001b[39Gthe\u001b[43Grunner,\u001b[51Gfrom\u001b[56Gthe\u001b[60Gjob\u001b[64Glog\u001b[68Gof\u001b[71G2026-11-16:\u001b[83G2\u001b[85G732\u001b[89Gs,\u001b[92Gclang-tidy\r\u001b[1B     \u001b[2m 726 \u001b[12G\u001b[22m \u001b[14G**786\u001b[20Gs**, the debug\u001b[35Gbuild\u001b[41G665\u001b[45Gs,\u001b[48Gthe\u001b[52Grelease\u001b[60Gbuild\u001b[66G580\u001b[70Gs,\u001b[73Gthe\u001b[77Glavapipe\u001b[86Gsmoke\u001b[92Gtest\u001b[97G489\u001b[101Gs,\r\u001b[8C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m \u001b[14Greference frames 160 s, the two suites 27\u001b[56Gs and 24 s,\u001b[68Gformat 1 s, with\u001b[85G94 s of ru\u001b[96Gner setup\u001b[106Gin\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 728 -\u001b[38;2;248;248;242m  front. The job took 47m34s against a 60-minute timeout, and later runs \u001b[48;2;92;2;0mpassed\u001b[48;2;61;1;0m it, which is why      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 728 +\u001b[38;2;248;248;242m  front. The job took 47m34s against a 60-minute timeout, and later runs \u001b[48;2;4;71;0mran\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mpast \u001b[48;2;2;40;0mit, which is why    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 729 \u001b[22m   CI was cut to the build and the smoke test.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 730 \u001b[22m - An earlier run failed compiling ImGui's GLFW backend because `GL/gl.h` was missing. The ImGui\u001b[K\r\u001b[7C\u001b[1B\u001b[2m31\u001b[14G\u001b[22mtarget\u001b[21Gdefines `GLFW_INCLUDE_NONE`, because\u001b[58Git\u001b[61Guses\u001b[66GVulkan\u001b[73Gand\u001b[77Gdoes\u001b[82Gnot\u001b[86Gneed\u001b[91GOpenGL\u001b[98Gheaders.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe README d\u001b[16Gscribes the\u001b[28Glocal\u001b[34Ggate,\u001b[40Gso\u001b[43Git\u001b[46Gstays.\u001b[53GNow\u001b[57GManifest's\u001b[68Gdocuments:\u001b[79Gits\u001b[83Gbuild-and-gates\u001b[99GCI\u001b[102Glines,\u001b[109Gits\r\u001b[1B  \u001b[38;2;177;185;249mAGENTS.md\u001b[39m, a D-116 ledger row,\u001b[34Gand\u001b[38GR07's\u001b[44Gnote\u001b[49Gthat\u001b[54GCI\u001b[57Gran\u001b[61Gthe\u001b[65Gbundle\u001b[72Gcheck.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
