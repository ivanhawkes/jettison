[0.079, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPushed. Now building Manifest on the new pin and\u001b[52Grunning\u001b[60Gthe\u001b[64Gsuites\u001b[71Gthe\u001b[75Gfixes\u001b[81Gtouch.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery suite the fixes\u001b[25Gtouch\u001b[31Gpasses.\u001b[39GNext:\u001b[45Gcommit\u001b[52GManifest,\u001b[62Gthen\u001b[67Gits\u001b[71Gfull\u001b[76Ggate,\u001b[82Gthen\u001b[87Ground\u001b[93G2.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+29\u001b[38;2;153;153;153m, ran \u001b[1m9\u001b[22m shell commands, recalled \u001b[1m1\u001b[22m memory \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted in Manifest as \u001b[38;2;177;185;249m4ddac45\u001b[39m. Its full gate (\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m,\u001b[76G24\u001b[79Gworkers)\u001b[88Gis\u001b[91Gstarting.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m60\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe Manifest gate is on its sanitised suites now; \u001b[38;2;177;185;249mfixture_cruise\u001b[68G\u001b[39malone\u001b[74Gtakes\u001b[80Gabout\u001b[86Gten\u001b[90Gminutes.\u001b[99GStill\u001b[105Gwaiting.\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mBackground command \"cd ../manifest &&\u001b[41GCMAKE_BUILD_PARALLEL_LEVEL=24 CTEST_PARALLEL_LEVEL=24 MANIFEST_TIDY_JOBS=24\r\u001b[2C\u001b[1B./scripts/ci.sh\u001b[19G--werror\u001b[28G--asan\u001b[35G--tidy\u001b[42G>\u001b[44Gbuild/gate-stage5-review1.out\u001b[74G2>&1;\u001b[80Gecho\u001b[85G\"exit=$?\"\u001b[95G>>\r\u001b[1B \u001b[3Gbuild/\u001b[10Gate-stage5-review1.out\"\u001b[34Gcompleted\u001b[44G(exit\u001b[50Gcode\