[0.148, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe engine changed in three places.\u001b[41G\u001b[22m\u001b[38;2;177;185;249mSimWorld::ComponentNames\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249mServiceNames\u001b[83G\u001b[39mnow\u001b[87Greturn\u001b[94Gcopies.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mNet::Server::Closing\u001b[39m is new, so \u001b[38G stopping\u001b[48Gserver can wait for its clients to rec\u001b[87Give the last replies.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mPlatform::ResolvePath\u001b[27G\u001b[39mresolves\u001b[36Gone\u001b[40GXDG\u001b[44Gdirectory\u001b[54Galone.\r\u001b[4C\u001b[1B\u001b[1mF9 changed\u001b[16Gfour \u001b[22Gxisting journ\u001b[36Gl tests.\u001b[22m They expected one flush per \u001b[38;2;177;185;249mAdvance\u001b[39m call,\u001b[87Gwhich was the bug.\u001b[106GThe\u001b[110Gfixtures'\r\u001b[4C\u001b[1Bpinned state hashes d\u001b[27Gd\u001b[30Got move.\u001b[39G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe F8/F10 fix:\u001b[22m directories are \u001b[38Gow created one component\u001b[63Gat\u001b[66Ga\u001b[68Gtime,\u001b[74Geach\u001b[79Gmade\u001b[84Gprivate\u001b[92Gthrough\u001b[100Gthe\u001b[104Gsame\u001b[109Gpath\u001b[114Git\u001b[117Gwas\r\u001b[2C\u001b[1B \u001b[5Gcreated by. That covers \u001b[38;2;177;185;249mnew/..\u001b[39m paths and symlinks, and the world and backup\u001b[81Gdirector\u001b[90Ges\u001b[93Guse\u001b[97Git too. A side effect:\r\u001b[4C\u001b[1Bwhe\u001b[9G a\u001b[12Gworld\u001b[18Gor backup direct\u001b[35Gry's\u001b[40Gparent\u001b[47Gfolders\u001b[55Gare\u001b[59Gmissing,\u001b[68Gthose\u001b[74Gparents\u001b[82Gare\u001b[86Gnow\u001b[90Gcreated\u001b[98Gprivate\u001b[106Gas\u001b[109Gwell,\u001b[115Gwhere\r\u001b[2C\u001b[1B \u001b[5Gbefore only the\u001b[21Glast one was.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mYour new review rule\u001b[22m is in J\u001b[32Gt\u001b[34Gison \u001b[38