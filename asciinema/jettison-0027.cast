77;185;249mgit log\u001b[39m,\u001b[82Gbetween\u001b[90G\u001b[38;2;177;185;249m15a0ac5\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249m7b6a8d7\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe engine changed in three places.\u001b[41G\u001b[22m\u001b[38;2;177;185;249mSimWorld::ComponentNames\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249mServiceNames\u001b[83G\u001b[39mnow\u001b[87Greturn\u001b[94Gcopies.\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mNet::Server::Closing\u001b[39m is\u001b[29Gnew,\u001b[34Gso\u001b[37Ga\u001b[39Gstopping\u001b[48Gserver\u001b[55Gcan\u001b[59Gwait\u001b[64Gfor\u001b[68Gits\u001b[72Gclients\u001b[80Gto\u001b[83Greceive\u001b[91Gthe\u001b[95Glast\u001b[100Greplies.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mPlatform::ResolvePath\u001b[27G\u001b[39mresolves\u001b[36Gone\u001b[40GXDG\u001b[44Gdirectory\u001b[54Galone.\r\u001b[1B \u001b[3G- \u001b[1mF9 changed four existing journal tests.\u001b[22m They expected one flush per \u001b[38;2;177;185;249mAdvance\u001b[39m call, which was the bug. The fixtures'\r\u001b[2C\u001b[1B  pinned state hash\u001b[23Gs did not move.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mThe F8/F10 fix:\u001b[22m directories are now created one component\u001b[63Gat\u001b[66Ga\u001b[68Gtime,\u001b[74Geach\u001b[79Gmade\u001b[84Gprivate\u001b[92Gthrough\u001b[100Gthe\u001b[104Gsame\u001b[109Gpath\u001b[114Git\u001b[117Gwas\r\u001b[4C\u001b[1Bcreated\u001b[13Gby.\u001b[17GThat\u001b[22Gcovers\u001b[29G\u001b[38;2;177;185;249mnew/..\u001b[36G\u001b[39mpaths\u001b[42Gand\u001b[46Gsymlinks,\u001b[56Gand\u001b[60Gthe\u001b[64Gworld\u001b[70Gand\u001b[74Gbackup\u001b[81Gdirectories\u001b[93Guse\u001b[97Git\u001b[100Gtoo.\u001b[105GA\u001b[107Gside\u001b[112Geffect:\r\u001b[1B \u001b[3G  when a world or backup directory's\u001b[40Gparent\u001b[47Gfolders\u001b[55Gare\u001b[59Gmissing,\u001b[68Gthose\u001b[74Gparents\u001b[82Gare\u001b[86Gnow\u001b[90Gcreated\u001b[98Gprivate\u001b[106Gas\u