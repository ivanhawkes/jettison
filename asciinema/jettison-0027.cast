nning c\u001b[13G ../manifest && cmak\u001b[34G --bu\u001b[40Gld --preset c\u001b[54Gang-de…\u001b[62G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && cmake --build --preset clang-debug -j24 2>&1 | grep -E \"error|FAILED\" | head; ctest --test-dir \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mbuild/clang-debug -j24 2>&1 | tail -6; clang-tidy -p build/clang-debug source/game/content/src/ContentIdentity.cpp \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153msource/game/ho\u001b[22G/src/Journal.cpp sourc\u001b[45G/game/host/tests/HostTests.cpp… (1m\u001b[81G47s · 7 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ Saves should be decoupled from that loop and thread in future. We don't want to have frame stutter because a save \u001b[39m    \r\u001b[1B  \u001b[38;2;153;153;153mtook more than 16ms.\u001b[39m                                                                                                  \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✻\u001b[39m \u001b[38;2;218;124;92mDoodling…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Debug suites, tidy, format\u001b[41Gcheck · 21m 28s · ↓\u001b[39m \u001b[38;2;153;153;153m40.4k tokens)\r\u001b[1B  ⎿  Tip: Name sessions with /rename to find them in /resume\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0027 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[2mPress up to edit queued messages\r\u001b[37C\u001b[3B\u001b[22m\u001b[38;2;153;153;153m · esc to interrupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
