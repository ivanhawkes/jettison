[0.561, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth fixes are in, and four existing journal tests that assumed one flush per \u001b[38;2;177;185;249mAdvance\u001b[39m call are updated. \u001b[38;2;177;185;249mhost\u001b[39m, \u001b[38;2;177;185;249mremote\r\u001b[2C\u001b[1B\u001b[39mand \u001b[38;2;177;185;249mcli_serve\u001b[39m pass. Committing, then the full gate covers the fixtures.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/game/host/include/manifest/host/Journal.h)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 139 \u001b[22m   \u001b[38;2;166;226;46mvoid\u001b[39m \u001b[38;2;166;226;46mRecover\u001b[38;2;253;151;31m(Jettison::Sim::SimWorld &world)\u001b[59G\u001b[38;2;166;226;46mconst\u001b[39m;\r\u001b[1B     \u001b[2m 140 \u001b[12G\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m41\u001b[12G\u001b[22m  \u001b[38;2;117;113;94m// Takes the world's next steps, the requests queued on it running at the start of the first, and\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 142 -\u001b[38;2;248;248;242m  // writes \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m batch \u001b[48;2;92;2;0mor\u001b[48;2;61;1;0m \u001b[48;2;92;2;0ma \u001b[48;2;61;1;0msnapshot \u001b[48;2;92;2;0mwhen\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mone\u001b[48;2;61;1;0m is due. Nothing but requests may be queued. A write that   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 142 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// writes \u001b[48;2;4;71;0meach\u001b[48;2;2;40;0m batch \u001b[48;2;4;71;0mand\u001b[48;2;2;40;0m snapshot \u001b[48;2;4;71;0mdue\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mon\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mthe way at the step it \u001b[48;2;2;40;0mis due\u001b[48;2;4;71;0m, as shorter advances would\u001b[48;2;2;40;0m. N\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m     +\u001b[38;2;117;113;94mothing but requests may be queued. A write that\u001b[38;2;248;248;242m                                                       \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 143 \u001b[22m   \u001b[38;2;117;113;94m// fails throws what the writer threw and leaves the files uncertain, since the catalogue may\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 144 \u001b[22m   \u001b[38;2;117;113;94m// already name what was written: the journal then refuses every later call with\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 145 \u001b[22m   \u001b[38;2;117;113;94m// std::logic_error, and the next opening finds which it was. Throws std::logic_error too for a\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/history.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m4\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m39\u001b[12G\u001b[22mvariable\u001b[21Gor\u001b[24GHOME\u001b[29G(Jettison's\u001b[41G`Resol\u001b[76Gime);\u001b[82Gand\u001b[86Gno\u001b[89Gtest\u001b[94Gcut\u001b[98Ga\u001b[100Gsnapshot's\u001b[27;1H\u001b[24;3H\u001b[?25h"]
