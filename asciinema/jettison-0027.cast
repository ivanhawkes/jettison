[0.684, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│     │          │ A clean stop never sends the final replies: the server is          │ Manifest \u001b[38;2;177;185;249mmain.cpp:202\u001b[39m (or │\r\u001b[4C\u001b[1BF1\u001b[11Gblocker\u001b[22Gdestroyed straight\u001b[41Gafter\u001b[47G\u001b[38;2;177;185;249mPublish()\u001b[39m, before they\u001b[70Ggo out.  \u001b[91G the \u001b[97Gngine server's \u001b[113G   \r\u001b[4C\u001b[1B  \u001b[11G       \u001b[22G         \u001b[32G        \u001b[41G     \u001b[47G          \u001b[58G      \u001b[65G    \u001b[70G  \u001b[73G    \u001b[91Gdestructor)\u001b[103G        \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│     │          │ \u001b[38;2;177;185;249mSimWorld::ComponentNames()\u001b[39m and \u001b[38;2;177;185;249mServiceNames()\u001b[39m return names that    │                           │\r\u001b[4C\u001b[1BF2\u001b[11Gblocker\u001b[22Gbreak when another service\u001b[49Gis added, though the header promises\u001b[91G\u001b[1mJettison\u001b[100G\u001b[22m\u001b[38;2;177;185;249mSimWorld.cpp:149\r\u001b[4C\u001b[1B\u001b[39m  \u001b[11G       \u001b[22Gth\u001b[25Gy last as long a\u001b[42G the world. Ad\u001b[57GressSanitiz\u001b[69Gr c\u001b[73Gtches the stale\u001b[91G        \u001b[100G                \r\u001b[21C\u001b[1B r\u001b[25Gad.   \u001b[32G  \u001b[35G    \u001b[40G  \u001b[43G   \u001b[47G      \u001b[54G                \u001b[71G       \u001b[79G   \u001b[83G     \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│     │          │ A flush limits how many requests a batch holds but not its size. A │                           │\r\u001b[4C\u001b[1BF3\u001b[11Gblocker\u001b[22G batch of 34.8\u001b[37GMB was written, and\u001b[57Grecovery then refused it under \u001b[91GManifest\u001b[100G\u001b[38;2;177;185;249mJournal.cpp:462\r\u001b[4C\u001b[1B\u001b[39m  \u001b[11G       \u001b[22Gits 32\u001b[29GMiB limit.\u001b[40G   \u001b[44G        \u001b[53G   \u001b[57G        \u001b[66G    \u001b[71G       \u001b[79G  \u001b[82G     \u001b[91G        \u001b[100G               \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│     │          │ Restore checks and writes one file at a time, so it writes before  │                           │\r\u001b[4C\u001b[1BF4\u001b[11Gmajor\u001b[22Git has checked\u001b[37Gthe\u001b[42Ghol\u001b[46G backup. The plan says every checksum is \u001b[91GManifest\u001b[100G\u001b[38;2;177;185;249mJournal.cpp:619\r\u001b[4C\u001b[1B\u001b[39m  \u001b[11G     \u001b[22Gchecked b\u001b[32Gfore\u001b[41Gfirst\u001b[47Gwrite. \u001b[55G   \u001b[59G    \u001b[64G    \u001b[69G     \u001b[75G        \u001b[84G  \u001b[91G        \u001b[100G               \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│ F5  │ major    │ \u001b[38;2;177;185;249mDefaultLocations()\u001b[39m fails when only \u001b[38;2;177;185;249mXDG_CACHE_HOME\u001b[39m is missing,      │ Manifest \u001b[38;2;177;185;249mLocations.cpp:19\u001b[39m │\r\u001b[4C\u001b[1B  \u001b[11G     \u001b[22Gthough Manifest never u\u001b[46Ge\u001b[75G        \u001b[91G        \u001b[100G                \u001b[27;1H\u001b[24;3H\u001b[?25h"]
