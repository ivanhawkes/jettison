[1.583, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[1mF12 (a backup could delete the world):\u001b[22m a world inside its backup\u001b[71Gdir\u001b[75Gctory is now refused.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF13 (a symlink could put backups inside the world):\u001b[22m the location\u001b[70Gcheck\u001b[76Gnow\u001b[80Gruns\u001b[85Gagain\u001b[91Gafter\u001b[97Gthe\u001b[101Gbackups\u001b[109Gdirectory\u001b[119Gis\r\u001b[4C\u001b[1Bmade,\u001b[11Gwhen\u001b[16Gevery\u001b[22Gpart\u001b[27Gof\u001b[30Gthe\u001b[34Gpath\u001b[39Gexists\u001b[46Gand\u001b[50Gthe\u001b[54Gsymlinks\u001b[63Gresolve.\r\u001b[2C\u001b[1B- \u001b[1mF14 (a world directory left op\u001b[36Gn to\u001b[41Gev\u001b[44Gryone):\u001b[22m directories are now created 0700 from the start instead of being\r\u001b[2C\u001b[1B \u001b[5Gchanged afterwards. This\u001b[31Geeded an engin\u001b[46G change: Jettison's \u001b[38;2;177;185;249mCreateDirectoriesDurably\u001b[39m takes\u001b[97Gthe permissions to\u001b[116G\u001b[K\r\u001b[4C\u001b[1Bcr\u001b[8Gat\u001b[11G with.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits and gate\u001b[20G:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison \u001b[38;2;177;185;249m459af99\u001b[22G\u001b[39mh\u001b[24Glds\u001b[28Gthe engine change; its gate passed \u001b[64Gnd it's\u001b[72Gpushed.\u001b[80GYour\u001b[85Grule\u001b[90Gcommit\u001b[97G\u001b[38;2;177;185;249mc2be3ac\u001b[105G\u001b[39mwas\u001b[109Gpushed\u001b[116Gwith\r\u001b[4C\u001b[1Bit, since it sits\u001b[23Gunderneath.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GManifest \u001b[38;2;177;185;249m24f08d0\u001b[39m mov\u001b[26Gs the pin to \u001b[38;2;177;185;249m459af99\u001b[39m and holds the rest. Its gate passed (\u001b[38;2;177;185;249mbuild/gate-stage5-review5.out\u001b[39m). It\r\u001b[4C\u001b[1Bisn't\u001b[11Gpushed,\u001b[19Gnor\u001b[23Gare\u001b[27Gthe\u001b[31Gearlier\u001b[39GStage\u001b[45G5\u001b[47Greview\u001b[54Gcommits.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat Codex's own checks showed before the filter stopped it\u001b[22m (sav\u001b[68Gd in \u001b[38;2;177;185;249mbuild/reviews/stage-5/round-6a-scratch/\u001b[39m):\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF12, F13, F14:\u001b[20G\u001b[22mall\u001b[24Gthree\u001b[30Gnow\u001b[34Gfail\u001b[39Gas\u001b[42Gintended.\u001b[52G\u001b[38;2;177;185;249mnew/..\u001b[59G\u001b[39mand\u001b[63Grelative\u001b[72Gpaths\u001b[78Gleave\u001b[84Gthe\u001b[88Gexisting\u001b[97Gparent\u001b[104Gat\u001b[107G0750\u001b[112Gand\u001b[116Gmake\r\u001b[2C\u001b[1B  the new directory 0700.\u001b[29GThe symlink path into the world is refused with no identity written, and a\u001b[104Gworld inside\u001b[117Gits\r\u001b[2C\u001b[1B  backups is refused.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mTwo more checks it was running:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  - A symlink in\u001b[20Ga token file\u001b[35Gpath left the other\u001b[55Gfile in\u001b[63Gact.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GIt\u001b[10Greplaced\u001b[19Gthe\u001b[23Gworld's\u001b[31G\u001b[38;2;177;185;249msnapshots\u001b[41G\u001b[39mdirectory\u001b[51Gwith\u001b[56Ga\u001b[58Gsymlink\u001b[66Gto\u001b[69Ga\u001b[71Gfolder\u001b[78Goutside.\u001b[87GThe\u001b[91Gserver\u001b[98Gwrote\u001b[104Ga\u001b[106G474\u001b[110GKB\u001b[113Gsnapshot\r\u001b[1B \u001b[3G    through it, and the probe's \u001b[38;2;177;185;249moriginal_retained False\u001b[59G\u001b[39msuggests\u001b[68Gsomething\u001b[78Galready\u001b[86Gin\u001b[89Gthat\u001b[94Gfolder\u001b[101Gdidn't\u001b[108Gsurvive.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
