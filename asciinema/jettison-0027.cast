[0.065, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mi pushed it for you\u001b[39m                                                                                                   \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[39m Thanks. With \u001b[38;2;177;185;249m13c1bec\u001b[39m on GitHub I'll move Manifest's pin and go back to its own trees once this probe build finishes.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe probe matches R01's\u001b[27Ginventory\u001b[37Gexactly:\u001b[46G32\u001b[49GManifest\u001b[58Gcomponents,\u001b[70G18\u001b[73Gtravel\u001b[80Gcomponents,\u001b[92G3\u001b[94Gservices.\u001b[104GReplacing\u001b[114Gthe\r\u001b[2C\u001b[1Bprobe\u001b[9Gwith\u001b[14Gthe\u001b[18Gpinned\u001b[25Gtest\u001b[30Gand\u001b[34Gmoving\u001b[41Gthe\u001b[45Gpin\u001b[49Gto\u001b[52G\u001b[38;2;177;185;249m13c1bec\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cd\u001b[14G../manif\u001b[23Gst && git diff --qui\u001b[44Gt 13c1bec -- dev…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && git diff --quiet 13c1bec -- devenv.nix 2>/dev/null; for f in devenv.nix devenv.yaml \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mdevenv.lock; do cmp -s $f ../jettison/$f && echo \"$f same\" || echo \"$f DIFFERS\"; done; clang-format -i \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153msource/game/ho\u001b[22G/tests/HostTests.cpp\u001b[43Gsourc\u001b[49G/game/host/tests/JournalTests.cpp sourc\u001b[89G/game/hos… (1m 3s · 6 lines)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ When you have some spare time, the github CI is failing every time, probably because it takes over an hour to run the\u001b[39m \r\u001b[1B  \u001b[38;2;153;153;153mtests there. Can we just cu