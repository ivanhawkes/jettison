[0.056, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSave size and flush timing measured: 475 KB takes 6.0 ms and 741 KB takes 10.9 ms in Release, with each fsync'd\u001b[115Gflush\r\u001b[2C\u001b[1Baround 10.6 ms. I'm running the Debug suites and tidy on the touched units before committing.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mAre saves running on a different thread to the main game loop?\u001b[39m                                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSaves run on the server loop's own thread, \u001b[47Go each flush\u001b[60Gpauses it about 10.6 ms and each hourly snapshot\u001b[109Gabout\u001b[115G60\u001b[118Gms,\r\u001b[2C\u001b[1Bwhich\u001b[9Gis\u001b[12Groughly\u001b[20Gfour\u001b[25Gframes\u001b[32Gthat\u001b[37Gthe\u001b[41Gloop\u001b[46Gthen\u001b[51Gcatches\u001b[59Gup.\u001b[63GThat\u001b[68Gis\u001b[71Gharmless\u001b[80Gtoday,\u001b[87Gbut\u001b[91Gthe\u001b[95Gcost\u001b[100Ggrows\u001b[106Gwith\u001b[111Gworld\r\u001b[1B  size and disk speed, so I'll record it as a known limit in R09 and carry on with the Debug suites.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[60C\u001b[7B\u001b[38;2;153;153;153m40\u001b[64G5\u001b[78Gought for 7s)\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
