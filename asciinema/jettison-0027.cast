u001b[39G\u001b[38;2;177;185;249mc2be3ac\u001b[39m,\u001b[48Gnot\u001b[52Gyet\u001b[56Gpushed.\u001b[64G\u001b[38;2;177;185;249mcross-review.sh\u001b[80G\u001b[39mnow\u001b[84Gdefaults\u001b[93Gto\u001b[96Gthree\u001b[102Grounds.\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdocs/build-and-gates.md\u001b[27G\u001b[39mnow says to\u001b[39Greview a\u001b[48Gstage's\u001b[56Gcommits\u001b[64Gwhen it closes.\u001b[80GWhen a major\u001b[93Gstage closes, a\u001b[K\r\u001b[2C\u001b[1Bwhole-codebase review follow\u001b[32G, Je\u001b[37Gtison first, th\u001b[53Gn Manifest, aimed at concerns th\u001b[86Gt cut across\u001b[99Gstag\u001b[105G.\u001b[107GThe\u001b[111Gmemory\u001b[118Gis\r\u001b[2C\u001b[1Bupdated too. I\u001b[20Gad \"major stage\" as \u001b[42Ge of Manif\u001b[53Gst's development stages; tell\u001b[83Gme if you mean something larg\u001b[113Gr.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BManifest's\u001b[14G\u001b[38;2;177;185;249mfeature-base\u001b[27G\u001b[39mand\u001b[31GJettison\u001b[40G\u001b[38;2;177;185;249mc2be3ac\u001b[48G\u001b[39mare\u001b[52Gboth\u001b[57Gready\u001b[63Gto\u001b[66Gpush.\u001b[72GShall\u001b[78GI\u001b[80Gpush\u001b[85Gthem?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis\u001b[8Gis\u001b[11Ga\u001b[13Ggood\u001b[18Gpoint\u001b[24Gto\u001b[27Gstart\u001b[33Ga\u001b[35Gnew\u001b[39Gsession\u001b[47Gor\u001b[50G\u001b[38;2;177;185;249m/compact\u001b[39m.\r\u001b[2C\u001b[1B    \u001b[8G  \u001b[11G \u001b[13G    \u001b[18G     \u001b[24G  \u001b[27G     \u001b[33G \u001b[35G   \u001b[39G       \u001b[27;1H\u001b[24;3H\u001b[?25h"]
