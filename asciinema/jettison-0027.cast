[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery s\u001b[11Gite the fixes touch passes. Next: commit Manifest, then its\u001b[71Gfull gate, then round 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+29\u001b[38;2;153;153;153m, ran \u001b[1m9\u001b[22m shell commands, recalled \u001b[1m1\u001b[22m memory \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted in Manifest as \u001b[38;2;177;185;249m4ddac45\u001b[39m.\u001b[37GIts\u001b[41Gfull\u001b[46Ggate\u001b[51G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m,\u001b[76G24\u001b[79Gworkers)\u001b[88Gis\u001b[91Gstarting.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m60\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe Manifest gate is on its sanitised\u001b[41Gsuites\u001b[48Gnow;\u001b[53G\u001b[38;2;177;185;249mfixture_cruise\u001b[68G\u001b[39malone\u001b[74Gtakes\u001b[80Gabout\u001b[86Gten\u001b[90Gminutes.\u001b[99GStill\u001b[105Gwaiting.\r\u001b[2C\u001b[2BBackground command \"cd ..\u001b[29Gmanifest && CMAKE_BUILD_PARALLEL_LEVEL=24\u001b[71GCTEST_PARALLEL_LEVEL=24\u001b[95GMANIFEST_TIDY_JOBS=24\r\u001b[1B  ./sc\u001b[8Gipts/ci.sh --werror --asan --tidy > build/gate-stage5-review1.out 2>&1; echo\u001b[85G\"exit=$?\"\u001b[95G>>\r\u001b[2C\u001b[1Bbuild/gate-stage5-revi\u001b[26Gw1.out\"\u001b[34Gcompleted (exit code 0)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m13\u001b[22m patterns \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mManifest's gate passed:\u001b[27Gevery suite\u001b[39Gin four preset\u001