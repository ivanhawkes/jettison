[0.051, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(~/projects/manif\u001b[27Gst/docs/coding-standards.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m29\u001b[11G\u001b[22mThe developme\u001b[25Gt shell and the\u001b[41GSDK pin\u001b[49Gmove together\u001b[63G([\u001b[38;2;230;219;116mD-006\u001b[39m](decision-ledger.\u001b[89Gd),\u001b[K\r\u001b[6C\u001b[1B\u001b[2m30\u001b[11G\u001b[22m[\u001b[38;2;230;219;116mD-054\u001b[39m](dec\u001b[23Gsion-ledger.md#d-054)). Do not\u001b[54Gadd a secon\u001b[66G vers\u001b[72Gon\u001b[76Gf an engine dependency.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 31 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m32\u001b[11G\u001b[38;2;248;248;242mCl\u001b[15Gg-tidy runs in CI and\u001b[37Gis op\u001b[43G-in locally ([D-007](decision-ledger.md)), and\u001b[90Gbuild    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 32 +\u001b[38;2;248;248;242mClang-tidy is opt-in locally (`--tidy`) and runs at the gate before a push, not in CI                  \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m33\u001b[11G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-007\u001b[38;2;248;248;242m](decision-ledger.md), [\u001b[38;2;230;219;116mD-116\u001b[38;2;248;248;242m](decision-ledger.md#d-116)), and build                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 34 \u001b[22m concurrency is set per machine ([\u001b[38;2;230;219;116mD-051\u001b[39m](decision-ledger.md#d-051)).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 35 \u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m36\u001b[11G\u001b[22m## Differences from the engine's\u001b[44Grules\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ yq '.jobs | keys' .github/workflows/ci.yml && yq '.jobs.bundle.steps[].name' ../manifest/.github/workflows/ci.yml\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m&& yq '.jobs.smoke.steps[].name' .github/workflows/ci.yml; lychee --offline --no-progress docs/build-and-gates.md \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m../manifest/do\u001b[21Gs/build-and-gates.m\u001b[41G ../manifest/docs/decision-ledger.…\r\u001b[13C\u001b[2B49m 38s · ↓\u001b[39m \u001b[38;2;153;153;153m70.9k\u001b[32Gt\u001b[34Gkens)\u001b[39m\u001b[K\r\u001b[18C\u001b[7B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
