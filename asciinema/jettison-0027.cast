[0.064, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe probe\u001b[13Gmatches R01's \u001b[28Gnventory exactly: 32 Ma\u001b[52Gifest\u001b[58Gcomponents, 18 travel\u001b[80Gc\u001b[82Gmponents,\u001b[92G3\u001b[94Gservices.\u001b[104GReplacing\u001b[114Gthe\r\u001b[2C\u001b[1Bprobe\u001b[9Gwith\u001b[14Gthe\u001b[18Gpinned\u001b[25Gtest\u001b[30Gand\u001b[34Gmoving\u001b[41Gthe\u001b[45Gpin\u001b[49Gto\u001b[52G\u001b[38;2;177;185;249m13c1bec\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhen you have some spare time, the github CI is failing every time, probably because it takes over an hour to run the\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mtests there. Can we just cut it down to a small subset of the tests run here e.g. build, make the install images, \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255msmoketest?\u001b[39m                                                                                                            \r\u001b[1B\u001b[49m\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m2\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[2C\u001b[2B\u001b[39mNoted \u001b[10Gn CI. I'll\u001b[21Glook at it once\u001b[37GR09's build\u001b[49Gand t\u001b[57Gs are through, and check which reposito\u001b[97Gy's workflow \u001b[111Gs timing\r\u001b[2C\u001b[1Bout before\u001b[14Gcutting it\u001b[25Gdown. Waiting on the rebuild against\u001b[62Gthe\u001b[66Gnew\u001b[70Gpin.\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[39m Running cd ../manifest && git diff --quiet 13c1bec -- dev…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && git diff --quiet 13c1bec -- devenv.nix 2>/dev/null; for f in devenv.nix devenv.yaml \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;153;153;153mdevenv.lock; do cmp -s $f ../jettison/$f && echo