[4.356, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mFinding:\u001b[22m \u001b[1mA backup can delete the live world.\u001b[48G\u001b[22mThe\u001b[52Glocation\u001b[61Gcheck\u001b[67Gallows\u001b[74Gthe\u001b[78Gworld\u001b[84Gto\u001b[87Gsit\u001b[91Ginside\u001b[98Gthe\u001b[102Gbackups\r\u001b[2C\u001b[1B  directory. If the world's folder happens\u001b[46Gto\u001b[49Gbe\u001b[52Gnamed\u001b[58G\u001b[38;2;177;185;249m<world-id>.<next-batch>\u001b[39m,\u001b[83Gthe\u001b[87Gnext\u001b[92Gbackup's\u001b[101Gtarget\u001b[108Gis\u001b[111Gthe\r\u001b[2C\u001b[1B  world itself. \u001b[38;2;177;185;249mremove_all\u001b[39m then deletes it, lock included, and s\u001b[68Gutdown still reports success.\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow Codex proved it:\u001b[22m \u001b[38;2;177;185;249mround5-backup-alias.py\u001b[39m:\u001b[48Grestore,\u001b[57Gserve\u001b[63Gand\u001b[67Gstop\u001b[72Gexited\u001b[79G0,\u001b[82Gand\u001b[86Gthe\u001b[90Gworld\u001b[96Gdirectory\u001b[106Gwas\u001b[110Ggone.\r\u001b[2C\u001b[1B\u001b[1mFix I'd make:\u001b[22m Refuse a world inside the backups\u001b[51Gdirectory\u001b[61Gas\u001b[64Gwell\u001b[69Gas\u001b[72Gbackups\u001b[80Ginside\u001b[87Gthe\u001b[91Gworld.\u001b[98GAlso\u001b[103Grefuse\u001b[110Gany\r\u001b[2C\u001b[1B  backup\u001b[12Gwhose\u001b[18Gtarget\u001b[25Gresolves\u001b[34Gto\u001b[37Gthe\u001b[41Gworld\u001b[47Gbefore\u001b[54G\u001b[38;2;177;185;249mremove_all\u001b[65G\u001b[39mruns.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1m#:\u001b[22m F13\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinding:\u001b[22m \u001b[1mA symlink can get backups inside the world.\u001b[56G\u001b[22m\u001b[38;2;177;185;249mweakly_canon\u001b[69Gcal\u001b[39m stops resolving\u001b[89Gat the\u001b[96Gfirst\u001b[102Gfolder\u001b[109Gthat\r\u001b[2C\u001b[1B  doesn't exist yet.\u001b[24GSo \u001b[38;2;177;185;249m<base>/missing/../link/backups\u001b[39m, wher\u001b[65G\u001b[38;2;177;185;249mlink\u00