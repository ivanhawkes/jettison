2;230;219;116mjettison\"\u001b[38;2;248;248;242m,\u001b[59G\u001b[38;2;166;226;46mEnvironment\u001b[38;2;248;248;242m({{\u001b[38;2;230;219;116m\"HOME\"\u001b[38;2;248;248;242m,\u001b[81G\u001b[38;2;230;219;116m\"/home/a\"\u001b[38;2;248;248;242m}}))\u001b[95G==\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[13G\u001b[38;2;248;248;242m    \u001b[38;2;230;219;116m\"/home/a/.local/state/jettison\"\u001b[38;2;248;248;242m);           \u001b[62G      \u001b[69G            \u001b[82G                       \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[11G\u001b[38;2;248;248;242m \u001b[13G\u001b[38;2;166;226;46mCHECK_THROWS_AS\u001b[38;2;248;248;242m(\u001b[38;2;166;226;46mResolvePath\u001b[38;2;248;248;242m(Directory::UserData, \u001b[38;2;230;219;116m\"a/b\"\u001b[38;2;248;248;242m, configOnly), std::invalid_argument);         \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m89\u001b[11G\u001b[38;2;248;248;242m}\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m0\r\u001b[5C\u001b[1B 91 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m2\u001b[11G\u001b[22m\u001b[38;2;166;226;46mTEST_CASE\u001b[39m(\u001b[38;2;230;219;116m\"Paths: the application name is one relative path component\"\u001b[39m)\r\u001b[7C\u001b[1B\u001b[2m3\u001b[11G\u001b[22m{\u001b[13G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 94 \u001b[13G\u001b[22m\u001b[38;2;166;226;46mconst\u001b[19G\u001b[38;2;249;38;114mauto\u001b[24G\u001b[39menvironment\u001b[36G=\u001b[38G\u001b[38;2;166;226;46mEnvironment\u001b[39m({{\u001b[38;2;230;219;116m\"HOME\"\u001b[39m,\u001b[60G\u001b[38;2;230;219;116m\"/home/pilot\"\u001b[39m}});\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Running \u001b[1m2\u001b[22m shell commands\u001b[38;2;153;153;153m · 17s\u001b[39m…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ ./scripts/format-check.sh 2>&1 | tail -3\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?2