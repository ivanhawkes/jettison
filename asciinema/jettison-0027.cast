[0.016, "o", "\u001b[?25l\u001b[H\u001b[12G\u001b[38;2;248;248;242m\u001b[48;2;2;40;0mt` suite\u001b[21Gsends\u001b[27Ga session a mes\u001b[43Gage,\u001b[48Gcloses it, polls\u001b[65Guntil it is no longer\u001b[87Gclosing, and\u001b[100Gits client\u001b[111Ghas\r\u001b[11C\u001b[1B the message and\u001b[29Gthe reason. |     \u001b[48G      \u001b[55G   \u001b[59G     \u001b[65G     \u001b[71G  \u001b[74G  \u001b[77G  \u001b[80G      \u001b[87G        \u001b[96G   \u001b[100G   \u001b[104G      \u001b[111G   \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m417\u001b[12G\u001b[38;2;248;248;242m| One XDG directory resolved\u001b[41Galone\u001b[47G|\u001b[49GStage\u001b[55G5\u001b[57Greview\u001b[64G|\u001b[66G`ResolvePaths`\u001b[81Gresolves\u001b[90Gall\u001b[94Gfour\u001b[99Gdirectories,\u001b[112Gso\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;248;248;242m a program w\u001b[25Giting only configuration needed\u001b[57GHOME or every XDG variabl\u001b[83G. **Done**\u001b[94G2026-11-25: `R\u001b[110Golve\r\u001b[11C\u001b[1BP\u001b[14Gth`, one\u001b[23Gdirectory, needing HOME \u001b[49Gly wh\u001b[55Gn\u001b[57Gits own\u001b[65Gvariable is not absolute. | Met: the `platform` s\r\u001b[11C\u001b[1Bui\u001b[15Ge resolves configuration from its variable alone and refuses the c\u001b[82Gche with\u001b[91Gneither. |\u001b[102G          \u001b[113G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m418\u001b[12G\u001b[38;2;248;248;242m    \u001b[17G        \u001b[26G             \u001b[40G    \u001b[45G   \u001b[49G        \u001b[58G     \u001b[64G   \u001b[68G       \u001b[76G   \u001b[80G     \u001b[86G    \u001b[91G        \u001b[100G \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 419 \u001b[22m Manifest's W18, W11 and W19 needed no engine edit, and later W12, W13 and W14 (2026-11-23), competitiv\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22me\u001b[K\r\u001b[6C\u001b[1B\u001b[2m420\u001b[12G\u001b[22mprocurement,\u001b[25Gregional\u001b[34Ggovernance\u001b[45Gand\u001b[49Gthe\u001b[53Gclose\u001b[59Gof\u001b[62Gits\u001b[66GStage\u001b[72G4,\u001b[75Gon\u001b[78Gthe\u001b[82Gpin\u001b[86G`14fc23a`.\u001b[97GIts\u001b[101GR01\r\u001b[8C\u001b[1B\u001b[2m1\u001b[12G\u001b[22m(2026-11-24), the s\u001b[32Gve and compatibility\u001b[54Gontract, a planning task, needed none either and names\u001b[109Gno\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+26\u001b[38;2;153;153;153m, ran \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEngine\u001b[10Gcommit\u001b[17G\u001b[38;2;177;185;249m6c4e9ca\u001b[25G\u001b[39mis\u001b[28Gin.\u001b[32GNext,\u001b[38GManifest:\u001b[48Gmove\u001b[53Gits\u001b[57GSDK\u001b[61Gpin\u001b[65Gto\u001b[68Git,\u001b[72Gthen\u001b[77Gthe\u001b[81GManifest\u001b[90Gfixes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m5\u001b[13G\u001b[22mshell\u001b[19Gcommands…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ sed -n 1,40p ../manifest/source/external/CMakeLists.txt; grep -n JETTISON_SOURCE_DIR \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153m../manifest/CMakePresets.json ../manifest/dev\u001b[52Gnv.nix .\u001b[61G/manif\u001b[68Gst/scripts/ci.sh\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
