[0.083, "o", "\u001b[?25l\u001b[H  \u001b[1mRelease measurements\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌─────────────────────────────────────┬───────────┬────────┬─────────┐\u001b[K\r\u001b[2C\u001b[1B│\u001b[6G    \u001b[41G│\u001b[43GNo\u001b[46Gplayer\u001b[53G│\u001b[56GOne\u001b[62G│\u001b[65GFour\u001b[72G│\r\u001b[2C\u001b[1B├─────────────────────────────────────┼───────────┼────────┼─────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GSave size                           │ 475 KB    │ 538 KB │ 741 KB  │\u001b[K\r\u001b[2C\u001b[1B├─────────────────────────────────────┼───────────┼────────┼─────────┤\u001b[K\r\u001b[2C\u001b[1B│\u001b[5GTime to serialise\u001b[23Gthe save  \u001b[34G       │ 6.0 ms    │ 6.5 ms │ 10\u001b[67G9 ms │\u001b[K\r\u001b[2C\u001b[1B├─────────────────────────────────────┼───────────┼────────┼─────────┤\r\u001b[2C\u001b[1B│\u001b[5GClean\u001b[11Gstop (step, snapshot, backup) │ 58 ms \u001b[53G│\u001b[55G59\u001b[58Gms\u001b[62G│\u001b[64G66\u001b[67Gms\u001b[72G│\r\u001b[2C\u001b[1B├─────────────────────────────────────┼───────────┼────────┼─────────┤\r\u001b[2C\u001b[1B│ Recovery fr\u001b[18G the snapshot\u001b[41G│\u001b[43G53\u001b[46Gms\u001b[53G│\u001b[55G53\u001b[58Gms\u001b[62G│\u001b[64G56\u001b[67Gms\u001b[72G│\r\u001b[2C\u001b[1B└─────────────────────────────────────┴───────────┴────────┴─────────┘\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe 30-second\u001b[17Gsave\u001b[22Gto\u001b[25Gdisk\u001b[30Gtakes\u001b[36Gabout\u001b[42G11\u001b[45Gms\u001b[48Gon\u001b[51Gthe\u001b[55Ggame\u001b[60Gloop.\u001b[66GFour\u001b[71Gplayers\u001b[79Gis\u001b[82Gthe\u001b[86Gmost\u001b[91Gthe\u001b[95Gtrading\u001b[103Gscenario\u001b[112Gholds,\r\u001b[2C\u001b[1Bbecause\u001b[11Gits\u001b[15Gstarting\u001b[24Gstation's\u001b[34Glife\u001b[39Gsupport\u001b[47Ghas\u001b[51Groom\u001b[56Gfor\u001b[60Gonly\u001b[65Gfour\u001b[70Gships.\u001b[77GSo\u001b[80Gthe\u001b[84Glarger\u001b[91Gworlds\u001b[98Gearlier\u001b[106Gestimates\r\u001b[1B \u001b[3Gguessed at couldn't\u001b[23Gbe built or measured.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCI\r\u001b[1B\u001b[22m \u001b[3G- Jettison \u001b[38;2;177;185;249m84b8eed\u001b[39m: builds \u001b[38;2;177;185;249mclang-headless\u001b[39m with warnings\u001b[59Gas\u001b[62Gerrors,\u001b[70Gthen\u001b[75Gruns\u001b[80Gthe\u001b[84Gsmoke\u001b[90Gtest\u001b[95Gon\u001b[98Gsoftware\u001b[107GVulkan.\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
