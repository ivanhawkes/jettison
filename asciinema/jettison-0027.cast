[0.018, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mTwo more checks it was running:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- A syml\u001b[14Gnk in a token\u001b[28Gfile's\u001b[35Gpath\u001b[40Gleft\u001b[45Gthe\u001b[49Gother\u001b[55Gfile\u001b[60Gintact.\r\u001b[2C\u001b[1B \u001b[5G- It replaced the world's \u001b[38;2;177;185;249msnapshots\u001b[41G\u001b[39mdirectory\u001b[51Gwith\u001b[56Ga\u001b[58Gsymlink\u001b[66Gto\u001b[69Ga\u001b[71Gfolder\u001b[78Goutside.\u001b[87GThe\u001b[91Gserver\u001b[98Gwrote\u001b[104Ga\u001b[106G474\u001b[110GKB\u001b[113Gsnapshot\r\u001b[4C\u001b[1B \u001b[7Gthrough it, and th\u001b[26G prob\u001b[35G\u001b[38;2;177;185;249moriginal_retained False\u001b[39m sugges\u001b[66Gs\u001b[68Gsomething\u001b[78Galready\u001b[86Gin\u001b[89Gthat\u001b[94Gfolder\u001b[101Gdidn't\u001b[108Gsurvive.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BI\u001b[7Ghaven't\u001b[15Gjudged the snapshots result. Planting a symlink inside the world m\u001b[83Gns\u001b[86Galready\u001b[94Ghaving\u001b[101Gaccess\u001b[108Gto its\u001b[K\r\u001b[4C\u001b[1Bprivate\u001b[13Gdirectory,\u001b[24Gso\u001b[27GI\u001b[29Gdoubt\u001b[35Git's\u001b[40Ga\u001b[42Greal\u001b[47Gfinding,\u001b[56Gbut\u001b[60GCodex\u001b[66Gnever\u001b[72Gwrote\u001b[78Gone\u001b[82Gup.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy sa\u001b[9Ged notes say not to\u001b[29Greword \u001b[37Ghe\u001b[40Gprompt\u001b[47Gto get past the filt\u001b[68Gr with\u001b[75Gut\u001b[78Gasking you.\u001b[90GSo\u001b[93Ghow\u001b[97Gshould\u001b[104GI\u001b[106Ggo\u001b[109Gon?\r\u001b[2C\u001b[1B1.\u001b[6GRetry\u001b[12Ground\u001b[18G6\u001b[20Glater\u001b[26Gwith\u001b[31Gthe\u001b[35Gsame\u001b[40Gprompt.\r\u001b[2C\u001b[1B2.\u001b[6GLet me reword the brief to drop the \"reach … through\u001b[59G\u001b[38;2;177;185;249m..\u001b[39m or a syml\u001b[72Gnk\" request,\u001b[85Gwhich is the likely trigger.\r\u001b[2C\u001b[1B3\u001b[6GStop here and\u001b[20Gt\u001b[22Gk\u001b[24G round\u001b[31G5's\u001b[35Gfix\u001b[39Gs as checked\u001b[52Gby\u001b[55Gthe\u001b[59Gpartial\u001b[67Gevidence\u001b[76Gabove.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 29m 27s · done 9:44 am\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m3. Writing symlinks to an outside folder needs access to the save folder anyway, it's not a real threat. Let's finish\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mup here.\u001b[39m                                                                                                              \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Working…\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.016, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5G- A symlink in a token file's path\u001b[40Gleft\u001b[45Gthe\u001b[49Gother\u001b[55Gfile\u001b[60Gintact.\r\u001b[6C\u001b[1BIt replaced the world's \u001b[38;2;177;185;249msnapshots\u001b[39m directory with a symlink to\u001b[69Ga\u001b[71Gfolder\u001b[78Goutside.\u001b[87GThe\u001b[91Gserver\u001b[98Gwrote\u001b[104Ga\u001b[106G474\u001b[110GKB\u001b[113Gsnapshot\r\u001b[4C\u001b[1B \u001b[7Gthrough it,\u001b[19Gand\u001b[23Gthe probe's \u001b[38;2;177;185;249moriginal_retained False\u001b[39m suggests something\u001b[78Galrea\u001b[84Gy in that folde\u001b[100G didn't survive.\u001b[K\r\u001b[6C\u001b[1B\u001b[K\r\u001b[4C\u001b[1BI\u001b[7Ghaven't\u001b[15Gjudged\u001b[22Gthe\u001b[26Gsnapshots\u001b[36Gresult.\u001b[44GPlanting\u001b[53Ga\u001b[55Gsymlink\u001b[63Ginside\u001b[70Gthe\u001b[74Gworld\u001b[80Gmeans\u001b[86Galready\u001b[94Ghaving\u001b[101Gaccess\u001b[108Gto\u001b[111Gits\r\u001b[4C\u001b[1Bprivate directory, so I doub\u001b[34G it'\u001b[39G a rea\u001b[46G finding, but Codex never wrote one up.\u001b[86G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMy\u001b[6Gsaved\u001b[12Gnotes\u001b[18Gsay\u001b[22Gnot\u001b[26Gto\u001b[29Greword\u001b[36Gthe\u001b[40Gprompt\u001b[47Gto\u001b[50Gget\u001b[54Gpast\u001b[59Gthe\u001b[63Gfilter\u001b[70Gwithout\u001b[78Gasking\u001b[85Gyou.\u001b[90GSo\u001b[93Ghow\u001b[97Gshould\u001b[104GI\u001b[106Ggo\u001b[109Gon?\r\u001b[2C\u001b[1B1.\u001b[6GRetry\u001b[12Gr\u001b[14Gund\u001b[18G6 later\u001b[26Gwith the sam\u001b[46G.\u001b[K\r\u001b[2C\u001b[1B2\u001b[6GL\u001b[9G me reword\u001b[20Gthe brief to drop the \"reach\u001b[49G…\u001b[51Gthrough\u001b[59G\u001b[38;2;177;185;249m..\u001b[62G\u001b[39mor\u001b[65Ga\u001b[67Gsymlink\"\u001b[76Grequest,\u001b[85Gwhich\u001b[91Gis\u001b[94Gthe\u001b[98Glikely\u001b[105Gtrigger.\r\u001b[2C\u001b[1B3\u001b[6GStop he\u001b[15G an\u001b[21Gake \u001b[26Gound 5's fixes as checked by the\u001b[59Gpartial\u001b[67Gevide\u001b[73Gce\u001b[76Gabov\u001b[81G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 29m 27s · done 9:44 am\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255m3. Writing symlinks to an outside folder needs access to the save folder anyway, it's not a real threat. Let's finish\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mup\u001b[6Ghere.\u001b[39m                                                                                                             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning\u001b[11Gcd\u001b[14G'/home/ivan/projects/manifest'\u001b[45G&&\u001b[48G./scripts/fo…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd '/home/ivan/projects/manifest' && ./scripts/format-check.sh 2>&1 | tail -2\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
