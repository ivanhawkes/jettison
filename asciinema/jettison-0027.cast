[0.021, "o", "\u001b[?25l\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/proj\u001b[17Gcts/manife\u001b[28Gt/docs/coding-standards.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[2m29\u001b[11G\u001b[22mThe\u001b[15Gdevelopment\u001b[27Gshell\u001b[33Gand\u001b[37Gthe\u001b[41GSDK\u001b[45Gpin\u001b[49Gmove\u001b[54Gtogether\u001b[63G([\u001b[38;2;230;219;116mD-006\u001b[39m](decision-ledger.md),\r\u001b[5C\u001b[1B\u001b[2m 30 \u001b[22m [\u001b[38;2;230;219;116mD-054\u001b[39m](decision-ledger.md#d-054)). Do not add a second version of an engine dependency.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 31 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 32 -\u001b[38;2;248;248;242mClang-tidy runs in CI and is opt-in locally ([D-007](decision-ledger.md)), and build                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 32 +\u001b[38;2;248;248;242mClang-tidy is opt-in locally (`--tidy`) and runs at the gate before a push, not in CI                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 33 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-007\u001b[38;2;248;248;242m](decision-ledger.md), [\u001b[38;2;230;219;116mD-116\u001b[38;2;248;248;242m](decision-ledger.md#d-116)), and build                            \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m4\u001b[11G\u001b[22mconcurr\u001b[19Gncy i\u001b[26Gset per mach\u001b[41G ([\u001b[38;2;230;219;116mD-051\u001b[39m](decision-ledger.md#d-051)).\r\u001b[5C\u001b[1B\u001b[2m 35 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 36 \u001b[11G\u001b[22m## Differences from\u001b[31Gthe\u001b[35Gengine's\u001b[44Grules\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRunning \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[2C\u001b[1B⎿\u001b[6G$ cd ../manifest && grep -n \"d\u001b[37Gvenv\\|dire\u001b[48Gv\" .gitignor\u001b[61G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
