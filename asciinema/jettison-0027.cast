[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[17B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m❯ /update-config              Change settings: hooks, permissions, environment variables\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /ponytail:ponytail-audit    (ponytail) Quality audit of a whole repo: bugs, security holes, what breaks under real\r\u001b[1B\u001b[39m \u001b[3G                            \u001b[33G\u001b[38;2;153;153;153mload, risky code without tests, slow paths, and what to delete, merge or split. Ranke…\r\u001b[2C\u001b[1B  /statusline                 Set up the status line\r\u001b[2C\u001b[2B\u001b[39m/\u001b[K\r\u001b[38C\u001b[3B\u001b[K\u001b[27;1H\u001b[24;4H\u001b[?25h"]
[0.349, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[17B\u001b[38;2;177;185;249m❯ /\u001b[1mc\u001b[22md                         Move this session to a new working dire\u001b[1mc\u001b[22mtory\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1mc\u001b[22m\u001b[38;2;153;153;153mopy                       \u001b[39m\u001b[1mC\u001b[22m\u001b[38;2;153;153;153mopy the last response to clipboard (/copy 2 for the one before)\r\u001b[5C\u001b[1B\u001b[39m\u001b[1mc\u001b[22m\u001b[38;2;153;153;153mlear                  \u001b[33GStart \u001b[40G new session with\u001b[58Gempty \u001b[39m\u001b[1mc\u001b[66G\u001b[22m\u001b[38;2;153;153;153mntext; loops carry over, and the old one \u001b[108Gtays in\u001b[39m\u001b[K\r\u001b[32C\u001b[1B\u001b[38;2;153;153;153m/resume\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[1mc\u001b[22m\u001b[38;2;153;153;153molor     \u001b[37Gthe prompt bar \u001b[39m\u001b[1mc\u001b[22m\u001b[38;2;153;153;153molor for this session\r\u001b[3C\u001b[2B\u001b[39mc\u001b[27;1H\u001b[24;5H\u001b[?25h"]
[0.121, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[17B\u001b[38;2;177;185;249m\u001b[1ml\u001b[22mear\u001b[33GStart a new \u001b[46Gession with empty context; l\u001b[75Gops carry over, and the old one stays in\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;177;185;249m/resume\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[1ml\u001b[22m\u001b[38;2;153;153;153maude-api\u001b[33GBuild\u001b[40Gnd debug apps that use the \u001b[39m\u001b[1mCl\u001b[22m\u001b[38;2;153;153;153maude API\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m  /\u001b[39m\u001b[1mcl\u001b[22m\u001b[38;2;153;153;153maude-in-chrome           Let \u001b[39m\u001b[1mCl\u001b[22m\u001b[38;2;153;153;153maude browse and interact with pages in your Chrome\r\u001b[5C\u001b[1Bc\u001b[8Gde-review\u001b[33G3 free /ultrareview · Review\u001b[64Ge current diff or a PR for bugs\r\u001b[4C\u001b[2B\u001b[39ml\u001b[27;1H\u001b[24;6H\u001b[?25h"]
[0.084, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[17B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m❯ /\u001b[1mcle\u001b[22mar                      Start a new session with empty context; loops carry over, and the old one stays in\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;177;185;249m/resume\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mcode-review     \u001b[33G3 free /ultrareview ·\u001b[55GReview \u001b[63Ghe current d\u001b[76Gff \u001b[80Gr a PR for bugs\r\u001b[5C\u001b[1Bsimplify   \u001b[33G\u001b[39m\u001b[1mCle\u001b[22m\u001b[38;2;153;153;153man up the changed code without changing behavior\u001b[39m\u001b[K\r\u001b[5C\u001b[2Be\u001b[27;1H\u001b[24;7H\u001b[?25h"]
