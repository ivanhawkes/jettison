[0.017, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[11G\u001b[38;2;248;248;242mon\u001b[14Gpin\u001b[18G`13c1bec`.\u001b[29GThe\u001b[33G`host`\u001b[40Gsuite\u001b[46Gpins\u001b[51Gthe\u001b[55Gstate\u001b[61Ginventory\u001b[71Gto\u001b[74Gthe\u001b[78Gnames\u001b[84Ga\u001b[86Gworld's\u001b[94Gsave\u001b[99Glists\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m7\u001b[11G\u001b[38;2;248;248;242m(`SimWorld::ComponentName\u001b[37G`,\u001b[40G`ServiceNames`). A world opened under\u001b[78Goth\u001b[82Gr\u001b[84Gcontent is refused naming\u001b[110Gthe\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m8\u001b[11G\u001b[38;2;248;248;242mfirst definition tha\u001b[32G differs, and a pruned request sequ\u001b[69Gce\u001b[72Gis held too\u001b[84Gold acros\u001b[95Ga load.\u001b[103GThe   \u001b[110G   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m9\u001b[11G\u001b[38;2;248;248;242mbundle passed \u001b[28GLythir and in\u001b[42GUbuntu 24.04\u001b[55Gand Debian 13. The Release figures are recorded: a flush\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m10\u001b[11G\u001b[38;2;248;248;242mhol\u001b[15Gs the \u001b[23Grver's loop\u001b[36Gbout 11 ms, a snapshot\u001b[59Gabout 60. Sav\u001b[73Gs ar\u001b[78G to\u001b[82Gleave the step's thread\u001b[106G     \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[11G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-115\u001b[38;2;248;248;242m](decision-ledger.md#d-115)), not yet built. The later workstreams (L01 onwards) wait until the \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242muser has played the first loop for a day or two; W22 waits for the first larger hull.                  \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242m    \u001b[16G   \u001b[20G      \u001b[27G   \u001b[31G     \u001b[37G    \u001b[42G   \u001b[46G \u001b[48G   \u001b[52G  \u001b[55G    \u001b[60G   \u001b[64G     \u001b[70G   \u001b[74G   \u001b[78G     \u001b[84G      \u001b[91G     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 14 \u001b[22m R08 is done: [\u001b[38;2;230;219;116mreconnect and recovery\u001b[39m](stage-5-recovery-plan.md#reconnect-and-recovery-r08-2026-11-24),\u001b[K\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22mon p\u001b[16Gn\u001b[18G`d9f565c` with no engine edit, in t\u001b[54Gsts al\u001b[61Gn\u001b[63G. The `remot\u001b[76G` suite crash\u001b[90Gs a jou\u001b[98Gnalled server\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22mu\u001b[13Gder three clients and r\u001b[37Gcon\u001b[42Gcts \u001b[47Ghem:\u001b[52Gwha\u001b[56G the journal\u001b[69Gkept is answered from the ledger, what it\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitting\u001b[14Gthe\u001b[18Gclose,\u001b[25Gthen\u001b[30Ggating\u001b[37Git\u001b[40Gin\u001b[43G\u001b[38;2;177;185;249mbuild/gate-tree\u001b[59G\u001b[39mwith\u001b[64G\u001b[38;2;177;185;249m--tidy\u001b[71G\u001b[39mat\u001b[74G24\u001b[77Gworkers.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mMaking\u001b[10G\u001b[1m1\u001b[12G\u001b[22mscratchpad\u001b[23Gedit\u001b[28G\u001b[38;2;56;166;96m+19\u001b[39m,\u001b[33Grunning\u001b[41G\u001b[1m4\u001b[43G\u001b[22mshell\u001b[49Gcommands…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ git -C ../manifest/build/gate-tree checkout -q --detach '65cc2ed84e025d7406f183aca346ed63241547a7'\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
