/usr/bin/env bash\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 2 -\u001b[38;2;248;248;242m# The dedicated server unattended, killed and stopped: an administrator's token issued, \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mserver\u001b[48;2;61;1;0m      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2 +\u001b[38;2;117;113;94m# The dedicated server unattended, killed and stopped: an administrator's token issued, \u001b[48;2;4;71;0mand\u001b[48;2;2;40;0m \u001b[48;2;4;71;0manother\u001b[38;2;248;248;242m\u001b[48;2;2;40;0m     \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m3\u001b[10G\u001b[38;2;117;113;94m# with only XDG_CONFIG_HOME set; the server\u001b[38;2;248;248;242m                             \r\u001b[6C\u001b[1B\u001b[39m\u001b[49m\u001b[2m4\u001b[10G\u001b[22m\u001b[38;2;117;113;94m# started on a new world and an ephemeral port with no client, flushing its journal every second and\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;117;113;94m# writing a snapshot every two, left to step and killed outright; started again on the world, it takes\r\u001b[6C\u001b[1B\u001b[39m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;2;117;113;94m# up at a step its journal had flushed, steps on and is stopped with SIGINT, which writes a snapshot\r\u001b[2C\u001b[2B\u001b[39mSearching\u001b[13Gfor \u001b[1m1\u001b[19G\u001b[22mpattern, reading\u001b[36G\u001b[1m1\u001b[38G\u001b[22mfile,\u001b[44Grunning\u001b[52G\u001b[1m1\u001b[54G\u001b[22mshell\u001b[60Gcommand…\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m$ t\u001b[10Gil -c 600 build/gat\u001b[30G.log\u001b[39m\u001b[K\r\u001b[18C\u001b[2B\u001b[38;2;153;153;153m3\r\u001b[20C\u001b[6B\u001b[38;2;0;204;204m1\u001b[38G\u001b[38;2;153;153;153m · esc to inter\u001b[54Gupt · ← 1 agent · ↓ to manage\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
