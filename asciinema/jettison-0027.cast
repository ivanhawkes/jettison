\u001b[29Gcmake\u001b[35G--build\u001b[43G--preset\u001b[52Gclang-de…\r\u001b[1C\u001b[1B\u001b[38;2;153;153;153m ⎿  $ cd ../manifest && cmake --build --preset clang-debug -j24 2>&1 | grep -E \"error|FAILED\" | head; ctest --test-dir \r\u001b[1B\u001b[39m     \u001b[38;2;153;153;153mbuild/clang-d\u001b[20Gbug -j24 2>&1 | tail \u001b[42G6; clang-tidy -p build/clang-debug sourc\u001b[83G/game/content/src/ContentIden\u001b[113Gity.cpp\r\u001b[5C\u001b[1Bsource/g\u001b[15Gme/host/src/Journal.cpp source/g\u001b[48Gme/host/tests/HostTests.cpp…\u001b[77G(1m 41s · 7 li\u001b[92Ges)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m·\u001b[3G\u001b[38;2;223;134;102mDoodling…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Debug suites, tidy, format check · 21m 22s · ↓\u001b[61G40.4k tokens)\r\u001b[1B  ⎿  Tip: Name sessions with /rename to\u001b[41Gfind them in /resume\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0027 ─\r\u001b[1B\u001b[38;2;153;153;153m❯ \u001b[39mSaves should be decoupled from that loop and thread in future. We don't want to have frame stutter because a save\u001b[K\r\u001b[1B  too\u001b[K\u001b[27;1H\u001b[24;6H\u001b[?25h"]
