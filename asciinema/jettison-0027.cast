[0.037, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/docs/coding-standards.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 29 \u001b[22m The d\u001b[17Gvelopment \u001b[28Ghell and the SDK pin move together\u001b[63G([\u001b[38;2;230;219;116mD-006\u001b[39m](decision-ledger.md),\r\u001b[1B     \u001b[2m 30 \u001b[22m [\u001b[38;2;230;219;116mD-054\u001b[39m](decision-ledger.md#d-054)).\u001b[47GDo\u001b[50Gnot\u001b[54Gadd\u001b[58Ga\u001b[60Gsecond\u001b[67Gversion\u001b[75Gof\u001b[78Gan\u001b[81Gengine\u001b[88Gdependency.\r\u001b[6C\u001b[1B\u001b[2m31\u001b[11G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 32 -\u001b[38;2;248;248;242mClang-tidy runs in CI and is opt-in locally ([D-007](decision-ledger.md)), and build                   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 32 +\u001b[38;2;248;248;242mClang-tidy is opt-in locally (`--tidy`) and runs at the gate before a push, not in CI                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 33 +\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mD-007\u001b[38;2;248;248;242m](decision-ledger.md), [\u001b[38;2;230;219;116mD-116\u001b[38;2;248;248;242m](decision-ledger.md#d-116)), and build                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 34 \u001b[22m concurrency is set per machine ([\u001b[38;2;230;219;116mD-051\u001b[39m](decision-ledger.md#d-051)).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 35 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m6\u001b[11G\u001b[22m## Diff\u001b[19Grence\u001b[26Gfrom the eng\u001b[41G's rules\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BRan \u001b[1m2\u001b[22m shell commands\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[38;2;177;185;249m.devenv\u001b[11G\u001b[39mis ignored, \u001b[26G \u001b[38;2;177;185;249mstage-bundle.sh\u001b[43G\u001b[39mran\u001b[47Gclean\u001b[53Gin\u001b[56Gthis\u001b[61Gcheckout\u001b[70Gunder\u001b[76Gdevenv.\u001b[84GCommitting\u001b[95Gthe\u001b[99GCI\u001b[102Gchange\u001b[109Gin\u001b[112Geach\r\u001b[2C\u001b[1Brepository.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
