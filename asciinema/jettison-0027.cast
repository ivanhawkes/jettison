[0.030, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mHow Codex proved it:\u001b[24G\u001b[22m\u001b[38;2;177;185;249mround5-backup-alias.py\u001b[39m:\u001b[48Grestore,\u001b[57Gserve\u001b[63Gand\u001b[67Gstop\u001b[72Gexited\u001b[79G0,\u001b[82Gand\u001b[86Gthe\u001b[90Gworld\u001b[96Gdirectory\u001b[106Gwas\u001b[110Ggone.\r\u001b[2C\u001b[1B\u001b[1mFix I'd make:\u001b[22m Refuse\u001b[24Ga world insid\u001b[38G \u001b[40Ghe backups\u001b[51Gdirectory as well\u001b[69Gas backups\u001b[80Ginside the world.\u001b[98GAlso\u001b[103Grefuse\u001b[110Gany\r\u001b[4C\u001b[1Bbackup\u001b[12Gwh\u001b[15Gse target resolves to the world\u001b[47Gbefore \u001b[38;2;177;185;249mremove_all\u001b[39m runs.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[1m#:\u001b[6G\u001b[22mF13\r\u001b[2C\u001b[1B\u001b[1mFinding:\u001b[22m \u001b[1mA symlink can get backups inside the world.\u001b[56G\u001b[22m\u001b[38;2;177;185;249mweakly_canonical\u001b[73G\u001b[39mstops\u001b[79Gresolving\u001b[89Gat\u001b[92Gthe\u001b[96Gfirst\u001b[102Gfolder\u001b[109Gthat\r\u001b[4C\u001b[1Bdoesn't\u001b[13Gexist\u001b[19Gyet.\u001b[24GSo\u001b[27G\u001b[38;2;177;185;249m<base>/missing/../link/backups\u001b[39m,\u001b[59Gwhere\u001b[65G\u001b[38;2;177;185;249mlink\u001b[70G\u001b[39mpoints\u001b[77Ginto\u001b[82Gthe\u001b[86Gworld,\u001b[93Gpasses\u001b[100Gthe\u001b[104Gcheck,\u001b[111Gand\u001b[115Gthe\r\u001b[1B \u001b[3G  backups land in \u001b[38;2;177;185;249mworld/backups\u001b[39m.\u001b[K\r\u001b[1B  \u001b[1mHow Codex proved it:\u001b[22m \u001b[38;2;177;185;249mround5-paths.py\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFix I'd make:\u001b[22m Cr\u001b[20Gate the \u001b[29Ga\u001b[31Gkups directory first, then check with \u001b[38;2;177;185;249mcanonical\u001b[79G\u001b[39mon\u001b[82Gboth\u001b[87Gpaths,\u001b[94Gin\u001b[97Gboth\u001b[102Gdirections.\u001b[114GThat\r\u001b[4C\u001b[1Bfix\u001b[9Galso\u001b[14Gcovers\u001b[21GF12's\u001b[