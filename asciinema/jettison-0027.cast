[1.874, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39mBackground\u001b[14Gcommand\u001b[22G\"Run\u001b[27GStage\u001b[33G5\u001b[35Gcross-review\u001b[48Ground\u001b[54G5\"\u001b[57Gcompleted\u001b[67G(exit\u001b[73Gcode\u001b[78G0)\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRead \u001b[1m2\u001b[22m files, ran \u001b[1m1\u001b[22m shell command · \u001b[38;2;255;107;128m22 failed\u001b[38;2;153;153;153m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRound\u001b[9G5\u001b[11Gfinished\u001b[20Gand\u001b[24Git\u001b[27Gdoes\u001b[32Gnot\u001b[36Gapprove.\u001b[45GCodex\u001b[51Gconfirmed\u001b[61GF8,\u001b[65GF10\u001b[69Gand\u001b[73GF11\u001b[77Gare\u001b[81Gfixed,\u001b[88Gthen\u001b[93Gfound\u001b[99Gthree\u001b[105Gnew\u001b[109Gblockers.\u001b[119GIt\r\u001b[1B \u001b[3Gleft the track\u001b[20Gfiles unchanged; its r\u001b[43Gproductions a\u001b[57Ge in \u001b[38;2;177;185;249m../manifest/build/reviews/stage-5/scratch/\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m#:\u001b[6G\u001b[22mF12\r\u001b[2C\u001b[1B\u001b[1mFinding:\u001b[12GA backup can delete the live world.\u001b[48G\u001b[22mThe\u001b[52Glocation\u001b[61Gcheck\u001b[67Gallows\u001b[74Gthe\u001b[78Gworld\u001b[84Gto\u001b[87Gsit\u001b[91Ginside\u001b[98Gthe\u001b[102Gbackups\r\u001b[2C\u001b[1B  directory. If the world's folder happens to b\u001b[52Gnamed \u001b[38;2;177;185;249m<world-id>.<next-batch>\u001b[39m, the\u001b[87Gnext backup's target is\u001b[111Gthe\r\u001b[4C\u001b[1Bwo\u001b[8Gld itself.\u001b[19G\u001b[38;2;177;185;249mremove_all\u001b[39m then deletes it, lock\u001b[52Gincluded, and shutdown still reports success.\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow Codex proved it:\u001b[22m \u001b[38;2;177;185;249mround5-backup-alias.py\u001b[39m: restore, s\u001b[59Grve and stop exited 0, and \u001b[87Ghe world directory\u001b[106Gwas\u001b[110Ggone.\r\u001b[2C\u001b[1B\u001b[1mFix\u001b[7GI'\u001b[10G make:\u001b[22m Refuse\u001b[24Ga world inside the backups di\u001b[55Gctory as well as\u001b[72Gbackups insi\u001b[85Ge the world. Also \u001b[104Gefuse\u001b[110Gany\u001b[K\r\u001b[2C\u001b[1B  backup whose targ\u001b[23Gt reso\u001b[30Gves to the world before \u001b[38;2;177;185;249mremove_all\u001b[39m runs.\u001b[K\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1m#:\u001b[22m F13\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinding:\u001b[12GA symlink can get backups inside the world.\u001b[56G\u001b[22m\u001b[38;2;177;185;249mweakly_canonical\u001b[73G\u001b[39mstops\u001b[79Gresolving\u001b[89Gat\u001b[92Gthe\u001b[96Gfirst\u001b[102Gfolder\u001b[109Gthat\r\u001b[2C\u001b[1B  doesn't exist yet. So \u001b[38;2;177;185;249m<base>/missing/../link/backups\u001b[39m, where \u001b[38;2;177;185;249mli\u001b[68Gk\u001b[39m poin\u001b[75Gs into the world, passes \u001b[101Ghe ch\u001b[107Gck, \u001b[112Gnd\u001b[115Gthe\r\u001b[4C\u001b[1Bbackups\u001b[13Gland in \u001b[38;2;177;185;249mworld/backups\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow Codex proved it:\u001b[22m \u001b[38;2;177;185;249mround5-paths.py\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
