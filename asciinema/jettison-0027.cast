[0.248, "o", "\u001b[?25l\u001b[H\u001b[3G│ Time to serialise the save          │ 6.0 ms    │ 6.5 ms │ 10.9 ms │\r\u001b[2C\u001b[1B├─────────────────────────────────────┼───────────┼────────┼─────────┤\r\u001b[2C\u001b[1B│ Clean stop (step, snapshot, backup) │ 58 ms     │ 59 ms  │ 66 ms   │\r\u001b[2C\u001b[1B├─────────────────────────────────────┼───────────┼────────┼─────────┤\r\u001b[2C\u001b[1B│ Recovery from the snapshot          │ 53 ms     │ 53 ms  │ 56 ms   │\r\u001b[2C\u001b[1B└─────────────────────────────────────┴───────────┴────────┴─────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7G30-second\u001b[17Gsave\u001b[22Gto\u001b[25Gdisk\u001b[30Gtakes\u001b[36Gabout\u001b[42G11\u001b[45Gms\u001b[48Gon\u001b[51Gthe\u001b[55Ggame\u001b[60Gloop.\u001b[66GFour\u001b[71Gplayers\u001b[79Gis\u001b[82Gthe\u001b[86Gmost\u001b[91Gthe\u001b[95Gtrading\u001b[103Gscenario\u001b[112Gholds,\r\u001b[2C\u001b[1Bbecause its starting station's life support has\u001b[51Groom for\u001b[60Gonly four ships. So the larger\u001b[91Gworlds earlier est\u001b[110Gmates\u001b[K\r\u001b[2C\u001b[1Bguessed\u001b[11Ga\u001b[13G couldn't be bu\u001b[29Glt or measured.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCI\r\u001b[2C\u001b[1B\u001b[22m- Jettison\u001b[14G\u001b[38;2;177;185;249m84b8eed\u001b[39m:\u001b[23Gbuilds\u001b[30G\u001b[38;2;177;185;249mclang-headless\u001b[45G\u001b[39mwith\u001b[50Gwarnings\u001b[59Gas\u001b[62Gerrors,\u001b[70Gthen\u001b[75Gruns\u001b[80Gthe\u001b[84Gsmoke\u001b[90Gtest\u001b[95Gon\u001b[98Gsoftware\u001b[107GVulkan.\r\u001b[4C\u001b[1BManifest\u001b[14G\u001b[38;2;177;185;249mcdde5ab\u001b[23G\u001b[39mthe environment check, then the rele\u001b[61Ge build packaged as the install bundle, \u001b[102Ghen its smoke\u001b[116Gtest\r\u001b[2C\u001b[1B \u001b[5Gon th\u001b[11G runner's Ubuntu.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe full gate, tidy included,\u001b[35Gnow\u001b[39Gruns\u001b[44Gonly\u001b[49Glocally\u001b[