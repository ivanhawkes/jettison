er;\u001b[31Gthe\u001b[35Greal\u001b[40Ghash\u001b[45Gof\u001b[48Gthat\u001b[53Gformat\u001b[60Gcommit\u001b[67Gis\u001b[70Gin\u001b[73G\u001b[38;2;177;185;249mgit log\u001b[39m,\u001b[82Gbetween\u001b[90G\u001b[38;2;177;185;249m15a0ac5\u001b[98G\u001b[39mand\u001b[102G\u001b[38;2;177;185;249m7b6a8d7\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe engine changed in three places.\u001b[41G\u001b[22m\u001b[38;2;177;185;249mSimWorld::ComponentNames\u001b[66G\u001b[39mand\u001b[70G\u001b[38;2;177;185;249mServiceNames\u001b[83G\u001b[39mnow\u001b[87Greturn\u001b[94Gcopies.\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mNet::Server::Closing\u001b[39m is new, so a stopping server can wait for its clients to\u001b[83Greceive the last replies.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mPlatform::Reso\u001b[20GvePath\u001b[39m resolve\u001b[35G one XDG directory alo\u001b[58Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mF9 changed four existing journal tests.\u001b[22m Th\u001b[48Gy expected one\u001b[63Gflush\u001b[69Gper\u001b[73G\u001b[38;2;177;185;249mAdvance\u001b[81G\u001b[39mcall,\u001b[87Gwhich\u001b[93Gwas\u001b[97Gthe\u001b[101Gbug.\u001b[106GThe\u001b[110Gfixtures'\r\u001b[2C\u001b[1B \u001b[5Gpinned state hashes did not move.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe F8/F10 fix:\u001b[22m directories\u001b[33Gare now\u001b[41Gcreated\u001b[49Gone\u001b[53Gcomponent\u001b[63Gat\u001b[66Ga\u001b[68Gtime,\u001b[74Geach\u001b[79Gmade\u001b[84Gprivate\u001b[92Gthrough\u001b[100Gthe\u001b[104Gsame\u001b[109Gpath\u001b[114Git\u001b[117Gwas\r\u001b[2C\u001b[1B \u001b[5Gcreated by. That covers \u001b[38;2;177;185;249mnew/..\u001b[39m paths and s\u001b[77Gkup \u001b[82Girectori\u001b[91Gs use it\u001b[101Goo. A side effect:\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
