[0.017, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m2\u001b[16G\u001b[38;2;248;248;242mThe TUI** retries nothing (R08), and `tes\u001b[58G-bundle.\u001b[67Gh` needs Docker\u001b[83Gand\u001b[87Gis\u001b[90Grun\u001b[94Gby\u001b[97Ghand.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m3\u001b[12G\u001b[38;2;248;248;242m-\u001b[14G**Debug\u001b[22Gfiles**:\u001b[31Ga\u001b[33Grelease's\u001b[43Gbinaries\u001b[52Gkeep\u001b[57Gtheirs,\u001b[65Gas\u001b[68GR07\u001b[72Gleft\u001b[77Gthem.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 794 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[8C\u001b[1B\u001b[49m\u001b[39m\u001b[2m5\u001b[12G\u001b[22m##\u001b[15GCommit\u001b[22Gmodel:\u001b[29Gdurable\u001b[37Gstep\u001b[42Gbatches\r\u001b[8C\u001b[1B\u001b[2m6\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 797 \u001b[12G\u001b[22mThe\u001b[16Gproposal\u001b[25Gof\u001b[28G2026-11-15,\u001b[40Gkept\u001b[45Gas\u001b[48Git\u001b[51Gwas\u001b[55Gmade.\u001b[61GIts\u001b[65Gcommit\u001b[72Gbefore\u001b[79Gexecution\u001b[89Gand\u001b[93Gits\u001b[97Gdurable\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m...\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22mStage 5 comple\u001b[28Gs when acknowledged commands\u001b[57Gs\u001b[59Grvive the tested cra\u001b[80Gh boundaries, retries\r\u001b[8C\u001b[1B\u001b[2m3\u001b[14G\u001b[22mnnot duplic\u001b[26Gte actions after r\u001b[45Gcovery,\u001b[53Gthe\u001b[57Gfull loc\u001b[66Gl loop re\u001b[76Gumes without downtime\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 984 \u001b[22m catch-up, a backup restores successfully and the declared release distribution relocates.\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 907 -\u001b[38;2;248;248;242mNo checks in this document have yet been executed.                                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2