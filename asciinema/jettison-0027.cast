\u001b[90Gworld\u001b[96Gdirectory\u001b[106Gwas\u001b[110Ggone.\r\u001b[2C\u001b[1B\u001b[1mFix I'd make:\u001b[22m Refuse a world inside the backups\u001b[51Gdirectory\u001b[61Gas\u001b[64Gwell\u001b[69Gas\u001b[72Gbackups\u001b[80Ginside\u001b[87Gthe\u001b[91Gworld.\u001b[98GAlso\u001b[103Grefuse\u001b[110Gany\r\u001b[2C\u001b[1B  backup\u001b[12Gwhose\u001b[18Gtarget\u001b[25Gresolves\u001b[34Gto\u001b[37Gthe\u001b[41Gworld\u001b[47Gbefore\u001b[54G\u001b[38;2;177;185;249mremove_all\u001b[65G\u001b[39mruns.\r\u001b[2C\u001b[1B────────────────────────────────────────\u001b[K\r\u001b[2C\u001b[1B\u001b[1m#:\u001b[22m F13\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinding:\u001b[22m \u001b[1mA symlink can get backups inside the world.\u001b[56G\u001b[22m\u001b[38;2;177;185;249mweakly_canon\u001b[69Gcal\u001b[39m stops resolving\u001b[89Gat the\u001b[96Gfirst\u001b[102Gfolder\u001b[109Gthat\r\u001b[2C\u001b[1B  doesn't exist yet.\u001b[24GSo \u001b[38;2;177;185;249m<base>/missing/../link/backups\u001b[39m, wher\u001b[65G\u001b[38;2;177;185;249mlink\u001b[39m points\u001b[77Ginto\u001b[82Gthe\u001b[86Gworld,\u001b[93Gpasses\u001b[100Gthe\u001b[104Gcheck,\u001b[111Gand\u001b[115Gthe\r\u001b[2C\u001b[1B  backups land in \u001b[38;2;177;185;249mworld/backups\u001b[39m.  \u001b[38G       \u001b[46G \u001b[76G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
