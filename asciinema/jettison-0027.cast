[0.096, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSaves run on the server\u001b[27Gloop's\u001b[34Gown\u001b[38Gthread,\u001b[46Gso\u001b[49Geach\u001b[54Gflush\u001b[60Gpauses\u001b[67Git\u001b[70Gabout\u001b[76G10.6\u001b[81Gms\u001b[84Gand\u001b[88Geach\u001b[93Ghourly\u001b[100Gsnapshot\u001b[109Gabout\u001b[115G60\u001b[118Gms,\r\u001b[2C\u001b[1Bwhich\u001b[9Gis\u001b[12Groughly\u001b[20Gfour\u001b[25Gframes\u001b[32Gthat\u001b[37Gthe\u001b[41Gloop\u001b[46Gthen\u001b[51Gcatches\u001b[59Gup.\u001b[63GThat\u001b[68Gis\u001b[71Gharmless\u001b[80Gtoday,\u001b[87Gbut\u001b[91Gthe\u001b[95Gcost\u001b[100Ggrows\u001b[106Gwith\u001b[111Gworld\r\u001b[1B \u001b[3Gsiz\u001b[8Gand disk\u001b[17Gspeed, so I'll recor\u001b[38G it as a\u001b[47Gknown\u001b[53Glimit in R09 and carry on with the\u001b[88GD\u001b[90Gbug suites.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mSaves should be decoupled from that loop and thread in future. We don't want to have frame stutter because a save \u001b[39m    \r\u001b[1B  \u001b[38;2;255;255;255mtook more\u001b[13Gtha\u001b[17G 16ms.\u001b[39m                                          \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSaves will move off the\u001b[27Gloop's\u001b[34Gthread,\u001b[42Gand\u001b[46Gserialising\u001b[58Ga\u001b[60Glarge\u001b[66Gworld\u001b[72Gneeds\u001b[78Geither\u001b[85Ga\u001b[87Gcheap\u001b[93Gstate\u001b[99Gcopy\u001b[104Gbetween\u001b[112Gsteps\u001b[118Gor\r\u001b[2C\u001b[1Bslicing,\u001b[12Gso\u001b[15GI'm\u001b[19Glogging\u001b[27Gthat\u001b[32Gagainst\u001b[40GR09\u001b[44Gas\u001b[47Gyour\u001b[52Gdecision.\u001b[62GIf\u001b[65Ga\u001b[67Gwriter\u001b[74Gthread\u001b[81Gis\u001b[84Greusable,\u001b[94GJettison\u001b