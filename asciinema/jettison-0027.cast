[0.173, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1Bnothing runs beside clang.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mJettison's gate passed (293 s). I'm pushing its \u001b[38;2;177;185;249mfeature-base\u001b[39m so Manifest's\u001b[78Gpin\u001b[82Gcan\u001b[86Gfetch\u001b[92Gthe\u001b[96Gfix.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mPushed to \u001b[1mfeature-base\u001b[22m, searched for \u001b[1m1\u001b[22m pattern \u001b[51G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mPushed. Now building Manifest on the new pin and running the\u001b[64Gsuites\u001b[71Gthe\u001b[75Gfixes\u001b[81Gtouch.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mEvery s\u001b[11Gite the fixes touch passes. Next: commit Manifest, then its\u001b[71Gfull gate, then round 2.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+29\u001b[38;2;153;153;153m, ran \u001b[1m9\u001b[22m shell commands, recalled \u001b[1m1\u001b[22m memory \r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mCommitted in Manifest as \u001b[38;2;177;185;249m4ddac45\u001b[39m.\u001b[37GIts\u001b[41Gfull\u001b[46Ggate\u001b[51G(\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m,\u001b[76G24\u001b[79Gworkers)\u001b[88Gis\u001b[91Gstarting.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m60\u001b[22m patterns, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
