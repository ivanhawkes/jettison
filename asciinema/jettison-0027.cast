[0.057, "o", "\u001b[?25l\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe pin fetches from\u001b[24GGitHub,\u001b[32Gso\u001b[35Gthe\u001b[39Gengine\u001b[46Gcommit\u001b[53Ghas\u001b[57Gto\u001b[60Gbe\u001b[63Gpushed\u001b[70Gbefore\u001b[77GManifest\u001b[86Gcan\u001b[90Gbuild\u001b[96Gon\u001b[99Git.\u001b[103GPushing\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mfeature-base\u001b[39m,\u001b[17Gas\u001b[20Gthe\u001b[24Gearlier\u001b[32Gpins\u001b[37Gwere.\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Blocked by auto mode · /permissions to review · see \u001b]8;id=1vsd2k;https://code.claude.com/docs/s/claude-code-auto-mode\u0007https://code.claude.com/docs/s/claude-code-auto-mode\u001b]8;;\u0007\r\u001b[2C\u001b[1B\u001b[39m   \u001b[2m│\u001b[22m \u001b[38;2;153;153;153mAuto mode: [Destructive or Unwanted Actions]\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe push was refused. Manifest's pin can't fetch \u001b[38;2;177;185;249m13c1bec\u001b[60G\u001b[39muntil\u001b[66Git's\u001b[71Gon\u001b[74GGitHub,\u001b[82Gso\u001b[85GI'll\u001b[90Gcarry\u001b[96Gon\u001b[99Gin\u001b[102GManifest's\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249msdk-local\u001b[13G\u001b[39mtree,\u001b[19Gwhich\u001b[25Gbuilds\u001b[32Gagainst\u001b[40Gthe\u001b[44Glocal\u001b[50Gengine,\u001b[58Gand\u001b[62Gleave\u001b[68Gthe\u001b[72Gpush\u001b[77Gto\u001b[80Gyou.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mRunning cd ../manifest && cmake --build build/sdk-local -…\u001b[62G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cd ../manifest && cmake --build build/sdk-local --target manifest_host_tests 2>&1 | grep -E \"error|FAILED\" | \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153mhead; ./build/sdk-local/bin/manifest_host_tests -tc=\"PROBE inventory\" -s 2>&1 | grep -A4 MESSAGE || find \r\u001b[1B\u001b[39m  