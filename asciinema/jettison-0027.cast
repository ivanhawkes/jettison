[0.056, "o", "\u001b[?25l\u001b[H \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 850 -\u001b[38;2;248;248;242m  }                                                                                                   \u001b[115G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 851 -\u001b[38;2;248;248;242m}                                                                                                     \r\u001b[2B\u001b[49m\u001b[39m  \u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mSave size and flush timing\u001b[30Gmeasured:\u001b[40G475\u001b[44GKB\u001b[47Gtakes\u001b[53G6.0\u001b[57Gms\u001b[60Gand\u001b[64G741\u001b[68GKB\u001b[71Gtakes\u001b[77G10.9\u001b[82Gms\u001b[85Gin\u001b[88GRelease,\u001b[97Gwith\u001b[102Geach\u001b[107Gfsync'd\u001b[115Gflush\r\u001b[2C\u001b[1Baround\u001b[10G10.6\u001b[15Gms.\u001b[19GI'm\u001b[23Grunning\u001b[31Gthe\u001b[35GDebug\u001b[41Gsuites\u001b[48Gand\u001b[52Gtidy\u001b[57Gon\u001b[60Gthe\u001b[64Gtouched\u001b[72Gunits\u001b[78Gbefore\u001b[85Gcommitting.\u001b[38;2;153;153;153m · summary\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mAre saves running on a different thread to the main game loop?\u001b[39m                                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[39m Saves run on the server loop's own thread, so each flush pauses it about 10.6 ms and each hourly snapshot about 60 ms,\r\u001b[2C\u001b[1Bwhich is roughly four frames that the loop then catches up. That is harmless today, but the cost grows with world\u001b[K\r\u001b[2C\u001b[1Bsize and disk speed, so I'll record it as a known limit in R09 and carry on with the Debug suites.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[5B\u001b[38;2;235;159;127mDoodling…\r\u001b[2C\u001b[4B\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
