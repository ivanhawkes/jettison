fest plan doc line    │\r\u001b[4C\u001b[1B  \u001b[11G     \u001b[22Gwrite, but none exists.    \u001b[50G \u001b[52G    \u001b[57G  \u001b[60G  \u001b[63G           \u001b[75G        \u001b[91G741 and the missing t\u001b[113Gsts\r\u001b[2C\u001b[1B└─────┴──────────┴────────────────────────────────────────────────────────────────────┴───────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCodex\u001b[9Gfound\u001b[15Gno\u001b[18Gfault\u001b[24Gin\u001b[27Greplay,\u001b[35Gretries,\u001b[44Gcompatibility\u001b[58Gchecks,\u001b[66Gthe\u001b[70Gworld\u001b[76Glock\u001b[81G(it\u001b[85Gtried\u001b[91Gsymlinks\u001b[100Gand\u001b[104Gother\u001b[110Gpaths)\u001b[117Gor\r\u001b[2C\u001b[1Bthe glibc 2.38\u001b[18Glimi\u001b[23G. F2 is \u001b[32G Jettison fix, so the Manifest fixes need a\u001b[76Gnew engine pin. Shall I\u001b[100Gstart on the fixes,\r\u001b[2C\u001b[1Bwith F2 in Jettison first?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GR09\u001b[11Ggate's\u001b[18Gown\u001b[22Glog\u001b[26Gwasn't\u001b[33Gsaved,\u001b[40Gso\u001b[43Gthe\u001b[47Gprompt\u001b[54Ggave\u001b[59GCodex\u001b[65GR08's\u001b[71Ggate\u001b[76Glog\u001b[80Gplus\u001b[85Gthe\u001b[89Gplan's\u001b[96Gwritten\u001b[104Grecord\u001b[111Gof\u001b[114GR09's\r\u001b[2C\u001b[1Brun. Round 2 is the last of \u001b[32Ghe two allowed;\u001b[75Ges to you\u001b[86Go settle.\u001b[96G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.061, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B  \u001b[11G       \u001b[22Gits 32\u001b[29GMiB limit.\u001b[40G   \u001b[44G        \u001b[53G   \u001b[57G        \u001b[66G    \u001b[71G       \u001b[79G  \u001b[82G     \u001b[91G        \u001b[100G               \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│     │          │ Restore checks and writes one file at a time, so it writes before  │                           │\r\u001b[4C\u001b[1BF4\u001b[11Gmajor\u001b[22Git has checked\u001b[37Gthe\u001b[42Ghol\u001b[46G backup. The plan says every checksum is \u001b[91GManifest\u001b[100G\u001b[38;2;177;185;249mJournal.cpp:619\r\u001b[4C\u001b[1B\u001b[39m  \u001b[11G     \u001b[22Gchecked b\u001b[32Gfore\u001b[41Gfirst\u001b[47Gwrite. \u001b[55G   \u001b[59G    \u001b[64G    \u001b[69G     \u001b[75G        \u001b[84G  \u001b[91G        \u001b[100G               \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│ F5  │ major    │ \u001b[38;2;177;185;249mDefaultLocations()\u001b[39m fails when only \u001b[38;2;177;185;249mXDG_CACHE_HOME\u001b[39m is missing,      │ Manifest \u001b[38;2;177;185;249mLocations.cpp:19\u001b[39m │\r\u001b[4C\u001b[1B  \u001b[11G     \u001b[22Gthough Manifest never u\u001b[46Ges the cache directory.  \u001b[72G  \u001b[75G        \u001b[91G        \u001b[100G                \r\u001b[2C\u001b[1B├─────┼──────────┼────────────────────────────────────────────────────────────────────┼───────────────────────────┤\r\u001b[2C\u001b[1B│ F6  │ major    │ The R09 checks table claims a test of an interrupted snapshot      │ Manifest plan doc line    │\r\u001b[4C\u001b[1B  \u001b[11G     \u001b[22Gwrite, but none exists.    \u001b[50G \u001b[52G    \u001b[57G  \u001b[60G  \u001b[63G           \u001b[75G        \u001b[91G741 and the missing t\u001b[113Gsts\r\u001b[2C\u001b[1B└─────┴──────────┴────────────────────────────────────────────────────────────────────┴───────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCodex\u001b[9Gfound\u001b[15Gno\u001b[18Gfault\u001b[24Gin\u001b[27Greplay,\u001b[35Gretries,\u001b[44Gcompatibility\u001b[58Gchecks,\u001b[66Gthe\u001b[70Gworld\u001b[76Glock\u001b[81G(it\u001b[85Gtried\u001b[91Gsymlinks\u001b[100Gand\u001b[104Gother\u001b[110Gpaths)\u001b[117Gor\r\u001b[2C\u001b[1Bthe glibc 2.38\u001b[18Glimi\u001b[23G. F2 is \u001b[32G Jettison fix, so the Manifest fixes need a\u001b[76Gnew engine pin. Shall I\u001b[100Gstart on the fixes,\r\u001b[2C\u001b[1Bwith F2 in Jettison first?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GR09\u001b[11Ggate's\u001b[18Gown\u001b[22Glog\u001b[26Gwasn't\u001b[33Gsaved,\u001b[40Gso\u001b[43Gthe\u001b[47Gprompt\u001b[54Ggave\u001b[59GCodex\u001b[65GR08's\u001b[71Ggate\u001b[76Glog\u001b[80Gplus\u001b[85Gthe\u001b[89Gplan's\u001b[96Gwritten\u001b[104Grecord\u001b[111Gof\u001b[114GR09's\r\u001b[2C\u001b[1Brun. Round 2 is the last of \u001b[32Ghe two allowed; whatever it leaves open comes to you\u001b[86Go settle.\u001b[96G\u001b[K\r\u001b[2C\u001b[1B    \u001b[8G     \u001b[14G \u001b[16G  \u001b[19G   \u001b[23G    \u001b[28G  \u001b[31G   \u001b[35G   \u001b[39G        \u001b[75G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
