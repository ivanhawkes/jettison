[0.020, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[2BClean stop (step,\u001b[23Gsnap\u001b[28Ghot,\u001b[33Gbackup)\u001b[43G58 ms \u001b[55G59 ms \u001b[64G66 ms  \r\u001b[4C\u001b[2BRecovery from the\u001b[31G \u001b[33G       \u001b[44G3\u001b[56G3\u001b[64G5\r\u001b[2C\u001b[1B└\u001b[41G┴\u001b[53G┴\u001b[62G┴\u001b[72G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe 30-second save to disk takes about 11 ms on the game loop. Four players\u001b[79Gis\u001b[82Gthe\u001b[86Gmost\u001b[91Gthe\u001b[95Gtrading\u001b[103Gscenario\u001b[112Gholds,\r\u001b[2C\u001b[1Bbecause\u001b[11Gits\u001b[15Gstarting\u001b[24Gstation's\u001b[34Glife\u001b[39Gsupport\u001b[47Ghas\u001b[51Groom\u001b[56Gfor\u001b[60Gonly\u001b[65Gfour\u001b[70Gships.\u001b[77GSo\u001b[80Gthe\u001b[84Glarger\u001b[91Gworlds\u001b[98Gearlier\u001b[106Gestimates\r\u001b[2C\u001b[1Bgu\u001b[6Gssed at couldn't be buil\u001b[31G or meas\u001b[40Gred.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCI\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GJettison\u001b[14G\u001b[38;2;177;185;249m84b8eed\u001b[39m:\u001b[23Gbuilds\u001b[30G\u001b[38;2;177;185;249mclang-headless\u001b[45G\u001b[39mwith\u001b[50Gwarnings\u001b[59Gas\u001b[62Gerrors,\u001b[70Gthen\u001b[75Gruns\u001b[80Gthe\u001b[84Gsmoke\u001b[90Gtest\u001b[95Gon\u001b[98Gsoftware\u001b[107GVulkan.\r\u001b[2C\u001b[1B- Manifest\u001b[14G\u001b[38;2;177;185;249mcdde5ab\u001b[39m:\u001b[23Gthe\u001b[27Genvironment\u001b[39Gcheck,\u001b[46Gthen\u001b[51Gthe\u001b[55Grelease\u001b[63Gbuild\u001b[69Gpackaged\u001b[78Gas\u001b[81Gthe\u001b[85Ginstall\u001b[93Gbundle,\u001b[101Gthen\u001b[106Gits\u001b[110Gsmoke\u001b[116Gtest\r\u001b[2C\u001b[1B \u001b[5Gon \u001b[9Ghe runner's Ubuntu.\u001b[K\r\u001b[4C\u001b[1BThe \u001b[10Gull\u001b[14Ggate, tidy included, now\u001b[39Gruns only locally b\u001b[59Gfore a push. That's recorded as D-116, and the\u001b[106Gdocs in bo\u001b[117Gh\u001b[K\r\u001b[4C\u001b[1Brepositories say so.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done or not checked\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mPushes:\u001b[13G\u001b[22mplease\u001b[20Gpush\u001b[25G\u001b[38;2;177;185;249mfeature-base\u001b[38G\u001b[39min\u001b[41Gboth\u001b[46Grepositories.\r\u001b[2C\u001b[1B- \u001b[1mCI:\u001b[22m neither new workflow\u001b[30Ghas\u001b[34Grun\u001b[38Gon\u001b[41GGitHub\u001b[76Ged\u001b[79Gwhen\u001b[84GI\u001b[86Gran\u001b[90Gthem\u001b[95Ghere,\u001b[101Gbut\u001b[105Gthe\u001b[109Gfirst\u001b[115Greal\u001b[27;1H\u001b[24;3H\u001b[?25h"]
