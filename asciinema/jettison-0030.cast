ftware\u001b[92Graster\u001b[99Gmove\u001b[104Gfrom\u001b[109GDeferred\u001b[118Gto\r\u001b[2C\u001b[1B \u001b[5GOpen (J50).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoadmap:\u001b[14G\u001b[22mthe\u001b[18GJ49\u001b[22Gand\u001b[26GJ50\u001b[30Grows\u001b[35Gare\u001b[39Gupdated\u001b[47Gto\u001b[50Gmatch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmade two calls of my own:\u001b[K\r\u001b[4C\u001b[1B\u001b[1mMSAA is\u001b[15Gm\u001b[17Gved, not kept beside TAA.\u001b[22m Two anti-aliasing paths would have to be kept in step.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TAA resolve starts from AMD's FSR 3 upscaler run at native resolution, not from scratch.\u001b[98G\u001b[22mIt\u001b[101Gcomes\u001b[107Gfrom\u001b[112Gthe\u001b[116Gsame\r\u001b[4C\u001b[1BFidelityFX\u001b[16Gv1.1.4\u001b[23Grelease\u001b[31Gas\u001b[34Gthe\u001b[38Gdenoisers,\u001b[49Gunder\u001b[55Gthe\u001b[59Gsame\u001b[64GMIT\u001b[68Glicence\u001b[76Gand\u001b[80Gin\u001b[83GGLSL.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTell\u001b[8Gme\u001b[11Gif\u001b[14Gyou\u001b[18Gwant\u001b[23Geither\u001b[30Gone\u001b[34Gchanged.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
