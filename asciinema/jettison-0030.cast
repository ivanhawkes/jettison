1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m27\u001b[12G\u001b[22m \u001b[14G  J42\u001b[20G--> J44 --> J45\u001b[K\r\u001b[7C\u001b[1B\u001b[2m28\u001b[12G\u001b[22m \u001b[14G  J42\u001b[20G--> J46\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 429 \u001b[22m     J44 --> J47 --> J49 -. \"temporal AA chosen\" .-> J50\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 430 -\u001b[38;2;248;248;242m    \u001b[48;2;92;2;0mJ40\u001b[48;2;61;1;0m --> J48                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 430 +\u001b[38;2;248;248;242m    \u001b[48;2;4;71;0mJ43\u001b[48;2;2;40;0m --> J48                                                                                       \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m31\u001b[12G\u001b[22m \u001b[14G  J42\u001b[20G--> J48\u001b[K\r\u001b[7C\u001b[1B\u001b[2m32\u001b[12G\u001b[22m```\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[1.652, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b[11Gocs/dense-ge\u001b[24Gm\u001b[26Gtry-and-ray-tracing.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[2m27\u001b[12G\u001b[22m \u001b[14G  J42\u001b[20G--> J44 --> J45\u001b[K\r\u001b[7C\u001b[1B\u001b[2m28\u001b[12G\u001b[22m \u001b[14G  J42\u001b[20G--> J46\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 429 \u001b[22m     J44 --> J47 --> J49 -. \"temporal AA chosen\" .-> J50\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 430 -\u001b[38;2;248;248;242m    \u001b[48;2;92;2;0mJ40\u001b[48;2;61;1;0m --> J48                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 430 +\u001b[38;2;248;248;242m    \u001b[48;2;4;71;0mJ43\u001b[48;2;2;40;0m --> J48                                                                                       \r\u001b[7C\u001b[1B\u001b[49m\u001b[39m\u001b[2m31\u001b[12G\u001b[22m \u001b[14G  J42\u001b[20G--> J48\u001b[K\r\u001b[7C\u001b[1B\u001b[2m32\u001b[12G\u001b[22m```\r\u001b[5C\u001b[1B\u001b[2m 433 \r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b[11Gocs/dense-ge\u001b[24Gm\u001b[26Gtry-and-ray-tracing.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines, removed \u001b[1m1\u001b[22m line\r\u001b[6C\u001b[1B\u001b[2m545\u001b[16G\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[2m546\u001b[12G\u001b[22m-\u001b[14G**Delivers.**\u001b[28GThe\u001b[32G`meshlet-traverse` pass a\u001b[58Gd\u001b[60Gits\u001b[64Gtwo\u001b[68Gcuts;\u001b[74GCLAS\u001b[79Gper\u001b[83Gloaded\u001b[90Gmeshlet,\u001b[99Gbuilt\u001b[105Gas\r\u001b[5C\u001b[1B\u001b[2m 547 \u001b[22m   pages arrive; per-instance bottom-level structures from the rays' cut; the alignments, limits and\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 548 -\u001b[38;2;248;248;242m  scratch sizes from the device's properties, all within \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m geometry budget; \u001b[48;2;92;2;0ma\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mdebug\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mmode\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mfeeding\u001b[48;2;61;1;0m    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 548 +\u001b[38;2;248;248;242m  scratch sizes from the device's properties, all within \u001b[48;2;4;71;0mJ43's\u001b[48;2;2;40;0m geometry budget; \u001b[48;2;4;71;0mthe\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mrays'\u001b[48;2;2;40;0m \u001b[48;2;4;71;0mcut\u001b[48;2;2;40;0m \u001b[48;2;4;71;0min\u001b[48;2;2;40;0m      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 549 +\u001b[38;2;248;248;242m  the streaming demand; a debug mod\u001b[75G                                       \u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
