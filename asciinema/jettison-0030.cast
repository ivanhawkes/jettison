[0.097, "o", "\u001b[?25l\u001b[H\u001b[5G-\u001b[7GJ49\u001b[11Ghas\u001b[15Gno\u001b[18Gdecision\u001b[27Gleft\u001b[32Gbefore\u001b[39Git\u001b[42Gstarts.\u001b[50GIt\u001b[53Gnow\u001b[57Gdelivers\u001b[66GTAA\u001b[70Gin\u001b[73Gplace\u001b[79Gof\u001b[82GMSAA\u001b[87Gand\u001b[91Gremoves\u001b[99GMSAA,\u001b[105Gits\u001b[109Gresolve\u001b[117Gand\r\u001b[1B      th\u001b[10G anti-aliasing setting.\u001b[K\r\u001b[4C\u001b[1B- J50 is\u001b[14Gno longer co\u001b[27Gditional. I\u001b[39G now needs J41 \u001b[55Gs\u001b[57Gwell as J49, since it\u001b[79G ex\u001b[83Gt crite\u001b[91Gion is measured against\u001b[115GJ41's\r\u001b[5C\u001b[1B scene.\u001b[K\r\u001b[4C\u001b[1B- J49 and J50 add about\u001b[29G2 to 4\u001b[36Gmonths after J48.\u001b[K\r\u001b[4C\u001b[1B- There's a\u001b[17Gnew expected-issues\u001b[37Grow:\u001b[42GTAA\u001b[46Gcan\u001b[50Gghost,\u001b[57Gblur\u001b[62Gthin\u001b[67Gstruts\u001b[74Gand\u001b[78Glines,\u001b[85Gand\u001b[89Gsmear\u001b[95Gtransparent\u001b[107Gsurfaces,\r\u001b[5C\u001b[1B which have no motion vectors.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScope:\u001b[12G\u001b[22manti-\u001b[18Gliasing \u001b[27Gay\u001b[30G TAA replaces MSAA in J49. The visibility buffer and software\u001b[92Graster move from Deferred\u001b[118Gto\r\u001b[4C\u001b[1BOpen (J50).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoadmap:\u001b[22m the J49 and J50 rows are updated to match.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmade two calls of my own:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMSAA is removed, not kept beside TAA.\u001b[22m Two anti-aliasing paths would have to be kept in step.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe TAA resolve starts from AMD's FSR 3 upscaler run at native resolution, not from scratch.\u001b[22m It comes from\u001b[112Gthe\u001b[116Gsame\r\u001b[4C\u001b[1BFidelityFX v1.1.4 rel\u001b[27Gas\u001b[30G as\u001b[34Gthe denois\u001b[46Gs, under the same MIT licence\u001b[76Gand in\u001b[83GGLSL.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTell\u001b[8Gme\u001b[11Gif\u001b[14Gyou\u001b[18Gwant\u001b[23Geither\u001b[30Gone\u001b[34Gchanged.\r\u001b[1B\u001b[K\r\u001b[1B  The link check still finds no errors. Shall I commit and push?\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.038, "o", "\u001b]0;✳ jettison-0030\u0007"]
