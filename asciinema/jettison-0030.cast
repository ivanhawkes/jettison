38;2;177;185;249m\u001b[1mVK_EXT_cluster_acceleration_structure\u001b[22m\u001b[39m was reported in NVIDIA's 615.71.09 notes, but\u001b[89Git's\u001b[94Gin neith\u001b[103Gr\u001b[105Gthe\u001b[109Gregistry\u001b[118Gnor\r\u001b[4C\u001b[1Bthe 1.4.363\u001b[17Gheaders, and driver 615.78.08 h\u001b[50Ge\u001b[52Gdoesn't\u001b[60Gexpose\u001b[67Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo the plan is:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPlain\u001b[11GKHR\u001b[15Gacceleration\u001b[28Gstructures\u001b[39Gare\u001b[43Gthe\u001b[47Gbaseline\u001b[56Gon\u001b[59Gevery\u001b[65Gvendor.\r\u001b[2C\u001b[1B- Mega\u001b[10GGeometry\u001b[19Gis\u001b[22Gan\u001b[25G\u001b[1moptional accelerator\u001b[46G\u001b[22mbehind\u001b[53Ga\u001b[55Gcapability\u001b[66Gcheck,\u001b[73Gkept\u001b[78Ginside\u001b[85Gone\u001b[89Gbuilder,\u001b[98Gso\u001b[101Gmoving\u001b[108Gto\u001b[111Gan\u001b[114GEXT\r\u001b[2C\u001b[1B \u001b[5Gversion later is \u001b[23G l\u001b[26Gcal change.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.323, "o", "\u001b]0;◑ jettison-0030\u0007"]
[0.079, "o", "\u001b[?25l\u001b[H\u001b[3Gbuilt with and without ray queries. Off costs nothing. A device w\u001b[70Ghout ray queries run\u001b[91G with it off, and\u001b[109Gthe log says\r\u001b[2C\u001b[1Bwhy, the way \u001b[17Gev\u001b[20Gce choice\u001b[30Glogs its\u001b[39Greason\u001b[46G now.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7G2026-11-11\u001b[18Gdecision\u001b[27Gto\u001b[30Gkeep\u001b[35Greflections\u001b[47Gout\u001b[51Ggets\u001b[56Gsuperseded,\u001b[68Gwith\u001b[73Gthe\u001b[77Gart\u001b[81Gteam's\u001b[88Grequest\u001b[96Gas\u001b[99Gthe\u001b[103Greason.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Mega Geometry on AMD: no equivalent exists on Vulkan today\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOnly NVIDIA ships cluster acceleration structures on Vulkan.\r\u001b[4C\u001b[1BAMD's \u001b[38;2;177;185;249mVK_AMDX_dense_geometry_format\u001b[22m\u001b[39m is provisional and solves\u001b[67Ga\u001b[69Gdifferent\u001b[79Gproblem:\u001b[88Gcompressed\u001b[99Gtriangle\u001b[108Ginput.\u001b[115GIt\r\u001b[2C\u001b[1B \u001b[5Gtargets future hardware and has only a\u001b[44GWindows preview\u001b[60Gdri\u001b[65Gr.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCross-vendor cluster builds exist only in DirectX\u001b[22m (DXR, preview\u001b[69Gsince\u001b[75GOctober\u001b[83G2026,\u001b[89Gwith\u001b[94GAMD,\u001b[99GIntel\u001b[105Gand\u001b[109GQualcomm\r\u001b[2C\u001b[1B \u001b[5Gsigned up). A Khronos version is likely later.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mVK_EXT_cluster_acceleration_structure\u001b[22m\u001b[39m was r\u001b[49Gported\u001b[56Gin\u001b[59GNVIDIA's\u001b[68G615.71.09\u001b[78Gnotes,\u001b[85Gbut\u001b[89Git's\u001b[94Gin\u001b[97Gneither\u001b[105Gthe\u001b[109Gregistry\u001b[118Gnor\r\u001b[2C\u001b[1B \u001b[5Gthe 1.4.363 headers, and driver 615.78.08\u001b[47Gh\u001b[49Gre doesn't expose it.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gthe\u001b[10Gplan\u001b[15Gis:\r\u001b[2C\u001b[1B- Plain KHR\u001b[15Gacceleration\u001b[28Gstructures\u001b[39Gare\u001b[43Gthe\u001b[47Gbaseline\u001b[56Gon\u001b[59Gevery\u001b[65Gvendor.\r\u001b[4C\u001b[1BMega Geometry is \u001b[23Gn \u001b[1moptional accelerator\u001b[22m behind a capability check,\u001b[73Gkept\u001b[78Ginside\u001b[85Gone\u001b[89Gbuilder,\u001b[98Gso\u001b[101Gmoving\u001b[108Gto\u001b[111Gan\u001b[114GEXT\r\u001b[2C\u001b[1B \u001b[5Gv\u001b[7Grsion la\u001b[16Ger\u001b[23G local change.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GRADV a\u001b[12Gd Intel \u001b[21Ghowed no\u001b[30Gwork on\u001b[38Git,\u001b[42Gbut\u001b[46GGitLab\u001b[53Gblocked\u001b[61Gthe\u001b[65Gsearch,\u001b[73Gso\u001b[76Gthat\u001b[81Gpart\u001b[86Gis\u001b[89Gunconfirmed.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
