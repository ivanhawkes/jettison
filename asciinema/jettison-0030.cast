\u001b[55Gcapability\u001b[66Gcheck,\u001b[73Gkept\u001b[78Ginside\u001b[85Gone\u001b[89Gbuilder,\u001b[98Gso\u001b[101Gmoving\u001b[108Gto\u001b[111Gan\u001b[114GEXT\r\u001b[2C\u001b[1B \u001b[5Gversion later is \u001b[23G l\u001b[26Gcal change.\u001b[K\r\u001b[4C\u001b[1BRADV\u001b[10Gand Intel \u001b[21Ghowed no work on it, but\u001b[46GGitLab\u001b[53Gblocked the sear\u001b[70Gh\u001b[73Gso \u001b[77Ghat part is\u001b[89Gunconfirmed.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Vulkan 1.3 vs 1.4\u001b[22m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
