Gthe\u001b[61Grig.\u001b[66GThat\u001b[71Gdouble\u001b[78Gread\u001b[83Gis\u001b[86GJ27's\u001b[92G\"a\u001b[95Gmodel\u001b[101Gfile\u001b[106Gread\u001b[111Gonce\"\u001b[117Grow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe options:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌────────────────────────────────┬────────────────────────────────────────────────┬───────────────────────────────┐\r\u001b[2C\u001b[1B│\u001b[5G            Option             │\u001b[38G    \u001b[43G  \u001b[46G   \u001b[50G         For  \u001b[65G    \u001b[70G     \u001b[76G    \u001b[81G    │   \u001b[90G  \u001b[93G   \u001b[97G Again\u001b[106G     \u001b[112G     │\u001b[K\r\u001b[2C\u001b[1B├────────────────────────────────┼────────────────────────────────────────────────┼───────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G\u001b[1mNew \u001b[38;2;177;185;249mgeometry\u001b[39m module\u001b[22m, CPU-only, │ The cook tool\u001b[53G\u001b[38;2;177;185;249mrender\u001b[39m,\u001b[61G\u001b[38;2;177;185;249mphysics\u001b[39m (J12) and    \u001b[83G  │ One more module: its CMake,  \u001b[117G│\u001b[K\r\u001b[2C\u001b[1B│\u001b[6Gwith\u001b[11Gfastgltf\u001b[20Gand\u001b[36G│\u001b[38G\u001b[38;2;177;185;249manimation\u001b[48G\u001b[39m(one\u001b[53Gshared\u001b[60Gread)\u001b[66Gcan\u001b[70Gall\u001b[74Guse\u001b[78Git;\u001b[82Git\u001b[85G│\u001b[87Gsuite,\u001b[94Gdocs\u001b[99Gand\u001b[103Ga\u001b[105Gline\u001b[110Gin\u001b[113Gthe\u001b[117G│\r\u001b[2C\u001b[1B│ meshoptimizer\u001b[36G│\u001b[39Gbuilds\u001b[46Gand\u001b[50Gtests\u001b[56Gin\u001b[59G\u001b[38;2;177;185;249mclang-cpu\u001b[85G\u001b[39m│\u001b[88Gmodule\u001b[95Ggraph\u001b[117G│\r\u001b[2C\u001b[1B└────────────────────────────────┴────────────────────────────────────────────────┴───────────────────────────────┘\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.084, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5Greading\u001b[13Gand\u001b[17Gwriting\u001b[25Gthe\u001b[29Gcooked\u001b[36Gpage\u001b[41Gformat\u001b[48Gthat\u001b[53Gstreaming\u001b[63Guses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNone\u001b[8Gof\u001b[11Gthis\u001b[16Gtouches\u001b[24Gthe\u001b[28GGPU.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the cod\u001b[16G says tod\u001b[26Gy:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe glTF geometry reader is in \u001b[38;2;177;185;249mrender\u001b[43G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mrender/src/vulkan/ModelGltf.cpp\u001b[39m).\u001b[78G\u001b[38;2;177;185;249mrender\u001b[85G\u001b[39monly\u001b[90Gbuilds\u001b[97Gwith\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mJETTISON_PRESENTATION\u001b[39m on, which needs Vulkan and glslc.\u001b[61G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe packer is built without presentation.\u001b[47G\u001b[22m\u001b[38;2;177;185;249mjettison_pack\u001b[39m links\u001b[67Gonly\u001b[72G\u001b[38;2;177;185;249mVfs\u001b[76G\u001b[39mand\u001b[80G\u001b[38;2;177;185;249mCore\u001b[39m,\u001b[86Gand\u001b[90Gbuilds\u001b[97Gin\u001b[100Gthe\u001b[104G\u001b[38;2;177;185;249mclang-cpu\u001b[114G\u001b[39mpreset.\r\u001b[2C\u001b[1B \u001b[5GStreaming (J41) needs a cook step in that tool, or besid\u001b[62G it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe simulation can't see \u001b[38;2;177;185;249mrender\u001b[39m.\u001b[22m Thi\u001b[42G is the architecture's \u001b[66Gard rule: \u001b[38;2;177;185;249msim\u001b[39m, \u001b[38;2;177;185;249mphysics\u001b[39m,\u001b[90G\u001b[38;2;177;185;249mai\u001b[93G\u001b[39mand\u001b[97Gthe\u001b[101Grest\u001b[106Gnever\u001b[112Ginclude\r\u001b[2C\u001b[1B \u001b[5Git. J12 (a glTF model's collision mesh) is \u001b[38;2;177;185;249mphysics\u001b[39m wanting the same triangles.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1manimation\u001b[39m parses the same glTF file separately\u001b[22m,\u001b[53Gfor\u001b[57Gthe\u001b[61Grig.\u001b[66GThat\u001b[71Gdouble\u001b[78Gread\u001b[83Gis\u001b[86GJ27's\u001b[92G\"a\u001b[95Gmodel\u001b[101Gfile\u001b[106Gread\u001b[111Gonce\"\u001b[117Grow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe options:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B┌────────────────────────────────┬────────────────────────────────────────────────┬───────────────────────────────┐\r\u001b[2C\u001b[1B│             Option             │                      For                       │            Against            │\r\u001b[2C\u001b[1B├────────────────────────────────┼────────────────────────────────────────────────┼───────────────────────────────┤\r\u001b[4C\u001b[1B\u001b[1mNew \u001b[38;2;177;185;249mgeometry\u001b[39m module\u001b[22m,\u001b[26GCPU-only,\u001b[38GThe cook to\u001b[50Gl,\u001b[53G\u001b[38;2;177;185;249mrender\u001b[39m, \u001b[38;2;177;185;249mphysics\u001b[39m (J12) and   \u001b[82G  \u001b[87GOne more module: its CMake,  \r\u001b[4C\u001b[1B with fastgltf\u001b[20Gand\u001b[38G\u001b[38;2;177;185;249manimation\u001b[39m (on\u001b[52G shared read) can\u001b[70Gall\u001b[74Guse\u001b[78Git;\u001b[82Git\u001b[87Gsuite, docs and\u001b[103Ga\u001b[105Gline\u001b[110Gin\u001b[113Gthe\r\u001b[2C\u001b[1B│ meshoptimizer                  │  builds and tests in \u001b[38;2;177;185;249mclang-cpu\u001b[39m                 │  module graph                 │\u001b[27;1H\u001b[24;3H\u001b[?25h"]
