[0.300, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Samples and SDKs: none of them is a dependency except meshoptimizer\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mmeshoptimizer (MIT)\u001b[25G\u001b[22mis\u001b[28Gthe\u001b[32Gonly\u001b[37Greal\u001b[42Gdependency.\u001b[54GIt\u001b[57Gprovides\u001b[66Gthe\u001b[70Gmeshlets,\u001b[80Gthe\u001b[84GLOD\u001b[88Ghierarchy,\u001b[99Gthe\u001b[103Gray-tracing\r\u001b[2C\u001b[1B \u001b[5Gcluster preset, and\u001b[25Ga meshlet cod\u001b[39Gc for str\u001b[49Gaming.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA \u001b[38;2;177;185;249mnvpro-samples\u001b[39m (Apache-2.0)\u001b[22m are the \u001b[49Gferences\u001b[58Gto\u001b[61Gread:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m: the closest to\u001b[39Gth\u001b[43Gw\u001b[45Gole plan.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249manimated_clusters\u001b[39m: deforming\u001b[39Gmeshes, relevant\u001b[56Gto\u001b[59Gthe\u001b[63Gblend\u001b[69Gshapes\u001b[76Gnoted\u001b[82Gbelow.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mtessellated_clusters\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mraytracing_tutorial_KHR\u001b[39m:\u001b[35Gray-query\u001b[45Gshadows\u001b[53Gand\u001b[57GAO.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mmini_samples\u001b[39m: mesh shaders, position fetch.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mnv\u001b[10Gcluster_*\u001b[39m build\u001b[26Grs\u001b[29Gand \u001b[38;2;177;185;249mvk_raytrace\u001b[39m: archived.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mvk\u001b[10Gpartitioned_tlas\u001b[39m: h\u001b[30Gs no licence file, so it can't\u001b[61Gbe\u001b[64Greused.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA RTX SDKs (NRD, RTXDI, RTXGI, RTXMG)\u001b[22m u\u001b[50Ge\u001b[52Ga proprietary licence.\u001b[75GClause\u001b[82G4e\u001b[85Gforbids\u001b[93Gusing\u001b[99Gthem\u001b[104Gin\u001b[107Ga\u001b[109Gway\u001b[113Gthat\r\u001b[2C\u001b[1B \u001b[5Gputs them under an open-source licence. NRD is\u001b[52Gthe \u001b[57Gnly productio\u001b[71G denoiser,\u001b[82Git's HLSL-only, and it's\u001b[109Glegal\u001b[K\r\u001b[4C\u001b[1Bq\u001b[7Ge\u001b[9Gtion rath\u001b[21Gthan a technica\u001b[37G one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- FidelityFX\u001b[18Gv2\u001b[21Gis\u001b[24Gbinary-only,\u001b[37Gmostly\u001b[44GWindows,\u001b[53Gand\u001b[57Gdrops\u001b[63Gthe\u001b[67Gray-tracing\u001b[79Geffects.\r\u001b[6C\u001b[1Bv1.1.4 is MIT\u001b[21Gand frozen, with HLSL source for its denoiser, SSSR \u001b[74Gnd CACAO, worth\u001b[90Gporting\u001b[98Gideas\u001b[104Gfrom.\r\u001b[6C\u001b[1BCapsaic\u001b[15Gn\u001b[17Gis DirectX 12 only. HIP RT isn't\u001b[50GVulkan.\u001b[58GThe DGF SDK targets future hardware.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.221, "o", "\u001b]0;◑ jettison-0030\u0007"]
[0.330, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B- \u001b[1mmeshoptimizer (MIT)\u001b[22m is the only real dependency. It provides the meshlets,\u001b[80Gthe\u001b[84GLOD\u001b[88Ghierarchy,\u001b[99Gthe\u001b[103Gray-tracing\r\u001b[4C\u001b[1Bcluster\u001b[13Gpreset,\u001b[21Gand\u001b[25Ga\u001b[27Gmeshlet\u001b[35Gcodec\u001b[41Gfor\u001b[45Gstreaming.\r\u001b[4C\u001b[1B\u001b[1mNVIDIA \u001b[38;2;177;185;249mnvpro-samples\u001b[39m (Apache-2.0)\u001b[22m \u001b[40Gre th\u001b[46G r\u001b[49Gferences t\u001b[60G read:\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m: the clos\u001b[33Gst to the whole pla\u001b[53G.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mvk_animated_clusters\u001b[39m: deforming\u001b[39Gmeshes,\u001b[49Gl\u001b[51Gva\u001b[54Gt to the blend\u001b[69Gshapes\u001b[76Gnoted\u001b[82Gbelow.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mtesse\u001b[16Gla\u001b[20Gd_clusters\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mraytracing_tu\u001b[24Go\u001b[26Gial_KHR\u001b[39m: ray-query shadows and AO.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mmini_samples\u001b[39m: mesh shaders,\u001b[38Gposition\u001b[47Gfetch.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mnv\u001b[10Gcluster_*\u001b[39m builders and \u001b[38;2;177;185;249mvk_raytrace\u001b[39m: archived.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mpartitioned_tlas\u001b[39m: has no licence file, so it\u001b[55Gcan't\u001b[61Gbe\u001b[64Greused.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA RTX SDKs (NRD, RTXDI, RTXGI, RTXMG)\u001b[22m use a proprietary\u001b[66Glicence.\u001b[75GClause\u001b[82G4e\u001b[85Gforbids\u001b[93Gusing\u001b[99Gthem\u001b[104Gin\u001b[107Ga\u001b[109Gway\u001b[113Gthat\r\u001b[4C\u001b[1Bputs them under an open-source licence. NRD\u001b[49Gis\u001b[52Gthe o\u001b[58Gly\u001b[61Gproduction\u001b[72Gdenoiser,\u001b[82Git's\u001b[87GHLSL-only,\u001b[98Gand\u001b[102Git's\u001b[107Ga\u001b[109Glegal\r\u001b[2C\u001b[1B \u001b[5Gquestion rather than a technical one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD:\u001b[10G\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- FidelityFX v2\u001b[21Gis binary-o\u001b[33Gly, m\u001b[39Gstly\u001b[44GWindows,\u001b[53Gand\u001b[57Gdrops\u001b[63Gthe\u001b[67Gray-tracing\u001b[79Geffects.\r\u001b[2C\u001b[1B \u001b[5G- v1.1.4\u001b[14Gis\u001b[17GMIT\u001b[21Gand\u001b[25Gfrozen,\u001b[33Gwith\u001b[38GHLSL\u001b[43Gsource\u001b[50Gfor\u001b[54Gits\u001b[58Gdenoiser,\u001b[68GSSSR\u001b[73Gand\u001b[77GCACAO,\u001b[84Gworth\u001b[90Gporting\u001b[98Gideas\u001b[104Gfrom.\r\u001b[6C\u001b[1BCapsa\u001b[13Gcin is D\u001b[22GrectX 12 \u001b[35G.\u001b[37GHIP RT\u001b[44Gis\u001b[47G't Vulkan. The DGF SDK ta\u001b[73Ggets future hardware.\r\u001b[6C\u001b[1BUseful\u001b[14Gguidance: meshl\u001b[30Gts\u001b[33Gof 128 vertices / 256 \u001b[56Griangle\u001b[64G on\u001b[68GRDNA, a TL\u001b[79GS rebuil\u001b[88G eve\u001b[93Gy frame, and \u001b[107Gpaque,\r\u001b[4C\u001b[1B \u001b[7Gfir\u001b[11Gt-h\u001b[15Gt\u001b[17Gshadow rays.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.399, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[20B\u001b[1mUpshot:\u001b[13G\u001b[22mno\u001b[16Gdenoiser\u001b[25Gis\u001b[28Gavailable\u001b[38Gunder\u001b[44Gan\u001b[47Gacceptable\u001b[58Glicence,\u001b[67Gso\u001b[70Gthe\u001b[74Gengine\u001b[81Gwrites\u001b[88Gits\u001b[92Gown\u001b[96Gsmall\u001b[102Gones,\u001b[108Gor\u001b[111Guses\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.152, "o", "\u001b[?25l\u001b[H\u001b[5Gcluster\u001b[13Gpreset,\u001b[21Gand\u001b[25Ga\u001b[27Gmeshlet\u001b[35Gcodec\u001b[41Gfor\u001b[45Gstreaming.\r\u001b[4C\u001b[1B\u001b[1mNVIDIA \u001b[38;2;177;185;249mnvpro-samples\u001b[39m (Apache-2.0)\u001b[22m \u001b[40Gre th\u001b[46G r\u001b[49Gferences t\u001b[60G read:\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m: the clos\u001b[33Gst to the whole pla\u001b[53G.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mvk_animated_clusters\u001b[39m: deforming\u001b[39Gmeshes,\u001b[49Gl\u001b[51Gva\u001b[54Gt to the blend\u001b[69Gshapes\u001b[76Gnoted\u001b[82Gbelow.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mtesse\u001b[16Gla\u001b[20Gd_clusters\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mraytracing_tu\u001b[24Go\u001b[26Gial_KHR\u001b[39m: ray-query shadows and AO.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mmini_samples\u001b[39m: mesh shaders,\u001b[38Gposition\u001b[47Gfetch.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mnv\u001b[10Gcluster_*\u001b[39m builders and \u001b[38;2;177;185;249mvk_raytrace\u001b[39m: archived.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mpartitioned_tlas\u001b[39m: has no licence file, so it\u001b[55Gcan't\u001b[61Gbe\u001b[64Greused.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA RTX SDKs (NRD, RTXDI, RTXGI, RTXMG)\u001b[22m use a proprietary\u001b[66Glicence.\u001b[75GClause\u001b[82G4e\u001b[85Gforbids\u001b[93Gusing\u001b[99Gthem\u001b[104Gin\u001b[107Ga\u001b[109Gway\u001b[113Gthat\r\u001b[4C\u001b[1Bputs them under an open-source licence. NRD\u001b[49Gis\u001b[52Gthe o\u001b[58Gly\u001b[61Gproduction\u001b[72Gdenoiser,\u001b[82Git's\u001b[87GHLSL-only,\u001b[98Gand\u001b[102Git's\u001b[107Ga\u001b[109Glegal\r\u001b[2C\u001b[1B \u001b[5Gquestion rather than a technical one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAMD:\u001b[10G\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- FidelityFX v2\u001b[21Gis binary-o\u001b[33Gly, m\u001b[39Gstly\u001b[44GWindows,\u001b[53Gand\u001b[57Gdrops\u001b[63Gthe\u001b[67Gray-tracing\u001b[79Geffects.\r\u001b[2C\u001b[1B \u001b[5G- v1.1.4\u001b[14Gis\u001b[17GMIT\u001b[21Gand\u001b[25Gfrozen,\u001b[33Gwith\u001b[38GHLSL\u001b[43Gsource\u001b[50Gfor\u001b[54Gits\u001b[58Gdenoiser,\u001b[68GSSSR\u001b[73Gand\u001b[77GCACAO,\u001b[84Gworth\u001b[90Gporting\u001b[98Gideas\u001b[104Gfrom.\r\u001b[6C\u001b[1BCapsa\u001b[13Gcin is D\u001b[22GrectX 12 \u001b[35G.\u001b[37GHIP RT\u001b[44Gis\u001b[47G't Vulkan. The DGF SDK ta\u001b[73Ggets future hardware.\r\u001b[6C\u001b[1BUseful\u001b[14Gguidance: meshl\u001b[30Gts\u001b[33Gof 128 vertices / 256 \u001b[56Griangle\u001b[64G on\u001b[68GRDNA, a TL\u001b[79GS rebuil\u001b[88G eve\u001b[93Gy frame, and \u001b[107Gpaque,\r\u001b[4C\u001b[1B \u001b[7Gfir\u001b[11Gt-h\u001b[15Gt\u001b[17Gshadow rays.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUpshot:\u001b[22m no denoiser i\u001b[27G available und\u001b[43G an acceptable licence, so the\u001b[74Gengine\u001b[81Gwrites its own small\u001b[102Go\u001b[104Ges, or uses\r\u001b[4C\u001b[1Bef\u001b[8Gects that don't\u001b[24Gneed one.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
