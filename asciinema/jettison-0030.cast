u001b[38;2;248;248;242m](#memory) budget, a                                    \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 508 \u001b[22m   setting, over everything geometry holds on the GPU; a model on the streamed path uploads from its\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 509 \u001b[22m   GLB only the level rays use, never the finest.\u001b[K\r\u001b[8C\u001b[1B\u001b[2m0\u001b[12G\u001b[22m-\u001b[14G**Exit\u001b[21Gcriterion.**\u001b[34GWith\u001b[39Ga\u001b[41Gpool\u001b[46Gsmaller\u001b[54Gthan\u001b[59Gthe\u001b[63Gscene,\u001b[70Ga\u001b[72Gcamera\u001b[79Gflight\u001b[86Gon\u001b[89Glavapipe\u001b[98Gends\u001b[103Gon\u001b[106Gthe\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/dense-geometry-and-ray-tracing.m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.351, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/dense-geome\u001b[27Gry-and-r\u001b[36Gy-trac\u001b[43Gng.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m- **Exit\u001b[21Gcriterion.** The\u001b[38G`geometry`\u001b[49Gsuite\u001b[55Gproves\u001b[62Gthe\u001b[66Glevels'\u001b[74Gerrors\u001b[81Ggrow\u001b[86Gand\u001b[90Gthe\u001b[94Gcook's\u001b[101Goutput\u001b[108Gis\r\u001b[5C\u001b[1B\u001b[2m 453 \u001b[14G\u001b[22mthe\u001b[18Gsame\u001b[23Gbytes\u001b[29Gtwice;\u001b[36Gthe\u001b[40Gcook\u001b[45Gsuite\u001b[51Gcooks\u001b[57Ga\u001b[59Gfixture\u001b[67Gtree,\u001b[73Gskips\u001b[79Gwhat\u001b[84Gis\u001b[87Gunchanged,\u001b[98Gdeletes\u001b[106Gwhat\r\u001b[1B \u001b[3G   \u001b[2m 454 \u001b[22m   lost its source, and cooks a model again\u001b[55Gwhen\u001b[60Gonly\u001b[65Gits\u001b[69Gbuffer,\u001b[77Gan\u001b[80Gimage\u001b[86Gor\u001b[89G`cook.yaml`\u001b[101Gchanged;\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 455 -\u001b[38;2;248;248;242m  the animation suite reads a cooked skinned fixture with its joints, clips and poses intact; \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 456 -\u001b[38;2;248;248;242m  render test draws cooked models; a reference view shows a generated asteroid                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 455 +\u001b[38;2;248;248;242m  the animation suite reads a cooked skinned fixture with its joints, clips and poses intact; \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 456 +\u001b[38;2;248;248;242m  \u001b[48;2;4;71;0mreference view draws a cooked textured model with its KTX 2 base colour; the \u001b[48;2;2;40;0mrender test