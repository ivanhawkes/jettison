[0.804, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mI've\u001b[8Grecorded\u001b[17Gthe\u001b[21Gswitch\u001b[28Gto\u001b[31GTAA\u001b[35Gacross\u001b[42Gthe\u001b[46Gdocuments.\u001b[57GIt's\u001b[62Gnot\u001b[66Gcommitted\u001b[76Gyet.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDecision\u001b[14G\u001b[22m(\u001b[38;2;177;185;249mdocs/decisions.md\u001b[39m):\u001b[35GTAA\u001b[39Greplaces\u001b[48GMSAA\u001b[53Gin\u001b[56GJ49\u001b[60Gand\u001b[64Gthe\u001b[68Gengine\u001b[75Gkeeps\u001b[81Gone\u001b[85Ganti-aliasing\u001b[99Gpath.\u001b[105GTAA\u001b[109Galso\u001b[114Gmakes\r\u001b[2C\u001b[1B \u001b[5Groom for\u001b[14GJ50's visibility buffer,\u001b[39Gwhich only gives\u001b[56Gone\u001b[60Gsample p\u001b[69Gr pixel.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPlan:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- J49\u001b[11Ghas\u001b[15Gno\u001b[18Gdecision\u001b[27Gleft\u001b[32Gbefore\u001b[39Git\u001b[42Gstarts.\u001b[50GIt\u001b[53Gnow\u001b[57Gdelivers\u001b[66GTAA\u001b[70Gin\u001b[73Gplace\u001b[79Gof\u001b[82GMSAA\u001b[87Gand\u001b[91Gremoves\u001b[99GMSAA,\u001b[105Gits\u001b[109Gresolve\u001b[117Gand\r\u001b[4C\u001b[1B \u001b[7Gthe\u001b[11Ganti-alias\u001b[22Gng setting.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GJ50\u001b[11Gis no \u001b[18Gonger conditional.\u001b[37GIt\u001b[40Gnow\u001b[44Gneeds\u001b[50GJ41\u001b[54Gas\u001b[57Gwell\u001b[62Gas\u001b[65GJ49,\u001b[70Gsince\u001b[76Gits\u001b[80Gexit\u001b[85Gcriterion\u001b[95Gis\u001b[98Gmeasured\u001b[107Gagainst\u001b[115GJ41's\r\u001b[4C\u001b[1B \u001b[7Gscene.\u001b[14G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GJ49 and\u001b[15GJ50\u001b[19Gadd\u001b[23Gabout\u001b[29G2\u001b[31Gto\u001b[34G4\u001b[36Gmonths\u001b[43Gafter\u001b[49GJ48.\r\u001b[6C\u001b[1BThere's\u001b[15Ga new expected-issues row: TAA can ghost,\u001b[57Gblur\u001b[62Gthin\u001b[67Gstruts\u001b[74Gand\u001b[78Glines,\u001b[85Gand\u001b[89Gsmear\u001b[95Gtransparent\u001b[107Gsurfaces,\r\u001b[4C\u001b[1B \u001b[7Gw\u001b[9Gich have no\u001b[21Gmotion vectors.\u001b[37G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScope:\u001b[22m anti-aliasing says TAA replaces\u001b[44GMSAA\u001b[49Gin\u001b[52GJ49.\u001b[57GThe\u001b[61Gvisibility\u001b[72Gbuffer\u001b[79Gand\u001b[83Gsoftware\u001b[92Graster\u001b[99Gmove\u001b[104Gfrom\u001b[109GDeferred\u001b[118Gto\r\u001b[2C\u001b[1B \u001b[5GOpen (J50).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoadmap:\u001b[22m the\u001b[18GJ49\u001b[22Gand\u001b[26GJ50\u001b[30Grows\u001b[35Gare\u001b[39Gupdated\u001b[47Gto\u001b[50Gmatch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gmade\u001b[10Gtwo\u001b[14Gcalls\u001b[20Gof\u001b[23Gmy\u001b[26Gown:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMSAA is removed, not kept beside TAA.\u001b[43G\u001b[22mTwo\u001b[47Ganti-aliasing\u001b[61Gpaths\u001b[67Gwould\u001b[73Ghave\u001b[78Gto\u001b[81Gbe\u001b[84Gkept\u001b[89Gin\u001b[92Gstep.\r\u001b[4C\u001b[1B\u001b[1mThe TAA\u001b[15Gs\u001b[17Glve starts from AMD's FSR 3 up\u001b[75Gion, not from scratch.\u001b[98G\u001b[22mIt\u001b[101Gcomes\u001b[107Gfrom\u001b[112Gthe\u001b[116Gsame\u001b[27;1H\u001b[24;3H\u001b[?25h"]
