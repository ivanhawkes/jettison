[0.004, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mFallback paths are\u001b[22Gbeing kept\u001b[33Gunder\u001b[39Gtest, Mega Geometry\u001b[59Ggets\u001b[64Ga\u001b[66Gcheck\u001b[72Gscript\u001b[79Gon\u001b[82GLythir,\u001b[90Gand\u001b[94Gsharp\u001b[100Greflections\u001b[112Gcome\r\u001b[2C\u001b[1Bfirst,\u001b[10Gwith\u001b[15GVulkan\u001b[22G1.4\u001b[26Gas\u001b[29Gstep\u001b[34G0.\u001b[37GNext\u001b[42GI'm\u001b[46Gchecking\u001b[55Ghow\u001b[59GAO\u001b[62Gand\u001b[66Gthe\u001b[70Gshadow\u001b[77Gcascades\u001b[86Gare\u001b[90Gbuilt,\u001b[97Gsince\u001b[103Gray\u001b[107Gtracing\u001b[115Gwill\r\u001b[1B \u001b[3Gplug into them.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRay-traced AO fits the existing ambient-occlusion pass unchanged, so only\u001b[77Gits\u001b[81Gsampling\u001b[90Gdiffers;\u001b[99G\"Surfaces\"\u001b[110Gmay\r\u001b[2C\u001b[1Bconflict with docs/scope.md, which lists terrain and water as Out, so that needs\u001b[84Gyour\u001b[89Gdecision.\u001b[38;2;153;153;153m · summary\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Surfaces \u001b[39m\u001b[49m ☐\u001b[18GOcclus\u001b[25Gon\u001b[28G ☐ Streaming  ☐ Local\u001b[50Gshadows \u001b[59G✔ Submit  →\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u001b[1mBy 'Surfaces', which do you mean? (Terrain is Out in scope.md.)\r\u001b[2B\u001b[22m\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[39m \u001b[38;2;177;185;249mAsteroid meshes\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mDense authored or procedural meshes of rocks and small bodies; no terrain system\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;2;153;153;153m2.\u001b[39m Planet LOD\u001b[17G\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153mFiner levels of detail for the existing procedural bodies seen close, still spheres with maps\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3.\u001b[6G\u001b[39mTerrain\u001b[14GIn\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153mA real terrain system for landing on bodies; it becomes its own plan, and this plan only makes sure meshlets fit it\r\u001b[2C\u001b[1B4. Type something.\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  5.\u001b[6GChat\u001b[11Gabout\u001b[17Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0030 ─\u001b[39m\u001b[27;1H\u001b[16;1H"]
