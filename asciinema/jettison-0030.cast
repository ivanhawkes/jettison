[0.159, "o", "\u001b[?25l\u001b[H\u001b[5Geverything at\u001b[19Gload time\u001b[33G     \u001b[39G    \u001b[72Gfrom d\u001b[79Gsk, which defeats J41  \u001b[103G       \u001b[111G   \r\u001b[2C\u001b[1B└───────────────────────────┴──────────────────────────────────────┴─────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation is the new \u001b[38;2;177;185;249mgeometry\u001b[39m module\u001b[22m,\u001b[49Gkept\u001b[54Gnarrow:\r\u001b[2C\u001b[1B- \u001b[1mNo Vulka\u001b[14G types.\u001b[22m It outputs plain arrays in\u001b[49Gthe layout the\u001b[64GGPU\u001b[68Greads,\u001b[75Gand\u001b[79G\u001b[38;2;177;185;249mrender\u001b[86G\u001b[39monly\u001b[91Guploads\u001b[99Gthem.\r\u001b[4C\u001b[1B\u001b[1mDependencies:\u001b[22m \u001b[38;2;177;185;249mcore\u001b[39m,\u001b[25G\u001b[38;2;177;185;249mmath\u001b[39m, \u001b[38;2;177;185;249mvfs\u001b[39m, fastgltf and\u001b[49Gmeshoptimizer.\u001b[64GThat put\u001b[73G it in the Data tier, be\u001b[98Gide \u001b[38;2;177;185;249mresource\u001b[39m.\u001b[112G\u001b[38;2;177;185;249mphysics\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gand \u001b[38;2;177;185;249manimation\u001b[19G\u001b[39msit above it, so\u001b[36Gevery edge points down.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe same bytes every run.\u001b[22m A\u001b[33Gpinned meshoptim\u001b[50Gzer\u001b[54Gand fixed\u001b[64Ginputs\u001b[71Ggive\u001b[76Gthe\u001b[80Gsame\u001b[85Ghierarchy\u001b[95Geach\u001b[100Gtime,\u001b[106Gwhich\u001b[112Gis\u001b[115Gwhat\r\u001b[2C\u001b[1B \u001b[5Gthe reference frames need.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSimulation determinism is J12's question, not this plan's.\u001b[64G\u001b[22mIf\u001b[67G\u001b[38;2;177;185;249mphysics\u001b[75G\u001b[39mreads\u001b[81Gcollision\u001b[91Gmeshes\u001b[98Gfrom\u001b[103Git,\u001b[107GJ12\u001b[111Gdecides\r\u001b[2C\u001b[1B \u001b[5Gthen whether the module gets the \u001b[38;2;177;185;249mDETERMINISTIC