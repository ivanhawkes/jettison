[0.054, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/decisions.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m8\u001b[14G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[2m 452 \u001b[22m - **KTX-S\u001b[22Gftware\u001b[29Gstays\u001b[35Gon\u001b[38Gv4.4.2**\u001b[47G(2026-11-11).\u001b[61GIts\u001b[65Gnewest\u001b[72Gtag\u001b[76Gis\u001b[79Gstill\u001b[85Gv5.0.0-rc2,\u001b[97Gand\u001b[101Gv4.4.2\r\u001b[1B     \u001b[2m 453 \u001b[12G\u001b[22m \u001b[14Gread\u001b[20Gevery\u001b[26Gfile\u001b[31Gthe\u001b[35Gengine\u001b[42Gneeds\u001b[48G(KTX\u001b[53G2,\u001b[56GBasis\u001b[62GUniversal\u001b[72GETC1S\u001b[78Gand\u001b[82GUASTC,\u001b[89Gzstd\u001b[94Gsupercompression);\r\u001b[8C\u001b[1B\u001b[2m4\u001b[12G\u001b[22m \u001b[14Grevisit when v5 is released. [\u001b[38;2;230;219;116mBuild and gates\u001b[39m](build-and-gates.md)\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 455 +\u001b[38;2;248;248;242m- **Vulkan 1.4** (2026-11-25, the user's; built in J36). Every device with mesh shaders and ray       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 456 +\u001b[38;2;248;248;242m  queries reports 1.4 on a current driver, and it makes scalar block layout and push descriptors      \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242m \u001b[14Greq\u001b[18Gired. Devices whose drivers\u001b[46Gstop at\u001b[54G1.3 (GCN\u001b[63G1 and\u001b[69G2, Mesa before 25.0) can no longer\u001b[105Gun\u001b[108Gthe\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[14G\u001b[38;2;248;248;242mengin\u001b[20G.\u001b[22G[\u001b[38;2;230;219;116mDense geometry and ray tracing\u001b[38;2;248;248;242m](dense-geometry-and-ray-tracing.md)                         \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242m-\u001b[14G**No d\u001b[21Gpend\u001b[26Gncy under a\u001b[38Glicence\u001b[46Gthat\u001b[51Gforbids open-source us\u001b[74G**\u001b[77G(2026-11-25\u001b[89G. NVIDIA's RTX\u001b[104GSDKs   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m60\u001b[14G\u001b[38;2;248;248;242mlice\u001b[19Gce\u001b[22G(NRD, RTXDI, RTXGI, RTXMG) forbids use that would put the SDK under an open-source licence, \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m61\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gand FidelityFX 2 ships as bi\u001b[43Garies only, so the engine writ\u001b[74Gs its own denoising.     \u001b[100G   \u001b[104G    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\u001b[14G\u001b[38;2;248;248;242m[\u001b[38;2;230;219;116mCoding standards\u001b[38;2;248;248;242m](coding-standards.md#dependencies)                                                \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 463 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 464 \u001b[22m ## Process\u001b[K\r\u001b[8C\u001b[1B\u001b[2m5\r\u001b[5C\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNow the glossary\u001b[20Gand\u001b[24Gthe\u001b[28Gcoding\u001b[35Gstandards.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
