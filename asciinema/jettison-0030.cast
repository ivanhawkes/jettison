[0.005, "o", "\u001b[?25l\u001b[H\u001b[7GThe engine owns the t\u001b[29Gol, \u001b[34Ghe format and the defaults.\u001b[62G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GManife\u001b[14Gt owns\u001b[21Gits \u001b[38;2;177;185;249mcook.yaml\u001b[39m (source\u001b[43Groot,\u001b[49Goutput\u001b[56Groot,\u001b[62Gits\u001b[66Gdefaults)\u001b[76Gand\u001b[80Gits\u001b[84Gcontent.\r\u001b[2C\u001b[1B \u001b[5G- The cook also r\u001b[23Gj\u001b[25Gcts file names that break\u001b[51Gthe\u001b[55Gkebab-case\u001b[66Grule.\u001b[72GThat's\u001b[79Gvalidation\u001b[90Gat\u001b[93Gthe\u001b[97Gboundary\u001b[106Gwhere\u001b[112Gartists'\r\u001b[4C\u001b[1B \u001b[7Gfiles come in.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe runtime gets leaner.\u001b[22m The meshlet build\u001b[48Gmoves from load time (J38)\u001b[75Ginto\u001b[80Gthe\u001b[84Gcook,\u001b[90Gso\u001b[93Gthe\u001b[97Gengine\u001b[104Gonly\u001b[109Gdecodes.\u001b[118GA\r\u001b[4C\u001b[1BGLB wi\u001b[12Ghou\u001b[16G a meshlet sidecar still\u001b[41Gdraws,\u001b[48Gon\u001b[51Gthe\u001b[55Gindexed\u001b[63Gpath,\u001b[69Gwith\u001b[74Ga\u001b[76Gwarning\u001b[84Gnaming\u001b[91Gthe\u001b[95Gtool.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Grepo\u001b[12Gcan't\u001b[18Gsettle\u001b[25Gthe\u001b[29Gremaining\u001b[39Gchoices,\u001b[48Gso\u001b[51Gthese\u001b[57Gare\u001b[61Gfor\u001b[65Gyou:\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Cooked form \u001b[39m\u001b[49m ☐ Uncooked\u001b[31G☐\u001b[33GCook\u001b[38Gscope\u001b[45G☐\u001b[47GEngine\u001b[54Gcontent\u001b[63G✔\u001b[65GSubmit\u001b[73G→\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u001b[1mWhat should a cooked model be?\u001b[22m\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[39m \u001b[38;2;177;185;249mGLB + sidecar\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mA normalised GLB (rig, clips and nodes kept, so animation's loader is unchanged) plus a `.meshlets` page file \r\u001b[2C\u001b[1B\u001b[39m \u001b[5G \u001b[38;2;153;153;153mbeside it, stored uncompressed in packs for ranged reads\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[39m One GLB\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mMeshlet pages inside the GLB under a custom extension; one file, but fastgltf has no hook for unknown extensions, \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mso the loader reads the bufferViews itself\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3.\u001b[6G\u001b[39mNative\u001b[13Gformat\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153mOne engine binary for\u001b[28Geverything; the rig and clip loader is rewritten for it\r\u001b[2C\u001b[1B4. Type something.\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  5.\u001b[6GChat\u001b[11Gabout\u001b[17Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0030 ─\u001b[39m\u001b[27;1H\u001b[14;1H"]
[0.161, "o", "\u001b[H\u001b[11Gcook also rejects file names that break th\u001b[54G kebab-case\u001b[66Grule.\u001b[72GThat's\u001b[79Gvalidation\u001b[90Gat\u001b[93Gthe\u001b[97Gboundary\u001b[106Gwhere\u001b[112Gartists'\r\u001b[4C\u001b[1B \u001b[7Gfiles come in.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe runtime gets leaner.\u001b[22m Th\u001b[34Gmeshle\u001b[41G build moves from load time (J38) into the cook,\u001b[90Gso\u001b[97Gengine only d\u001b[111Gcodes. A\u001b[K\r\u001b[4C\u001b[1BGLB without a meshlet\u001b[27Gsidecar\u001b[35Gstill\u001b[41Gdraws,\u001b[48Gon\u001b[51Gthe\u001b[55Gindexed\u001b[63Gpath,\u001b[69Gwith\u001b[74Ga\u001b[76Gwarning\u001b[84Gnaming\u001b[91Gthe\u001b[95Gtool.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe repo can't settle \u001b[26Ghe r\u001b[31Gm\u001b[33Gining choice\u001b[48Gso\u001b[54Gse are for you:\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m●\u001b[3G\u001b[39mWorking…\u001b[12G\u001b[K\u001b[27;1H\u001b[14;1H"]
[0.338, "o", "\u001b[H\r\u001b[7B\u001b[38;2;153;153;153m \u001b[39m\u001b[27;1H\u001b[14;1H"]
