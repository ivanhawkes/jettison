[0.050, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5GJ20 hands its glTF clip eve\u001b[33Gts row to J54\u001b[47Gand its cross-fade row to J53. J42 now needs J51.\u001b[97G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScope and decisions:\u001b[22m ten n\u001b[32Gw decisions under Animati\u001b[58Gn. In scope:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Open: blend shapes, ble\u001b[31Gd spa\u001b[37Ge\u001b[39G, lip sync, the character \u001b[67Gntroller,\u001b[77Gskin\u001b[82Gand\u001b[86Geyes,\u001b[92Ghair\u001b[97Gcards,\u001b[104Gtwo-bone\u001b[113GIK\u001b[116Gand\r\u001b[4C\u001b[1B \u001b[7Glook-at.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GOut: root\u001b[17Gmotion,\u001b[25Ganimation\u001b[35Gstate\u001b[41Gmachines\u001b[50Gand\u001b[54Ggraphs,\u001b[62Gcrowds,\u001b[70Ghair\u001b[75Gstrands\u001b[83Gand\u001b[87Gcloth.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAlso updated:\u001b[22m f\u001b[21Gve gloss\u001b[30Gry entries, the limits in \u001b[38;2;177;185;249manimation.md\u001b[70G\u001b[39mthe README index, and the\u001b[96Gdense-geometry\u001b[111Gplan\r\u001b[2C\u001b[1B \u001b[5G(deform pass,\u001b[19Ghair\u001b[24Gas the firs\u001b[36G non-opaque ray-tracing geometry\u001b[74Goverflow order).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCoding standards:\u001b[22m committed test content must be the project's own or g\u001b[77Gnerated at build\u001b[94Gtime,\u001b[100Gnot\u001b[104Gunder\u001b[110Gsomeone\r\u001b[2C\u001b[1B \u001b[5Gelse's licence, CC-BY \u001b[28Gncluded.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the review changed:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mBlending and playback\u001b[28G\u001b[22mquaternion\u001b[39Gblending\u001b[48Gis\u001b[51Gnow\u001b[55Gtruly\u001b[61Gorder-independent.\u001b[80GMorph\u001b[86Gweights\u001b[94Gset\u001b[98Gon\u001b[101Ga\u001b[103Gnode\u001b[108Goverride\u001b[117Gits\r\u001b[2C\u001b[1B \u001b[5Gmesh's defaults. Bounds for morphed mo\u001b[44Gels\u001b[48Gare recomputed each fram\u001b[73G from the curr\u001b[88Gnt weigh\u001b[97Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLocomotion:\u001b[22m playback speed is matched after sync, as a dir\u001b[64Gction rathe\u001b[76G than a ba\u001b[88G spe\u001b[93Gd. The\u001b[100Gblend\u001b[106Gspace\u001b[112Greads\r\u001b[2C\u001b[1B \u001b[5Gwalking speed rel\u001b[23Gtive to what the character stands on, so a passenger on \u001b[80G turning\u001b[89Gdeck stands still.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLip sync:\u001b[22m Rhubarb's \u001b[27Grsion is\u001b[36Gpart of the cook key, and a\u001b[64Gmissing Rhubarb deletes stale\u001b[94Glip-sync c\u001b[105Gips\u001b[109Gand\u001b[113Gtriggers\r\u001b[2C\u001b[1B \u001b[5Ga re-cook\u001b[15Glater. J57 now also needs\u001b[41GJ53.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFootstep events:\u001b[22G\u001b[22mclips in a blended\u001b[41Ggroup\u001b[47Ggive\u001b[52Gone\u001b[56Gfootstep\u001b[65Gper\u001b[69Gcontact,\u001b[78Gwith\u001b[83Gnone\u001b[88Grepeated\u001b[97Gor\u001b[100Glost\u001b[105Gwhen\u001b[110Gthe\u001b[114Gleading\r\u001b[2C\u001b[1B \u001b[5Gclip changes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFoot placement:\u001b[21G\u001b[22mfeet\u001b[26Gare\u001b[30Gplaced\u001b[37Gfrom\u001b[42Gbox\u001b[46Gsweeps\u001b[53Gover\u001b[58Ga\u001b[60Ggrid,\u001b[66Gso\u001b[69Gthey\u001b[74Gnever\u001b[80Gsink\u001b[85Ginto\u001b[90Ga\u001b[92Gsurface.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
