[0.085, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMy recommendation is the new \u001b[38;2;177;185;249mgeometry\u001b[39m module\u001b[22m,\u001b[49Gkept\u001b[54Gnarrow:\r\u001b[2C\u001b[1B- \u001b[1mNo Vulka\u001b[14G types.\u001b[22m It outputs plain arrays in\u001b[49Gthe layout the\u001b[64GGPU\u001b[68Greads,\u001b[75Gand\u001b[79G\u001b[38;2;177;185;249mrender\u001b[86G\u001b[39monly\u001b[91Guploads\u001b[99Gthem.\r\u001b[4C\u001b[1B\u001b[1mDependencies:\u001b[22m \u001b[38;2;177;185;249mcore\u001b[39m,\u001b[25G\u001b[38;2;177;185;249mmath\u001b[39m, \u001b[38;2;177;185;249mvfs\u001b[39m, fastgltf and\u001b[49Gmeshoptimizer.\u001b[64GThat put\u001b[73G it in the Data tier, be\u001b[98Gide \u001b[38;2;177;185;249mresource\u001b[39m.\u001b[112G\u001b[38;2;177;185;249mphysics\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gand \u001b[38;2;177;185;249manimation\u001b[19G\u001b[39msit above it, so\u001b[36Gevery edge points down.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe same bytes every run.\u001b[22m A\u001b[33Gpinned meshoptim\u001b[50Gzer\u001b[54Gand fixed\u001b[64Ginputs\u001b[71Ggive\u001b[76Gthe\u001b[80Gsame\u001b[85Ghierarchy\u001b[95Geach\u001b[100Gtime,\u001b[106Gwhich\u001b[112Gis\u001b[115Gwhat\r\u001b[2C\u001b[1B \u001b[5Gthe reference frames need.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSimulation determinism is J12's question, not this plan's.\u001b[64G\u001b[22mIf\u001b[67G\u001b[38;2;177;185;249mphysics\u001b[75G\u001b[39mreads\u001b[81Gcollision\u001b[91Gmeshes\u001b[98Gfrom\u001b[103Git,\u001b[107GJ12\u001b[111Gdecides\r\u001b[2C\u001b[1B \u001b[5Gthen whether the module gets the \u001b[38;2;177;185;249mDETERMINISTIC\u001b[39m flag.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCost to a game with no dense content:\u001b[22m a small MIT library\u001b[63Gcompiled\u001b[72Gin.\u001b[76GNothing\u001b[84Gruns\u001b[89Gunless\u001b[96Ga\u001b[98Gmodel\u001b[104Gloads.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDo\u001b[6Gyou\u001b[10Gwant\u001b[15Gthe\u001b[19Gnew\u001b[23G\u001b[38;2;177;185;249mgeometry\u001b[32G\u001b[39mmodule,\u001b[40Gor\u001b[43Gone\u001b[47Gof\u001b[50Gthe\u001b[54Gother\u001b[60Goptions?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCrunched for 29s · done 8:58 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0030 ─\r\u001b[1B\u001b[39m❯ New geometry module, go with your recommendation We will be using a cook stage in the asset pipeline, so all gltf\u001b[K\r\u001b[1B  assets will be cooked into a\u001b[32Gperfo\u001b[38Gmant a\u001b[46G suitable format\u001b[63Gfor consumption by\u001b[82Gthe engine. That may al\u001b[108Gbe gltf if\r\u001b[2C\u001b[1Bit supports\u001b[15Geverything we need. I a\u001b[39G leaning tow\u001b[52Grds\u001b[56Ghaving\u001b[63Ga sidecar outside the game r\u001b[92Gpo for\u001b[99Gall\u001b[103Gthe game assets\r\u001b[2C\u001b[1Bthat the artists author. A small co\u001b[39Gmand line daemon\u001b[56Gtool would watch\u001b[73Gthat folder\u001b[85Gfor file changes,\u001b[103Gand\u001b[107Gcook\u001b[112Gthe\u001b[K\r\u001b[2C\u001b[1Bassets into the format the\u001b[30Gengine requires, moving them int\u001b[63G an\u001b[67Gasset\u001b[73Gfolder inside the game repo at that point,\r\u001b[2C\u001b[1Bthat mirrors the structur\u001b[30Gof th\u001b[37Gorig\u001b[42Gnal asset fold\u001b[57Gr. This keep\u001b[70G massiv\u001b[78G source ass\u001b[90Gts out of the\u001b[104Ggame\u001b[109Gasse\u001b[114G\u001b[K\r\u001b[2C\u001b[1Brepo. A yaml\u001b[16Gfile with matching name of the \u001b[48Gource asset\u001b[60G(s\u001b[63Gdecar) would b\u001b[79Gable to ov\u001b[90Grride de\u001b[99Gault\u001b[104Gproces\u001b[111Ging\r\u001b[2C\u001b[1Bs\u001b[5Gtti\u001b[9G\u001b[K\u001b[27;1H\u001b[24;8H\u001b[?25h"]
