[5.534, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mHere's\u001b[10Gwhat\u001b[15GI've\u001b[20Grecorded\u001b[29Gfrom\u001b[34Gthat\u001b[39Gbatch\u001b[45Gso\u001b[48Gfar:\r\u001b[1B \u001b[3G- \u001b[1mContent needing dense geometry:\u001b[22m ship and station\u001b[54Gkits,\u001b[60Gmany\u001b[65Ginstances,\u001b[76Gand\u001b[80Gsurfaces.\r\u001b[4C\u001b[1B\u001b[1mRay-traced effects:\u001b[22m sun shadows, local-light shadows and AO. Refle\u001b[72Gtions stay scr\u001b[87Gen-space.\r\u001b[4C\u001b[1B\u001b[1mStill op\u001b[14Gn:\u001b[22m the minim\u001b[27Gm\u001b[29Ghar\u001b[33Gware, and how the g\u001b[53Gte checks the Mega Ge\u001b[75Gmetry path.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BWhat\u001b[8Gwould\u001b[14Gyou\u001b[18Glike\u001b[23Gto\u001b[26Gclarify?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMeanwhile,\u001b[14Gthe\u001b[18Gchecks\u001b[25Gon\u001b[28Gthe\u001b[32Gtranscript\u001b[43Ghave\u001b[48Gturned\u001b[55Gup:\r\u001b[2C\u001b[1B- \u001b[1mWrong name:\u001b[22m the operation that builds\u001b[43Gan object's\u001b[55Gacceleration\u001b[68Gstructure\u001b[78Gfrom\u001b[83Gits\u001b[87Gclusters\u001b[96Gis\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mVK_CLUSTER_ACCELERATION_STRUCTURE_OP_TYPE_BUILD_CLUSTERS_BOTTOM_LEVEL_NV\u001b[39m, n\u001b[81Gt\u001b[83G\u001b[38;2;177;185;249mBUILD_BLAS_FROM_CLUSTERS_NV\u001b[39m.\u001b[112GCluster\r\u001b[4C\u001b[1Bstructures can't be serialised either, so they're rebuilt on each run and\u001b[79Gcan't be cooked to disk.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHardware limits:\u001b[22G\u001b[22mthe \u001b[27Gxtension\u001b[36Gis NVIDIA-only and\u001b[55Gnot ra\u001b[62Gified. The per-cluster\u001b[85Gv\u001b[87Grtex and triangle\u001b[105Glimits\u001b[112Gcome\u001b[117Gfrom\r\u001b[2C\u001b[1B \u001b[5Gthe device, not a fix\u001b[27Gd 128. Plain \u001b[38;2;177;185;249mvulkaninfo\u001b[51G\u001b[39mdoes\u001b[56G'\u001b[59Gprint them, so the engine\u001b[85Gwill have to query the\u001b[108G itself.\u001b[117G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCompiler:\u001b[22m glslang\u001b[23G16.6 compiles a ray query using \u001b[38;2;177;185;249mrayQueryGetIntersectionClusterIdNV\u001b[90G\u001b[39mat our current \u001b[38;2;177;185;249mvulkan1.3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gtarget. The he\u001b[20Gders (1.4.363) have every s\u001b[48Gmbol.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRay tracing on lavapipe:\u001b[22m it's\u001b[35Gslow\u001b[40Gfor dense scenes,\u001b[58Gbut\u001b[62Gthe\u001b[66Greference\u001b[76Gviews\u001b[82Gare\u001b[86Gsmall.\r\u001b[4C\u001b[1B\u001b[1mmeshoptimizer v1.3\u001b[22m is MIT. \u001b[38;2;177;185;249mclusterlod.h\u001b[39m ha\u001b[48G a \u001b[38;2;177;185;249mclodDefaultConfigRT\u001b[39m preset for\u001b[82Gray\u001b[86Gtr\u001b[89Gcing.\u001b[95GNVIDIA's\u001b[104Gown\u001b[108GLOD\u001b[112Gsample\r\u001b[2C\u001b[1B \u001b[5G(\u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m, Apache-2.0) builds its hierarchy with a lightly\u001b[71Gmodified copy of it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCluster size:\u001b[22m NVIDIA's animated-c\u001b[39Gu\u001b[41Gter\u001b[46Gs\u001b[76G and 64 vert\u001b[89Gces.\u001b[94GThat\u001b[99Gcontradicts\u001b[111Gthe\u001b[27;1H\u001b[24;53H\u001b[?25h"]
