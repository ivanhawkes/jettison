[0.142, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242mg decision (MSAA or temporal AA) is due before it starts.** | J47 | — |                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 727 \u001b[22m | <a \u001b[38;2;166;226;46mid\u001b[39m=\u001b[38;2;230;219;116m\"j50\"\u001b[39m></a>J50. Visibil\u001b[43Gty buffer\u001b[53Gand\u001b[57Gsoftware\u001b[66Graster\u001b[73G|\u001b[75GOnly\u001b[80Gif\u001b[83GJ49's\u001b[89Gdecision\u001b[98Gchose\u001b[104Gtemporal\u001b[113GA\r\u001b[1B     \u001b[2m     \u001b[12G\u001b[22mA. | J49\u001b[21G|\u001b[23G—\u001b[25G|\r\u001b[6C\u001b[1B\u001b[2m728\r\u001b[6C\u001b[1B729\u001b[13G\u001b[22mracks A (J37\u001b[26Gto J43, g\u001b[36Gome\u001b[40Gry) \u001b[45Gnd\u001b[48GB (J42, J44 to J47, ray tracing)\u001b[81Gcan\u001b[85Galternate\u001b[95Gonce\u001b[100GJ37\u001b[104Gis\u001b[107Gdone.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/decisions.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 458 \u001b[22m   engine. [\u001b[38;2;230;219;116mDense geometry and ray tracing\u001b[39m](dense-geometry-and-ray-tracing.md)\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 459 \u001b[22m - **No dependency under a licence that forbids open-source use** (2026-11-25). NVIDIA's RTX SDKs\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 460 \u001b[22m   licence (NRD, RTXDI, RTXGI, RTXMG) forbids use that would put the SDK under an open-source licence,\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 461 -\u001b[38;2;248;248;242m  and FidelityFX 2 ships as binaries only, so the engine writes its own denoising.                    \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m461\u001b[14G\u001b[38;2;248;248;242mand\u001b[18GFidelityFX\u001b[29G2\u001b[31Gships\u001b[37Gas\u001b[40Gbinaries\u001b[49Gonly;\u001b[55GFidelityFX\u001b[66Gv1.1.4's\u001b[75GMIT\u001b[79Gshader\u001b[86Gsources\u001b[94Gare\u001b[98Gthe\u001b[102Gdenoisers'\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 462 +\u001b[38;2;248;248;242m  starting point.                                                                                     \r\u001b[6C\u001b[1B\u001b[49m\u001b[39m\u001b[2m463\u001b[14G\u001b[22m[\u001b[38;2;230;219;116mCoding standards\u001b[39m](coding-standards.md#dependencies)\r\u001b[6C\u001b[1B\u001b[2m464\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 465 \u001b[12G\u001b[22m##\u001b[15GProcess\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m●\u001b[39m Searching for \u001b[1m1\u001b[22m pattern…\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✽\u001b[3G\u001b[38;2;230;149;117mMetamorphosing…\u001b[20G\u001b[38;2;153;153;153m10m 30s · ↓\u001b[39m \u001b[38;2;153;153;153m21.2k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
