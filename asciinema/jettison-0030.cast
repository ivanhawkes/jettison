[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242md models; a reference view shows a generated asteroid                                                 \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[2m 457 \u001b[22m   at three dis\u001b[27Gances, e\u001b[36Gch at \u001b[43Gts level,\u001b[53Gwith\u001b[58Gno\u001b[61Gswitch\u001b[68Gback\u001b[73Gand\u001b[77Gforth\u001b[83Gat\u001b[86Ga\u001b[88Gthreshold.\r\u001b[1B     \u001b[2m 458 \u001b[12G\u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m### J38.\u001b[21GThe cook's watch\u001b[38Gmode\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/dense-geometry-and-ray-tracing.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 502 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 503 \u001b[22m ### J43. Streaming\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 504 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 505 -\u001b[38;2;248;248;242m- **Delivers.** Ranged reads in the VFS for loose and stored pack files; the feedback buffer\u001b[48;2;92;2;0m;\u001b[48;2;61;1;0m the     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 506 -\u001b[38;2;248;248;242m  page pool and its eviction; the coarsest levels pinned. The [geometry memory](#memory) budget, a    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 505 +\u001b[38;2;248;248;242m- **Delivers.** Ranged reads in the VFS for loose and stored pack files; the feedback buffer \u001b[48;2;4;71;0mand \u001b[48;2;2;40;0mthe  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 506 +\u001b[38;2;248;248;242m  pages' use stamps; traversal stopping at resident nodes; the page pool and its eviction; the        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 507 +\u001b[38;2;248;248;242m  coarsest levels pinned. The [\u001b[38;2;230;219;116mgeometry memory\u001b[38;2;248;248;242m](#memory) budget, a                                    \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[2m 508 \u001b[22m   setting, \u001b[24Gv\u001b[26Gr everything geometry holds\u001b[54Gon\u001b[57Gthe\u001b[61GGPU;\u001b[66Ga\u001b[68Gmodel\u001b[74Gon\u001b[77Gthe\u001b[81Gstreamed\u001b[90Gpath\u001b[95Guploads\u001b[103Gfrom\u001b[108Gits\r\u001b[1B     \u001b[2m 509 \u001b[12G\u001b[22m \u001b[14GGLB only the leve\u001b[32G rays\u001b[38Guse,\u001b[43Gnever\u001b[49Gthe\u001b[53Gfinest.\r\u001b[7C\u001b[1B\u001b[2m10\u001b[12G\u001b[22m-\u001b[14G**Exit\u001b[21Gcriterion.**\u001b[34GWith\u001b[39Ga\u001b[41Gpool\u001b[46Gsmaller\u001b[54Gthan\u001b[59Gthe\u001b[63Gscene,\u001b[70Ga\u001b[72Gcamera\u001b[79Gflight\u001b[86Gon\u001b[89Glavapipe\u001b[98Gends\u001b[103Gon\u001b[106Gthe\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/dense-geometry-and-ray-tracing.m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
