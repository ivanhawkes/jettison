[0.663, "o", "\u001b[?25l\u001b[H\u001b[3GWhat\u001b[8Gwould\u001b[14Gyou\u001b[18Glike\u001b[23Gto\u001b[26Gclarify?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BMeanwhile, the checks on the transcript\u001b[43Ghave turned\u001b[55Gup:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWrong name:\u001b[22m the operation that builds an object's acceleration structure fr\u001b[81Gm\u001b[83Gits clusters is\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mVK_CLUSTER_ACCELERATION_STRUCTURE_OP_TYPE_BUILD_CLUSTERS_BOTTOM_LEVEL_NV\u001b[39m,\u001b[79Gnot \u001b[38;2;177;185;249mBUILD_BLAS_FROM_CLUSTERS_NV\u001b[39m.\u001b[112GCluster\r\u001b[2C\u001b[1B \u001b[5Gstructures can't\u001b[22Gbe s\u001b[27Grialised\u001b[36Geither, so they're\u001b[55Grebuil\u001b[62G on each run and can't\u001b[85Gb\u001b[87G cooked to disk.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mHardware limits:\u001b[22m the \u001b[27Gxtension is NVIDIA-only\u001b[51Gand \u001b[56Go\u001b[59Gratified. The per-cluster\u001b[85Gvertex and triangle li\u001b[108Gits come\u001b[117Gfrom\r\u001b[2C\u001b[1B \u001b[5Gthe device, not a\u001b[23Gfixed 128. Plain \u001b[38;2;177;185;249mvulkaninfo\u001b[39m doesn't print them, so the engine will\u001b[90Ghave to query them itself.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCompiler:\u001b[22m glsl\u001b[20Gng 16.6 compiles a ray quer\u001b[48G using\u001b[55G\u001b[38;2;177;185;249mrayQueryGetIntersectionClusterIdNV\u001b[90G\u001b[39mat\u001b[93Gour\u001b[97Gcurrent\u001b[105G\u001b[38;2;177;185;249mvulkan1.3\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gtarget. The headers (1.4.363)\u001b[35Ghave\u001b[40Gevery symbol.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mRay tracing on lavapipe:\u001b[22m it's slow for den\u001b[48Ge scenes, but the reference views\u001b[82Gare\u001b[86Gsm\u001b[89Gll.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mmeshoptimizer v1.3\u001b[22m is MIT. \u001b[38;2;177;185;249mclusterlod.h\u001b[39m has a \u001b[38;2;177;185;249mclodDefaultConfigRT\u001b[71G\u001b[39mpreset for ray tracing.\u001b[95GNVIDIA's\u001b[104Gown\u001b[108GLOD\u001b[112Gsample\r\u001b[2C\u001b[1B \u001b[5G(\u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m, Apache-2.0) bui\u001b[39Gd\u001b[41G it\u001b[46Ghierarchy with a ligh\u001b[68Gly modified copy of \u001b[89Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCluster size:\u001b[22m NVIDIA's animated-clu\u001b[41Gters samp\u001b[51Ge recommends\u001b[64G64 tri\u001b[71Gngles and\u001b[81G64 vertices. That\u001b[99Gcontradicts\u001b[111Gthe\r\u001b[2C\u001b[1B \u001b[5Gtranscript's \"128/128\u001b[27Gis the\u001b[35Gweet \u001b[41Gpot\". I'll\u001b[52Gmeasure the size rather than pick one now.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSample framework:\u001b[22m the\u001b[27GNVIDIA\u001b[34Gsamples\u001b[42Gdepend\u001b[49Gon\u001b[52Gtheir\u001b[58Gown\u001b[62G\u001b[38;2;177;185;249mnvpro_core2\u001b[74G\u001b[39mframework.\u001b[85GThey're\u001b[93Greferences\u001b[104Gto\u001b[107Gread,\u001b[113Gnot\r\u001b[4C\u001b[1Bdependencies\u001b[18Gto\u001b[21Gadd.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne thing I haven't se\u001b[26Gtled is whether \u001b[38;2;177;185;249mVK_EXT_cluster_acceleration_structure\u001b[80G\u001b[39mexists\u001b[87Ganywhere:\u001b[97Gthe\u001b[101Gregistry\u001b[110Gpage\r\u001b[2C\u001b[1Breturned\u001b[12G403,\u001b[17Gthough\u001b[24Git\u001b[27Gisn't\u001b[33Gon\u001b[36Gthis\u001b[41Gdriver\u001b[48Geither\u001b[55Gway.\r\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
