[0.162, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[4C\u001b[1BThe Nanit\u001b[15G backgro\u001b[24Gnd is\u001b[30Gfolded\u001b[37Ginto\u001b[42Git.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mroadmap.md\u001b[39m:\r\u001b[4C\u001b[1B\u001b[22m- A\u001b[9Gnew s\u001b[15Gction, \"A separate track: dense\u001b[47Ggeometry\u001b[56Gand\u001b[60Gray\u001b[64Gtracing\",\u001b[74Gwith\u001b[79Gone\u001b[83Grow\u001b[87Gper\u001b[91Gstage:\u001b[98Gwhat\u001b[103Git\u001b[106Gis,\u001b[110Gwhat\u001b[115Git\r\u001b[2C\u001b[1B \u001b[5G  waits on,\u001b[17Gand\u001b[21Gwhich\u001b[27Gbacklog\u001b[35Gitems\u001b[41Git\u001b[44Gtouches.\r\u001b[6C\u001b[1BJ27's\u001b[13Gl\u001b[15Gvel-of-detail \u001b[30Gow moved to J37,\u001b[47Gand i\u001b[53Gs spot\u001b[60Gand\u001b[64Gpoint shadows r\u001b[80Gw now point\u001b[92G to J45.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GIn \"Waiting on you\", the Nan\u001b[38G line\u001b[44Gis replaced\u001b[56Gby\u001b[59Gone\u001b[63Gfor\u001b[67Gblend\u001b[73Gspaces\u001b[80Gand\u001b[84Gblend\u001b[90Gshapes.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m\u001b[K\r\u001b[6C\u001b[1BRay trac\u001b[18G, occl\u001b[25Gsion culling,\u001b[39Ggeometry streaming,\u001b[59Gmeshlets, the\u001b[73Gcook, r\u001b[81Gy-trace\u001b[93Gdows\u001b[98Gand\u001b[102GAO,\u001b[106Gand\u001b[110Gblend\r\u001b[2C\u001b[1B \u001b[5G  shapes and\u001b[18Gspaces\u001b[25Gare\u001b[29Gnow\u001b[33GOpen.\r\u001b[6C\u001b[1BThe\u001b[11Gvisibility buffer is Deferred, and vir\u001b[50Gual shadow maps are Out.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GWindows and terrain stay Out.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[22m \u001b[20Gen new decisions, \u001b[39Gach link\u001b[48Gng back to the \u001b[64Glan. The 2026-11-11\u001b[84Gdecision\u001b[93Gagainst\u001b[101Gscreen-space\r\u001b[4C\u001b[1Breflections stands: reflections\u001b[37Gcome\u001b[42Gfrom\u001b[47Gray\u001b[51Gtracing,\u001b[60Gnot\u001b[64Gscreen\u001b[71Gspace.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mglos\u001b[10Gary.md\u001b[39m:\u001b[22m acceleration \u001b[32Gtructure, cook (and the\u001b[56Gc\u001b[58Gok setti\u001b[67Ggs file), depth pyramid, meshlet,\u001b[101Gmeshlet hierarchy.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mcoding-standards.md\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- A dependency's \u001b[23Gicence must allow open-source distribution.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Facts about APIs, drivers\u001b[33Gand\u001b[37Gdevices\u001b[45Gare\u001b[49Gchecked\u001b[57Gagainst\u001b[65Gprimary\u001b[73Gsources\u001b[81Gand\u001b[85Gdated.\r\u001b[8C\u001b[1Bn\u001b[11Gw \"GPU code\" s\u001b[26Gction: one table of devi\u001b[53Gcapab\u001b[59Gli\u001b[63Ges,\u001b[67GGPU\u001b[71Gstruct\u001b[78Glayouts\u001b[86Gchecked\u001b[94Gat\u001b[97Gbuild\u001b[103Gtime,\u001b[109Ga\u001b[111Gfixed\r\u001b[4C\u001b[1B \u001b[7Gorder\u001b[13Gwherever it\u001b[26Gecide\u001b[35G image, and variants built from one source.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.241, "o", "\u001b[?25l\u001b[H\u001b[5GThe\u001b[9GNanite\u001b[16Gbackground\u001b[27Gis\u001b[30Gfolded\u001b[37Ginto\u001b[42Git.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mroadmap.md\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- A new section,\u001b[22G\"A\u001b[25Gseparate\u001b[34Gtrack:\u001b[41Gdense\u001b[47Ggeometry\u001b[56Gand\u001b[60Gray\u001b[64Gtracing\",\u001b[74Gwith\u001b[79Gone\u001b[83Grow\u001b[87Gper\u001b[91Gstage:\u001b[98Gwhat\u001b[103Git\u001b[106Gis,\u001b[110Gwhat\u001b[115Git\r\u001b[4C\u001b[1B \u001b[7Gwaits\u001b[13Gon, and which b\u001b[29Gcklog items\u001b[41Git touches.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GJ27'\u001b[13Glevel-of-detail row moved to J37, and its\u001b[55Gspot\u001b[60Gand\u001b[64Gpoint\u001b[70Gshadows\u001b[78Grow\u001b[82Gnow\u001b[86Gpoints\u001b[93Gto\u001b[96GJ45.\r\u001b[6C\u001b[1BIn \"Waiting \u001b[20Gn you\", the Nanite\u001b[39Gline is\u001b[47Greplaced by one for blend spaces and blend shapes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mscope.md\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Ray tracing,\u001b[20Gocclusion\u001b[30Gculling,\u001b[39Ggeometry\u001b[48Gstreaming,\u001b[59Gmeshlets,\u001b[69Gthe\u001b[73Gcook,\u001b[79Gray-traced\u001b[90Gshadows\u001b[98Gand\u001b[102GAO,\u001b[106Gand\u001b[110Gblend\r\u001b[4C\u001b[1B \u001b[7Gshapes and spa\u001b[22Ges are now Open.\u001b[39G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GT\u001b[9Ge visibility buffer\u001b[29Gis Def\u001b[36Grred,\u001b[42Gand\u001b[46Gvirtual\u001b[54Gshadow\u001b[61Gmaps\u001b[66Gare\u001b[70GOut.\r\u001b[6C\u001b[1BWindow\u001b[14G and \u001b[20Gerrain stay\u001b[32GOut.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mdecisions.md\u001b[39m:\u001b[21G\u001b[22mn new\u001b[27Gdecisions,\u001b[38Geach\u001b[43Glinking\u001b[51Gback\u001b[56Gto\u001b[59Gthe\u001b[63Gplan.\u001b[69GThe\u001b[73G2026-11-11\u001b[84Gdecision\u001b[93Gagainst\u001b[101Gscreen-space\r\u001b[2C\u001b[1B \u001b[5Greflections stands: reflect\u001b[36G come from ray\u001b[51Gtracing, not screen space.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mglossary.md\u001b[39m:\u001b[22m acceleration structure,\u001b[42Gco\u001b[45Gk\u001b[47G(\u001b[49Gnd the cook settings file), depth\u001b[83Gpyramid,\u001b[92Gmeshlet,\u001b[101Gmeshlet\u001b[109Ghierarchy.\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mcoding-standards.md\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- A dependency's licence\u001b[30Gmust\u001b[35Gallow\u001b[41Gopen-source\u001b[53Gdistribution.\r\u001b[6C\u001b[1BFacts about APIs, drivers and devices are ch\u001b[52Gcked against primary\u001b[73Gsources\u001b[81Gand\u001b[85Gdated.\r\u001b[6C\u001b[1BA new\u001b[13G\"GPU code\" section:\u001b[33Go\u001b[35Ge\u001b[37Gtable of d\u001b[48Gvic\u001b[52G capabil\u001b[61Gties, GPU struct layouts ch\u001b[89Gcked\u001b[94Gat\u001b[97Gbuild\u001b[103Gtime,\u001b[109Ga\u001b[111Gfixed\r\u001b[4C\u001b[1B \u001b[7Gord\u001b[11Gr\u001b[13Gwherever it dec\u001b[29Gdes\u001b[33Ga\u001b[35G im\u001b[39Gge,\u001b[43Gand variants bu\u001b[60Gt from\u001b[67Gone\u001b[72Gour\u001b[76Ge.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mrendering.md\u001b[39m and \u001b[38;2;177;185;249mREADME.md\u001b[39m:\u001b[33G\u001b[22mlinks update\u001b[46G. \u001b[38;2;177;185;249mnanite-research.md\u001b[67G\u001b[39mis deleted\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
