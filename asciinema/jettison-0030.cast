[0.059, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3GMeanwhile, the checks on the transcript have turned up:\u001b[K\r\u001b[1B  - \u001b[1mWrong name:\u001b[22m the operation\u001b[31Gthat\u001b[36Gbuilds\u001b[43Gan\u001b[46Gobject's\u001b[55Gacceleration\u001b[68Gstructure\u001b[78Gfrom\u001b[83Gits\u001b[87Gclusters\u001b[96Gis\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mVK_CLUSTER_ACCELERATION_STRUCTURE_OP_TYPE_BUILD_CLUSTERS_BOTTOM_LEVEL_NV\u001b[39m,\u001b[79Gnot\u001b[83G\u001b[38;2;177;185;249mBUILD_BLAS_FROM_CLUSTERS_NV\u001b[39m.\u001b[112GCluster\r\u001b[1B \u001b[3G  struc\u001b[11Gures can't \u001b[23Ge serialised either, so they're \u001b[56Gebuilt\u001b[63Gon\u001b[66Geach\u001b[71Grun\u001b[75Gand\u001b[79Gcan't\u001b[85Gbe\u001b[88Gcooked\u001b[95Gto\u001b[98Gdisk.\r\u001b[1B  - \u001b[1mHardware limits:\u001b[22m the\u001b[26Gextension\u001b[36Gis\u001b[39GNVIDIA-only\u001b[51Gand\u001b[55Gnot\u001b[59Gratified.\u001b[69GThe\u001b[73Gper-cluster\u001b[85Gvertex\u001b[92Gand\u001b[96Gtriangle\u001b[105Glimits\u001b[112Gcome\u001b[117Gfrom\r\u001b[4C\u001b[1Bthe\u001b[9Gdevice,\u001b[17Gnot\u001b[21Ga\u001b[23Gfixed 128.\u001b[34GPlain\u001b[40G\u001b[38;2;177;185;249mvulkaninfo\u001b[51G\u001b[39mdoesn't\u001b[59Gprint\u001b[65Gthem,\u001b[71Gso\u001b[74Gthe\u001b[78Gengine\u001b[85Gwill\u001b[90Ghave\u001b[95Gto\u001b[98Gquery\u001b[104Gthem\u001b[109Gitself.\r\u001b[1B \u001b[3G- \u001b[1mCompiler:\u001b[15G\u001b[22mgl\u001b[18Glang 16.6 compiles a ray\u001b[43Gquery\u001b[49Gusing\u001b[55G\u001b[38;2;177;185;249mrayQueryGetIntersectionClusterIdNV\u001b[90G\u001b[39mat\u001b[93Gour\u001b[97Gcurrent\u001b[105G\u001b[38;2;177;185;249mvulkan1.3\r\u001b[1B\u001b[39m    target. The headers (1.4.363) have every symbol.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRay tracing on lavapipe:\u001b[22m it's\u001b[35Gslow\u001b[40Gfor\u001b[44Gdense\u001b[50Gscenes,\u001b[58Gbut\u001b[62Gthe\u001b[66Greference\u001b[76Gviews\u001b[82Gare\u001b[86Gsmall.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mmeshoptimizer v1.3\u001b[22m is MIT. \u001b[38;2;177;185;249mclusterlod.h\u001b[39m has a \u001b[38;2;177;185;249mclodDefaultConfigRT\u001b[39m preset for ray tracing. NVIDIA's own LOD sample\r\u001b[4C\u001b[1B(\u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m,\u001b[23GApache-2.0)\u001b[35Gbuilds\u001b[42Gits\u001b[46Ghierarchy\u001b[56Gwith\u001b[61Ga\u001b[63Glightly\u001b[71Gmodified\u001b[80Gcopy\u001b[85Gof\u001b[88Git.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCluster size:\u001b[22m NVIDIA's animated-clusters sample recommends 64 triangles and 64 vertices. That contradicts the\r\u001b[4C\u001b[1Btranscript's \"128/128 is the sweet spot\". I'll measure the size rather than pick one now.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSample framework:\u001b[23G\u001b[22mthe\u001b[27GNVIDIA\u001b[34Gsamples\u001b[42Gdepend\u001b[49Gon\u001b[52Gtheir\u001b[58Gown\u001b[62G\u001b[38;2;177;185;249mnvpro_core2\u001b[74G\u001b[39mframework.\u001b[85GThey're\u001b[93Greferences\u001b[104Gto\u001b[107Gread,\u001b[113Gnot\r\u001b[1B \u001b[3G  dependenci\u001b[16Gs to add.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOne thing I haven't settled is whether \u001b[38;2;177;185;249mVK_EXT_cluster_acceleration_structure\u001b[39m exists anywhere: the registry page\u001b[K\r\u001b[2C\u001b[1Breturned\u001b[12G403,\u001b[17Gthough\u001b[24Git\u001b[27Gisn't\u001b[33Gon\u001b[36Gthis\u001b[41Gdriver\u001b[48Geither\u001b[55Gway.\r\u001b[25C\u001b[2B\u001b[38;2;153;153;153m2\u001b[28G4\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
