[0.083, "o", "\u001b[?25l\u001b[H\u001b[3G├───────────────┼─────────────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[1B \u001b[3G│ Artists       │ A development\u001b[35Gbuild's\u001b[43G\u001b[38;2;177;185;249mResourceManager\u001b[59G\u001b[39mhot-reloads\u001b[71Gloaded\u001b[78Gfiles\u001b[84Gthat\u001b[89Gchange.\u001b[97GA\u001b[99Gcooked\u001b[106Gfile\u001b[117G│\r\u001b[2C\u001b[1B│\u001b[5Gseeing\u001b[19G│\u001b[21Gdropped\u001b[29Ginto\u001b[34Gthe\u001b[38Ggame's\u001b[45Gasset\u001b[51Gfolder\u001b[58Gshows\u001b[64Gup\u001b[67Gin\u001b[70Gthe\u001b[74Grunning\u001b[82Ggame.\u001b[117G│\r\u001b[1B  │ changes live  │                                                                                                 │\u001b[K\r\u001b[1B  ├───────────────┼─────────────────────────────────────────────────────────────────────────────────────────────────┤\u001b[K\r\u001b[1B  │ Defaults with │ The engine's layered definitions (merge patches) already merge YAML. They handle engine         │\u001b[K\r\u001b[1B  │  overrides    │ defaults, then the game's \u001b[38;2;177;185;249mcook.yaml\u001b[39m, then \u001b[38;2;177;185;249mbig-ship.gltf.yaml\u001b[39m.                                   │\u001b[K\r\u001b[1B  └───────────────┴─────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mWhat I'd propose:\u001b[22m\u001b[K\r\u001b[1B  - \u001b[38;2;177;185;249m\u001b[1mjettison_cook\u001b[22m\u001b[39m, an engine tool in \u001b[38;2;177;185;249msource/tools/cook\u001b[39m, CPU-only, on the \u001b[38;2;177;185;249mgeometry\u001b[39m module.\u001b[K\r\u001b[1B    - \u001b[38;2;177;185;249mjettison_cook <src> <dst>\u001b[39m cooks once: the same input gives the same output bytes, so committed cooked files don't\u001b[K\r\u001b[6C\u001b[1Bchurn.\r\u001b[1B \u001b[3G  - \u001b[38;2;177;185;249m--watch\u001b[39m is\u001b[18Gyour daemon. It watches the sourc\u001b[53Gtree with inotify, debounces\u001b[82Gc\u001b[84Gang\u001b[89G, \u001b[93Goks on the j\u001b[106Gb threads,\u001b[117Gand\r\u001b[2C\u001b[1B    writes \u001b[16Gomically.\u001b[K\r\u001b[2C\u001b[1B  - A cook rec\u001b[18Grd in the output (hashes \u001b[44Gf\u001b[46Gthe sour\u001b[55Ge, it\u001b[61G sidec\u001b[68Gr and the tool)\u001b[84Gskips what hasn't\u001b[102Gchanged\u001b[110Gand\u001b[114Gdeletes\r\u001b[6C\u001b[1Boutputs\u001b[15Gwhose\u001b[21Gsource\u001b[28Gis\u001b[31Ggone.\r\u001b[1B \u001b[3G- \u001b[1mInside the tool\u001b[22m, everything runs i\u001b[40G-process:\u001b[K\r\u001b[1B    - tangents with mikktspace, which is already a dependency;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gmeshoptimizer's\u001b[23Gcache\u001b[29Goptimisation,\u001b[43GLODs\u001b[48Gand\u001b[52Gmeshlet\u001b[60Ghierarchy;\r\u001b[1B \u001b[3G  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
