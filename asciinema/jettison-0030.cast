[0.006, "o", "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mRhubarb\u001b[11GLip\u001b[15GSync\u001b[20Gchecked\u001b[28Gout:\u001b[33Git's\u001b[38GMIT-licensed\u001b[51Gwith\u001b[56Gpermissive\u001b[67Gdependencies,\u001b[81Gstill\u001b[87Gmaintained,\u001b[99Gand\u001b[103Ghas\u001b[107Ga\u001b[109GLinux\u001b[115Gbuild.\r\u001b[1B \u001b[3GIts word recog\u001b[18Gition only works in\u001b[38GEnglish, \u001b[48Go for French, German and Japanese it would f\u001b[93Gll back to \u001b[105G less precise\u001b[K\r\u001b[2C\u001b[1Blanguage-independent\u001b[24Gmode, and it fits a\u001b[44G an exte\u001b[53Gnal program the\u001b[69Gcook runs rather than\u001b[91Ga \u001b[94Ginked libr\u001b[105Gry.\u001b[38;2;153;153;153m · summary\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[47C\u001b[2B ☒ Schedule \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ✔ Submit \u001b[49m\u001b[38;2;153;153;153m →\r\u001b[2B\u001b[38;2;255;255;255m\u001b[1mRevi\u001b[6Gw\u001b[8Gyour answers\u001b[22m\u001b[39m\u001b[K\r\u001b[2B \u001b[2m│\u001b[22m ●\u001b[6GWhere should morphing\u001b[28Gand\u001b[32Gskinning\u001b[41Grun?\u001b[46GJ42\u001b[50Galready\u001b[58Gplans\u001b[64Ga\u001b[66Gcompute\u001b[74Gpass\u001b[79Gthat\u001b[84Gskins\u001b[90Gonce\u001b[95Gper\u001b[99Gframe,\u001b[106Gwhich\u001b[112Gray\r\u001b[1C\u001b[1B\u001b[2m│\u001b[6G\u001b[22mtracing needs.\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Compute, brought forward (Rec.)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[22m ●\u001b[6GThe \u001b[11Gig loader\u001b[21Grefuses\u001b[29Ga\u001b[31Gmodel\u001b[37Gwith\u001b[42Gmore\u001b[47Gthan\u001b[52Gone\u001b[56Gmesh\u001b[61Gnode.\u001b[67GCharacters\u001b[78Gusually\u001b[86Ghave\u001b[91Gseveral\u001b[99G(body,\u001b[106Geyes,\u001b[112Gteeth,\r\u001b[1C\u001b[1B\u001b[2m│\u001b[6G\u001b[22mclothing). Lift the limit?\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Several meshes (Rec.)\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m│\u001b[22m ●\u001b[6GPort\u001b[11Gaits\u001b[16Gput faces close\u001b[32Gup.\u001b[36GScope\u001b[42Ghas\u001b[46Gskin,\u001b[52Ghair\u001b[57Gand\u001b[61Gfaces\u001b[67GOut.\u001b[72GWhat\u001b[77Gshading\u001b[85Gcomes\u001b[91Gwith\u001b[96Gthis?\r\u001b[3C\u001b[1B\u001b[38;2;78;186;101m→ Skin, eyes, hair\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m│\u001b[22m ● When should this\u001b[23Gtrack\u001b[29Gbe\u001b[32Gbuilt,\u001b[39Gagainst\u001b[47Gthe\u001b[51Gdense\u001b[57Ggeometry\u001b[66Gand\u001b[70Gray\u001b[74Gtracing\u001b[82Gtrack\u001b[88G(J36\u001b[93Gto\u001b[96GJ50)?\r\u001b[1B   \u001b[38;2;78;186;101m→ After J37 (Rec.)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1. \u001b[38;2;177;185;249mSubmit answers\r\u001b[1B\u001b[39m  \u001b[38;2;153;153;153m2. \u001b[39mCancel\u001b[K\u001b[27;1H\u001b[25;1H"]
