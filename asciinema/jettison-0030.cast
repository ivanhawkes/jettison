[0.018, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m5\u001b[14G\u001b[38;2;248;248;242mthe same source (`jettison_compile_shader_variant`), not a\u001b[73Gcopy, so the paths cannot\u001b[99Gdrift\u001b[105Gapart.\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242m \u001b[14G     \u001b[20G       \u001b[28G        \u001b[37G   \u001b[41G           \u001b[53G \u001b[55G       \u001b[63G    \u001b[68G       \u001b[76G  \u001b[79G \u001b[81G      \u001b[88G       \u001b[96G  \u001b[99G \u001b[101G       \u001b[109G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 357 \u001b[22m ## Testing\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 358 \u001b[22m\u001b[K\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m- Ev\u001b[17Gry module\u001b[27Ghas\u001b[31Ga\u001b[33Gdoctest\u001b[41Gsuite;\u001b[48Gwork\u001b[53Gis\u001b[56Gnot\u001b[60Gdone\u001b[65Guntil\u001b[71Gits\u001b[75Gsuite\u001b[81Gcovers\u001b[88Gits\u001b[92Gexit\u001b[97Gcriterion.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/coding-standards.m\u001b[34G)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[2m 360 \u001b[22m - Serialisa\u001b[24Gion ha\u001b[31G round-trip\u001b[43Gtests.\u001b[50GSimulation\u001b[61Ghas\u001b[65Greplay\u001b[72Gtests\u001b[78Gof\u001b[81Gthe\u001b[85Gstate\u001b[91Ghash\r\u001b[1B     \u001b[2m 361 \u001b[12G\u001b[22m \u001b[14G([\u001b[38;2;230;219;116msimulation code\u001b[39m](#simulation-code)).\r\u001b[8C\u001b[1B\u001b[2m2\u001b[14G\u001b[22mGPU paths are\u001b[28Gcove\u001b[33Ged by the\u001b[43Gh\u001b[45Gadless [\u001b[38;2;230;219;116msmoke test\u001b[39m](glossary.md#smoke-te\u001b[87G), judged\u001b[97Gon\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 363 -\u001b[38;2;248;248;242m  validation-layer output as well as exit status ([build and gates](build-and-gates.md)).             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 363 +\u001b[38;2;248;248;242m  validation-layer output as well as exit status ([\u001b[38;2;230;219;116mbuild and gates\u001b[38;2;248;248;242m](build-and-gates.md)).\u001b[48;2;4;71;0m An\u001b[48;2;2;40;0m          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 364 +\u001b[38;2;248;248;242m  optional path is covered both on and forced off ([\u001b[38;2;230;219;116mGPU code\u001b[38;2;248;248;242m](#gpu-code)).                            \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[2m 365 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 366 \u001b[22m ## Commits\u001b[K\r\u001b[8C\u001b[1B\u001b[2m7\r\u001b[5C\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWorking…\u001b[27;1H\u001b[24;3H\u001b[?25h"]
