[0.254, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BVMA\u001b[7G3.5\u001b[11Gpicks\u001b[17Gup\u001b[20G1.4\u001b[24Gfrom\u001b[29Gthe\u001b[33Gheaders.\u001b[42GAll\u001b[46Gthree\u001b[52Gdevices\u001b[60Ghere\u001b[65Greport\u001b[72G1.4.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it loses:\u001b[18G\u001b[22mdevices\u001b[26Gwhose\u001b[32Gdrivers\u001b[40Gstop\u001b[45Gat\u001b[48G1.3,\u001b[53Gsuch\u001b[58Gas\u001b[61GGCN1–2,\u001b[69Gor\u001b[72GMesa\u001b[77Gbefore\u001b[84G25.0.\u001b[90GNone\u001b[95Gof\u001b[98Gthem\u001b[103Ghas\u001b[107Gray\u001b[111Gqueries\u001b[119Gor\r\u001b[2C\u001b[1Bmesh shaders. Ev\u001b[20Gry device that has bo\u001b[42Gh reports 1.4 on a\u001b[61Gcurrent\u001b[69Gd\u001b[71Giv\u001b[74Gr (NVIDIA\u001b[84GTuring a\u001b[93Gd\u001b[95Gnewer, RADV\u001b[107Gon GFX8 and\u001b[119G\u001b[K\r\u001b[2C\u001b[1Bn\u001b[5Gwer, Arc, lavapipe). I recommend moving as s\u001b[50Gep 0.\u001b[56G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Samples and SDKs: none of them is a dependency except meshoptimizer\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mmeshoptimizer (MIT)\u001b[25G\u001b[22mis\u001b[28Gthe\u001b[32Gonly\u001b[37Greal\u001b[42Gdependency.\u001b[54GIt\u001b[57Gprovides\u001b[66Gthe\u001b[70Gmeshlets,\u001b[80Gthe\u001b[84GLOD\u001b[88Ghierarchy,\u001b[99Gthe\u001b[103Gray-tracing\r\u001b[2C\u001b[1B \u001b[5Gcluster preset, and\u001b[25Ga meshlet cod\u001b[39Gc for str\u001b[49Gaming.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA \u001b[38;2;177;185;249mnvpro-samples\u001b[39m (Apache-2.0)\u001b[22m are the \u001b[49Gferences\u001b[58Gto\u001b[61Gread:\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m: the closest to\u001b[39Gth\u001b[43Gw\u001b[45Gole plan.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249manimated_clusters\u001b[39m: deforming\u001b[39Gmeshes, relevant\u001b[56Gto\u001b[59Gthe\u001b[63Gblend\u001b[69Gshapes\u001b[76Gnoted\u001b[82Gbelow.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mtessellated_clusters\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mraytracing_tutorial_KHR\u001b[39m:\u001b[35Gray-query\u001b[45Gshadows\u001b[53Gand\u001b[57GAO.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mmini_samples\u001b[39m: mesh shaders, position fetch.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mnv\u001b[10Gcluster_*\u001b[39m build\u001b[26Grs\u001b[29Gand \u001b[38;2;177;185;249mvk_raytrace\u001b[39m: archived.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mvk\u001b[10Gpartitioned_tlas\u001b[39m: h\u001b[30Gs no licence file, so it can't\u001b[61Gbe\u001b[64Greused.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA RTX SDKs (NRD, RTXDI, RTXGI, RTXMG)\u001b[22m u\u001b[50Ge\u001b[52Ga proprietary licence.\u001b[75GClause\u001b[82G4e\u001b[85Gforbids\u001b[93Gusing\u001b[99Gthem\u001b[104Gin\u001b[107Ga\u001b[109Gway\u001b[113Gthat\r\u001b[2C\u001b[1B \u001b[5Gputs them under an open-source licence. NRD is\u001b[52Gthe \u001b[57Gnly productio\u001b[71G denoiser,\u001b[82Git's HLSL-only, and it's\u001b[109Glegal\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.150, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhat it loses:\u001b[22m devices whose drivers stop a\u001b[47G 1.3, such as GCN1–2, or\u001b[72GMesa\u001b[77Gbefore\u001b[84G25.0.\u001b[90GNone\u001b[95Gof\u001b[98Gthem\u001b[103Ghas\u001b[107Gray\u001b[111Gqueries\u001b[119Gor\r\u001b[2C\u001b[1Bmesh\u001b[8Gshaders.\u001b[17GEvery\u001b[23Gdevice\u001b[30Gthat\u001b[35Ghas\u001b[39Gboth\u001b[44Greports\u001b[52G1.4\u001b[56Gon\u001b[59Ga\u001b[61Gcurrent\u001b[69Gdriver\u001b[76G(NVIDIA\u001b[84GTuring\u001b[91Gand\u001b[95Gnewer,\u001b[102GRADV\u001b[107Gon\u001b[110GGFX8\u001b[115Gand\r\u001b[2C\u001b[1Bnewer, Arc, lavapipe).\u001b[26GI recommend moving\u001b[46Gs\u001b[48Gstep\u001b[53G0.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m4. Samples and SDKs: none of them is a dependency except meshoptimizer\r\u001b[2C\u001b[2B\u001b[22m- \u001b[1mmeshoptimizer (MIT)\u001b[22m is the only real dependency. It provides the meshlets,\u001b[80Gthe\u001b[84GLOD\u001b[88Ghierarchy,\u001b[99Gthe\u001b[103Gray-tracing\r\u001b[4C\u001b[1Bcluster\u001b[13Gpreset,\u001b[21Gand\u001b[25Ga\u001b[27Gmeshlet\u001b[35Gcodec\u001b[41Gfor\u001b[45Gstreaming.\r\u001b[4C\u001b[1B\u001b[1mNVIDIA \u001b[38;2;177;185;249mnvpro-samples\u001b[39m (Apache-2.0)\u001b[22m \u001b[40Gre th\u001b[46G r\u001b[49Gferences t\u001b[60G read:\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;177;185;249mvk_lod_clusters\u001b[39m: the clos\u001b[33Gst to the whole pla\u001b[53G.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mvk_animated_clusters\u001b[39m: deforming\u001b[39Gmeshes,\u001b[49Gl\u001b[51Gva\u001b[54Gt to the blend\u001b[69Gshapes\u001b[76Gnoted\u001b[82Gbelow.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mtesse\u001b[16Gla\u001b[20Gd_clusters\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mraytracing_tu\u001b[24Go\u001b[26Gial_KHR\u001b[39m: ray-query shadows and AO.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mmini_samples\u001b[39m: mesh shaders,\u001b[38Gposition\u001b[47Gfetch.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mnv\u001b[10Gcluster_*\u001b[39m builders and \u001b[38;2;177;185;249mvk_raytrace\u001b[39m: archived.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mpartitioned_tlas\u001b[39m: has no licence file, so it\u001b[55Gcan't\u001b[61Gbe\u001b[64Greused.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNVIDIA RTX SDKs (NRD, RTXDI, RTXGI, RTXMG)\u001b[22m use a proprietary\u001b[66Glicence.\u001b[75GClause\u001b[82G4e\u001b[85Gforbids\u001b[93Gusing\u001b[99Gthem\u001b[104Gin\u001b[107Ga\u001b[109Gway\u001b[113Gthat\r\u001b[4C\u001b[1Bputs them under an open-source licence. NRD\u001b[49Gis\u001b[52Gthe o\u001b[58Gly\u001b[61Gproduction\u001b[72Gdenoiser,\u001b[82Git's\u001b[87GHLSL-only,\u001b[98Gand\u001b[102Git's\u001b[107Ga\u001b[109Glegal\r\u001b[2C\u001b[1B \u001b[5Gquestion rather than a technical one.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
