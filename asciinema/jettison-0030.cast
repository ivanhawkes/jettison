[0.170, "o", "\u001b[?25l\u001b[H \u001b[3Gthe test content, say which and\u001b[35GI'll go thro\u001b[48Ggh that\u001b[56Gone ins\u001b[64Gead.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhere the device-free mesh work lives\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat has to live somewhere:\r\u001b[2C\u001b[1B\u001b[22m- reading a glTF file's triangles;\r\u001b[4C\u001b[1Bsimplifyin\u001b[16G them into\u001b[27GLODs (m\u001b[36Ghoptimizer);\r\u001b[4C\u001b[1Bbuild\u001b[11Gng the m\u001b[20Gshle\u001b[25G LOD hierarchy (\u001b[38;2;177;185;249mclusterlod.h\u001b[39m);\r\u001b[4C\u001b[1Breading and writing the cooked page format that streaming\u001b[63Guses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNone\u001b[8Gof\u001b[11Gthis\u001b[16Gtouches\u001b[24Gthe\u001b[28GGPU.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the code says today:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mThe glTF g\u001b[16Gometry re\u001b[26Gder is in \u001b[38;2;177;185;249mrender\u001b[43G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mrender/src/vulkan/ModelGltf.cpp\u001b[39m).\u001b[78G\u001b[38;2;177;185;249mrender\u001b[85G\u001b[39monly\u001b[90Gbuilds\u001b[97Gwith\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mJETTISON_PRESENTATION\u001b[39m on, which needs\u001b[43GVulkan and glslc.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe packer is built without presentation.\u001b[22m \u001b[38;2;177;185;249mjettison_pack\u001b[61G\u001b[39mlinks\u001b[67Gonly\u001b[72G\u001b[38;2;177;185;249mVfs\u001b[76G\u001b[39mand\u001b[80G\u001b[38;2;177;185;249mCore\u001b[39m,\u001b[86Gand\u001b[90Gbuilds\u001b[97Gin\u001b[100Gthe\u001b[104G\u001b[38;2;177;185;249mclang-cpu\u001b[114G\u001b[39mpreset.\r\u001b[2C\u001b[1B \u001b[5GStreaming (J41) needs a cook step in that\u001b[47Gtool, or beside it.\u001b[67G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe simulation can't see \u001b[38;2;177;185;249mrender\u001b[39m.\u001b[22m This is the architectur\u001b[62G's hard\u001b[70Grule:\u001b[76G\u001b[38;2;177;185;249msim\u001b[39m,\u001b[81G\u001b[38;2;177;185;249mphysics\u001b[39m,\u001b[90G\u001b[38;2;177;185;249mai\u001b[93G\u001b[39mand\u001b[97Gthe\u001b[101Grest\u001b[106Gnever\u001b[112Ginclude\r\u001b[2C\u001b[1B \u001b[5Git. J12 (a glTF model's collision me\u001b[42Gh) is \u001b[38;2;177;185;249mphysics\u001b[39m wanting t\u001b[66Ge same triangles.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1manimation\u001b[39m parses the same glTF file separately\u001b[22m, for the rig. That double read is\u001b[86GJ27's\u001b[92G\"a\u001b[95Gmodel\u001b[101Gfile\u001b[106Gread\u001b[111Gonce\"\u001b[117Grow.\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.149, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhere the device-free mesh work lives\u001b[22m\u001b[K\r\u001b[4C\u001b[2B\u001b[1mat has to l\u001b[17Gv\u001b[19G som\u001b[24Gwh\u001b[27Gre:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Greading\u001b[13Ga\u001b[15GglTF\u001b[20Gfile's\u001b[27Gtriangles;\r\u001b[2C\u001b[1B- simplifying them into LODs\u001b[32G(meshoptimizer);\r\u001b[4C\u001b[1Bbuilding the mesh\u001b[24Gt LOD hierarchy\u001b[40G(\u001b[38;2;177;185;249mclusterlod.h\u001b[39m);\r\u001b[4C\u001b[1Breading a\u001b[15Gd\u001b[17Gwriting the cooked page format that\u001b[53Gstreaming\u001b[63Guses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNon\u001b[7G of this touches the GPU.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat the code says today:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe glTF geometry reader is in \u001b[38;2;177;185;249mrender\u001b[43G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mrender/src/vulkan/ModelGltf.cpp\u001b[39m).\u001b[78G\u001b[38;2;177;185;249mrender\u001b[85G\u001b[39monly\u001b[90Gbuilds\u001b[97Gwith\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mJETTISON_PRESENTATION\u001b[39m on,\u001b[31Gwhich\u001b[37Gneeds\u001b[43GVulkan\u001b[50Gand\u001b[54Gglslc.\r\u001b[8C\u001b[1B\u001b[1mpacker is built without\u001b[33Gpresentation.\u001b[22m \u001b[38;2;177;185;249mj\u001b[49Gttison_pack\u001b[39m links only \u001b[38;2;177;185;249mVfs\u001b[39m and \u001b[38;2;177;185;249mCore\u001b[39m, and\u001b[97Gin the\u001b[104G\u001b[38;2;177;185;249mclang-cpu\u001b[114G\u001b[39mpreset.\r\u001b[4C\u001b[1BStreaming (J41) needs\u001b[27Ga cook step in that tool, or beside\u001b[63Git.\r\u001b[8C\u001b[1B\u001b[1msimulat\u001b[17Gon can't see \u001b[38;2;177;185;249mrender\u001b[39m.\u001b[22m This is the architecture's hard rule:\u001b[76G\u001b[38;2;177;185;249msim\u001b[39m, \u001b[38;2;177;185;249mphysics\u001b[39m,\u001b[90G\u001b[38;2;177;185;249mai\u001b[39m and\u001b[97Gthe r\u001b[103Gst never includ\u001