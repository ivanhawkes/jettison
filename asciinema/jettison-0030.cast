[0.004, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;153;153;153mtracing nee\u001b[18Gs. →\u001b[23GComput\u001b[30G, brought forward (R\u001b[51Gc.)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;153;153;153mT\u001b[10Ge rig loader r\u001b[25Gfuses a model with mor\u001b[48G \u001b[50Gha\u001b[54Gon\u001b[57G mesh node.\u001b[69GCharacters usually have several (body, eyes, teeth, \r\u001b[5C\u001b[1Bclothing). Lift \u001b[23Ghe l\u001b[28Gmit? → Several\u001b[43Gmeshes\u001b[50G(Rec.)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m· Portraits put faces close up. Scope has skin, hair and faces Out. What shading comes with this? → Skin, eyes, \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153mhair\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m· When should this track be built, against the dense geometry and ray tracing track (J36 to J50)? → After J37 \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m(Rec.)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Hair \u001b[39m\u001b[49m ☐ Skin  ☐ Shape names\u001b[34G ☐\u001b[37GLook-\u001b[43Gt\u001b[45G ✔\u001b[48GSubmit  →\u001b[K\r\u001b[2B\u001b[2m│\u001b[3G\u001b[22m\u001b[38;2;255;255;255m\u001b[1mHair with skin and eyes: how is hair made? Today the engine has no alpha-tested geometry, and the ray-tracing plan \r\u001b[1B\u001b[22m\u001b[39m\u001b[2m│\u001b[22m \u001b[38;2;255;255;255m\u001b[1mrelies on that.\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mAlpha-tested cards (Rec.)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mHair cards\u001b[17Gcut by alpha \u001b[31Gest, softened by the temporal AA already decided. Brings the first alpha-tested materials:\r\u001b[5C\u001b[1Balpha tes\u001b[16G in \u001b[21Ghe prepass and shad\u001b[41Gws, \u001b[46Gnd an any-hit path for\u001b[69Gray-traced shadows. Strands s\u001b[99Gay Out.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[6G\u001b[39mBlended\u001b[14Gcards\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mAlp\u001b[10Ga-blende\u001b[20Gcards, sorted. Sof\u001b[39Ger edge\u001b[47G,\u001b[49Gbut\u001b[53Gsortin\u001b[60G problems within one head, and no depth for\u001b[104Gray \u001b[109Gracing\u001b[116Gor \r\u001b[5C\u001b[1Bambient occlusion.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[39mCards\u001b[12G+\u001b[14Gstrands\u001b[22Glater\r\u001b[1B \u001b[3G   \u001b[38;2;153;153;153mCards now,\u001b[17Gstrand rendering an Open item for later.\r\u001b[2C\u001b[1B4. Type something.\r\u001b[1B────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  5.\u001b[6GChat\u001b[11Gabout\u001b[17Gthis\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[38;2;136;136;136m──────────────────────────────────────────────────────────────────────────────────────────────────────── jettison-0030 ─\u001b[39m\u001b[27;1H\u001b[14;1H"]
[26.270, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.006, "o", "\u001b[H\r\u001b[8B←  ☒ Hair \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Skin \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mSkin needs light\u001b[18Gto scatter under\u001b[35Gthe surface. Which approach?\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;177;185;249m❯\u001b[3G\u001b[38;2;153;153;153m1.\u001b[6G\u001b[38;2;177;185;249mPre-integrated (Rec.)\r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;2;153;153;153mA lookup texture of scattering by curvature and light angle, in the forward shader. No extra pass, cheap, good at \r\u001b[5C\u001b[1Bportrait distance; weaker on thin \u001b[41Gars\u001b[45Gin\u001b[48Gbacklight.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m2.\u001b[6G\u001b[39mScreen-space SSS\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;153;153;153mA separable blur of skin's diffuse light in screen space. Better, but it needs a separate diffuse buffer, which a \r\u001b[5C\u001b[1Bforw\u001b[11Grd renderer \u001b[24Goesn't keep.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3. Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m4.\u001b[6GChat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[K\u001b[27;1H\u001b[13;1H"]
[29.581, "o", "\u001b(B\u000f\u001b[?2004h\u001b[<u\u001b[>5u\u001b[>4;2m\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[0.005, "o", "\u001b[H\r\u001b[10C\u001b[8B ☒ Skin \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Shape names \r\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mDo fac\u001b[8Gs fo\u001b[13Glow a naming standard\u001b[35Gfor\u001b[40Ghape keys?\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[2B\u001b[38;2;177;185;249mARKit 52 (Rec.)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mFaces \u001b[13Gse Apple's 52 ARKit names (jawOpen, eyeBlinkLeft...).\u001b[67GLip-sync mapping, expressions \u001b[98Gnd future capture d\u001b[119Ga \r\u001b[5C\u001b[1Bthen work on every\u001b[25Gface. The\u001b[35Gengin\u001b[41G checks names only when a feature asks for them.\r\u001b[5C\u001b[1B\u001b[39mFre\u001b[10G \u001b[12Games\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;153;153;153mny n\u001b[12Gmes. Each face maps its own names to lip-sy\u001b[56Gc shapes and express\u001b[77Gons in its settings file.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3. Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  4. Chat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[13;1H"]
