[0.008, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd propose:\u001b[21G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mjettison_cook\u001b[22m\u001b[39m, an engine tool in \u001b[38;2;177;185;249msource/tools/cook\u001b[39m, CPU-only, on the \u001b[38;2;177;185;249mgeometry\u001b[39m module.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249mjettison_cook <src> <dst>\u001b[33G\u001b[39mcooks\u001b[39Gonce:\u001b[45Gthe\u001b[49Gsame\u001b[54Ginput\u001b[60Ggives\u001b[66Gthe\u001b[70Gsame\u001b[75Goutput\u001b[82Gbytes,\u001b[89Gso\u001b[92Gcommitted\u001b[102Gcooked\u001b[109Gfiles\u001b[115Gdon't\r\u001b[2C\u001b[1B    churn.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249m--watch\u001b[39m is your\u001b[23Gdaemon. It watches the source tree with inotify, debounces changes,\u001b[91Gcooks\u001b[97Gon\u001b[100Gthe\u001b[104Gjob\u001b[108Gthreads,\u001b[117Gand\r\u001b[4C\u001b[1B \u001b[7Gwrites atomically.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GA cook\u001b[14Grecord\u001b[21Gin\u001b[24Gthe\u001b[28Goutput\u001b[35G(hashes\u001b[43Gof\u001b[46Gthe\u001b[50Gsource,\u001b[58Gits\u001b[62Gsidecar\u001b[70Gand\u001b[74Gthe\u001b[78Gtool)\u001b[84Gskips\u001b[90Gwhat\u001b[95Ghasn't\u001b[102Gchanged\u001b[110Gand\u001b[114Gdeletes\r\u001b[4C\u001b[1B \u001b[7Goutputs\u001b[15Gwhose source is\u001b[31Ggone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInside the tool\u001b[22m, everything\u001b[33Gruns\u001b[38Gin-process:\r\u001b[6C\u001b[1Btangents with\u001b[21Gmikktspace, which is already\u001b[50Ga dep\u001b[56Gndency;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gmeshoptimizer'\u001b[22G ca\u001b[26Ghe optimisation,\u001b[43GLODs\u001b[48Gand\u001b[52Gmeshlet\u001b[60Ghierarchy;\r\u001b[2C\u001b[1B \u001b[5G- quantisation and compression;\u001b[K\r\u001b[7C\u001b[1Bhe GLB wr\u001b[19Gten by fastgltf's exporte\u001b[45G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1Bgltfpack s\u001b[16Gays\u001b[21G reference, because\u001b[41Ga\u001b[43Gsubprocess\u001b[54Gis\u001b[57Gharder\u001b[64Gto\u001b[67Gtest\u001b[72Gand\u001b[76Gto\u001b[79Gkeep\u001b[84Gdeterministic,\u001b[99Gand\u001b[103Git\u001b[106Gdoesn't\r\u001b[4C\u001b[1Bgenerate tangents.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe engine and game split:\r\u001b[4C\u001b[1B\u001b[22m- The engine owns th\u001b[26G tool\u001b[33Gthe form\u001b[42Gt and th\u001b[51G defaults.\u001b[K\r\u001b[4C\u001b[1B- Manif\u001b[13Gs\u001b[15G owns its\u001b[25G\u001b[38;2;177;185;249mcook.yaml\u001b[35G\u001b[39m(source\u001b[43Groot,\u001b[49Goutput\u001b[56Groot,\u001b[62Gits\u001b[66Gdefaults)\u001b[76Gand\u001b[80Gits\u001b[84Gcontent.\r\u001b[2C\u001b[1B \u001b[5G-\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.853, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mjettison_cook\u001b[22m\u001b[39m,\u001b[20Gan\u001b[23Gengine\u001b[30Gtool\u001b[35Gin\u001b[38G\u001b[38;2;177;185;249msource/tools/cook\u001b[39m,\u001b[57GCPU-only,\u001b[67Gon\u001b[70Gthe\u001b[74G\u001b[38;2;177;185;249mgeometry\u001b[83G\u001b[39mmodule.\r\u001b[2C\u001b[1B  - \u001b[38;2;177;185;249mjettison_cook <src> <dst>\u001b[33G\u001b[39mcooks\u001b[39Gonce:\u001b[45Gthe\u001b[49Gsame\u001b[54Ginput\u001b[60Ggives\u001b[66Gthe\u001b[70Gsame\u001b[75Goutput\u001b[82Gbytes,\u001b[89Gso\u001b[92Gcommitted\u001b[102Gcooked\u001b[109Gfiles\u001b[115Gdon't\r\u001b[2C\u001b[1B \u001b[5G  churn.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249m--watch\u001b[39m is your daemon. It watches the source tree with ino\u001b[67Gify, d\u001b[74Gb\u001b[77Gnces\u001b[82Gchanges, co\u001b[94Gks on the job threads, and\r\u001b[6C\u001b[1Bwrites\u001b[14Gatomically.\r\u001b[6C\u001b[1BA cook record in the output (hashes of\u001b[46Gthe sourc\u001b[56G,\u001b[58Gits s\u001b[64Gdecar an\u001b[73G the tool) skip\u001b[89G what has\u001b[99G'\u001b[101G changed and deletes\r\u001b[6C\u001b[1Boutputs whose source\u001b[28Gis\u001b[31Ggone.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInside the tool\u001b[22m, everything runs in-pr\u001b[44Gcess:\u001b[50G\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gtangents with\u001b[21Gmikktspace, which\u001b[39Gis\u001b[42Galready\u001b[50Ga\u001b[52Gdependency;\r\u001b[2C\u001b[1B \u001b[5G- meshoptimizer's cache optimisat\u001b[39Gon, LOD\u001b[47G and\u001b[52Gmeshlet\u001b[60Ghierarchy;\r\u001b[6C\u001b[1Bquantisation and com\u001b[28Gression;\u001b[K\r\u001b[6C\u001b[1Bthe GLB written\u001b[23Gby fastgltf'\u001b[36G exporter.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[4C\u001b[1Bgl\u001b[8Gfpack stays a reference, because a subprocess\u001b[54Gis\u001b[57Gharder\u001b[64Gto\u001b[67Gtest\u001b[72Gand\u001b[76Gto\u001b[79Gkeep\u001b[84Gdeterministic,\u001b[99Gand\u001b[103Git\u001b[106Gdoesn't\r\u001b[4C\u001b[1Bgenerate\u001b[14Gtangents.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe engine and game split:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B- The engine own\u001b[22G the\u001b[27Gtool,\u001b[33Gthe\u001b[37Gformat\u001b[44Gand\u001b[48Gthe\u001b[52Gdefaults.\r\u001b[2C\u001b[1B \u001b[5G- Manifest owns its \u001b[38;2;177;185;249mcook.yaml\u001b[35G\u001b[39m(source\u001b[43Groot,\u001b[49Goutput\u001b[56Groot,\u001b[62Gits\u001b[66Gdefaults)\u001b[76Gand\u001b[80Gits\u001b[84Gcontent.\r\u001b[10C\u001b[1Bcook also rejects file names that break th\u001b[54G kebab-case\u001b[66Grule.\u001b[72GThat's\u001b[79Gvalidation\u001b[90Gat\u001b[93Gthe\u001b[97Gboundary\u001b[106Gwhere\u001b[112Gartists'\r\u001b[4C\u001b[1B \u001b[7Gfiles come in.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
