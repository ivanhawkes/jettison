[0.219, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[1mWhere the device-free mesh work lives\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat has to live somewhere:\u001b[22m\u001b[K\r\u001b[4C\u001b[1Breading a \u001b[16GlTF file's\u001b[27Gtriangl\u001b[36G;\u001b[K\r\u001b[4C\u001b[1Bsimpl\u001b[11Gfying th\u001b[20Gm in\u001b[25Go LODs (meshoptimizer);\u001b[K\r\u001b[4C\u001b[1Bbuilding the meshlet LOD hierarchy (\u001b[38;2;177;185;249mclusterlod.h\u001b[39m);\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Greading\u001b[13Gand\u001b[17Gwriting\u001b[25Gthe\u001b[29Gcooked\u001b[36Gpage\u001b[41Gformat\u001b[48Gthat\u001b[53Gstreaming\u001b[63Guses.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNone\u001b[8Gof\u001b[11Gthis\u001b[16Gtouches\u001b[24Gthe\u001b[28GGPU.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the cod\u001b[16G says tod\u001b[26Gy:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe glTF geometry reader is in \u001b[38;2;177;185;249mrender\u001b[43G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mrender/src/vulkan/ModelGltf.cpp\u001b[39m).\u001b[78G\u001b[38;2;177;185;249mrender\u001b[85G\u001b[39monly\u001b[90Gbuilds\u001b[97Gwith\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mJETTISON_PRESENTATION\u001b[39m on, which needs Vulkan and glslc.\u001b[61G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe packer is built without presentation.\u001b[47G\u001b[22m\u001b[38;2;177;185;249mjettison_pack\u001b[39m links\u001b[67Gonly\u001b[72G\u001b[38;2;177;185;249mVfs\u001b[76G\u001b[39mand\u001b[80G\u001b[38;2;177;185;249mCore\u001b[39m,\u001b[86Gand\u001b[90Gbuilds\u001b[97Gin\u001b[100Gthe\u001b[104G\u001b[38;2;177;185;249mclang-cpu\u001b[114G\u001b[39mpreset.\r\u001b[2C\u001b[1B \u001b[5GStreaming (J41) needs a cook step in that tool, or besid\u001b[62G it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe simulation can't see \u001b[38;2;177;185;249mrender\u001b[39m.\u001b[22m Thi\u001b[42G is the architecture's \u001b[66Gard rule: \u001b[38;2;177;185;249msim\u001b[39m, \u001b[38;2;177;185;249mphysics\u001b[39m,\u001b[90G\u001b[38;2;177;185;249mai\u001b[93G\u001b[39mand\u001b[97Gthe\u001b[101Grest\u001b[106Gnever\u001b[112Ginclude\r\u001b[2C\u001b[1B \u001b[5Git. J12 (a glTF model's collision mesh) is \u001b[38;2;177;185;249mphysics\u001b[39m wanting the same triangles.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1manimation\u001b[39m parses the same glTF file separately\u001b[22m,\u001b[53Gfor\u001b[57Gthe\u001b[61Grig.\u001b[66GThat\u001b[71Gdouble\u001b[78Gread\u001b[83Gis\u001b[86GJ27's\u001b[92G\"a\u001b[95Gmodel\u001b[101Gfile\u001b[106Gread\u001b[111Gonce\"\u001b[117Grow.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe options:\u001b[22m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
