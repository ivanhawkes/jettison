[0.086, "o", "\u001b[?25l\u001b[H\u001b[3G│ Defaults with │ The engine's layered definitions (merge patches) already merge YAML. They handle engine         │\r\u001b[4C\u001b[1B overrides\u001b[21Gdefaults, then the game's \u001b[38;2;177;185;249mcook.yaml\u001b[39m, t\u001b[60Gen \u001b[38;2;177;185;249mbig-ship.gltf.yaml\u001b[39m. \u001b[84G    \u001b[89G       \u001b[97G \u001b[99G      \u001b[106G    \r\u001b[2C\u001b[1B└───────────────┴─────────────────────────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I'd propose:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mjettison_cook\u001b[22m\u001b[39m, an \u001b[24Gngine tool in \u001b[38;2;177;185;249msource/tools/cook\u001b[39m, CPU-only, on\u001b[70Gthe \u001b[38;2;177;185;249mgeometry\u001b[39m module.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;177;185;249mjettison_cook <src> <dst>\u001b[39m cooks once: the same inpu\u001b[59G gives the same output bytes,\u001b[89Gso\u001b[92Gcommitted\u001b[102Gcooked\u001b[109Gfiles\u001b[115Gdon't\r\u001b[2C\u001b[1B    churn.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7G\u001b[38;2;177;185;249m--watch\u001b[15G\u001b[39mis\u001b[18Gyour\u001b[23Gdaemon.\u001b[31GIt\u001b[34Gwatches\u001b[42Gthe\u001b[46Gsource\u001b[53Gtree\u001b[58Gwith\u001b[63Ginotify,\u001b[72Gdebounces\u001b[82Gchanges,\u001b[91Gcooks\u001b[97Gon\u001b[100Gthe\u001b[104Gjob\u001b[108Gthreads,\u001b[117Gand\r\u001b[2C\u001b[1B    writes atomically.\r\u001b[2C\u001b[1B \u001b[5G- A cook record in the ou\u001b[31Gput\u001b[35G(hashes of the source, its sidecar\u001b[70Gand\u001b[74Gthe tool) skips what\u001b[95Ghasn't\u001b[102Gchanged\u001b[110Gand\u001b[114Gdeletes\r\u001b[4C\u001b[1B \u001b[7Goutputs whose source is gone.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mInside the tool\u001b[22m,\u001b[22Geverything\u001b[33Gruns\u001b[38Gin-process:\r\u001b[6C\u001b[1Btangents with mikktspace, which i\u001b[42Galready a dep\u001b[56Gndency;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gmeshoptimizer's cache\u001b[29Goptimisation,\u001b[43GLODs\u001b[48Gand\u001b[52Gmeshlet\u001b[60Ghierarchy;\r\u001b[6C\u001b[1Bquantisati\u001b[18Gn and\u001b[24Gcompression;\u001b[K\r\u001b[4C\u001b[1B-\u001b[7Gthe GLB\u001b[16Gritten by fastgltf's\u001b[37Gexporter.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[4C\u001b[1Bgl\u001b[8Gfpack \u001b[15Gtays a referen\u001b[33Gbecause a subprocess is harder\u001b[64Gto\u001b[67Gtest\u001b[72Gand\u001b[76Gto\u001b[79Gkeep\u001b[84Gdeterministic,\u001b[99Gand\u001b[103Git\u001b[106Gdoesn't\r\u001b[4C\u001b[1Bgen\u001b[9Grate tang\u001b[19Gnt\u001b[22G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
