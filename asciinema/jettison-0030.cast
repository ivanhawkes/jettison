[0.087, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[2m 255 \u001b[12G\u001b[22m-\u001b[14G**The\u001b[20Gmodel,\u001b[27G`<name>.glb`.**\u001b[43GPlain\u001b[49GglTF\u001b[54G2.0\u001b[58Gwith\u001b[63G`KHR_mesh_quantization`\u001b[87Gand\r\u001b[1B \u001b[3G   \u001b[2m 256 \u001b[22m   `KHR_mesh\u001b[24Gpt_compression`, which fastgltf\u001b[56G1.0.1\u001b[62Gparses\u001b[69Gand\u001b[73Gmeshoptimizer\u001b[87Gdecodes.\u001b[96GIts\u001b[100Glevels\u001b[107Gof\r\u001b[1B     \u001b[2m 257 \u001b[12G\u001b[22m \u001b[14Gdetail\u001b[21Gare its\u001b[29Gprimitives\u001b[40Gin\u001b[43Gorder,\u001b[50Gfinest\u001b[57Gfirst,\u001b[64Gwith\u001b[69Gtheir\u001b[75Gerrors\u001b[82Gin\u001b[85Gthe\u001b[89Gprimitive's\u001b[101Gextras;\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 258 -\u001b[38;2;248;248;242m  `asset.extras` carries the cook key. `geometry`'s reader opens it with \u001b[48;2;92;2;0mboth\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mextensions enabled \u001b[48;2;61;1;0mand  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 258 +\u001b[38;2;248;248;242m  `asset.extras` carries the cook key. `geometry`'s reader opens it with \u001b[48;2;4;71;0mthese\u001b[48;2;2;40;0m and\u001b[48;2;4;71;0m `KHR_texture_basisu\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0m`\u001b[48;2;2;40;0m                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 259 +\u001b[38;2;248;248;242m  enabled and                                                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 260 \u001b[22m   decodes the compressed buffer views, and the model loader and the rig loader both go through it\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 261 \u001b[22m   (today each sets up its own parser, with no extensions, and would refuse the file). A GLB with no\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 262 \u001b[22m   meshlet file beside it draws on the indexed path, so an uncooked glTF keeps working, with a\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/dense-geome\u001b[27Gry-and-r\u001b[36Gy-trac\u001b[43Gng.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[8C\u001b[1B\u001b[2m2\u001b[12G\u001b[22m- **Exit\u001b[21Gcriterion.** The\u001b[38G`geometry`\u001b[49Gsuite\u001b[55Gproves\u001b[62Gthe\u001b[66Glevels'\u001b[74Gerrors\u001b[81Ggrow\u001b[86Gand\u001b[90Gthe\u001b[94Gcook's\u001b[101Goutput\u001b[108Gis\r\u001b[5C\u001b[1B\u001b[2m 453 \u001b[14G\u001b[22mthe\u001b[18Gsame\u001b[23Gbytes\u001b[29Gtwice;\u001b[36Gthe\u001b[40Gcook\u001b[45Gsuite\u001b[51Gcooks\u001b[57Ga\u001b[59Gfixture\u001b[67Gtree,\u001b[73Gskips\u001b[79Gwhat\u001b[84Gis\u001b[87Gunchanged,\u001b[98Gdeletes\u001b[106Gwhat\r\u001b[1B \u001b[3G   \u001b[2m 454 \u001b[22m   lost its source, and cooks a model again\u001b[55Gwhen\u001b[60Gonly\u001b[65Gits\u001b[69Gbuffer,\u001b[77Gan\u001b[80Gimage\u001b[86Gor\u001b[89G`cook.yaml`\u001b[101Gchanged;\r\u001b[1B     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 455 -\u001b[38;2;248;248;242m  the animation suite reads a cooked skinned fixture with its joints, clips and poses intact; \u001b[48;2;92;2;0mthe\u001b[48;2;61;1;0m     \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 456 -\u001b[38;2;248;248;242m  render test draws cooked models; a reference view shows a generated asteroid                        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 455 +\u001b[38;2;248;248;242m  the animation suite reads a cooked skinned fixture with its joints, clips and poses intact; \u001b[48;2;4;71;0ma\u001b[48;2;2;40;0m       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 456 +\u001b[38;2;248;248;242m  \u001b[48;2;4;71;0mreference view draws a cooked tex\u001b[76Gse colour; the \u001b[48;2;2;40;0mrender test draws cooke\u001b[49m\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.563, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 239 +\u001b[38;2;248;248;242m  script's settings (UASTC for colour and normal maps), through libktx's encoder.\u001b[48;2;4;71;0m A cooked GLB\u001b[48;2;2;40;0m        \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 240 +\u001b[38;2;248;248;242m  names them through `KHR_texture_basisu`, with no PNG fallback, so the reader enables that           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 241 +\u001b[38;2;248;248;242m  extension too, the model loader takes the extension's image index, and the material cache decodes   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 242 +\u001b[38;2;248;248;242m  KTX 2 through `Texture`'s existing reader instead of `DecodeImage` (stb_image).                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 243 \u001b[22m - **Formats.** No version numbers or migrations until player testing\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 244 \u001b[22m   ([\u001b[38;2;230;219;116mformats in place\u001b[39m](decisions.md#persistence)): a format change cooks everything again.\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 245 \u001b[22m - **The engine's own content** (`source/test/content`) is cooked by CMake into the build tree, as\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/dense-geometry-and-ray-tracing.md)\u001b[50G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 255 \u001b[12G\u001b[22m-\u001b[14G**The\u001b[20Gmodel,\u001b[27G`<name>.glb`.**\u001b[43GPlain\u001b[49GglTF\u001b[54G2.0\u001b[58Gwith\u001b[63G`KHR_mesh_quantization`\u001b[87Gand\r\u001b[1B \u001b[3G   \u001b[2m 256 \u001b[22m   `KHR_mesh\u001b[24Gpt_compression`, which fastgltf\u001b[56G1.0.1\u001b[62Gparses\u001b[69Gand\u001b[73Gmeshoptimizer\u001b[87Gdecodes.\u001b[96GIts\u001b[100Glevels\u001b[107Gof\r\u001b[1B     \u001b[2m 257 \u001b[12G\u001b[22m \u001b[14Gdetail\u001b[21Gare its\u001b[29Gprimitives\u001b[40Gin\u001b[43Gorder,\u001b[50Gfinest\u001b[57Gfirst,\u001b[64Gwith\u001b[69Gtheir\u001b[75Gerrors\u001b[82Gin\u001b[85Gthe\u001b[89Gprimitive's\u001b[101Gextras;\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 258 -\u001b[38;2;248;248;242m  `asset.extras` carries the cook key. `geometry`'s reader opens it with \u001b[48;2;92;2;0mboth\u001b[48;2;61;1;0m \u001b[48;2;92;2;0mextensions enabled \u001b[48;2;61;1;0mand  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 258 +\u001b[38;2;248;248;242m  `asset.extras` carries the cook key. `geometry`'s reader opens it with \u001b[48;2;4;71;0mthese\u001b[48;2;2;40;0m and\u001b[48;2;4;71;0m `KHR_texture_basisu\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0m`\u001b[48;2;2;40;0m                                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 259 +\u001b[38;2;248;248;242m  enabled and                                                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 260 \u001b[22m   decodes the compressed buffer views, and the model loader and the rig loader both go through it\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 261 \u001b[22m   (today each sets up its own parser, with no extensions, and would refuse the file). A GLB with no\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 262 \u001b[22m   meshlet file beside it draws on t\u001b[76Ged glTF keeps working, with a\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
