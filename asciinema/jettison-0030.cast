[0.001, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 46 -\u001b[38;2;248;248;242m| Windows (scope says Out) | Stays Out; every dependency chosen is portable, so it stays possible |    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 46 +\u001b[38;2;248;248;242m| Windows | Near the end of this development phase ([\u001b[38;2;230;219;116mdecisions\u001b[38;2;248;248;242m](decisions.md#build-and-platform)); desi\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m    +\u001b[38;2;248;248;242mgned for Linux until then, every dependency chosen portable |                                          \u001b[115G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m 47 \u001b[22m | What justifies th\u001b[31G work |\u001b[39GManif\u001b[45Gst conten\u001b[55G: ship and station kits, many\u001b[85Ginstances,\u001b[96Gdense\u001b[102Gasteroid\u001b[111Gmes\r\u001b[5C\u001b[1B\u001b[2m    \u001b[11G\u001b[22mhes\u001b[15G(no\u001b[19Gterrain\u001b[27Gsystem)\u001b[35G|\r\u001b[1B \u001b[3G   \u001b[2m 48 \u001b[22m | Anti-\u001b[19Gliasing against a visibility buffer | Decided later, before \u001b[81Ge temporal\u001b[92Gstage\u001b[98G([\u001b[38;2;230;219;116mJ49\u001b[39m](roadmap.m\r\u001b[5C\u001b[1B\u001b[2m    \u001b[11G\u001b[22md#j49))\u001b[19G|\r\u001b[2C\u001b[1B   \u001b[2m 49 \u001b[22m | Ray-traced effects | Sun shadows, local light shadows,\u001b[68Gambient\u001b[76Gocclusion;\u001b[87Greflections\u001b[99Gadded\u001b[105Gat\u001b[108Gthe\u001b[112Gar\r\u001b[5C\u001b[1B\u001b[2m    \u001b[11G\u001b[22mt\u001b[13Gteam's\u001b[20Grequest\u001b[28G|\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;153;153;153mMade \u001b[1m1\u001b[22m scratchpad edit \u001b[38;2;56;166;96m+20\u001b[38;2;153;153;153m, read \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands, recalled \u001b[1m1\u001b[22m memory, wrote \u001b[1m2\u001b[22m memories \r\u001b[5C\u001b[1B\u001b[39m\u001