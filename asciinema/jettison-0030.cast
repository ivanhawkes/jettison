[0.182, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 365 +\u001b[38;2;248;248;242m### Meshlet                                                                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 366 +\u001b[38;2;248;248;242m                                                                                                      \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242mA small cluster\u001b[28Gof\u001b[31Ga\u001b[33Gmesh's\u001b[40Gtriangles\u001b[50G(up\u001b[54Gto\u001b[57Ga\u001b[59Gfew\u001b[63Ghundred),\u001b[73Gwith\u001b[78Gits\u001b[82Gbounds,\u001b[90Gnormal\u001b[97Gcone\u001b[102Gand\u001b[106Gerror,\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m8\u001b[12G\u001b[38;2;248;248;242mculled\u001b[19Gand\u001b[23Gdrawn\u001b[29Gas\u001b[32Ga\u001b[34Gunit\u001b[39Gby\u001b[42Gtask\u001b[47Gand\u001b[51Gmesh\u001b[56Gshaders.\u001b[65GNot\u001b[69Ga\u001b[71Gcluster:\u001b[80Gthat\u001b[85Gword\u001b[90Gis\u001b[93Gthe\u001b[97Glight\u001b[103Ggrid's\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m9\u001b[12G\u001b[38;2;248;248;242m([\u001b[38;2;230;219;116mrendering\u001b[38;2;248;248;242m](rendering.md#clustered-lights)). Planned: see [\u001b[38;2;230;219;116mdense geometry and ray tracing\u001b[38;2;248;248;242m](dense-geom\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m   \u001b[12G\u001b[38;2;248;248;242metry-and-ray-tracing.md). \u001b[39G  \u001b[42G    \u001b[47G   \u001b[51G    \u001b[56G        \u001b[65G   \u001b[69G \u001b[71G        \u001b[80G    \u001b[85G    \u001b[90G  \u001b[93G   \u001b[97G     \u001b[103G      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m70\u001b[12G\u001b[38;2;248;248;242m                                                                                                      \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m371\u001b[12G\u001b[38;2;248;248;242m### Meshlet hierarchy    \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m2\r\u001b[8C\u001b[1B3\u001b[12G\u001b[38;2;248;248;242mA mod\u001b[18Gl's [\u001b[38;2;230;219;116mmeshlets\u001b[38;2;248;248;242m](#meshlet) at every level of detail, each group simplified from the one below     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m4\u001b[12G\u001b[38;2;248;248;242mwith\u001b[17Gits\u001b[21Gborder\u001b[28Glocked,\u001b[36Gso\u001b[39Gany\u001b[43Gcut\u001b[47Gthrough\u001b[55Git\u001b[58Gis\u001b[61Gcrack-free\u001b[72Gand\u001b[76Geach\u001b[81Gmeshlet\u001b[89Gdecides\u001b[97Galone\u001b[103Gwhether\r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m5\u001b[12G\u001b[38;2;248;248;242mit is drawn. Cooked into a page file beside the model, read in pages as the view needs them.          \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m6\u001b[12G\u001b[38;2;248;248;242mPlanned:\u001b[21Gsee [\u001b[38;2;230;219;116mdense geometry and ray tracing\u001b[38;2;248;248;242m](dense-geometry-and-ray-tracing.md).                     \r\u001b[8C\u001b[1B\u001b[38;2;80;200;80m7\u001b[12G\u001b[38;2;248;248;242m  \u001b[15G  \u001b[18G      \u001b[25G      \u001b[32G    \u001b[37G \u001b[39G    \u001b[44G    \u001b[49G      \u001b[56G   \u001b[60G      \u001b[67G    \u001b[72G  \u001b[75G     \u001b[81G  \u001b[84G   \u001b[88G    \u001b[93G     \u001b[99G     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 378 \u001b[22m ### Migration\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 379 \u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[2m80\u001b[12G\u001b[22mA step that brings\u001b[31Gdata\u001b[36Gof\u001b[39Gone\u001b[43Gformat\u001b[50Gversion\u001b[58Gup\u001b[61Gto\u001b[64Gthe\u001b[68Gnext\u001b[73G(`Serialise::Migrations`).\u001b[100GA\u001b[102Gchain\u001b[108Gof\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mWorking…\u001b[12G\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m✢\u001b[3G\u001b[38;2;218;124;92mJitterbugging…\u001b[75G\u001b[38;2;153;153;153m8\u001b[39m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
