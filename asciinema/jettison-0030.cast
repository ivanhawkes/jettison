[0.006, "o", "\u001b[H\r\u001b[10B←  ☒ Deform pass \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Mesh nodes \r\u001b[2C\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mT\u001b[6G rig loa\u001b[15Ger \u001b[19Gefuses a model with more than one mesh \u001b[59Gode. Character\u001b[74G usu\u001b[79Glly have several\u001b[96G(body\u001b[103Geyes,\u001b[109Gteeth, \u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;255;255;255m\u001b[1mclothing). Lift the limit?\r\u001b[5C\u001b[2B\u001b[22m\u001b[38;2;177;185;249mSeveral meshes (Rec.)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mSeveral mesh nodes per model, each\u001b[41Gwith\u001b[46Gits own skin or none, sharing\u001b[76Go\u001b[78Ge node\u001b[85Ghierarchy and one set of\u001b[110Gclips. \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mSh\u001b[9Gpe weights are\u001b[24Gper mesh node, as glTF\u001b[47Ghas\u001b[51Gthem.\u001b[39m\u001b[K\r\u001b[5C\u001b[1BK\u001b[8Gep one mesh\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mArtists join\u001b[19Ga character into on\u001b[40Gmesh in\u001b[48GBle\u001b[52Gder before\u001b[63Gexport. Simple\u001b[78G lo\u001b[82Gd\u001b[84Gr, but it con\u001b[98Gtrains \u001b[106Guthoring.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3. Type\u001b[11Gsomething.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  4. Chat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[16;1H"]
