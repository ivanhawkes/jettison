[0.056, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m53\u001b[12G\u001b[38;2;248;248;242m  ord\u001b[18Gr, or\u001b[24Gmake\u001b[29Gthe\u001b[33Gresult\u001b[40Gorder-independent.\u001b[59GThe\u001b[63Greference\u001b[73Gframes\u001b[80Gdepend\u001b[87Gon\u001b[90Git.\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m54\u001b[12G\u001b[38;2;248;248;242m-\u001b[14G**One\u001b[20Gsource,\u001b[28Gvariants\u001b[37Gfor\u001b[41Gfeatures.**\u001b[53GA\u001b[55Gprogram\u001b[63Gthat\u001b[68Gdiffers\u001b[76Gby\u001b[79Ga\u001b[81Gdevice\u001b[88Gfeature\u001b[96Gis\u001b[99Ga\u001b[101Gvariant\u001b[109Gof\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m55\u001b[12G\u001b[38;2;248;248;242m \u001b[14Gthe same \u001b[24Gou\u001b[27Gce (`jettison_compi\u001b[48G_shader_v\u001b[58Griant`), not a\u001b[73Gcopy, so\u001b[82Gthe paths cannot drift apa\u001b[109Gt. \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m56\u001b[12G\u001b[38;2;248;248;242m      \u001b[19G   \u001b[23G     \u001b[29G  \u001b[32G \u001b[34G    \u001b[39G  \u001b[42G    \u001b[47G   \u001b[51G    \u001b[56G        \u001b[65G   \u001b[69G \u001b[71G        \u001b[80G    \u001b[85G    \u001b[90G  \u001b[93G   \u001b[97G     \u001b[103G      \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[2m 357 \u001b[22m ## Testing\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 358 \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 359 \u001b[22m - Every module has a doctest suite; work is not done until its suite covers its exit criterion.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(docs/coding-standards.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 360 \u001b[22m - Serialisation has round-trip tests. Simulation has replay tests of the state hash\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 361 \u001b[22m   ([\u001b[38;2;230;219;116msimulation code\u001b[39m](#simulation-code)).\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 362 \u001b[22m - GPU paths are covered by the headless [\u001b[38;2;230;219;116msmoke test\u001b[39m](glossary.md#smoke-test), judged on\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 363 -\u001b[38;2;248;248;242m  validation-layer output as well as exit status ([build and gates](build-and-gates.md)).             \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 363 +\u001b[38;2;248;248;242m  validation-layer output as well as exit status ([\u001b[38;2;230;219;116mbuild and gates\u001b[38;2;248;248;242m](build-and-gates.md)).\u001b[48;2;4;71;0m An\u001b[48;2;2;40;0m          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 364 +\u001b[38;2;248;248;242m  optional path is covered both on and forced off ([\u001b[38;2;230;219;116mGPU code\u001b[38;2;248;248;242m](#gpu-code)).                            \r\u001b[7C\u001b[1B\u001b[39m\u001b[49m\u001b[2m65\u001b[12G\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 366 \u001b[12G\u001b[22m##\u001b[15GCommits\r\u001b[1B \u001b[3G   \u001b[2m 367 \r\u001b[18C\u001b[2B\u001b[22m\u001b[38;2;153;153;153m10m 18s · ↓\u001b[39m \u001b[38;2;153;153;153m57.1k tokens)\u001b[39m\u001b[K\r\u001b[18C\u001b[6B\u001b[38;2;153;153;153m(shift+tab to cycle) · esc to inte\u001b[54Grupt · ← 1 agent\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
