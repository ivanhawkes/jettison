[0.063, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mRoadmap:\u001b[14G\u001b[22ma\u001b[16Gnew\u001b[20Gtrack\u001b[26Gsection,\u001b[35G\"A\u001b[38Gseparate\u001b[47Gtrack:\u001b[54Gcharacters\".\u001b[67GThe\u001b[71G\"Waiting\u001b[80Gon\u001b[83Gyou\"\u001b[88Gline\u001b[93Gfor\u001b[97Gthis\u001b[102Gplanning\u001b[111Gis\u001b[114Ggone.\r\u001b[4C\u001b[1BJ20\u001b[9Ghands\u001b[15Gits\u001b[19GglTF\u001b[24Gclip\u001b[29Gevents\u001b[36Grow\u001b[40Gto\u001b[43GJ54\u001b[47Gand\u001b[51Gits\u001b[55Gcross-fade\u001b[66Grow\u001b[70Gto\u001b[73GJ53.\u001b[78GJ42\u001b[82Gnow\u001b[86Gneeds\u001b[92GJ51.\r\u001b[1B \u001b[3G- \u001b[1mScope and decisions:\u001b[22m \u001b[27Gen new decisions under\u001b[50GAnimation.\u001b[61GIn\u001b[64Gscope:\r\u001b[1B    - Op\u001b[10Gn: b\u001b[15Ge\u001b[17Gd shapes, blend spaces,\u001b[41Glip\u001b[45Gsync,\u001b[51Gthe\u001b[55Gcharacter\u001b[65Gcontroller,\u001b[77Gskin\u001b[82Gand\u001b[86Geyes,\u001b[92Ghair\u001b[97Gcards,\u001b[104Gtwo-bone\u001b[113GIK\u001b[116Gand\r\u001b[5C\u001b[1B look-at.\u001b[K\r\u001b[4C\u001b[1B- Out:\u001b[12Groot motion, animation \u001b[36Gta\u001b[39Ge machines and\u001b[54Ggraphs, crowd\u001b[68G, hair strands\u001b[83Gand\u001b[87Gcloth.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAlso updated:\u001b[22m five glossary entries, the limits \u001b[54Gn \u001b[38;2;177;185;249manimation.md\u001b[39m,\u001b[74GREADME index, and the dense-geometry plan\r\u001b[4C\u001b[1B(deform pass, hair as the first non-opaque ray-tracing geometry, the overflow order).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCoding standards:\u001b[22m committed test content must be the project's own or generated at build time, not under someone\r\u001b[4C\u001b[1Belse's licence, CC-BY included.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat the review changed:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBlending and playback:\u001b[22m quaternion blending is now truly order-independent. Morph weights set on a node override\u001b[117Gits\r\u001b[4C\u001b[1Bmesh's\u001b[12Gde\u001b[15Gaults. Bound\u001b[28G for mo\u001b[36Gphed models are recomputed\u001b[63Geach\u001b[68Gframe\u001b[74Gfrom\u001b[79Gthe\u001b[83Gcurrent\u001b[91Gweights.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLocomotion:\u001b[17G\u001b[22mplayback\u001b[26Gspeed\u001b[32Gis\u001b[35Gmatched\u001b[43Gafter\u001b[49Gsync,\u001b[55Gas\u001b[58Ga\u001b[60Gdirection\u001b[70Grather\u001b[77Gthan\u001b[82Ga\u001b[84Gbare\u001b[89Gspeed.\u001b[96GThe\u001b[100Gblend\u001b[106Gspace\u001b[112Greads\r\u001b[4C\u001b[1Bwalking speed relative to\u001b[31Gwhat\u001b[36Gthe\u001b[40Gcharacter\u001b[50Gstands\u001b[57Gon,\u001b[61Gso\u001b[64Ga\u001b[66Gpassenger\u001b[76Gon\u001b[79Ga\u001b[81Gturning\u001b[89Gdeck\u001b[94Gstands\u001b[101Gstill.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLip sync:\u001b[15G\u001b[22mRhubarb's\u001b[25Gversion\u001b[33Gis\u001b[36Gpart\u001b[41Gof\u001b[44Gthe\u001b[48Gcook\u001b[53Gkey,\u001b[58Gand\u001b[62Ga\u001b[64Gmissing\u001b[72GRhubarb\u001b[80Gdeletes\u001b[88Gstale\u001b[94Glip-sync\u001b[103Gclips\u001b[109Gand\u001b[113Gtriggers\r\u001b[1B \u001b[3G  a re-cook later. J57 now also needs\u001b[41GJ53.\u001b[K\r\u001b[1B  - \u001b[1mFootstep events:\u001b[22m clips\u001b[28Gin\u001b[31Ga\u001b[33Gblended\u001b[41Ggroup\u001b[47Ggive\u001b[52Gone\u001b[56Gfootstep\u001b[65Gper\u001b[69Gcontact,\u001b[78Gwith\u001b[83Gnone\u001b[88Grepeated\u001b[97Gor\u001b[100Glost\u001b[105Gwhen\u001b[110Gthe\u001b[114Gleading\r\u001b[4C\u001b[1Bclip\u001b[10Gchanges.\r\u001b[1B \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
