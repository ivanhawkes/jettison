sest to\u001b[39Gth\u001b[43Gw\u001b[45Gole plan.\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249manimated_clusters\u001b[39m: deforming\u001b[39Gmeshes, relevant\u001b[56Gto\u001b[59Gthe\u001b[63Gblend\u001b[69Gshapes\u001b[76Gnoted\u001b[82Gbelow.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mtessellated_clusters\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mraytracing_tutorial_KHR\u001b[39m:\u001b[35Gray-query\u001b[45Gshadows\u001b[53Gand\u001b[57GAO.\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mmini_samples\u001b[39m: mesh shaders, position fetch.\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mnv\u001b[10Gcluster_*\u001b[39m build\u001b[26Grs\u001b[29Gand \u001b[38;2;177;185;249mvk_raytrace\u001b[39m: archived.\r\u001b[6C\u001b[1B\u001b[38;2;177;185;249mvk\u001b[10Gpartitioned_tlas\u001b[39m: h\u001b[30Gs no licence file, so it can't\u001b[61Gbe\u001b[64Greused.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
