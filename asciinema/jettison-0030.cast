[0.006, "o", "\u001b[H\r\u001b[9B←  ☒ Cooked form \u001b[48;2;177;185;249m\u001b[38;2;0;0;0m ☐ Uncooked \r\u001b[5C\u001b[2B\u001b[49m\u001b[38;2;255;255;255m\u001b[1mdoes the\u001b[15Gruntime do with a glTF that was not cooked?\r\u001b[5C\u001b[2B\u001b[22m\u001b[38;2;177;185;249mIndexed path\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mLoads it as today, on the indexed fallback path, w\u001b[57Gth n\u001b[62G meshlets,\u001b[73Gand logs a warning\u001b[92Gnaming jet\u001b[103Gison_cook; the \r\u001b[5C\u001b[1Bm\u001b[9Ghl\u001b[12Gt builde\u001b[21G lives only in the\u001b[40Gcoo\u001b[44G\u001b[39m\u001b[K\r\u001b[5C\u001b[1BRefuse it\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mOnly cooked models load;\u001b[31Gmods and tests must cook\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m3.\u001b[6G\u001b[39mCook on load\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;153;153;153mThe runtime runs the cook in memory; slow loads, but every file gets meshlets\r\u001b[2C\u001b[1B4. Type something.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m  5. Chat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153mEnter to select · Tab/Arrow keys to navigate · Esc to cancel\r\u001b[1B\u001b[39m\u001b[K\u001b[27;1H\u001b[14;1H"]
