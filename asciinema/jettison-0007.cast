[0.002, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1Bstation.\u001b[14GEach\u001b[19Grefusal\u001b[27Gleaves\u001b[34Gthe\u001b[38Gcompany's\u001b[48Gcredits\u001b[56Gand\u001b[60Ggoods\u001b[66Gunchanged.\r\u001b[1B \u001b[3G- \u001b[1mMarket reports:\u001b[22m Ore's repor\u001b[33G is live at\u001b[45Gt\u001b[47Ge start and freezes when the \u001b[77Ghip\u001b[81Gleaves; Brine's starts as\u001b[107Gthe\u001b[111Gstarting\r\u001b[2C\u001b[1B  report and goe\u001b[20G live on docking.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCredits and goods checked every step:\u001b[43G\u001b[22mcredits\u001b[51Gchange\u001b[58Gonly\u001b[63Gwhen\u001b[68Gthe\u001b[72Gcompany\u001b[80Gis\u001b[83Gset\u001b[87Gup\u001b[90Gand\u001b[94Gwhen\u001b[99Gthe\u001b[103Gupgrade\u001b[111Gis\u001b[114Gbought.\r\u001b[2C\u001b[1B  Goods change only when production\u001b[39Gdelivers or households use them up. Productio\u001b[86Gbatches normally take a day, so\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Gtest overlay sho\u001b[22Gtens th\u001b[30Gm\u001b[32Gto 300 s to make deliveries happen\u001b[67Gduring the\u001b[79Goop.\u001b[84GI\u001b[86Gchecke\u001b[94Gthe goods check isn't\u001b[K\r\u001b[6C\u001b[1Bothless:\u001b[16Gwith\u001b[21Gthe\u001b[25Gproduction\u001b[36Gallowance\u001b[46Gremoved,\u001b[55Git\u001b[58Gfails\u001b[64Gat\u001b[67Gstep 16200.\r\u001b[4C\u001b[1B\u001b[1mSave, repl\u001b[16Gy,\u001b[19Gpack:\u001b[22m a sav\u001b[31G taken mid-cruise wi\u001b[53G t\u001b[56Ge bi\u001b[61G \u001b[63Gesting cont\u001b[75Gnues to the same results and the same\u001b[113Gworld.\r\u001b[4C\u001b[1BReplaying the recorded commands from the start\u001b[52Greaches the same world.\u001b[76GThe\u001b[80Gpack\u001b[85Ggives\u001b[91Gthe\u001b[95Gsame\u001b[100Gcontent\u001b[108Gand\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gresults as the directory.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges outside the new suite:\u001b[34G\u001b[22m\u001b[K\r\u00