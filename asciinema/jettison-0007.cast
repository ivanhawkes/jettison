[0.026, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 270 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(hosted.\u001b[38;2;166;226;46mRunJourney\u001b[38;2;248;248;242m() == std::vector<Leg>{Leg::Departing, Leg::Clearing, Leg::Failed});         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 271 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(hosted.\u001b[38;2;166;226;46mJourney\u001b[38;2;248;248;242m().failure == Failure::CruiseRefused);                                          \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 272 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(hosted.\u001b[38;2;166;226;46mRecord\u001b[38;2;248;248;242m().dockedAt.\u001b[38;2;166;226;46mempty\u001b[38;2;248;248;242m());                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 273 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(registry.\u001b[38;2;166;226;46mget\u001b[38;2;248;248;242m<World::Cargo>(hosted.\u001b[38;2;166;226;46mShip\u001b[38;2;248;248;242m()) == cargo);                                          \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 274 +\u001b[38;2;248;248;242m  \u001b[38;2;117;113;94m// Ended, it gives way to a new journey, back to the pads it left.\u001b[38;2;248;248;242m                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 275 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(hosted.\u001b[38;2;166;226;46mGo\u001b[38;2;248;248;242m(kAda, kOre) == Result::Succeeded);                                                  \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 276 +\u001b[38;2;248;248;242m}                                                                                                     \u