[0.083, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat the fixture does:\u001b[26G\u001b[22mone\u001b[30Gsequence\u001b[39Gof\u001b[42Gpublic\u001b[49Gcommands\u001b[58Gon\u001b[61Gthe\u001b[65Gtrading\u001b[73Gscenario,\u001b[83Gin\u001b[86G\u001b[38;2;177;185;249msource/test/FixtureTests.cpp\u001b[39m:\r\u001b[1B  - \u001b[1mThe loop:\u001b[22m buy furs, oxygen and scrubber cartridges at Ore and load them, leave a low bid resting at Brine, then\u001b[117Gfly\r\u001b[4C\u001b[1Bto Brine.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mIn flight and at Brine:\u001b[29G\u001b[22mrefill\u001b[36Gthe\u001b[40Gtanks\u001b[46Gfrom\u001b[51Gthe\u001b[55Ghold\u001b[60Gduring\u001b[67Gthe\u001b[71Gcruise,\u001b[79Gthen\u001b[84Gdock,\u001b[90Greplace\u001b[98Gthe\u001b[102Gcartridge,\u001b[113Gunload\r\u001b[1B \u001b[3G  and sell the furs, cancel the bid, and\u001b[44Gbuy the cargo-hold upgrade.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefusals:\u001b[15G\u001b[22mloading,\u001b[24Gunloading\u001b[34Gand\u001b[38Gupgrading\u001b[48Gare\u001b[52Geach\u001b[57Grefused\u001b[65Gin\u001b[68Gtransit,\u001b[77Gand\u001b[81Gunloading\u001b[91Gis\u001b[94Grefused\u001b[102Gat\u001b[105Gthe\u001b[109Gwrong\r\u001b[2C\u001b[1B  station. Each refusal\u001b[27Gleaves\u001b[34Gthe\u001b[38Gcompany's\u001b[48Gcredits\u001b[56Gand\u001b[60Ggoods\u001b[66Gunchanged.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMarket reports:\u001b[21G\u001b[22mOre's\u001b[27Greport\u001b[34Gis\u001b[37Glive\u001b[42Gat\u001b[45Gthe\u001b[49Gstart\u001b[55Gand\u001b[59Gfreezes\u001b[67Gwhen\u001b[72Gthe\u001b[76Gship\u001b[81Gleaves;\u001b[89GBrine's\u001b[97Gstarts\u001b[104Gas\u001b[107Gthe\u001b[111Gstarting\r\u001b[1B \u001b[3G  rep\u001b[9Grt\u001b[12Gand goes live on docking.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mCredits and goods checked every step:\u001b[43G\u001b[22mcredits\u001b[51Gchange\u001b[58Gonly\u001b[63Gwhen\u001b[68Gthe\u001b[72Gcompany\u001b[80Gis\u001b[83Gset\u001b[87Gup\u001b[90Gand\u001b[94Gwhen\u001b[99Gthe\u001b[103Gupgrade\u001b[111Gis\u001b[114Gbought.\r\u001b[4C\u001b[1BGoods\u001b[11Gchange\u001b[18Gonly\u001b[23Gwhen\u001b[28Gproduction\u001b[39Gdelivers\u001b[48Gor\u001b[51Ghouseholds\u001b[62Guse\u001b[66Gthem\u001b[71Gup.\u001b[75GProduction\u001b[86Gbatches\u001b[94Gnormally\u001b[103Gtake\u001b[108Ga\u001b[110Gday,\u001b[115Gso\u001b[118Ga\r\u001b[1B \u001b[3G  test\u001b[10Goverl\u001b[16Gy short\u001b[24Gns them to 300 s to\u001b[44Gmake deliveries\u001b[60Ghappen\u001b[67Gduring\u001b[74Gthe\u001b[78Gloop.\u001b[84GI\u001b[86Gchecked\u001b[94Gthe\u001b[98Ggoods\u001b[104Gcheck\u001b[110Gisn't\r\u001b[1B    toothless: with the production allowance\u001b[46Gremoved,\u001b[55Git\u001b[58Gfails\u001b[64Gat\u001b[67Gstep 16200.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSave, replay, pack:\u001b[22m a save taken mid-cruise with the bid resting continues to the same results and the same\u001b[113Gworld.\r\u001b[1B    Replaying the recorded commands from the start reaches the same world. The pack gives the same content and the\u001b[116Gsame\r\u001b[4C\u001b[1Bresults as the directory.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges outside the new suite:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mContent:\u001b[14G\u001b[22mthe\u001b[18Gtrading\u001b[26Gfixture's\u001b[36GOre\u001b[40Gnow\u001b[44Gmakes\u001b[50Goxygen\u001b[57Gand\u001b[61Gcartridges\u001b[72Gand\u001b[76GBrine\u001b[82Gwants\u001b[88Gthem.\u001b[94GW06\u001b[98Ghad\u001b[102Gleft\u001b[107Gthat\u001b[112Gfor\u001b[116GW09.\r\u001b[1B \u001b[3G  Three counts in existing\u001b[30Gtests changed with it; the furs-run\u001b[66Gcredits\u001b[74G(24,691\u001b[82Gand\u001b[86G29,590)\u001b[94Gare\u001b[98Gunchanged.\r\u001b[1B  -\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.233, "o", "\u001b[?25l\u001b[H\r\u001b[47C\u001b[25B\u001b[38;2;153;153;153m\u001b[2m7\u001b[50G1\u001b[54G3\u001b[22m\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.017, "o", "\u001b[?25l\u001b[H\u001b[3G  to Brine.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mIn f\u001b[10Gight and at Brine:\u001b[22m refill\u001b[36Gthe tanks f\u001b[48Gom th\u001b[54G hold duri\u001b[65Gg\u001b[67Gthe cruise, then\u001b[84Gdock,\u001b[90Greplace the\u001b[102Gcart\u001b[108Gdge, unload\u001b[K\r\u001b[4C\u001b[1Band sell the\u001b[18Gfurs,\u001b[24Gcancel\u001b[31Gthe\u001b[35Gbid,\u001b[40Gand\u001b[44Gbuy\u001b[48Gthe\u001b[52Gcargo-hold\u001b[63Gupgrade.\r\u001b[4C\u001b[1B\u001b[1mRefusals:\u001b[22m loading, unloading and upgrading are eac\u001b[56G refused in transit, and u\u001b[83Gloading is refused\u001b[102Gat \u001b[106Ghe wrong\u001b[K\r\u001b[4C\u001b[1Bstation.\u001b[14GEach refusal l\u001b[29Gaves the company's\u001b[48Gcr\u001b[51Gdits and goods unchanged.\r\u001b[4C\u001b[1B\u001b[1mMarket reports:\u001b[22m Ore's report\u001b[34Gis live \u001b[43Gt the start and \u001b[60Gre\u001b[63Gzes when the ship\u001b[81Gleaves; Br\u001b[92Gne's starts as the starting\r\u001b[4C\u001b[1Breport and goes live on docking.\u001b[38G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mCredi\u001b[11Gs and goods checked every step:\u001b[22m credit\u001b[50G change only when the\u001b[72Gcompany is set up and when the upgrad\u001b[111Gis bought.\r\u001b[4C\u001b[1BGoods change only when pr\u001b[31Gduction\u001b[39Gdelivers\u001b[48Gor\u001b[51Ghouseholds\u001b[62Guse\u001b[66Gthem\u001b[71Gup.\u001b[75GProduction\u001b[86Gbatches\u001b[94Gnormally\u001b[103Gtake\u001b[108Ga\u001b[110Gday,\u001b[115Gso\u001b[118Ga\r\u001b[2C\u001b[1B \u001b[5Gtest overlay shortens them to 300 s to make deliveries happen during the loop. I checke\u001b[94Gt\u001b[97G goods check isn't\u001b[K\r\u001b[4C\u001b[1Bt\u001b[8Gthless: with the production allowanc\u001b[45G removed, it fails at step 16200.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSave, replay, pack:\u001b[22m a\u001b[27Gsave\u001b[33Gaken mid-cruis\u001b[49Gwith the bid resting continues to the same results and\u001b[104Gt\u001b[107G same world.\r\u001b[4C\u001b[1BReplaying the recorded commands fr\u001b[40Gm th\u001b[46Gstart reaches the\u001b[64Gsame world. The\u001b[80Gpack\u001b[85Ggives\u001b[91Gthe\u001b[95Gsame\u001b[100Gcontent\u001b[108Gand\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gresults as the directory.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges outside the new suite:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mContent:\u001b[14G\u001b[22mthe\u001b[18Gtrading\u001b[26Gfixture's\u001b[36GOre\u001b[40Gnow\u001b[44Gmakes\u001b[50Goxygen\u001b[57Gand\u001b[61Gcartridges\u001b[72Gand\u001b[76GBrine\u001b[82Gwants\u001b[88Gthem.\u001b[94GW06\u001b[98Ghad\u001b[102Gleft\u001b[107Gthat\u001b[112Gfor\u001b[116GW09.\r\u001b[2C\u001b[1B  Three counts in existing tests\u001b[36Gchanged\u001b[44Gwith\u001b[49Git;\u001b[53Gthe\u001b[57Gfurs-run\u001b[66Gcredits\u001b[74G(24,691\u001b[82Gand\u001b[86G29,590)\u001b[94Gare\u001b[98Gunchanged.\r\u001b[4C\u001b[1B\u001b[1mTrav\u001b[10Gl suite:\u001b[22m it gains a refu\u001b[35Ged-cruise case, which\u001b[57Gno suite had: a ship without a\u001b[88Gdrive\u001b[94Gfails its journey\u001b[112Gand\u001b[116Gkeeps\r\u001b[4C\u001b[1Bits cargo.\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.136, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mIn flight and at Brine:\u001b[29G\u001b[22mrefill\u001b[36Gthe\u001b[40Gtanks\u001b[46Gfrom\u001b[51Gthe\u001b[55Ghold\u001b[60Gduring\u001b[67Gthe\u001b[71Gcruise,\u001b[79Gthen\u001b[84Gdock,\u001b[90Greplace\u001b[98Gthe\u001b[102Gcartridge,\u001b[113Gunload\r\u001b[2C\u001b[1B \u001b[5Gand sell the furs, cancel the bid,\u001b[40Gand buy the carg\u001b[57G-hold up\u001b[66Grad\u001b[70G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRefusals:\u001b[22m loading\u001b[24Gunloading and upgrading\u001b[48Gar\u001b[52Ge\u001b[54Gch refused in transit,\u001b[77Gand\u001b[81Gunloading\u001b[91Gis\u001b[94Grefused\u001b[102Gat\u001b[105Gthe\u001b[109Gwrong\r\u001b[2C\u001b[1B \u001b[5Gstation. Each refusal leaves\u001b[34Gthe\u001b[38Gcomp\u001b[43Gny's\u001b[48Gc\u001b[51Gdits and goo\u001b[64Gs unch\u001b[72Gged.\u001b[77G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMarket reports:\u001b[22m Ore's\u001b[27Gr\u001b[29Gport\u001b[34Gis live \u001b[43Gt the star\u001b[54G and freezes when the ship\u001b[81Gleaves;\u001b[89GBrine's\u001b[97Gstarts\u001b[104Gas\u001b[107Gthe\u001b[111Gstarting\r\u001b[2C\u001b[1B \u001b[5Greport and goes\u001b[21Glive on d\u001b[31Gcking.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCredits and goods checked every step:\u001b[43G\u001b[22mcredits\u001b[51Gchange\u001b[58Gonly\u001b[63Gwhen\u001b[68Gthe\u001b[72Gcompany\u001b[80Gis\u001b[83Gset\u001b[87Gup\u001b[90Gand\u001b[94Gwhen\u001b[99Gthe\u001b[103Gupgrade\u001b[111Gis\u001b[114Gbought.\r\u001b[2C\u001b[1B \u001b[5GGoods change only when production delivers or\u001b[51Ghouseholds use them up. Production batches\u001b[94Gnormally\u001b[103Gtake a day, so a\u001b[K\r\u001b[4C\u001b[1Btest overlay\u001b[18Gshortens them to 300\u001b[39Gs to make deliveries happ\u001b[65Gn during the loop. I\u001b[86Gche\u001b[90Gk\u001b[92Gd\u001b[94Gthe goods ch\u001b[107Gck\u001b[110Gisn't\u001b[K\r\u001b[5C\u001b[1Boo\u001b[9Ghless: wit\u