[0.300, "o", "\u001b[?25l\u001b[H\u001b[3G \u001b[5Gtest overlay shortens them to 300 s to make deliveries happen during the loop. I checke\u001b[94Gt\u001b[97G goods check isn't\u001b[K\r\u001b[4C\u001b[1Bt\u001b[8Gthless: with the production allowanc\u001b[45G removed, it fails at step 16200.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSave, replay, pack:\u001b[22m a\u001b[27Gsave\u001b[33Gaken mid-cruis\u001b[49Gwith the bid resting continues to the same results and\u001b[104Gt\u001b[107G same world.\r\u001b[4C\u001b[1BReplaying the recorded commands fr\u001b[40Gm th\u001b[46Gstart reaches the\u001b[64Gsame world. The\u001b[80Gpack\u001b[85Ggives\u001b[91Gthe\u001b[95Gsame\u001b[100Gcontent\u001b[108Gand\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B \u001b[5Gresults as the directory.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges outside the new suite:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mContent:\u001b[14G\u001b[22mthe\u001b[18Gtrading\u001b[26Gfixture's\u001b[36GOre\u001b[40Gnow\u001b[44Gmakes\u001b[50Goxygen\u001b[57Gand\u001b[61Gcartridges\u001b[72Gand\u001b[76GBrine\u001b[82Gwants\u001b[88Gthem.\u001b[94GW06\u001b[98Ghad\u001b[102Gleft\u001b[107Gthat\u001b[112Gfor\u001b[116GW09.\r\u001b[2C\u001b[1B  Three counts in existing tests\u001b[36Gchanged\u001b[44Gwith\u001b[49Git;\u001b[53Gthe\u001b[57Gfurs-run\u001b[66Gcredits\u001b[74G(24,691\u001b[82Gand\u001b[86G29,590)\u001b[94Gare\u001b[98Gunchanged.\r\u001b[4C\u001b[1B\u001b[1mTrav\u001b[10Gl suite:\u001b[22m it gains a refu\u001b[35Ged-cruise case, which\u001b[57Gno suite had: a ship without a\u001b[88Gdrive\u001b[94Gfails its journey\u001b[112Gand\u001b[116Gkeeps\r\u001b[4C\u001b[1Bits cargo.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mDocs:\u001b[22m updated\u001b[20Gn\u001b[22Gboth repositories.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits:\u001b[22m Manifest \u001b[38;2;177;185;249md0a8c0a\u001b[39m and Jetti\u001b[39Gon\u001b[42G\u001b[38;2;177;185;249mb218554\u001b[39m,\u001b[51Gboth\u001b[56Gon\u001b[59G\u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[73GNeither\u001b[81Gis\u001b[84Gpushed.\r\u001b[2C\u001b[2B\u001b[1mLi\u001b[6Gits:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gfixture\u001b[17Gflies\u001b[23Gthe\u001b[27Gshortened\u001b[37Gcruise\u001b[44Gfrom\u001b[49Gthe\u001b[53Gtravel\u001b[60Gsuite,\u001b[67Gnot\u001b[71Gthe\u001b[75Greal\u001b[80G4.49-day\u001b[89Gone.\u001b[94GW15\u001b[98Galready\u001b[106Gcovers\u001b[113Gthat\r\u001b[2C\u001b[1B  journey\u001b[13Gthrough\u001b[21Gthe\u001b[25Gconsole.\r\u001b[8C\u001b[1Bplan's other edg\u001b[27Gcases (partial fills,\u001b[49Gexpiry, another company's\u001b[75Gship, full pads and so\u001b[98Gon) stay in the\u001b[K\r\u001b[4C\u001b[1Bexisting \u001b[38;2;177;185;249mtrade\u001b[39m,\u001b[21G\u001b[38;2;177;185;249mcompany\u001b[39m and \u001b[38;2;177;185;249mtravel\u001b[40G\u001b[39msuites,\u001b[48Gas\u001b[51Gthe\u001b[55Gstage\u001b[61Gplan's\u001b[68GW09\u001b[72Gsection\u001b[80Grecords.\u001b[89GW09\u001b[93Gdoesn't\u001b[101Grepeat\u001b[108Gthem.\r\u001b[4C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.251, "o", "\u001b[?25l\u001b[H\u001b[6Goo\u001b[9Ghless: wit\u001b[20G th\u001b[24G producti\u001b[34Gn allowance r\u001b[48Gmoved, it fails at\u001b[67Gstep 16200.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSave, replay, pack:\u001b[25G\u001b[22ma save taken mid-cruis\u001b[48G with the\u001b[58Gbid res\u001b[66Ging continues\u001b[80Gto\u001b[83Gthe\u001b[87Gsame\u001b[92Gresults\u001b[100Gand\u001b[104Gthe\u001b[108Gsame\u001b[113Gworld.\r\u001b[2C\u001b[1B \u001b[5GReplaying the recorded commands from the \u001b[47Gtart reaches the \u001b[65Game world. The\u001b[80Gpack gives th\u001b[94G same\u001b[100Gcontent\u001b[108Gand the same\r\u001b[4C\u001b[1Br\u001b[7Gsults as the directory.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges outside the new suite:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mContent:\u001b[22m the trading fixture's\u001b[36GOre\u001b[40Gnow\u001b[44Gmakes\u001b[50Goxygen\u001b[57Gand\u001b[61Gcartridges\u001b[72Gand\u001b[76GBrine\u001b[82Gwants\u001b[88Gthem.\u001b[94GW06\u001b[98Ghad\u001b[102Gleft\u001b[107Gthat\u001b[112Gfor\u001b[116GW09.\r\u001b[2C\u001b[1B \u001b[5GThree counts\u001b[18Gin existing test\u001b[36Gchanged\u001b[44Gwith it; the\u001b[57Gfurs-run credits (24,691\u001b[82Gand 29,590)\u001b[94Gare\u001b[98Gunchanged.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTravel suite:\u001b[22m it gains a\u001b[30Gr\u001b[32Gfu\u001b[35Ged-cruise case, which\u001b[57Gno \u001b[61Guite\u001b[66Ghad: a ship without\u001b[86Ga drive\u001b[94Gfails its journey\u001b[112Gand\u001b[116Gkeeps\r\u001b[2C\u001b[1B \u001b[5Gits cargo.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mDocs:\u001b[22m updated\u001b[19Gin\u001b[22Gboth\u001b[27Grepositories.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCommits:\u001b[12G\u001b[22mManifest\u001b[21G\u001b[38;2;177;185;249md0a8c0a\u001b[29G\u001b[39mand\u001b[33GJettison\u001b[42G\u001b[38;2;177;185;249mb218554\u001b[39m,\u001b[51Gboth\u001b[56Gon\u001b[59G\u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[73GNeither\u001b[81Gis\u001b[84Gpushed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimits:\r\u001b[2C\u001b[1B\u001b[22m- The fixture\u001b[17Gflies\u001b[23Gthe\u001b[27Gshortened\u001b[37Gcruise\u001b[44Gfrom\u001b[49Gthe\u001b[53Gtravel\u001b[60Gsuite,\u001b[67Gnot\u001b[71Gthe\u001b[75Greal\u001b[80G4.49-day\u001b[89Gone.\u001b[94GW15\u001b[98Galready\u001b[106Gcovers\u001b[113Gthat\r\u001b[2C\u001b[1B \u001b[5Gjourney through the cons\u001b[30Gle.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe plan's \u001b[17Gther edge cases (partial\u001b[42Gfills,\u001b[49Gexpiry,\u001b[57Ganother\u001b[65Gcompany's\u001b[75Gship,\u001b[81Gfull\u001b[86Gpads\u001b[91Gand\u001b[95Gso\u001b[98Gon)\u001b[102Gstay\u001b[107Gin\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5Gexisting \u001b[38;2;177;185;249mtrade\u001b[39m, \u001b[38;2;177;185;249mcompany\u001b[39m and\u001b[33G\u001b[38;2;177;185;249mtravel\u001b[39m suites, as the st\u001b[58Gge plan's W09 section records. W09 \u001b[94Goesn't repeat them.\r\u001b[2C\u001b[1B-\u001b[5GCro\u001b[9Gs-review waits until W14 closes stage 4.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
