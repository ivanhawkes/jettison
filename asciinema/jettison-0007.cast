[0.533, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;153;153;153mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mFound \u001b[1m10\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/test/FixtureTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 519 \u001b[22m   \u001b[38;2;166;226;46mREQUIRE\u001b[39m(loaded.\u001b[38;2;166;226;46mShip1\u001b[39m().journey->leg == Leg::Cruising);\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 520 \u001b[22m   \u001b[38;2;166;226;46mFromCruise\u001b[39m(loaded);\u001b[K\r\u001b[5C\u001b[1B\u001b[2m 521 \u001b[22m   \u001b[38;2;166;226;46mCheckLedger\u001b[39m(loaded);\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 522 -\u001b[38;2;248;248;242m  CHECK(loaded.trace == std::vector<Outcome>(hosted.trace.begin() + traced, hosted.trace.end()));     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 522 +\u001b[38;2;248;248;242m  \u001b[38;2;166;226;46mCHECK\u001b[38;2;248;248;242m(loaded.trace == std::\u001b[38;2;166;226;46mvector\u001b[38;2;248;248;242m<Outcome>(hosted.trace.\u001b[38;2;166;226;46mbegin\u001b[38;2;248;248;242m() + \u001b[38;2;166;226;46m\u001b[48;2;4;71;0mstatic_cast\u001b[38;2;248;248;242m<std::\u001b[38;2;166;226;46mptrdiff_t\u001b[38;2;248;248;242m>(\u001b[48;2;2;40;0mtraced\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0m)\u001b[48;2;2;40;0m, hosted.trace.\u001b[38;2;166;226;46mend\u001b[38;2;248;248;242m()));                                                                              \r\u001b[1B\u001b[39m\u001b[49m     \u001b[2m 523 \u001b[22m   \u001b[38;2;166;226;46mCHECK\u001b[39m(loaded.world.\u001b[38;2;166;226;46mStateHash\u001b[39m() == hosted.world.\u001b[38;2;166;226;46mStateHash\u001b[39m());\r\u001b[5C\u001b[1B\u001b[2m 524 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 525 \u001b[22m   \u001b[38;2;117;113;94m// Replayed from the bootstrap, the recorded commands reach the same world.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m10\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mGoods are conserved from the first run, but provisioning counts as a credit source, so the ledger has to start after\r\u001b[2C\u001b[1Bit, and a tank refill isn't landing exactly \u001b[75Gll code next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.156, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m     +\u001b[38;2;248;248;242m\u001b[48;2;4;71;0m)\u001b[48;2;2;40;0m, hosted.trace.\u001b[38;2;166;226;46mend\u001b[38;2;248;248;242m()));                                                                              \r\u001b[1B\u001b[39m\u001b[49m     \u001b[2m 523 \u001b[22m   \u001b[38;2;166;226;46mCHECK\u001b[39m(loaded.world.\u001b[38;2;166;226;46mStateHash\u001b[39m() == hosted.world.\u001b[38;2;166;226;46mStateHash\u001b[39m());\r\u001b[5C\u001b[1B\u001b[2m 524 \r\u001b[1B\u001b[22m \u001b[3G   \u001b[2m 525 \u001b[22m   \u001b[38;2;117;113;94m// Replayed from the bootstrap, the recorded commands reach the same world.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  Found \u001b[1m10\u001b[22m new diagnostic issues in 1 file (ctrl+o to expand)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mGoods are conserved from the first run, but provisioning counts as a credit source, so the ledger has to start after\r\u001b[2C\u001b[1Bit, and a tank refill isn't landing exactly on 10. I'm checking the refill code next.\u001b[38;2;153;153;153m · summary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(~/projects/manifest/source/test/FixtureTests.cpp)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[2m 165 \u001b[22m         \u001b[38;2;166;226;46mRun\u001b[39m(kHost,\u001b[31GCompany::kProvision,\u001b[52GCompany::kVersion,\r\u001b[1B     \u001b[2m 166 \u001b[22m             Company::Provision{\u001b[38;2;230;219;116m\"Ada\"\u001b[39m, \u001b[38;2;230;219;116m\"Ada\"\u001b[39m, \u001b[38;2;230;219;116m\"Ada Co\"\u001b[39m})\u001b[68G==\u001b[71GResult::Succeeded);\r\u001b[5C\u001b[1B\u001b[2m 167 \u001b[16G\u001b[22mworld.\u001b[38;2;166;226;46mRegistry\u001b[39m().\u001b[38;2;166;226;46mget\u001b[39m<Jettison::Space::CruiseDrive>(\u001b[38;2;166;226;46mShip\u001b[39m()).profile.\u001b[38;2;166;226;46mreset\u001b[39m();\r\u001b[1B \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 168 +\u001b[38;2;248;248;242m    \u001b[38;2;117;113;94m// The company's starting credits are made by provisioning, so the ledger starts after it.\u001b[38;2;248;248;242m        \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 169 +\u001b[38;2;248;248;242m    credits = \u001b[38;2;166;226;46mCredits\u001b[38;2;248;248;242m(world.\u001b[38;2;166;226;46mRegistr\u001b[75G\u001b[38;2;248;248;242m                                       \u001b[39m\u001b[49m\u001b[27;1H\u001b[24;3H\u001b[?25h"]
