[0.062, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mBoth repositories are pushed, and\u001b[37GManifest's\u001b[48Gpinned\u001b[55Ggate\u001b[60Gpassed\u001b[67Gon\u001b[70Gthe\u001b[74Gfetched\u001b[82Gengine.\r\u001b[2B  - \u001b[1mJettison:\u001b[22m \u001b[38;2;177;185;249m71e9a31..e10a595\u001b[39m on \u001b[38;2;177;185;249mfeature-base\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mManifest:\u001b[15G\u001b[22m\u001b[38;2;177;185;249m3f97171..8f703bc\u001b[32G\u001b[39mon\u001b[35G\u001b[38;2;177;185;249mfeature-base\u001b[39m.\r\u001b[2C\u001b[1B- \u001b[1mPinned gate:\u001b[22m run in \u001b[38;2;177;185;249mbuild/gate-tree\u001b[39m at \u001b[38;2;177;185;249m8f703bc\u001b[52G\u001b[39mwith\u001b[57G\u001b[38;2;177;185;249m--werror --asan --tidy\u001b[39m;\u001b[81Gall\u001b[85G57\u001b[88Gsuites\u001b[95Gand\u001b[99Gtidy\u001b[104Gpassed\u001b[111Gagainst\r\u001b[4C\u001b[1Bthe\u001b[9Gfetched\u001b[17G\u001b[38;2;177;185;249mea66afe\u001b[39m.\r\u001b[1B \u001b[3G- \u001b[1mPreset caches:\u001b[22m the local-engine override \u001b[47Gs cleared from all four\u001b[71Gpr\u001b[74Gsets in the m\u001b[88Gin checkout; they\u001b[106Gnow fetch the\u001b[K\r\u001b[2C\u001b[1B  pin.\u001b[K\r\u001b[2C\u001b[2BManifest's CI run for \u001b[38;2;177;185;249m8f703bc\u001b[39m is still\u001b[42Gin\u001b[45Gprogress,\u001b[55Gso\u001b[58GI\u001b[60Ghave\u001b[65Gno\u001b[68GCI\u001b[71Gverdict.\u001b[80GThe\u001b[84Glast\u001b[89Gfive\u001b[94Gfull-length\u001b[106Gruns\u001b[111Gon\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mfeature-base\u001b[16G\u001b[39mwere\u001b[21Geach\u001b[26Gcancelled\u001b[36Gat\u001b[39Gabout\u001b[45G60\u001b[48Gminutes,\u001b[57Gwhich\u001b[63Glooks\u001b[69Glike\u001b[74Ga\u001b[76Gjob\u001b[80Gtime\u001b[85Glimit,\u001b[92Gso\u001b[95Gthis\u001b[100Gone\u001b[104Gmay\u001b[108Gbe\u001b[111Gcancelled\r\u001b[1B \u001b[3Gthe same way. I did \u001b[24Got wa\u001b[30Gt for it or look into why.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BJettison\u001b[12Gshows\u001b[18Gno\u001b[21GCI\u001b[24Grun\u001b[28Gfor\u001b[32Gtoday's\u001b[40Gpush;\u001b[46Gits\u001b[50Gmost\u001b[55Grecent\u001b[62Gruns\u001b[67Gare\u001b[71Gfrom\u001b[76G2026-11-17\u001b[87Gand\u001b[91Gfailed.\u001b[99GI\u001b[101Gdid\u001b[105Gnot\u001b[109Ginvestigate\r\u001b[1B \u001b[3Gthat either.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BR03 is next, and a new session is a good place to start it.\u001b[27;1H\u001b[24;3H\u001b[?25h"]
