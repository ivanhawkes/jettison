[0.060, "o", "\u001b[?25l\u001b[H\u001b[5Greleases\u001b[14Git w\u001b[19Gen the \u001b[27Grocess dies.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe \u001b[38;2;177;185;249mcore\u001b[39m suite cover\u001b[26G both, including a sec\u001b[50Gd process refused and\u001b[72Ga kill\u001b[79Gd holder's lock take\u001b[100G. Under \u001b[38;2;177;185;249mstrace\u001b[39m,\u001b[116Geach\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmkdir\u001b[39m is followed by its paren\u001b[36G's \u001b[38;2;177;185;249mfsync\u001b[39m, and a write is partial-file \u001b[38;2;177;185;249mfsync\u001b[39m, \u001b[38;2;177;185;249mrename\u001b[39m, directory \u001b[38;2;177;185;249mfsync\u001b[39m.\u001b[106G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFull gate green\u001b[21Gwith \u001b[38;2;177;185;249m--werror --asan\u001b[39m (139 s).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe message longer than a packet needed no engine code.\u001b[22m The roadmap booked splitting\u001b[88Gand\u001b[92Greassembly,\u001b[104Gbut\u001b[108GENet\u001b[113Galready\r\u001b[2C\u001b[1Bdoes that;\u001b[14Gthe\u001b[18G64\u001b[21GKiB\u001b[25Gwas\u001b[29Gonly\u001b[34G\u001b[38;2;177;185;249mLimits::maxMessageBytes\u001b[39m,\u001b[59Gwhich\u001b[65Ga\u001b[67Ggame\u001b[72Gcan\u001b[76Graise.\u001b[83GI\u001b[85Gadded\u001b[91Ga\u001b[93G\u001b[38;2;177;185;249mnet\u001b[97G\u001b[39mtest\u001b[102G(192\u001b[107GKiB\u001b[111Gsnapshot,\r\u001b[2C\u001b[1B1\u001b[5GMiB reliable message) and removed the roadmap item. On loopback an unreliable message arrived 20 of 20 times at\u001b[117G192\r\u001b[2C\u001b[1Band 256 KiB and never at 384 KiB or more. So a snapshot past about 256 KiB needs deltas, not a bigger limit.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mManifest (\u001b[38;2;177;185;249m8f703bc\u001b[39m, pin \u001b[38;2;177;185;249mea66afe\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mHost::OpenWorldDirectory\u001b[39m makes a world's root durably, 0700 when it creates it, and holds its lock; a second opener\r\u001b[4C\u001b[1Bis refused with the root name\u001b[35G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe tok\u001b[13Gn\u001b[15Gfile\u001b[20Gwas\u001b[24Grenamed\u001b[32Ginto\u001b[37Gplace\u001b[43Gwith\u001b[48Gno\u001b[51Gflush;\u001b[58Git\u001b[61Gnow\u001b[65Ggoes\u001b[70Gthrough\u001b[78G\u001b[38;2;177;185;249mWriteFileDurably\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mRemote::kMaxMessageBytes\u001b[39m is 192 KiB on both\u001b[49Gends. A new \u001b[38;2;177;185;249mremote\u001b[39m test rests 24\u001b[82Gb\u001b[84Gds in the trading scenario,\u001b[112Gtaking\r\u001b[4C\u001b[1BAda's view to 69,829\u001b[26Gbyte\u001b[31G, and it arrives; with the limit removed the test fails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GFull\u001b[10Ggate\u001b[15Ggreen\u001b[21G(Debug,\u001b[29Gno-TUI,\u001b[37GRelease,\u001b[46GASan,\u001b[52Gtidy;\u001b[58G57\u001b[61Gsuites),\u001b[70Grun\u001b[74Gagainst\u001b[82Gthe\u001b[86Glocal\u001b[92Gengine\u001b[99Gcheckout\u001b[108Gat\u001b[111G\u001b[38;2;177;185;249mea66afe\r\u001b[1B\u001b[39m \u001b[3G  rather\u001b[12Gthan t\u001b[19Ge fetched pin.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWaiting on you\r\u001b[1B\u001b[22m \u001b[3G-\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
