[0.028, "o", "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[1mThe compatibility rule:\u001b[22m a build loads\u001b[43Ga\u001b[45Gsave\u001b[50Gonly\u001b[55Gwhen\u001b[60Gthose\u001b[66Gfields\u001b[73Gequal\u001b[79Gits\u001b[83Gown,\u001b[88Gchecked\u001b[96Gbefore\u001b[103Ganything\u001b[112Gis\r\u001b[4C\u001b[1Binstalled.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe state inventory:\u001b[22m 50 component storages (32 Ma\u001b[55Gif\u001b[58Gst's, 18\u001b[67Gfor a\u001b[73Gship\u001b[78Gin space) and 3 services\u001b[104Gmap\u001b[109Gd \u001b[112Go request\r\u001b[4C\u001b[1Boutcomes,\u001b[15Gobservations,\u001b[29Gregional\u001b[38Grights,\u001b[46Gcadence\u001b[54Gand\u001b[58Gactive\u001b[65Gjobs.\u001b[71GI\u001b[73Gtook\u001b[78Gthe\u001b[82Glist\u001b[87Gfrom\u001b[92Ga\u001b[94Ghosted\u001b[101Gtrading\u001b[109Gworld's\u001b[117Gown\r\u001b[4C\u001b[1Bsave, using a temporary test that I reverted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe content inventory:\u001b[22m the 15 definition types the manifest covers.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe audit found three things the plans had assumed that are not so:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNo load compares content.\u001b[22m Stage 4's handoff said a save was refused by its fingerprint; only the fixtures' tests\r\u001b[4C\u001b[1Bcompare manifests. I corrected that line.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe world's save does not hold its step length.\u001b[22m A save made at 1/60 s loads into a world stepping at any other,\u001b[117Gso\r\u001b[4C\u001b[1Bthe section carries it.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe executable knows neither its own revision nor the SDK's.\u001b[66G\u001b[22mR03\u001b[70Ghas\u001b[74Gto\u001b[77Gcompile\u001b[85Gboth\u001b[90Gin.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Ghosted\u001b[12Gsession\u001b[20Galso\u001b[25Grefuses\u001b[33Ga\u001b[35Gwritable\u001b[44Gmount,\u001b[51Gso\u001b[54Ga\u001b[56Gsnapshot\u001b[65Ggoes\u001b[70Gthrough\u001b[78G\u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m,\u001b[102Gnot\u001b[106Gthe\u001b[110GVFS's\u001b[116Guser\r\u001b[1B \u001b[3Gmou\u001b[7Gt. That is R02's to prove.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision\u001b[12Gfor\u001b[16Gyou:\u001b[21GI\u001b[23Grecorded\u001b[32Gthe\u001b[36Gcompatibility\u001b[50Grule\u001b[55Gas\u001b[58GD-111,\u001b[65Gmarked\u001b[72Gas\u001b[75Gmine\u001b[80Gand\u001b[84Gyours\u001b[90Gto\u001b[93Greview.\u001b[101GBecause\u001b[109Gformats\r\u001b[1B \u001b[3Gchange in place until player testing,\u001b[41Gthe\u001b[45Gbuild\u001b[51Gis\u001b[54Gcompared\u001b[63Gexactly.\u001b[72GThe\u001b[76Gcatch\u001b[82Gis\u001b[85Gthat\u001b[90Ga\u001b[92Gpersistent\u001b[103Gworld\u001b[109Gdoes\u001b[114Gnot\r\u001b[1B  survive a rebuild of Manifest or a pin move until then. If you want dev worlds to\u001b[85Gcarry\u001b[91Gover,\u001b[97Gthe\u001b[101Grule\u001b[106Gloosens\u001b[114Gto\u001b[27;1H\u001b[24;3H\u001b[?25h"]
[0.103, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[1mstate \u001b[16Gnven\u001b[21Gory:\u001b[22m 50\u001b[29Gcomponent stor\u001b[44Gges (32 Manif\u001b[58Gst's, 18 for a\u001b[73Gship in \u001b[82Gpace)\u001b[88Gand 3 services, mapped to request\r\u001b[4C\u001b[1Boutcomes, observations,\u001b[29Gregional\u001b[38Grights,\u001b[46Gcadence\u001b[54Gand\u001b[58Gactive\u001b[65Gjobs.\u001b[71GI\u001b[73Gtook\u001b[78Gthe\u001b[82Glist\u001b[87Gfrom\u001b[92Ga\u001b[94Ghosted\u001b[101Gtrading\u001b[109Gworld's\u001b[117Gown\r\u001b[2C\u001b[1B \u001b[5Gsave, using a temporary\u001b[29Gtest tha\u001b[39GI reverted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe content inventory:\u001b[22m th\u001b[31G 15 definition\u001b[46Gtyp\u001b[50Gs the manifest\u001b[65Gc\u001b[67Gvers.\u001b[73G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe audit found three things\u001b[32Gthe pla\u001b[40Gs had\u001b[46Gassumed that ar\u001b[62G not so:\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mNo load compares content.\u001b[22m S\u001b[33Gage 4's han\u001b[45Goff sai\u001b[54Ga save was refused\u001b[73Gby\u001b[76Gits\u001b[80Gfingerprint;\u001b[93Gonly\u001b[98Gthe\u001b[102Gfixtures'\u001b[112Gtests\r\u001b[4C\u001b[1Bcompare\u001b[13Gmanifests.\u001b[24GI\u001b[26Gcorrected\u001b[36Gthat\u001b[41Gline.\r\u001b[4C\u001b[1B\u001b[1mThe world's save\u001b[22Gd\u001b[24Ges \u001b[28Got hold its step length.\u001b[22m A save made\u001b[65Gat 1/60\u001b[73Gs loads \u001b[83Gto a world stepping at any oth\u001b[114Gr, so\r\u001b[4C\u001b[1Bthe sectio\u001b[16G carries it.\u001b[K\r\u001b[8C\u001b[1B\u001b[1mexecutable knows nei\u001b[30Gher its own revision nor the SDK's.\u001b[22m R03 has to comp\u001b[82Gle both in.\u001b[94G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Ghosted session also refuses a writable mount, so a snapshot goes\u001b[70Gthrough \u001b[38;2;177;185;249mCore::WriteFileDurably\u001b[39m,\u001b[102Gnot\u001b[106Gthe\u001b[110GVFS's\u001b[116Guser\r\u001b[2C\u001b[1Bmount.\u001b[10GThat\u001b[15Gis\u001b[18GR02's\u001b[24Gto\u001b[27Gprove.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BDecision for you: I recorded the\u001b[36Gcompatibility\u001b[50Grule\u001b[55Gas\u001b[58GD-111,\u001b[65Gmarked\u001b[72Gas\u001b[75Gmine\u001b[80Gand\u001b[84Gyours\u001b[90Gto\u001b[93Greview.\u001b[101GBecause\u001b[109Gformats\r\u001b[2C\u001b[1Bchange\u001b[10Gin\u001b[13Gplace\u001b[19Guntil\u001b[25Gplayer\u001b[32Gtesting,\u001b[41Gthe\u001b[45Gbuild\u001b[51Gis\u001b[54Gcompared\u001b[63Gexactly.\u001b[72GThe\u001b[76Gcatch\u001b[82Gis\u001b[85Gthat\u001b[90Ga\u001b[92Gpersistent\u001b[103Gworld\u001b[109Gdoes\u001b[114Gnot\r\u001b[2C\u001b[1Bsurvive a rebuild\u001b[21Gof Manif\u001b[30Gst or\u001b[36Ga pin move until then. If you want dev\u001b[75Gworlds to ca\u001b[88Gry \u001b[92Gver, the\u001b[101Grule loosens \u001b[115Go\r\u001b[2C\u001b[1Bex\u001b[6Gct co\u001b[12Gtent and commands only, at the cost of\u001b[51Ga journ\u001b[59Gl possibly replaying under changed \u001b[95Gules.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[27;1H\u001b[24;3H\u001b[?25h"]
