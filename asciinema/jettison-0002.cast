[0.003, "o", "\u001b[?25l\u001b[H\u001b[3Gkeeping\u001b[11Gstock correct ac\u001b[28Goss \u001b[33Gave\u001b[37Gand\u001b[41Greplay\u001b[48Gis\u001b[51Gwhere\u001b[57Ga\u001b[59Gcheaper\u001b[67Gmodel\u001b[73Gwould\u001b[79Gleave\u001b[85Ghard-to-find\u001b[98Gbugs.\u001b[104GSonnet\u001b[111Gis\u001b[114Gfine\r\u001b[2C\u001b[1Bfor\u001b[7Gthe\u001b[11Gdoc\u001b[15Gupdates\u001b[23Gafterwards.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BShould\u001b[10GI\u001b[12Gdraft\u001b[18Gproposed\u001b[27Ganswers\u001b[35Gto\u001b[38G1–6\u001b[42Gfor\u001b[46Gyou\u001b[50Gto\u001b[53Gapprove?\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Ghaven't\u001b[13Gread\u001b[18GManifest's\u001b[29Gtravel\u001b[36Gor\u001b[39Gcompany\u001b[47Gheaders\u001b[55Gin\u001b[58Gdetail,\u001b[66Gso\u001b[69G\"no\u001b[73Gengine\u001b[80Gedit\"\u001b[86Gis\u001b[89Gan\u001b[92Ginference.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GSautéed for 37s · done 4:41 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mMak\u001b[7G a not\u001b[14G, ignore all files in ./asciinema - they are a recording of this project using ascii capture code and are \r\u001b[1B\u001b[39m  \u001b[38;2;255;255;255mnever to be inspected by you.\u001b[39m                                                                                         \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRecalled \u001b[1m1\u001b[22m memory, wrote \u001b[1m2\u001b[22m memories \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mNot\u001b[8G: from now on I won't open,\u001b[36Gread\u001b[41Gor search\u001b[51Gany\u001b[55Ghing \u001b[61Gn \u001b[38;2;177;185;249m./asciinema\u001b[39m, and every search I run will leave it out.\u001b[118GI\r\u001b[2C\u001b[1Badded this\u001b[14Gto\u001b[17Gmy\u001b[20Gmemory,\u001b[28Gand\u001b[32Gthe\u001b[36Gnote\u001b[41Galso\u001b[46Gsays\u001b[5