# Normalise line endings on check-out: LF in the repository, LF in the working tree.
* text=auto

# Shell scripts must keep LF: a CRLF shebang fails to exec on Linux and macOS.
*.sh text eol=lf
*.bash text eol=lf

# YAML is read by yaml-cpp, yq and the game; keep it LF everywhere.
*.yaml text eol=lf
*.yml text eol=lf

# Source and documentation.
*.c text
*.cpp text
*.cxx text
*.h text
*.hpp text
*.cs text
*.md text
*.nix text
*.toml text
*.json text
*.uplugin text
CMakeLists.txt text
*.lock text
.envrc text
.gitattributes text

# Binary assets: never diff, never merge, never normalise line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.dds binary
*.fbx binary
*.blend binary
*.uasset binary
*.umap binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.a binary
*.o binary
*.so binary
*.pdf binary
*.zip binary

# Large media goes through Git LFS, and each rule also asserts -text so the content is
# never touched by the line-ending machinery above. History was migrated explicitly with:
#   git lfs migrate import --include="*.glb,*.png,*.jpg,*.jpeg,*.tga,*.dds,*.fbx,*.blend,*.ttf,*.otf,*.wav,*.ogg,*.mp3" \
#     --include-ref=refs/heads/main --include-ref=refs/heads/feature-base
# Note: *.gltf stays a plain Git blob; it is JSON with sidecar .bin buffers, so it diffs.
*.glb  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.dds  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
