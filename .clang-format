# Formatting rules for the C++ tree, enforced by scripts/format-check.sh, which the
# worktrunk pre-commit hook runs and CI (.github/workflows/ci.yml) runs first.
#
# Needs clang-format 20 or newer: BinPackParameters below is a string ("BinPack"),
# which became the spelling in LLVM 20; an older formatter calls it an "invalid
# boolean" and cannot read this file at all. The devenv shell and CI both use
# LLVM 21.1.8, and the gate script refuses to run an older formatter.
#
# Format the whole tree:
#
#   find source \( -name '*.h' -o -name '*.hpp' -o -name '*.cpp' \) -print0 \
#     | xargs -0 clang-format -i
#
# Keep the parentheses: find's -print binds to the last -name alone, so a pipeline
# ending '-name "*.h" -o -name "*.cpp" -print' lists the .cpp files, the gate sees no
# headers, and header drift passes every check. The gate itself is git ls-files based,
# which cannot make that mistake, and it skips source/test/ImGuiMain.cpp (the dead
# ImGui sample program, excluded from the build).
BasedOnStyle: Microsoft
AlignAfterOpenBracket: AlwaysBreak
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
BinPackArguments: true
BinPackParameters: BinPack
BreakBeforeBraces: Allman
ColumnLimit: 104
ContinuationIndentWidth: 4
DisableFormat: false
IndentCaseLabels: true
IndentWidth: 4
Standard: Latest
TabWidth: 4
UseTab: ForIndentation
MaxEmptyLinesToKeep: 2
